{
  "name": "webao",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cf:dev": "wrangler dev --config wrangler.jsonc",
    "cf:deploy": "npm run build && rm -f dist/client/wrangler.json && wrangler deploy --config wrangler.jsonc",
    "cf:build": "npm run build",
    "lint": "astro check",
    "prebuild": "node scripts/restore-images.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "npm run build && tsx --test tests/cloudflare.integration.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
