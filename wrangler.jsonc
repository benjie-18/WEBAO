{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "WEBAO_KV",
      "id": "42eb0707bb614686ad067fb7a82c3f81"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "webao.ca@gmail.com"
    }
  ],
  "main": "worker/index.ts",
  "name": "webao",
  "observability": {
    "enabled": true
  },
  "env": {
    "test": {
      "name": "webao-test",
      // Route test.webao.ca/* -> webao-test is attached in the Cloudflare dashboard (like prod), NOT here: the deploy token cannot create zone routes.
      "vars": { "TEST_MODE": "1" },
      "kv_namespaces": [
        {
          "binding": "WEBAO_KV",
          "id": "c5c9c6b80997418ab21e92f6d69dab5d"
        }
      ]
    }
  }
}
