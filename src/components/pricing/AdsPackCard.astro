---
// Ads Pack card: a standalone service, sold on its own or next to a website
// plan. Monthly only, there is no annual term; the one-time setup fee is
// added by checkout server-side and is stated on the card so the total is
// clear before buying.
//
// Channel picker: one channel (Meta or Google) is the single price; both
// together are the bundle price. The picker only changes which cart product
// the button adds (ads-meta / ads-google / ads-both); the Stripe price for
// a single channel is the same either way, and checkout records the channel
// from the cart key in metadata[items].
import { useTranslations, type Locale } from "../../lib/i18n";
import CartButton from "./CartButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const a = t.pricing.adsPack;

const variants = [
  {
    id: "meta",
    product: "ads-meta",
    label: a.metaLabel,
    price: a.metaPrice,
    priceCents: 89999,
    setup: a.setup,
    budget: a.budget,
    include: a.metaInclude,
    name: `${a.name} (${a.metaLabel})`,
  },
  {
    id: "google",
    product: "ads-google",
    label: a.googleLabel,
    price: a.metaPrice,
    priceCents: 89999,
    setup: a.setup,
    budget: a.budget,
    include: a.googleInclude,
    name: `${a.name} (${a.googleLabel})`,
  },
  {
    id: "both",
    product: "ads-both",
    label: a.bothLabel,
    price: a.bothPrice,
    priceCents: 134999,
    setup: a.bothSetup,
    budget: a.bothBudget,
    include: a.bothInclude,
    name: `${a.name} (${a.bothLabel})`,
  },
] as const;
const selected = variants[0];
---

<div class="bundle-card" data-ads-pack>
  <p class="bc-kicker">{a.eyebrow}</p>
  <div class="bc-name-row">
    <h3 class="bc-name">{a.name}</h3>
    <CartButton locale={locale} product={selected.product} name={selected.name} priceCents={selected.priceCents} interval="month" type="bundle" />
  </div>
  <p class="bc-price" data-ads-price>{selected.price}</p>

  <fieldset class="bc-channels">
    <legend class="bc-label">{a.channelLabel}</legend>
    {
      variants.map((v) => (
        <label class="bc-channel">
          <input
            type="radio"
            name="ads-channel"
            value={v.product}
            data-product={v.product}
            data-name={v.name}
            data-price-cents={String(v.priceCents)}
            data-price={v.price}
            data-setup={v.setup}
            data-budget={v.budget}
            data-include={v.include}
            checked={v.id === "meta"}
          />
          <span>{v.label}</span>
        </label>
      ))
    }
  </fieldset>

  <p class="bc-label">{a.includesLabel}</p>
  <ul class="bc-includes">
    <li>
      <svg viewBox="0 0 16 16" aria-hidden="true" class="bc-check">
        <path
          d="M3.5 8.2l3.2 3.2 5.8-6.8"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span data-ads-include>{selected.include}</span>
    </li>
    {a.includes.map((inc) => (
      <li>
        <svg viewBox="0 0 16 16" aria-hidden="true" class="bc-check">
          <path
            d="M3.5 8.2l3.2 3.2 5.8-6.8"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>{inc}</span>
      </li>
    ))}
  </ul>

  <dl class="bc-meta">
    <div class="bc-row">
      <dt>{a.setupLabel}</dt>
      <dd data-ads-setup>{selected.setup}</dd>
    </div>
    <div class="bc-row">
      <dt>{a.budgetLabel}</dt>
      <dd data-ads-budget>{selected.budget}</dd>
    </div>
  </dl>

  <div class="bc-starter" data-ads-starter>
    <p class="bc-label">{a.starterTitle}</p>
    <p class="bc-starter-body">{a.starterBody}</p>
    <a class="bc-starter-link" href={locale === "fr" ? "/fr/contact" : "/contact"}>{a.starterLink}</a>
  </div>

  <p class="bc-note">{a.upgradeNote}</p>

  <div class="bc-gbp">
    <div>
      <p class="bc-label">{a.gbpLabel}</p>
      <p class="bc-gbp-name">{a.gbpName} <span class="mono">{a.gbpPrice}</span></p>
      <p class="bc-gbp-short">{a.gbpShort}</p>
    </div>
    <CartButton locale={locale} product="gbp-revamp" name={a.gbpName} priceCents={14999} interval="one-time" type="addon" />
  </div>
</div>

<script>
  // Channel picker: swap the displayed price/setup/budget/include and the
  // cart button's product. If an Ads Pack variant is already in the cart,
  // swap it for the newly picked variant instead of leaving two packs in
  // the cart (checkout also rejects two variants, as a backstop).
  function initAdsPack() {
    var root = document.querySelector("[data-ads-pack]") as HTMLElement | null;
    if (!root || root.dataset.adsInit === "1") return;
    root.dataset.adsInit = "1";
    var priceEl = root.querySelector("[data-ads-price]");
    var setupEl = root.querySelector("[data-ads-setup]");
    var budgetEl = root.querySelector("[data-ads-budget]");
    var includeEl = root.querySelector("[data-ads-include]");
    var btn = root.querySelector("[data-cart-btn]") as HTMLElement | null;
    var starterEl = root.querySelector("[data-ads-starter]") as HTMLElement | null;
    var adsKeys = ["ads-pack-month", "ads-meta-month", "ads-google-month", "ads-both-month"];
    // Starter test is Meta-only: show it for Meta, hide it for Google/Both.
    function syncStarter(product: string) {
      if (!starterEl) return;
      starterEl.hidden = product !== "ads-meta";
    }
    var checkedInput = root.querySelector('input[name="ads-channel"]:checked') as HTMLInputElement | null;
    if (checkedInput) syncStarter(checkedInput.dataset.product || "");
    root.addEventListener("change", function (event) {
      var input = event.target as HTMLInputElement | null;
      if (!input || input.name !== "ads-channel" || !input.checked) return;
      if (priceEl) priceEl.textContent = input.dataset.price || "";
      if (setupEl) setupEl.textContent = input.dataset.setup || "";
      if (budgetEl) budgetEl.textContent = input.dataset.budget || "";
      if (includeEl) includeEl.textContent = input.dataset.include || "";
      syncStarter(input.dataset.product || "");
      if (btn) {
        btn.dataset.product = input.dataset.product || "";
        btn.dataset.name = input.dataset.name || "";
        btn.dataset.priceCents = input.dataset.priceCents || "";
        btn.dataset.key = (input.dataset.product || "") + "-month";
      }
      try {
        var raw = window.localStorage.getItem("webao_cart_v1");
        if (!raw) return;
        var items = JSON.parse(raw);
        if (!Array.isArray(items)) return;
        var had = items.some(function (item) { return item && adsKeys.indexOf(item.key) >= 0; });
        if (!had) return;
        var next = items.filter(function (item) { return !item || adsKeys.indexOf(item.key) < 0; });
        next.push({
          key: (input.dataset.product || "") + "-month",
          product: input.dataset.product || "",
          name: input.dataset.name || "",
          priceCents: Number(input.dataset.priceCents || 0),
          interval: "month",
          type: "bundle",
        });
        window.localStorage.setItem("webao_cart_v1", JSON.stringify(next));
        window.dispatchEvent(new CustomEvent("webao:cart-change", { detail: { items: next } }));
      } catch (e) {
        // Cart swap is a convenience; the button still adds the new variant.
      }
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdsPack);
  } else {
    initAdsPack();
  }
</script>

<style>
  .bundle-card {
    --bc-bg: var(--bundle-bg);
    --bc-text: var(--bundle-text);
    --bc-soft: var(--bundle-soft);
    --bc-line: var(--bundle-line);
    background: linear-gradient(165deg, var(--bundle-bg-2) 0%, var(--bc-bg) 60%);
    color: var(--bc-text);
    border: 1px solid var(--bc-line);
    border-radius: 26px;
    padding: clamp(22px, 3vw, 32px);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 400px;
  }
  .bc-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bc-soft);
  }
  .bc-name-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .bc-name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-top: 6px;
    line-height: 1;
  }
  .bc-price {
    margin-top: 10px;
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .bc-label {
    margin-top: 18px;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bc-soft);
  }
  .bc-includes {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: grid;
    gap: 9px;
    font-size: 0.94rem;
  }
  .bc-includes li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
  }
  .bc-check {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--bc-text);
    opacity: 0.85;
    flex: none;
  }
  .bc-meta {
    margin: 18px 0 0;
    padding: 0;
    border-top: 1px solid var(--bc-line);
  }
  .bc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--bc-line);
    font-size: 0.88rem;
  }
  .bc-row:last-child {
    border-bottom: 0;
  }
  .bc-row dt {
    color: var(--bc-soft);
  }
  .bc-row dd {
    margin: 0;
    font-weight: 650;
    text-align: right;
  }
  .bc-channels {
    border: 0;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .bc-channels legend {
    width: 100%;
  }
  .bc-channel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--bc-line);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .bc-channel:has(input:checked) {
    border-color: var(--bc-text);
    font-weight: 650;
  }
  .bc-note {
    margin: 14px 0 0;
    font-size: 0.88rem;
    color: var(--bc-soft);
  }
  .bc-starter {
    margin-top: 18px;
    padding: 16px;
    border: 1px solid var(--bc-line);
    border-radius: 16px;
  }
  .bc-starter[hidden] {
    display: none;
  }
  .bc-starter .bc-label {
    margin-top: 0;
  }
  .bc-starter-body {
    margin-top: 6px;
    font-size: 0.88rem;
    color: var(--bc-soft);
  }
  .bc-starter-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--bc-text);
  }
  .bc-gbp {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--bc-line);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .bc-gbp-name {
    font-weight: 650;
    margin-top: 6px;
  }
  .bc-gbp-short {
    font-size: 0.88rem;
    color: var(--bc-soft);
    margin-top: 4px;
  }
</style>
