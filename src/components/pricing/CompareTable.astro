---
import { plans, compatibility, type PlanId, type Compat } from "../../lib/pricing";
import { useTranslations, type Locale } from "../../lib/i18n";
import NoteRef from "../NoteRef.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const tc = t.pricing.compare;
const tp = t.pricing.plans;

const planMeta: Record<PlanId, { name: string; monthly: string }> = {
  launch: { name: tp.launch.name, monthly: tp.launch.monthly },
  grow: { name: tp.grow.name, monthly: tp.grow.monthly },
  scale: { name: tp.scale.name, monthly: tp.scale.monthly },
};
const planIds: PlanId[] = ["launch", "grow", "scale"];

interface Row {
  text: string;
  note: number;
  launch: Compat;
  grow: Compat;
  scale: Compat;
}


// Feature rows, strictly from each tier's include list. Grow includes
// everything in Launch; Scale includes everything in Grow.
const featureRows: Row[] = [
  ...plans[0].features.map((f, i) => ({
    text: tp.launch.features[i],
    note: f.note ?? 0,
    launch: "I" as Compat,
    grow: "I" as Compat,
    scale: "I" as Compat,
  })),
  ...plans[1].features.map((f, i) => ({
    text: tp.grow.features[i],
    note: f.note ?? 0,
    launch: "N" as Compat,
    grow: "I" as Compat,
    scale: "I" as Compat,
  })),
  ...plans[2].features.map((f, i) => ({
    text: tp.scale.features[i],
    note: f.note ?? 0,
    launch: "N" as Compat,
    grow: "N" as Compat,
    scale: "I" as Compat,
  })),
];

const compatNames = tc.compatRows;
const compatRows = compatibility.map((c) => ({
  name: (compatNames as Record<string, string>)[c.key],
  note: c.note ?? 0,
  launch: c.launch,
  grow: c.grow,
  scale: c.scale,
}));

---

<section class="compare-section" aria-labelledby="compare-h">
  <div class="shell" data-reveal>
    <p class="eyebrow">{tc.eyebrow}</p>
    <h2 id="compare-h" class="display compare-title">{tc.title}</h2>
    <p class="compare-legend">
      <span class="legend-item">
        <svg viewBox="0 0 16 16" aria-hidden="true" class="legend-check"><path d="M3.5 8.2l3.2 3.2 5.8-6.8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {tc.legendIncluded}
      </span>
      <span class="legend-item"><span class="legend-dash" aria-hidden="true">✕</span> {tc.legendDash}</span>
      <span class="legend-item"><span class="cell-addon cell-addon--static">{tc.cellAddonShort}</span> {tc.legendAddon}</span>
    </p>

    <div class="table-scroll">
      <table class="compare-table">
        <caption class="visually-hidden">{tc.title}</caption>
        <thead>
          <tr>
            <th scope="col" class="col-feature">{tc.colFeature}</th>
            {planIds.map((pid) => (
              <th scope="col" class:list={["col-plan", pid === "grow" && "col-grow"]}>
                <span class="col-plan-name">{planMeta[pid].name}</span>
                <span class="col-plan-price mono">{planMeta[pid].monthly}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {featureRows.map((row) => (
            <tr>
              <th scope="row" class="row-head">
                {row.text}
                {row.note > 0 && <NoteRef locale={locale} note={row.note} />}
              </th>
              {planIds.map((pid) => (
                <td class:list={[pid === "grow" && "col-grow"]}>
                  {row[pid] === "I" && (
                    <span class="cell-check">
                      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.2l3.2 3.2 5.8-6.8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span class="visually-hidden">{tc.cellIncluded}</span>
                    </span>
                  )}
                  {row[pid] === "N" && (
                    <span class="cell-dash">
                      <span aria-hidden="true">✕</span>
                      <span class="visually-hidden">{tc.cellNotInTier}</span>
                    </span>
                  )}
                </td>
              ))}
            </tr>
          ))}
          <tr class="compat-divider">
            <td colspan="4">
              <span class="compat-divider-title">{tc.compatTitle}</span>
            </td>
          </tr>
          {compatRows.map((row) => (
            <tr class="compat-row">
              <th scope="row" class="row-head">
                {row.name}
                {row.note > 0 && <NoteRef locale={locale} note={row.note} />}
              </th>
              {planIds.map((pid) => (
                <td class:list={[pid === "grow" && "col-grow"]}>
                  {row[pid] === "I" && (
                    <span class="cell-check">
                      <span>{tc.cellIncluded}</span>
                    </span>
                  )}
                  {row[pid] === "N" && (
                    <span class="cell-dash">
                      <span aria-hidden="true">✕</span>
                      <span class="visually-hidden">{tc.cellNotInTier}</span>
                    </span>
                  )}
                  {row[pid] === "A" && (
                    <span class="cell-addon">{tc.cellAddonShort}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare-section {
    padding-block: clamp(48px, 8vw, 110px);
    /* Containment boundary: nothing in this section may ever widen the
       page on mobile (prevents the iOS "zoomed out" layout-viewport bug).
       hidden, not clip: iOS Safari sizes its layout viewport from the
       page's scrollable overflow and honors overflow hidden for that,
       while clip is ignored on older iOS and not honored by the
       viewport sizing. */
    overflow-x: hidden;
  }
  /* The shell clips the table's overflow too, so the section itself
     never reports scrollable overflow beyond the viewport: the wide
     table (min-width 600px on mobile) otherwise leaks into the
     shell/section scroll widths and iOS expands the layout viewport
     to fit it. The table still scrolls inside .table-scroll. */
  .compare-section .shell {
    overflow-x: hidden;
  }
  .compare-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 0.95;
    margin-top: 10px;
  }
  .compare-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .legend-check {
    width: 16px;
    height: 16px;
    color: var(--success);
  }
  .legend-dash {
    color: var(--muted);
    font-weight: 700;
  }

  .table-scroll {
    margin-top: 24px;
    /* Explicit width + min-width 0: the scroll container is exactly the
       shell width and can never be sized by its (600px) table content.
       The table scrolls inside this box; it must never widen the page.
       position relative: the table cells hold absolutely positioned
       .visually-hidden spans, and a static scroll container does not
       contain those, so they leaked to the document (scrollWidth 563)
       and iOS expanded the viewport to fit them. Relative makes this
       box their containing block, so the overflow clips here. */
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card-bg);
    box-shadow: var(--shadow-sm);
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    min-width: 640px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9rem;
  }
  .compare-table thead th {
    background: var(--card-bg);
    text-align: center;
    padding: 16px 12px;
    border-bottom: 2px solid var(--line-strong);
    vertical-align: bottom;
  }
  .col-feature {
    text-align: left !important;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .col-plan-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .col-plan-price {
    display: block;
    margin-top: 4px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  /* Grow column highlight */
  .col-grow {
    background: color-mix(in srgb, var(--plan-grow-glow) 10%, transparent) !important;
  }
  thead .col-grow {
    box-shadow: inset 0 3px 0 var(--plan-grow-bg);
  }

  .compare-table tbody th,
  .compare-table tbody td {
    padding: 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .compare-table tbody tr:last-child th,
  .compare-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .row-head {
    text-align: left;
    font-weight: 550;
    font-size: 0.88rem;
    line-height: 1.4;
    min-width: 220px;
  }
  .compare-table td {
    text-align: center;
  }
  .compare-table tbody tr {
    transition: background 0.2s;
  }
  .compare-table tbody tr:hover {
    background: color-mix(in srgb, var(--paper-2) 60%, transparent);
  }
  .compare-table tbody tr:hover .col-grow {
    background: color-mix(in srgb, var(--plan-grow-glow) 16%, transparent) !important;
  }

  .cell-check {
    display: inline-flex;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--success) 14%, transparent);
    color: var(--success);
    align-items: center;
    justify-content: center;
  }
  .cell-check svg {
    width: 13px;
    height: 13px;
  }
  /* Compat table: "Included" text instead of checkmark icon. */
  .compat-row .cell-check {
    width: auto;
    height: auto;
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .cell-dash {
    color: var(--muted);
    font-weight: 700;
    font-size: 1rem;
  }
  .cell-addon {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    color: var(--accent-soft-text);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .cell-addon--static {
    font-size: 0.72rem;
    padding: 3px 10px;
  }

  .compat-divider td {
    background: var(--paper-2);
    padding: 14px 12px;
  }
  .compat-divider-title {
    display: block;
    font-weight: 750;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  .compat-divider-legend {
    display: block;
    margin-top: 4px;
    font-size: 0.72rem;
    color: var(--muted);
  }


  /* Small screens: horizontal scroll with sticky first column. */
  @media (max-width: 760px) {
    .compare-table {
      min-width: 600px;
    }
    .compare-table thead th:first-child,
    .compare-table tbody th.row-head {
      position: sticky;
      left: 0;
      z-index: 2;
      background: var(--card-bg);
      box-shadow: 1px 0 0 var(--line);
    }
    .compare-table thead th:first-child {
      z-index: 4;
    }
    .row-head {
      min-width: 190px;
      max-width: 220px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compare-table tbody tr {
      transition: none;
    }
  }
</style>
