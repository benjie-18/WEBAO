---
import CartButton from "./CartButton.astro";
import type { Locale } from "../../lib/i18n";

// AI service cards for /pricing2 only.
// AI branch prices, live since the checkout wiring (Stripe prices in
// worker/checkout.ts PRICE_MAP, setup fees added server-side there).
// Cart buttons are the same component as everywhere else.
// Reuses the bundle-card classes from the Ads Pack card so the styling
// matches the current pricing page.
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props as Props;
const services = [
  {
    name: "AI Receptionist",
    product: "ai-receptionist",
    price: "C$299.99/mo",
    priceCents: 29999,
    setup: "C$299.99 one-time",
    accent: "ai--receptionist",
    includes: [
      "Answers calls as your business",
      "Takes messages and callback details",
      "500 minutes per month, fair use",
    ],
  },
  {
    name: "AI Website Chat",
    product: "ai-website-chat",
    price: "C$149.99/mo",
    priceCents: 14999,
    setup: "C$149.99 one-time",
    accent: "ai--chat",
    includes: [
      "Chat on your website",
      "Trained on your business",
    ],
  },
  {
    name: "AI Follow-up",
    product: "ai-followup",
    price: "C$99.99/mo",
    priceCents: 9999,
    setup: "C$99.99 one-time",
    accent: "ai--followup",
    includes: [
      "Missed-call text-back",
      "Review requests after a job",
    ],
  },
];
---

<div class="ai-pack-wrap">
  <div class="bundle-card ai-pack-card">
    <p class="bc-kicker">AI bundle, best value</p>
    <div class="bc-name-row">
      <h3 class="bc-name">AI Pack</h3>
      <CartButton locale={locale} product="ai-pack" name="AI Pack" priceCents={44999} interval="month" type="bundle" />
    </div>
    <p class="bc-price">C$449.99/mo</p>
    <ul class="bc-includes">
      <li><svg viewBox="0 0 16 16" aria-hidden="true" class="bc-check"><path d="M3.5 8.2l3.2 3.2 5.8-6.8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>AI Receptionist</span></li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" class="bc-check"><path d="M3.5 8.2l3.2 3.2 5.8-6.8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>AI Website Chat</span></li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" class="bc-check"><path d="M3.5 8.2l3.2 3.2 5.8-6.8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>AI Follow-up</span></li>
    </ul>
    <dl class="bc-meta">
      <div class="bc-row">
        <dt>Individual value:</dt>
        <dd>C$549.97/mo</dd>
      </div>
      <div class="bc-row">
        <dt>Monthly saving:</dt>
        <dd>C$99.98/mo</dd>
      </div>
    </dl>
  </div>
</div>

<div class="ai-grid">
  {services.map((s) => (
    <div class:list={["bundle-card", s.accent]}>
      <p class="bc-kicker">AI service</p>
      <div class="bc-name-row">
        <h3 class="bc-name">{s.name}</h3>
        <CartButton locale={locale} product={s.product} name={s.name} priceCents={s.priceCents} interval="month" type="addon" />
      </div>
      <p class="bc-price">{s.price}</p>
      <ul class="bc-includes">
        {s.includes.map((inc) => (
          <li><svg viewBox="0 0 16 16" aria-hidden="true" class="bc-check"><path d="M3.5 8.2l3.2 3.2 5.8-6.8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>{inc}</span></li>
        ))}
      </ul>
      <dl class="bc-meta">
        <div class="bc-row">
          <dt>Setup:</dt>
          <dd>{s.setup}</dd>
        </div>
      </dl>
      </div>
  ))}
</div>

<style>
  /* Card styles copied from AdsPackCard, because Astro scopes that
    component's styles to itself and they do not apply here. */
  .bundle-card {
    --bc-bg: var(--bundle-bg);
    --bc-text: var(--bundle-text);
    --bc-soft: var(--bundle-soft);
    --bc-line: var(--bundle-line);
    background: linear-gradient(165deg, var(--bundle-bg-2) 0%, var(--bc-bg) 60%);
    color: var(--bc-text);
    border: 1px solid var(--bc-line);
    border-radius: 26px;
    padding: clamp(22px, 3vw, 32px);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 400px;
  }
  .bc-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bc-soft);
  }
  .bc-name-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .bc-name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-top: 6px;
    line-height: 1;
  }
  .bc-price {
    margin-top: 10px;
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .bc-includes {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: grid;
    gap: 9px;
    font-size: 0.94rem;
  }
  .bc-includes li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
  }
  .bc-check {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--bc-text);
    opacity: 0.85;
    flex: none;
  }
  .bc-meta {
    margin: 18px 0 0;
    padding: 0;
    border-top: 1px solid var(--bc-line);
  }
  .bc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--bc-line);
    font-size: 0.88rem;
  }
  .bc-row:last-child {
    border-bottom: 0;
  }
  .bc-row dt {
    color: var(--bc-soft);
  }
  .bc-row dd {
    margin: 0;
    font-weight: 650;
    text-align: right;
  }
  .bc-note {
    margin: 14px 0 0;
    font-size: 0.88rem;
    color: var(--bc-soft);
  }
  .ai-grid .bundle-card,
  .ai-pack-wrap .bundle-card {
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .ai-grid .bundle-card:hover,
  .ai-pack-wrap .bundle-card:hover {
    transform: translateY(-2px);
  }
  /* Visual distinction between the three similar AI cards: a pronounced
     side border in the card's own colour, a matching kicker, and a
     subtle glow in the same colour. The pack used to share
     Receptionist's red; it now gets gold, so the two are unmistakable. */
  /* Explicit red: var(--accent) renders blue on this site, which made
     Receptionist identical to Chat's blue. Do not use --accent here. */
  .ai--receptionist {
    --ai-accent: #e5484d;
    border: 1.5px solid var(--ai-accent);
    border-top: 3px solid var(--ai-accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--ai-accent) 24%, transparent), 0 18px 40px rgba(10, 15, 28, 0.22);
  }
  .ai--receptionist .bc-kicker {
    color: #ff9a90;
  }
  .ai--chat {
    --ai-accent: #1877f2;
    border: 1.5px solid var(--ai-accent);
    border-top: 3px solid var(--ai-accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--ai-accent) 24%, transparent), 0 18px 40px rgba(10, 15, 28, 0.22);
  }
  .ai--chat .bc-kicker {
    color: #7db4f2;
  }
  .ai--followup {
    --ai-accent: #1a9e6a;
    border: 1.5px solid var(--ai-accent);
    border-top: 3px solid var(--ai-accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--ai-accent) 24%, transparent), 0 18px 40px rgba(10, 15, 28, 0.22);
  }
  .ai--followup .bc-kicker {
    color: #6cc79f;
  }
  .ai-pack-card {
    --ai-accent: #e8a020;
    border: 1.5px solid var(--ai-accent);
    border-top: 3px solid var(--ai-accent);
    box-shadow: 0 0 32px color-mix(in srgb, var(--ai-accent) 30%, transparent), 0 18px 40px rgba(10, 15, 28, 0.22);
  }
  .ai-pack-card .bc-kicker {
    color: #f2c14e;
  }
  .ai-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 48px;
  }
  .ai-pack-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 24px;
  }
  .ai-pack-wrap .bundle-card {
    max-width: 640px;
    margin: 0 auto;
  }
  @media (max-width: 900px) {
    .ai-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
