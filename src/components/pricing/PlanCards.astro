---
import { plans, type PlanId } from "../../lib/pricing";
import { useTranslations, type Locale } from "../../lib/i18n";
import { priceCentsFor } from "../../lib/cart-catalog";
import NoteRef from "../NoteRef.astro";

interface Props {
  locale: Locale;
  /* Pricing2 only: when true, the plan badge (e.g. "Most Popular") is
     rendered above the card instead of inside it. /pricing passes
     nothing, so its layout is untouched. */
  badgeAbove?: boolean;
}
const { locale, badgeAbove = false } = Astro.props as Props;
const t = useTranslations(locale);
const tp = t.pricing.plans;

const planData: Record<PlanId, (typeof tp)["launch"]> = {
  launch: tp.launch,
  grow: tp.grow,
  scale: tp.scale,
};

// Prices in cents for the cart, from the shared catalog: monthly, or annually
// in advance (2 months free). One source of truth with `worker/checkout.ts`.
const planCents = (id: PlanId, interval: "month" | "year"): number => priceCentsFor(id, interval) ?? 0;

---

<!-- Squircle clip-path fallback (objectBoundingBox superellipse). Used only
     where the native `corner-shape` property is unsupported. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <clipPath id="webao-squircle" clipPathUnits="objectBoundingBox">
      <path d="M 1.0000 0.5000 L 0.9995 0.6364 L 0.9980 0.6896 L 0.9954 0.7296 L 0.9918 0.7627 L 0.9872 0.7912 L 0.9815 0.8165 L 0.9747 0.8390 L 0.9669 0.8594 L 0.9579 0.8779 L 0.9478 0.8948 L 0.9365 0.9100 L 0.9239 0.9239 L 0.9100 0.9365 L 0.8948 0.9478 L 0.8779 0.9579 L 0.8594 0.9669 L 0.8390 0.9747 L 0.8165 0.9815 L 0.7912 0.9872 L 0.7627 0.9918 L 0.7296 0.9954 L 0.6896 0.9980 L 0.6364 0.9995 L 0.5000 1.0000 L 0.3636 0.9995 L 0.3104 0.9980 L 0.2704 0.9954 L 0.2373 0.9918 L 0.2088 0.9872 L 0.1835 0.9815 L 0.1610 0.9747 L 0.1406 0.9669 L 0.1221 0.9579 L 0.1052 0.9478 L 0.0900 0.9365 L 0.0761 0.9239 L 0.0635 0.9100 L 0.0522 0.8948 L 0.0421 0.8779 L 0.0331 0.8594 L 0.0253 0.8390 L 0.0185 0.8165 L 0.0128 0.7912 L 0.0082 0.7627 L 0.0046 0.7296 L 0.0020 0.6896 L 0.0005 0.6364 L 0.0000 0.5000 L 0.0005 0.3636 L 0.0020 0.3104 L 0.0046 0.2704 L 0.0082 0.2373 L 0.0128 0.2088 L 0.0185 0.1835 L 0.0253 0.1610 L 0.0331 0.1406 L 0.0421 0.1221 L 0.0522 0.1052 L 0.0635 0.0900 L 0.0761 0.0761 L 0.0900 0.0635 L 0.1052 0.0522 L 0.1221 0.0421 L 0.1406 0.0331 L 0.1610 0.0253 L 0.1835 0.0185 L 0.2088 0.0128 L 0.2373 0.0082 L 0.2704 0.0046 L 0.3104 0.0020 L 0.3636 0.0005 L 0.5000 0.0000 L 0.6364 0.0005 L 0.6896 0.0020 L 0.7296 0.0046 L 0.7627 0.0082 L 0.7912 0.0128 L 0.8165 0.0185 L 0.8390 0.0253 L 0.8594 0.0331 L 0.8779 0.0421 L 0.8948 0.0522 L 0.9100 0.0635 L 0.9239 0.0761 L 0.9365 0.0900 L 0.9478 0.1052 L 0.9579 0.1221 L 0.9669 0.1406 L 0.9747 0.1610 L 0.9815 0.1835 L 0.9872 0.2088 L 0.9918 0.2373 L 0.9954 0.2704 L 0.9980 0.3104 L 0.9995 0.3636 Z" />
    </clipPath>
  </defs>
</svg>

<div class="plan-grid" role="list" aria-label={locale === "fr" ? "Forfaits" : "Plans"}>
  {plans.map((def) => {
    const p = planData[def.id];
    return (
      <div class:list={["pcard-slot", `pcard-slot--${def.id}`]} role="listitem" data-reveal>
        {badgeAbove && p.badge !== "" && (
          <span class="pcard-badge pcard-badge--above">{p.badge}</span>
        )}
        <div class="pcard-lift">
          <div class="pcard-glow">
            <div class="pcard-frame squircle">
              <article class:list={["pcard", "squircle"]}>
                <div class="pcard-bg pcard-bg--dim" aria-hidden="true" />
                <div class="pcard-bg pcard-bg--full" aria-hidden="true" />
                <div class="pcard-content">
                  {!badgeAbove && p.badge !== "" && (
                    <span class="pcard-badge">{p.badge}</span>
                  )}
                  <div class="pcard-name-row">
                    <h3 class="pcard-name">{p.name}</h3>
                  </div>
                  <p class="pcard-price">
                    {p.monthly}
                    {p.priceNote > 0 && <NoteRef locale={locale} note={p.priceNote} />}
                  </p>
                  <p class="pcard-annual">{p.annual}</p>
                  <p class="pcard-desc">{p.desc}</p>
                  {p.inherits !== "" && <p class="pcard-inherits">{p.inherits}</p>}
                  <ul class="pcard-features">
                    {p.features.map((f, i) => {
                      const ref = def.features[i];
                      return (
                        <li>
                          <svg viewBox="0 0 16 16" aria-hidden="true" class="pcard-check">
                            <path
                              d="M3.5 8.2l3.2 3.2 5.8-6.8"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                          <span>
                            {f}
                            {ref.note !== undefined && ref.note > 0 && (
                              <NoteRef locale={locale} note={ref.note} />
                            )}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                  {/* Full-width plan CTA: same cart toggle as the old top-right
                      icon, with a price label that follows the billing term
                      (cart-ui keeps the [data-cta-label] text in sync). */}
                  <button
                    type="button"
                    class="btn btn--primary pcard-cta"
                    data-cart-btn
                    data-key={`${def.id}-month`}
                    data-product={def.id}
                    data-name={p.name}
                    data-price-cents={planCents(def.id, "month")}
                    data-interval="month"
                    data-type="plan"
                    data-price-year={planCents(def.id, "year")}
                    aria-label={t.cart.add.replace("{name}", p.name)}
                    title={t.cart.add.replace("{name}", p.name)}
                    aria-pressed="false"
                  >
                    <span
                      data-cta-label
                      data-month={tp.choose.replace("{name}", p.name).replace("{price}", p.monthly)}
                      data-year={tp.choose.replace("{name}", p.name).replace("{price}", p.annual.replace(/^\(|\)$/g, ""))}
                      data-added={tp.chosen.replace("{name}", p.name)}
                    >{tp.choose.replace("{name}", p.name).replace("{price}", p.monthly)}</span>
                  </button>
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
  /* True squircle: native corner-shape where supported, otherwise the
     generated superellipse clip-path above. */
  .squircle {
    border-radius: 34px;
  }
  @supports (corner-shape: squircle) {
    .squircle {
      corner-shape: squircle;
    }
  }
  @supports not (corner-shape: squircle) {
    .squircle {
      clip-path: url(#webao-squircle);
    }
  }

  .plan-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    /* Deep overlap: only ~50-60% of side cards visible until hovered. */
    --overlap: clamp(90px, 12vw, 160px);
    margin-top: clamp(28px, 4vw, 48px);
  }

  .pcard-slot {
    position: relative;
    min-width: 0;
    /* Per-plan palette hooks */
  }
  .pcard-slot--launch {
    z-index: 1;
    --pbg: var(--plan-launch-bg);
    --pbg-dim: var(--plan-launch-bg-dim);
    --pglow: var(--plan-launch-glow);
    --pline: var(--plan-launch-line);
  }
  .pcard-slot--grow {
    z-index: 2;
    --pbg: var(--plan-grow-bg);
    --pbg-dim: var(--plan-grow-bg-dim);
    --pglow: var(--plan-grow-glow);
    --pline: var(--plan-grow-line);
  }
  .pcard-slot--scale {
    z-index: 1;
    --pbg: var(--plan-scale-bg);
    --pbg-dim: var(--plan-scale-bg-dim);
    --pglow: var(--plan-scale-glow);
    --pline: var(--plan-scale-line);
  }

  /* Stable, non-transforming hit area per slot: hover/focus-within never
     moves the element the pointer is over, so no flicker where cards
     overlap. */
  .pcard-lift {
    position: relative;
    transition: transform 380ms var(--ease-out-expo);
  }
  /* Middle card: same size as siblings, slightly higher, floating above. */
  .pcard-slot--grow .pcard-lift {
    transform: translateY(-22px);
    margin-inline: calc(var(--overlap) * -1);
  }
  /* Side cards stay static on hover / keyboard focus: no lift, no scale,
     no z-index jump. Only their background brightens and their glow
     appears (below), like the middle card. */

  /* Glow lives on the unclipped wrapper: drop-shadow follows the squircle
     silhouette, which box-shadow cannot do under clip-path. */
  .pcard-glow {
    filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0));
    transition: filter 380ms var(--ease-out-expo);
  }
  .pcard-slot--grow .pcard-glow {
    filter: drop-shadow(0 18px 46px color-mix(in srgb, var(--pglow) 62%, transparent));
  }
  .pcard-slot--grow:hover .pcard-glow,
  .pcard-slot--grow:focus-within .pcard-glow {
    filter: drop-shadow(0 30px 80px var(--pglow));
  }
  .pcard-slot--launch:hover .pcard-glow,
  .pcard-slot--launch:focus-within .pcard-glow,
  .pcard-slot--scale:hover .pcard-glow,
  .pcard-slot--scale:focus-within .pcard-glow {
    filter: drop-shadow(0 26px 70px var(--pglow));
  }

  /* Border layer: a slightly larger squircle behind the card, its padding
     showing through as a hairline that follows the squircle shape. */
  .pcard-frame {
    padding: 1.5px;
    background: linear-gradient(
      145deg,
      var(--pline) 0%,
      transparent 32%,
      transparent 68%,
      var(--pline) 100%
    );
  }

  .pcard {
    position: relative;
    overflow: hidden;
    color: var(--plan-text);
  }
  .pcard-bg {
    position: absolute;
    inset: 0;
    transition: opacity 380ms var(--ease-out-expo);
    pointer-events: none;
  }
  .pcard-bg--dim {
    opacity: 1;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.07) 0%, transparent 55%),
      linear-gradient(165deg, var(--pbg-dim) 0%, color-mix(in srgb, var(--pbg-dim) 78%, black) 100%);
  }
  .pcard-bg--full {
    opacity: 0;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.10) 0%, transparent 55%),
      linear-gradient(165deg, var(--pbg) 0%, color-mix(in srgb, var(--pbg) 66%, black) 100%);
  }
  /* All three cards sit at dim strength at rest and brighten to full on
     hover / keyboard focus, Grow included: its red face is darker until
     hovered, then exactly as bright as before. */
  .pcard-slot--launch:hover .pcard-bg--dim,
  .pcard-slot--launch:focus-within .pcard-bg--dim,
  .pcard-slot--grow:hover .pcard-bg--dim,
  .pcard-slot--grow:focus-within .pcard-bg--dim,
  .pcard-slot--scale:hover .pcard-bg--dim,
  .pcard-slot--scale:focus-within .pcard-bg--dim {
    opacity: 0;
  }
  .pcard-slot--launch:hover .pcard-bg--full,
  .pcard-slot--launch:focus-within .pcard-bg--full,
  .pcard-slot--grow:hover .pcard-bg--full,
  .pcard-slot--grow:focus-within .pcard-bg--full,
  .pcard-slot--scale:hover .pcard-bg--full,
  .pcard-slot--scale:focus-within .pcard-bg--full {
    opacity: 1;
  }

  .pcard-content {
    position: relative;
    z-index: 1;
    /* Generous inline padding: the squircle curve cuts deep into the
       corners, so text needs extra inset to never touch the clipped edge. */
    padding: clamp(26px, 3.5vw, 40px) clamp(32px, 5vw, 52px);
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }
  .pcard-slot--grow .pcard-content {
    padding: clamp(30px, 4vw, 46px) clamp(36px, 5.5vw, 58px);
  }

  /* Above-card badge: anchored to the slot (position: relative), so it
     floats over the card's top edge instead of sitting inside the card.
     The card itself is clipped by its squircle, so the badge must live
     outside the card, at slot level. */
  .pcard-badge.pcard-badge--above {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    margin-bottom: 0;
    white-space: nowrap;
    /* Opaque card-colour background: the in-card badge is translucent
       white on a dark card, which reads as white on white once the
       badge floats above the card over the light page background. */
    background: var(--pbg);
    border-color: var(--pbg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
  }
  .pcard-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--plan-text);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid var(--pline);
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .pcard-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .pcard-slot--launch .pcard-name { text-align: left; }
  .pcard-slot--grow .pcard-name { text-align: center; }
  .pcard-slot--scale .pcard-name { text-align: right; }
  /* Desktop: the name must span the name row, otherwise the flex row shrinks
     it to its text and the per-slot text-align above positions nothing.
     (Mobile keeps its centered stacked layout, untouched.) */
  @media (min-width: 820px) {
    .pcard-name { flex: 1 1 auto; min-width: 0; }
  }
  .pcard-price {
    margin-top: 14px;
    font-size: clamp(2.08rem, 3.68vw, 3.2rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .pcard-slot--launch .pcard-price { text-align: left; }
  .pcard-slot--grow .pcard-price { text-align: center; }
  .pcard-slot--scale .pcard-price { text-align: right; }
  .pcard-annual {
    margin-top: 6px;
    font-size: 0.95rem;
    color: var(--plan-text-soft);
  }
  .pcard-desc {
    margin-top: 14px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--plan-text-soft);
  }
  .pcard-inherits {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--pline);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--plan-text);
  }
  .pcard-features {
    list-style: none;
    padding: 0;
    margin: 14px 0 6px;
    display: grid;
    gap: 9px;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .pcard-features li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
  }
  .pcard-check {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--plan-text);
    opacity: 0.9;
    flex: none;
  }

  /* Full-width plan CTA, pinned to the card bottom so all three cards'
     CTAs align. Crimson in both themes (the dark theme's primary token
     is royal blue); the added state reads as selected, not as a second
     primary button. */
  .pcard-cta {
    width: 100%;
    justify-content: center;
    margin-top: auto;
    min-height: 46px;
    background: #d92b22;
    border-color: #d92b22;
  }
  .pcard-cta:hover {
    background: #a81e14;
    border-color: #a81e14;
  }
  .pcard-cta.is-added {
    background: transparent;
    border-color: var(--pline);
    color: var(--plan-text);
    box-shadow: none;
  }
  .pcard-cta.is-added:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--pline);
  }

  /* Note refs inherit the card's light text. */
  .pcard .noteref {
    color: var(--plan-text);
  }

  /* 820–1023px: scale proportions down gracefully. */
  @media (max-width: 1023px) and (min-width: 820px) {
    .plan-grid {
      --overlap: 30px;
    }
    .pcard-slot--grow .pcard-lift {
      transform: translateY(-14px);
    }
    .pcard-content {
      padding: 26px 32px;
    }
  }

  /* Below 820px: separate, non-overlapping, equal-width stacked cards. */
  @media (max-width: 819px) {
    .plan-grid {
      display: flex;
      flex-direction: column;
      gap: 18px;
      --overlap: 0px;
    }
    /* All card text centered on mobile (overrides the per-slot
       left/center/right desktop alignment). */
    .pcard-slot .pcard-content {
      text-align: center;
    }
    .pcard-slot .pcard-name,
    .pcard-slot .pcard-price {
      text-align: center;
    }
    .pcard-slot .pcard-badge {
      align-self: center;
    }
    .pcard-slot .pcard-features li {
      justify-content: center;
    }
    .pcard-slot--grow .pcard-lift {
      transform: none;
      margin-inline: 0;
    }
    /* Full color on mobile; subtle glow when scrolled into view. */
    .pcard-bg--dim {
      opacity: 0;
    }
    .pcard-bg--full {
      opacity: 1;
    }
    .pcard-slot .pcard-glow {
      filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0));
      transition: filter 600ms var(--ease-out-expo);
    }
    .pcard-slot.is-visible .pcard-glow {
      filter: drop-shadow(0 14px 34px color-mix(in srgb, var(--pglow) 45%, transparent));
    }
    .pcard-slot--launch:hover .pcard-lift,
    .pcard-slot--launch:focus-within .pcard-lift,
    .pcard-slot--scale:hover .pcard-lift,
    .pcard-slot--scale:focus-within .pcard-lift {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard-lift,
    .pcard-glow,
    .pcard-bg {
      transition: none;
    }
    .pcard-slot--grow .pcard-lift {
      transform: none;
    }
  }
</style>
