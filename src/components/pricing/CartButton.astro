---
/**
 * CartButton — small cart button that morphs to checkmark when item is in cart.
 * 
 * Props:
 * - product: product key (e.g. "launch", "grow", "lead-pack")
 * - name: display name
 * - priceCents: price in cents
 * - interval: "month" | "year" | "one-time"
 * - type: "plan" | "bundle" | "addon"
 * - billing: which billing option this button represents ("monthly" | "yearly")
 */
interface Props {
  product: string;
  name: string;
  priceCents: number;
  interval: "month" | "year" | "one-time";
  type: "plan" | "bundle" | "addon";
}

const { product, name, priceCents, interval, type } = Astro.props as Props;
const key = `${product}-${interval}`;
---

<button
  type="button"
  class="cart-btn"
  data-cart-btn
  data-key={key}
  data-product={product}
  data-name={name}
  data-price-cents={priceCents}
  data-interval={interval}
  data-type={type}
  aria-label={`Add ${name} to cart`}
  title={`Add ${name} to cart`}
>
  <svg class="cart-btn-icon cart-btn-icon--cart" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <g clip-path="url(#cart-clip)">
      <path d="M5.33331 6H19.8672C20.4687 6 20.9341 6.52718 20.8595 7.12403L20.1095 13.124C20.0469 13.6245 19.6215 14 19.1172 14H16.5555H9.44442H7.99998" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
      <path d="M2 4H4.23362C4.68578 4 5.08169 4.30341 5.19924 4.74003L8.30076 16.26C8.41831 16.6966 8.81422 17 9.26638 17H19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
      <circle cx="10" cy="20" r="1.2" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
      <circle cx="17.5" cy="20" r="1.2" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
    </g>
    <defs>
      <clipPath id="cart-clip">
        <rect width="24" height="24" fill="white"/>
      </clipPath>
    </defs>
  </svg>
  <svg class="cart-btn-icon cart-btn-icon--check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M5 13.3636L8.03559 16.3204C8.42388 16.6986 9.04279 16.6986 9.43108 16.3204L19 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"/>
  </svg>
</button>

<style>
  .cart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--card-bg);
    color: #000;
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }
  [data-theme="dark"] .cart-btn {
    color: #fff;
  }
  .cart-btn:hover {
    border-color: var(--accent);
    transform: scale(1.05);
  }
  .cart-btn-icon {
    width: 20px;
    height: 20px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .cart-btn-icon--check {
    display: none;
  }
  .cart-btn.is-added {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .cart-btn.is-added .cart-btn-icon--cart {
    display: none;
  }
  .cart-btn.is-added .cart-btn-icon--check {
    display: block;
  }
</style>
