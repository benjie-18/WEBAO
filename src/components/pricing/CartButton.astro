---
/**
 * CartButton — small cart button that morphs to checkmark when item is in cart.
 * 
 * Props:
 * - product: product key (e.g. "launch", "grow", "lead-pack")
 * - name: display name
 * - priceCents: price in cents
 * - interval: "month" | "year" | "one-time"
 * - type: "plan" | "bundle" | "addon"
 * - yearlyPriceCents: annual price in cents, when the product can be billed
 *   yearly. The button then follows the pricing page's billing term toggle
 *   (data-price-year); without it the button always adds the base interval
 *   (one-time add-ons, or products with no annual price).
 *
 * The active key/price shown here is the monthly (base) variant; the client
 * cart layer (`src/lib/cart-ui.ts`) re-derives both from `data-*` at click
 * time and keeps `data-key` in sync for debugging.
 *
 * The button's accessible name comes from the locale's cart strings
 * (`t.cart.add`), so French pages do not announce an English label.
 * `locale` defaults to English for call sites that do not pass one.
 */
import { useTranslations, type Locale } from "../../lib/i18n";

interface Props {
  product: string;
  name: string;
  priceCents: number;
  interval: "month" | "year" | "one-time";
  type: "plan" | "bundle" | "addon";
  yearlyPriceCents?: number;
  locale?: Locale;
}

const { product, name, priceCents, interval, type, yearlyPriceCents, locale = "en" } = Astro.props as Props;
const key = `${product}-${interval}`;
const hasYearly = typeof yearlyPriceCents === "number" && Number.isFinite(yearlyPriceCents);
const addLabel = useTranslations(locale).cart.add.replace("{name}", name);
---

<button
  type="button"
  class="cart-btn"
  data-cart-btn
  data-key={key}
  data-product={product}
  data-name={name}
  data-price-cents={priceCents}
  data-interval={interval}
  data-type={type}
  data-price-year={hasYearly ? String(yearlyPriceCents) : undefined}
  aria-label={addLabel}
  title={addLabel}
  aria-pressed="false"
>
  <svg class="cart-btn-icon cart-btn-icon--cart" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M5.33331 6H19.8672C20.4687 6 20.9341 6.52718 20.8595 7.12403L20.1095 13.124C20.0469 13.6245 19.6215 14 19.1172 14H16.5555H9.44442H7.99998" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
    <path d="M2 4H4.23362C4.68578 4 5.08169 4.30341 5.19924 4.74003L8.30076 16.26C8.41831 16.6966 8.81422 17 9.26638 17H19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
    <circle cx="10" cy="20" r="1.2" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
    <circle cx="17.5" cy="20" r="1.2" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
  </svg>
  <svg class="cart-btn-icon cart-btn-icon--check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M5 13.3636L8.03559 16.3204C8.42388 16.6986 9.04279 16.6986 9.43108 16.3204L19 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"/>
  </svg>
</button>

<style>
  /* Theme tokens, not a `[data-theme="dark"]` override: Astro scopes every
     compound of a selector to this component, and <html> (where the theme
     attribute lives) is never part of this component's template, so such an
     override can never match. `--ink` already flips with the theme. */
  .cart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px: the site's minimum touch target (EscapeHatch, portal
       buttons, carousel nav). 36px was too small a tap target for the
       add-to-cart control on every pricing card. */
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--card-bg);
    color: var(--ink);
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }
  .cart-btn:hover {
    border-color: var(--accent);
    transform: scale(1.05);
  }
  .cart-btn-icon {
    width: 20px;
    height: 20px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .cart-btn-icon--check {
    display: none;
  }
  .cart-btn.is-added {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .cart-btn.is-added .cart-btn-icon--cart {
    display: none;
  }
  .cart-btn.is-added .cart-btn-icon--check {
    display: block;
  }
</style>
