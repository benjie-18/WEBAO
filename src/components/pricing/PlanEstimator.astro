---
// Quiz, redone from services: the first question is the service, then one
// follow-up per service. Website: pages + job -> Launch/Grow/Scale (the
// real plan boundaries: Launch 1-5 pages, Grow 5-10, Scale 10-20, with a
// booking or sales job needing the room Grow gives). Ads: channel ->
// Starter test (Meta), one channel, or both. AI: need -> Receptionist,
// Online Receptionist, Follow-up, or the AI Pack. Everything ->
// Growth Engine, no follow-up needed. Prices come from the cart catalog,
// never hardcoded, and the result button is a real cart button (same attrs
// as the pricing cards), so cart-ui keeps its label and added state in
// sync. Monthly-only products carry no yearly price, so the button follows
// the monthly term for them. A fixed service skips the service question
// and opens that service's follow-ups directly: on /pricing the visitor
// already picked the service with the pill, so the quiz there is
// website-only.
import { useTranslations, localizedPaths, type Locale } from "../../lib/i18n";
import { cartProducts } from "../../lib/cart-catalog";

interface Props {
  locale: Locale;
  // On /pricing the visitor is already comparing plans, so the
  // "Compare all plans" link is redundant there.
  showCompare?: boolean;
  // Fixed service: the quiz skips the service question and opens that
  // service's follow-ups directly. On /pricing the visitor already
  // picked the service with the pill, so the quiz there is website-only.
  service?: "website" | "ads" | "ai" | "all";
}

const { locale, showCompare = true, service } = Astro.props as Props;
const t = useTranslations(locale);
const e = t.estimator;
const tp = t.pricing.plans;
const ap = t.pricing.adsPack;
const ai = t.pricing.ai;
const paths = localizedPaths[locale];

const stripParens = (s: string) => s.replace(/^\(|\)$/g, "");
// Yearly label for the one recommendation with a yearly term but no i18n
// yearly string (Online Receptionist): same format as the AI cards.
const yearlyLabel = (cents: number) =>
  `C$${(cents / 100).toLocaleString("en-CA", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}${locale === "fr" ? "/an" : "/yr"}`;

const rec = (product: string, name: string, monthly: string, annual: string, why: string) => {
  const p = cartProducts[product];
  return {
    name,
    monthly,
    annual,
    monthCents: p?.monthCents ?? 0,
    yearCents: p?.yearCents ?? 0,
    type: p?.type ?? "addon",
    why,
  };
};
const recs = {
  launch: rec("launch", tp.launch.name, tp.launch.monthly, stripParens(tp.launch.annual), e.whyLaunch),
  grow: rec("grow", tp.grow.name, tp.grow.monthly, stripParens(tp.grow.annual), e.whyGrow),
  scale: rec("scale", tp.scale.name, tp.scale.monthly, stripParens(tp.scale.annual), e.whyScale),
  "ads-starter": rec("ads-starter", ap.starterTitle, ap.starterPrice, "", e.whyAdsStarter),
  "ads-meta": rec("ads-meta", `${ap.name} (${ap.metaLabel})`, ap.metaPrice, "", e.whyAdsSingle),
  "ads-google": rec("ads-google", `${ap.name} (${ap.googleLabel})`, ap.metaPrice, "", e.whyAdsSingle),
  "ads-both": rec("ads-both", `${ap.name} (${ap.bothLabel})`, ap.bothPrice, "", e.whyAdsBoth),
  "ai-receptionist": rec("ai-receptionist", t.start.selection.aiReceptionist, ai.receptionistPrice, "", e.whyReceptionist),
  aichat: rec(
    "aichat",
    t.start.selection.aiChat,
    ai.chatPrice,
    yearlyLabel(cartProducts["aichat"]?.yearCents ?? 0),
    e.whyOnlineReceptionist,
  ),
  "ai-followup": rec("ai-followup", t.start.selection.aiFollowup, ai.followupPrice, "", e.whyFollowup),
  "ai-pack": rec("ai-pack", t.start.selection.aiPack, ai.packPrice, stripParens(ai.packYearlyPrice), e.whyAiPack),
  "growth-engine": rec("growth-engine", t.pricing.bundles.engine.name, t.pricing.bundles.engine.price, "", e.whyGrowthEngine),
};
const def = recs.launch;
---

<section class="estimator" data-estimator data-recs={JSON.stringify(recs)} data-est-fixed-service={service} data-choose={tp.choose} data-chosen={tp.chosen} data-add={t.cart.add} aria-labelledby="estimator-h">
  <div class="shell estimator-inner" data-reveal>
    <p class="eyebrow">{e.eyebrow}</p>
    <h2 id="estimator-h" class="display estimator-title">{e.title}</h2>
    <p class="estimator-sub">{e.sub}</p>

    <form class="estimator-questions" data-estimator-form>
      <fieldset class="estimator-q" hidden={service !== undefined}>
        <legend>{e.qService}</legend>
        <label class="estimator-opt">
          <input type="radio" name="est-service" value="website" />
          <span>{e.serviceWebsite}</span>
        </label>
        <label class="estimator-opt">
          <input type="radio" name="est-service" value="ads" />
          <span>{e.serviceAds}</span>
        </label>
        <label class="estimator-opt">
          <input type="radio" name="est-service" value="ai" />
          <span>{e.serviceAi}</span>
        </label>
        <label class="estimator-opt">
          <input type="radio" name="est-service" value="all" />
          <span>{e.serviceAll}</span>
        </label>
      </fieldset>

      <div data-est-follow="website" hidden>
        <fieldset class="estimator-q">
          <legend>{e.qPages}</legend>
          <label class="estimator-opt">
            <input type="radio" name="est-pages" value="5" />
            <span>{e.pages5}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-pages" value="10" />
            <span>{e.pages10}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-pages" value="20" />
            <span>{e.pages20}</span>
          </label>
        </fieldset>

        <fieldset class="estimator-q">
          <legend>{e.qJob}</legend>
          <label class="estimator-opt">
            <input type="radio" name="est-job" value="inform" />
            <span>{e.jobInform}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-job" value="book" />
            <span>{e.jobBook}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-job" value="sell" />
            <span>{e.jobSell}</span>
          </label>
        </fieldset>
      </div>

      <div data-est-follow="ads" hidden>
        <fieldset class="estimator-q">
          <legend>{e.qChannel}</legend>
          <label class="estimator-opt">
            <input type="radio" name="est-channel" value="ads-starter" />
            <span>{e.channelStarter}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-channel" value="ads-meta" />
            <span>{e.channelMeta}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-channel" value="ads-google" />
            <span>{e.channelGoogle}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-channel" value="ads-both" />
            <span>{e.channelBoth}</span>
          </label>
        </fieldset>
      </div>

      <div data-est-follow="ai" hidden>
        <fieldset class="estimator-q">
          <legend>{e.qAiNeed}</legend>
          <label class="estimator-opt">
            <input type="radio" name="est-ai" value="ai-receptionist" />
            <span>{e.aiCalls}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-ai" value="aichat" />
            <span>{e.aiVisitors}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-ai" value="ai-followup" />
            <span>{e.aiQuotes}</span>
          </label>
          <label class="estimator-opt">
            <input type="radio" name="est-ai" value="ai-pack" />
            <span>{e.aiAll}</span>
          </label>
        </fieldset>
      </div>
    </form>

    <div class="estimator-result" data-estimator-result hidden>
      <p class="estimator-result-label">{e.resultLabel}</p>
      <p class="display estimator-result-plan" data-estimator-plan></p>
      <p class="estimator-result-price" data-estimator-price></p>
      <p class="estimator-result-why" data-estimator-why></p>
      <div class="estimator-result-actions">
        <button
          type="button"
          class="btn btn--primary"
          data-cart-btn
          data-estimator-cta
          data-key="launch-month"
          data-product="launch"
          data-name={def.name}
          data-price-cents={def.monthCents}
          data-price-year={def.yearCents}
          data-interval="month"
          data-type="plan"
          aria-label={t.cart.add.replace("{name}", def.name)}
          title={t.cart.add.replace("{name}", def.name)}
          aria-pressed="false"
        >
          <span
            data-cta-label
            data-month={tp.choose.replace("{name}", def.name).replace("{price}", def.monthly)}
            data-year={tp.choose.replace("{name}", def.name).replace("{price}", def.annual)}
            data-added={tp.chosen.replace("{name}", def.name)}
          >{tp.choose.replace("{name}", def.name).replace("{price}", def.monthly)}</span>
        </button>
        {showCompare && (
          <a href={paths.pricing} class="estimator-compare">{e.compare}</a>
        )}
      </div>
    </div>
  </div>
</section>

<script data-astro-rerun>
  // ClientRouter fix: without data-astro-rerun and the astro:page-load
  // listener below, the quiz is dead after a ClientRouter navigation
  // (for example, home -> /pricing): the module script runs once per
  // page load and never re-binds, so clicking an option does nothing.
  // Same failure the pills had, same fix. Plain JavaScript on purpose:
  // with data-astro-rerun, astro check treats this block as JS, and any
  // TypeScript annotation in it fails the deploy.
  function initEstimators() {
    // One init per estimator on the page; the follow-up questions for the
    // picked service show, the others hide and their answers clear, and
    // the result recomputes on every change. The cart button's dataset is
    // rewritten to the recommended product so cart-ui treats it exactly
    // like a pricing-card CTA.
    document.querySelectorAll("[data-estimator]").forEach(function (root) {
      var el = root;
      if (el.dataset.estimatorInit === "1") return;
      el.dataset.estimatorInit = "1";
      var result = root.querySelector("[data-estimator-result]");
      var planEl = root.querySelector("[data-estimator-plan]");
      var priceEl = root.querySelector("[data-estimator-price]");
      var whyEl = root.querySelector("[data-estimator-why]");
      var btn = root.querySelector("[data-estimator-cta]");
      var label = btn ? btn.querySelector("[data-cta-label]") : null;
      var recs = JSON.parse(el.dataset.recs || "{}");
      var chooseTemplate = el.dataset.choose || "";
      var chosenTemplate = el.dataset.chosen || "";
      var addTemplate = el.dataset.add || "";
      var fixedService = el.getAttribute("data-est-fixed-service") || null;
      var followGroups = Array.prototype.slice.call(root.querySelectorAll("[data-est-follow]"));
      var read = function (name) {
        var input = root.querySelector('input[name="' + name + '"]:checked');
        return input ? input.value : null;
      };
      var pickedService = function () {
        return fixedService || read("est-service");
      };
      var syncFollow = function () {
        var s = pickedService();
        followGroups.forEach(function (g) {
          var show = g.getAttribute("data-est-follow") === s;
          g.hidden = !show;
          if (!show) {
            g.querySelectorAll('input[type="radio"]').forEach(function (i) {
              i.checked = false;
            });
          }
        });
      };
      var render = function () {
        if (!result || !planEl || !priceEl || !whyEl) return;
        syncFollow();
        var s = pickedService();
        var id = null;
        if (s === "website") {
          var pages = read("est-pages");
          var job = read("est-job");
          if (!pages || !job) {
            result.hidden = true;
            return;
          }
          // Page count is the real plan boundary; a booking or sales job
          // needs the room Grow gives even on a small site.
          if (pages === "20") id = "scale";
          else if (pages === "10" || job !== "inform") id = "grow";
          else id = "launch";
        } else if (s === "ads") {
          id = read("est-channel");
        } else if (s === "ai") {
          id = read("est-ai");
        } else if (s === "all") {
          id = "growth-engine";
        }
        if (!id) {
          result.hidden = true;
          return;
        }
        var r = recs[id];
        if (!r) return;
        planEl.textContent = r.name;
        priceEl.textContent = r.monthly;
        whyEl.textContent = r.why;
        if (btn && label) {
          btn.dataset.key = id + "-month";
          btn.dataset.product = id;
          btn.dataset.name = r.name;
          btn.dataset.priceCents = String(r.monthCents);
          btn.dataset.priceYear = r.yearCents ? String(r.yearCents) : "";
          btn.dataset.type = r.type;
          btn.setAttribute("aria-label", addTemplate.replace("{name}", r.name));
          btn.title = addTemplate.replace("{name}", r.name);
          label.dataset.month = chooseTemplate.replace("{name}", r.name).replace("{price}", r.monthly);
          label.dataset.year = chooseTemplate.replace("{name}", r.name).replace("{price}", r.annual || r.monthly);
          label.dataset.added = chosenTemplate.replace("{name}", r.name);
          label.textContent = label.dataset.month;
          btn.setAttribute("aria-pressed", "false");
          btn.classList.remove("is-added");
        }
        result.hidden = false;
      };
      root.addEventListener("change", render);
      render();
    });
  }
  initEstimators();
  if (!window.__webaoEstimatorPL) {
    window.__webaoEstimatorPL = true;
    document.addEventListener("astro:page-load", initEstimators);
  }
</script>

<style>
  .estimator {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
    padding: 64px 0;
  }
  .estimator-inner { max-width: 860px; }
  .estimator-title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: .95;
    margin-top: 12px;
  }
  .estimator-sub { color: var(--muted); margin-top: 10px; }
  .estimator-questions { display: grid; gap: 24px; margin-top: 28px; }
  /* The service question hides when the quiz takes a fixed service.
     The .estimator-q rule below sets display: grid, which would beat
     the browser's built-in hidden styling, so this rule restores it. */
  .estimator-q[hidden] {
    display: none;
  }
  .estimator-q {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .estimator-q legend {
    font-weight: 650;
    font-size: 15px;
    margin-bottom: 4px;
    padding: 0;
  }
  .estimator-opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card-bg);
    cursor: pointer;
    font-size: 14.5px;
  }
  .estimator-opt:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft, rgba(217, 43, 34, 0.06));
  }
  .estimator-opt input {
    accent-color: var(--accent);
    width: 18px;
    height: 18px;
    flex: none;
    margin: 0;
  }
  .estimator-result {
    margin-top: 28px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card-bg);
    box-shadow: var(--shadow-sm);
  }
  .estimator-result-label {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .estimator-result-plan {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1;
    margin-top: 8px;
  }
  .estimator-result-price {
    font-size: 1.1rem;
    font-weight: 650;
    margin-top: 8px;
  }
  .estimator-result-why { color: var(--muted); margin-top: 8px; line-height: 1.55; }
  .estimator-result-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }
  .estimator-compare {
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 720px) {
    .estimator-q { grid-template-columns: repeat(3, 1fr); }
    .estimator-q legend { grid-column: 1 / -1; }
  }
</style>
