---
import { useTranslations, localizedPaths, type Locale } from "../../lib/i18n";
import { styleFamilies } from "../../lib/demos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];
---

<section class="contact-hero grain">
  <div class="shell">
    <div class="contact-grid">
      <div class="contact-copy" data-reveal>
        <div class="eyebrow">{t.contact.hero.eyebrow}</div>
        <h1 class="display" style="font-size: var(--text-h1); margin-top:12px;" set:html={t.contact.hero.title}></h1>
        <p class="prose" style="margin-top:14px; max-width:52ch;">
          {t.contact.hero.desc}
        </p>

        <!-- #25: one contact card (email + location rows) and one "more"
             card (trust + browse demos + existing clients), instead of four
             competing boxes. -->
        <div class="contact-cards">
          <div class="c-card">
            <a href="mailto:contact@webao.ca" class="c-row">
              <span class="c-icon" aria-hidden="true">✉</span>
              <span>
                <strong>{t.contact.hero.email}</strong>
                <span class="mono">{t.contact.hero.emailNote}</span>
              </span>
              <span aria-hidden="true" style="margin-left:auto;">→</span>
            </a>
            <div class="c-row">
              <span class="c-icon" aria-hidden="true">📍</span>
              <span>
                <strong>{t.contact.hero.location}</strong>
                <span class="mono">{t.contact.hero.locationNote}</span>
              </span>
            </div>
          </div>
        </div>

        <div class="testi">
          <div class="trust-mini mono">
            {t.contact.hero.trust.map(tr => <span>{tr}</span>)}
          </div>
          <p>{t.contact.hero.browseText}</p>
          <a href={paths.start} class="mono" style="display:inline-block; margin-top:8px; font-size:12px; font-weight:600; color: var(--accent-text); text-decoration: underline; text-underline-offset:3px;">{t.contact.hero.browseCta}</a>
          <p class="mono" style="margin-top:12px; font-size:12px; color: var(--muted); line-height:1.6;">{t.contact.hero.clientText} <a href={paths.support} style="color: var(--accent-text); font-weight:600; text-decoration: underline; text-underline-offset:3px;">{t.contact.hero.clientCta}</a></p>
        </div>
      </div>

      <div class="contact-form-wrap" data-reveal style="--d:120ms">
        <form
          class="form"
          id="contact-form"
          novalidate
          data-validation-error={t.contact.form.validationError}
          data-success={t.contact.form.success}
          data-ready={t.contact.form.ready}
        >
          <div class="form-head">
            <h2>{t.contact.form.title}</h2>
          </div>

          <label>{t.contact.form.name}
            <input name="name" placeholder={t.contact.form.namePlaceholder} autocomplete="name" required />
            <p class="field-error" data-error-for="name" hidden>{t.contact.form.errorName}</p>
          </label>

          <label>{t.contact.form.email}
            <input name="email" type="email" placeholder={t.contact.form.emailPlaceholder} autocomplete="email" required />
            <p class="field-error" data-error-for="email" hidden>{t.contact.form.errorEmail}</p>
          </label>

          <label>{t.contact.form.trade}
            <input name="trade" placeholder={t.contact.form.tradePlaceholder} autocomplete="off" />
          </label>

          <label>{t.contact.form.city}
            <input name="city" placeholder={t.contact.form.cityPlaceholder} autocomplete="address-level2" />
          </label>

          <label>{t.contact.form.demo}
            <select name="demo">
              <option value="" selected>{t.contact.form.demoPlaceholder}</option>
              {styleFamilies.map((family) => (
                <option value={t.demos.families[family]}>{t.demos.families[family]}</option>
              ))}
            </select>
          </label>

          <p class="form-shortlist" data-contact-shortlist hidden>
            <strong>{t.demos.shortlistTitle}:</strong>
            <span data-contact-shortlist-names></span>
            <a href={paths.demos}>{t.demos.shortlistChange}</a>
          </p>
          <input type="hidden" name="shortlist" data-contact-shortlist-field value="" />

          <label>{t.contact.form.message}
            <textarea name="message" rows="5" placeholder={t.contact.form.messagePlaceholder} required></textarea>
            <p class="field-error" data-error-for="message" hidden>{t.contact.form.errorMessage}</p>
          </label>

          <div class="form-meta mono">
            <span>{t.contact.form.privacy}</span>
          </div>

          <button type="submit" class="btn btn--primary" style="width:100%; justify-content:center; margin-top:6px;">
            {t.contact.form.submit}
          </button>
          <div id="form-status" role="status" aria-live="polite" class="form-status mono" hidden></div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Secondary info, as FAQ: the three info cards are gone, their
  content lives here unchanged (titles become the questions). -->
<section class="section section--tight grain" style="background: var(--paper-2); border-top:1px solid var(--line);">
  <div class="shell">
    <h2 class="faq-title" data-reveal>{t.contact.info.faqTitle}</h2>
    <div class="faq-list" data-reveal>
      <details class="faq-item" open>
        <summary>{t.contact.info.reply.title}</summary>
        <div class="faq-body">
          <div class="faq-body-inner">
          <p>{t.contact.info.reply.desc}</p>
          <ul>
            {t.contact.info.reply.bullets.map(b => <li>{b}</li>)}
          </ul>
          <div class="mono" style="margin-top:10px; font-size:11px; color: var(--muted);">{t.contact.info.reply.note}</div>
          </div>
        </div>
      </details>
      <details class="faq-item">
        <summary>{t.contact.info.send.title}</summary>
        <div class="faq-body">
          <div class="faq-body-inner">
          <ul>
            {t.contact.info.send.bullets.map(b => <li>{b}</li>)}
          </ul>
          <div class="mono" style="margin-top:10px; font-size:11px; color: var(--muted);">{t.contact.info.send.note}</div>
          </div>
        </div>
      </details>
      <details class="faq-item">
        <summary>{t.contact.info.plain.title}</summary>
        <div class="faq-body">
          <div class="faq-body-inner">
          <p>{t.contact.info.plain.desc}</p>
          <div class="mono" style="display:grid; gap:6px; font-size:12.5px;">
            {t.contact.info.plain.lines.map(l => <span>{l}</span>)}
          </div>
          <a href="mailto:contact@webao.ca" class="btn btn--dark btn--sm" style="margin-top:14px;">{t.contact.info.plain.cta}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  import { readShortlist, shortlistNames } from "../../lib/shortlist";

  function initContactPage() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status') as HTMLElement | null;
    const locale = document.documentElement.lang === 'fr' ? 'fr' : 'en';

    // Shortlist (#50): show the visitor's shortlisted demos and carry
    // them with the message so the owner sees which directions they liked.
    const shortlistEl = document.querySelector('[data-contact-shortlist]') as HTMLElement | null;
    const shortlistNamesEl = document.querySelector('[data-contact-shortlist-names]') as HTMLElement | null;
    const shortlistField = document.querySelector('[data-contact-shortlist-field]') as HTMLInputElement | null;
    const shortlistIds = readShortlist(window);
    if (shortlistIds.length > 0 && shortlistEl && shortlistNamesEl && shortlistField) {
      const names = shortlistNames(shortlistIds);
      shortlistNamesEl.textContent = names.join(', ');
      shortlistField.value = names.join(', ');
      shortlistEl.hidden = false;
    }

    if (form && status && !form.dataset.bound) {
      form.dataset.bound = '1';
      const validationError = form.getAttribute('data-validation-error') || 'Please fill in the required fields with a valid email, and tick the contact checkbox.';
      const successMsg = form.getAttribute('data-success') || (locale === 'fr'
        ? 'Message envoyé. On vous répond en un jour ouvrable.'
        : "Message sent. We'll reply within one business day.");
      const readyText = form.getAttribute('data-ready') || (locale === 'fr' ? 'Envoyé ✓' : 'Sent ✓');
      // Same shape as the start page and the worker (EMAIL_RE): an address
      // like "a@" must fail here with the validation message, not reach the
      // API and come back as a misleading "could not send" error.
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      // #74: inline per-field errors (shown on blur and on a failed submit),
      // so the visitor sees which field failed instead of only the generic
      // status line.
      const fieldError = (fieldName: string) =>
        form.querySelector(`[data-error-for="${fieldName}"]`) as HTMLElement | null;
      const validateField = (fieldName: string): boolean => {
        const input = form.querySelector(`[name="${fieldName}"]`) as HTMLInputElement | null;
        if (!input) return true;
        const value = input.value.trim();
        const ok = fieldName === "email" ? EMAIL_RE.test(value) : value !== "";
        input.setAttribute("aria-invalid", ok ? "false" : "true");
        const err = fieldError(fieldName);
        if (err) err.hidden = ok;
        return ok;
      };
      ["name", "email", "message"].forEach((fieldName) => {
        const input = form.querySelector(`[name="${fieldName}"]`) as HTMLElement | null;
        input?.addEventListener("blur", () => validateField(fieldName));
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (form.dataset.sending === '1') return;
        const data = new FormData(form as HTMLFormElement);
        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const message = String(data.get('message') || '').trim();
        const trade = String(data.get('trade') || '').trim();
        const city = String(data.get('city') || '').trim();
        const demo = String(data.get('demo') || '').trim();
        let valid = true;
        if (!name || !email || !message) valid = false;
        if (!EMAIL_RE.test(email)) valid = false;
        if (!valid) {
          ["name", "email", "message"].forEach((fieldName) => validateField(fieldName));
          (status as HTMLElement).hidden = false;
          status.textContent = validationError;
          status.classList.remove('form-status--success');
          status.classList.add('form-status--error');
          // Focus the first field that failed, like the start page does,
          // instead of leaving focus on the submit button.
          const firstInvalid = (!name ? form.querySelector('[name="name"]') : null)
            ?? (!EMAIL_RE.test(email) ? form.querySelector('[name="email"]') : null)
            ?? (!message ? form.querySelector('[name="message"]') : null);
          (firstInvalid as HTMLElement | null)?.focus();
          return;
        }
        // In-flight guard: a second click (or Enter) while the request is
        // pending must not send a duplicate message to the inbox.
        form.dataset.sending = '1';
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (submitBtn) submitBtn.disabled = true;
        // Send the message to the site inbox (fail-silent is not an option here;
        // show an error if the API is unreachable).
        fetch("/api/forms/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          keepalive: true,
          body: JSON.stringify({
            form: "contact",
            fields: { name, email, message, trade, city, demo, page: location.pathname },
          }),
        })
          .then((r) => r.json())
          .then((res) => {
            if (res && res.ok) {
              status.hidden = false;
              status.textContent = successMsg;
              status.classList.remove('form-status--error');
              status.classList.add('form-status--success');
              const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
              if (btn) { btn.textContent = readyText; btn.disabled = true; }
              form.querySelectorAll('input, textarea').forEach((el) => { (el as HTMLInputElement).disabled = true; });
            } else {
              throw new Error('submit failed');
            }
          })
          .catch(() => {
            form.dataset.sending = '0';
            if (submitBtn) submitBtn.disabled = false;
            status.hidden = false;
            status.textContent = locale === 'fr'
              ? "Envoi impossible pour le moment. Écrivez-nous directement à contact@webao.ca."
              : "Could not send right now. Email us directly at contact@webao.ca.";
            status.classList.remove('form-status--success');
            status.classList.add('form-status--error');
          });
      });
    }
  }

  // astro:page-load can land after a fast first interaction, so bind on
  // script evaluation too; the dataset guard prevents double-binding.
  initContactPage();
  document.addEventListener('astro:page-load', initContactPage);
</script>

<style>
  .contact-hero { padding-block: clamp(28px,5vw,64px); background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%); border-bottom: 1px solid var(--line); }
  .contact-grid { display:grid; grid-template-columns: 1fr 1.05fr; gap: clamp(24px,4vw,40px); align-items:start; }
  .contact-copy { position: sticky; top: calc(var(--header-h) + 16px); }
  .contact-cards { margin-top:18px; display:grid; gap:10px; }
  .c-card { background: var(--card-bg); border:1px solid var(--line); border-radius:14px; padding:14px; box-shadow: var(--shadow-sm); }
  .c-row { display:flex; align-items:center; gap:12px; }
  .c-row + .c-row { border-top:1px solid var(--line); margin-top:12px; padding-top:12px; }
  a.c-row { color: inherit; text-decoration: none; }
  a.c-row:hover strong { text-decoration: underline; text-underline-offset:3px; }
  .c-icon { width:36px; height:36px; border-radius:10px; background: var(--paper-2); border:1px solid var(--line); display:grid; place-items:center; font-size:14px; }
  .c-card strong { display:block; font-size:14.5px; letter-spacing:-0.02em; }
  .c-card .mono { display:block; font-size:11px; color: var(--muted); margin-top:2px; }
  .trust-mini { margin-top:14px; display:flex; gap:8px; flex-wrap:wrap; font-size:11px; color: var(--muted); }
  .testi { margin-top:18px; background: var(--card-bg); border:1px solid var(--line); border-radius:14px; padding:16px; box-shadow: var(--shadow-sm); }
  .testi .trust-mini { margin: 0 0 12px; }
  .testi p { font-size:14px; line-height:1.6; color: var(--ink-3); }
  .contact-form-wrap { display:grid; gap:10px; }
  .form { background: var(--card-bg); border:1px solid var(--line); border-radius:18px; padding:18px; box-shadow: var(--shadow-md); display:grid; gap:14px; }
  .form-head h2 { font-size: 1.35rem; letter-spacing:-0.02em; font-weight:750; line-height:1; }
  .form-head p { margin-top:4px; font-size:11px; color: var(--muted); }
  label { display:grid; gap:6px; font-size:13px; font-weight:600; letter-spacing:-0.01em; color: var(--ink-3); }
  input, select, textarea { width:100%; min-height: 48px; padding:10px 12px; border:1px solid var(--line-strong); border-radius:10px; background: var(--paper-3); font-size:14px; font-weight:500; color: var(--ink); transition: border-color .2s, box-shadow .2s; }
  textarea { resize: vertical; min-height: 72px; }
  input:focus, select:focus, textarea:focus { outline:none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--focus-ring); }
  .form-meta { display:grid; gap:8px; font-size:11px; color: var(--muted); line-height:1.5; }
  .form-shortlist { font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0; }
  .form-shortlist a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; margin-left: 6px; }
  .form-status { padding:10px 12px; border-radius:10px; border:1px solid var(--line); font-size:12.5px; line-height:1.5; }
  /* #74: inline per-field validation errors. */
  .field-error { color: var(--accent-text); font-size: 12.5px; line-height: 1.4; margin: 6px 0 0; }
  .form input[aria-invalid="true"], .form textarea[aria-invalid="true"], .form select[aria-invalid="true"] { border-color: var(--accent); }
  .faq-title { font-size: 1.6rem; letter-spacing:-0.02em; font-weight:750; margin-bottom: 16px; }
  .faq-list { display:grid; gap:12px; max-width: 720px; }
  .faq-item { background: var(--card-bg); border:1px solid var(--line); border-radius:16px; padding: 16px 18px; box-shadow: var(--shadow-sm); }
  .faq-item summary { cursor: pointer; font-size:14.5px; letter-spacing:-0.02em; font-weight:750; }
  .faq-body { display: grid; grid-template-rows: 0fr; margin-top: 0; opacity: 0; transition: grid-template-rows .25s ease-out, opacity .25s ease-out, margin .25s ease-out; }
  .faq-body-inner { overflow: hidden; min-height: 0; }
  .faq-item[open] .faq-body { grid-template-rows: 1fr; margin-top: 10px; opacity: 1; }
  .faq-body p { font-size:13px; color: var(--muted); line-height:1.5; }
  .faq-body ul { list-style:none; padding:0; margin-top:10px; display:grid; gap:6px; font-size:13px; line-height:1.5; color: var(--ink-3); }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } .contact-copy { position: static; } }
</style>
