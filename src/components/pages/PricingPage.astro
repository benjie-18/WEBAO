---
import { useTranslations, localizedPaths, type Locale } from "../../lib/i18n";
import PlanCards from "../pricing/PlanCards.astro";
import BundleCarousel from "../pricing/BundleCarousel.astro";
import AddonList from "../pricing/AddonList.astro";
import CompareTable from "../pricing/CompareTable.astro";
import NoteRef from "../NoteRef.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];
const termsPath = locale === "fr" ? "/fr/conditions" : "/terms";
---

<!-- Hero: page title + the plan's own billing lines -->
<section class="pricing-hero-new grain">
  <div class="shell pricing-hero-inner" data-reveal>
    <h1 class="display pricing-title">{t.pricing.hero.title}</h1>
    <ul class="billing-strip" aria-label={t.pricing.hero.title}>
      {t.pricing.hero.strip.map((s) => (
        <li>
          <span>{s.text}</span>
          {s.note > 0 && <NoteRef locale={locale} note={s.note} />}
        </li>
      ))}
    </ul>
    <div class="cluster pricing-hero-cta">
      <a href={paths.start} class="btn btn--primary">{t.nav.startSite}</a>
    </div>
  </div>
</section>

<!-- Plan cards -->
<section class="section plans-section" aria-labelledby="plans-h">
  <div class="shell">
    <h2 id="plans-h" class="visually-hidden">{t.pricing.plansTitle}</h2>
    <PlanCards locale={locale} />
  </div>
</section>

<BundleCarousel locale={locale} />

<AddonList locale={locale} />

<CompareTable locale={locale} />

<!-- Terms -->
<section class="terms-band grain" aria-labelledby="terms-h">
  <div class="shell terms-band-inner" data-reveal>
    <div>
      <p class="eyebrow">{t.pricing.hero.eyebrow}</p>
      <h2 id="terms-h" class="display terms-band-title">{t.pricing.termsCta.title}</h2>
    </div>
    <a href={termsPath} class="btn btn--on-dark btn--lg">{t.pricing.termsCta.label}</a>
  </div>
</section>

<style>
  .pricing-hero-new {
    padding-block: clamp(40px, 7vw, 88px) clamp(8px, 2vw, 16px);
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .pricing-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pricing-title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.95;
    margin-top: 12px;
    letter-spacing: -0.02em;
  }
  .billing-strip {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    max-width: 72ch;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .billing-strip li {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }
  .billing-strip li + li::before {
    content: "·";
    margin-right: 18px;
    color: var(--muted-2);
  }
  .pricing-hero-cta {
    margin-top: 24px;
    justify-content: center;
  }

  .plans-section {
    padding-top: clamp(8px, 2vw, 16px);
    overflow-x: clip;
  }

  .terms-band {
    background: var(--section-dark-bg);
    color: var(--section-dark-text);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .terms-band-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }
  .terms-band .eyebrow {
    color: rgba(248, 245, 239, 0.5);
  }
  .terms-band-title {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 0.95;
    margin-top: 10px;
  }
  .btn--lg {
    padding: 16px 30px;
    font-size: 1.02rem;
  }

</style>
