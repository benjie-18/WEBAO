---
import { useTranslations, localizedPaths, getDemos, type Locale } from "../../lib/i18n";
import { styleFamilies, getDemoFamily, tradeFilters } from "../../lib/demos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];
const demos = getDemos(locale);

// Demos with published standalone microsites
const liveDemos = new Set(["nora", "mira", "atelier-nord", "encre-brute", "kanso", "leduc", "boise", "sora", "forma", "toit-fils", "verte", "lune", "maison-lune", "finition-r", "pouf", "hexline", "papier-ciseaux", "studio-reve", "cyberdoll", "pixelforge", "vhs-dreams", "prism", "tactile", "lattice", "maximal", "atelier-caractere", "esquisse", "brume", "sahara-sage", "aeris"]);
// Hidden from the catalog: style already covered by another demo (boba-club = Y2K, covered by cyberdoll)
const hiddenDemos = new Set(["boba-club"]);
const visibleDemos = demos.filter((d) => !hiddenDemos.has(d.id));
const demoHref = (id: string) => `${paths.demos}/${id}`;

// Style families for the filter: broad, plain-language groups
const families = styleFamilies;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Baloo+2:wght@700&family=Fraunces:ital,wght@1,600&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet" />

<section class="demos-hero grain">
  <div class="shell">
    <div class="demos-hero-grid" data-reveal>
      <div>
        <div class="eyebrow">{t.demos.hero.eyebrow}</div>
        <h1 class="display" style="font-size: clamp(2.6rem, 6vw, 5rem); line-height:.88; margin-top:12px;" set:html={t.demos.hero.title}></h1>
        <p class="prose" style="margin-top:14px; max-width: 52ch; font-size: 15px;">
          {t.demos.hero.desc}
        </p>
        <div class="mono" style="margin-top:10px; font-size:11px; color: var(--muted);">{t.demos.hero.countNote}</div>
      </div>
      <div class="demos-hero-card" aria-hidden="true">
        <div class="demos-hero-preview">
          <div class="mono" style="font-size:10px; opacity:.5;">{t.demos.hero.howTitle}</div>
          <ol class="mono" style="margin-top:12px; display:grid; gap:8px; font-size:12px; line-height:1.5; color: var(--ink-3); list-style: none; padding:0;">
            {t.demos.hero.howSteps.map((step, i) => (
              <li><strong style="color: var(--ink);">{i+1}. {step.split(":")[0]}</strong>{step.includes(":") ? `: ${step.split(":").slice(1).join(":")}` : ""}</li>
            ))}
          </ol>
          <div style="margin-top:14px; height:1px; background: var(--line);"></div>
          <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
            {t.demos.hero.pills.map((pill, i) => (
              <span class="pill mono" style={i===0 ? "background: var(--ink); color: var(--paper);" : "background: var(--paper-2); border:1px solid var(--line);"}>{pill}</span>
            ))}
          </div>
        </div>
        <div class="mono" style="margin-top:10px; font-size:10px; text-align:center; color: var(--muted);">{t.demos.hero.fictionalNote}</div>
      </div>
    </div>

    <!-- Controls -->
    <div class="controls" data-reveal style="--d:100ms">
      <label class="search">
        <span aria-hidden="true">⌕</span>
        <input id="search" type="search" placeholder={t.demos.searchPlaceholder} autocomplete="off" aria-label={t.common.search} />
        <span class="mono" style="font-size:11px; color: var(--muted); white-space:nowrap;" data-count>{t.demos.searchCount.replace("{count}", String(visibleDemos.length))}</span>
      </label>
      <div class="filters" role="group" aria-label={t.demos.styleLabel}>
        <button class="chip chip--active" data-filter="All" aria-pressed="true">{t.demos.allStyles}</button>
        {families.map((family) => (
          <button class="chip" data-filter={family} aria-pressed="false">{t.demos.families[family]}</button>
        ))}
      </div>
      <div class="filters" role="group" aria-label={t.demos.tradeLabel}>
        <button class="chip chip--active" data-trade-filter="All" aria-pressed="true">{t.demos.allTrades}</button>
        {tradeFilters.map((trade) => (
          <button class="chip" data-trade-filter={trade} aria-pressed="false">{t.demos.trades[trade]}</button>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 20px;">
  <div class="shell">
    <div id="demo-grid" class="demo-grid" data-reveal>
      {visibleDemos.map((d, i) => (
        <a href={liveDemos.has(d.id) ? demoHref(d.id) : "#"} class="demo-card-demo" data-category={d.category} data-search={`${d.name} ${d.category} ${d.city} ${d.tone} ${d.palette} ${d.localizedDescription}`.toLowerCase()} data-reveal style={`--d:${(i%3)*80}ms`} data-demo-id={d.id} data-demo-tone={d.tone} data-demo-family={getDemoFamily(d.id)} data-demo-trade={d.trade ?? ""} data-demo-palette={d.palette} data-live={liveDemos.has(d.id) ? "true" : undefined} aria-label={`${t.demos.searchPlaceholder} ${d.name}`}>
          {liveDemos.has(d.id) ? (
            <div class={`demo-thumb dthumb dthumb-${d.id}`}>
              {d.id === "nora" && (
                <div class="dthumb-art">
                  <div class="dn-top"><span class="dn-dot" aria-hidden="true"></span>{locale === "fr" ? "LAVAL · ARTISANS" : "LAVAL · TRADES"}</div>
                  <div class="dn-name">NORA<span aria-hidden="true">⚡</span></div>
                  <div class="dn-bar">24/7 DISPATCH</div>
                </div>
              )}
              {d.id === "mira" && (
                <div class="dthumb-art">
                  <div class="dm-kicker">{locale === "fr" ? "cantine · vieux-montréal" : "cantine · old montreal"}</div>
                  <div class="dm-name">Mira</div>
                  <div class="dm-pills"><span class="dm-pill-solid">Menu</span><span class="dm-pill-line">{locale === "fr" ? "Réserver" : "Reserve"}</span></div>
                </div>
              )}
              {d.id === "atelier-nord" && (
                <div class="dthumb-art">
                  <div class="da-status"><span class="da-pulse" aria-hidden="true"></span>BAY 01 · IN PROGRESS</div>
                  <div class="da-name">ATELIER NORD</div>
                  <div class="da-chips"><span>140 PTS</span><span>0.01°</span><span>SAME DAY</span></div>
                </div>
              )}
              {d.id === "encre-brute" && (
                <div class="dthumb-art">
                  <div class="eb-sticker" aria-hidden="true">WALK-INS OK</div>
                  <div class="eb-name">ENCRE<br />BRUTE</div>
                  <div class="eb-bar" aria-hidden="true"></div>
                  <div class="eb-sub">TATTOO · MONTRÉAL</div>
                </div>
              )}
              {d.id === "boba-club" && (
                <div class="dthumb-art">
                  <span class="bc-spark" aria-hidden="true">✦</span>
                  <span class="bc-spark bc-spark2" aria-hidden="true">✦</span>
                  <div class="bc-name">Boba Club</div>
                  <div class="bc-tag">pearls. ice. repeat.</div>
                </div>
              )}
              {d.id === "kanso" && (
                <div class="dthumb-art dthumb-ks-art">
                  <div class="ks-vert" aria-hidden="true">茶</div>
                  <div>
                    <div class="ks-name">Kanso</div>
                    <div class="ks-rule" aria-hidden="true"></div>
                    <div class="ks-sub">{locale === "fr" ? "maison de thé" : "tea house"}</div>
                  </div>
                </div>
              )}
              {d.id === "leduc" && (
                <div class="dthumb-art">
                  <div class="ld-seal" aria-hidden="true">
                    <svg viewBox="0 0 100 100"><defs><path id="ld-circ" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" /></defs><text><textPath href="#ld-circ">SINCE 1987 ★ PLOMBERIE ★ </textPath></text></svg>
                    <span class="ld-seal-core">LD</span>
                  </div>
                  <div class="ld-kicker">PLOMBERIE · LONGUEUIL</div>
                  <div class="ld-name">Leduc</div>
                  <div class="ld-bar" aria-hidden="true"></div>
                  <div class="ld-pill">{locale === "fr" ? "URGENCE 24/7" : "24/7 EMERGENCY"}</div>
                </div>
              )}
              {d.id === "boise" && (
                <div class="dthumb-art">
                  <svg class="bs-leaf" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 C36 12 42 24 40 44 C28 42 12 34 8 20 C14 22 20 14 24 4 Z" /><path d="M24 10 L24 40" stroke-width="1.6" /></svg>
                  <div class="bs-name">Boisé</div>
                  <div class="bs-sub">PAYSAGE · GATINEAU</div>
                  <div class="bs-seasons"><span>{locale === "fr" ? "printemps" : "spring"}</span><span>·</span><span>{locale === "fr" ? "été" : "summer"}</span><span>·</span><span>{locale === "fr" ? "automne" : "fall"}</span><span>·</span><span>{locale === "fr" ? "hiver" : "winter"}</span></div>
                </div>
              )}
              {d.id === "sora" && (
                <div class="dthumb-art">
                  <div class="sr-kicker">CLINIQUE · BROSSARD</div>
                  <div class="sr-name">Sora</div>
                  <div class="sr-book">
                    <span class="sr-book-dot" aria-hidden="true"></span>
                    <span>{locale === "fr" ? "Prochaine dispo : demain 9h40" : "Next opening: tomorrow 9:40"}</span>
                    <span class="sr-book-btn">{locale === "fr" ? "Réserver" : "Book"}</span>
                  </div>
                </div>
              )}
              {d.id === "forma" && (
                <div class="dthumb-art">
                  <div class="fm-kicker">ARCHITECTURE INTÉRIEURE · MONTRÉAL</div>
                  <div class="fm-name">Forma</div>
                  <div class="fm-rows" aria-hidden="true">
                    <div><span>01</span><span>Villa Lumière</span></div>
                    <div><span>02</span><span>Loft Canal</span></div>
                    <div><span>03</span><span>Maison Cèdre</span></div>
                  </div>
                </div>
              )}
              {d.id === "toit-fils" && (
                <div class="dthumb-art">
                  <div class="tf-seal" aria-hidden="true"><span>25</span><span>ANS</span></div>
                  <div class="tf-kicker">COUVREURS · QUÉBEC</div>
                  <div class="tf-name">Toit &amp; Fils</div>
                  <div class="tf-rule" aria-hidden="true"></div>
                  <div class="tf-sub">{locale === "fr" ? "garantie 25 ans, par écrit" : "25-year warranty, in writing"}</div>
                </div>
              )}
              {d.id === "verte" && (
                <div class="dthumb-art">
                  <div class="vt-stickers" aria-hidden="true"><span class="vt-stk vt-stk-t">VRAC</span><span class="vt-stk vt-stk-s">LOCAL</span></div>
                  <div class="vt-kicker">ÉPICERIE · SHERBROOKE</div>
                  <div class="vt-name">Verte</div>
                  <div class="vt-tag">{locale === "fr" ? "zéro déchet, plein de goût" : "zero waste, full flavor"}</div>
                </div>
              )}
              {d.id === "lune" && (
                <div class="dthumb-art">
                  <div class="lf-kicker">CROSSFIT · TROIS-RIVIÈRES</div>
                  <div class="lf-name">LUNE</div>
                  <div class="lf-sched" aria-hidden="true"><span>06:00</span><span class="lf-volt">WOD</span><span>12:15</span><span class="lf-volt">OPEN GYM</span></div>
                </div>
              )}
              {d.id === "maison-lune" && (
                <div class="dthumb-art">
                  <div class="ml-moon" aria-hidden="true"></div>
                  <div class="ml-kicker">GÎTE · MAGOG</div>
                  <div class="ml-name">Maison Lune</div>
                  <div class="ml-stars" aria-hidden="true">★ ★ ★ ★</div>
                  <div class="ml-sub">{locale === "fr" ? "quatre chambres, bord du lac" : "four rooms, lakeside"}</div>
                </div>
              )}
              {d.id === "finition-r" && (
                <div class="dthumb-art">
                  <div class="fnr-kicker">RÉNOVATION · MONTRÉAL</div>
                  <div class="fnr-name">FINITION R<span class="fnr-dot" aria-hidden="true">.</span></div>
                  <div class="fnr-rows" aria-hidden="true">
                    <div><span>01</span><span>PLÂTRE</span></div>
                    <div><span>02</span><span>PEINTURE</span></div>
                    <div><span>03</span><span>BOISERIE</span></div>
                  </div>
                </div>
              )}
              {d.id === "pouf" && (
                <div class="dthumb-art">
                  <div class="pf-blob pf-blob-a" aria-hidden="true"></div>
                  <div class="pf-blob pf-blob-b" aria-hidden="true"></div>
                  <div class="pf-name">Pouf</div>
                  <div class="pf-sub">STUDIO · MONTRÉAL</div>
                  <div class="pf-btn" aria-hidden="true">Squish me</div>
                </div>
              )}
              {d.id === "hexline" && (
                <div class="dthumb-art">
                  <span class="hx-corner hx-tl" aria-hidden="true"></span><span class="hx-corner hx-tr" aria-hidden="true"></span><span class="hx-corner hx-bl" aria-hidden="true"></span><span class="hx-corner hx-br" aria-hidden="true"></span>
                  <div class="hx-status"><span class="hx-dot" aria-hidden="true"></span>SYS.ONLINE</div>
                  <div class="hx-name">HEXLINE</div>
                  <div class="hx-sub">NEURAL SECURITY</div>
                </div>
              )}
              {d.id === "papier-ciseaux" && (
                <div class="dthumb-art">
                  <div class="pc-tape" aria-hidden="true"></div>
                  <div class="pc-name">Papier Ciseaux</div>
                  <div class="pc-sub">papeterie · québec</div>
                  <div class="pc-sticker" aria-hidden="true">100% fait main!</div>
                </div>
              )}
              {d.id === "studio-reve" && (
                <div class="dthumb-art">
                  <div class="rv-moon" aria-hidden="true"></div>
                  <div class="rv-door" aria-hidden="true"></div>
                  <div class="rv-name">Rêve</div>
                  <div class="rv-sub">STUDIO · MONTRÉAL</div>
                </div>
              )}
              {d.id === "cyberdoll" && (
                <div class="dthumb-art">
                  <span class="cd-spark" aria-hidden="true">✦</span><span class="cd-spark cd-s2" aria-hidden="true">✦</span>
                  <div class="cd-badge" aria-hidden="true">NEW!!</div>
                  <div class="cd-name">CYBERDOLL</div>
                  <div class="cd-sub">y2k · forever</div>
                </div>
              )}
              {d.id === "pixelforge" && (
                <div class="dthumb-art">
                  <div class="px-invader" aria-hidden="true"></div>
                  <div class="px-name">PIXELFORGE</div>
                  <div class="px-start" aria-hidden="true">▶ PRESS START</div>
                </div>
              )}
              {d.id === "vhs-dreams" && (
                <div class="dthumb-art">
                  <div class="vh-sun" aria-hidden="true"></div>
                  <div class="vh-grid" aria-hidden="true"></div>
                  <div class="vh-name">VHS DREAMS</div>
                  <div class="vh-sub">SYNTHWAVE · RECORDS</div>
                </div>
              )}
              {d.id === "prism" && (
                <div class="dthumb-art">
                  <div class="pr-blob pr-b1" aria-hidden="true"></div>
                  <div class="pr-blob pr-b2" aria-hidden="true"></div>
                  <div class="pr-card" aria-hidden="true">
                    <div class="pr-card-top">PRISM</div>
                    <div class="pr-card-bal">$4,280.00</div>
                  </div>
                </div>
              )}
              {d.id === "tactile" && (
                <div class="dthumb-art">
                  <div class="tx-name">Tactile</div>
                  <div class="tx-sub">SMART HOME · SOFT UI</div>
                  <div class="tx-btn" aria-hidden="true"><span class="tx-toggle"></span></div>
                </div>
              )}
              {d.id === "lattice" && (
                <div class="dthumb-art">
                  <div class="lt-grid" aria-hidden="true">
                    <span class="lt-c lt-a"></span><span class="lt-c lt-b"></span><span class="lt-c lt-c"></span><span class="lt-c lt-d"></span>
                  </div>
                  <div class="lt-name">Lattice</div>
                  <div class="lt-sub">BENTO WORKSPACE</div>
                </div>
              )}
              {d.id === "maximal" && (
                <div class="dthumb-art">
                  <div class="mx-burst" aria-hidden="true">★</div>
                  <div class="mx-name">MAXIMAL</div>
                  <div class="mx-sticker" aria-hidden="true">NO BEIGE!</div>
                  <div class="mx-ticker" aria-hidden="true">MORE IS MORE ★ MORE IS MORE ★</div>
                </div>
              )}
              {d.id === "atelier-caractere" && (
                <div class="dthumb-art">
                  <div class="ac-aa" aria-hidden="true">Aa</div>
                  <div class="ac-rule" aria-hidden="true"></div>
                  <div class="ac-name">Atelier Caractère</div>
                  <div class="ac-sub">FONDERIE · MONTRÉAL</div>
                </div>
              )}
              {d.id === "esquisse" && (
                <div class="dthumb-art">
                  <div class="es-name">Esquisse</div>
                  <div class="es-sub">atelier d'architecture</div>
                  <svg class="es-house" viewBox="0 0 60 44" aria-hidden="true"><path d="M6 38 L6 20 L30 6 L54 20 L54 38 M24 38 L24 26 L36 26 L36 38" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
              )}
              {d.id === "brume" && (
                <div class="dthumb-art">
                  <div class="br-orb" aria-hidden="true"></div>
                  <div class="br-name">Brume</div>
                  <div class="br-sub">PARFUMS · GRASSE</div>
                </div>
              )}
              {d.id === "sahara-sage" && (
                <div class="dthumb-art">
                  <div class="ss-arch" aria-hidden="true"><span class="ss-sun"></span></div>
                  <div class="ss-name">Sahara &amp; Sage</div>
                  <div class="ss-sub">BOHÈME · MONTRÉAL</div>
                </div>
              )}
              {d.id === "aeris" && (
                <div class="dthumb-art">
                  <div class="ae-orb" aria-hidden="true"></div>
                  <div class="ae-name">AERIS</div>
                  <div class="ae-sub">CLEAN TECH</div>
                </div>
              )}
            </div>
          ) : (
            <div class="demo-thumb" style={`background:${d.accent};`}>
              <div class="thumb-inner">
                <div class="thumb-bar mono">{d.city.toUpperCase()} · {((t.demos.categories as any)[d.category] ?? d.category).toUpperCase()}</div>
                <div class="thumb-title display" style="font-size:1.35rem; line-height:.9; color:white;">{d.name.split(" ")[0]} <span style="font-weight:400; opacity:.8;">{d.name.split(" ").slice(1).join(" ")}</span></div>
                <div class="thumb-tone mono" style="color: rgba(255,255,255,.7); font-size:10px; margin-top:6px;">{d.tone} · {d.palette}</div>
                <div style="margin-top:14px; height:1px; background: rgba(255,255,255,.18);"></div>
              </div>
              <div class="thumb-meta mono" style="background: rgba(0,0,0,.22); backdrop-filter: blur(8px);">
                <span>{d.localizedDescription}</span>
              </div>
            </div>
          )}
          <div class="demo-card-foot">
            <div>
              <div style="font-weight:750; letter-spacing:-0.02em; font-size:14px;">{d.name}</div>
              <div class="mono" style="font-size:11px; color: var(--muted);">{d.city} · {d.tone}</div>
            </div>
            <span class="mono" style="font-size:11px; background: var(--paper-2); border:1px solid var(--line); padding:6px 10px; border-radius:99px;">{liveDemos.has(d.id) ? t.demos.viewDemo : t.demos.details}</span>
          </div>
        </a>
      ))}
    </div>

    <div id="empty" class="empty mono" hidden>
      {t.demos.empty}
      <button id="clear" class="btn btn--ghost btn--sm" style="margin-top:12px;">{t.demos.clear}</button>
    </div>

    <div class="demos-note mono" data-reveal>
      <span>{t.demos.noteLeft}</span>
      <span style="opacity:.5;">{t.demos.noteRight}</span>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section--dark grain" style="padding-block: 48px;">
  <div class="shell" style="display:flex; flex-wrap:wrap; gap:16px; align-items:center; justify-content:space-between;">
    <div>
      <h2 class="display" style="font-size: clamp(1.8rem, 4vw, 2.6rem); line-height:.9; color: var(--section-dark-text);">{t.demos.ctaTitle}</h2>
      <p class="mono" style="margin-top:8px; color: rgba(248,245,239,.6); font-size:12px;">{t.demos.ctaDesc}</p>
    </div>
    <div class="cluster">
      <a href={paths.start} class="btn btn--on-dark">{t.demos.ctaPrimary}</a>
      <a href={paths.pricing} class="btn btn--ghost-on-dark">{t.demos.ctaSecondary}</a>
    </div>
  </div>
  <div class="shell" style="margin-top: 22px; display:flex; justify-content:center;">
    <a href={locale === "fr" ? "/fr/sources" : "/sources"} class="mono" style="font-size:11px; letter-spacing:.1em; color: rgba(248,245,239,.45); text-decoration: underline; text-underline-offset: 3px;">{t.demos.sourcesLink}</a>
  </div>
</section>

<div id="demo-i18n" hidden data-toast-template={t.demos.toast} data-search-count-template={t.demos.searchCount}></div>

<script>
  function initDemosPage() {
    const search = document.getElementById('search') as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll('[data-filter]'));
    const tradeChips = Array.from(document.querySelectorAll('[data-trade-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-category]')) as HTMLElement[];
    const empty = document.getElementById('empty') as HTMLElement | null;
    const clearBtn = document.getElementById('clear');
    const i18nEl = document.getElementById('demo-i18n');
    const toastTemplate = i18nEl?.getAttribute('data-toast-template') || '{name} is a fictional business and one of our design directions: {tone}, {palette}. The full clickable demo site isn’t published yet. Like this direction? Mention it when you contact us.';
    const countTemplate = i18nEl?.getAttribute('data-search-count-template') || '{count} demos';
    let activeStyle = 'All';
    let activeTrade = 'All';
    let query = '';

    // Deep link: /demos?trade=plumbing preselects the trade filter, so
    // trade-specific landing pages can link straight into a filtered catalog.
    try {
      const initialTrade = new URLSearchParams(window.location.search).get('trade');
      if (initialTrade && tradeChips.some((c) => c.getAttribute('data-trade-filter') === initialTrade)) {
        activeTrade = initialTrade;
      }
    } catch (e) { /* URL parsing unavailable; ignore */ }

    function syncChips(list: Element[], value: string, attr: string) {
      for (const c of list) {
        const isActive = c.getAttribute(attr) === value;
        c.classList.toggle('chip--active', isActive);
        c.setAttribute('aria-pressed', String(isActive));
      }
    }

    function apply() {
      let visible = 0;
      const q = query.trim().toLowerCase();
      for (const c of cards) {
        const family = c.getAttribute('data-demo-family') || '';
        const trade = c.getAttribute('data-demo-trade') || '';
        const txt = c.getAttribute('data-search') || '';
        const matchStyle = activeStyle === 'All' || family === activeStyle;
        const matchTrade = activeTrade === 'All' || trade === activeTrade;
        const matchQ = !q || txt.includes(q);
        const show = matchStyle && matchTrade && matchQ;
        (c as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (empty) (empty as HTMLElement).hidden = visible !== 0;
      const count = document.querySelector('[data-count]');
      if (count) count.textContent = countTemplate.replace('{count}', String(visible));
    }

    if (search) {
      search.addEventListener('input', (e) => {
        query = (e.target as HTMLInputElement).value;
        apply();
      });
    }
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeStyle = chip.getAttribute('data-filter') || 'All';
        syncChips(chips, activeStyle, 'data-filter');
        apply();
      });
    }
    for (const chip of tradeChips) {
      chip.addEventListener('click', () => {
        activeTrade = chip.getAttribute('data-trade-filter') || 'All';
        syncChips(tradeChips, activeTrade, 'data-trade-filter');
        apply();
      });
    }
    if (clearBtn && search) {
      clearBtn.addEventListener('click', () => {
        query = '';
        (search as HTMLInputElement).value = '';
        activeStyle = 'All';
        activeTrade = 'All';
        syncChips(chips, 'All', 'data-filter');
        syncChips(tradeChips, 'All', 'data-trade-filter');
        apply();
      });
    }

    // Honor a deep-linked trade filter on first load.
    syncChips(tradeChips, activeTrade, 'data-trade-filter');
    if (activeTrade !== 'All') apply();

    for (const card of cards) {
      // Published demos navigate to their microsite; others show the "not yet published" toast.
      if (card.getAttribute('data-live') === 'true') continue;
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const name = card.querySelector('.demo-card-foot div div')?.textContent || 'Demo';
        const tone = card.getAttribute('data-demo-tone') || '';
        const palette = card.getAttribute('data-demo-palette') || '';
        const toast = document.createElement('div');
        toast.setAttribute('role','status');
        toast.setAttribute('aria-live','polite');
        toast.textContent = toastTemplate
          .replace('{name}', name)
          .replace('{tone}', tone.toLowerCase())
          .replace('{palette}', palette.toLowerCase());
        Object.assign(toast.style, {
          position:'fixed', bottom:'20px', left:'50%', transform:'translateX(-50%) translateY(8px)',
          background:'#0A0F1C', color:'#F8F5EF', padding:'12px 16px', borderRadius:'12px',
          fontSize:'13px', lineHeight:'1.5', maxWidth:'min(560px, 90vw)', boxShadow:'0 16px 40px rgba(0,0,0,.24)',
          zIndex:'80', opacity:'0', transition:'opacity .2s, transform .2s'
        });
        document.body.appendChild(toast);
        requestAnimationFrame(()=> { toast.style.opacity='1'; toast.style.transform='translateX(-50%) translateY(0)'; });
        setTimeout(()=> { toast.style.opacity='0'; toast.style.transform='translateX(-50%) translateY(8px)'; setTimeout(()=> toast.remove(), 220); }, 3400);
      });
    }
  }

  document.addEventListener('astro:page-load', initDemosPage);
</script>

