---
import { useTranslations, localizedPaths, getDemos, type Locale } from "../../lib/i18n";
import { styleFamilies, getDemoFamily, tradeFilters } from "../../lib/demos";
import { sortCatalogForFallback } from "../../lib/demo-order";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];
const demos = getDemos(locale);

// Demos with published standalone microsites
const liveDemos = new Set(["nora", "mira", "atelier-nord", "encre-brute", "kanso", "leduc", "boise", "sora", "forma", "toit-fils", "verte", "lune", "maison-lune", "finition-r", "pouf", "hexline", "papier-ciseaux", "studio-reve", "cyberdoll", "pixelforge", "vhs-dreams", "prism", "tactile", "lattice", "maximal", "atelier-caractere", "esquisse", "brume", "sahara-sage", "aeris", "debit", "bec-fin", "voltige", "lueur", "21-degres", "extreme-climat", "confort-76", "zenith", "toitures-tempete", "chantier-brut", "maison-dore", "sneaker-pro", "onde", "noctua", "lisiere", "boreal", "rive-nord"]);
// Hidden from the catalog: style already covered by another demo (boba-club = Y2K, covered by cyberdoll)
const hiddenDemos = new Set(["boba-club"]);
const visibleDemos = demos.filter((d) => !hiddenDemos.has(d.id));
// Canonical catalog index, so the shared session shuffle rebuilds the same
// input even when the static fallback shows the pinned demos first.
const catalogIndex = new Map(visibleDemos.map((d, i) => [d.id, i]));
// Static fallback order: the moving demos lead while their one-week pin is
// active, then the rest in canonical order.
const displayDemos = sortCatalogForFallback(visibleDemos);
const demoHref = (id: string) => `${paths.demos}/${id}`;

// Style families for the filter: broad, plain-language groups
const families = styleFamilies;
---


<section class="demos-hero grain">
  <div class="shell">
    <div class="demos-hero-grid" data-reveal>
      <div>
        <div class="eyebrow">{t.demos.hero.eyebrow}</div>
        <h1 class="display" style="font-size: clamp(2.6rem, 6vw, 5rem); line-height:.88; margin-top:12px;" set:html={t.demos.hero.title}></h1>
        <p class="prose" style="margin-top:14px; max-width: 52ch; font-size: 15px;">
          {t.demos.hero.desc}
        </p>
        <div class="mono" style="margin-top:10px; font-size:11px; color: var(--muted);">{t.demos.hero.countNote}</div>
      </div>
      <div class="demos-hero-card">
        <div class="demos-hero-preview">
          <div class="mono" style="font-size:10px; opacity:.5;">{t.demos.hero.howTitle}</div>
          <ol class="mono" style="margin-top:12px; display:grid; gap:8px; font-size:12px; line-height:1.5; color: var(--ink-3); list-style: none; padding:0;">
            {t.demos.hero.howSteps.map((step, i) => (
              <li><strong style="color: var(--ink);">{i+1}. {step.split(":")[0]}</strong>{step.includes(":") ? `: ${step.split(":").slice(1).join(":")}` : ""}</li>
            ))}
          </ol>
          <div style="margin-top:14px; height:1px; background: var(--line);"></div>
          <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
            {t.demos.hero.pills.map((pill, i) => (
              <span class="pill mono" style={i===0 ? "background: var(--ink); color: var(--paper);" : "background: var(--paper-2); border:1px solid var(--line);"}>{pill}</span>
            ))}
          </div>
        </div>
        <div class="mono" style="margin-top:10px; font-size:10px; text-align:center; color: var(--muted);">{t.demos.hero.fictionalNote}</div>
      </div>
    </div>

    <!-- Controls -->
    <div class="controls" data-reveal style="--d:100ms">
      <label class="search">
        <span aria-hidden="true">⌕</span>
        <input id="search" type="search" placeholder={t.demos.searchPlaceholder} autocomplete="off" aria-label={t.common.search} />
        <span class="mono" style="font-size:11px; color: var(--muted); white-space:nowrap;" data-count>{t.demos.searchCount.replace("{count}", String(visibleDemos.length))}</span>
      </label>
      <div class="filters" role="group" aria-label={t.demos.styleLabel}>
        <button class="chip chip--active" data-filter="All" aria-pressed="true">{t.demos.allStyles}</button>
        {families.map((family) => (
          <button class="chip" data-filter={family} aria-pressed="false">{t.demos.families[family]}</button>
        ))}
      </div>
      <div class="filters" role="group" aria-label={t.demos.tradeLabel}>
        <button class="chip chip--active" data-trade-filter="All" aria-pressed="true">{t.demos.allTrades}</button>
        {tradeFilters.map((trade) => (
          <button class="chip" data-trade-filter={trade} aria-pressed="false">{t.demos.trades[trade]}</button>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 20px;">
  <div class="shell">
    <div id="demo-grid" class="demo-grid">
      {displayDemos.map((d, i) => (
        <a href={liveDemos.has(d.id) ? demoHref(d.id) : "#"} class="demo-card-demo" data-category={d.category} data-search={`${d.name} ${d.category} ${d.city} ${d.tone} ${d.localizedTone} ${d.palette} ${d.localizedDescription} ${((t.demos.categories as any)[d.category] ?? d.category)} ${d.trade ? ((t.demos.trades as any)[d.trade] ?? d.trade) : ""}`.toLowerCase()} data-reveal style={`--d:${(i%3)*80}ms`} data-demo-id={d.id} data-demo-index={catalogIndex.get(d.id)} data-demo-tone={d.localizedTone} data-demo-family={getDemoFamily(d.id)} data-demo-trade={d.trade ?? ""} data-demo-palette={d.palette} data-live={liveDemos.has(d.id) ? "true" : undefined} aria-label={`${d.name} — ${t.demos.viewDemo.replace(" →", "")}`}>
          {liveDemos.has(d.id) ? (
            <div class={`demo-thumb dthumb dthumb-${d.id}`}>
              {d.id === "nora" && (
                <div class="dthumb-art">
                  <div class="dn-top"><span class="dn-dot" aria-hidden="true"></span>{locale === "fr" ? "LAVAL · ARTISANS" : "LAVAL · TRADES"}</div>
                  <div class="dn-name">NORA<span aria-hidden="true">⚡</span></div>
                  <div class="dn-bar">24/7 DISPATCH</div>
                </div>
              )}
              {d.id === "mira" && (
                <div class="dthumb-art">
                  <div class="dm-kicker">{locale === "fr" ? "cantine · vieux-montréal" : "cantine · old montreal"}</div>
                  <div class="dm-name">Mira</div>
                  <div class="dm-pills"><span class="dm-pill-solid">Menu</span><span class="dm-pill-line">{locale === "fr" ? "Réserver" : "Reserve"}</span></div>
                </div>
              )}
              {d.id === "atelier-nord" && (
                <div class="dthumb-art">
                  <div class="da-status"><span class="da-pulse" aria-hidden="true"></span>BAY 01 · IN PROGRESS</div>
                  <div class="da-name">ATELIER NORD</div>
                  <div class="da-chips"><span>140 PTS</span><span>0.01°</span><span>SAME DAY</span></div>
                </div>
              )}
              {d.id === "encre-brute" && (
                <div class="dthumb-art">
                  <div class="eb-sticker" aria-hidden="true">WALK-INS OK</div>
                  <div class="eb-name">ENCRE<br />BRUTE</div>
                  <div class="eb-bar" aria-hidden="true"></div>
                  <div class="eb-sub">TATTOO · MONTRÉAL</div>
                </div>
              )}
              {d.id === "kanso" && (
                <div class="dthumb-art dthumb-ks-art">
                  <div class="ks-vert" aria-hidden="true">茶</div>
                  <div>
                    <div class="ks-name">Kanso</div>
                    <div class="ks-rule" aria-hidden="true"></div>
                    <div class="ks-sub">{locale === "fr" ? "maison de thé" : "tea house"}</div>
