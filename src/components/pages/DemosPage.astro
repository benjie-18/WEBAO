    <a href={locale === "fr" ? "/fr/sources" : "/sources"} class="mono" style="font-size:11px; letter-spacing:.1em; color: rgba(248,245,239,.45); text-decoration: underline; text-underline-offset: 3px;">{t.demos.sourcesLink}</a>
  </div>
