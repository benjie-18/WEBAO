---
import { useTranslations, localizedPaths, getDemos, type Locale } from "../../lib/i18n";
import { demoCategories as baseCategories } from "../../lib/demos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];
const demos = getDemos(locale);

// Demos with published standalone microsites
const liveDemos = new Set(["nora", "mira", "atelier-nord", "encre-brute", "boba-club", "kanso"]);
const demoHref = (id: string) => `${paths.demos}/${id}`;

// Categories with localized labels but keep base value for filtering
const categories = baseCategories.map(cat => ({
  value: cat,
  label: (t.demos.categories as any)[cat] ?? cat,
}));
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Baloo+2:wght@700&family=Fraunces:ital,wght@1,600&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet" />

<section class="demos-hero grain">
  <div class="shell">
    <div class="demos-hero-grid" data-reveal>
      <div>
        <div class="eyebrow">{t.demos.hero.eyebrow}</div>
        <h1 class="display" style="font-size: clamp(2.6rem, 6vw, 5rem); line-height:.88; margin-top:12px;" set:html={t.demos.hero.title}></h1>
        <p class="prose" style="margin-top:14px; max-width: 52ch; font-size: 15px;">
          {t.demos.hero.desc}
        </p>
        <div class="mono" style="margin-top:10px; font-size:11px; color: var(--muted);">{t.demos.hero.countNote}</div>
      </div>
      <div class="demos-hero-card" aria-hidden="true">
        <div class="demos-hero-preview">
          <div class="mono" style="font-size:10px; opacity:.5;">{t.demos.hero.howTitle}</div>
          <ol class="mono" style="margin-top:12px; display:grid; gap:8px; font-size:12px; line-height:1.5; color: var(--ink-3); list-style: none; padding:0;">
            {t.demos.hero.howSteps.map((step, i) => (
              <li><strong style="color: var(--ink);">{i+1}. {step.split(":")[0]}</strong>{step.includes(":") ? `: ${step.split(":").slice(1).join(":")}` : ""}</li>
            ))}
          </ol>
          <div style="margin-top:14px; height:1px; background: var(--line);"></div>
          <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
            {t.demos.hero.pills.map((pill, i) => (
              <span class="pill mono" style={i===0 ? "background: var(--ink); color: var(--paper);" : "background: var(--paper-2); border:1px solid var(--line);"}>{pill}</span>
            ))}
          </div>
        </div>
        <div class="mono" style="margin-top:10px; font-size:10px; text-align:center; color: var(--muted);">{t.demos.hero.fictionalNote}</div>
      </div>
    </div>

    <!-- Controls -->
    <div class="controls" data-reveal style="--d:100ms">
      <label class="search">
        <span aria-hidden="true">⌕</span>
        <input id="search" type="search" placeholder={t.demos.searchPlaceholder} autocomplete="off" aria-label={t.common.search} />
        <span class="mono" style="font-size:11px; color: var(--muted); white-space:nowrap;" data-count>{t.demos.searchCount.replace("{count}", String(demos.length))}</span>
      </label>
      <div class="filters" role="group" aria-label={t.demos.filterLabel}>
        {categories.map((c) => (
          <button class:list={["chip", c.value === "All" && "chip--active"]} data-filter={c.value} aria-pressed={c.value === "All" ? "true" : "false"}>{c.label}</button>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 20px;">
  <div class="shell">
    <div id="demo-grid" class="demo-grid" data-reveal>
      {demos.map((d, i) => (
        <a href={liveDemos.has(d.id) ? demoHref(d.id) : "#"} class="demo-card-demo" data-category={d.category} data-search={`${d.name} ${d.category} ${d.city} ${d.tone} ${d.palette} ${d.localizedDescription}`.toLowerCase()} data-reveal style={`--d:${(i%3)*80}ms`} data-demo-id={d.id} data-demo-tone={d.tone} data-demo-palette={d.palette} data-live={liveDemos.has(d.id) ? "true" : undefined} aria-label={`${t.demos.searchPlaceholder} ${d.name}`}>
          {liveDemos.has(d.id) ? (
            <div class={`demo-thumb dthumb dthumb-${d.id}`}>
              {d.id === "nora" && (
                <div class="dthumb-art">
                  <div class="dn-top"><span class="dn-dot" aria-hidden="true"></span>{locale === "fr" ? "LAVAL · ARTISANS" : "LAVAL · TRADES"}</div>
                  <div class="dn-name">NORA<span aria-hidden="true">⚡</span></div>
                  <div class="dn-bar">24/7 DISPATCH</div>
                </div>
              )}
              {d.id === "mira" && (
                <div class="dthumb-art">
                  <div class="dm-kicker">{locale === "fr" ? "cantine · vieux-montréal" : "cantine · old montreal"}</div>
                  <div class="dm-name">Mira</div>
                  <div class="dm-pills"><span class="dm-pill-solid">Menu</span><span class="dm-pill-line">{locale === "fr" ? "Réserver" : "Reserve"}</span></div>
                </div>
              )}
              {d.id === "atelier-nord" && (
                <div class="dthumb-art">
                  <div class="da-status"><span class="da-pulse" aria-hidden="true"></span>BAY 01 · IN PROGRESS</div>
                  <div class="da-name">ATELIER NORD</div>
                  <div class="da-chips"><span>140 PTS</span><span>0.01°</span><span>SAME DAY</span></div>
                </div>
              )}
              {d.id === "encre-brute" && (
                <div class="dthumb-art">
                  <div class="eb-sticker" aria-hidden="true">WALK-INS OK</div>
                  <div class="eb-name">ENCRE<br />BRUTE</div>
                  <div class="eb-bar" aria-hidden="true"></div>
                  <div class="eb-sub">TATTOO · MONTRÉAL</div>
                </div>
              )}
              {d.id === "boba-club" && (
                <div class="dthumb-art">
                  <span class="bc-spark" aria-hidden="true">✦</span>
                  <span class="bc-spark bc-spark2" aria-hidden="true">✦</span>
                  <div class="bc-name">Boba Club</div>
                  <div class="bc-tag">pearls. ice. repeat.</div>
                </div>
              )}
              {d.id === "kanso" && (
                <div class="dthumb-art dthumb-ks-art">
                  <div class="ks-vert" aria-hidden="true">茶</div>
                  <div>
                    <div class="ks-name">Kanso</div>
                    <div class="ks-rule" aria-hidden="true"></div>
                    <div class="ks-sub">{locale === "fr" ? "maison de thé" : "tea house"}</div>
                  </div>
                </div>
              )}
              <div class="dthumb-desc">{d.localizedDescription}</div>
            </div>
          ) : (
            <div class="demo-thumb" style={`background:${d.accent};`}>
              <div class="thumb-inner">
                <div class="thumb-bar mono">{d.city.toUpperCase()} · {((t.demos.categories as any)[d.category] ?? d.category).toUpperCase()}</div>
                <div class="thumb-title display" style="font-size:1.35rem; line-height:.9; color:white;">{d.name.split(" ")[0]} <span style="font-weight:400; opacity:.8;">{d.name.split(" ").slice(1).join(" ")}</span></div>
                <div class="thumb-tone mono" style="color: rgba(255,255,255,.7); font-size:10px; margin-top:6px;">{d.tone} · {d.palette}</div>
                <div style="margin-top:14px; height:1px; background: rgba(255,255,255,.18);"></div>
              </div>
              <div class="thumb-meta mono" style="background: rgba(0,0,0,.22); backdrop-filter: blur(8px);">
                <span>{d.localizedDescription}</span>
              </div>
            </div>
          )}
          <div class="demo-card-foot">
            <div>
              <div style="font-weight:750; letter-spacing:-0.02em; font-size:14px;">{d.name}</div>
              <div class="mono" style="font-size:11px; color: var(--muted);">{d.city} · {d.tone}</div>
            </div>
            <span class="mono" style="font-size:11px; background: var(--paper-2); border:1px solid var(--line); padding:6px 10px; border-radius:99px;">{liveDemos.has(d.id) ? t.demos.viewDemo : t.demos.details}</span>
          </div>
          <span class="corner mono">{t.demos.fictional}</span>
        </a>
      ))}
    </div>

    <div id="empty" class="empty mono" hidden>
      {t.demos.empty}
      <button id="clear" class="btn btn--ghost btn--sm" style="margin-top:12px;">{t.demos.clear}</button>
    </div>

    <div class="demos-note mono" data-reveal>
      <span>{t.demos.noteLeft}</span>
      <span style="opacity:.5;">{t.demos.noteRight}</span>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section--dark grain" style="padding-block: 48px;">
  <div class="shell" style="display:flex; flex-wrap:wrap; gap:16px; align-items:center; justify-content:space-between;">
    <div>
      <h2 class="display" style="font-size: clamp(1.8rem, 4vw, 2.6rem); line-height:.9; color: var(--section-dark-text);">{t.demos.ctaTitle}</h2>
      <p class="mono" style="margin-top:8px; color: rgba(248,245,239,.6); font-size:12px;">{t.demos.ctaDesc}</p>
    </div>
    <div class="cluster">
      <a href={paths.contact} class="btn btn--on-dark">{t.demos.ctaPrimary}</a>
      <a href={paths.pricing} class="btn btn--ghost-on-dark">{t.demos.ctaSecondary}</a>
    </div>
  </div>
</section>

<div id="demo-i18n" hidden data-toast-template={t.demos.toast} data-search-count-template={t.demos.searchCount}></div>

<script>
  function initDemosPage() {
    const search = document.getElementById('search') as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll('[data-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-category]')) as HTMLElement[];
    const empty = document.getElementById('empty') as HTMLElement | null;
    const clearBtn = document.getElementById('clear');
    const i18nEl = document.getElementById('demo-i18n');
    const toastTemplate = i18nEl?.getAttribute('data-toast-template') || '{name} is a fictional business and one of our design directions: {tone}, {palette}. The full clickable demo site isn’t published yet. Like this direction? Mention it when you contact us.';
    const countTemplate = i18nEl?.getAttribute('data-search-count-template') || '{count} demos';
    let active = 'All';
    let query = '';

    function apply() {
      let visible = 0;
      const q = query.trim().toLowerCase();
      for (const c of cards) {
        const cat = c.getAttribute('data-category') || '';
        const txt = c.getAttribute('data-search') || '';
        const matchCat = active === 'All' || cat === active;
        const matchQ = !q || txt.includes(q);
        const show = matchCat && matchQ;
        (c as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (empty) (empty as HTMLElement).hidden = visible !== 0;
      const count = document.querySelector('[data-count]');
      if (count) count.textContent = countTemplate.replace('{count}', String(visible));
    }

    if (search) {
      search.addEventListener('input', (e) => {
        query = (e.target as HTMLInputElement).value;
        apply();
      });
    }
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        active = chip.getAttribute('data-filter') || 'All';
        for (const c of chips) {
          const isActive = c.getAttribute('data-filter') === active;
          c.classList.toggle('chip--active', isActive);
          c.setAttribute('aria-pressed', String(isActive));
        }
        apply();
      });
    }
    if (clearBtn && search) {
      clearBtn.addEventListener('click', () => {
        query = '';
        (search as HTMLInputElement).value = '';
        active = 'All';
        for (const c of chips) {
          const isActive = c.getAttribute('data-filter') === 'All';
          c.classList.toggle('chip--active', isActive);
          c.setAttribute('aria-pressed', String(isActive));
        }
        apply();
      });
    }

    for (const card of cards) {
      // Published demos navigate to their microsite; others show the "not yet published" toast.
      if (card.getAttribute('data-live') === 'true') continue;
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const name = card.querySelector('.demo-card-foot div div')?.textContent || 'Demo';
        const tone = card.getAttribute('data-demo-tone') || '';
        const palette = card.getAttribute('data-demo-palette') || '';
        const toast = document.createElement('div');
        toast.setAttribute('role','status');
        toast.setAttribute('aria-live','polite');
        toast.textContent = toastTemplate
          .replace('{name}', name)
          .replace('{tone}', tone.toLowerCase())
          .replace('{palette}', palette.toLowerCase());
        Object.assign(toast.style, {
          position:'fixed', bottom:'20px', left:'50%', transform:'translateX(-50%) translateY(8px)',
          background:'#0A0F1C', color:'#F8F5EF', padding:'12px 16px', borderRadius:'12px',
          fontSize:'13px', lineHeight:'1.5', maxWidth:'min(560px, 90vw)', boxShadow:'0 16px 40px rgba(0,0,0,.24)',
          zIndex:'80', opacity:'0', transition:'opacity .2s, transform .2s'
        });
        document.body.appendChild(toast);
        requestAnimationFrame(()=> { toast.style.opacity='1'; toast.style.transform='translateX(-50%) translateY(0)'; });
        setTimeout(()=> { toast.style.opacity='0'; toast.style.transform='translateX(-50%) translateY(8px)'; setTimeout(()=> toast.remove(), 220); }, 3400);
      });
    }
  }

  document.addEventListener('astro:page-load', initDemosPage);
</script>

<style>
  .demos-hero { padding-block: clamp(28px,5vw,56px); background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%); border-bottom: 1px solid var(--line); }
  .demos-hero-grid { display:grid; grid-template-columns: 1.2fr .8fr; gap: clamp(24px,4vw,32px); align-items:start; }
  .demos-hero-card { background: var(--card-bg); border:1px solid var(--line); border-radius:16px; padding:14px; box-shadow: var(--shadow-sm); }
  .demos-hero-preview { background: var(--paper-3); border:1px solid var(--line); border-radius:12px; padding:14px; }
  .pill { padding:6px 10px; border-radius:99px; font-size:10px; letter-spacing:.06em; }
  .controls { margin-top: 18px; display:grid; gap:12px; background: var(--card-bg); border:1px solid var(--line); border-radius:16px; padding:14px; box-shadow: var(--shadow-sm); }
  .search { display:flex; align-items:center; gap:10px; background: var(--paper-3); border:1px solid var(--line); border-radius:12px; padding:10px 12px; }
  .search span:first-child { font-size:16px; opacity:.5; }
  .search input { flex:1; min-width:0; border:0; background:transparent; outline:none; font-size:14px; font-weight:500; }
  .filters { display:flex; gap:8px; flex-wrap:wrap; }
  .chip { padding:7px 12px; border-radius:99px; border:1px solid var(--line); background: var(--paper-2); font-size:12.5px; font-weight:600; letter-spacing:-0.01em; cursor:pointer; transition: background .2s, color .2s, border-color .2s; }
  .chip:hover { background: var(--paper-3); }
  .chip--active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .demo-grid { display:grid; grid-template-columns: repeat(3,1fr); gap:16px; }
  .demo-card-demo { position:relative; background: var(--card-bg); border:1px solid var(--line); border-radius:18px; overflow:clip; box-shadow: var(--shadow-sm); display:flex; flex-direction:column; transition: transform .35s var(--ease-out), box-shadow .35s; }
  .demo-card-demo:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .demo-thumb { position:relative; min-height: 220px; padding:16px; display:flex; flex-direction:column; justify-content:space-between; overflow:clip; }
  .demo-thumb::after { content:""; position:absolute; inset:0; background: radial-gradient(400px 200px at 80% 20%, rgba(255,255,255,.18) 0%, transparent 60%), linear-gradient(180deg, rgba(0,0,0,.08) 0%, rgba(0,0,0,.22) 100%); pointer-events:none; }
  .thumb-inner { position:relative; z-index:1; }
  .thumb-bar { font-size:10px; color: rgba(255,255,255,.72); letter-spacing:.08em; }
  .thumb-tone { font-size:10px; }
  .thumb-meta { position:relative; z-index:1; margin-top:14px; color: rgba(255,255,255,.92); font-size:11px; line-height:1.5; border:1px solid rgba(255,255,255,.16); background: rgba(0,0,0,.18); border-radius:10px; padding:8px 10px; }
  .demo-card-foot { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 14px; background: var(--card-bg); border-top:1px solid var(--line); }
  .corner { position:absolute; top:10px; right:10px; z-index:2; font-size:9px; letter-spacing:.12em; background: rgba(0,0,0,.55); color:white; padding:4px 7px; border-radius:99px; border:1px solid rgba(255,255,255,.18); backdrop-filter: blur(6px); }

  /* ---- Custom demo cards: each card speaks its demo's own design language ---- */
  .dthumb { min-height: 230px; display: flex; flex-direction: column; }
  .dthumb::after { display: none; }
  .dthumb-art { flex: 1; padding: 20px 18px 16px; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .dthumb-desc { padding: 10px 14px; font-size: 11px; line-height: 1.55; }

  /* Nora: Swiss dispatch */
  .dthumb-nora { background: #FAF7F2; color: #16130E; }
  .dthumb-nora .dthumb-desc { background: #fff; border-top: 1px solid rgba(22,19,14,.1); color: #4A4438; }
  .dn-top { font-family: ui-monospace, Menlo, monospace; font-size: 10px; letter-spacing: .2em; display: flex; align-items: center; gap: 8px; color: #4A4438; font-weight: 600; }
  .dn-dot { width: 8px; height: 8px; border-radius: 50%; background: #FF3B30; flex: none; }
  .dn-name { font-family: "Archivo Black", system-ui, sans-serif; font-size: 46px; letter-spacing: -.02em; line-height: 1; }
  .dn-name span { color: #FF3B30; }
  .dn-bar { margin-top: 2px; background: #16130E; color: #FAF7F2; font-family: ui-monospace, Menlo, monospace; font-size: 10px; font-weight: 600; letter-spacing: .24em; padding: 9px 13px; align-self: flex-start; }

  /* Mira: warm editorial */
  .dthumb-mira { background: #F6EFE1; color: #221610; }
  .dthumb-mira .dthumb-desc { background: rgba(255,255,255,.55); color: #5C4B3E; border-top: 1px solid rgba(34,22,16,.12); }
  .dm-kicker { font-size: 10px; letter-spacing: .28em; text-transform: uppercase; color: #C2481F; font-weight: 600; }
  .dm-name { font-family: "Fraunces", Georgia, serif; font-style: italic; font-weight: 600; font-size: 54px; line-height: 1; letter-spacing: -.02em; }
  .dm-pills { display: flex; gap: 8px; margin-top: 2px; }
  .dm-pill-solid { background: #221610; color: #F6EFE1; border-radius: 999px; padding: 7px 15px; font-size: 11px; font-weight: 600; }
  .dm-pill-line { border: 1.5px solid #221610; border-radius: 999px; padding: 6px 14px; font-size: 11px; font-weight: 600; }

  /* Atelier Nord: dark technical */
  .dthumb-atelier-nord { background: #0A0F1A; color: #F2F5F9; }
  .dthumb-atelier-nord .dthumb-desc { background: rgba(255,255,255,.04); color: #9AA6BC; border-top: 1px solid rgba(242,245,249,.12); }
  .da-status { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10px; letter-spacing: .18em; color: #9AA6BC; display: flex; align-items: center; gap: 8px; }
  .da-pulse { width: 8px; height: 8px; border-radius: 50%; background: #34D399; flex: none; }
  .da-name { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 29px; letter-spacing: .02em; line-height: 1.05; }
  .da-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .da-chips span { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 9.5px; letter-spacing: .12em; border: 1px solid rgba(242,245,249,.22); padding: 5px 9px; border-radius: 6px; color: #9AA6BC; }

  /* Encre Brute: neo-brutalism */
  .dthumb-encre-brute { background: #fff; color: #000; }
  .dthumb-encre-brute .dthumb-art { border: 3px solid #000; margin: 12px; padding: 18px 16px; box-shadow: 5px 5px 0 #000; background: #fff; }
  .dthumb-encre-brute .dthumb-desc { background: #000; color: #fff; }
  .eb-sticker { position: absolute; top: 22px; right: 20px; background: #FFFF00; border: 2px solid #000; font-family: "Archivo Black", system-ui, sans-serif; font-size: 9px; padding: 5px 8px; transform: rotate(8deg); box-shadow: 3px 3px 0 #000; white-space: nowrap; }
  .eb-name { font-family: "Archivo Black", system-ui, sans-serif; font-size: 38px; line-height: .95; letter-spacing: -.01em; }
  .eb-bar { height: 10px; background: #FF0000; margin-top: 4px; }
  .eb-sub { font-family: ui-monospace, Menlo, monospace; font-size: 10px; letter-spacing: .2em; font-weight: 600; }

  /* Boba Club: Y2K chrome */
  .dthumb-boba-club { background: linear-gradient(135deg, #FFD6E8 0%, #E3D6FF 50%, #CDE7FF 100%); color: #3B2A55; }
  .dthumb-boba-club .dthumb-desc { background: rgba(255,255,255,.65); color: #5A4A78; border-top: 1px solid rgba(59,42,85,.12); }
  .bc-spark { position: absolute; top: 16px; right: 20px; color: #fff; font-size: 24px; text-shadow: 0 0 10px rgba(255,255,255,.95); }
  .bc-spark2 { top: auto; right: auto; bottom: 58px; left: 20px; font-size: 16px; }
  .bc-name { font-family: "Baloo 2", system-ui, sans-serif; font-weight: 700; font-size: 44px; line-height: 1; letter-spacing: -.01em; }
  .bc-tag { font-family: "Baloo 2", system-ui, sans-serif; font-weight: 700; font-size: 13px; background: rgba(255,255,255,.85); border: 2px solid #fff; box-shadow: 0 4px 14px rgba(180,140,255,.45); align-self: flex-start; padding: 7px 15px; border-radius: 999px; }

  /* Kanso: Japanese minimal */
  .dthumb-kanso { background: #E9E4D8; color: #1A1815; }
  .dthumb-ks-art { flex-direction: row; align-items: center; justify-content: flex-start; gap: 20px; }
  .dthumb-kanso .dthumb-desc { background: rgba(255,255,255,.4); color: #5A554B; border-top: 1px solid rgba(26,24,21,.12); }
  .ks-vert { writing-mode: vertical-rl; font-family: Georgia, "Hiragino Mincho ProN", serif; font-size: 36px; letter-spacing: .3em; }
