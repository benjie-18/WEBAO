---
/**
 * StartPage — step 1 of the purchase funnel ("Start your site").
 *
 * Collects the customer's details and confirms the selection, then hands over
 * to the checkout page (step 2) which creates the Stripe session. There is no
 * payment UI here on purpose: one page owns the money, so /start and
 * /checkout can never disagree about what is being bought.
 *
 * The selection card is wired by `src/lib/start-ui.ts`:
 * - it mirrors the shared cart (plan radios, add-ons/bundles, total),
 * - an empty cart is seeded with `data-default-plan` (Grow, the C$149 anchor),
 * - the billing toggle uses the pricing page's hooks (handled by cart-ui).
 */
import { plans } from "../../lib/pricing";
import { useTranslations, localizedPaths, type Locale } from "../../lib/i18n";
import { priceCentsFor } from "../../lib/cart-catalog";
import { formatMoney } from "../../lib/cart-ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];
const checkoutPath = locale === "fr" ? "/fr/checkout" : "/checkout";
const fmt = { prefix: t.cart.moneyPrefix, suffix: t.cart.moneySuffix, decimal: t.cart.moneyDecimal };

/** Server-rendered monthly prices; start-ui re-renders them for the active term. */
const planRows = plans.map((def) => {
  const p = t.pricing.plans[def.id];
  const cents = priceCentsFor(def.id, "month") ?? 0;
  return { id: def.id, name: p.name, badge: p.badge, scope: p.features[0], price: `${formatMoney(cents, fmt)}${t.cart.suffixMonth}` };
});
/** Ads channels and AI services: monthly only, priced live from the catalog. */
const adsRows = [
  { id: "ads-meta", name: t.pricing.adsPack.metaLabel },
  { id: "ads-google", name: t.pricing.adsPack.googleLabel },
  { id: "ads-both", name: t.pricing.adsPack.bothLabel },
].map((row) => ({ ...row, price: `${formatMoney(priceCentsFor(row.id, "month") ?? 0, fmt)}${t.cart.suffixMonth}` }));
const gbpPrice = `${formatMoney(priceCentsFor("gbp-revamp", "one-time") ?? 0, fmt)}${t.cart.suffixOneTime}`;
const aiRows = [
  { id: "ai-receptionist", name: t.start.selection.aiReceptionist },
  { id: "aichat", name: t.start.selection.aiChat },
  { id: "ai-followup", name: t.start.selection.aiFollowup },
  { id: "ai-pack", name: t.start.selection.aiPack },
].map((row) => ({ ...row, price: `${formatMoney(priceCentsFor(row.id, "month") ?? 0, fmt)}${t.cart.suffixMonth}` }));
---

<section class="section start-section">
  <div class="shell start-shell">
    <header class="start-head" data-reveal>
      <p class="mono start-step">{t.start.step}</p>
      <div class="eyebrow" data-start-eyebrow>{t.start.eyebrow}</div>
      <h1 class="display start-title">{t.start.title}</h1>
      <p class="prose start-intro">{t.start.intro}</p>
    </header>

    <div
      class="start-grid"
      data-start
      data-default-plan="grow"
      data-label-remove={t.start.selection.remove}
      data-eyebrow-web={t.start.eyebrow}
      data-eyebrow-ads={t.start.eyebrowAds}
      data-eyebrow-ai={t.start.eyebrowAi}
      data-eyebrow-mixed={t.start.eyebrowMixed}
      data-hint-web={t.start.selection.noneHint}
      data-hint-service={t.start.selection.hintService}
      data-label-group-web={t.start.selection.groupWeb}
      data-label-group-ads={t.start.selection.groupAds}
      data-label-group-ai={t.start.selection.groupAi}
      data-summary-empty={t.start.selection.summaryEmpty}
      data-summary-line={t.start.selection.summaryLine}
      data-submit={t.start.form.submit}
      data-submit-with-total={t.start.form.submitWithTotal}
    >
      <!-- Selection card (DOM-first so phones read "what am I buying" first) -->
      <aside class="sel-card" aria-labelledby="sel-title" data-reveal style="--d:80ms">
        {/* Mobile only: collapsed order summary. The full pickers live
            below; the toggle opens them. The line is filled by start-ui. */}
        <button type="button" class="sel-mobile-toggle" data-start-summary-toggle aria-expanded="false">
          <span class="sel-mobile-toggle-line" data-start-summary-line>{t.start.selection.title}</span>
          <span class="sel-mobile-toggle-chevron" aria-hidden="true">▾</span>
        </button>
        <div class="sel-head">
          <h2 id="sel-title" class="sel-title">{t.start.selection.title}</h2>
          <a href={paths.pricing} class="sel-change mono">{t.start.selection.change}</a>
        </div>

        <div class="billing-toggle sel-billing" role="group" aria-label={t.cart.billingLegend} data-billing-toggle>
          <span class="billing-thumb" aria-hidden="true"></span>
          <button type="button" class="billing-opt is-active" data-billing-opt="month" aria-pressed="true">
            {t.cart.billingMonthly}
          </button>
          <button type="button" class="billing-opt" data-billing-opt="year" aria-pressed="false">
            {t.cart.billingYearly}
            <span class="billing-opt-note">{t.cart.billingYearlyNote}</span>
          </button>
        </div>

        <!-- Branch select: Website, Ads and AI can be bought together.
             A branch is on when the cart holds one of its products; turning
             a branch on reveals its picker so it can be added here too. -->
        <div class="branch-select" role="group" aria-label={t.start.selection.branchesLabel} data-branch-select>
          <span class="mono sel-legend">{t.start.selection.branchesLabel}</span>
          <div class="branch-chips">
            <button type="button" class="branch-chip" data-branch-toggle="web" aria-pressed="true">{t.start.selection.branchWeb}</button>
            <button type="button" class="branch-chip" data-branch-toggle="ads" aria-pressed="false">{t.start.selection.branchAds}</button>
            <button type="button" class="branch-chip" data-branch-toggle="ai" aria-pressed="false">{t.start.selection.branchAi}</button>
          </div>
        </div>

        <fieldset class="plan-picker" data-branch-picker="web">
          <legend class="mono sel-legend">{t.start.selection.planLegend}</legend>
          {planRows.map((row) => (
            <label class="plan-opt">
              <input type="radio" name="plan" value={row.id} data-name={row.name} />
              <span class="plan-opt-body">
                <span class="plan-opt-main">
                  <span class="plan-opt-name">
                    {row.name}
                    {row.badge !== "" && <em class="plan-opt-badge mono">{row.badge}</em>}
                  </span>
                  <span class="plan-opt-scope">{row.scope}</span>
                </span>
                <span class="plan-opt-price mono" data-plan-price>{row.price}</span>
              </span>
            </label>
          ))}
          <label class="plan-opt plan-opt--none">
            <input type="radio" name="plan" value="none" />
            <span class="plan-opt-body">
              <span class="plan-opt-main">
                <span class="plan-opt-name">{t.start.selection.noPlanOption}</span>
              </span>
            </span>
          </label>
        </fieldset>

        <fieldset class="plan-picker" data-branch-picker="ads" hidden>
          <legend class="mono sel-legend">{t.start.selection.adsLegend}</legend>
          {adsRows.map((row) => (
            <label class="plan-opt">
              <input type="radio" name="ads-channel" value={row.id} data-name={row.name} />
              <span class="plan-opt-body">
                <span class="plan-opt-main">
                  <span class="plan-opt-name">{row.name}</span>
                </span>
                <span class="plan-opt-price mono" data-ads-price>{row.price}</span>
              </span>
            </label>
          ))}
          <label class="plan-opt plan-opt--none">
            <input type="radio" name="ads-channel" value="none" />
            <span class="plan-opt-body">
              <span class="plan-opt-main">
                <span class="plan-opt-name">{t.start.selection.adsNone}</span>
              </span>
            </span>
          </label>
          <label class="plan-opt plan-opt--check">
            <input type="checkbox" name="gbp" value="gbp-revamp" data-name={t.pricing.adsPack.gbpName} />
            <span class="plan-opt-body">
              <span class="plan-opt-main">
                <span class="plan-opt-name">{t.pricing.adsPack.gbpName}</span>
              </span>
              <span class="plan-opt-price mono" data-gbp-price>{gbpPrice}</span>
            </span>
          </label>
        </fieldset>

        <fieldset class="plan-picker" data-branch-picker="ai" hidden>
          <legend class="mono sel-legend">{t.start.selection.aiLegend}</legend>
          {aiRows.map((row) => (
            <label class="plan-opt plan-opt--check">
              <input type="checkbox" name="ai-service" value={row.id} data-name={row.name} />
              <span class="plan-opt-body">
                <span class="plan-opt-main">
                  <span class="plan-opt-name">{row.name}</span>
                </span>
                <span class="plan-opt-price mono" data-ai-price>{row.price}</span>
              </span>
            </label>
          ))}
        </fieldset>
        <p class="mono sel-hint" data-start-no-plan hidden>{t.start.selection.noneHint}</p>
        <p class="mono sel-hint" data-start-default-note hidden>{t.start.selection.defaultNote}</p>

        <div class="sel-extras" data-start-extras hidden>
          <p class="mono sel-legend">{t.start.selection.summaryTitle}</p>
          <ul class="sel-extras-list" data-start-extras-list></ul>
        </div>

        <div class="sel-total">
          <span>{t.cart.total}</span>
          <strong class="mono" data-start-total>{formatMoney(0, fmt)}</strong>
        </div>
        <p class="mono sel-note">{t.cart.note}</p>
        <p class="field-error mono sel-error" data-start-selection-error hidden>{t.start.form.errSelection}</p>

        <div class="sel-steps">
          <p class="mono sel-legend">{t.start.steps.title}</p>
          <ol class="sel-steps-list">
            {t.start.steps.items.map((step, i) => (
              <li>
                <span class="sel-step-num mono" aria-hidden="true">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <!-- Details form -->
      <form
        id="start-form"
        class="start-form"
        data-start-form
        data-astro-reload
        novalidate
        data-checkout-path={checkoutPath}
        data-err-name={t.start.form.errName}
        data-err-email={t.start.form.errEmail}
        data-err-email-format={t.start.form.errEmailFormat}
        data-err-business={t.start.form.errBusiness}
        data-reveal
      >
        <label>{t.start.form.name}
          <input name="name" placeholder={t.start.form.namePlaceholder} autocomplete="name" required />
          <span class="field-error mono" data-error="name" hidden></span>
        </label>
        <label>{t.start.form.email}
          <input name="email" type="email" placeholder={t.start.form.emailPlaceholder} autocomplete="email" required />
          <span class="field-error mono" data-error="email" hidden></span>
        </label>
        <label>{t.start.form.business}
          <input name="business" placeholder={t.start.form.businessPlaceholder} autocomplete="organization" required />
          <span class="field-error mono" data-error="business" hidden></span>
        </label>
        <button type="submit" class="btn btn--primary start-submit" data-track="cta" data-track-label={t.start.form.submit}>
          {t.start.form.submit}
        </button>
        <p class="mono start-reassurance">{t.start.form.reassurance}</p>
        <ul class="start-trust mono" aria-label={t.home.hero.trustStrip.join(" · ")}>
          {t.home.hero.trustStrip.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="mono start-launch-date" data-launch-date data-template={t.start.form.launchRange} hidden></p>
        <p class="mono start-shortlist" data-start-shortlist hidden>
          <strong>{t.demos.shortlistTitle}:</strong>
          <span data-start-shortlist-names></span>
          <a href={paths.demos}>{t.demos.shortlistChange}</a>
        </p>
        <a href={paths.contact} class="start-directions">{t.start.form.directionsLink}</a>
        <p class="mono start-hint">{t.start.form.hint}</p>
      </form>
    </div>

    <p class="mono start-aside">
      {t.start.aside} <a href={paths.contact} style="color: var(--ink);">{t.start.asideCta}</a>
    </p>
  </div>
</section>

<script>
  import { initStart } from "../../lib/start-ui";
  initStart();
</script>

<style>
  .start-shell {
    max-width: 980px;
  }
  .start-step {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .start-title {
    font-size: var(--text-h1);
    line-height: 0.92;
    margin-top: 12px;
  }
  .start-intro {
    margin-top: 12px;
    max-width: 56ch;
  }

  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas: "form selection";
    gap: 24px;
    align-items: start;
    margin-top: 32px;
  }
  .sel-card {
    grid-area: selection;
    position: sticky;
    top: 88px;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--paper-2);
    padding: 22px;
  }
  .start-form {
    grid-area: form;
    display: grid;
    gap: 14px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
  }
  /* Mobile order summary: collapsed to one line, form first in view.
     The toggle is hidden on desktop; the pickers show unless the card
     is closed on a phone. */
  .sel-mobile-toggle { display: none; }
  @media (max-width: 760px) {
    .start-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "selection" "form";
    }
    .sel-card {
      position: static;
    }
    .sel-card:not(.is-open) {
      padding: 6px 22px;
    }
    .sel-mobile-toggle {
      display: flex;
      width: 100%;
      min-height: 44px;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 6px 2px;
      background: transparent;
      border: none;
      font: inherit;
      color: var(--ink);
      cursor: pointer;
      text-align: left;
    }
    .sel-mobile-toggle-line {
      font-weight: 650;
      font-size: 0.95rem;
    }
    .sel-mobile-toggle-chevron {
      color: var(--muted);
      transition: transform 0.2s ease;
    }
    .sel-card.is-open .sel-mobile-toggle-chevron {
      transform: rotate(180deg);
    }
    .sel-card:not(.is-open) > :not(.sel-mobile-toggle) {
      display: none;
    }
  }

  /* Branch select: three toggle chips above the pickers, same look as
     the billing toggle on the pricing page. */
  .branch-select { margin-top: 16px; }
  .branch-chips { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
  .branch-chip {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .branch-chip[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .plan-opt--none { opacity: 0.75; }
  .plan-opt--none .plan-opt-name { font-weight: 500; }
  .plan-picker[hidden] { display: none; }
  /* Grouped summary: branch headings above their items. */
  .sel-group-head {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 10px 0 2px;
    list-style: none;
  }
  .sel-group-head:first-child { padding-top: 0; }

  /* Selection card */
  .sel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sel-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }
  .sel-change {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sel-billing {
    margin-top: 16px;
  }
  .sel-legend {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0;
    margin: 0 0 8px;
  }
  .plan-picker {
    border: 0;
    padding: 0;
    margin: 18px 0 0;
    display: grid;
    gap: 8px;
  }
  .plan-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px 12px 42px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card-bg);
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* Custom radio/check circle: the native input stays in the DOM
     (keyboard + screen reader) but is visually replaced by this ring,
     which fills with a checkmark on selection. */
  .plan-opt::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: var(--card-bg);
    display: grid;
    place-items: center;
    font-size: 11px;
    line-height: 1;
    color: var(--paper);
    transition: background .2s ease, border-color .2s ease;
  }
  .plan-opt:has(input:checked)::before {
    content: "✓";
    background: var(--accent);
    border-color: var(--accent);
  }
  .plan-opt:hover {
    border-color: var(--line-strong);
  }
  .plan-opt:has(input:checked) {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .plan-opt:has(input:focus-visible) {
    outline: 2px solid var(--focus-outline, var(--accent));
    outline-offset: 2px;
  }
  .plan-opt input {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    margin: 0;
    opacity: 0;
  }
  .plan-opt-body {
    flex: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    min-width: 0;
  }
  .plan-opt-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .plan-opt-scope {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.45;
  }
  .plan-opt-name {
    font-weight: 600;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .plan-opt-badge {
    font-style: normal;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .plan-opt-price {
    font-size: 12.5px;
    white-space: nowrap;
    color: var(--ink-3);
  }
  .sel-hint {
    font-size: 11px;
    color: var(--muted);
    margin: 10px 0 0;
    line-height: 1.5;
  }
  .sel-extras {
    margin-top: 18px;
  }
  .sel-extras-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .sel-extras-list :global(.sel-extra) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card-bg);
    font-size: 0.92rem;
  }
  .sel-extras-list :global(.sel-extra-name) {
    flex: 1;
    min-width: 0;
    font-weight: 600;
  }
  .sel-extras-list :global(.sel-extra-price) {
    font-size: 12px;
    white-space: nowrap;
    color: var(--ink-3);
  }
  .sel-extras-list :global(.sel-extra-remove) {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  /* 44px tap target without changing the 26px visual: the invisible
     expansion covers the gap to the neighbouring row content. */
  .sel-extras-list :global(.sel-extra-remove::after) {
    content: "";
    position: absolute;
    inset: -9px;
  }
  .sel-extras-list :global(.sel-extra-remove:hover) {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }
  .sel-extras-list :global(.sel-extra-remove svg) {
    width: 12px;
    height: 12px;
  }
  .sel-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
    font-size: 1.05rem;
  }
  .sel-total strong {
    font-size: 1.3rem;
  }
  .sel-note {
    font-size: 10.5px;
    color: var(--muted);
    margin: 8px 0 0;
  }
  .sel-error {
    margin-top: 10px;
  }
  /* What happens after checkout: numbered steps in the sidebar. */
  .sel-steps {
    margin-top: 18px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .sel-steps-list {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: grid;
    gap: 10px;
  }
  .sel-steps-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .sel-step-num {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    margin-top: 1px;
  }

  /* Form */
  .start-form label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .start-form input {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--paper-3);
    font-size: 14px;
    color: var(--ink);
  }
  .start-form input:focus {
    outline: none;
    border-color: var(--ink);
