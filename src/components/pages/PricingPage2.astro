---
import { useTranslations, type Locale } from "../../lib/i18n";
import PlanCards from "../pricing/PlanCards.astro";
import BundleCarousel from "../pricing/BundleCarousel.astro";
import AdsPackCard from "../pricing/AdsPackCard.astro";
import AddonList from "../pricing/AddonList.astro";
import CompareTable from "../pricing/CompareTable.astro";
import AiPackCards from "../pricing/AiPackCards.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const a = t.pricing.adsPack;
const termsPath = locale === "fr" ? "/fr/conditions" : "/terms";
---

<!-- Temporary revamped pricing test page. Same cards, prices and cart
  wiring as /pricing, plus the AI branch. No description
  paragraphs: title, service chooser, billing toggle, then cards. -->
<div data-pricing2>
  <section class="p2-hero grain">
    <div class="shell p2-hero-inner">
      <h1 class="display p2-title">{t.pricing.hero.title}</h1>

      <div class="service-chooser" role="tablist" aria-label="Select your service">
        <button type="button" class="service-pill" role="tab" id="p2-tab-ads" aria-controls="p2-panel-ads" aria-selected="false" data-service-pill="ads">Ads</button>
        <button type="button" class="service-pill is-active" role="tab" id="p2-tab-web" aria-controls="p2-panel-web" aria-selected="true" data-service-pill="web">Web</button>
        <button type="button" class="service-pill" role="tab" id="p2-tab-ai" aria-controls="p2-panel-ai" aria-selected="false" data-service-pill="ai">AI</button>
      </div>

      <!-- Same billing toggle as /pricing (classes and data attributes
        live in global.css and cart-ui.ts). It sits under the chooser
        and still re-prices the cart when switched. -->
      <div class="billing-toggle-wrap">
        <div class="billing-toggle" role="group" aria-label={t.cart.billingLegend} data-billing-toggle>
          <button type="button" class="billing-opt is-active" data-billing-opt="month" aria-pressed="true">
            {t.cart.billingMonthly}
          </button>
          <button type="button" class="billing-opt" data-billing-opt="year" aria-pressed="false">
            {t.cart.billingYearly}
            <span class="billing-opt-note">{t.cart.billingYearlyNote}</span>
          </button>
        </div>
        <p class="billing-toggle-hint mono">{t.cart.billingHint}</p>
      </div>
    </div>
  </section>

  <div class="p2-panels">
    <!-- Web (default): the normal price cards, bundles and add-ons. -->
    <section class="p2-panel" role="tabpanel" id="p2-panel-web" aria-labelledby="p2-tab-web" data-service-panel="web">
      <section class="section plans-section">
        <div class="shell">
          <h2 id="plans-h" class="visually-hidden">{t.pricing.plansTitle}</h2>
          <PlanCards locale={locale} badgeAbove />
          <p class="p2-plan-note">No setup fee on website plans. Cancel with 30 days' notice.</p>
        </div>
      </section>
      <BundleCarousel locale={locale} />
      <AddonList locale={locale} />
      <CompareTable locale={locale} />
    </section>

    <!-- Ads: one card per channel for a cleaner distinction, then the
      existing Ads Pack card with its channel picker (customization)
      and Google Business Profile revamp. Prices come from the same
      i18n strings as the card, so they cannot drift apart. -->
    <section class="p2-panel" role="tabpanel" id="p2-panel-ads" aria-labelledby="p2-tab-ads" data-service-panel="ads" hidden>
      <h2 class="visually-hidden">{a.name}</h2>
      <section class="section ads-section" aria-label={a.name}>
        <div class="shell ads-wrap">
          <AdsPackCard locale={locale} />
        </div>
      </section>
      <div class="shell ads-distinction">
        <div class="ads-option ads-option--meta" data-ads-option="meta" role="button" tabindex="0" aria-pressed="true">
          <h3>{a.metaLabel}</h3>
          <p class="ads-option-price">{a.metaPrice}</p>
          <p>{a.setup}</p>
          <p>{a.budget}</p>
        </div>
        <div class="ads-option ads-option--both" data-ads-option="both" role="button" tabindex="0" aria-pressed="false">
          <h3>{a.bothLabel}</h3>
          <p class="ads-option-tag">Best value</p>
          <p class="ads-option-price">{a.bothPrice}</p>
          <p>{a.bothSetup}</p>
          <p>{a.bothBudget}</p>
          <p>Save C$449.99/mo vs two single channels</p>
        </div>
        <div class="ads-option ads-option--google" data-ads-option="google" role="button" tabindex="0" aria-pressed="false">
          <h3>{a.googleLabel}</h3>
          <p class="ads-option-price">{a.metaPrice}</p>
          <p>{a.setup}</p>
          <p>{a.budget}</p>
        </div>
      </div>
    </section>

    <!-- AI services, checkout wired. -->
    <section class="p2-panel" role="tabpanel" id="p2-panel-ai" aria-labelledby="p2-tab-ai" data-service-panel="ai" hidden>
      <h2 class="visually-hidden">AI services</h2>
      <div class="section">
        <AiPackCards locale={locale} />
      </div>
    </section>
  </div>

  <section class="terms-band grain" aria-labelledby="terms-h">
    <div class="shell terms-band-inner">
      <div>
        <p class="eyebrow">{t.pricing.hero.eyebrow}</p>
        <h2 id="terms-h" class="display terms-band-title">{t.pricing.termsCta.title}</h2>
      </div>
      <a href={termsPath} class="btn btn--on-dark btn--lg">{t.pricing.termsCta.label}</a>
    </div>
  </section>
</div>

<script data-astro-rerun>
  // Service switch: fade the current panel out, then fade the chosen
  // panel in. No overlap, and instant switching when the visitor
  // prefers reduced motion.
  // ClientRouter fix: this script must re-init after a ClientRouter
  // navigation (for example, backing here from /start). Without
  // data-astro-rerun and the astro:page-load listener below, the pills
  // were dead on return: fresh Web-default HTML with no listeners.
  // Plain JavaScript on purpose: with data-astro-rerun, astro check
  // treats this block as JS, and any TypeScript annotation in it fails
  // the deploy (run 542). The runtime guard below handles a missing root.
  function initPricing2() {
    var root = document.querySelector("[data-pricing2]");
    if (!root || root.dataset.p2Init === "1") return;
    root.dataset.p2Init = "1";
    var pills = Array.prototype.slice.call(root.querySelectorAll("[data-service-pill]"));
    var panels = {};
    Array.prototype.slice.call(root.querySelectorAll("[data-service-panel]")).forEach(function (p) {
      var key = p.getAttribute("data-service-panel");
      if (key) panels[key] = p;
    });
    var current = "web";
    var busy = false;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function show(next) {
      if (next === current || busy) return false;
      var from = panels[current];
      var to = panels[next];
      if (!from || !to) return false;
      pills.forEach(function (b) {
        var on = b.getAttribute("data-service-pill") === next;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      if (reduced) {
        from.hidden = true;
        to.hidden = false;
        current = next;
        return true;
      }
      busy = true;
      current = next;
      from.classList.add("is-leaving");
      window.setTimeout(function () {
        from.hidden = true;
        from.classList.remove("is-leaving");
        to.hidden = false;
        to.classList.add("is-entering");
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            to.classList.remove("is-entering");
            busy = false;
          });
        });
      }, 240);
      return true;
    }
    pills.forEach(function (b) {
      b.addEventListener("click", function () {
        var service = b.getAttribute("data-service-pill");
        if (service) show(service);
      });
    });
    // Ads selection: the option boxes were static, the only picker was
    // the radio pills inside the Ads card. Make the boxes select the
    // channel themselves, and keep them in sync with the card picker.
    // This also updates the card price, setup, budget, include text and
    // cart button directly, so it works even if the card's own script
    // did not re-init after a ClientRouter navigation.
    var adsPack = document.querySelector("[data-ads-pack]");
    var adsOptions = Array.prototype.slice.call(root.querySelectorAll("[data-ads-option]"));
    function syncAdsOptions() {
      if (!adsPack) return;
      var checked = adsPack.querySelector('input[name="ads-channel"]:checked');
      var product = checked ? checked.getAttribute("value") || "" : "";
      adsOptions.forEach(function (opt) {
        var key = opt.getAttribute("data-ads-option");
        var on = product === "ads-" + key;
        opt.classList.toggle("is-selected", on);
        opt.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }
    function selectAdsChannel(key) {
      if (!adsPack) return;
      var input = adsPack.querySelector('input[name="ads-channel"][value="ads-' + key + '"]');
      if (!input) return;
      if (input.checked) {
        syncAdsOptions();
        return;
      }
      input.checked = true;
      // Update the card display and cart button, mirroring the card's
      // own change handler, then let that handler run too if present.
      var priceEl = adsPack.querySelector("[data-ads-price]");
      var setupEl = adsPack.querySelector("[data-ads-setup]");
      var budgetEl = adsPack.querySelector("[data-ads-budget]");
      var includeEl = adsPack.querySelector("[data-ads-include]");
      var btn = adsPack.querySelector("[data-cart-btn]");
      if (priceEl) priceEl.textContent = input.getAttribute("data-price") || "";
      if (setupEl) setupEl.textContent = input.getAttribute("data-setup") || "";
      if (budgetEl) budgetEl.textContent = input.getAttribute("data-budget") || "";
      if (includeEl) includeEl.textContent = input.getAttribute("data-include") || "";
      if (btn) {
        btn.setAttribute("data-product", input.getAttribute("data-product") || "");
        btn.setAttribute("data-name", input.getAttribute("data-name") || "");
        btn.setAttribute("data-price-cents", input.getAttribute("data-price-cents") || "");
        btn.setAttribute("data-key", (input.getAttribute("data-product") || "") + "-month");
      }
      try {
        input.dispatchEvent(new Event("change", { bubbles: true }));
      } catch (e) {}
      syncAdsOptions();
    }
    adsOptions.forEach(function (opt) {
      opt.addEventListener("click", function () {
        var key = opt.getAttribute("data-ads-option");
        if (key) selectAdsChannel(key);
      });
      opt.addEventListener("keydown", function (event) {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          var key = opt.getAttribute("data-ads-option");
          if (key) selectAdsChannel(key);
        }
      });
    });
    if (adsPack) {
      adsPack.addEventListener("change", syncAdsOptions);
      syncAdsOptions();
    }
    // Tablist keyboard pattern: arrows move between services, Home/End
    // jump to the first and last service.
    var chooser = root.querySelector(".service-chooser");
    if (chooser) {
      chooser.addEventListener("keydown", function (event) {
        var order = ["ads", "web", "ai"];
        var idx = order.indexOf(current);
        var next = null;
        if (event.key === "ArrowRight") next = order[(idx + 1) % order.length];
        if (event.key === "ArrowLeft") next = order[(idx + order.length - 1) % order.length];
        if (event.key === "Home") next = order[0];
        if (event.key === "End") next = order[order.length - 1];
        if (!next) return;
        event.preventDefault();
        if (!show(next)) return;
        var pill = root.querySelector('[data-service-pill="' + next + '"]');
        if (pill) pill.focus();
      });
    }
  }
  initPricing2();
  if (!window.__webaoPricing2PL) {
    window.__webaoPricing2PL = true;
    document.addEventListener("astro:page-load", initPricing2);
  }
</script>

<style>
  .p2-hero {
    padding-block: clamp(40px, 7vw, 88px) clamp(8px, 2vw, 16px);
    background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .p2-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .p2-title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .service-chooser {
    display: flex;
    flex-direction: row;
    gap: 10px;
    justify-content: center;
    margin-top: 28px;
  }
  .service-pill {
    padding: 11px 26px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }
  .service-pill:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .service-pill:active {
    transform: scale(0.97);
  }
  .service-pill.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .service-pill:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .plans-section {
    padding-top: clamp(8px, 2vw, 16px);
    overflow-x: clip;
  }
  .p2-plan-note {
    text-align: center;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 20px 0 0;
  }
  /* Pricing2 only: on desktop, show the three plan cards side by side
     instead of /pricing's deep overlap, so every price and cart button
     is visible at rest and the card tops align. /pricing is untouched. */
  @media (min-width: 820px) {
    .p2-panel :global(.plan-grid) {
      --overlap: 0px;
      gap: 16px;
      align-items: start;
    }
    .p2-panel :global(.pcard-slot--grow .pcard-lift) {
      transform: none;
      margin-inline: 0;
    }
  }
  /* Bottom breathing room: the white (light theme) / dark (dark theme)
     area behind the cards gets a clear gap before the dark terms band
     and the footer, so the last cards never look like they touch them. */
  .p2-panels {
    padding-bottom: 56px;
  }
  [data-pricing2] {
    padding-bottom: 64px;
  }
  /* Web plan cards, pricing2 only: Grow's hover glow now matches the
     other two cards exactly (0 26px 70px), instead of its stronger
     0 30px 80px. The hover lift ("jump") is subtler for all three
     cards: -12px and 1.02 scale instead of -30px and 1.06. The glow
     itself is unchanged for Launch and Scale. */
  .p2-panel :global(.pcard-slot--grow:hover .pcard-glow),
  .p2-panel :global(.pcard-slot--grow:focus-within .pcard-glow) {
    filter: drop-shadow(0 26px 70px var(--pglow));
  }
  .p2-panel :global(.pcard-slot--launch:hover .pcard-lift),
  .p2-panel :global(.pcard-slot--launch:focus-within .pcard-lift),
  .p2-panel :global(.pcard-slot--scale:hover .pcard-lift),
  .p2-panel :global(.pcard-slot--scale:focus-within .pcard-lift) {
    transform: translateY(-12px) scale(1.02);
  }
  .p2-panel {
    transition: opacity 240ms ease;
  }
  .p2-panel.is-leaving,
  .p2-panel.is-entering {
    opacity: 0;
  }
  .p2-panel[hidden] {
    display: none;
  }
  /* Description taglines hidden on this revamp; feature lists stay. */
  .p2-panel :global(.pcard-desc),
  .p2-panel :global(.addon-short) {
    display: none;
  }
  .ads-wrap {
    display: flex;
    justify-content: center;
  }
  .ads-distinction {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding-top: 32px;
  }
  .ads-option {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    text-align: center;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .ads-option p.ads-option-tag {
    display: inline-block;
    color: #fff;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    margin: 0 0 8px;
  }
  /* Bundle cards: BundleCard defines no .bc-name-row rule at all, so
     the title took the full width and the cart button dropped below
     it, on desktop and mobile alike. Pricing2 only: put the button
     back on the right of the title. */
  .p2-panel :global(.bc-name-row) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .p2-panel :global(.bc-name) {
    flex: 1 1 auto;
    min-width: 0;
  }
  /* Ads options: pronounced side borders in their own colour, plus a
     subtle glow in the same colour. The selected option glows harder. */
  .ads-option {
    cursor: pointer;
    position: relative;
  }
  .ads-option--both {
    --opt-accent: var(--accent);
    border: 1.5px solid var(--opt-accent);
    border-top: 3px solid var(--opt-accent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--opt-accent) 20%, transparent);
  }
  .ads-option--meta {
    --opt-accent: #1877f2;
    border: 1.5px solid var(--opt-accent);
    border-top: 3px solid var(--opt-accent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--opt-accent) 20%, transparent);
  }
  .ads-option--google {
    --opt-accent: #1a9e6a;
    border: 1.5px solid var(--opt-accent);
    border-top: 3px solid var(--opt-accent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--opt-accent) 20%, transparent);
  }
  .ads-option:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(10, 15, 28, 0.08), 0 0 24px color-mix(in srgb, var(--opt-accent) 25%, transparent);
  }
  .ads-option:active {
    transform: scale(0.99);
  }
  .ads-option:focus-visible {
    outline: 2px solid var(--opt-accent);
    outline-offset: 2px;
  }
  /* No border-width change on selection: that would shift the layout
     by half a pixel. The stronger glow plus the Selected pill below
     carry the state instead. */
  .ads-option.is-selected {
    box-shadow: 0 0 32px color-mix(in srgb, var(--opt-accent) 38%, transparent);
  }
  .ads-option.is-selected::after {
    content: "Selected";
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--opt-accent);
    color: #fff;
  }
  /* Subtle, satisfying press feedback on every pricing2 action, and a
     visible focus ring on cart buttons. Fast (120ms) so it never feels
     laggy, and no bounce or ripple that would get annoying. */
  .p2-panel :global(.cart-btn) {
    transition: transform 120ms ease, background 160ms ease, border-color 160ms ease;
  }
  .p2-panel :global(.cart-btn:active) {
    transform: scale(0.88);
  }
  .p2-panel :global(.cart-btn:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ads-option h3 {
    margin: 0 0 8px;
  }
  .ads-option p {
    margin: 6px 0;
    color: var(--muted);
  }
  .ads-option-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
  }
  .terms-band {
    background: var(--section-dark-bg);
    color: var(--section-dark-text);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .terms-band-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }
  .terms-band .eyebrow {
    color: rgba(248, 245, 239, 0.5);
  }
  .terms-band-title {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 0.95;
    margin-top: 10px;
  }
  .btn--lg {
    padding: 16px 30px;
    font-size: 1.02rem;
  }
  @media (max-width: 640px) {
    .service-chooser {
      flex-direction: column;
      align-items: stretch;
      width: min(320px, 100%);
    }
    .service-pill {
      text-align: center;
      width: 100%;
    }
    .ads-distinction {
      grid-template-columns: 1fr;
    }
  }
</style>
