  .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(700px 400px at 18% 18%, var(--hero-glow-a) 0%, transparent 62%), radial-gradient(600px 600px at 92% 88%, var(--hero-glow-b) 0%, transparent 58%), linear-gradient(180deg, transparent 0%, var(--hero-glow-b) 100%); }
