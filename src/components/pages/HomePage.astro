---
import CursorJourney from "../anim/CursorJourney.astro";
import { useTranslations, localizedPaths, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

const paths = localizedPaths[locale];
const processId = locale === "fr" ? "processus" : "process";
---

<!-- The signature intro is rendered by the page into BaseLayout's `overlay`
     slot (outside <main>), never here: <main> is transformed while the intro
     plays, and a transformed ancestor would push the fixed overlay off-screen. -->

<!-- HERO: watermark + parallax + split reveal -->
<section class="hero grain" id="hero">
  <div class="hero-watermark" aria-hidden="true"><span>WEBAO</span><span>WEBAO</span></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="hero-kicker" data-reveal>
        <span class="eyebrow" style="color: var(--accent-text);">{t.home.hero.kicker}</span>
        <span class="hero-badge">
          <span class="dot"></span> {t.home.hero.badge}
        </span>
      </div>

      <h1 class="hero-title display" data-reveal style="--d:80ms">
        {t.home.hero.title1}<br />
        <span class="hero-italic">{t.home.hero.titleWork}</span> {t.home.hero.title2}<br />
        {t.home.hero.title3}
      </h1>

      <p class="hero-lead prose" data-reveal style="--d:160ms">
        {t.home.hero.lead}
        <strong>{t.home.hero.leadStrong}</strong> {t.home.hero.leadRest}
      </p>

      <div class="hero-actions" data-reveal style="--d:240ms">
        <a href={paths.contact} class="btn btn--primary">
          {t.home.hero.ctaPrimary}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5"/></svg>
        </a>
        <a href={paths.demos} class="btn btn--ghost">
          {t.home.hero.ctaSecondary}
        </a>
        <span class="hero-note mono" set:html={t.home.hero.priceNote}></span>
      </div>
    </div>

    <div class="hero-visual" data-reveal="scale" style="--d:140ms" aria-hidden="true" data-hero-visual>
      <div class="visual-stack" data-parallax="stack">
        <!-- Top bar -->
        <div class="browser-bar">
          <div class="dots"><i></i><i></i><i></i></div>
          <div class="url">{t.home.hero.visual.url}</div>
          <div class="live"><i></i>{t.home.hero.visual.live}</div>
        </div>

        <!-- Main preview -->
        <div class="preview-main">
          <div class="preview-media">
            <svg viewBox="0 0 640 420" role="img" aria-label="Preview collage" class="preview-art">
              <defs>
                <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0A0F1C"/><stop offset="100%" stop-color="#1E2A3A"/>
                </linearGradient>
                <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
                  <path d="M32 0 H0 V32" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
                </pattern>
              </defs>
              <rect width="640" height="420" rx="16" fill="url(#g1)"/>
              <rect width="640" height="420" rx="16" fill="url(#grid)"/>
              <rect x="28" y="28" width="260" height="320" rx="14" fill="#F8F5EF"/>
              <rect x="42" y="46" width="180" height="10" rx="5" fill="#0A0F1C" opacity=".08"/>
              <rect x="42" y="66" width="232" height="26" rx="6" fill="#0A0F1C"/>
              <rect x="42" y="100" width="210" height="8" rx="4" fill="#0A0F1C" opacity=".36"/>
              <rect x="42" y="116" width="180" height="8" rx="4" fill="#0A0F1C" opacity=".18"/>
              <rect x="42" y="146" width="232" height="1" fill="#0A0F1C" opacity=".08"/>
              <rect x="42" y="164" width="232" height="150" rx="10" fill="#E3421E"/>
              <g opacity=".92">
                <path d="M58 264 q56 -48 96 0 t 104 0" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
                <circle cx="210" cy="198" r="22" fill="white" opacity=".95"/>
              </g>
              <rect x="306" y="28" width="306" height="140" rx="14" fill="white" opacity=".96"/>
              <rect x="324" y="48" width="110" height="8" rx="4" fill="#0A0F1C" opacity=".08"/>
              <rect x="324" y="64" width="170" height="12" rx="6" fill="#0A0F1C"/>
              <rect x="324" y="86" width="150" height="7" rx="3.5" fill="#0A0F1C" opacity=".30"/>
              <g transform="translate(324 108)">
                <rect width="88" height="28" rx="14" fill="#0A0F1C"/><text x="18" y="18" font-size="11" font-family="Inter" fill="white" font-weight="600">{locale==="fr" ? "Devis" : "Get Quote"}</text>
                <rect x="96" y="0" width="88" height="28" rx="14" fill="none" stroke="#0A0F1C" stroke-opacity=".12"/><text x="112" y="18" font-size="11" font-family="Inter" fill="#0A0F1C" font-weight="600">{locale==="fr" ? "Réalisations" : "Our Work"}</text>
              </g>
              <g transform="translate(306 182)">
                <rect width="148" height="96" rx="12" fill="white"/>
                <rect x="14" y="14" width="36" height="36" rx="8" fill="#F8F5EF" stroke="#0A0F1C" stroke-opacity=".06"/>
                <text x="14" y="76" font-size="11" font-family="Inter" font-weight="650" fill="#0A0F1C">{locale==="fr" ? "Résidentiel" : "Residential"}</text>
                <text x="14" y="88" font-size="10" font-family="Inter" fill="#6B7288">{locale==="fr" ? "Urgence 24h" : "24h emergency"}</text>
                <rect x="158" y="0" width="148" height="96" rx="12" fill="#0A0F1C"/>
                <circle cx="172" cy="32" r="18" fill="white" opacity=".12"/><path d="M166 32 h12 M172 26 v12" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
                <text x="172" y="76" font-size="11" font-family="Inter" font-weight="650" fill="white">{locale==="fr" ? "Commercial" : "Commercial"}</text>
                <text x="172" y="88" font-size="10" font-family="Inter" fill="white" opacity=".6">{locale==="fr" ? "Certifié et assuré" : "Certified & insured"}</text>
              </g>
              <g transform="translate(306 290)">
                <rect width="306" height="58" rx="12" fill="#0A0F1C"/>
                <text x="16" y="24" font-size="10" font-family="IBM Plex Mono" fill="white" opacity=".5" letter-spacing="2">{locale==="fr" ? "PROCHAINE DISPO" : "NEXT AVAILABLE"}</text>
                <text x="16" y="42" font-size="13" font-family="Inter" font-weight="650" fill="white">{locale==="fr" ? "Demain à 9h00 · Réserver" : "Tomorrow at 9:00 AM · Book now"}</text>
                <circle cx="280" cy="29" r="16" fill="white"/><path d="M274 29 l5 5 6-6" fill="none" stroke="#0A0F1C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
            </svg>
          </div>
          <div class="preview-meta">
            <div class="meta-left">
              <span class="mono" style="font-size:10px; color: var(--muted);">{t.home.hero.visual.demoLabel}</span>
              <span style="font-weight:650; letter-spacing:-0.02em;">{t.home.hero.visual.demoTone}</span>
            </div>
            <span class="pill">{t.home.hero.visual.mobileReady}</span>
          </div>
        </div>

        <div class="float-card float-a" data-parallax="a">
          <div class="float-icon">◐</div>
          <div>
            <div style="font-weight: 700; font-size: 13px; letter-spacing:-0.02em;">{t.home.hero.visual.domainIncluded}</div>
            <div style="font-size: 12.5px; color: var(--muted);">{t.home.hero.visual.domainDesc}</div>
          </div>
          <span class="check">✓</span>
        </div>
        <div class="float-card float-b" data-parallax="b">
          <div style="font-family: var(--font-mono); font-size:10px; letter-spacing:.12em; color: var(--muted);">{t.home.hero.visual.smallUpdates}</div>
          <div style="font-family: var(--font-display); font-size:24px; line-height:1.05; margin-top:6px;" set:html={t.home.hero.visual.hours}></div>
          <ul class="float-list" role="list">
            <li><i>✓</i> {t.home.hero.visual.included}</li>
            <li><i>✓</i> {t.home.hero.visual.sendEmail}</li>
          </ul>
        </div>
      </div>

      <div class="visual-caption mono">
        <span>{t.home.hero.visual.captionLeft}</span>
        <span style="opacity:.5;">{t.home.hero.visual.captionRight}</span>
      </div>
    </div>
  </div>

  <div class="hero-rail" aria-hidden="true">
    <div class="rail-line"></div>
    <span class="mono">{locale==="fr" ? "DÉFILER" : "SCROLL"}</span>
    <div class="rail-line"></div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span class="marquee-item" set:html={t.home.marquee}></span>
    <span class="marquee-item" set:html={t.home.marquee}></span>
    <span class="marquee-item" set:html={t.home.marquee}></span>
    <span class="marquee-item" set:html={t.home.marquee}></span>
  </div>
</div>

<!-- POSITIONING / INTRO -->
<section class="section grain">
  <div class="shell">
    <div class="intro-grid">
      <div data-reveal>
        <div class="eyebrow">{t.home.why.eyebrow}</div>
        <h2 class="display" style="font-size: clamp(2.2rem, 5vw, 4.2rem); margin-top: 14px; line-height:.92;">
          {t.home.why.title1}<br />
          {t.home.why.title2}<br />
          <span style="font-style: italic; font-weight:400;">{t.home.why.title3}</span>
        </h2>
      </div>
      <div class="intro-copy" data-reveal style="--d:120ms">
        <p class="prose" set:html={t.home.why.p1}></p>
        <p class="prose" style="margin-top: 16px; color: var(--muted);">
          {t.home.why.p2}
        </p>

        <div class="cluster" style="margin-top: 28px;">
          <a href={paths.pricing} class="btn btn--dark btn--sm">{t.home.why.cta}</a>
          <span class="mono" style="font-size:11px; color: var(--muted);">{t.home.why.note}</span>
        </div>
      </div>
    </div>

    <div class="feature-grid" data-reveal style="--d:180ms">
      {t.home.why.features.map((f) => (
        <div class="f-card">
          <div class="f-icon">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
      <!-- Accent card: inverts against its siblings in both themes -->
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id={processId} class="section section--dark grain" style="overflow: clip;">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div class="eyebrow" style="color: rgba(248,245,239,.5);">{t.home.process.eyebrow}</div>
      <h2 class="display" style="font-size: clamp(2.4rem, 6vw, 5rem); margin-top: 12px; line-height:.92;" set:html={t.home.process.title}></h2>
    </div>

    <div class="steps">
      {t.home.process.steps.map((step: any, idx: number) => (
        <div class="step" data-reveal style={`--d:${idx*100}ms`}>
          <div class="step-n">0{idx+1}</div>
          <div class="step-body">
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
            <ul class="step-list mono">
              {step.bullets.map((b: string) => <li>{b}</li>)}
            </ul>
          </div>
          <div class="step-visual">
            {idx === 0 && (
              <div class="mini-card">
                <div class="mono" style="font-size:10px; opacity:.5;">{step.visualInbox}</div>
                <div style="margin-top:10px; font-size:13px; line-height:1.5;"><strong>{step.subject}</strong> {step.subjectText}</div>
                <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">{step.tags?.map((tag: string) => <span class="tag">{tag}</span>)}</div>
                <div style="margin-top:12px; height:1px; background: var(--line);"></div>
                <div style="margin-top:10px; display:flex; align-items:center; gap:8px; font-size:13px;"><span style="width:28px;height:28px;border-radius:99px;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-size:11px;">W</span> {step.reply} <span style="margin-left:auto; color: var(--accent-text);">↗</span></div>
              </div>
            )}
            {idx === 1 && (
              <div class="mini-card mini-card--dark">
                <div style="display:flex; align-items:center; gap:8px;"><span style="width:8px;height:8px;border-radius:99px;background:#00D084;"></span><span class="mono" style="font-size:10px; opacity:.7; color:white;">{step.preview}</span></div>
                <div style="margin-top:14px; height:86px; border-radius:10px; overflow:hidden; background: linear-gradient(135deg,#F8F5EF 0%, #EFE9DE 100%); position:relative;">
                  <div style="position:absolute; inset:12px; border-radius:8px; background:white; border:1px solid rgba(10,15,28,.06); padding:10px;">
                    <div style="height:6px; width:42%; border-radius:99px; background:#0A0F1C; opacity:.9;"></div>
                    <div style="height:4px; width:64%; border-radius:99px; background:#0A0F1C; opacity:.14; margin-top:8px;"></div>
                    <div style="display:flex; gap:6px; margin-top:10px;"><span style="flex:1; height:22px; border-radius:99px; background:#FF3B30;"></span><span style="flex:1; height:22px; border-radius:99px; border:1px solid rgba(10,15,28,.12);"></span></div>
                  </div>
                </div>
                <div style="margin-top:12px; display:flex; gap:8px;"><span class="btn btn--primary btn--sm" style="flex:1; justify-content:center;">{step.approve}</span><span class="btn btn--ghost btn--sm" style="flex:1; justify-content:center; border-color: rgba(255,255,255,.14); color:white;">{step.comment}</span></div>
              </div>
            )}
            {idx === 2 && (
              <div class="mini-card">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                  <span class="mono" style="font-size:10px; opacity:.5;">{step.launchDay}</span>
                  <span style="font-size:11px; background:var(--ink); color:var(--paper); padding:4px 8px; border-radius:99px; font-weight:600;">{step.live}</span>
                </div>
                <div style="margin-top:12px; display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:12.5px;">
                  <div style="background:#F8F5EF; border-radius:10px; padding:10px; text-align:center;"><div style="font-weight:700;">{step.ssl}</div><div style="opacity:.6; font-size:11px;">{step.sslDesc}</div></div>
                  <div style="background:#F8F5EF; border-radius:10px; padding:10px; text-align:center;"><div style="font-weight:700;">{step.backups}</div><div style="opacity:.6; font-size:11px;">{step.backupsDesc}</div></div>
                </div>
                <div style="margin-top:10px; font-size:12.5px; color: var(--muted); text-align:center;">{step.needChange} <a href={paths.contact} style="color:var(--accent-text); font-weight:600; text-decoration:underline; text-underline-offset:3px;">{step.sendMessage}</a></div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="steps-cta" data-reveal>
      <a href={paths.contact} class="btn btn--primary">{t.home.process.cta}</a>
      <span class="mono" style="color: rgba(248,245,239,.5); font-size:11px;">
        {t.home.process.ctaNote.split("{link}")[0]}
        <a href={paths.contact} style="color: var(--section-dark-text); text-decoration: underline; text-underline-offset: 3px;">{t.home.process.sendDetails}</a>{t.home.process.ctaNote.split("{link}")[1] ?? ""}
      </span>
    </div>
  </div>
</section>

<!-- DEMOS PREVIEW -->
<section class="section">
  <div class="shell">
    <div class="split-head" data-reveal>
      <div>
        <div class="eyebrow">{t.home.demosPreview.eyebrow}</div>
        <h2 class="display" style="font-size: clamp(2.2rem, 5.2vw, 4.4rem); margin-top:10px; line-height:.92;" set:html={t.home.demosPreview.title}></h2>
      </div>
      <div class="split-head-actions">
        <p class="prose" style="font-size: 15px; max-width: 38ch;">{t.home.demosPreview.desc}</p>
        <a href={paths.demos} class="btn btn--ghost btn--sm" style="margin-top:16px;">{t.home.demosPreview.browse}</a>
      </div>
    </div>

    <div class="demo-strip">
      <a href={paths.demos} class="demo-card demo-card--dark" data-reveal>
        <div class="demo-media">
          <div class="demo-tag mono">{t.home.demosPreview.cards[0].tag}</div>
          <div class="demo-title">NORA <span>ÉLECTRIQUE</span></div>
          <div class="demo-sub mono">{t.home.demosPreview.cards[0].sub}</div>
          <div class="demo-lines"><i style="width:92%"></i><i style="width:68%; opacity:.5"></i></div>
        </div>
        <div class="demo-foot">
          <span style="font-weight:650; letter-spacing:-0.02em;">Nora Électrique</span>
          <span class="mono" style="font-size:11px; opacity:.6;">{t.home.demosPreview.view}</span>
        </div>
      </a>
      <a href={paths.demos} class="demo-card demo-card--paper" data-reveal style="--d:100ms">
        <div class="demo-media" style="background: #FFF7ED;">
          <div class="demo-tag mono" style="color: #9A3412;">{t.home.demosPreview.cards[1].tag}</div>
          <div class="demo-title" style="color:#431407; font-family: var(--font-display); font-style: italic; letter-spacing:-0.03em;">Mira <span style="font-style: normal; font-weight:400;">Cantine</span></div>
          <div class="demo-sub mono" style="color:#9A3412;">{t.home.demosPreview.cards[1].sub}</div>
          <div style="margin-top:18px; display:flex; gap:8px;">
            <span style="background:#431407; color:#FFF7ED; padding:6px 12px; border-radius:99px; font-size:11px; font-weight:650;">{t.home.demosPreview.cards[1].reserve}</span>
            <span style="border:1px solid rgba(67,20,7,.14); padding:6px 12px; border-radius:99px; font-size:11px;">{t.home.demosPreview.cards[1].menu}</span>
          </div>
        </div>
        <div class="demo-foot">
          <span style="font-weight:650; letter-spacing:-0.02em;">Mira Cantine</span>
          <span class="mono" style="font-size:11px; opacity:.6;">{t.home.demosPreview.view}</span>
        </div>
      </a>
      <a href={paths.demos} class="demo-card demo-card--ink" data-reveal style="--d:200ms">
        <div class="demo-media" style="background:#0F172A; color:#E2E8F0;">
          <div class="demo-tag mono" style="color: rgba(226,232,240,.5);">{t.home.demosPreview.cards[2].tag}</div>
          <div class="demo-title" style="color:white; letter-spacing:-0.04em;">ATELIER <span style="font-weight:400; opacity:.7;">NORD</span></div>
          <div class="demo-sub mono" style="color: rgba(226,232,240,.6);">{t.home.demosPreview.cards[2].sub}</div>
          <div style="margin-top:16px; height:1px; background: rgba(226,232,240,.12);"></div>
          <div style="margin-top:14px; display:flex; gap:8px; font-size:11px;"><span style="color: white; font-weight:650;">Services</span><span style="opacity:.5;">·</span><span style="opacity:.7;">Inventaire</span><span style="opacity:.5;">·</span><span style="opacity:.7;">Rendez-vous</span></div>
        </div>
        <div class="demo-foot" style="background:#0F172A; color:#E2E8F0; border-top-color: rgba(226,232,240,.08);">
          <span style="font-weight:650; letter-spacing:-0.02em;">Atelier Nord</span>
          <span class="mono" style="font-size:11px; opacity:.5;">{t.home.demosPreview.view}</span>
        </div>
      </a>
    </div>

    <div class="demo-browse" data-reveal>
      <div class="demo-browse-left">
        <span class="mono" style="font-size:11px; color: var(--muted);">{t.home.demosPreview.also}</span>
        <div class="chips">
          {t.home.demosPreview.chips.map(c => <span>{c}</span>)}
        </div>
      </div>
      <a href={paths.demos} class="btn btn--dark" style="white-space:nowrap;">{t.home.demosPreview.searchFilter}</a>
    </div>
  </div>
</section>

<!-- AGENCY CARDS -->
<section class="section section--ink2 grain" style="padding-bottom: 0;">
  <div class="shell">
    <div class="agency-head" data-reveal>
      <h2 class="display" style="font-size: clamp(2.6rem, 6vw, 5.2rem); line-height:.9; color: var(--section-dark-text);">{t.home.agency.title}</h2>
      <p class="mono" style="color: rgba(248,245,239,.5); margin-top:12px; font-size: 12px;">{t.home.agency.subtitle}</p>
    </div>

    <div class="agency-grid" style="position: relative;">
      <CursorJourney locale={locale} />
      <a href={paths.pricing} class="agency-card agency-card--pricing" data-reveal>
        <div class="agency-top mono">
          <span>{t.home.agency.pricing.top}</span><span aria-hidden="true">→</span>
        </div>
        <div class="agency-body">
          <div class="agency-price">
            <span class="display">{t.home.agency.pricing.price}</span>
            <span class="mono" set:html={t.home.agency.pricing.priceSuffix}></span>
          </div>
          <h3 class="agency-title" set:html={t.home.agency.pricing.title}></h3>
          <p>{t.home.agency.pricing.desc}</p>
        </div>
        <div class="agency-foot">
          <span class="agency-cta">{t.home.agency.pricing.cta} <span aria-hidden="true">↗</span></span>
          <div class="agency-mini">
            {t.home.agency.pricing.mini.map(m => <span>{m}</span>)}
          </div>
        </div>
        <div class="agency-art" aria-hidden="true">
          <div class="art-price"></div>
        </div>
      </a>

      <a href={paths.contact} class="agency-card agency-card--contact" data-reveal style="--d:120ms">
        <div class="agency-top mono" style="color: var(--muted);">
          <span>{t.home.agency.contact.top}</span><span aria-hidden="true">→</span>
        </div>
        <div class="agency-body" style="color: var(--ink);">
          <h3 class="agency-title" style="color: var(--ink);" set:html={t.home.agency.contact.title}></h3>
          <p style="color: var(--muted);">{t.home.agency.contact.desc}</p>
          <div class="contact-pills">
            {t.home.agency.contact.pills.map(p => <span>{p}</span>)}
          </div>
        </div>
        <div class="agency-foot" style="border-top-color: var(--line); color: var(--ink);">
          <span class="agency-cta" style="background: var(--ink); color: var(--paper);">{t.home.agency.contact.cta} <span aria-hidden="true">↗</span></span>
        </div>
