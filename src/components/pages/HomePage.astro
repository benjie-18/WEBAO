---
import DemoCarousel from "../home/DemoCarousel.astro";
import { useTranslations, localizedPaths, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

const paths = localizedPaths[locale];
const processId = locale === "fr" ? "processus" : "process";
---

<!-- The signature intro is rendered by the page into BaseLayout's `overlay`
     slot (outside <main>), never here: <main> is transformed while the intro
     plays, and a transformed ancestor would push the fixed overlay off-screen. -->

<!-- HERO: asymmetric editorial. Copy on cols 1-7, a vertical fracture
     divider, and the live site fragment on cols 9-12 bleeding off the right
     edge. Exactly 4 text elements: title, lead, primary CTA, price note.
     Entrance is gated on data-hero-enter, fired by the intro handoff
     (or immediately when no intro plays). -->
<section class="hero grain" id="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title display" data-hero-title>
        {t.home.hero.title1} <span class="hero-italic">{t.home.hero.titleWork}</span><br />
        {t.home.hero.title2} {t.home.hero.title3}
      </h1>

      <p class="hero-lead prose" data-hero-lead>
        {t.home.hero.lead}
        <strong>{t.home.hero.leadStrong}</strong> {t.home.hero.leadRest}
      </p>

      <div class="hero-actions" data-hero-actions>
        <a href={paths.pricing} class="btn btn--primary">
          {t.home.hero.ctaPrimary}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
        </a>
        <span class="hero-note mono" set:html={t.home.hero.priceNote}></span>
      </div>
    </div>

    <div class="hero-fracture" aria-hidden="true"><span class="fracture-v"></span></div>

  </div>

</section>


<!-- DEMO CAROUSEE : real demo homepages, auto-rotating -->
<DemoCarousel locale={locale} />

<!-- OFFER: asymmetric. One pricing panel (60%) + two text links (40%).
     Kills the three-equal-cards template. No eyebrow in this section. -->
<section class="section section--ink2 grain" style="padding-bottom: 0;">
  <div class="shell">
    <div class="offer-head" data-reveal>
      <h2 class="display" style="font-size: clamp(2.6rem, 6vw, 5.2rem); line-height:.9; color: var(--section-dark-text);">{t.home.agency.title}</h2>
      <p class="mono" style="color: rgba(248,245,239,.5); margin-top:12px; font-size: 12px;">{t.home.agency.subtitle}</p>
    </div>

    <div class="offer-grid">
      <a href={paths.pricing} class="offer-panel fracture-reveal" data-offer-panel>
        <span class="offer-fracture" aria-hidden="true"></span>
        <span class="offer-panel-top mono">
          <span>{t.home.agency.pricing.top}</span><span aria-hidden="true">→</span>
        </span>
        <span class="offer-price">
          <span class="display">{t.home.agency.pricing.price}</span>
          <span class="mono" set:html={t.home.agency.pricing.priceSuffix}></span>
        </span>
        <span class="offer-title display" set:html={t.home.agency.pricing.title}></span>
        <span class="offer-desc">{t.home.agency.pricing.desc}</span>
        <span class="offer-foot">
          <span class="offer-cta">{t.home.agency.pricing.cta} <span aria-hidden="true">↗</span></span>
          <span class="offer-mini mono">
            {t.home.agency.pricing.mini.map(m => <span>{m}</span>)}
          </span>
        </span>
      </a>

      <div class="offer-links" data-reveal style="--d:120ms">
        <a href={paths.contact} class="offer-link">
          <span class="mono offer-link-top"><span>{t.home.agency.contact.top}</span><span aria-hidden="true">→</span></span>
          <span class="offer-link-title display" set:html={t.home.agency.contact.title}></span>
          <span class="offer-link-desc">{t.home.agency.contact.desc}</span>
          <span class="offer-link-pills">
            {t.home.agency.contact.pills.map(p => <span>{p}</span>)}
          </span>
          <span class="offer-link-cta">{t.home.agency.contact.cta} <span aria-hidden="true">↗</span></span>
        </a>
        <a href={paths.demos} class="offer-link">
          <span class="mono offer-link-top"><span>{t.home.agency.demos.top}</span><span aria-hidden="true">→</span></span>
          <span class="offer-link-title display" set:html={t.home.agency.demos.title}></span>
          <span class="offer-link-desc">{t.home.agency.demos.desc}</span>
          <span class="offer-link-mini mono">
            {t.home.agency.demos.mini.map(m => <span>{m}</span>)}
          </span>
          <span class="offer-link-cta">{t.home.agency.demos.cta} <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>

    <div class="offer-note mono" data-reveal>
      <span>{t.home.agency.noteLeft}</span>
      <span style="opacity:.4;">{t.home.agency.noteRight}</span>
    </div>
  </div>
  <div class="angle-divider" aria-hidden="true"></div>
</section>

<!-- HOW IT WORKS : pinned scrubbed timeline -->
<section id={processId} class="section section--dark grain process">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div class="eyebrow" style="color: rgba(248,245,239,.5);">{t.home.process.eyebrow}</div>
      <h2 class="display" style="font-size: clamp(2.4rem, 6vw, 5rem); margin-top: 12px; line-height:.92;" set:html={t.home.process.title}></h2>
    </div>
  </div>

  <div class="pin-wrap" data-process-pin>
    <div class="pin-stage">
      <div class="shell">
        <div class="journey" data-journey>
          <div class="journey-ends mono" aria-hidden="true">
            <span>DAY 0</span>
            <span data-day-readout>DAY 0</span>
            <span>DAY 7</span>
          </div>
          <div class="journey-track">
            <div class="journey-line" aria-hidden="true"></div>
            <div class="crack-fill" data-crack-fill aria-hidden="true"><span class="crack-spark" aria-hidden="true"></span></div>
            <ol class="stations" role="list">
              {t.home.process.steps.map((step: any, idx: number) => (
                <li class="station" data-station={idx} style={`--pos:${[6, 50, 94][idx]}%`}>
                  <span class="station-node" aria-hidden="true"><span class="oglyph">0{idx+1}</span></span>
                  <div class="station-card">
                    <div class="station-body">
                      <h3>{step.title}</h3>
                      <p>{step.desc}</p>
                      <ul class="step-list mono">
                        {step.bullets.map((b: string) => <li>{b}</li>)}
                      </ul>
                    </div>
                    <div class="station-visual">
                      {idx === 0 && (
                        <div class="mini-card">
                          <div class="mono" style="font-size:10px; opacity:.5;">{step.visualInbox}</div>
                          <div style="margin-top:10px; font-size:13px; line-height:1.5;"><strong>{step.subject}</strong> {step.subjectText}</div>
                          <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">{step.tags?.map((tag: string) => <span class="tag">{tag}</span>)}</div>
                          <div style="margin-top:12px; height:1px; background: var(--line);"></div>
                          <div style="margin-top:10px; display:flex; align-items:center; gap:8px; font-size:13px;"><span style="width:28px;height:28px;border-radius:99px;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-size:11px;"><span class="oglyph">W</span></span> {step.reply} <span style="margin-left:auto; color: var(--accent-text);">↗</span></div>
                        </div>
                      )}
                      {idx === 1 && (
                        <div class="mini-card mini-card--dark">
                          <div style="display:flex; align-items:center; gap:8px;"><span style="width:8px;height:8px;border-radius:99px;background:#00D084;"></span><span class="mono" style="font-size:10px; opacity:.7; color:white;">{step.preview}</span></div>
                          <div style="margin-top:14px; height:86px; border-radius:10px; overflow:hidden; background: linear-gradient(135deg,#F8F5EF 0%, #EFE9DE 100%); position:relative;">
                            <div style="position:absolute; inset:12px; border-radius:8px; background:white; border:1px solid rgba(10,15,28,.06); padding:10px;">
                              <div style="height:6px; width:42%; border-radius:99px; background:#0A0F1C; opacity:.9;"></div>
                              <div style="height:4px; width:64%; border-radius:99px; background:#0A0F1C; opacity:.14; margin-top:8px;"></div>
                              <div style="display:flex; gap:6px; margin-top:10px;"><span style="flex:1; height:22px; border-radius:99px; background:#FF3B30;"></span><span style="flex:1; height:22px; border-radius:99px; border:1px solid rgba(10,15,28,.12);"></span></div>
                            </div>
                          </div>
                          <div style="margin-top:12px; display:flex; gap:8px;"><span class="btn btn--primary btn--sm" style="flex:1; justify-content:center;">{step.approve}</span><span class="btn btn--ghost btn--sm" style="flex:1; justify-content:center; border-color: rgba(255,255,255,.14); color:white;">{step.comment}</span></div>
                        </div>
                      )}
                      {idx === 2 && (
                        <div class="mini-card">
                          <div style="display:flex; align-items:center; justify-content:space-between;">
                            <span class="mono" style="font-size:10px; opacity:.5;">{step.launchDay}</span>
                            <span style="font-size:11px; background:var(--ink); color:var(--paper); padding:4px 8px; border-radius:99px; font-weight:600;">{step.live}</span>
                          </div>
                          <div style="margin-top:12px; display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:12.5px;">
                            <div style="background:#F8F5EF; color:#0A0F1C; border-radius:10px; padding:10px; text-align:center;"><div style="font-weight:700;">{step.ssl}</div><div style="opacity:.6; font-size:11px;">{step.sslDesc}</div></div>
                            <div style="background:#F8F5EF; color:#0A0F1C; border-radius:10px; padding:10px; text-align:center;"><div style="font-weight:700;">{step.backups}</div><div style="opacity:.6; font-size:11px;">{step.backupsDesc}</div></div>
                          </div>
                          <div style="margin-top:10px; font-size:12.5px; color: var(--muted); text-align:center;">{step.needChange} <a href={paths.contact} style="color:var(--accent-text); font-weight:600; text-decoration:underline; text-underline-offset:3px;">{step.sendMessage}</a></div>
                        </div>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="shell">
    <div class="steps-cta" data-reveal>
      <a href={paths.contact} class="btn btn--primary">{t.home.process.cta}</a>
      <span class="mono" style="color: rgba(248,245,239,.5); font-size:11px;">
        {t.home.process.ctaNote.split("{link}")[0]}
        <a href={paths.contact} style="color: var(--section-dark-text); text-decoration: underline; text-underline-offset: 3px;">{t.home.process.sendDetails}</a>{t.home.process.ctaNote.split("{link}")[1] ?? ""}
      </span>
    </div>
  </div>
</section>

<!-- CRAFT / EDITORIAL -->
<section class="section section--tight">
  <div class="shell">
    <div class="craft-grid" data-reveal>
      <div class="craft-visual">
        <div class="craft-frame">
          <div class="craft-img">
            <svg viewBox="0 0 560 680" class="craft-svg" role="img" aria-label="Craft collage">
              <rect width="560" height="680" rx="18" fill="#0A0F1C"/>
              <g opacity=".95">
                <rect x="0" y="0" width="560" height="420" rx="18" fill="#0A0F1C"/>
                <g stroke="rgba(255,255,255,.08)" stroke-width="1" fill="none">
                  <path d="M24 42 H536 M24 72 H536 M24 102 H536 M24 132 H536 M24 162 H536 M24 192 H536 M24 222 H536 M24 252 H536 M24 282 H536"/>
                  <path d="M42 24 V396 M92 24 V396 M142 24 V396 M192 24 V396 M242 24 V396 M292 24 V396 M342 24 V396 M392 24 V396 M442 24 V396 M492 24 V396"/>
                </g>
                <rect x="28" y="28" width="504" height="360" rx="14" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1.2"/>
                <rect x="40" y="42" width="480" height="28" rx="8" fill="rgba(255,255,255,.06)"/>
                <circle cx="56" cy="56" r="5" fill="#FF5F57"/><circle cx="72" cy="56" r="5" fill="#FFBD2E"/><circle cx="88" cy="56" r="5" fill="#28C940"/>
                <rect x="40" y="84" width="220" height="100" rx="10" fill="white" opacity=".96"/>
                <rect x="52" y="98" width="160" height="8" rx="4" fill="#0A0F1C" opacity=".08"/>
                <rect x="52" y="114" width="120" height="12" rx="6" fill="#0A0F1C"/>
                <rect x="52" y="136" width="180" height="6" rx="3" fill="#0A0F1C" opacity=".18"/>
                <rect x="52" y="152" width="90" height="22" rx="11" fill="#FF3B30"/>
                <rect x="272" y="84" width="248" height="180" rx="10" fill="rgba(255,255,255,.08)" stroke="rgba(255,255,255,.12)"/>
                <g transform="translate(284 96)">
                  <rect width="224" height="8" rx="4" fill="white" opacity=".18"/>
                  <rect y="16" width="180" height="6" rx="3" fill="white" opacity=".10"/>
                  <rect y="32" width="224" height="6" rx="3" fill="white" opacity=".08"/>
                  <rect y="48" width="200" height="6" rx="3" fill="white" opacity=".08"/>
                  <g transform="translate(0 72)">
                    <rect width="104" height="64" rx="8" fill="white" opacity=".96"/>
                    <rect x="114" y="0" width="110" height="64" rx="8" fill="#FF3B30"/>
                  </g>
                </g>
                <g transform="translate(40 198)">
                  <rect width="154" height="44" rx="10" fill="white" opacity=".96"/>
                  <rect x="166" y="0" width="154" height="44" rx="10" fill="white" opacity=".08" stroke="rgba(255,255,255,.14)"/>
                  <rect x="332" y="0" width="154" height="44" rx="10" fill="white" opacity=".08" stroke="rgba(255,255,255,.14)"/>
                </g>
              </g>
              <rect x="20" y="400" width="520" height="260" rx="14" fill="#F8F5EF"/>
              <text x="44" y="438" font-family="Instrument Serif" font-size="26" fill="#0A0F1C">{t.home.craft.built1}</text>
              <text x="44" y="466" font-family="Instrument Serif" font-size="26" fill="#0A0F1C" font-style="italic">{t.home.craft.built2}</text>
              <text x="44" y="496" font-family="Inter" font-size="12.5" fill="#6B7288">{t.home.craft.builtDesc1}</text>
              <text x="44" y="514" font-family="Inter" font-size="12.5" fill="#6B7288">{t.home.craft.builtDesc2}</text>
              <g transform="translate(44 536)">
                <rect width="124" height="32" rx="16" fill="#0A0F1C"/><text x="14" y="20" font-family="Inter" font-size="11.5" fill="white" font-weight="600">{t.home.craft.badges[0]}</text>
                <rect x="132" y="0" width="110" height="32" rx="16" fill="none" stroke="#0A0F1C" stroke-opacity=".12"/><text x="146" y="20" font-family="Inter" font-size="11.5" fill="#0A0F1C" font-weight="600">{t.home.craft.badges[1]}</text>
              </g>
            </svg>
          </div>
          <div class="craft-float mono">
            <span>{t.home.craft.float}</span>
            <span style="opacity:.5;">{t.home.craft.float2}</span>
          </div>
          {t.home.craft.items.map((item, i) => (
            <aside class={`margin-note margin-note--${i}`} data-reveal style={`--d:${i * 90}ms`}>
              <span class="mono margin-note-tag">0{i + 1}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </aside>
          ))}
        </div>
      </div>
      <div class="craft-copy">
        <div class="eyebrow">{t.home.craft.eyebrow}</div>
        <h2 class="display" style="font-size: clamp(2rem, 4.4vw, 3.4rem); margin-top:10px; line-height:.92;" set:html={t.home.craft.title}></h2>
        <p class="prose" style="margin-top:16px;">{t.home.craft.desc}</p>

        <div class="cluster" style="margin-top: 24px;">
          <a href={paths.pricing} class="btn btn--ghost btn--sm">{t.home.craft.cta}</a>
          <span class="mono" style="font-size:11px; color: var(--muted);">{t.home.craft.note}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section" style="background: var(--paper-2); border-block: 1px solid var(--line);">
  <div class="shell">
    <div class="faq-grid">
      <div data-reveal>
        <h2 class="display" style="font-size: clamp(2rem, 4vw, 3.2rem); line-height:.92;" set:html={t.home.faq.title}></h2>
        <p class="prose" style="margin-top:14px; font-size:15px; color: var(--muted);">
          {t.home.faq.contactPrompt.split("{link}")[0]}
          <a href={paths.contact} style="color: var(--accent-text); font-weight:600; text-decoration: underline; text-underline-offset:3px;">{t.home.faq.askDirectly}</a>{t.home.faq.contactPrompt.split("{link}")[1] ?? ""}
        </p>
      </div>
      <div class="faq-list" data-reveal style="--d:100ms">
        {t.home.faq.items.map((item, i) => [
          i > 0 ? <div class="fracture-divider" aria-hidden="true"></div> : null,
          <details open={i===0}>
            <summary>{item.q}</summary>
            <div><p>{item.a}</p></div>
          </details>
        ])}
      </div>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta-statement grain">
  <div class="shell cta-statement-inner" data-reveal>
    <h2 class="display cta-statement-title" set:html={t.home.finalCta.title}></h2>
    <p class="cta-statement-desc">{t.home.finalCta.desc}</p>
    <div class="cluster cta-statement-actions">
      <a href={paths.pricing} class="btn btn--on-dark btn--crack"><span class="btn--crack-label">{t.home.finalCta.ctaPrimary}</span></a>
      <a href={paths.demos} class="btn btn--ghost-on-dark">{t.home.finalCta.ctaSecondary}</a>
    </div>
    <div class="mono cta-statement-contact">{t.home.finalCta.contact}</div>
  </div>
</section>

<style>
  /* --- HERO: asymmetric editorial ---
     12-track grid: copy 1-7, 14px vertical fracture divider, visual 9-12
     bleeding off the right viewport edge. Entrance gated on
     [data-hero-enter="true"] (intro handoff or immediate). */
  .hero { padding-block: clamp(24px, 4vw, 56px) clamp(32px, 5vw, 72px); background: linear-gradient(180deg, var(--paper) 0%, var(--paper-3) 100%); overflow: clip; position: relative; isolation: isolate; }
  .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(700px 400px at 18% 18%, var(--hero-glow-a) 0%, transparent 62%), radial-gradient(600px 600px at 92% 88%, var(--hero-glow-b) 0%, transparent 58%); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)) 14px repeat(4, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); align-items: center; }
  .hero-copy { grid-column: 1 / 8; min-width: 0; }
  .hero-fracture { grid-column: 8 / 9; align-self: stretch; display: flex; min-width: 0; }
  .fracture-v { width: 14px; align-self: stretch; min-height: 240px; background: var(--line); clip-path: polygon(43% 0%, 57% 7%, 36% 14%, 57% 22%, 43% 31%, 64% 40%, 36% 49%, 57% 58%, 43% 67%, 64% 76%, 36% 85%, 57% 93%, 43% 100%, 57% 100%, 71% 93%, 50% 85%, 78% 76%, 57% 67%, 71% 58%, 50% 49%, 78% 40%, 57% 31%, 71% 22%, 50% 14%, 71% 7%, 57% 0%); }
  .hero-visual { grid-column: 9 / 13; min-width: 0; position: relative; margin-right: calc((min(var(--content-max), 100vw - var(--content-pad) * 2) - 100vw) / 2); }
  .hero-title { font-size: clamp(2.9rem, 7.4vw, 6.4rem); line-height: .88; letter-spacing: -0.04em; text-wrap: balance; }
  .hero-title .hero-italic { font-style: italic; font-weight: 400; color: var(--accent); position: relative; }
  .hero-title .w { display: inline-block; opacity: 0; transform: translateY(.55em); will-change: transform, opacity; }
  [data-hero-enter="true"] .hero-title .w { animation: hero-word-in var(--dur-4) var(--ease-out-expo) forwards; animation-delay: calc(var(--wi, 0) * var(--stagger)); }
  @keyframes hero-word-in { to { opacity: 1; transform: translateY(0); } }
  .hero-title .hero-italic::after { content: ""; position: absolute; left: -2%; right: -2%; bottom: 0.08em; height: 0.34em; background: var(--accent-underline); z-index: -1; transform: scaleX(0); transform-origin: left; border-radius: 2px; }
  [data-hero-enter="true"] .hero-title .hero-italic::after { transform: scaleX(1); transition: transform var(--dur-5) var(--ease-out-expo) calc(6 * var(--stagger)); }
  .hero-lead { margin-top: 20px; max-width: 46ch; font-size: clamp(1rem, 1.5vw, 1.08rem); opacity: 0; }
  .hero-actions { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; opacity: 0; }
  .hero-note { width: 100%; margin-top: 4px; font-size: 11px; color: var(--muted); letter-spacing: .04em; }
  .hero-visual { opacity: 0; }
  [data-hero-enter="true"] .hero-lead, [data-hero-enter="true"] .hero-actions { animation: hero-rise var(--dur-4) var(--ease-out-expo) forwards; }
  [data-hero-enter="true"] .hero-lead { animation-delay: calc(5 * var(--stagger)); }
  [data-hero-enter="true"] .hero-actions { animation-delay: calc(7 * var(--stagger)); }
  [data-hero-enter="true"] .hero-visual { animation: hero-visual-in var(--dur-5) var(--ease-out-expo) forwards; animation-delay: calc(3 * var(--stagger)); }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes hero-visual-in { from { opacity: 0; transform: translateX(56px) rotate(.6deg); } to { opacity: 1; transform: translateX(0) rotate(0deg); } }
  .visual-stack { position: relative; background: var(--card-bg); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow-lg); overflow: clip; transform: perspective(1400px) rotateY(-6deg) rotateX(1deg); transform-origin: left center; }
  .browser-bar { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--line); background: var(--card-bg); }
  .dots { display:flex; gap:6px; } .dots i { width:10px; height:10px; border-radius:99px; background: #E6E0D6; display:block; } .dots i:nth-child(1){ background:#FF5F57; } .dots i:nth-child(2){ background:#FFBD2E; } .dots i:nth-child(3){ background:#28C940; }
