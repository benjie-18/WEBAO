  .offer-grid { margin-top: 28px; display:grid; grid-template-columns: 1.5fr 1fr; gap: clamp(20px, 3vw, 44px); align-items: stretch; }
  .offer-panel { position:relative; display:flex; flex-direction:column; gap:14px; background: var(--offer-panel-bg); color:#fff; border-radius: var(--r-lg); padding: clamp(24px, 3vw, 40px); overflow: clip; isolation:isolate; }
  .offer-panel:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .offer-fracture { position:absolute; left:0; top:-2%; bottom:-2%; width:16px; background: var(--section-ink2-bg); clip-path: polygon(43% 0%, 57% 7%, 36% 14%, 57% 22%, 43% 31%, 64% 40%, 36% 49%, 57% 58%, 43% 67%, 64% 76%, 36% 85%, 57% 93%, 43% 100%, 57% 100%, 71% 93%, 50% 85%, 78% 76%, 57% 67%, 71% 58%, 50% 49%, 78% 40%, 57% 31%, 71% 22%, 50% 14%, 71% 7%, 57% 0%); pointer-events:none; transition: transform var(--dur-3) var(--ease-out-expo); }
  .offer-panel-top { display:flex; justify-content:space-between; align-items:center; font-size:10px; letter-spacing:.14em; color: rgba(255,255,255,.8); }
  .offer-price { display:flex; align-items:baseline; gap:12px; margin-top:6px; flex-wrap:wrap; }
  .offer-price .display { font-size: clamp(4rem, 8vw, 6.5rem); line-height:.9; letter-spacing:-0.04em; }
  .offer-price .mono { font-size:11px; line-height:1.4; color: rgba(255,255,255,.75); }
  .offer-title { font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height:1; letter-spacing:-0.03em; font-weight:750; }
  .offer-desc { font-size:14px; line-height:1.6; color: rgba(255,255,255,.85); max-width: 44ch; }
  .offer-foot { margin-top:auto; padding-top:16px; border-top:1px solid rgba(255,255,255,.2); display:grid; gap:10px; }
  .offer-cta { display:inline-flex; align-items:center; gap:8px; font-weight:700; font-size:13px; letter-spacing:-0.01em; background:#fff; color: var(--offer-panel-bg); padding:10px 16px; border-radius:99px; width: fit-content; }
  .offer-mini { display:flex; gap:8px; flex-wrap:wrap; font-size:10px; letter-spacing:.04em; color: rgba(255,255,255,.80); }
  @media (hover: hover) and (pointer: fine) {
    /* Keep the fracture-reveal clip-path transition AND add the hover
       displacement; both transitions must be listed or one is lost. */
    .offer-panel { transition: clip-path var(--dur-5) var(--ease-out-expo), transform var(--dur-3) var(--ease-out-expo); }
    .offer-panel:hover { transform: translateX(10px); }
    .offer-panel:hover .offer-fracture { transform: translateX(-7px); }
    .offer-link { transition: transform var(--dur-3) var(--ease-out-expo); }
    .offer-link:hover { transform: translateX(8px); }
    .offer-link:hover .offer-link-cta { color: var(--accent); border-bottom-color: var(--accent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .offer-panel, .offer-panel .offer-fracture, .offer-link { transition: none; }
    .offer-panel:hover, .offer-panel:hover .offer-fracture, .offer-link:hover { transform: none; }
  }
  .offer-links { display:grid; gap:0; align-content:start; }
  .offer-link { display:grid; gap:8px; padding: 22px 4px; border-top:1px solid var(--line-on-dark); color: var(--section-dark-text); align-content:start; }
  .offer-link:last-child { border-bottom:1px solid var(--line-on-dark); }
  .offer-link-top { display:flex; justify-content:space-between; align-items:center; font-size:10px; letter-spacing:.14em; color: rgba(248,245,239,.5); }
  .offer-link-title { font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height:1.02; letter-spacing:-0.03em; font-weight:750; }
  .offer-link-desc { font-size:13.5px; line-height:1.6; color: var(--section-dark-soft); max-width: 38ch; }
  .offer-link-pills { display:flex; flex-wrap:wrap; gap:8px; }
  .offer-link-pills span { border:1px solid var(--line-on-dark); padding:7px 12px; border-radius:99px; font-size:12px; font-weight:600; letter-spacing:-0.01em; }
  .offer-link-mini { display:flex; gap:8px; flex-wrap:wrap; font-size:10px; letter-spacing:.04em; color: rgba(248,245,239,.5); }
  .offer-link-cta { display:inline-flex; align-items:center; gap:8px; font-weight:700; font-size:13px; letter-spacing:-0.01em; color: var(--section-dark-text); width: fit-content; border-bottom:1px solid rgba(248,245,239,.4); padding-bottom:2px; }
  .offer-note { margin-top:14px; display:flex; flex-wrap:wrap; gap:12px; justify-content:space-between; font-size:10px; color: rgba(248,245,239,.45); padding: 0 2px 22px; }
  @media (max-width: 960px) { .offer-grid { grid-template-columns: 1fr; } }
  .angle-divider { height: 28px; background: var(--paper); clip-path: polygon(0 100%, 100% 0, 100% 100%, 0 100%); margin-top: 10px; }
  .craft-grid { display:grid; grid-template-columns: .95fr 1.05fr; gap: clamp(24px, 4vw, 48px); align-items: center; }
  .craft-frame { position:relative; }
  .craft-img { border-radius:18px; overflow: clip; border:1px solid var(--line); box-shadow: var(--shadow-lg); background: var(--card-bg); }
  .craft-svg { width:100%; height:auto; display:block; }
  .craft-float { position:absolute; right:12px; bottom:12px; background: var(--card-bg); border:1px solid var(--line); border-radius:99px; padding:8px 12px; font-size:10px; display:flex; gap:8px; box-shadow: var(--shadow-sm); }
  /* CRAFT marginalia: the 4 proof points as annotated notes pinned around
     the visual, not a checklist. Leader lines tie each note to the frame. */
  .margin-note { position: absolute; z-index: 3; width: 218px; background: var(--card-bg); border: 1px solid var(--line); border-radius: var(--r-md); padding: 12px 14px; box-shadow: var(--shadow-md); }
  .margin-note strong { display: block; font-size: 13px; letter-spacing: -0.01em; margin: 6px 0 4px; }
  .margin-note p { margin: 0; font-size: 12px; line-height: 1.55; color: var(--muted); }
  .margin-note-tag { font-size: 10px; letter-spacing: .14em; color: var(--accent-text); }
  .margin-note::after { content: ""; position: absolute; background: var(--line-strong); }
  .margin-note--0 { top: -22px; left: -26px; transform: rotate(-1.6deg); }
  .margin-note--0::after { left: 30px; top: 100%; width: 1px; height: 22px; }
  .margin-note--1 { top: 24%; right: -34px; transform: rotate(1.2deg); }
  .margin-note--1::after { left: 100%; top: 50%; width: 34px; height: 1px; }
  .margin-note--2 { bottom: 26%; left: -30px; transform: rotate(1deg); }
  .margin-note--2::after { right: 100%; top: 50%; width: 30px; height: 1px; }
  .margin-note--3 { bottom: -26px; right: -26px; transform: rotate(-1.2deg); }
  .margin-note--3::after { right: 34px; bottom: 100%; width: 1px; height: 26px; }
  @media (max-width: 1100px) {
    /* No room for marginalia: notes become a static 2-col grid under the visual. */
    .margin-note { position: static; width: auto; transform: none; }
    .margin-note::after { display: none; }
    .craft-frame { display: grid; gap: 12px; }
    .craft-img { order: -1; }
    .margin-note--0, .margin-note--1, .margin-note--2, .margin-note--3 { order: 0; }
    .craft-frame { grid-template-columns: 1fr 1fr; }
    .craft-img, .craft-float { grid-column: 1 / -1; }
  }
  @media (max-width: 880px) { .craft-grid { grid-template-columns: 1fr; } .craft-frame { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .margin-note { transform: none; } }
  .faq-grid { display:grid; grid-template-columns: .9fr 1.1fr; gap: clamp(24px, 4vw, 48px); align-items: start; }
  .faq-list { display:grid; gap: 0; }
  .faq-list details { background: transparent; border: 0; border-radius: 0; box-shadow: none; overflow: clip; }
  .faq-list summary { list-style:none; cursor:pointer; padding:18px 4px; font-weight:650; letter-spacing:-0.02em; font-size:15px; display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .faq-list summary::-webkit-details-marker{ display:none; }
  .faq-list summary::after { content:"+"; width:24px; height:24px; border-radius:99px; border:1px solid var(--line); display:grid; place-items:center; font-weight:500; flex:none; font-size:12px; }
  .faq-list details[open] summary::after { content:"\2212"; background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .faq-list details div { padding: 0 4px 20px; color: var(--muted); font-size:14px; line-height:1.6; }
  /* Hairline crack between FAQ items: the fracture motif as divider. */
  .fracture-divider { height: 8px; margin-block: 2px; background: var(--line-strong); opacity: .75; clip-path: polygon(0 42%, 9% 60%, 20% 34%, 33% 64%, 46% 38%, 59% 62%, 72% 36%, 84% 60%, 100% 42%, 100% 58%, 84% 74%, 72% 50%, 59% 76%, 46% 52%, 33% 78%, 20% 48%, 9% 74%, 0 56%); }
  @media (max-width: 880px) { .faq-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .fracture-divider { clip-path: none; height: 1px; } }
  /* FINAL CTA: full-viewport dark statement. The primary button cracks
     open along a jagged line on hover (transform-only, clipped by the
     button's own overflow). */
  .cta-statement { background: var(--section-dark-bg); color: var(--section-dark-text); min-height: 100svh; display: grid; align-items: center; position: relative; overflow: clip; border-top: 1px solid var(--line-on-dark); }
  .cta-statement::before { content:""; position:absolute; inset:0; background: radial-gradient(700px 460px at 50% 8%, var(--cta-glow-a) 0%, transparent 60%), radial-gradient(500px 500px at 50% 108%, rgba(255,255,255,.05) 0%, transparent 60%); pointer-events:none; }
  .cta-statement-inner { position: relative; text-align: center; display: grid; justify-items: center; gap: clamp(18px, 3vw, 28px); padding-block: clamp(56px, 9vw, 110px); }
  .cta-statement-title { font-size: clamp(2.8rem, 8vw, 6.4rem); line-height: .9; letter-spacing: -0.03em; text-wrap: balance; max-width: 20ch; }
  .cta-statement-title span { font-style: italic; font-weight: 400; color: var(--accent); }
  .cta-statement-desc { color: rgba(248,245,239,.68); font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 1.6; max-width: 46ch; text-wrap: pretty; }
  .cta-statement-actions { justify-content: center; }
  .cta-statement-contact { font-size: 11px; letter-spacing: .06em; color: rgba(248,245,239,.46); }
  .btn--crack { background: var(--btn-primary-bg); color: #fff; }
  .btn--crack:hover { transform: none; filter: none; box-shadow: 0 14px 34px color-mix(in srgb, var(--accent) 45%, transparent); }
  .btn--crack .btn--crack-label { position: relative; z-index: 1; color: var(--on-dark-btn-text); }
  .btn--crack::before, .btn--crack::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--on-dark-btn-bg); transition: transform var(--dur-3) var(--ease-out-expo); }
  .btn--crack::before { clip-path: polygon(0 0, 100% 0, 100% 44%, 86% 47%, 93% 51%, 78% 54%, 88% 58%, 72% 61%, 0 61%); }
  .btn--crack::after { clip-path: polygon(0 61%, 72% 61%, 88% 58%, 78% 54%, 93% 51%, 86% 47%, 100% 44%, 100% 100%, 0 100%); }
  @media (hover: hover) and (pointer: fine) {
    .btn--crack:hover::before { transform: translateY(-7px); }
    .btn--crack:hover::after { transform: translateY(7px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn--crack::before, .btn--crack::after { transition: none; }
    .btn--crack:hover::before, .btn--crack:hover::after { transform: none; }
  }
  .section { content-visibility: auto; contain-intrinsic-size: auto 700px; }
  .hero, .marquee { content-visibility: visible; contain-intrinsic-size: auto; }
  /* Dark theme only: --accent (#0043E0) as TEXT on near-black surfaces
     fails WCAG even for large text (~2.4:1). --accent-text (#4D7FFF)
     passes everywhere (5.6/5.4/4.9 on the hero gradient, 5.6 on the
     final-CTA bg, 5.1 on offer cards). Light theme keeps --accent here
     (it already passes) so light rendering is untouched. */
  html[data-theme="dark"] .hero-title .hero-italic { color: var(--accent-text); }
  html[data-theme="dark"] .cta-statement-title span { color: var(--accent-text); }
  html[data-theme="dark"] .offer-link:hover .offer-link-cta { color: var(--accent-text); border-bottom-color: var(--accent-text); }
</style>

<script>
  // Disposers for the current page instance. Astro's client-side navigation
  // re-runs initHomePage on every page-load while window-level listeners and
  // observers from the previous instance survive — dispose them first.
  let homeCleanups: Array<() => void> = [];
  function onHomeDispose(fn: () => void) { homeCleanups.push(fn); }
  function disposeHome() {
    for (const fn of homeCleanups) { try { fn(); } catch {} }
    homeCleanups = [];
  }
  document.addEventListener('astro:before-swap', disposeHome);

  function initHomePage() {
    disposeHome();
    const hero = document.getElementById('hero');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isCoarse = window.matchMedia('(pointer: coarse), (hover: none)').matches;
    if (hero && !prefersReduced && !isCoarse) {
      const stack = hero.querySelector('[data-parallax="stack"]') as HTMLElement | null;
      const a = hero.querySelector('[data-parallax="a"]') as HTMLElement | null;
      const b = hero.querySelector('[data-parallax="b"]') as HTMLElement | null;
      let raf = 0, tx = 0, ty = 0, cx = 0, cy = 0;
      let px = 0, py = 0, hasPointer = false;
      const onMove = (e: MouseEvent) => {
        // Store the pointer only; the rect read happens once per frame in
        // tick() instead of once per mousemove event (high-polling mice
        // fire far more events than frames). Same math, same result.
        px = e.clientX;
        py = e.clientY;
        hasPointer = true;
        if (!raf) raf = requestAnimationFrame(tick);
      };
      const onLeave = () => {
        hasPointer = false;
        tx = 0; ty = 0;
        if (!raf) raf = requestAnimationFrame(tick);
      };
      hero.addEventListener('mousemove', onMove);
      hero.addEventListener('mouseleave', onLeave);
      onHomeDispose(() => {
        hero.removeEventListener('mousemove', onMove);
        hero.removeEventListener('mouseleave', onLeave);
        if (raf) cancelAnimationFrame(raf);
      });
      function tick() {
        raf = 0;
        if (hasPointer) {
          const r = hero!.getBoundingClientRect();
          tx = ((px - r.left) / r.width - 0.5) * 2;
          ty = ((py - r.top) / r.height - 0.5) * 2;
        }
        cx += (tx - cx) * 0.08;
        cy += (ty - cy) * 0.08;
        if (stack) stack.style.transform = `perspective(1400px) rotateY(-6deg) rotateX(1deg) translate3d(${cx * 6}px, ${cy * 6}px, 0)`;
        if (a) a.style.transform = `rotate(1.2deg) translate3d(${cx * 14}px, ${cy * 10}px, 0)`;
        if (b) b.style.transform = `rotate(-1deg) translate3d(${cx * -12}px, ${cy * -8}px, 0)`;
        if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) {
          raf = requestAnimationFrame(tick);
        }
      }
    }

    initHeroEntrance(hero, prefersReduced);

    initProcessTimeline(prefersReduced);

    // Fracture reveals: generic IntersectionObserver for .fracture-reveal
    // elements (see global.css). Scroll-triggered, so it works on touch;
    // reduced motion gets the instant, fully-open state.
    // NOTE: we observe the closest .section, not the element itself.
    // Sections use content-visibility:auto, which suppresses
    // IntersectionObserver callbacks for skipped descendants in Chromium;
    // observing the section (which keeps its box via contain-intrinsic-size)
    // fires reliably.
    const fractures = document.querySelectorAll('.fracture-reveal');
    if (prefersReduced || !('IntersectionObserver' in window)) {
      fractures.forEach((el) => el.classList.add('is-visible'));
    } else {
      const seen = new WeakSet<Element>();
      const revealIn = (root: Element) => {
        if (root.classList.contains('fracture-reveal') && !seen.has(root)) {
          seen.add(root);
          root.classList.add('is-visible');
        }
        root.querySelectorAll('.fracture-reveal').forEach((el) => {
          if (!seen.has(el)) {
            seen.add(el);
            el.classList.add('is-visible');
          }
        });
      };
      const fio = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            revealIn(e.target as Element);
            fio.unobserve(e.target);
          }
        }
      }, { threshold: 0.12 });
      const triggers = new Set<Element>();
      fractures.forEach((el) => {
        triggers.add(el.closest('.section') ?? el);
      });
      triggers.forEach((t) => fio.observe(t));
      onHomeDispose(() => fio.disconnect());
    }
  }

  /* Process timeline: pinned scrub.
     The .pin-wrap is 280vh tall; .pin-stage sticks for one viewport while
     the user scrolls through it. On each frame we compute how far the
     viewport has travelled through the wrap (0..1) and:
       - set --scrub on the journey, which drives .crack-fill scaleX
       - toggle .is-active on stations whose --pos the crack has reached
       - update the DAY 0..7 readout
     Station thresholds sit slightly before each station's --pos so the
     card starts opening as the spark arrives. Everything is transform /
     opacity only. Reduced motion and narrow viewports get the static
     vertical stack from CSS, so this function bails early there. */
  function initProcessTimeline(prefersReduced: boolean): void {
    const wrap = document.querySelector('[data-process-pin]') as HTMLElement | null;
    const journey = wrap?.querySelector('[data-journey]') as HTMLElement | null;
    if (!wrap || !journey) return;
    const stations = Array.from(journey.querySelectorAll<HTMLElement>('[data-station]'));
    const readout = journey.querySelector('[data-day-readout]') as HTMLElement | null;
    const dayLabel = journey.dataset.dayLabel ?? 'DAY';
    const narrow = window.matchMedia('(max-width: 860px)');
    if (prefersReduced || narrow.matches || !('requestAnimationFrame' in window)) {
      // Static fallbacks: light every station, fill the crack.
      stations.forEach((s) => s.classList.add('is-active'));
      journey.style.setProperty('--scrub', '1');
      if (readout) readout.textContent = `${dayLabel} 7`;
      return;
    }

    // Station positions as fractions, read from the --pos custom property.
    const thresholds = stations.map((s) => {
      const raw = getComputedStyle(s).getPropertyValue('--pos').trim();
      const frac = parseFloat(raw) / 100;
      return Math.max(0, (isNaN(frac) ? 0.5 : frac) - 0.07);
    });

    // Geometry is cached: reading getBoundingClientRect + offsetHeight on
    // every scroll frame forces a synchronous layout flush each frame.
    // The wrap's page position and height only change on resize/reflow,
    // so measure there and keep the per-frame path to pure scrollY math.
    // The progress values produced are identical.
    let wrapTop = 0;
    let wrapTotal = 1;
    const measure = () => {
      wrapTop = wrap.getBoundingClientRect().top + window.scrollY;
      wrapTotal = wrap.offsetHeight - window.innerHeight;
    };
    measure();
    if ('fonts' in document && (document as any).fonts?.ready) {
      (document as any).fonts.ready.then(measure);
    }
    // Sections above the wrap use content-visibility, so their settled
    // height can shift the wrap's position without a window resize; a
    // ResizeObserver keeps the cache exact in that case too.
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(measure);
      ro.observe(wrap);
      if (document.body) ro.observe(document.body);
      onHomeDispose(() => ro.disconnect());
    }

    let ticking = false;
    let lastProgress = -1;
    const update = () => {
      ticking = false;
      const total = wrapTotal;
      const travelled = Math.min(Math.max(window.scrollY - wrapTop, 0), Math.max(total, 1));
      const progress = total > 0 ? travelled / total : 1;
      if (Math.abs(progress - lastProgress) < 0.0005) return;
      lastProgress = progress;
      journey.style.setProperty('--scrub', progress.toFixed(4));
      // Spark swells slightly while moving, settles at rest.
      journey.style.setProperty('--spark', (0.85 + progress * 0.3).toFixed(3));
      stations.forEach((s, i) => {
        s.classList.toggle('is-active', progress >= (thresholds[i] ?? 1));
      });
      if (readout) {
        const day = Math.round(progress * 7);
        const label = `${dayLabel} ${day}`;
        if (readout.textContent !== label) readout.textContent = label;
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    const onResize = () => { measure(); onScroll(); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    onHomeDispose(() => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
    });
    // If the viewport crosses the narrow breakpoint mid-session, fall back
    // to the static stack rather than a half-driven scrub.
    const onNarrow = (e: MediaQueryListEvent) => {
      if (e.matches) {
        window.removeEventListener('scroll', onScroll);
        stations.forEach((s) => s.classList.add('is-active'));
        journey.style.setProperty('--scrub', '1');
        if (readout) readout.textContent = `${dayLabel} 7`;
      }
    };
    narrow.addEventListener('change', onNarrow);
    onHomeDispose(() => narrow.removeEventListener('change', onNarrow));
    update();
  }

  /* Hero entrance: word-split title reveal gated on data-hero-enter.
     The intro signals completion by adding .wi-released to <html>;
     we watch for it so the hero choreography hands off seamlessly.
     No intro (or already released) -> enter on the next frames. */
  function splitWords(root: HTMLElement, lang: string): void {
    const segmenter = new Intl.Segmenter(lang, { granularity: 'word' });
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes: Node[] = [];
    let n: Node | null;
    while ((n = walker.nextNode())) nodes.push(n);
    let i = 0;
    for (const node of nodes) {
      const frag = document.createDocumentFragment();
      const text = node.textContent ?? '';
      for (const seg of segmenter.segment(text)) {
        if (seg.isWordLike) {
          const s = document.createElement('span');
          s.className = 'w';
          s.setAttribute('aria-hidden', 'true');
          s.style.setProperty('--wi', String(i++));
          s.textContent = seg.segment;
          frag.appendChild(s);
        } else {
          frag.appendChild(document.createTextNode(seg.segment));
        }
      }
      const parent = node.parentNode;
      if (parent) parent.replaceChild(frag, node);
    }
  }

  function initHeroEntrance(hero: HTMLElement | null, prefersReduced: boolean): void {
    if (!hero) return;
    const title = hero.querySelector('[data-hero-title]') as HTMLElement | null;
    const enter = () => hero.setAttribute('data-hero-enter', 'true');
    const lang = document.documentElement.lang.startsWith('fr') ? 'fr-CA' : 'en-CA';

    const doSplitAndEnter = () => {
      if (hero.hasAttribute('data-hero-split')) return;
      hero.setAttribute('data-hero-split', 'true');
      if (title) {
        title.setAttribute('aria-label', (title.textContent ?? '').replace(/\s+/g, ' ').trim());
        if (!prefersReduced && 'Segmenter' in Intl) {
          const original = title.innerHTML;
          splitWords(title, lang);
          let rt = 0;
          const onResize = () => {
            window.clearTimeout(rt);
            rt = window.setTimeout(() => {
              if (!hero.isConnected) return;
              title.innerHTML = original;
              splitWords(title, lang);
            }, 250);
          };
          window.addEventListener('resize', onResize);
          onHomeDispose(() => window.removeEventListener('resize', onResize));
        }
      }

      if (prefersReduced) { enter(); return; }

      const html = document.documentElement;
      if (html.classList.contains('wi-run') && !html.classList.contains('wi-released')) {
        const mo = new MutationObserver(() => {
          if (html.classList.contains('wi-released')) { mo.disconnect(); enter(); }
        });
        mo.observe(html, { attributes: true, attributeFilter: ['class'] });
        window.setTimeout(() => { mo.disconnect(); enter(); }, 9000);
      } else {
        requestAnimationFrame(() => requestAnimationFrame(enter));
      }
    };

    // Wait for fonts before splitting words: splitting with fallback fonts
    // then swapping to webfonts shifts word positions mid-animation (stutter).
    if (title && 'fonts' in document && (document as any).fonts.ready) {
      (document as any).fonts.ready.then(() => doSplitAndEnter());
      // Failsafe: don't wait more than 1.5s for fonts
      window.setTimeout(() => {
        if (!hero.hasAttribute('data-hero-enter')) doSplitAndEnter();
      }, 1500);
    } else {
      doSplitAndEnter();
    }
  }

  // Immediate init (house pattern): initHomePage disposes first, so the
  // evaluation call and the page-load call cannot double-bind.
  initHomePage();
  document.addEventListener('astro:page-load', initHomePage);
</script>
