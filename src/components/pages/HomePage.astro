  .hero-watermark span { position: absolute; font-family: var(--font-display); font-size: clamp(10rem, 28vw, 24rem); line-height: 1; letter-spacing: -0.06em; color: var(--ink); white-space: nowrap; transform: rotate(-6deg); }
