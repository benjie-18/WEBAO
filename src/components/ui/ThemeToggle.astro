---
import { useTranslations, type Locale } from "../../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props as Props;
const t = useTranslations(locale);
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-to-dark={t.nav.themeToDark}
  data-label-to-light={t.nav.themeToLight}
  data-label-dark-on={t.nav.themeDarkOn}
  data-label-light-on={t.nav.themeLightOn}
  aria-label={t.nav.themeToDark}
  title={t.nav.themeToDark}
>
  <img src="/light-mode.svg" alt="" aria-hidden="true" class="tt-icon tt-sun" width="20" height="20" />
  <img src="/dark-mode.svg" alt="" aria-hidden="true" class="tt-icon tt-moon" width="20" height="20" />
</button>

<style is:global>
  /* Theme switch: circular reveal from the toggle button via View Transitions.
     The old snapshot stays fully painted underneath while the new theme
     wipes in as an expanding circle. Transform/clip-path only. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: var(--dur-4, 1800ms);
    animation-timing-function: var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  ::view-transition-old(root) {
    animation-name: webao-theme-hold;
  }
  ::view-transition-new(root) {
    animation-name: webao-theme-reveal;
  }
  @keyframes webao-theme-hold {
    from { opacity: 1; }
    to { opacity: 1; }
  }
  @keyframes webao-theme-reveal {
    from {
      clip-path: circle(0px at var(--vt-x, 50%) var(--vt-y, 80px));
    }
    to {
      clip-path: circle(var(--vt-r, 150vmax) at var(--vt-x, 50%) var(--vt-y, 80px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.01ms;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    var KEY = "webao.theme";
    var THEME_COLOR = { light: "#F8F5EF", dark: "#070B14" };

    function currentTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
    }

    function applyMeta(theme) {
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", THEME_COLOR[theme] || THEME_COLOR.light);
    }

    function syncToggles(theme) {
      var toDark = theme !== "dark";
      document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
        var label = toDark ? btn.getAttribute("data-label-to-dark") : btn.getAttribute("data-label-to-light");
        if (label) {
          btn.setAttribute("aria-label", label);
          btn.setAttribute("title", label);
        }
        btn.setAttribute("aria-pressed", String(!toDark));
      });
    }

    function applyTheme(theme) {
      var html = document.documentElement;
      html.setAttribute("data-theme", theme);
      try {
        localStorage.setItem(KEY, theme);
      } catch (e) {}
      applyMeta(theme);
      syncToggles(theme);
      // Notify anything that paints with theme-dependent colors (e.g. canvases)
      try {
        window.dispatchEvent(new CustomEvent("webao:themechange", { detail: { theme: theme } }));
      } catch (e) {}
    }

    function setTheme(theme, sourceBtn) {
      var html = document.documentElement;
      if (currentTheme() === theme) {
        syncToggles(theme);
        return;
      }
      // #73: announce the change to screen readers via the layout's live
      // region (only on a user toggle, never on page load).
      var live = document.querySelector("[data-theme-live]");
      if (live) {
        var onLabel = theme === "dark"
          ? (sourceBtn && sourceBtn.getAttribute("data-label-dark-on")) || "Dark theme on"
          : (sourceBtn && sourceBtn.getAttribute("data-label-light-on")) || "Light theme on";
        live.textContent = "";
        window.setTimeout(function () { live.textContent = onLabel; }, 50);
      }
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var canVT =
        !reduced &&
        typeof document.startViewTransition === "function";

      if (canVT) {
        // Circular reveal from the toggle button position.
        var x = window.innerWidth / 2;
        var y = 80;
        try {
          var btn =
            sourceBtn && sourceBtn.getBoundingClientRect
              ? sourceBtn
              : document.querySelector("[data-theme-toggle]");
          if (btn) {
            var rect = btn.getBoundingClientRect();
            x = rect.left + rect.width / 2;
            y = rect.top + rect.height / 2;
          }
        } catch (e) {}
        var r = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        );
        html.style.setProperty("--vt-x", Math.round(x) + "px");
        html.style.setProperty("--vt-y", Math.round(y) + "px");
        html.style.setProperty("--vt-r", Math.ceil(r) + "px");
        var transition = document.startViewTransition(function () {
          applyTheme(theme);
        });
        var cleaned = false;
        var cleanup = function () {
          if (cleaned) return;
          cleaned = true;
          html.style.removeProperty("--vt-x");
          html.style.removeProperty("--vt-y");
          html.style.removeProperty("--vt-r");
        };
        if (transition && transition.finished) {
          transition.finished.then(cleanup, cleanup);
        }
        // Safety net: the finished promise can resolve later than the
        // nominal animation duration; never leak the custom properties.
        window.setTimeout(cleanup, 3600);
        return;
      }

      // Fallback: smooth color crossfade, or instant under reduced motion.
      if (!reduced) html.classList.add("theming");
      applyTheme(theme);
      if (!reduced) {
        window.setTimeout(function () {
          html.classList.remove("theming");
        }, 650);
      }
    }

    function init() {
      applyStoredTheme();
      document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
        if (btn.dataset.webaoThemeBound) return;
        btn.dataset.webaoThemeBound = "1";
        btn.addEventListener("click", function () {
          setTheme(currentTheme() === "dark" ? "light" : "dark", btn);
        });
      });
    }

    /**
     * Re-apply the stored theme from localStorage. Exported so the layout can
     * also call it after a View Transition swap.
     */
    function applyStoredTheme() {
      var stored = null;
      try { stored = localStorage.getItem(KEY); } catch (e) {}
      // No stored choice: fall back to the OS preference, exactly like the
      // head init script does on a full page load. The old fallback read
      // data-theme off the freshly swapped document, which never carries it,
      // so every OS-dark visitor who never pressed the toggle was flipped
      // to light on the first client-side navigation (e.g. home -> pricing).
      var theme = stored === "dark" || stored === "light"
        ? stored
        : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      var html = document.documentElement;
      if (html.getAttribute("data-theme") !== theme) {
        html.setAttribute("data-theme", theme);
        applyMeta(theme);
      } else {
        applyMeta(theme);
      }
      syncToggles(theme);
    }

    window.__webaoSetTheme = setTheme;
    window.__webaoApplyStoredTheme = applyStoredTheme;
    document.addEventListener("astro:page-load", init);
    // View Transitions swap in a freshly SSR'd <html> whose runtime
    // data-theme attribute was lost, which reset the site to light on every
    // client-side navigation. Re-apply the stored choice right after the swap,
    // before the new page paints.
    if (!window.__webaoThemeSwapBound) {
      window.__webaoThemeSwapBound = true;
      document.addEventListener("astro:after-swap", applyStoredTheme);
    }
    if (document.readyState !== "loading") init();
    else document.addEventListener("DOMContentLoaded", init, { once: true });
  })();
</script>
