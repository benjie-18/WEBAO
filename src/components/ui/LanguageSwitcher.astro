---
import { getAlternatePath, type Locale } from "../../lib/i18n/config";

interface Props {
  locale: Locale;
  currentPath: string;
  variant?: "header" | "mobile" | "toggle";
}

const { locale, currentPath, variant = "header" } = Astro.props as Props;

const enPath = getAlternatePath(currentPath, "en");
const frPath = getAlternatePath(currentPath, "fr");

const isEn = locale === "en";
const isFr = locale === "fr";
---

<div class:list={["lang-switcher", variant === "mobile" && "lang-switcher--mobile", variant === "toggle" && "lang-toggle"]} role="group" aria-label="Language switcher">
  {variant === "toggle" && (
    <a
      href={isEn ? frPath : enPath}
      class="lang-toggle-link"
      aria-label={isEn ? "Passer en français" : "Switch to English"}
      title={isEn ? "Passer en français" : "Switch to English"}
      data-lang={isEn ? "fr" : "en"}
      hreflang={isEn ? "fr" : "en"}
    >
      <span class="lang-flag" aria-hidden="true">
        <img src={isEn ? "/qc-flag.png" : "/us-flag.png"} alt="" width="20" height="20" loading="eager" decoding="async" class:list={["flag-img", isEn ? "flag-qc" : "flag-us"]} />
      </span>
    </a>
  )}
  {variant !== "toggle" && (
  <a
    href={enPath}
    class:list={["lang-option", isEn && "is-active"]}
    aria-current={isEn ? "true" : undefined}
    aria-label="Switch to English"
    data-lang="en"
    hreflang="en"
  >
    <span class="lang-flag" aria-hidden="true">
      <img src="/us-flag.png" alt="" width="20" height="20" loading="eager" decoding="async" class="flag-img flag-us" />
    </span>
    <span class="lang-label">EN</span>
  </a>
  <a
    href={frPath}
    class:list={["lang-option", isFr && "is-active"]}
    aria-current={isFr ? "true" : undefined}
    aria-label="Passer en français"
    data-lang="fr"
    hreflang="fr"
  >
    <span class="lang-flag" aria-hidden="true">
      <img src="/qc-flag.png" alt="" width="20" height="20" loading="eager" decoding="async" class="flag-img flag-qc" />
    </span>
    <span class="lang-label">FR</span>
  </a>
  )}
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .lang-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 6px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: background .2s var(--ease-out), color .2s, box-shadow .2s, transform .2s;
    text-decoration: none;
    line-height: 1;
  }
  .lang-option:hover {
    background: var(--paper-3);
    color: var(--ink);
  }
  .lang-option.is-active {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 2px 8px rgba(10,15,28,.12);
  }
  .lang-flag {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: white;
    border: 1px solid rgba(10,15,28,.08);
    flex: none;
  }
  .lang-option.is-active .lang-flag {
    border-color: rgba(248,245,239,.2);
  }
  .flag-img {
    width: 20px;
    height: 20px;
    display: block;
    object-fit: cover;
    border-radius: 999px;
  }
  /* Normalize visual size: US flag has more transparent padding (0.855 vs 0.949) */
  .flag-us {
    transform: scale(1.11);
    transform-origin: center;
  }
  .flag-qc {
    transform: scale(1.02);
  }

  /* Mobile variant */
  .lang-switcher--mobile {
    width: 100%;
    justify-content: center;
    padding: 6px;
    background: var(--paper-3);
    margin-top: 12px;
  }
  .lang-switcher--mobile .lang-option {
    flex: 1;
    justify-content: center;
    padding: 10px;
    font-size: 12px;
  }
  .lang-switcher--mobile .lang-flag {
    width: 22px;
    height: 22px;
  }
  .lang-switcher--mobile .flag-img {
    width: 22px;
    height: 22px;
  }

  /* Single-flag toggle: mobile header only. Same 40px footprint as the
     theme toggle beside it, same theme tokens, so the pair reads as one
     set of controls. Hidden on desktop, where the full pill is the
     switcher. The flag itself is the existing PNG (flags have no
     theme-aware variant); the button chrome and the white flag badge
     are what adapt to the theme. */
  .lang-switcher.lang-toggle {
    display: none;
    width: 40px;
    height: 40px;
    flex: none;
    padding: 0;
    border-radius: 12px;
    background: var(--paper-2);
    box-shadow: none;
    justify-content: center;
    cursor: pointer;
    transition: background .25s var(--ease-out), border-color .25s var(--ease-out), transform .15s var(--ease-out), box-shadow .25s var(--ease-out);
  }
  @media (max-width: 860px) {
    .lang-switcher.lang-toggle {
      display: inline-flex;
    }
  }
  .lang-switcher.lang-toggle:hover {
    background: var(--paper-3);
    border-color: var(--line-strong);
  }
  .lang-switcher.lang-toggle:active {
    transform: scale(.9);
  }
  .lang-switcher.lang-toggle:focus-visible {
    outline: 2px solid var(--focus-outline);
    outline-offset: 2px;
  }
  [data-theme="dark"] .lang-switcher.lang-toggle:hover {
    border-color: rgba(0,67,224,.55);
    box-shadow: 0 0 0 3px rgba(0,67,224,.18);
  }
  .lang-toggle-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    text-decoration: none;
  }

  /* In dark header, adapt */
  :global(.site-header--dark) .lang-switcher {
    background: rgba(255,255,255,.06);
    border-color: rgba(248,245,239,.12);
  }
  :global(.site-header--dark) .lang-option {
    color: rgba(248,245,239,.6);
  }
  :global(.site-header--dark) .lang-option:hover {
    background: rgba(255,255,255,.08);
    color: var(--paper);
  }
  :global(.site-header--dark) .lang-option.is-active {
    background: var(--paper);
    color: var(--ink);
  }
</style>

<script>
  // Persist language choice (all instances: header + mobile drawer + mobile flag toggle)
  function initLangSwitcher() {
    document.querySelectorAll('.lang-switcher').forEach((switcher) => {
      const el = switcher as HTMLElement;
      if (el.dataset.langBound === '1') return;
      el.dataset.langBound = '1';
      el.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('webao.locale', a.dataset.lang || 'en');
          } catch {}
        });
      });
    });

    // First-visit browser-language default: if the visitor never chose a
    // language, their browser prefers French, and they landed on the EN home
    // page, send them to /fr/ (once per session; manual choice always wins).
    try {
      if (localStorage.getItem('webao.locale')) return;
      if (sessionStorage.getItem('webao.autoRedirect')) return;
      const path = window.location.pathname;
      if (path !== '/' && path !== '') return;
      const langs = window.navigator.languages || [window.navigator.language || ''];
      const prefersFr = langs.some((l) => l.toLowerCase().startsWith('fr'));
      if (!prefersFr) return;
      sessionStorage.setItem('webao.autoRedirect', '1');
      window.location.replace('/fr/');
    } catch {}
  }
  document.addEventListener('astro:page-load', initLangSwitcher);
  if (document.readyState !== 'loading') initLangSwitcher();
</script>
