---
// The WEBAO star, the same hand-drawn mark as the homepage and pricing
// heroes (copied verbatim from PricingPage2.astro). Color comes from
// currentColor; size from the class passed in. Used as the audit loading
// icon and as a decorative mark on the audit pages.
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props as Props;
