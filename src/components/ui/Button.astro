---
interface Props {
  href?: string;
  variant?: "primary" | "dark" | "light" | "ghost";
  size?: "sm" | "md";
  external?: boolean;
}

const { href, variant = "primary", size = "md", external = false } = Astro.props as Props;
const classes = ["btn", `btn--${variant}`, size === "sm" ? "btn--sm" : ""].filter(Boolean).join(" ");
const isLink = !!href;
---

{
  isLink ? (
    <a href={href} class={classes} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
      <slot />
    </a>
  ) : (
    <button class={classes} type="button">
      <slot />
    </button>
  )
}
