---
interface Props {
  tone?: "neutral" | "accent" | "dark";
}
const { tone = "neutral" } = Astro.props as Props;
const toneClass = `badge--${tone}`;
---

<span class:list={["badge mono", toneClass]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: .12em;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-2);
  }
  .badge--accent { background: var(--accent); color: white; border-color: var(--accent); }
  .badge--dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
</style>
