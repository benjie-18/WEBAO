---
// CursorJourney — guided animated cursor through agency cards
// Respects prefers-reduced-motion, hover capability, and pointer type.
// Performance: transform3d + will-change, rAF, no layout thrash.
---

<div class="cursor-journey" data-journey aria-hidden="true">
  <svg class="journey-trail" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path class="journey-path" d="" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 8" opacity="0" />
    <path class="journey-path-progress" d="" fill="none" stroke="var(--paper)" stroke-width="1.5" stroke-linecap="round" opacity="0" />
  </svg>
  <div class="journey-cursor" data-cursor>
    <span class="journey-cursor-ring" aria-hidden="true"></span>
    <span class="journey-cursor-dot" aria-hidden="true"></span>
    <span class="journey-cursor-label mono" data-cursor-label>Explore</span>
    <span class="journey-cursor-sub mono" data-cursor-sub>→ hover to peek</span>
  </div>
  <div class="journey-hint mono" data-journey-hint>✦ Guided tour — watching cursor explore the studio doors</div>
</div>

<style>
  .cursor-journey {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 12;
    overflow: visible;
    contain: layout style;
    opacity: 0;
    transition: opacity .45s var(--ease-out);
  }
  .cursor-journey.is-active { opacity: 1; }
  .cursor-journey.is-hidden { opacity: 0; pointer-events: none; }

  .journey-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .journey-path, .journey-path-progress {
    vector-effect: non-scaling-stroke;
    transition: opacity .4s var(--ease-out);
  }
  .journey-path-progress {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    transition: stroke-dashoffset 1.1s cubic-bezier(.16,1,.3,1), opacity .3s;
    filter: drop-shadow(0 0 8px rgba(255,255,255,.25));
  }

  .journey-cursor {
    position: absolute;
    left: 0; top: 0;
    width: 0; height: 0;
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 1.05s cubic-bezier(.16,1,.3,1), opacity .35s var(--ease-out);
    opacity: 0;
  }
  .journey-cursor.is-visible { opacity: 1; }
  .journey-cursor.is-clicking .journey-cursor-dot { transform: scale(0.72); }
  .journey-cursor.is-clicking .journey-cursor-ring { transform: translate(-50%, -50%) scale(1.35); opacity: 0; }

  .journey-cursor-dot {
    position: absolute;
    left: 50%; top: 50%;
    width: 10px; height: 10px;
    background: #0A0F1C;
    border: 2px solid #F8F5EF;
    border-radius: 999px;
    transform: translate(-50%, -50%);
    box-shadow: 0 2px 10px rgba(10,15,28,.22), 0 0 0 1px rgba(255,255,255,.9);
    transition: transform .18s var(--ease-out);
    z-index: 2;
  }
  .journey-cursor-ring {
    position: absolute;
    left: 50%; top: 50%;
    width: 36px; height: 36px;
    border: 1px solid rgba(248,245,239,.85);
    border-radius: 999px;
    transform: translate(-50%, -50%) scale(1);
    transition: transform .45s var(--ease-out), opacity .3s;
    box-shadow: 0 0 0 8px rgba(248,245,239,.06);
    z-index: 1;
  }
  .journey-cursor-label {
    position: absolute;
    left: 22px; top: -10px;
    background: #F8F5EF;
    color: #0A0F1C;
    border: 1px solid rgba(10,15,28,.08);
    font-size: 10px;
    letter-spacing: .08em;
    padding: 7px 10px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(10,15,28,.14), 0 2px 6px rgba(10,15,28,.08);
    transform: translateY(0) scale(1);
    transition: transform .35s var(--ease-out), opacity .25s, background .2s, color .2s;
    z-index: 3;
  }
  .journey-cursor-sub {
    position: absolute;
    left: 22px; top: 18px;
    font-size: 9px;
    letter-spacing: .1em;
    color: rgba(248,245,239,.72);
    background: rgba(10,15,28,.78);
    padding: 4px 7px;
    border-radius: 999px;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(248,245,239,.12);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .35s .1s, transform .35s .1s;
  }
  .journey-cursor.is-label-active .journey-cursor-sub { opacity: 1; transform: translateY(0); }

  .journey-hint {
    position: absolute;
    left: 50%;
    top: -18px;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: .12em;
    color: rgba(248,245,239,.58);
    background: rgba(10,15,28,.56);
    border: 1px solid rgba(248,245,239,.1);
    padding: 6px 10px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    white-space: nowrap;
    opacity: 0;
    transition: opacity .5s var(--ease-out);
  }
  .cursor-journey.is-active .journey-hint { opacity: 1; }

  /* Card hover state when cursor is over it */
  :global(.agency-card.is-cursor-active) {
    transform: translateY(-8px) rotate(.35deg) scale(1.012) !important;
    box-shadow: 0 24px 60px rgba(10,15,28,.22), 0 8px 24px rgba(10,15,28,.14) !important;
    z-index: 5;
  }
  :global(.agency-card.is-cursor-active .agency-cta) {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(10,15,28,.12);
  }
  :global(.agency-card--pricing.is-cursor-active) { outline: 2px solid rgba(255,255,255,.9); outline-offset: 2px; }
  :global(.agency-card--contact.is-cursor-active) { outline: 2px solid var(--ink); outline-offset: 2px; }
  :global(.agency-card--demos.is-cursor-active)  { outline: 2px solid rgba(248,245,239,.9); outline-offset: 2px; }

  /* Hide on touch / coarse pointer / reduced motion / small */
  @media (hover: none), (pointer: coarse), (max-width: 960px) {
    .cursor-journey { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor-journey { display: none !important; }
  }
</style>

<script>
  // @ts-nocheck
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches;
  const isSmall = window.innerWidth <= 960;
  if (prefersReduced || isTouch || isSmall) {
    // do nothing — journey disabled
  } else {
    const journey = document.querySelector('[data-journey]') as HTMLElement | null;
    const cursor = document.querySelector('[data-cursor]') as HTMLElement | null;
    const label = document.querySelector('[data-cursor-label]') as HTMLElement | null;
    const sub = document.querySelector('[data-cursor-sub]') as HTMLElement | null;
    const hint = document.querySelector('[data-journey-hint]') as HTMLElement | null;
    const path = document.querySelector('.journey-path') as SVGPathElement | null;
    const pathProgress = document.querySelector('.journey-path-progress') as SVGPathElement | null;
    const grid = document.querySelector('.agency-grid') as HTMLElement | null;
    const cards = Array.from(document.querySelectorAll('.agency-card')) as HTMLElement[];

    if (journey && cursor && label && grid && cards.length >= 3 && path && pathProgress) {
      let hasRun = false;
      let isManual = false;
      let rafId = 0;
      let mx = 0, my = 0, cx = 0, cy = 0;

      const labels = [
        { t: 'Pricing', s: '→ $149/mo · all-in', bg: '#F8F5EF', color: '#0A0F1C' },
        { t: 'Contact', s: '→ hello@webao.ca', bg: '#0A0F1C', color: '#F8F5EF' },
        { t: 'Demos',   s: '→ 12 art directions', bg: '#F8F5EF', color: '#0A0F1C' },
      ];

      function getPos(el: HTMLElement) {
        const gr = grid!.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        // center of card relative to grid
        return {
          x: r.left - gr.left + r.width / 2,
          y: r.top - gr.top + r.height / 2,
        };
      }

      function updatePath() {
        if (cards.length < 3) return;
        const pts = cards.slice(0,3).map(getPos);
        // Build smooth cubic path through points: M x0 y0 C ... -> use quadratic for simplicity
        const d = `M ${pts[0].x} ${pts[0].y} C ${pts[0].x + 80} ${pts[0].y - 20}, ${pts[1].x - 80} ${pts[1].y - 20}, ${pts[1].x} ${pts[1].y} C ${pts[1].x + 80} ${pts[1].y + 12}, ${pts[2].x - 80} ${pts[2].y + 12}, ${pts[2].x} ${pts[2].y}`;
        path.setAttribute('d', d);
        pathProgress.setAttribute('d', d);
        const len = (path as any).getTotalLength ? (path as any).getTotalLength() : 800;
        pathProgress.style.strokeDasharray = String(len);
        pathProgress.style.strokeDashoffset = String(len);
        // trigger layout
        void path.getBoundingClientRect();
        path.style.opacity = '1';
        pathProgress.style.opacity = '1';
      }

      function setCursor(x: number, y: number, immediate = false) {
        if (immediate) {
          cursor!.style.transition = 'none';
          void cursor!.offsetWidth;
          cursor!.style.transition = '';
        }
        cursor!.style.transform = `translate3d(${x}px, ${y}px, 0) translate3d(-50%, -50%, 0)`;
      }

      function setActiveCard(idx: number | null) {
        cards.forEach((c, i) => c.classList.toggle('is-cursor-active', i === idx));
      }

      async function runJourney() {
        if (hasRun && !isManual) return;
        hasRun = true;
        journey!.classList.add('is-active');
        cursor!.classList.add('is-visible');
        updatePath();
        // initial hide dash
        requestAnimationFrame(() => {
          pathProgress!.style.strokeDashoffset = '0';
        });

        for (let i = 0; i < 3; i++) {
          if (isManual) break;
          const p = getPos(cards[i]);
          // update label
          label!.textContent = labels[i].t;
          sub!.textContent = labels[i].s;
          label!.style.background = labels[i].bg;
          label!.style.color = labels[i].color;
          cursor!.classList.add('is-label-active');
          // move
          setCursor(p.x, p.y);
          setActiveCard(i);
          // click pulse at middle of dwell
          await new Promise(r => setTimeout(r, 420));
          cursor!.classList.add('is-clicking');
          await new Promise(r => setTimeout(r, 180));
          cursor!.classList.remove('is-clicking');
          await new Promise(r => setTimeout(r, 820));
        }
        if (!isManual) {
          cursor!.classList.remove('is-label-active');
          setActiveCard(null);
          // fade trail then cursor
          pathProgress!.style.opacity = '0';
          path!.style.opacity = '0';
          await new Promise(r => setTimeout(r, 700));
          journey!.classList.remove('is-active');
          cursor!.classList.remove('is-visible');
          // allow re-trigger after scroll away and back
          setTimeout(() => { hasRun = false; }, 8000);
        }
      }

      // Manual mouse follow with lerp (magnetic) — pauses autoplay
      let manualTimer: number | null = null;
      function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
      function loop() {
        cx = lerp(cx, mx, 0.14);
        cy = lerp(cy, my, 0.14);
        if (isManual && journey!.classList.contains('is-active')) {
          cursor!.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate3d(-50%, -50%, 0)`;
          // highlight nearest card
          let best = -1, bestDist = Infinity;
          cards.forEach((c,i) => {
            const p = getPos(c);
            const d = Math.hypot(p.x - cx, p.y - cy);
            if (d < bestDist && d < 170) { bestDist = d; best = i; }
          });
          setActiveCard(best >=0 ? best : null);
          if (best >=0) {
            label!.textContent = labels[best].t;
            sub!.textContent = labels[best].s;
          }
        }
        rafId = requestAnimationFrame(loop);
      }
      loop();

      grid.addEventListener('mousemove', (e: MouseEvent) => {
        const gr = grid.getBoundingClientRect();
        mx = e.clientX - gr.left;
        my = e.clientY - gr.top;
        if (!isManual) {
          isManual = true;
          journey!.classList.add('is-active');
          cursor!.classList.add('is-visible', 'is-label-active');
          path!.style.opacity = '0';
          pathProgress!.style.opacity = '0';
          if (hint) hint.style.opacity = '0';
        }
        if (manualTimer) clearTimeout(manualTimer);
        manualTimer = window.setTimeout(() => {
          // if mouse leaves, resume? keep manual until scroll
        }, 2000);
      });
      grid.addEventListener('mouseleave', () => {
        if (isManual) {
          // fade manual, allow autoplay later
          setTimeout(() => {
            isManual = false;
            cursor!.classList.remove('is-visible', 'is-label-active');
            setActiveCard(null);
            journey!.classList.remove('is-active');
          }, 600);
        }
      });
      grid.addEventListener('click', () => {
        // click ripple
        cursor!.classList.add('is-clicking');
        setTimeout(() => cursor!.classList.remove('is-clicking'), 280);
      });

      // IntersectionObserver to trigger autoplay once
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) {
          if (en.isIntersecting && !hasRun && !isManual) {
            // small delay so user sees page settle
            setTimeout(runJourney, 420);
          }
        }
      }, { threshold: 0.28, rootMargin: '0px 0px -10% 0px' });
      io.observe(grid);

      // recompute path on resize
      let resizeT: number | null = null;
      window.addEventListener('resize', () => {
        if (resizeT) clearTimeout(resizeT);
        resizeT = window.setTimeout(() => {
          if (journey!.classList.contains('is-active')) updatePath();
        }, 120);
      }, { passive: true });

      // initial position at first card (hidden)
      const first = getPos(cards[0]);
      setCursor(first.x, first.y, true);
      cx = first.x; cy = first.y; mx = first.x; my = first.y;
    }
  }
</script>
