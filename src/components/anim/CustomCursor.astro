---
// CustomCursor: a morphing cursor that carries the intro's flying-pointer
// identity across the site.
// - Default state is a tiny fracture shard (rotated square), echoing the
//   intro's barrier-break motif.
// - Morphs per hovered element: links expand the ring, buttons get a bold
//   ring + dot, media gets viewfinder corners. Text keeps the default shard
//   (no typing indicator).
// - The trailing ring uses spring physics (velocity integration) so it
//   overshoots and settles, driven with --ease-spring on morphs.
// - Fine pointers only: (hover: hover) and (pointer: fine)
// - Disabled entirely under prefers-reduced-motion
// - The native cursor is hidden only after the custom one is confirmed live
//   (first mousemove -> html.cc-ready), so a JS failure never leaves the
//   user without a cursor. Native I-beam is kept over form fields.
// - Hidden while the intro plays, so it never fights the existing animations.
// - Theme-aware through --ink / --accent tokens.
// - All shape morphs are opacity + transform only (shapes cross-fade).
---

<div class="cc" aria-hidden="true">
  <div class="cc-layer" data-cc-ring><span class="cc-ring-i"></span></div>
  <div class="cc-layer" data-cc-cur>
    <span class="cc-shape cc-shard"></span>
    <span class="cc-shape cc-dotm"></span>
    <span class="cc-shape cc-corners"><i></i><i></i><i></i><i></i></span>
  </div>
</div>

<style>
  .cc { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cc { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc { display: none !important; }
  }
  .cc-layer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 8000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    will-change: transform;
  }
  /* ---- Trailing ring (spring-driven in JS) ---- */
  .cc-ring-i {
    display: block;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent);
    transition:
      transform 0.38s var(--ease-spring),
      opacity 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease;
  }
  /* ---- Morph shapes (cross-fade via opacity + transform only) ---- */
  .cc-shape {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.22s ease,
      transform 0.38s var(--ease-spring);
  }
  /* Default: fracture shard, a rotated square echoing the intro */
  .cc-shard {
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 55%, transparent);
    opacity: 1;
    transform: scale(1) rotate(45deg);
  }
  /* Link / button: small ink dot at the pointer tip */
  .cc-dotm {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--ink);
  }
  /* Media: viewfinder corners */
  .cc-corners { width: 0; height: 0; }
  .cc-corners i {
    position: absolute;
    width: 11px;
    height: 11px;
    border: 0 solid var(--ink);
  }
  .cc-corners i:nth-child(1) { left: -19px; top: -19px; border-left-width: 2px; border-top-width: 2px; border-top-left-radius: 3px; }
  .cc-corners i:nth-child(2) { left: 8px; top: -19px; border-right-width: 2px; border-top-width: 2px; border-top-right-radius: 3px; }
  .cc-corners i:nth-child(3) { left: -19px; top: 8px; border-left-width: 2px; border-bottom-width: 2px; border-bottom-left-radius: 3px; }
  .cc-corners i:nth-child(4) { left: 8px; top: 8px; border-right-width: 2px; border-bottom-width: 2px; border-bottom-right-radius: 3px; }

  html.cc-ready .cc-layer { opacity: 1; }

  /* ---- Morph state: link ---- */
  html.cc-m-link .cc-shard { opacity: 0; transform: scale(0.5) rotate(45deg); }
  html.cc-m-link .cc-dotm { opacity: 1; transform: scale(1); }
  html.cc-m-link .cc-ring-i {
    transform: scale(1.55);
    border-color: color-mix(in srgb, var(--accent) 65%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  /* ---- Morph state: button / control ---- */
  html.cc-m-btn .cc-shard { opacity: 0; transform: scale(0.5) rotate(45deg); }
  html.cc-m-btn .cc-dotm { opacity: 1; transform: scale(1); }
  html.cc-m-btn .cc-ring-i {
    transform: scale(1.28);
    border-color: color-mix(in srgb, var(--accent) 85%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  /* ---- Morph state: media ---- */
  html.cc-m-media .cc-shard { opacity: 0; transform: scale(0.5) rotate(45deg); }
  html.cc-m-media .cc-corners { opacity: 1; transform: scale(1); }
  html.cc-m-media .cc-ring-i { opacity: 0; transform: scale(0.7); }

  /* Pressed: quick punch on every shape */
  html.cc-down .cc-ring-i { transform: scale(0.92); }
  html.cc-down.cc-m-link .cc-ring-i { transform: scale(1.35); }
  html.cc-down.cc-m-btn .cc-ring-i { transform: scale(1.12); }

  /* Suppressed while the intro plays or the journey cursor is visible */
  html.cc-off .cc-layer,
  html.cc-away .cc-layer { opacity: 0 !important; }
  /* Native cursor hides only once the custom one is live. Keep the native
     I-beam over text fields for usability (the custom cursor still tracks). */
  html.cc-ready,
  html.cc-ready *:not(input):not(textarea):not(select):not([contenteditable="true"]) {
    cursor: none;
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    if (window.__webaoCustomCursor) return;
    window.__webaoCustomCursor = true;

    var fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!fine || reduced) return;

    var html = document.documentElement;
    // Morph priority: controls/links first (an <img> icon inside a button
    // is a button, not media), then standalone media, then the
    // default shard. Text keeps the default shard (no typing indicator).
    var BTN_SEL =
      "button, [role='button'], summary, label, .chip, input, select, textarea, [data-cc-hot]";
    var LINK_SEL = "a";
    var MEDIA_SEL = "img, video, canvas, [data-cc-media]";
    var MORPH_CLASSES = ["cc-m-link", "cc-m-btn", "cc-m-media"];

    var cur, ring;
    var mx = -100, my = -100;
    // Cursor layer: tight lerp. Ring layer: velocity spring (overshoots).
    var cx = -100, cy = -100;
    var rx = -100, ry = -100, rvx = 0, rvy = 0;
    var STIFFNESS = 0.14;
    var DAMPING = 0.72;
    var raf = 0;
    var live = false;
    var morph = "";

    function bind() {
      if (cur && cur.isConnected && ring && ring.isConnected) return true;
      cur = document.querySelector("[data-cc-cur]");
      ring = document.querySelector("[data-cc-ring]");
      return !!(cur && ring);
    }

    function place() {
      if (!cur || !ring) return;
      cur.style.transform = "translate3d(" + cx + "px," + cy + "px,0)";
      ring.style.transform = "translate3d(" + rx + "px," + ry + "px,0)";
    }

    function tick() {
      raf = 0;
      cx += (mx - cx) * 0.45;
      cy += (my - cy) * 0.45;
      rvx = (rvx + (mx - rx) * STIFFNESS) * DAMPING;
      rvy = (rvy + (my - ry) * STIFFNESS) * DAMPING;
      rx += rvx;
      ry += rvy;
      place();
      var active =
        Math.abs(mx - cx) > 0.05 || Math.abs(my - cy) > 0.05 ||
        Math.abs(mx - rx) > 0.05 || Math.abs(my - ry) > 0.05 ||
        Math.abs(rvx) > 0.05 || Math.abs(rvy) > 0.05;
      if (active) raf = requestAnimationFrame(tick);
    }
    function kick() {
      if (!raf) raf = requestAnimationFrame(tick);
    }

    function setMorph(next) {
      if (next === morph) return;
      morph = next;
      for (var i = 0; i < MORPH_CLASSES.length; i++) {
        html.classList.remove(MORPH_CLASSES[i]);
      }
      if (next) html.classList.add(next);
    }

    function detectMorph(t) {
      if (!t || !t.closest) return "";
      if (t.closest(BTN_SEL)) return "cc-m-btn";
      if (t.closest(LINK_SEL)) return "cc-m-link";
      if (t.closest(MEDIA_SEL)) return "cc-m-media";
      return "";
    }

    function updateOff() {
      var journeyVisible = !!document.querySelector(".journey-cursor.is-visible");
      html.classList.toggle("cc-off", journeyVisible);
    }

    function onMove(e) {
      if (!bind()) return;
      mx = e.clientX;
      my = e.clientY;
      html.classList.remove("cc-away");
      if (!live) {
        live = true;
        cx = mx; cy = my; rx = mx; ry = my;
        rvx = 0; rvy = 0;
        place();
        html.classList.add("cc-ready");
      }
      setMorph(detectMorph(e.target));
      updateOff();
      kick();
    }

    document.addEventListener("mousemove", onMove, { passive: true });
    document.addEventListener(
      "mousedown",
      function () { html.classList.add("cc-down"); },
      { passive: true }
    );
    document.addEventListener(
      "mouseup",
      function () { html.classList.remove("cc-down"); },
      { passive: true }
    );
    document.addEventListener("mouseleave", function () {
      html.classList.add("cc-away");
    });
    document.addEventListener("mouseenter", function () {
      html.classList.remove("cc-away");
    });

    // Re-evaluate suppression when the intro or journey toggles classes.
    // Only <html> and the journey container itself are observed. This used
    // to watch class changes across the entire body subtree, which fired
    // on the main thread for every reveal / station / cart class toggle
    // anywhere on the page, to maintain a state that mousemove already
    // re-checks (onMove calls updateOff on every move). Same behaviour,
    // a fraction of the callbacks.
    var mo = new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var m = mutations[i];
        if (m.type !== "attributes") continue;
        var el = m.target;
        if (el === html || (el.classList && el.classList.contains("journey-cursor"))) {
          updateOff();
          return;
        }
      }
    });
    mo.observe(html, { attributes: true, attributeFilter: ["class"] });
    var journeyRoot = document.querySelector(".cursor-journey");
    if (journeyRoot) {
      mo.observe(journeyRoot, {
        attributes: true,
        subtree: true,
        attributeFilter: ["class"],
      });
    }

    // ClientRouter navigations: re-bind to the fresh DOM, keep it idempotent.
    document.addEventListener("astro:page-load", function () {
      live = false;
      morph = "";
      cx = cy = rx = ry = -100;
      rvx = rvy = 0;
      cur = null;
      ring = null;
      for (var i = 0; i < MORPH_CLASSES.length; i++) {
        html.classList.remove(MORPH_CLASSES[i]);
      }
      html.classList.remove("cc-ready", "cc-down", "cc-away");
      bind();
      // The journey element is fresh DOM after a navigation; re-observe it.
      var j = document.querySelector(".cursor-journey");
      if (j) {
        mo.observe(j, {
          attributes: true,
          subtree: true,
          attributeFilter: ["class"],
        });
      }
      updateOff();
    });

    bind();
    updateOff();
  })();
</script>
