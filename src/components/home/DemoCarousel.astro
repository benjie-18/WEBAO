---
import { getDemos, localizedPaths, useTranslations, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const paths = localizedPaths[locale];

// Same catalog order as /demos, minus hidden duplicates
const hidden = new Set(["boba-club"]);
const demos = getDemos(locale)
  .filter((d) => !hidden.has(d.id))
  .sort((a, b) => (a.id === "studio-reve" ? -1 : b.id === "studio-reve" ? 1 : 0));

const heading = t.home.proof.heading;
const sub = t.home.proof.sub;
const eyebrow = t.home.proof.eyebrow;
const browse = t.home.proof.browse;
const prevLabel = t.home.proof.prev;
const nextLabel = t.home.proof.next;
const imgAlt = (name: string) => t.home.proof.imgAlt.replace("{name}", name);
const total = String(demos.length).padStart(2, "0");
---

<!--
  Marks JS availability before first paint so auto-scroll, drag, arrows,
  and progress can engage. The horizontal strip layout itself is pure CSS
  and works without JS (native horizontal scroll).
-->
<script is:inline>
  try { document.documentElement.classList.add("proof-js"); } catch (e) {}
</script>

<section class="proof grain" data-proof aria-label={eyebrow}>
  <div class="shell">
    <div class="split-head" data-reveal>
      <div>
        <div class="eyebrow">{eyebrow}</div>
        <h2 class="display" style="font-size: clamp(2.2rem, 5vw, 4.2rem); margin-top: 14px; line-height:.92;">{heading}</h2>
      </div>
      <div class="split-head-actions">
        <p class="prose" style="font-size: 15px; max-width: 38ch;">{sub}</p>
        <a href={paths.demos} class="btn btn--ghost btn--sm" style="margin-top:16px;">{browse}</a>
      </div>
    </div>
  </div>

  <!-- Horizontal strip. The page scrolls vertically past it freely; the
       track scrolls horizontally on its own (auto-scroll, drag, arrows,
       native swipe). Pure CSS horizontal scroll works without JS;
       JS enhances with auto-scroll, drag, progress, and counters.
       Reduced motion falls back to a calm vertical stack. -->
  <div class="proof-scroll">
    <div class="proof-pin" data-proof-pin tabindex="0" aria-keyshortcuts="ArrowLeft ArrowRight Home End">
      <div class="proof-topbar" aria-hidden="true">
        <span class="eyebrow eyebrow--sm">{eyebrow}</span>
        <span class="proof-count mono"><span data-proof-count>01</span><span class="proof-count-sep"> / </span>{total}</span>
      </div>

      <div class="proof-track" data-proof-track>
        {demos.map((d, i) => (
          <article class="proof-panel" data-proof-panel data-demo-id={d.id}>
            {i > 0 && <span class="proof-fracture" aria-hidden="true"></span>}
            <a href={`${paths.demos}/${d.id}`} class="proof-shot" aria-label={`${d.name}, ${d.tone}`}>
              <img
                src={`/carousel/${d.id}.jpg`}
                alt={imgAlt(d.name)}
                loading={i < 2 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                width="1280"
                height="800"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
              />
              <span class="proof-fallback" aria-hidden="true" style="display:none;">
                <span class="proof-fallback-name">{d.name}</span>
                <span class="proof-fallback-tone">{d.tone}</span>
              </span>
            </a>
            <div class="proof-meta">
              <span class="proof-index mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="proof-name">{d.name}</h3>
              <p class="proof-tags mono"><span>{d.category}</span><span aria-hidden="true"> · </span><span>{d.tone}</span></p>
            </div>
          </article>
        ))}
      </div>

      <div class="proof-controls">
        <button type="button" class="proof-btn" data-proof-prev aria-label={prevLabel}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
        </button>
        <div class="proof-progress" aria-hidden="true">
          <span class="proof-crackline"></span>
          <span class="proof-fill" data-proof-fill></span>
        </div>
        <button type="button" class="proof-btn" data-proof-next aria-label={nextLabel}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initProof() {
    const root = document.querySelector('[data-proof]') as HTMLElement;
    if (!root || (root as HTMLElement).dataset.init) return;
    (root as HTMLElement).dataset.init = "1";
    const pin = root.querySelector('[data-proof-pin]') as HTMLElement;
    const track = root.querySelector('[data-proof-track]') as HTMLElement;
    const panels = Array.from(track.querySelectorAll('[data-proof-panel]')) as HTMLElement[];
    const prev = root.querySelector('[data-proof-prev]') as HTMLButtonElement;
    const next = root.querySelector('[data-proof-next]') as HTMLButtonElement;
    const fill = root.querySelector('[data-proof-fill]') as HTMLElement;
    const countNum = root.querySelector('[data-proof-count]') as HTMLElement;
    if (!panels.length || !pin || !track || !prev || !next || !fill || !countNum) return;

    const n = panels.length;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return; // CSS renders the vertical stack; no auto-scroll, nothing to drive.

    const AUTOPLAY_MS = 3000;

    // ---------- progress + counter ----------
    let paintQueued = false;
    function paint() {
      paintQueued = false;
      const max = Math.max(1, track.scrollWidth - track.clientWidth);
      const p = Math.min(1, Math.max(0, track.scrollLeft / max));
      fill.style.transform = `scaleX(${p})`;
      const idx = Math.min(n - 1, Math.round(p * (n - 1)));
      countNum.textContent = String(idx + 1).padStart(2, "0");
      for (let i = 0; i < n; i++) panels[i].classList.toggle("is-active", i === idx);
    }
    function queuePaint() {
      if (paintQueued) return;
      paintQueued = true;
      requestAnimationFrame(paint);
    }

    function panelLeft(i: number) {
      const clamped = Math.min(n - 1, Math.max(0, i));
      const panel = panels[clamped];
      // Center the panel in the visible track area.
      return panel.offsetLeft - (track.clientWidth - panel.offsetWidth) / 2;
    }
    function scrollToPanel(i: number, behavior: ScrollBehavior = "smooth") {
      track.scrollTo({ left: panelLeft(i), behavior });
    }
    function currentIndex() {
      const max = Math.max(1, track.scrollWidth - track.clientWidth);
      return Math.min(n - 1, Math.max(0, Math.round((track.scrollLeft / max) * (n - 1))));
    }

    // ---------- auto-scroll (pauses on hover / focus / drag / offscreen) ----------
    let timer = 0;
    let hoverPause = false;
    let focusPause = false;
    let dragPause = false;
    let inView = true;
    function stop() {
      if (timer) { window.clearInterval(timer); timer = 0; }
    }
    function start() {
      stop();
      if (hoverPause || focusPause || dragPause || !inView) return;
      timer = window.setInterval(() => {
        if (!root.isConnected) { stop(); return; }
        const at = currentIndex() + 1;
        // Wrap to the start instantly rather than rewinding through 30 panels.
        if (at >= n) scrollToPanel(0, "auto");
        else scrollToPanel(at);
      }, AUTOPLAY_MS);
    }
    function recomputePause() {
      const paused = hoverPause || focusPause || dragPause;
      if (paused) stop();
      else start();
    }

    pin.addEventListener("mouseenter", () => { hoverPause = true; recomputePause(); });
    pin.addEventListener("mouseleave", () => { hoverPause = false; recomputePause(); });
    pin.addEventListener("focusin", () => { focusPause = true; recomputePause(); });
    pin.addEventListener("focusout", (e: FocusEvent) => {
      if (!pin.contains(e.relatedTarget as Node)) { focusPause = false; recomputePause(); }
    });

    const io = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      inView = entry.isIntersecting;
      if (inView) start(); else stop();
    }, { threshold: 0.05 });
    io.observe(root);
    // Fallback: if the observer doesn't fire (or fires late), ensure autoplay
    // kicks in when the carousel is visible. The observer remains the source
    // of truth for pause/resume.
    setTimeout(() => {
      if (!timer && !hoverPause && !focusPause && !dragPause) {
        const r = root.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        if (r.bottom > 0 && r.top < vh) start();
      }
    }, 1200);

    // ---------- arrow buttons + keyboard ----------
    function goTo(i: number) {
      const at = i >= n ? 0 : (i < 0 ? n - 1 : i);
      scrollToPanel(at);
      start(); // reset the autoplay countdown after a manual move
    }
    prev.addEventListener("click", () => goTo(currentIndex() - 1));
    next.addEventListener("click", () => goTo(currentIndex() + 1));
    pin.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") { e.preventDefault(); goTo(currentIndex() + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); goTo(currentIndex() - 1); }
      else if (e.key === "Home") { e.preventDefault(); goTo(0); }
      else if (e.key === "End") { e.preventDefault(); goTo(n - 1); }
    });

    // ---------- drag to scroll (mouse only; touch uses native swipe) ----------
    let dragging = false;
    let startX = 0;
    let startLeft = 0;
    let moved = 0;
    track.addEventListener("pointerdown", (e: PointerEvent) => {
      if (e.button !== 0 || e.pointerType !== "mouse") return;
      if ((e.target as HTMLElement).closest("button")) return;
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add("is-dragging");
      dragPause = true;
      recomputePause();
      try { track.setPointerCapture(e.pointerId); } catch (err) { /* noop */ }
    });
    track.addEventListener("pointermove", (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      track.scrollLeft = startLeft - dx;
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging");
      dragPause = false;
      recomputePause();
      // Settle on the nearest panel for a tidy resting state.
      scrollToPanel(currentIndex());
    }
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);
    // A drag that ends over a link must not activate it.
    track.addEventListener("click", (e: MouseEvent) => {
      if (moved > 8) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    track.addEventListener("scroll", queuePaint, { passive: true });
    window.addEventListener("resize", queuePaint, { passive: true });
    // Clean up across Astro client-side navigations: the old interval and
    // resize listener must not keep firing on detached nodes.
    document.addEventListener("astro:before-swap", function cleanup() {
      stop();
      window.removeEventListener("resize", queuePaint);
      document.removeEventListener("astro:before-swap", cleanup);
    });
    paint();
    start();
  }

  function bootProof() {
    try { initProof(); } catch (e) { /* never break the page */ }
  }
  document.addEventListener("astro:page-load", bootProof);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", bootProof);
  else bootProof();
</script>

<style>
  .proof { padding-block: clamp(48px, 7vw, 96px); overflow: clip; }

  /* ---------- Horizontal strip (default, pure CSS) ----------
     The page scrolls vertically past this section at all times; the track
     scrolls horizontally on its own via auto-scroll, drag, arrows, or
     native touch swipe. Works without JS via native horizontal scroll. */
  .proof-scroll { margin-top: 34px; }
  .proof-pin { position: relative; }
  .proof-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(20px, 6vw, 88px) 18px;
  }
  .eyebrow--sm { font-size: 10px; }
  .proof-count { font-size: 11px; letter-spacing: .12em; color: var(--muted); }
  .proof-count-sep { opacity: .45; }

  .proof-track {
    --proof-gap: clamp(24px, 3vw, 44px);
    --proof-card-w: min(560px, 78vw);
    display: flex;
    gap: var(--proof-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Center the active card: side padding = (viewport - card) / 2,
       so half of neighbors peek on the edges. */
    padding: 6px max(clamp(20px, 6vw, 88px), calc(50% - var(--proof-card-w) / 2)) 30px;
    scrollbar-width: thin;
    /* Fade on the sides */
    mask-image: linear-gradient(90deg, transparent 0, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 10%, black 90%, transparent 100%);
  }
  .proof-panel {
    position: relative;
    flex: 0 0 auto;
    width: var(--proof-card-w);
    scroll-snap-align: center;
    min-width: 0;
  }
  .proof-shot {
    display: block; border-radius: var(--r-lg, 18px); overflow: clip;
    border: 1px solid var(--line); background: var(--paper-2);
    box-shadow: var(--shadow-sm);
    transition: transform .45s var(--ease-out, cubic-bezier(.16,1,.3,1)), box-shadow .45s var(--ease-out, cubic-bezier(.16,1,.3,1));
  }
  .proof-shot:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .proof-shot img {
    width: 100%; display: block;
    height: clamp(200px, 32vw, 360px);
    object-fit: cover; object-position: top;
  }
  .proof-fallback {
    width: 100%;
    height: clamp(200px, 32vw, 360px);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    background: linear-gradient(135deg, var(--paper-2), var(--paper-3));
    text-align: center;
    padding: 24px;
  }
  .proof-fallback-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
  }
  .proof-fallback-tone {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .proof-panel.is-active .proof-shot {
    box-shadow: var(--shadow-md);
  }
  .proof-meta { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-top: 14px; padding-inline: 4px; }
  .proof-index { font-size: 11px; color: var(--accent-text, var(--accent)); letter-spacing: .08em; }
  .proof-name { font-size: clamp(1.2rem, 2.4vw, 1.7rem); letter-spacing: -0.02em; font-weight: 700; }
  .proof-tags { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-left: auto; }

  /* Fracture motif: a jagged dark crack splitting each panel boundary,
     like a torn page edge. Centered in the gap between panels. */
  .proof-fracture {
    display: block;
    position: absolute;
    top: -3%; bottom: -3%; left: 0;
    width: 26px;
    transform: translateX(calc(-50% - var(--proof-gap, 32px) / 2));
    background: var(--ink);
    opacity: .13;
    clip-path: polygon(
      62% 0, 100% 5%, 54% 10%, 96% 16%, 52% 23%, 92% 30%, 56% 38%,
      100% 46%, 60% 55%, 94% 63%, 50% 71%, 88% 79%, 58% 87%,
      92% 94%, 62% 100%, 34% 100%, 66% 93%, 36% 85%, 70% 77%,
      38% 68%, 72% 60%, 40% 52%, 74% 44%, 42% 36%, 70% 28%,
      38% 20%, 68% 12%, 40% 5%, 34% 0
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Crack-fill progress + controls in normal flow under the track. */
  .proof-controls {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 2px clamp(20px, 6vw, 88px) 0;
  }
  .proof-btn {
    width: 44px; height: 44px; flex: none;
    border-radius: 99px; border: 1px solid var(--line);
    background: var(--card-bg); color: var(--ink); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background .25s var(--ease-out, ease), color .25s var(--ease-out, ease), transform .25s var(--ease-out, ease);
  }
  .proof-btn:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .proof-btn:active { transform: scale(.94); }
  .proof-btn svg { width: 16px; height: 16px; }
  .proof-progress { position: relative; flex: 1; height: 2px; }
  .proof-crackline {
    position: absolute; inset: 0;
    background: var(--line-strong);
    border-radius: 99px;
  }
  .proof-fill {
    position: absolute; inset: 0;
    background: var(--accent);
    border-radius: 99px;
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  /* Drag affordance, fine pointers only. */
  @media (hover: hover) and (pointer: fine) {
    .proof-track { cursor: grab; }
    .proof-track.is-dragging { cursor: grabbing; }
    .proof-track.is-dragging * { user-select: none; }
    .proof-panel a { cursor: pointer; }
  }

  /* ---------- Reduced motion: calm vertical stack, no auto-scroll ---------- */
  @media (prefers-reduced-motion: reduce) {
    .proof-track {
      display: grid;
      gap: clamp(36px, 5vw, 64px);
      overflow: visible;
      padding: 6px 0 48px;
    }
    .proof-panel { width: 100%; }
    .proof-shot img { height: auto; aspect-ratio: 16 / 10; }
    .proof-topbar,
    .proof-controls,
    .proof-fracture { display: none; }
    .proof-shot, .proof-btn { transition: none; }
  }
</style>
