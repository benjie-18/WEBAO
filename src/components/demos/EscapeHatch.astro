---
// Demo escape hatch — prominent, always-visible control back to the WEBAO demo catalog.
// Self-contained: own prefixed styles, no dependency on the main site theme.
// It must stand out on every demo page (light or dark art direction) and be easy
// to reach by mouse, touch, and keyboard, so: solid text-safe brand red
// (#C62820 — white on it is 5.64:1, AA; the brighter #FF3B30 is only 3.55:1),
// full opacity, a 44px minimum touch target, safe-area-aware placement, and a
// two-tone focus ring that reads on any background.
// The bar has two ends: back to the catalog (left, red) and forward to
// /start with this demo's slug (right, ink) — a prospect who likes the style
// can act on it without leaving the demo. The slug comes from the URL at
// runtime, so the 47 demo pages need no per-page prop; without JS the
// forward link still goes to /start.
interface Props {
  locale?: "en" | "fr";
  backHref?: string;
}
const { locale = "en", backHref } = Astro.props as Props;
const href = backHref ?? (locale === "fr" ? "/fr/demos" : "/demos");
const label = locale === "fr" ? "Retour aux démos · démo fictive" : "Back to demos · fictional demo";
const forwardHref = locale === "fr" ? "/fr/commencer" : "/start";
const forwardLabel = locale === "fr" ? "Construire mon site comme celui-ci →" : "Build my site like this →";
const forwardShort = locale === "fr" ? "Comme celui-ci →" : "Build like this →";
---

<div class="demo-exit-bar">
<a href={href} class="demo-exit" aria-label={label} title={label}>
  <svg class="demo-exit-arrow" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="demo-exit-word">webao</span>
  <span class="demo-exit-sep" aria-hidden="true">·</span>
  <span class="demo-exit-note">{locale === "fr" ? "démo fictive" : "fictional demo"}</span>
  <span class="demo-exit-back-banner">{locale === "fr" ? "Retour à WEBAO" : "Back to WEBAO"}</span>
</a>
<a href={forwardHref} class="demo-exit-forward" data-demo-forward data-forward-base={forwardHref}>
  <span class="demo-exit-forward-long">{forwardLabel}</span>
  <span class="demo-exit-forward-short">{forwardShort}</span>
</a>
<button type="button" class="demo-exit-dismiss" data-demo-dismiss aria-label={locale === "fr" ? "Masquer la barre" : "Dismiss banner"}>✕</button>
</div>

<script>
  // Attach this demo's slug to the forward link: /start?demo=<slug>.
  (function () {
    var link = document.querySelector("[data-demo-forward]");
    if (!link) return;
    var m = /\/demos\/([^/?#]+)/.exec(location.pathname);
    if (!m) return;
    link.setAttribute("href", link.getAttribute("data-forward-base") + "?demo=" + encodeURIComponent(m[1]));
  })();
  // Mobile top banner is dismissible for this page view only: it comes back
  // on the next page load, so the way back to WEBAO is never lost.
  (function () {
    var dismiss = document.querySelector("[data-demo-dismiss]");
    if (!dismiss) return;
    dismiss.addEventListener("click", function () {
      var bar = document.querySelector(".demo-exit-bar");
      if (bar) bar.remove();
    });
  })();
</script>

<style>
  .demo-exit-bar {
    position: fixed;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100vw - 32px);
  }
  .demo-exit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 16px;
    border-radius: 999px;
    background: #c62820;
    color: #ffffff;
    border: none;
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(255, 255, 255, 0.28);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .demo-exit:hover {
    background: #a81e14;
    transform: translateY(-2px);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.32);
  }
  .demo-exit:active {
    transform: translateY(0);
  }
  .demo-exit:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #ffffff,
      0 0 0 5px #0a0f1c,
      0 10px 28px rgba(0, 0, 0, 0.38);
  }
  .demo-exit-arrow { flex: none; }
  .demo-exit-word { font-weight: 800; }
  .demo-exit-sep { opacity: 0.6; }
  .demo-exit-note { opacity: 0.85; }
  /* Forward end of the bar: the conversion path. Ink pill, same 44px
     target, short label on narrow screens so the bar fits. */
  .demo-exit-forward {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 16px;
    border-radius: 999px;
    background: #0a0f1c;
    color: #ffffff;
    border: none;
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(255, 255, 255, 0.28);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .demo-exit-forward:hover {
    background: #1c2438;
    transform: translateY(-2px);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.32);
  }
  .demo-exit-forward:active {
    transform: translateY(0);
  }
  .demo-exit-forward:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #ffffff,
      0 0 0 5px #0a0f1c,
      0 10px 28px rgba(0, 0, 0, 0.38);
  }
  .demo-exit-forward-short { display: none; }
  .demo-exit-back-banner { display: none; }
  .demo-exit-dismiss { display: none; }
  @media (max-width: 640px) {
    /* #62: on mobile the hatch becomes a slim 36px top banner, so the
       bottom thumb-zone belongs to the demo sites' own Quick actions bars. */
    .demo-exit-bar {
      left: 0; right: 0; top: 0; bottom: auto;
      max-width: none; height: calc(36px + env(safe-area-inset-top, 0px));
      padding-top: env(safe-area-inset-top, 0px);
      box-sizing: border-box; gap: 0;
      background: #0a0f1c;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.14), 0 8px 24px rgba(0, 0, 0, 0.35);
    }
    .demo-exit, .demo-exit-forward {
      min-height: 36px; height: 36px; padding: 0 12px;
      border-radius: 0; box-shadow: none;
    }
    .demo-exit:hover, .demo-exit-forward:hover { transform: none; }
    .demo-exit-word, .demo-exit-sep, .demo-exit-note { display: none; }
    .demo-exit-back-banner { display: inline; font-weight: 800; }
    .demo-exit-forward { flex: 1; min-width: 0; justify-content: center; }
    .demo-exit-forward-long {
      display: inline; overflow: hidden; text-overflow: ellipsis;
    }
    .demo-exit-forward-short { display: none; }
    .demo-exit-dismiss {
      display: inline-flex; align-items: center; justify-content: center;
      flex: none; width: 36px; height: 36px; min-height: 36px;
      background: transparent; color: #ffffff; border: none; cursor: pointer;
      font-size: 13px; line-height: 1;
    }
    .demo-exit-dismiss:focus-visible {
      outline: none; box-shadow: inset 0 0 0 2px #ffffff;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-exit { transition: none; }
    .demo-exit:hover { transform: none; }
    .demo-exit-forward { transition: none; }
    .demo-exit-forward:hover { transform: none; }
  }
</style>
