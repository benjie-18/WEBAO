---
// Demo escape hatch — prominent, always-visible control back to the WEBAO demo catalog.
// Self-contained: own prefixed styles, no dependency on the main site theme.
// It must stand out on every demo page (light or dark art direction) and be easy
// to reach by mouse, touch, and keyboard, so: solid text-safe brand red
// (#C62820 — white on it is 5.64:1, AA; the brighter #FF3B30 is only 3.55:1),
// full opacity, a 44px minimum touch target, safe-area-aware placement, and a
// two-tone focus ring that reads on any background.
interface Props {
  locale?: "en" | "fr";
  backHref?: string;
}
const { locale = "en", backHref } = Astro.props as Props;
const href = backHref ?? (locale === "fr" ? "/fr/demos" : "/demos");
const label = locale === "fr" ? "Retour aux démos · démo fictive" : "Back to demos · fictional demo";
---

<a href={href} class="demo-exit" aria-label={label} title={label}>
  <svg class="demo-exit-arrow" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="demo-exit-word">webao</span>
  <span class="demo-exit-sep" aria-hidden="true">·</span>
  <span class="demo-exit-note">{locale === "fr" ? "démo fictive" : "fictional demo"}</span>
</a>

<style>
  .demo-exit {
    position: fixed;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 16px;
    border-radius: 999px;
    background: #c62820;
    color: #ffffff;
    border: none;
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(255, 255, 255, 0.28);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .demo-exit:hover {
    background: #a81e14;
    transform: translateY(-2px);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.32);
  }
  .demo-exit:active {
    transform: translateY(0);
  }
  .demo-exit:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #ffffff,
      0 0 0 5px #0a0f1c,
      0 10px 28px rgba(0, 0, 0, 0.38);
  }
  .demo-exit-arrow { flex: none; }
  .demo-exit-word { font-weight: 800; }
  .demo-exit-sep { opacity: 0.6; }
  .demo-exit-note { opacity: 0.85; }
  @media (max-width: 640px) {
    .demo-exit { left: 12px; padding: 12px 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-exit { transition: none; }
    .demo-exit:hover { transform: none; }
  }
</style>
