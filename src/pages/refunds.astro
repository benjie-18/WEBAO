---
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = "en" as const;
const title = "Refund policy · WEBAO";
const description = "WEBAO refund policy: subscription cancellation terms.";
---

<BaseLayout title={title} description={description} locale={locale} pageKey="refunds">
  <section class="section">
    <div class="shell" style="max-width: 860px;">
      <div class="eyebrow">Policy</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.6rem); line-height:.92; margin-top:12px;">Refund policy</h1>
      <p class="prose" style="margin-top:14px; max-width: 60ch;">
        Simple and straightforward. Website plans have no setup fee.
        Monthly subscriptions are paid in advance.
      </p>

      <div style="margin-top: 36px; display:grid; gap: 20px;">
        <div style="border:1px solid var(--line); border-radius:16px; padding:24px; background: var(--card-bg);">
          <h2 style="font-size:17px; letter-spacing:-0.01em; margin:0 0 12px;">Monthly subscription ($89.99–$349.99/mo, depending on your plan)</h2>
          <p class="prose" style="font-size:14px; margin:0;">
            Cancel with 30 days' notice. Your site stays live until the end of
            the period you've paid for. No cancellation fees.
          </p>
        </div>

        <div style="border:1px solid var(--line); border-radius:16px; padding:24px; background: var(--card-bg);">
          <h2 style="font-size:17px; letter-spacing:-0.01em; margin:0 0 12px;">How to cancel</h2>
          <p class="prose" style="font-size:14px; margin:0;">
            Just <a href="/contact" style="color: var(--accent-text);">contact us</a> and
            tell us you'd like to cancel. We'll confirm within one
            business day.
          </p>
        </div>
      </div>

      <p class="mono" style="margin-top:28px; font-size:11px; color: var(--muted);">
        Last updated November 2026. WEBAO reserves the right to update this policy;
        the version in effect at the time of your purchase applies.
      </p>
    </div>
  </section>
</BaseLayout>
