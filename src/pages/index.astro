---
import BaseLayout from "../layouts/BaseLayout.astro";
import CursorJourney from "../components/anim/CursorJourney.astro";
import IntroSequence from "../components/anim/IntroSequence.astro";
---

<BaseLayout
  title="WEBAO · Custom websites for small business · webao.ca"
  description="Custom websites for small businesses across Canada, for $149 CAD a month. Design, domain, hosting, updates, and support included. See the demo catalog."
>
  <!-- Signature intro: cursor flies in, hits the barrier, bounces, invites the
       click, breaks through and hands the visitor to "Start your site".
       Only runs on the landing page, once per session, and never blocks the
       site when disabled, reduced-motion, or JS-less. -->
  <IntroSequence slot="overlay" />
  <!-- HERO: watermark + parallax + split reveal -->
  <section class="hero grain" id="hero">
    <div class="hero-watermark" aria-hidden="true"><span>WEBAO</span><span>WEBAO</span></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker" data-reveal>
          <span class="eyebrow" style="color: var(--accent);">A SMALL WEB STUDIO IN MONTRÉAL</span>
          <span class="hero-badge">
            <span class="dot"></span> Accepting new projects
          </span>
        </div>

        <h1 class="hero-title display" data-reveal style="--d:80ms">
          Websites that<br />
          <span class="hero-italic">work</span> for<br />
          small business.
        </h1>

        <p class="hero-lead prose" data-reveal style="--d:160ms">
          A custom, professional website without the domains, hosting, and “can you fix this?” emails.
          <strong>One simple monthly fee.</strong> We design, launch, host, and maintain it while you run your business.
        </p>

        <div class="hero-actions" data-reveal style="--d:240ms">
          <a href="/contact" class="btn btn--primary">
            Start your site
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5"/></svg>
          </a>
          <a href="/demos" class="btn btn--ghost">
            See demo sites
          </a>
          <span class="hero-note mono">$149 <span style="opacity:.6">CAD/month</span> · All-inclusive</span>
        </div>
      </div>

      <div class="hero-visual" data-reveal="scale" style="--d:140ms" aria-hidden="true" data-hero-visual>
        <div class="visual-stack" data-parallax="stack">
          <!-- Top bar -->
          <div class="browser-bar">
            <div class="dots"><i></i><i></i><i></i></div>
            <div class="url">nora-electrique (demo)</div>
            <div class="live"><i></i>Fictional example site</div>
          </div>

          <!-- Main preview -->
          <div class="preview-main">
            <div class="preview-media">
              <!-- Custom editorial image: layered SVG composition -->
              <svg viewBox="0 0 640 420" role="img" aria-label="Preview collage" class="preview-art">
                <defs>
                  <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#0A0F1C"/><stop offset="100%" stop-color="#1E2A3A"/>
                  </linearGradient>
                  <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
                    <path d="M32 0 H0 V32" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
                  </pattern>
                </defs>
                <rect width="640" height="420" rx="16" fill="url(#g1)"/>
                <rect width="640" height="420" rx="16" fill="url(#grid)"/>
                <!-- abstract photo blocks -->
                <rect x="28" y="28" width="260" height="320" rx="14" fill="#F8F5EF"/>
                <rect x="42" y="46" width="180" height="10" rx="5" fill="#0A0F1C" opacity=".08"/>
                <rect x="42" y="66" width="232" height="26" rx="6" fill="#0A0F1C"/>
                <rect x="42" y="100" width="210" height="8" rx="4" fill="#0A0F1C" opacity=".36"/>
                <rect x="42" y="116" width="180" height="8" rx="4" fill="#0A0F1C" opacity=".18"/>
                <rect x="42" y="146" width="232" height="1" fill="#0A0F1C" opacity=".08"/>
                <!-- image placeholder with duotone -->
                <rect x="42" y="164" width="232" height="150" rx="10" fill="#E3421E"/>
                <g opacity=".92">
                  <path d="M58 264 q56 -48 96 0 t 104 0" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
                  <circle cx="210" cy="198" r="22" fill="white" opacity=".95"/>
                </g>
                <rect x="306" y="28" width="306" height="140" rx="14" fill="white" opacity=".96"/>
                <rect x="324" y="48" width="110" height="8" rx="4" fill="#0A0F1C" opacity=".08"/>
                <rect x="324" y="64" width="170" height="12" rx="6" fill="#0A0F1C"/>
                <rect x="324" y="86" width="150" height="7" rx="3.5" fill="#0A0F1C" opacity=".30"/>
                <g transform="translate(324 108)">
                  <rect width="88" height="28" rx="14" fill="#0A0F1C"/><text x="18" y="18" font-size="11" font-family="Inter" fill="white" font-weight="600">Get Quote</text>
                  <rect x="96" y="0" width="88" height="28" rx="14" fill="none" stroke="#0A0F1C" stroke-opacity=".12"/><text x="112" y="18" font-size="11" font-family="Inter" fill="#0A0F1C" font-weight="600">Our Work</text>
                </g>
                <!-- bottom service cards -->
                <g transform="translate(306 182)">
                  <rect width="148" height="96" rx="12" fill="white"/>
                  <rect x="14" y="14" width="36" height="36" rx="8" fill="#F8F5EF" stroke="#0A0F1C" stroke-opacity=".06"/>
                  <text x="14" y="76" font-size="11" font-family="Inter" font-weight="650" fill="#0A0F1C">Residential</text>
                  <text x="14" y="88" font-size="10" font-family="Inter" fill="#6B7288">24h emergency</text>
                  <rect x="158" y="0" width="148" height="96" rx="12" fill="#0A0F1C"/>
                  <circle cx="172" cy="32" r="18" fill="white" opacity=".12"/><path d="M166 32 h12 M172 26 v12" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
                  <text x="172" y="76" font-size="11" font-family="Inter" font-weight="650" fill="white">Commercial</text>
                  <text x="172" y="88" font-size="10" font-family="Inter" fill="white" opacity=".6">Certified & insured</text>
                </g>
                <g transform="translate(306 290)">
                  <rect width="306" height="58" rx="12" fill="#0A0F1C"/>
                  <text x="16" y="24" font-size="10" font-family="IBM Plex Mono" fill="white" opacity=".5" letter-spacing="2">NEXT AVAILABLE</text>
                  <text x="16" y="42" font-size="13" font-family="Inter" font-weight="650" fill="white">Tomorrow at 9:00 AM · Book now</text>
                  <circle cx="280" cy="29" r="16" fill="white"/><path d="M274 29 l5 5 6-6" fill="none" stroke="#0A0F1C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
              </svg>
            </div>
            <div class="preview-meta">
              <div class="meta-left">
                <span class="mono" style="font-size:10px; color: var(--muted);">DEMO 01 · NORA ÉLECTRIQUE (FICTIONAL)</span>
                <span style="font-weight:650; letter-spacing:-0.02em;">Clean contemporary · Built for calls</span>
              </div>
              <span class="pill">Mobile-ready</span>
            </div>
          </div>

          <!-- Floating cards: parallax layers -->
          <div class="float-card float-a" data-parallax="a">
            <div class="float-icon">◐</div>
            <div>
              <div style="font-weight: 700; font-size: 13px; letter-spacing:-0.02em;">Domain + hosting included</div>
              <div style="font-size: 12.5px; color: var(--muted);">Your domain · SSL · ongoing updates</div>
            </div>
            <span class="check">✓</span>
          </div>
          <div class="float-card float-b" data-parallax="b">
            <div style="font-family: var(--font-mono); font-size:10px; letter-spacing:.12em; color: var(--muted);">SMALL UPDATES</div>
            <div style="font-family: var(--font-display); font-size:24px; line-height:1.05; margin-top:6px;">Hours, photos,<br />prices.</div>
            <ul class="float-list" role="list">
              <li><i>✓</i> Included every month</li>
              <li><i>✓</i> Just send an email</li>
            </ul>
          </div>
        </div>

        <div class="visual-caption mono">
          <span>DEMO 01 · ELECTRICIAN</span>
          <span style="opacity:.5;">One of 12 design directions →</span>
        </div>
      </div>
    </div>

    <div class="hero-rail" aria-hidden="true">
      <div class="rail-line"></div>
      <span class="mono">SCROLL</span>
      <div class="rail-line"></div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-item">Électriciens <i></i> Plombiers <i></i> Couvreurs <i></i> Paysagistes <i></i> Restaurants <i></i> Cliniques</span>
      <span class="marquee-item">Électriciens <i></i> Plombiers <i></i> Couvreurs <i></i> Paysagistes <i></i> Restaurants <i></i> Cliniques</span>
      <span class="marquee-item">Électriciens <i></i> Plombiers <i></i> Couvreurs <i></i> Paysagistes <i></i> Restaurants <i></i> Cliniques</span>
      <span class="marquee-item">Électriciens <i></i> Plombiers <i></i> Couvreurs <i></i> Paysagistes <i></i> Restaurants <i></i> Cliniques</span>
    </div>
  </div>

  <!-- POSITIONING / INTRO -->
  <section class="section grain">
    <div class="shell">
      <div class="intro-grid">
        <div data-reveal>
          <div class="eyebrow">Why WEBAO exists</div>
          <h2 class="display" style="font-size: clamp(2.2rem, 5vw, 4.2rem); margin-top: 14px; line-height:.92;">
            You shouldn’t<br />
            need to become<br />
            <span style="font-style: italic; font-weight:400;">a web person.</span>
          </h2>
        </div>
        <div class="intro-copy" data-reveal style="--d:120ms">
          <p class="prose">
            Most small businesses don’t need a complex app. They need a <strong>fast, credible, findable</strong> website that answers the phone, even when you’re on a job.
          </p>
          <p class="prose" style="margin-top: 16px; color: var(--muted);">
            WEBAO is a small studio that takes care of all of it for one monthly fee: the domain, the hosting, the updates, the technical decisions. You get a person to talk to, not a ticket queue.
          </p>

          <div class="cluster" style="margin-top: 28px;">
            <a href="/pricing" class="btn btn--dark btn--sm">See what’s included →</a>
            <span class="mono" style="font-size:11px; color: var(--muted);">Monthly · No long-term contract</span>
          </div>
        </div>
      </div>

      <!-- Feature mini grid -->
      <div class="feature-grid" data-reveal style="--d:180ms">
        <div class="f-card">
          <div class="f-icon">◆</div>
          <h3>Looks custom. Because it is.</h3>
          <p>Every site is designed around your trade, not a template with your logo pasted on top. Typography, layout, and imagery chosen for your business.</p>
        </div>
        <div class="f-card f-card--accent">
          <div class="f-icon">◒</div>
          <h3>Built to be found.</h3>
          <p>Fast, accessible, mobile-first pages with clean markup, a sitemap, and SEO basics. We can also help set up your Google Business Profile. Solid fundamentals, not ranking promises.</p>
        </div>
        <div class="f-card">
          <div class="f-icon">◎</div>
          <h3>We keep it alive.</h3>
          <p>Hosting, SSL, security, backups, and small content updates like hours, photos, or menu changes. Send an email, we make the change.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="process" class="section section--dark grain" style="overflow: clip;">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div class="eyebrow" style="color: rgba(248,245,239,.5);">How it works · Three steps, and no meetings that should have been emails</div>
        <h2 class="display" style="font-size: clamp(2.4rem, 6vw, 5rem); margin-top: 12px; line-height:.92;">From idea to <span style="color: var(--accent); font-style: italic; font-weight:400;">live</span>, usually in about a week.</h2>
      </div>

      <div class="steps">
        <div class="step" data-reveal>
          <div class="step-n">01</div>
          <div class="step-body">
            <h3>You send the basics</h3>
            <p>Photos (phone is fine), services, service area, and what you want clients to do: call, book, or request a quote. We handle the rest and ask only good questions.</p>
            <ul class="step-list mono">
              <li>→ 15-min call or form</li>
              <li>→ We pick 2 directions from our demos</li>
            </ul>
          </div>
          <div class="step-visual">
            <div class="mini-card">
              <div class="mono" style="font-size:10px; opacity:.5;">INBOX · HELLO@WEBAO.CA</div>
              <div style="margin-top:10px; font-size:13px; line-height:1.5;"><strong>Subject:</strong> A site for my HVAC business</div>
              <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;"><span class="tag">Photos.zip</span><span class="tag">Services.txt</span><span class="tag">Logo.svg</span></div>
              <div style="margin-top:12px; height:1px; background: var(--line);"></div>
              <div style="margin-top:10px; display:flex; align-items:center; gap:8px; font-size:13px;"><span style="width:28px;height:28px;border-radius:99px;background:var(--ink);color:white;display:grid;place-items:center;font-size:11px;">W</span> Got it. First draft coming your way soon. <span style="margin-left:auto; color: var(--accent);">↗</span></div>
            </div>
          </div>
        </div>
        <div class="step" data-reveal style="--d:100ms">
          <div class="step-n">02</div>
          <div class="step-body">
            <h3>We design & build</h3>
            <p>You get a private preview link within a few days. Click through a real homepage on your phone. One round of clear feedback in, we polish.</p>
            <ul class="step-list mono">
              <li>→ Private preview URL</li>
              <li>→ One revision round</li>
            </ul>
          </div>
          <div class="step-visual">
            <div class="mini-card mini-card--dark">
              <div style="display:flex; align-items:center; gap:8px;"><span style="width:8px;height:8px;border-radius:99px;background:#00D084;"></span><span class="mono" style="font-size:10px; opacity:.7; color:white;">PREVIEW · YOUR SITE DRAFT</span></div>
              <div style="margin-top:14px; height:86px; border-radius:10px; overflow:hidden; background: linear-gradient(135deg,#F8F5EF 0%, #EFE9DE 100%); position:relative;">
                <div style="position:absolute; inset:12px; border-radius:8px; background:white; border:1px solid rgba(10,15,28,.06); padding:10px;">
                  <div style="height:6px; width:42%; border-radius:99px; background:#0A0F1C; opacity:.9;"></div>
                  <div style="height:4px; width:64%; border-radius:99px; background:#0A0F1C; opacity:.14; margin-top:8px;"></div>
                  <div style="display:flex; gap:6px; margin-top:10px;"><span style="flex:1; height:22px; border-radius:99px; background:#FF3B30;"></span><span style="flex:1; height:22px; border-radius:99px; border:1px solid rgba(10,15,28,.12);"></span></div>
                </div>
              </div>
              <div style="margin-top:12px; display:flex; gap:8px;"><span class="btn btn--primary btn--sm" style="flex:1; justify-content:center;">Approve →</span><span class="btn btn--ghost btn--sm" style="flex:1; justify-content:center; border-color: rgba(255,255,255,.14); color:white;">Comment</span></div>
            </div>
          </div>
        </div>
        <div class="step" data-reveal style="--d:200ms">
          <div class="step-n">03</div>
          <div class="step-body">
            <h3>We launch & maintain</h3>
            <p>Your domain, hosting, SSL, analytics, and backups. The site stays fast and correct. Need a price change or a new photo? Email us and it’s done.</p>
            <ul class="step-list mono">
              <li>→ Your domain, registered to your business</li>
              <li>→ Small updates included</li>
            </ul>
          </div>
          <div class="step-visual">
            <div class="mini-card">
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span class="mono" style="font-size:10px; opacity:.5;">YOURSITE.CA · LAUNCH DAY</span>
                <span style="font-size:11px; background:#0A0F1C; color:white; padding:4px 8px; border-radius:99px; font-weight:600;">● Live</span>
              </div>
              <div style="margin-top:12px; display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:12.5px;">
                <div style="background:#F8F5EF; border-radius:10px; padding:10px; text-align:center;"><div style="font-weight:700;">SSL</div><div style="opacity:.6; font-size:11px;">Auto-renewing</div></div>
                <div style="background:#F8F5EF; border-radius:10px; padding:10px; text-align:center;"><div style="font-weight:700;">Backups</div><div style="opacity:.6; font-size:11px;">Included</div></div>
              </div>
              <div style="margin-top:10px; font-size:12.5px; color: var(--muted); text-align:center;">Need a change? <a href="/contact" style="color:var(--accent); font-weight:600; text-decoration:underline; text-underline-offset:3px;">Send a message →</a></div>
            </div>
          </div>
        </div>
      </div>

      <div class="steps-cta" data-reveal>
        <a href="/contact" class="btn btn--primary">Start with a 15-min call</a>
        <span class="mono" style="color: rgba(248,245,239,.5); font-size:11px;">Or <a href="/contact" style="color: var(--paper); text-decoration: underline; text-underline-offset: 3px;">send your details</a>, usually answered within one business day</span>
      </div>
    </div>
  </section>

  <!-- DEMOS PREVIEW -->
  <section class="section">
    <div class="shell">
      <div class="split-head" data-reveal>
        <div>
          <div class="eyebrow">The demo catalog · 12 design directions, not 12 color swaps</div>
          <h2 class="display" style="font-size: clamp(2.2rem, 5.2vw, 4.4rem); margin-top:10px; line-height:.92;">What could <span style="font-style:italic; font-weight:400; color: var(--accent);">yours</span> look like?</h2>
        </div>
        <div class="split-head-actions">
          <p class="prose" style="font-size: 15px; max-width: 38ch;">Each demo is a fictional business with its own type, palette, layout, and tone. Find the direction that feels like you.</p>
          <a href="/demos" class="btn btn--ghost btn--sm" style="margin-top:16px;">Browse all demos →</a>
        </div>
      </div>

      <div class="demo-strip">
        <a href="/demos" class="demo-card demo-card--dark" data-reveal>
          <div class="demo-media">
            <div class="demo-tag mono">DEMO 01 · TRADES · FICTIONAL</div>
            <div class="demo-title">NORA <span>ÉLECTRIQUE</span></div>
            <div class="demo-sub mono">Clean contemporary · Emergency callouts</div>
            <div class="demo-lines"><i style="width:92%"></i><i style="width:68%; opacity:.5"></i></div>
          </div>
          <div class="demo-foot">
            <span style="font-weight:650; letter-spacing:-0.02em;">Nora Électrique</span>
            <span class="mono" style="font-size:11px; opacity:.6;">View in catalog →</span>
          </div>
        </a>
        <a href="/demos" class="demo-card demo-card--paper" data-reveal style="--d:100ms">
          <div class="demo-media" style="background: #FFF7ED;">
            <div class="demo-tag mono" style="color: #9A3412;">DEMO 02 · RESTAURANT · FICTIONAL</div>
            <div class="demo-title" style="color:#431407; font-family: var(--font-display); font-style: italic; letter-spacing:-0.03em;">Mira <span style="font-style: normal; font-weight:400;">Cantine</span></div>
            <div class="demo-sub mono" style="color:#9A3412;">Warm editorial · Wood-fired menu</div>
            <div style="margin-top:18px; display:flex; gap:8px;">
              <span style="background:#431407; color:#FFF7ED; padding:6px 12px; border-radius:99px; font-size:11px; font-weight:650;">Reserve</span>
              <span style="border:1px solid rgba(67,20,7,.14); padding:6px 12px; border-radius:99px; font-size:11px;">Menu</span>
            </div>
          </div>
          <div class="demo-foot">
            <span style="font-weight:650; letter-spacing:-0.02em;">Mira Cantine</span>
            <span class="mono" style="font-size:11px; opacity:.6;">View in catalog →</span>
          </div>
        </a>
        <a href="/demos" class="demo-card demo-card--ink" data-reveal style="--d:200ms">
          <div class="demo-media" style="background:#0F172A; color:#E2E8F0;">
            <div class="demo-tag mono" style="color: rgba(226,232,240,.5);">DEMO 03 · AUTOMOTIVE · FICTIONAL</div>
            <div class="demo-title" style="color:white; letter-spacing:-0.04em;">ATELIER <span style="font-weight:400; opacity:.7;">NORD</span></div>
            <div class="demo-sub mono" style="color: rgba(226,232,240,.6);">Premium automotive · Précision first</div>
            <div style="margin-top:16px; height:1px; background: rgba(226,232,240,.12);"></div>
            <div style="margin-top:14px; display:flex; gap:8px; font-size:11px;"><span style="color: white; font-weight:650;">Services</span><span style="opacity:.5;">·</span><span style="opacity:.7;">Inventaire</span><span style="opacity:.5;">·</span><span style="opacity:.7;">Rendez-vous</span></div>
          </div>
          <div class="demo-foot" style="background:#0F172A; color:#E2E8F0; border-top-color: rgba(226,232,240,.08);">
            <span style="font-weight:650; letter-spacing:-0.02em;">Atelier Nord</span>
            <span class="mono" style="font-size:11px; opacity:.5;">View in catalog →</span>
          </div>
        </a>
      </div>

      <div class="demo-browse" data-reveal>
        <div class="demo-browse-left">
          <span class="mono" style="font-size:11px; color: var(--muted);">ALSO IN THE CATALOG (ALL FICTIONAL)</span>
          <div class="chips">
            <span>Plomberie Leduc</span><span>Boisé Paysage</span><span>Clinique Sora</span><span>Studio Forma</span><span>Toit & Fils</span><span>+ 6 more</span>
          </div>
        </div>
        <a href="/demos" class="btn btn--dark" style="white-space:nowrap;">Search & filter demos</a>
      </div>
    </div>
  </section>

  <!-- AGENCY CARDS -->
  <section class="section section--ink2 grain" style="padding-bottom: 0;">
    <div class="shell">
      <div class="agency-head" data-reveal>
        <h2 class="display" style="font-size: clamp(2.6rem, 6vw, 5.2rem); line-height:.9; color: var(--paper);">Where to next?</h2>
        <p class="mono" style="color: rgba(248,245,239,.5); margin-top:12px; font-size: 12px;">PICK A DOOR · EACH IS A DIFFERENT COMPOSITION, SAME STUDIO.</p>
      </div>

      <div class="agency-grid" style="position: relative;">
        <CursorJourney />
        <!-- Pricing card -->
        <a href="/pricing" class="agency-card agency-card--pricing" data-reveal>
          <div class="agency-top mono">
            <span>01 · PRICING</span><span aria-hidden="true">→</span>
          </div>
          <div class="agency-body">
            <div class="agency-price">
              <span class="display">$149</span>
              <span class="mono">CAD / month<br />all-in</span>
            </div>
            <h3 class="agency-title">One price.<br />Everything in.</h3>
            <p>Custom 3–5 pages, domain, hosting, SSL, SEO basics, analytics, and support. One plan that covers the whole thing.</p>
          </div>
