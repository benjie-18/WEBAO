---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/pages/HomePage.astro";
import IntroSequence from "../components/anim/IntroSequence.astro";
import { useTranslations } from "../lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);
---

<BaseLayout
  title={t.meta.home.title}
  description={t.meta.home.description}
  locale={locale}
  pageKey="home"
>
  <!-- Signature intro: cursor flies in, hits the barrier, bounces, invites the
       click, breaks through and hands the visitor to the primary CTA.
       Only runs on the landing page, once per session, and never blocks the
       site when disabled, reduced-motion, or JS-less.
       Must sit in the `overlay` slot: BaseLayout renders it outside <main>,
       which is transformed (translateY(100dvh)) while the intro plays. -->
  <IntroSequence slot="overlay" locale={locale} />

  <HomePage locale={locale} />
</BaseLayout>
