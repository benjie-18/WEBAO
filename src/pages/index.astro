---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/pages/HomePage.astro";
import { useTranslations } from "../lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);

// FAQPage structured data for search snippets, built from the translated FAQ.
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: t.home.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
});
---

<BaseLayout
  title={t.meta.home.title}
  description={t.meta.home.description}
  locale={locale}
  pageKey="home"
>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />

  <HomePage locale={locale} />
</BaseLayout>
