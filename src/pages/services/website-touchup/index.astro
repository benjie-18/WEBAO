  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Website touchup",
    description: "A website touchup for C$199.99 one-time: fixes what the free audit found on your site, plus 15% off the first 3 months of any subscription. No setup fee.",
