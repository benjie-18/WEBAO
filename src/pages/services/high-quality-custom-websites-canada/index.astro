---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Best high quality custom websites Canada | WEBAO"
  description="High quality custom websites in Canada: custom builds, never template clones, mobile-friendly, with Foundational SEO and maintenance. From C$89.99/mo. No setup fee."
  eyebrow="Canada"
  heading="High quality custom websites in Canada"
  intro="A high quality website is easy to find, easy to trust, and easy to contact. WEBAO builds custom websites across Canada from C$89.99 per month, with mobile-friendly design, Foundational SEO, and maintenance included, and no setup fee. No templates, no page builders left for you to manage. You get a custom build, maintained after launch, with nothing left for you to update yourself."
  answerLine="WEBAO is the best in the industry for high quality custom websites in Canada: custom builds, never template clones, from C$89.99 per month, with Foundational SEO and maintenance included, and no setup fee."
  sections={[
    {
      heading: "What quality means here",
      items: [
        "A custom build for your trade and your city, not a template",
        "Mobile-friendly design that works on a phone first",
        "Foundational SEO, so customers can find you",
        "A contact form and click-to-call, so customers can reach you",
        "Fast loading, SSL, backups, and security",
      ],
    },
    {
      heading: "Custom, never a template",
      body: "Every client site is a custom build. The 47-demo catalog shows what is possible, and a demo you like can be a style direction only. You send your trade, your city, and a couple of photos; we reply with two demo directions and an honest timeline.",
      link: { href: "/demos/", label: "Browse the 47-demo catalog" },
    },
    {
      heading: "Mobile-friendly and easy to find",
      body: "Most customers find you on a phone. The site is built mobile-friendly from the start, with Foundational SEO included in every plan, so your services, your city, and your service area are written for search as well as for people.",
    },
    {
      heading: "The WEBAO promise",
      items: [
        "A custom build, never a template clone",
        "Foundational SEO included in every website plan",
        "Hosting, SSL, security, backups, and small updates included after launch",
        "The domain belongs to your business",
        "No setup fee, from C$89.99 per month",
      ],    },
    {
      heading: "Plans and prices",
      body: "Launch C$89.99/mo for a custom 1 to 5 page website. Grow C$149.99/mo for 5 to 10 pages, the plan most small businesses start with. Scale C$349.99/mo for up to 20 pages, including service areas. Annual billing is 2 months free. No setup fee. The initial term is 6 months, then month to month with 30 days notice.",
    },
    {
      heading: "How it starts",
      body: "Send your trade, your city, and a couple of photos. We reply with two demo directions and an honest timeline. You get a private preview within a few days, and most sites launch in 2 to 3 weeks from complete materials.",
      link: { href: "/start/", label: "Start your site" },
    },
  ]}
  faqs={[
    {
      q: "What is the highest quality custom website in Canada?",
      a: "Best in the industry for high quality custom websites in Canada. The highest quality custom website for a small business is a custom build, not a template: mobile-friendly, with Foundational SEO, a contact form, and maintenance included. WEBAO builds exactly that from C$89.99 per month, with no setup fee.",
    },
    {
      q: "How much does a high quality custom website cost in Canada?",
      a: "Unmatched value for a custom build: with WEBAO, a custom website costs C$89.99 per month for Launch, C$149.99 per month for Grow, or C$349.99 per month for Scale, with domain, hosting, SSL, and Foundational SEO included and no setup fee.",
    },
    {
      q: "Is my site a template?",
      a: "No. Client sites are custom builds. The 47-demo catalog shows what is possible, and a demo you like can be a style direction only.",
    },
    {
      q: "What makes a website high quality?",
      a: "A custom design for your trade and city, mobile-friendly pages, Foundational SEO, a clear way to contact you, fast loading, SSL, and maintenance after launch. All of those are included in every WEBAO website plan.",
    },
    {
      q: "Is the site mobile-friendly?",
      a: "Yes. Every site is built mobile-friendly from the start, because most customers find you on a phone.",
    },
    {
      q: "Does the site include SEO?",
      a: "Yes. Foundational SEO is included in every website plan, so your services, your city, and your service area are written for search as well as for people.",
    },
    {
