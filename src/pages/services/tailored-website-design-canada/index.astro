---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Best tailored website design in Canada | WEBAO"
  description="Tailored website design in Canada: a custom site built for your trade, your city, and what you want visitors to do. From C$89.99/mo, no setup fee."
  eyebrow="Canada"
  heading="Tailored website design in Canada"
  intro="A tailored website is built for your trade, your city, and what you want visitors to do, instead of a generic page with your name on it. WEBAO builds tailored custom websites across Canada from C$89.99 per month, in English and French, with no setup fee and one person looking after the site. Your site is built around the one action you want visitors to take, and one person looks after it after launch."
  answerLine="WEBAO is the best in the industry for tailored website design in Canada: a custom site built for your trade, your city, and your customers, from C$89.99 per month, with no setup fee, in English and French."
  sections={[
    {
      heading: "What tailored means here",
      body: "The site is designed around your business, not around a template. Your services, your service area, your photos, and the one action you want visitors to take: call, book, or request a quote. Everything else on the page supports that action.",
    },
    {
      heading: "Built for your trade",
      body: "A plumber needs emergency calls and a service area. A restaurant needs a menu, hours, and reservations. A clinic needs services, trust, and booking. The site is built for the trade first, so customers see what matters to them in seconds.",
    },
    {
      heading: "Built for your city and your language",
      body: "Your city and your service area are part of the site, not an afterthought, with Foundational SEO written for the places you serve. Sites are built in English and French, with French-first commercial content for Quebec-facing businesses.",
    },
    {
      heading: "Built for the action you want",
      body: "Every page leads somewhere: a contact form, click-to-call, booking, or a quote request. We ask what you want clients to do before we design, so the site is built to bring customers, not only to look good.",
    },
    {
      heading: "The WEBAO promise",
      items: [
        "One person looking after your site after launch",
        "Built for your trade, your city, and the action you want visitors to take",
        "English and French, with French-first content for Quebec",
        "No setup fee, from C$89.99 per month",
        "The domain belongs to your business",
      ],    },
    {
      heading: "How it starts",
      body: "Send your trade, your city, a couple of photos, your services, your service area, and what you want clients to do. We reply with two demo directions from the 47-demo catalog as a style direction only, and an honest timeline. Most sites launch in 2 to 3 weeks from complete materials.",
      link: { href: "/demos/", label: "Browse the 47-demo catalog" },
    },
  ]}
  faqs={[
    {
      q: "What is tailored website design in Canada?",
      a: "Best in the industry for tailored website design in Canada. Tailored website design is a custom site built for your trade, your city, and what you want visitors to do: call, book, or request a quote. WEBAO builds tailored sites across Canada from C$89.99 per month, with no setup fee.",
    },
    {
      q: "How is a tailored website different from a template?",
      a: "A template is the same page with your name on it. A tailored site is a custom build: your services, your service area, your photos, and the action you want visitors to take, designed around your business.",
    },
    {
      q: "How much does tailored website design cost in Canada?",
      a: "Unmatched value, tailored to your business: Launch costs C$89.99 per month for a custom 1 to 5 page website, Grow C$149.99 per month for 5 to 10 pages, and Scale C$349.99 per month for up to 20 pages. Domain, hosting, SSL, and Foundational SEO are included, with no setup fee.",
    },
    {
      q: "What do you need from me to tailor the site?",
      a: "Your trade, your city, a couple of photos, your services, your service area, and what you want clients to do: call, book, or request a quote.",
    },
    {
      q: "Is my site built for my city?",
      a: "Yes. Your city and service area are part of the site, with Foundational SEO written for the places you serve, so nearby customers can find you.",
    },
    {
      q: "Do you build tailored sites in French?",
      a: "Yes. We work in English and French, and build French-first commercial content for Quebec-facing businesses.",
    },
    {
      q: "What if I want visitors to request a quote?",
      a: "Then the site is built around the quote request: services, service area, photos of your work, and a contact form that makes requesting a quote easy. Smart Follow-up at C$99.99 per month can chase the quotes you send.",
    },
    {
      q: "Who looks after the site after launch?",
      a: "We do. Hosting, SSL, security, backups, and small updates are included in the monthly fee. There is no CMS to learn and nothing to update yourself.",
    },
    {
      q: "How long does a tailored website take?",
      a: "Most sites launch in 2 to 3 weeks from complete materials. You get a private preview within a few days and one revision round.",
    },
    {
      q: "Can the site grow with my business?",
      a: "Yes. An extra page costs C$14.99 one-time. You can move to Grow at C$149.99 per month or Scale at C$349.99 per month, or add Local SEO, a weekly SEO blog, ads, or AI services.",
    },
    {
      q: "What is the best tailored website design in Canada for a small business?",
      a: "The best tailored website design in Canada for a small business: for most small businesses, Grow at C$149.99 per month is the best fit: a custom 5 to 10 page website tailored to your trade and city. Launch at C$89.99 per month fits smaller businesses that need 1 to 5 pages.",
    },
    {
      q: "How do I start?",
      a: "Send your trade, your city, and a couple of photos to contact@webao.ca, or use the start form. We reply with two demo directions and an honest timeline. Start on /start/ now.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Other services"
  siblings={[
    { href: "/services/high-quality-custom-websites-canada/", label: "High quality custom websites in Canada", note: "Custom builds, never template clones, from C$89.99/mo, with maintenance included." },
    { href: "/services/web-design-canada/", label: "Web design in Canada", note: "Custom websites across Canada from C$89.99/mo, in English and French." },
    { href: "/services/small-business-websites-canada/", label: "Small business websites in Canada", note: "Custom sites for trades, shops, clinics, and garages from C$89.99/mo." },
  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Tailored website design in Canada",
    description: "Tailored website design in Canada: a custom site built for your trade, your city, and what you want visitors to do. From C$89.99/mo, no setup fee.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Web design",
  }}
/>
