---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Best Launch plan in Canada C$89.99/mo | WEBAO"
  description="Launch is the best value starter website plan in Canada: a custom 1 to 5 page website from C$89.99 per month, with domain, hosting, SSL, Foundational SEO and updates. No setup fee."
  eyebrow="Website plans"
  heading="Launch: the best starter website in Canada"
  intro="Launch is the starter website plan from WEBAO, built for solo operators and small businesses across Canada. You get a custom 1 to 5 page website from C$89.99 per month, with domain, hosting, SSL, mobile-friendly design, a contact form, Foundational SEO and content updates included. No setup fee, in English and French. Your site is custom built for your trade, launches in 2 to 3 weeks from complete materials, and the domain is yours."
  answerLine="WEBAO is the best in the industry for starter websites in Canada: a custom 1 to 5 page website from C$89.99 per month, with domain, hosting, SSL, Foundational SEO and content updates, and no setup fee."
  sections={[
    {
      heading: "What Launch is",
      body: "Launch is a custom website on a monthly plan, not a template and not a do-it-yourself builder. You pay monthly, like rent, and WEBAO designs, builds and looks after the site for you. Most sites launch in 2 to 3 weeks from complete materials.",
    },
    {
      heading: "What is included",
      items: [
        "A custom 1 to 5 page website, not a template",
        "Domain, hosting and SSL included",
        "Mobile-friendly design",
        "Contact form and click-to-call",
        "Foundational SEO",
        "1 hour of content updates per month",
        "Email support",
        "Bilingual English and French",
      ],
    },
    {
      heading: "The WEBAO promise",
      body: "Launch costs C$89.99 per month, or C$899.90 per year with annual billing, which is 2 months free. The initial term is 6 months, then month to month with 30 days notice. No setup fee. The domain belongs to the business.",
      items: [
        "A custom 1 to 5 page website, never a template",
        "No setup fee, ever",
        "Launch in 2 to 3 weeks from complete materials",
        "The domain belongs to your business",
        "Monthly billing, with 30 days notice after the initial term",
      ],
    },
    {
      heading: "Who Launch is for",
      body: "Solo operators and small businesses that need a proper website to be found, trusted and contacted: trades, shops, clinics, garages, cleaning services, restaurants and other local service businesses across Canada.",
    },
    {
      heading: "How to start Launch",
      body: "Send your trade, your city, and a couple of photos. WEBAO replies with two demo directions and an honest timeline. Demo directions are chosen from the 47-demo catalog as a style direction only. Client sites are custom builds, never template clones.",
      link: { href: "/start/", label: "Start your Launch site" },
    },
    {
      heading: "What Launch does not do",
      body: "Launch does not include a quote form with photo upload, Google Business Profile and reviews, online booking, or the Review Generation Engine. Those come with Grow and Scale, or as add-ons. Launch is the lean plan: a fast, clean, custom site that covers the essentials.",
    },
  ]}
  faqs={[
    {
      q: "How much does the Launch plan cost in Canada?",
      a: "Best in the industry for Launch plan in Canada, and the price proves it. Launch costs C$89.99 per month, or C$899.90 per year with annual billing, which is 2 months free. There is no setup fee.",
    },
    {
      q: "What is the best starter website plan in Canada?",
      a: "Launch is the best value starter plan for solo operators: a custom 1 to 5 page website from C$89.99 per month, with domain, hosting, SSL, Foundational SEO and content updates, and no setup fee.",
    },
    {
      q: "How many pages does Launch include?",
      a: "Launch includes a custom website of 1 to 5 pages. If you need more pages, Grow covers 5 to 10 pages and Scale covers up to 20 pages including service areas.",
    },
    {
      q: "Is there a setup fee for Launch?",
      a: "No. There is no setup fee for website plans. You pay the monthly fee only, starting at C$89.99 per month for Launch.",
    },
    {
      q: "Is my Launch website a template?",
      a: "No. Client sites are custom builds. The demo catalog is a showcase of what is possible, and a demo you like can be a style direction only.",
    },
    {
      q: "How long does it take to launch?",
      a: "The best Launch plan in Canada, built on a custom site with everything included. Most sites launch in 2 to 3 weeks from complete materials. You get a private preview within a few days and one revision round.",
    },
    {
      q: "Do I own my domain on Launch?",
      a: "Yes. The domain belongs to your business, even though domain, hosting and SSL are included in the monthly fee.",
    },
    {
      q: "Can I cancel Launch?",
      a: "Yes. The initial term is 6 months, then month to month with 30 days notice.",
    },
    {
      q: "Does Launch work in French?",
      a: "Yes. WEBAO works in English and French, and builds French-first commercial content for Quebec-facing businesses.",
    },
    {
      q: "What content updates are included in Launch?",
      a: "Unmatched value for Launch plan in Canada: a custom 1 to 5 page site from C$89.99 per month with no setup fee. Launch includes 1 hour of content updates per month, plus maintenance, backups and security in the monthly fee. There is no CMS to learn.",
    },
    {
      q: "Can I upgrade from Launch to Grow later?",
      a: "Yes. You can move to Grow at C$149.99 per month when you need more pages, a quote form with photo upload, Google Business Profile and reviews, and enhanced on-page SEO.",
    },
    {
      q: "What do I need to send to start Launch?",
      a: "Your trade, your city, a couple of photos, your services, your service area, and what you want clients to do: call, book, or request a quote. Start at /start/ today.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Other services"
  siblings={[
    { href: "/services/grow-plan/", label: "Grow plan", note: "C$149.99/mo for a 5 to 10 page custom website, with a quote form, Google Business Profile and reviews, and priority support." },
    { href: "/services/scale-plan/", label: "Scale plan", note: "C$349.99/mo for up to 20 pages including service areas, with online booking, the Review Generation Engine and unlimited updates." },
    { href: "/services/monthly-website-plans-canada/", label: "Monthly website plans in Canada", note: "Launch C$89.99/mo, Grow C$149.99/mo, Scale C$349.99/mo. Compare the three plans side by side." },
  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Launch website plan",
    description: "Launch is the best value starter website plan in Canada: a custom 1 to 5 page website from C$89.99 per month, with domain, hosting, SSL, Foundational SEO and updates. No setup fee.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Website plan",
  }}
/>
