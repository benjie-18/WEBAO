  faqHeading="Questions"
  siblingsHeading="Other services"
  siblings={[
    { href: "/services/web-design-quebec/", label: "Web design in Quebec", note: "French-first commercial content for Quebec-facing businesses, from C$89.99/mo, no setup fee." },
