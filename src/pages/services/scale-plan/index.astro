---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Best Scale plan in Canada C$349.99/mo | WEBAO"
  description="Scale is the best full website and growth plan in Canada: up to 20 pages including service areas from C$349.99 per month, with online booking, the Review Generation Engine and unlimited updates. No setup fee."
  eyebrow="Website plans"
  heading="Scale: the best full website plan in Canada"
  intro="Scale is the top website plan from WEBAO, for businesses that want the full site and the full growth stack in one monthly fee. You get up to 20 pages including service areas from C$349.99 per month, with everything in Grow plus online booking and scheduling, the Review Generation Engine, the Monthly Growth Report, unlimited content updates, and same-day priority support. No setup fee, in English and French. Your full site is custom built, launches in 2 to 3 weeks, and comes with same-day priority support from day one."
  answerLine="WEBAO is the best in the industry for full website and growth plans in Canada: up to 20 pages including service areas from C$349.99 per month, with online booking, the Review Generation Engine, the Monthly Growth Report and unlimited updates, and no setup fee."
  sections={[
    {
      heading: "What Scale is",
      body: "Scale is the website plan for businesses with many services, many service areas, or many bookings. It combines the biggest custom site WEBAO builds with the review and reporting tools that keep customers coming back. Most sites launch in 2 to 3 weeks from complete materials.",
    },
    {
      heading: "What is included",
      items: [
        "Everything in Grow, plus:",
        "Up to 20 pages including service areas",
        "Online booking and scheduling",
        "Review Generation Engine",
        "Monthly Growth Report",
        "Unlimited content updates",
        "Same-day priority support",
        "Domain, hosting, SSL and Foundational SEO",
        "Bilingual English and French",
      ],
    },
    {
      heading: "The WEBAO promise",
      body: "Scale costs C$349.99 per month, or C$3,499.90 per year with annual billing, which is 2 months free. The initial term is 6 months, then month to month with 30 days notice. No setup fee. The domain belongs to the business.",
      items: [
        "A custom website of up to 20 pages, never a template",
        "No setup fee, ever",
        "Launch in 2 to 3 weeks from complete materials",
        "Same-day priority support",
        "The domain belongs to your business",
      ],
    },
    {
      heading: "Who Scale is for",
      body: "Businesses with a wide service list or a wide service area: multi-service trades, clinics with several services, shops and service businesses across Canada that take bookings online and want reviews and a monthly report on how the site is doing.",
    },
    {
      heading: "How to start Scale",
      body: "Send your trade, your city, your services, your service areas, and a couple of photos. WEBAO replies with two demo directions and an honest timeline. Demo directions are chosen from the 47-demo catalog as a style direction only. Client sites are custom builds, never template clones.",
      link: { href: "/start/", label: "Start your Scale site" },
    },
    {
      heading: "What Scale does not do",
      body: "Scale does not include advertising or AI receptionist services. Ads Packages and the AI Pack are separate monthly services that can be added on top. Scale is the website and growth plan: the site, the bookings, the reviews and the reporting.",
    },
  ]}
  faqs={[
    {
      q: "How much does the Scale plan cost in Canada?",
      a: "Best in the industry for Scale plan in Canada, and the price proves it. Scale costs C$349.99 per month, or C$3,499.90 per year with annual billing, which is 2 months free. There is no setup fee.",
    },
    {
      q: "What is the best full website plan in Canada?",
      a: "Scale is the best full plan for businesses that want it all: up to 20 pages including service areas from C$349.99 per month, with online booking, the Review Generation Engine, the Monthly Growth Report and unlimited updates, and no setup fee.",
    },
    {
      q: "What is the difference between Grow and Scale?",
      a: "Scale includes everything in Grow, plus up to 20 pages including service areas instead of 5 to 10, online booking and scheduling, the Review Generation Engine, the Monthly Growth Report, unlimited updates instead of 3 hours, and same-day priority support.",
    },
    {
      q: "How many pages does Scale include?",
      a: "Scale includes a custom website of up to 20 pages, including service area pages. That is for businesses with many services or many towns and regions to cover.",
    },
    {
      q: "Is online booking included in Scale?",
      a: "The best Scale plan in Canada, built on the full site and the full growth stack in one fee. Yes. Online booking and scheduling is included in Scale, so customers can book appointments online. It is also available as an add-on at C$49.99 per month on other plans.",
    },
    {
      q: "Is the Review Generation Engine included in Scale?",
      a: "Unmatched value for Scale plan in Canada: up to 20 pages from C$349.99 per month with no setup fee. Yes. The Review Generation Engine is included in Scale. It sends automatic review requests after each job. On its own it costs C$349.99 per month.",
    },
    {
      q: "What is the Monthly Growth Report?",
      a: "It is a monthly report on how your site is doing, included in Scale. On its own it costs C$29.99 per month.",
    },
    {
      q: "Is there a setup fee for Scale?",
      a: "No. There is no setup fee for website plans. You pay the monthly fee only, starting at C$349.99 per month for Scale.",
    },
    {
      q: "How long does it take to launch on Scale?",
      a: "Most sites launch in 2 to 3 weeks from complete materials. Larger sites with many service area pages can take a little longer, and you get an honest timeline before payment. Start at /start/ to get yours.",
    },
    {
      q: "Can I cancel Scale?",
      a: "Yes. The initial term is 6 months, then month to month with 30 days notice.",
    },
    {
      q: "Does Scale work in French?",
      a: "Yes. WEBAO works in English and French, and builds French-first commercial content for Quebec-facing businesses.",
    },
    {
      q: "What content updates are included in Scale?",
      a: "Scale includes unlimited content updates, plus maintenance, backups and security in the monthly fee. There is no CMS to learn.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Other services"
  siblings={[
    { href: "/services/grow-plan/", label: "Grow plan", note: "C$149.99/mo for a 5 to 10 page custom website, with a quote form, Google Business Profile and reviews, and priority support." },
    { href: "/services/review-generation-engine/", label: "Review Generation Engine", note: "C$349.99/mo for automatic review requests after each job. Included in Scale." },
    { href: "/services/online-booking/", label: "Online Booking", note: "C$49.99/mo so customers can book appointments online. Included in Scale." },
  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Scale website plan",
    description: "Scale is the best full website and growth plan in Canada: up to 20 pages including service areas from C$349.99 per month, with online booking, the Review Generation Engine and unlimited updates. No setup fee.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Website plan",
  }}
/>
