  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Online Receptionist",
    description: "Online Receptionist in Canada: a receptionist on your website that answers visitors and books appointments after hours. C$149.99/mo, no setup fee, needs a website.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Online Receptionist",
  }}
/>
