---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="serviceAi"
  title="AI receptionist, online receptionist, and AI follow-up | WEBAO"
  description="AI services for small businesses: AI receptionist C$299.99/mo answers calls and chats, online receptionist C$149.99/mo answers website visitors and books appointments after hours, AI follow-up C$99.99/mo chases quotes. Or the AI Pack with all three for C$399.99/mo. No setup fee."
  eyebrow="AI services"
  heading="AI that answers when you cannot"
  intro="Three AI services that handle the work you miss while you are on a job: a receptionist that answers calls and chats, an online receptionist that answers visitors on your website, and follow-up that chases quotes you sent. All three together in the AI Pack for C$399.99/mo. No setup fee on any of them."
  answerLine="The phone gets answered, the website visitor gets a reply, and the quote you sent gets chased, even while you work."
  sections={[
    {
      heading: "AI receptionist",
      body: "C$299.99/mo. Answers your calls and chats, takes messages, and books callers in when you are busy. It works on its own: no website needed.",
      link: { href: "/guides/ai-receptionist-small-business/", label: "AI receptionist, in detail →" },
    },
    {
      heading: "Online receptionist",
      body: "C$149.99/mo. Answers visitors on your website while you work and books appointments after hours: hours, services, prices, and directions to contact you. It lives on your site, so it needs one.",
    },
    {
      heading: "AI follow-up",
      body: "C$99.99/mo. Chases the quotes you sent so the ones that go quiet get a nudge, and the ones that reply get back to you. It works on its own: no website needed.",
    },
    {
      heading: "AI Pack",
      body: "C$399.99/mo for all three: AI receptionist, online receptionist, and follow-up. The receptionist and follow-up work on their own; the online receptionist needs your website. No setup fee.",
    },
    {
      heading: "What the AI does not do",
      body: "It does not pretend to be you, and it does not make promises on your behalf. When it cannot answer, it takes a message and hands it to you. You stay in charge of every booking and every quote.",
    },
  ]}
  faqs={[
    {
      q: "Does the AI receptionist replace my phone?",
      a: "No. It answers when you cannot, takes the message, and hands it to you. Your phone still rings first when you are free to pick up.",
    },
    {
      q: "What happens when the AI cannot answer?",
      a: "It takes a message instead of guessing. You get the message with the caller's details and decide what happens next.",
    },
    {
      q: "Do I need a website for the AI services?",
      a: "Only for the online receptionist, which lives on your website. The receptionist and the follow-up work on their own.",
    },
    {
      q: "Is there a setup fee?",
      a: "No. There is no setup fee on the receptionist, the chat, the follow-up, or the AI Pack.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Other services"
  siblings={[
    { href: "/services/websites/", label: "Websites", note: "Custom websites on monthly plans: Launch C$89.99/mo, Grow C$149.99/mo, Scale C$349.99/mo. No setup fee." },
    { href: "/services/ads/", label: "Advertising", note: "Ads Packages on Meta and Google: Starter C$399.99/mo, one channel C$649.99/mo, both C$999.99/mo. No setup fee." },
    { href: "/services/", label: "All services", note: "Websites, advertising, and AI services from one team, on one monthly bill." },
  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI services",
    description: "AI receptionist C$299.99/mo, online receptionist C$149.99/mo, AI follow-up C$99.99/mo, or the AI Pack with all three for C$399.99/mo. No setup fee.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: "CA",
    serviceType: "AI services",
  }}
/>
