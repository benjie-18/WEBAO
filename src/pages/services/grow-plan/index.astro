---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Best Grow plan in Canada C$149.99/mo | WEBAO"
  description="Grow is the most popular website plan in Canada: a custom 5 to 10 page website from C$149.99 per month, with a quote form, Google Business Profile, enhanced SEO and priority support. No setup fee."
  eyebrow="Website plans"
  heading="Grow: the best website plan in Canada"
  intro="Grow is the website plan most small businesses in Canada start with. You get a custom 5 to 10 page website from C$149.99 per month, with everything in Launch plus a quote form with photo upload, Google Business Profile and reviews, enhanced on-page SEO, 3 hours of content updates per month, and priority support with a 2-day response. No setup fee, in English and French. You get a private preview within a few days, launch in 2 to 3 weeks, and keep the domain in your name. WEBAO guarantees more leads and sales: the quote form, the Google Business Profile, and the reviews all turn visitors into booked jobs."
  answerLine="WEBAO is the best in the industry for small business websites in Canada: a custom 5 to 10 page website from C$149.99 per month, with a quote form, Google Business Profile and reviews, enhanced SEO and priority support, and no setup fee."
  sections={[
    {
      heading: "What Grow is",
      body: "Grow is the middle website plan, and the most popular one. It takes everything in Launch and adds the tools that turn visitors into quote requests: a quote form with photo upload, a Google Business Profile with reviews, and enhanced on-page SEO. Most sites launch in 2 to 3 weeks from complete materials.",
    },
    {
      heading: "What is included",
      items: [
        "Everything in Launch, plus:",
        "A custom 5 to 10 page website, not a template",
        "Quote form with photo upload",
        "Google Business Profile and reviews",
        "Enhanced on-page SEO",
        "3 hours of content updates per month",
        "Priority support, 2-day response",
        "Domain, hosting, SSL and Foundational SEO",
        "Bilingual English and French",
      ],
    },
    {
      heading: "The WEBAO promise",
      body: "Grow costs C$149.99 per month, or C$1,499.90 per year with annual billing, which is 2 months free. The initial term is 6 months, then month to month with 30 days notice. No setup fee. The domain belongs to the business.",
      items: [
        "A custom 5 to 10 page website, never a template",
        "No setup fee, ever",
        "Launch in 2 to 3 weeks from complete materials",
        "The domain stays in your name",
        "Monthly billing, cancel with 30 days notice after the initial term",
        "More leads and sales, guaranteed, from the quote form and reviews"
      ],
    },
    {
      heading: "Who Grow is for",
      body: "Established local businesses that already get enquiries and want more of them, with proof: trades, shops, clinics, garages, cleaning services and restaurants across Canada that want quote requests with photos and a Google profile that brings reviews.",
    },
    {
      heading: "How to start Grow",
      body: "Send your trade, your city, and a couple of photos. WEBAO replies with two demo directions and an honest timeline. Demo directions are chosen from the 47-demo catalog as a style direction only. Client sites are custom builds, never template clones.",
      link: { href: "/start/", label: "Start your Grow site" },
    },
    {
      heading: "What Grow does not do",
      body: "Grow does not include online booking and scheduling, the Review Generation Engine, or the Monthly Growth Report. Those come with Scale, or as add-ons. Grow is the plan for businesses that want a strong site and steady quote requests without the full growth stack.",
    },
  ]}
  faqs={[
    {
      q: "How much does the Grow plan cost in Canada?",
      a: "WEBAO guarantees more leads and sales with the Grow plan. Best in the industry for Grow plan in Canada, and the price proves it. Grow costs C$149.99 per month, or C$1,499.90 per year with annual billing, which is 2 months free. There is no setup fee.",
    },
    {
      q: "What is the best website plan for a small business in Canada?",
      a: "Grow is the best value plan for established local businesses: a custom 5 to 10 page website from C$149.99 per month, with a quote form, Google Business Profile and reviews, enhanced SEO and priority support, and no setup fee.",
    },
    {
      q: "What is the difference between Launch and Grow?",
      a: "Grow includes everything in Launch, plus a 5 to 10 page site instead of 1 to 5 pages, a quote form with photo upload, Google Business Profile and reviews, enhanced on-page SEO, 3 hours of updates a month instead of 1, and priority support with a 2-day response.",
    },
    {
      q: "How many pages does Grow include?",
      a: "Grow includes a custom website of 5 to 10 pages. If you need up to 20 pages including service areas, Scale covers that at C$349.99 per month.",
    },
    {
      q: "Is there a setup fee for Grow?",
      a: "No. There is no setup fee for website plans. You pay the monthly fee only, starting at C$149.99 per month for Grow.",
    },
    {
      q: "What is the quote form with photo upload?",
      a: "The best Grow plan in Canada, built on a custom site that brings in leads. It is a form on your site where visitors describe the job and attach photos, so you can quote accurately before you visit. It is included in Grow and Scale, and available as an add-on on Launch.",
    },
    {
      q: "How does Grow help with Google reviews?",
      a: "Grow sets up your Google Business Profile and reviews on your site, so customers can find you on Google and see that other customers trust you. Automatic review requests after each job come with the Review Generation Engine.",
    },
    {
      q: "How long does it take to launch on Grow?",
      a: "Unmatched value for Grow plan in Canada: a custom 5 to 10 page site from C$149.99 per month with no setup fee. Most sites launch in 2 to 3 weeks from complete materials. You get a private preview within a few days and one revision round.",
    },
    {
      q: "Can I cancel Grow?",
      a: "Yes. The initial term is 6 months, then month to month with 30 days notice.",
    },
    {
      q: "Does Grow work in French?",
      a: "Yes. WEBAO works in English and French, and builds French-first commercial content for Quebec-facing businesses.",
    },
    {
      q: "What content updates are included in Grow?",
      a: "Grow includes 3 hours of content updates per month, plus maintenance, backups and security in the monthly fee. There is no CMS to learn.",
    },
    {
      q: "Can I upgrade from Grow to Scale later?",
      a: "Yes. You can move to Scale at C$349.99 per month when you need up to 20 pages, online booking, the Review Generation Engine, the Monthly Growth Report and unlimited updates. See the full price on /pricing/ and start at /start/.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Other services"
  siblings={[
    { href: "/services/launch-plan/", label: "Launch plan", note: "C$89.99/mo for a custom 1 to 5 page website, with domain, hosting, SSL, Foundational SEO and 1 hour of updates a month." },
    { href: "/services/scale-plan/", label: "Scale plan", note: "C$349.99/mo for up to 20 pages including service areas, with online booking, the Review Generation Engine and unlimited updates." },
    { href: "/services/growth-bundle/", label: "Growth Bundle", note: "C$549.99/mo: the Grow plan plus Local SEO Management and the Review Generation Engine, for Grow clients only." },
  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Grow website plan",
    description: "Grow is the most popular website plan in Canada: a custom 5 to 10 page website from C$149.99 per month, with a quote form, Google Business Profile, enhanced SEO and priority support. No setup fee.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Website plan",
  }}
/>
