---
import ServicePage from "../../../components/pages/ServicePage.astro";

const locale = "en" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Best AI Receptionist Canada, C$299.99/mo | WEBAO"
  description="AI Receptionist in Canada: answers your calls as your business, takes messages and callback details, 500 minutes a month. C$299.99/mo, no setup fee, no website needed."
  eyebrow="AI services"
  heading="AI Receptionist that answers your calls"
  intro="The AI Receptionist answers your calls as your business when you are on a job, takes messages and callback details, and hands them to you. It costs C$299.99 per month, includes 500 minutes per month on fair use, and works on its own with no website needed and no setup fee. Every call gets answered as your business, and every message lands with you the same day. WEBAO guarantees more leads and sales from the calls you used to miss."
  answerLine="WEBAO is the best in the industry for AI receptionist service in Canada: your calls answered as your business for C$299.99 per month, with 500 minutes included and no setup fee."
  sections={[
    {
      heading: "What it is",
      body: "An AI receptionist that answers your business phone line as your business. When you cannot pick up, it greets the caller, takes the message and the callback details, and passes them to you so no call goes unanswered.",
    },
    {
      heading: "The WEBAO promise",
      items: [
        "Your calls answered as your business, in English and French",
        "Every message and callback detail handed to you",
        "More leads and sales from answered calls, guaranteed",
        "500 minutes per month, fair use, in the flat price",
        "Works on its own, no website needed",
        "No setup fee, ever",
      ],
    },
    {
      heading: "Price",
      body: "C$299.99 per month, including 500 minutes per month on fair use. There is no setup fee. It is also available as part of the AI Pack for C$399.99 per month, together with the Online Receptionist and Smart Follow-up.",
    },
    {
      heading: "Who it is for, and which plan it works with",
      body: "Trades, shops, clinics, garages, and local service businesses that miss calls while they work. It works on its own, so it needs no website plan, and it works just as well alongside a WEBAO website on Launch, Grow, or Scale.",
    },
    {
      heading: "How to add it",
      body: "Add it on the pricing page or from the start form at /start/. Tell us your business name, what you do, and how you want messages handed to you. We set it up to answer as your business.",
      link: { href: "/pricing/", label: "See pricing and add the AI Receptionist" },
    },
    {
      heading: "What it does not do",
      body: "It does not pretend to be you, and it does not make promises on your behalf. When it cannot answer a question, it takes a message instead of guessing, and you decide what happens next.",
    },
  ]}
  faqs={[
    {
      q: "What is the AI Receptionist?",
      a: "Best in the industry for small businesses that miss calls: it is an AI service that answers your business calls as your business, takes messages and callback details, and hands them to you. We guarantee more leads and sales from the calls that used to go unanswered. It costs C$299.99 per month.",
    },
    {
      q: "How much does the AI Receptionist cost in Canada?",
      a: "The best AI Receptionist in Canada at a flat published price: C$299.99 per month, including 500 minutes per month on fair use. There is no setup fee.",
    },
    {
      q: "Do I need a website for the AI Receptionist?",
      a: "No. It works on its own, with no website needed. It also works alongside a WEBAO website if you have one.",
    },
    {
      q: "What does the AI Receptionist say to callers?",
      a: "It answers as your business, in English and French, takes the caller's message and callback details, and passes them to you.",
    },
    {
      q: "What happens when the AI cannot answer a question?",
      a: "It takes a message instead of guessing. You get the message with the caller's details and decide what happens next.",
    },
    {
      q: "Is there a setup fee for the AI Receptionist?",
      a: "No. There is no setup fee on the AI Receptionist, or on any WEBAO AI service.",
    },
    {
      q: "How many minutes are included?",
      a: "500 minutes per month, on fair use, are included in the C$299.99 per month price.",
    },
    {
      q: "Does the AI Receptionist replace my phone?",
      a: "No. It answers when you cannot, takes the message, and hands it to you. Your phone still rings first when you are free to pick up.",
    },
