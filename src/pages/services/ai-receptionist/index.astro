    { href: "/services/online-receptionist/", label: "Online Receptionist", note: "A receptionist on your website that answers visitors and books appointments after hours, C$149.99/mo." },
    { href: "/services/ai-pack/", label: "AI Pack", note: "All three AI services together for C$399.99/mo: AI Receptionist, Online Receptionist, and Smart Follow-up." },
    { href: "/services/smart-follow-up/", label: "Smart Follow-up", note: "Missed-call text-back and quote follow-ups until they answer, C$99.99/mo." },
  ]}
  startLabel="Start your site"
  emailLabel="Email contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI Receptionist",
    description: "AI Receptionist in Canada: answers your calls as your business, takes messages and callback details, 500 minutes a month. C$299.99/mo, no setup fee, no website needed.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "AI Receptionist",
  }}
/>
