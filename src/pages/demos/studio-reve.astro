---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Studio Reve, fictional surreal brand-experience agency, Montreal.
// Standalone art direction: surrealist night dream. Not connected to the WEBAO theme system.
// Structure: DREAMSCAPE. A non-linear fall through dream fragments at different
// depths: artworks drift, text weaves between them, no grid, no marketing sections.
const IMG = {
  sky: "/demos/studio-reve/01.jpg",
  nebula: "/demos/studio-reve/04.jpg",
  clouds: "/demos/studio-reve/02.jpg",
  mountains: "/demos/studio-reve/03.jpg",
  stars: "https://images.unsplash.com/photo-1520034475321-cbe63696469a?q=80&w=1200&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="studio-reve" locale="en" title="Studio Rêve: Surreal Brand Experiences in Montreal" description="Studio Rêve stages impossible brand experiences in Montreal. Pop-ups, installations and launches that feel like walking through a dream." ogImage="https://webao.ca/demos/studio-reve/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="rv">

  <EscapeHatch locale="en" />

  <!-- atmospheric minimal nav -->
  <header class="rv-navwrap">
    <nav class="rv-nav" aria-label="Primary">
      <a class="rv-logo" href="#top" aria-label="Studio Rêve, home"><span class="rv-moon-mini" aria-hidden="true"></span><span>Studio <em>Rêve</em></span></a>
      <div class="rv-links">
        <a href="#fall">Fall in</a>
        <a href="#wake">Wake up</a>
      </div>
    </nav>
  </header>

  <main id="top" class="rv-fall" aria-label="A falling dream">

    <!-- the descent: fragments at different depths -->
    <div class="rv-depth" id="fall" aria-hidden="false">

      <p class="rv-whisper rv-f1">you are falling asleep<span>.</span></p>

      <figure class="rv-frag rv-f2" data-depth="0.05">
        <img src={IMG.sky} alt="A night sky split by impossible light" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>dream nº 1 · the sky, unzipped</figcaption>
      </figure>

      <h1 class="rv-title rv-f3">We build <em>dreams</em><br />you can walk through</h1>

      <p class="rv-whisper rv-f4">Studio Rêve stages pop-ups, installations and launches that ignore physics and logic<span>.</span> Your brand, remembered like a beautiful strange dream<span>.</span></p>

      <figure class="rv-frag rv-f5" data-depth="0.11">
        <img src={IMG.nebula} alt="Impossible spiral staircase rising through storm clouds" loading="lazy" decoding="async" />
        <figcaption>for Maison Céleste · <strong>The Drowning Gallery.</strong> Guests walked through a corridor of floating scent orbs while the walls breathed nebula light. Nobody bought perfume. Everybody remembered it.</figcaption>
      </figure>

      <blockquote class="rv-mani rv-f6">
        Reality is a <em>rough draft</em>. We prefer the version where staircases lead to the sky, doors open onto oceans, and your logo glows like the moon.
      </blockquote>

      <figure class="rv-frag rv-f7" data-depth="0.08">
        <img src={IMG.clouds} alt="Ancient stone stairway dissolving into mist" loading="lazy" decoding="async" />
        <figcaption>for Orage Audio · <strong>The Sky Below.</strong> A listening room where the ceiling was a storm and the floor was glass. Three hundred guests lay down to hear an album. None of them checked their phones.</figcaption>
      </figure>

      <p class="rv-whisper rv-f8">deeper<span>.</span> keep falling<span>.</span></p>

      <figure class="rv-frag rv-f9" data-depth="0.13">
        <img src={IMG.mountains} alt="Wooden stairway floating among the clouds" loading="lazy" decoding="async" />
        <figcaption>for Nordalpine · <strong>Summit at Midnight.</strong> We rebuilt a mountaintop inside a warehouse, stars included. Visitors summited in evening wear and drank hot chocolate at 2,800 imaginary metres.</figcaption>
      </figure>

      <div class="rv-trio rv-f10">
        <p><em>i. Dream</em><span>We interview your team like therapists and your customers like novelists. Out of it comes the one image your brand secretly wants to be.</span></p>
        <p><em>ii. Distort</em><span>Our scenographers bend that image until physics complains. Scale, gravity and common sense are all negotiable.</span></p>
        <p><em>iii. Deliver</em><span>Engineers, lighting wizards and very patient carpenters make the impossible stand up, pass inspection, and open on time.</span></p>
      </div>

      <blockquote class="rv-note rv-f11">
        "They built us a staircase to nowhere and our launch sold out in eleven minutes. I still do not understand how the staircase stayed up."
        <cite>Léa Moreau, creative director at Orage Audio</cite>
      </blockquote>

      <p class="rv-whisper rv-f12">almost at the bottom<span>.</span> 27 dreams staged · 4 impossible awards · 0 ordinary launches<span>.</span></p>

    </div>

    <!-- waking: the commission -->
    <section class="rv-wake" id="wake" aria-label="Commission a dream">
      <div class="rv-stars-bg" aria-hidden="true"><img src={IMG.stars} alt="" loading="lazy" decoding="async" /></div>
      <div class="rv-wake-in">
        <h2 class="rv-h2">Tell us your <em>strangest</em> idea</h2>
        <p class="rv-copy">The weirder the better. We read every brief out loud at midnight, which is when the good decisions happen. Expect a reply within two sunrises.</p>
        <form class="rv-form" id="rv-form" novalidate>
          <label>Your name
            <input type="text" name="name" required placeholder="Salvador D." autocomplete="name" />
          </label>
          <label>Email address
            <input type="email" name="email" required placeholder="you@dreamco.com" autocomplete="email" />
          </label>
          <label>Describe the dream
            <textarea name="dream" rows="4" required placeholder="A door in the sky that opens onto..."></textarea>
          </label>
          <button class="rv-btn" type="submit">Send it into the night</button>
          <p class="rv-form-note" role="status" aria-live="polite"></p>
        </form>
        <address class="rv-addr">
          88, avenue Onirique · Montreal, QC H2W 1R4 · <a href="tel:+15145550166">(514) 555-0166</a> · <a href="mailto:bonjour@studioreve.example">bonjour@studioreve.example</a>
        </address>
      </div>
    </section>

  </main>

  <footer class="rv-footer">
    <p>Studio <em>Rêve</em> · © 2026 · Fictional demo. No ladders were harmed.</p>
  </footer>

  <script>
    (function () {
      // depth drift: fragments drift at different rates on scroll (skipped for reduced motion)
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var frags = document.querySelectorAll('.rv-frag[data-depth]');
      if (!reduce && frags.length) {
        var ticking = false;
        function drift() {
          frags.forEach(function (el) {
            if (!(el instanceof HTMLElement)) return;
            var d = parseFloat(el.getAttribute('data-depth') || '0');
            var r = el.getBoundingClientRect();
            var off = (r.top + r.height / 2 - window.innerHeight / 2) * d * -1;
            el.style.translate = '0px ' + off.toFixed(1) + 'px';
          });
          ticking = false;
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { window.requestAnimationFrame(drift); ticking = true; }
        }, { passive: true });
        drift();
      }

      var formEl = document.getElementById('rv-form');
      if (formEl instanceof HTMLFormElement) {
        const form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.rv-form-note');
          if (note) note.textContent = 'Received. We will read it at midnight and reply within two sunrises.';
          form.reset();
        });
      }
    })();
  </script>

<style>
  .rv {
    --rv-night: #1A1440;
    --rv-deep: #100C2E;
    --rv-gold: #E8B84B;
    --rv-cloud: #F5F1E8;
    --rv-rose: #E88AA0;
    --rv-serif: "Cormorant Garamond", Georgia, serif;
    --rv-sans: "Jost", "Avenir Next", system-ui, sans-serif;
    margin: 0;
    background: var(--rv-deep);
    color: var(--rv-cloud);
    font-family: var(--rv-sans);
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  .rv *, .rv *::before, .rv *::after { box-sizing: border-box; }
  .rv img { display: block; max-width: 100%; }
  .rv a { color: inherit; }

  .rv-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
  .rv-nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px clamp(20px, 4vw, 44px);
    background: linear-gradient(rgba(16,12,46,.75), rgba(16,12,46,0));
  }
  .rv-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 1.15rem; letter-spacing: .02em; }
  .rv-logo em { font-family: var(--rv-serif); font-style: italic; color: var(--rv-gold); }
  .rv-moon-mini { width: 22px; height: 22px; border-radius: 50%; background: var(--rv-gold); box-shadow: -6px 3px 0 1px var(--rv-deep) inset, 0 0 18px rgba(232,184,75,.5); }
  .rv-links { display: flex; gap: 26px; }
  .rv-links a { text-decoration: none; font-size: 0.95rem; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  .rv-links a:hover { opacity: 1; color: var(--rv-gold); }

  /* the fall */
  .rv-fall { position: relative; padding-top: 22vh; }
  .rv-depth { position: relative; max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 60px) 12vh; }

  .rv-whisper {
    font-family: var(--rv-serif); font-style: italic; font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    color: rgba(245,241,232,.62); margin: 0;
  }
  .rv-whisper span { color: var(--rv-gold); }

  .rv-f1 { text-align: center; margin-bottom: 16vh; }
  .rv-title {
    font-family: var(--rv-serif); font-weight: 500;
    font-size: clamp(2.8rem, 8vw, 6.2rem); line-height: 1.02;
    margin: 14vh 0 6vh; text-align: center;
  }
  .rv-title em { color: var(--rv-gold); font-style: italic; }

  .rv-frag { margin: 0; position: relative; will-change: translate; }
  .rv-frag img {
    width: 100%; border-radius: 4px;
    box-shadow: 0 40px 120px rgba(0,0,0,.55), 0 0 0 1px rgba(232,184,75,.14);
  }
  .rv-frag figcaption {
    margin-top: 14px; font-size: 0.95rem; line-height: 1.6; color: rgba(245,241,232,.72); max-width: 52ch;
  }
  .rv-frag figcaption strong { color: var(--rv-cloud); font-weight: 500; }
  .rv-f2 { width: min(620px, 88%); margin: 0 auto 0 2%; transform: rotate(-1.6deg); }
  .rv-f5 { width: min(560px, 84%); margin: 16vh 4% 0 auto; transform: rotate(1.2deg); }
  .rv-f7 { width: min(600px, 86%); margin: 16vh auto 0 6%; transform: rotate(-0.8deg); }
  .rv-f9 { width: min(540px, 82%); margin: 16vh 8% 0 auto; transform: rotate(1.8deg); }

  .rv-f4 { max-width: 44ch; margin: 0 auto; text-align: center; }
  .rv-f8 { text-align: right; margin: 18vh 6% 0 0; }
  .rv-f12 { text-align: center; margin: 16vh 0 0; }

  .rv-mani {
    font-family: var(--rv-serif); font-style: italic;
    font-size: clamp(1.7rem, 4.4vw, 3rem); line-height: 1.3;
    max-width: 22ch; margin: 18vh auto; text-align: center; padding: 0;
  }
  .rv-mani em { color: var(--rv-gold); }

  .rv-trio {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 4vw, 48px);
    margin: 20vh 0; padding: 0 2%;
  }
  .rv-trio p { margin: 0; }
  .rv-trio p:nth-child(2) { margin-top: 48px; }
  .rv-trio p:nth-child(3) { margin-top: 96px; }
  .rv-trio em { display: block; font-family: var(--rv-serif); font-style: italic; font-size: 1.6rem; color: var(--rv-gold); margin-bottom: 10px; }
  .rv-trio span { font-size: 0.98rem; line-height: 1.7; color: rgba(245,241,232,.75); }

  .rv-note {
    max-width: 520px; margin: 18vh auto 0; padding: 30px 34px;
    background: rgba(245,241,232,.05); border: 1px solid rgba(232,184,75,.25); border-radius: 4px;
    font-family: var(--rv-serif); font-style: italic; font-size: 1.25rem; line-height: 1.55;
    transform: rotate(-1deg);
  }
  .rv-note cite { display: block; margin-top: 14px; font-family: var(--rv-sans); font-style: normal; font-size: 0.85rem; letter-spacing: .08em; color: rgba(245,241,232,.6); }

  /* waking */
  .rv-wake { position: relative; padding: clamp(80px, 12vw, 160px) 0; overflow: clip; background: var(--rv-night); }
  .rv-stars-bg { position: absolute; inset: 0; opacity: .35; }
  .rv-stars-bg img { width: 100%; height: 100%; object-fit: cover; }
  .rv-wake-in { position: relative; max-width: 640px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 40px); text-align: center; }
  .rv-h2 { font-family: var(--rv-serif); font-weight: 500; font-size: clamp(2.2rem, 5.5vw, 3.6rem); margin: 0 0 14px; }
  .rv-h2 em { color: var(--rv-gold); }
  .rv-copy { color: rgba(245,241,232,.75); font-size: 1.05rem; line-height: 1.7; margin: 0 0 34px; }
  .rv-form { text-align: left; background: rgba(16,12,46,.6); border: 1px solid rgba(232,184,75,.22); border-radius: 6px; padding: clamp(24px, 5vw, 40px); backdrop-filter: blur(8px); }
  .rv-form label { display: block; font-size: 0.85rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(245,241,232,.65); margin-bottom: 18px; }
  .rv-form input, .rv-form textarea {
    display: block; width: 100%; margin-top: 8px; padding: 13px 15px;
    background: rgba(245,241,232,.06); border: 1px solid rgba(245,241,232,.18); border-radius: 4px;
    color: var(--rv-cloud); font: inherit; font-size: 1rem; letter-spacing: 0; text-transform: none;
  }
  .rv-form input:focus, .rv-form textarea:focus { outline: 1px solid var(--rv-gold); border-color: var(--rv-gold); }
  .rv-btn {
    display: inline-block; padding: 15px 34px; border: 1px solid var(--rv-gold); border-radius: 999px;
    background: transparent; color: var(--rv-gold); font: inherit; font-size: 0.95rem; letter-spacing: .14em; text-transform: uppercase;
    cursor: pointer; transition: background .25s ease, color .25s ease;
  }
  .rv-btn:hover { background: var(--rv-gold); color: var(--rv-deep); }
  .rv-form-note { margin: 16px 0 0; font-family: var(--rv-serif); font-style: italic; color: var(--rv-gold); }
  .rv-addr { margin-top: 34px; font-style: normal; font-size: 0.92rem; color: rgba(245,241,232,.6); line-height: 1.8; }
  .rv-addr a { color: var(--rv-gold); }

  .rv-footer { text-align: center; padding: 40px 20px 110px; color: rgba(245,241,232,.45); font-size: 0.9rem; letter-spacing: .06em; }
  .rv-footer em { font-family: var(--rv-serif); color: var(--rv-gold); }

  @media (max-width: 760px) {
    .rv-trio { grid-template-columns: 1fr; margin: 14vh 0; }
    .rv-trio p:nth-child(2), .rv-trio p:nth-child(3) { margin-top: 0; }
    .rv-f2, .rv-f5, .rv-f7, .rv-f9 { width: 100%; margin-left: 0; margin-right: 0; transform: none; }
    .rv-frag { margin-top: 12vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-frag { transform: none !important; }
    .rv-btn { transition: none; }
  }
</style>
</body>
</html>
