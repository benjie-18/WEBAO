    .dg-dispatch-grid { max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) clamp(48px, 8vh, 96px);
      display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 60px); align-items: start; }
    .dg-form { display: grid; gap: 16px; background: var(--dg-bg); border: 1px solid var(--dg-line); border-radius: 14px; padding: clamp(22px, 3vw, 34px); }
    .dg-form label { display: grid; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; color: var(--dg-dim); }
    .dg-form input, .dg-form select, .dg-form textarea { font-family: var(--dg-mono); font-size: 14.5px; color: var(--dg-text);
      background: var(--dg-panel-2); border: 1px solid var(--dg-line); border-radius: 8px; padding: 14px; width: 100%; }
    .dg-form input:focus, .dg-form select:focus, .dg-form textarea:focus { outline: 2px solid var(--dg-blue); outline-offset: 1px; }
    .dg-form-note { margin: 0; font-size: 13px; color: var(--dg-green); font-weight: 700; }
    .dg-form-note:empty { display: none; }
    .dg-bignum { display: inline-block; font-family: var(--dg-disp); font-weight: 700; text-decoration: none;
      font-size: clamp(3rem, 7vw, 5.4rem); line-height: 1; letter-spacing: -0.02em; margin: 10px 0 20px; }
    .dg-bignum:hover { color: var(--dg-blue); }
    .dg-fine { font-size: 12.5px; line-height: 2; color: var(--dg-dim); margin: 22px 0 0; }
    .dg-foot { border-top: 1px solid var(--dg-line); text-align: center; padding: 34px 20px; font-size: 11.5px; letter-spacing: 0.1em; line-height: 2; color: var(--dg-dim); }
    .dg-foot p { margin: 0; }
    @media (max-width: 1000px) {
      .dg-panel { grid-template-columns: 1fr; }
      .dg-grid { grid-template-columns: 1fr 1fr; }
      .dg-unit { grid-template-columns: 1fr 1fr; }
      .dg-unit > div { grid-column: 1 / -1; order: -1; }
      .dg-dispatch-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .dg-grid { grid-template-columns: 1fr; }
      .dg-meters { grid-template-columns: 1fr 1fr; }
      .dg-stats { grid-template-columns: 1fr 1fr; }
      .dg-events li { grid-template-columns: 1fr; gap: 6px; }
      .dg-unit { grid-template-columns: 1fr; }
      .dg-status { display: none; }
      .dg-brand span { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .dg-ticker p { animation: none; }
      .dg-needle { transition: none; }
      .dg-mod, .dg-btn, .dg-stepper button { transition: none; }
    }
  </style>
