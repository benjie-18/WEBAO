    .dg-events li:last-child { border-bottom: 0; }
    .dg-events li:nth-child(even) { background: var(--dg-panel-2); }
    .dg-ts { color: var(--dg-dim); font-size: 11.5px; }
    .dg-ev { line-height: 1.65; }
    .dg-tag { font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; border: 1px solid var(--dg-line); border-radius: 6px; padding: 5px 10px; white-space: nowrap; }
    .dg-tag.dg-ok { color: var(--dg-green); border-color: rgba(61,255,136,0.4); }
    .dg-tag.dg-warn { color: var(--dg-amber); border-color: rgba(255,184,77,0.4); }
    .dg-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .dg-stats div { background: var(--dg-panel); border: 1px solid var(--dg-line); border-radius: 14px; padding: 24px 20px; display: grid; gap: 8px; }
    .dg-stats strong { font-family: var(--dg-disp); font-size: 34px; font-weight: 700; }
    .dg-stats span { font-size: 11px; letter-spacing: 0.18em; color: var(--dg-dim); }
    .dg-unit { max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) clamp(48px, 8vh, 96px);
      display: grid; grid-template-columns: 300px 1fr 300px; gap: clamp(20px, 3vw, 36px); align-items: center; }
    .dg-unit img { width: 100%; height: 380px; object-fit: cover; border-radius: 14px; border: 1px solid var(--dg-line); filter: saturate(0.7) brightness(0.88); }
    .dg-speclist { list-style: none; margin: 26px 0 0; padding: 0; display: grid; border: 1px solid var(--dg-line); border-radius: 12px; overflow: clip; }
    .dg-speclist li { display: grid; grid-template-columns: 90px 1fr; gap: 14px; padding: 13px 18px; font-size: 13px; background: var(--dg-panel); border-bottom: 1px solid var(--dg-line); }
    .dg-speclist li:last-child { border-bottom: 0; }
    .dg-speclist span { color: var(--dg-blue); font-size: 11px; letter-spacing: 0.18em; font-weight: 700; }
    .dg-dispatch { border-top: 1px solid var(--dg-line); background: var(--dg-panel); padding-top: clamp(48px, 8vh, 96px); }
