    .dg-h2 { font-family: var(--dg-disp); font-weight: 700; font-size: clamp(1.9rem, 4vw, 3rem); letter-spacing: -0.02em; margin: 0 0 34px; }
    .dg-h2 span { color: var(--dg-dim); font-weight: 500; }
    .dg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .dg-mod { background: var(--dg-panel); border: 1px solid var(--dg-line); border-radius: 14px; padding: 26px 24px;
