    .dg-mod h3 { margin: 0; font-family: var(--dg-disp); font-size: 20px; font-weight: 700; }
    .dg-mod p { margin: 0; font-size: 13px; line-height: 1.7; color: var(--dg-dim); }
    .dg-spec { color: var(--dg-blue); font-size: 11px; letter-spacing: 0.12em; font-weight: 700; }
    .dg-log { max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) clamp(48px, 8vh, 96px); }
    .dg-events { list-style: none; margin: 0 0 30px; padding: 0; border: 1px solid var(--dg-line); border-radius: 14px; overflow: clip; }
    .dg-events li { display: grid; grid-template-columns: 170px 1fr auto; gap: 18px; align-items: baseline;
