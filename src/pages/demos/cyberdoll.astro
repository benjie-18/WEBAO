---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: CYBERDOLL, fictional Y2K fashion label, Los Angeles.
// Rebuilt as a LOOKBOOK ZINE: editorial spreads, sticker prices, tear-out order form.
// Standalone art direction. Chrome gradients, sparkles, glossy bubbles.
// Not connected to the WEBAO theme system.
const IMG = {
  hero: "/demos/cyberdoll/01.jpg",
  cargo: "https://images.unsplash.com/photo-1552902865-b72c031ac5ea?q=80&w=800&auto=format&fit=crop",
  tee: "/demos/cyberdoll/02.jpg",
  puffa: "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=800&auto=format&fit=crop",
  sneakers: "https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?q=80&w=800&auto=format&fit=crop",
  look1: "/demos/cyberdoll/03.jpg",
  look2: "/demos/cyberdoll/04.jpg",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CYBERDOLL: Y2K Fashion, Back 4Ever</title>
  <meta name="description" content="CYBERDOLL: fictional Y2K fashion label. Glitter cargos, butterfly tops, chrome everything. New drops every Friday." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="cd">

  <main id="top">
    <!-- ZINE COVER -->
    <section class="cd-cover">
      <div class="cd-stars" aria-hidden="true">
        <svg class="cd-spark s1" viewBox="0 0 24 24"><path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"/></svg>
        <svg class="cd-spark s2" viewBox="0 0 24 24"><path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"/></svg>
        <svg class="cd-spark s3" viewBox="0 0 24 24"><path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"/></svg>
      </div>
      <p class="cd-issue"><span>ISSUE #042</span><span aria-hidden="true">★</span><span>FRIDAY DROP</span><span aria-hidden="true">★</span><span>EST. 2003</span></p>
      <h1 class="cd-h1 cd-chrome">CYBER<br />DOLL</h1>
      <p class="cd-cover-tag">Y2K fashion for the new millennium, part two.</p>
      <figure class="cd-cover-photo">
        <img src={IMG.hero} alt="Chrome futuristic editorial look" loading="eager" fetchpriority="high" />
        <span class="cd-sticker cd-sticker-a" aria-hidden="true">NEW!!</span>
        <span class="cd-sticker cd-sticker-b" aria-hidden="true">BACK<br />4EVER</span>
      </figure>
      <p class="cd-cover-foot">Glitter, chrome, and butterfly clips · Free shipping over $75 · As seen in your dreams (and your old diary)</p>
      <a class="cd-scroll-cue" href="#spread-1">Flip through ↓</a>
    </section>

    <!-- SPREAD 1: CARGOS -->
    <article class="cd-spread" id="spread-1">
      <figure class="cd-spread-photo">
        <img src={IMG.cargo} alt="Model wearing olive cargo pants" loading="lazy" />
        <span class="cd-price" aria-hidden="true">$89</span>
        <span class="cd-sticker cd-sticker-c" aria-hidden="true">NEW!!</span>
      </figure>
      <div class="cd-spread-copy">
        <p class="cd-spread-no">p. 02</p>
        <h2>Glitterbomb Cargos</h2>
        <p>Low rise, six pockets, maximum sparkle. Your flip phone called, it approves.</p>
        <a class="cd-btn" href="#order">Tear out &amp; order</a>
      </div>
    </article>

    <!-- SPREAD 2: Y3K SET -->
    <article class="cd-spread cd-spread-flip" id="spread-2">
      <figure class="cd-spread-photo">
        <img src={IMG.tee} alt="Models in metallic Y3K outfits under chrome balloon letters" loading="lazy" />
        <span class="cd-price" aria-hidden="true">$45</span>
        <span class="cd-sticker cd-sticker-d" aria-hidden="true">NEW!!</span>
      </figure>
      <div class="cd-spread-copy">
        <p class="cd-spread-no">p. 03</p>
        <h2>Y3K Metallic Set</h2>
        <p>Liquid-metal separates straight off the Y3K runway. Shine responsibly.</p>
        <a class="cd-btn" href="#order">Tear out &amp; order</a>
      </div>
    </article>

    <!-- SPREAD 3: PUFFA -->
    <article class="cd-spread" id="spread-3">
      <figure class="cd-spread-photo">
        <img src={IMG.puffa} alt="Model wearing a silver puffer jacket" loading="lazy" />
        <span class="cd-price" aria-hidden="true">$149</span>
        <span class="cd-sticker cd-sticker-e" aria-hidden="true">HOT!!</span>
      </figure>
      <div class="cd-spread-copy">
        <p class="cd-spread-no">p. 04</p>
        <h2>Silver Puffa Jacket</h2>
        <p>Chrome-plated coziness. Reflects flash photography and bad vibes alike.</p>
        <a class="cd-btn" href="#order">Tear out &amp; order</a>
      </div>
    </article>

    <!-- SPREAD 4: SNEAKERS -->
    <article class="cd-spread cd-spread-flip" id="spread-4">
      <figure class="cd-spread-photo">
        <img src={IMG.sneakers} alt="Star platform sneakers" loading="lazy" />
        <span class="cd-price" aria-hidden="true">$120</span>
      </figure>
      <div class="cd-spread-copy">
        <p class="cd-spread-no">p. 05</p>
        <h2>Star Platform Sneakers</h2>
        <p>Four inches of pure attitude. Warning: may cause spontaneous dance breaks.</p>
        <a class="cd-btn" href="#order">Tear out &amp; order</a>
      </div>
    </article>

    <!-- EDITOR'S LETTER -->
    <section class="cd-letter">
      <div class="cd-wrap">
        <p class="cd-spread-no">p. 06 · editor's letter</p>
        <h2 class="cd-h2">The Doll Code</h2>
        <div class="cd-letter-cols">
          <p>Low rise is a lifestyle, not a trend. Glitter is a neutral. Chrome is a personality. Your flip phone deserves a matching outfit. Dress like the future we were promised in 1999.</p>
          <p>Every Friday we print a new issue and drop a new batch. When it's gone, it's gone, bestie. This zine is your catalog, your lookbook, and your permission slip.</p>
        </div>
        <p class="cd-sign">xoxo, the Dolls</p>
      </div>
    </section>

    <!-- LOOKBOOK PAGES -->
    <section class="cd-lookbook">
      <div class="cd-wrap">
        <p class="cd-spread-no">p. 07–09 · street snaps</p>
        <h2 class="cd-h2">Spotted on<br />Dollfam</h2>
        <div class="cd-look-grid">
          <figure class="cd-polaroid">
            <img src={IMG.look1} alt="Pink Y2K flatlay with velour hoodie, denim mini skirt and digicam" loading="lazy" />
            <figcaption>fit check #042: downtown diva</figcaption>
          </figure>
          <figure class="cd-polaroid cd-polaroid-tilt">
            <img src={IMG.look2} alt="Pink and white Y2K flatlay with bedazzled flip phone and baguette bag" loading="lazy" />
            <figcaption>fit check #043: mall rat couture</figcaption>
          </figure>
          <figure class="cd-polaroid">
            <img src={IMG.hero} alt="Chrome futuristic editorial look" loading="lazy" />
            <figcaption>fit check #044: main character</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- TEAR-OUT ORDER FORM -->
    <section class="cd-order" id="order">
      <div class="cd-wrap">
        <form class="cd-tear" id="cd-order-form" novalidate>
          <p class="cd-tear-cut" aria-hidden="true">✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -</p>
          <h2 class="cd-h2">Tear-Out<br />Order Form</h2>
          <p class="cd-tear-sub">Check what you want, we will email your total. Friday drop ships Monday.</p>
          <fieldset class="cd-tear-items">
            <legend>Friday drop #042</legend>
            <label><input type="checkbox" name="item" value="cargos" /><span>Glitterbomb Cargos</span><strong>$89</strong></label>
            <label><input type="checkbox" name="item" value="y3k" /><span>Y3K Metallic Set</span><strong>$45</strong></label>
            <label><input type="checkbox" name="item" value="puffa" /><span>Silver Puffa Jacket</span><strong>$149</strong></label>
            <label><input type="checkbox" name="item" value="sneakers" /><span>Star Platform Sneakers</span><strong>$120</strong></label>
          </fieldset>
          <div class="cd-tear-fields">
            <label>Your name<input type="text" name="name" required placeholder="Dollface" autocomplete="name" /></label>
            <label>Email<input type="email" name="email" required placeholder="cutie2003@example.com" autocomplete="email" /></label>
          </div>
          <button class="cd-btn cd-btn-big" type="submit">Send my order</button>
          <p class="cd-form-note" role="status" aria-live="polite"></p>
          <p class="cd-tear-fine">2003 Glitter Avenue, Los Angeles, CA 90014 · (213) 555-2003 · hello@cyberdoll.shop · @cyberdoll.official everywhere</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="cd-footer">
    <p class="cd-footer-giant cd-chrome" aria-hidden="true">CYBERDOLL</p>
    <p>© 2026 CYBERDOLL. Fictional demo. Made with glitter and dial-up.</p>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo: order form never submits anywhere
    (function () {
      var form = document.getElementById('cd-order-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.cd-form-note');
        var checked = form?.querySelectorAll('input[name="item"]:checked').length || 0;
        if (note) note.textContent = checked
          ? 'Order torn out! We will email your total for ' + checked + (checked === 1 ? ' item' : ' items') + '. XOXO'
          : 'Check at least one treasure first, doll.';
        if (checked) form?.reset();
      });
    })();
  </script>

  <style>
    .cd {
      --cd-pink: #FF6EC7;
      --cd-lav: #B28DFF;
      --cd-blue: #87CEFA;
      --cd-black: #0B0B10;
      --cd-white: #FFF7FB;
      --cd-display: "Audiowide", "Arial Black", cursive;
      --cd-body: "Quicksand", system-ui, sans-serif;
      margin: 0;
      background: var(--cd-black);
      color: var(--cd-white);
      font-family: var(--cd-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .cd *, .cd *::before, .cd *::after { box-sizing: border-box; }
    .cd img { display: block; max-width: 100%; }
    .cd-wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .cd-h2 { font-family: var(--cd-display); font-size: clamp(2.2rem, 6vw, 4.2rem); margin: 0 0 14px; letter-spacing: 0.04em; }

    .cd-chrome {
      background: linear-gradient(180deg, #ffffff 0%, #e9f5ff 16%, #87CEFA 30%, #ffffff 42%, #ffffff 50%, #B28DFF 58%, #FF6EC7 72%, #ffd9ef 84%, #ffffff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .cd-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--cd-body); font-weight: 700; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase;
      background: linear-gradient(180deg, #ff9ed8, var(--cd-pink) 55%, #e14fa4);
      color: #fff; text-decoration: none; cursor: pointer; border: none;
      padding: 16px 34px; border-radius: 999px;
      box-shadow: 0 4px 0 #a8327c, 0 10px 24px rgba(255, 110, 199, 0.45), inset 0 2px 2px rgba(255, 255, 255, 0.55);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .cd-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 0 #a8327c, 0 14px 30px rgba(255, 110, 199, 0.55), inset 0 2px 2px rgba(255, 255, 255, 0.55); }
    .cd-btn-big { width: 100%; font-size: 17px; padding: 20px; }

    .cd-spread-no { font-weight: 700; font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--cd-pink); margin: 0 0 16px; }

    /* stickers + prices */
    .cd-sticker {
      position: absolute; z-index: 3; font-family: var(--cd-display); color: #fff;
      display: flex; align-items: center; justify-content: center; text-align: center;
      border-radius: 50%; box-shadow: 0 8px 22px rgba(255,110,199,0.55), inset 0 3px 6px rgba(255,255,255,0.5);
    }
    .cd-price {
      position: absolute; z-index: 3; font-family: var(--cd-display); font-size: clamp(1.6rem, 4vw, 2.6rem); color: #0B0B10;
      background: #FFE45E; padding: 14px 22px; border-radius: 999px; transform: rotate(-8deg);
      box-shadow: 0 10px 26px rgba(0,0,0,0.4); border: 3px solid #0B0B10;
    }

    /* cover */
    .cd-cover { position: relative; min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; overflow: hidden; padding: 60px 20px 40px;
      background: radial-gradient(ellipse 70% 50% at 20% 10%, rgba(255,110,199,0.22), transparent 60%),
                  radial-gradient(ellipse 60% 45% at 85% 25%, rgba(178,141,255,0.25), transparent 60%),
                  var(--cd-black);
    }
    .cd-stars { position: absolute; inset: 0; pointer-events: none; }
    .cd-spark { position: absolute; fill: #fff; filter: drop-shadow(0 0 8px var(--cd-pink)); animation: cd-twinkle 3.2s ease-in-out infinite; }
    .cd-spark.s1 { width: 34px; top: 14%; left: 8%; }
    .cd-spark.s2 { width: 22px; top: 24%; right: 10%; animation-delay: 0.8s; fill: var(--cd-blue); }
    .cd-spark.s3 { width: 28px; top: 68%; left: 12%; animation-delay: 1.6s; fill: var(--cd-lav); }
    @keyframes cd-twinkle { 0%, 100% { transform: scale(0.6) rotate(0deg); opacity: 0.5; } 50% { transform: scale(1.15) rotate(20deg); opacity: 1; } }
    .cd-issue { display: flex; gap: 14px; align-items: center; font-weight: 700; font-size: 13px; letter-spacing: 0.34em; color: var(--cd-blue); margin: 0 0 20px; }
    .cd-h1 { font-family: var(--cd-display); font-size: clamp(3.6rem, 14vw, 11rem); line-height: 0.92; margin: 0 0 16px; letter-spacing: 0.02em;
      filter: drop-shadow(0 6px 0 rgba(178, 141, 255, 0.35)) drop-shadow(0 14px 34px rgba(255, 110, 199, 0.35)); }
    .cd-cover-tag { font-size: 18px; color: #e8dcf0; margin: 0 0 34px; font-weight: 500; }
    .cd-cover-photo { position: relative; margin: 0; transform: rotate(-2deg); }
    .cd-cover-photo img { width: min(420px, 78vw); height: min(520px, 90vw); object-fit: cover; filter: saturate(1.25) contrast(1.05);
      border: 12px solid #fff; border-bottom-width: 52px; box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
    .cd-sticker-a { width: 96px; height: 96px; font-size: 19px; top: -24px; right: -18px; transform: rotate(12deg);
      background: radial-gradient(circle at 35% 30%, #ff9ed8, var(--cd-pink) 65%, #d63f9c); }
    .cd-sticker-b { width: 110px; height: 110px; font-size: 15px; bottom: 60px; left: -30px; transform: rotate(-10deg); line-height: 1.2;
      background: radial-gradient(circle at 35% 30%, #cdb4ff, var(--cd-lav) 65%, #7f5fe0); }
    .cd-cover-foot { margin: 30px 0 26px; font-size: 14px; letter-spacing: 0.12em; color: #9b8ba3; max-width: 52ch; }
    .cd-scroll-cue { color: var(--cd-pink); font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; font-size: 13px; text-decoration: none; }

    /* spreads */
    .cd-spread { display: grid; grid-template-columns: 1.2fr 0.8fr; min-height: 92vh; align-items: stretch; border-top: 2px solid rgba(255,110,199,0.4); }
    .cd-spread-flip { direction: rtl; }
    .cd-spread-flip > * { direction: ltr; }
    .cd-spread-photo { position: relative; margin: 0; overflow: hidden; min-height: 60vh; }
    .cd-spread-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.25) contrast(1.05); }
    .cd-spread-photo .cd-price { bottom: 34px; left: 30px; }
    .cd-sticker-c { width: 88px; height: 88px; font-size: 17px; top: 26px; right: 26px; transform: rotate(10deg);
      background: radial-gradient(circle at 35% 30%, #ff9ed8, var(--cd-pink) 65%, #d63f9c); }
    .cd-sticker-d { width: 88px; height: 88px; font-size: 17px; top: 26px; left: 26px; transform: rotate(-12deg);
      background: radial-gradient(circle at 35% 30%, #aee3ff, var(--cd-blue) 65%, #5aa9e6); }
    .cd-sticker-e { width: 88px; height: 88px; font-size: 17px; top: 26px; right: 26px; transform: rotate(8deg);
      background: radial-gradient(circle at 35% 30%, #cdb4ff, var(--cd-lav) 65%, #7f5fe0); }
    .cd-spread-copy { display: flex; flex-direction: column; justify-content: center; gap: 18px; padding: clamp(40px, 6vw, 90px); background: #14141f; }
    .cd-spread-copy h2 { font-family: var(--cd-display); font-size: clamp(1.9rem, 4.5vw, 3.2rem); margin: 0; letter-spacing: 0.03em; }
    .cd-spread-copy p { margin: 0; font-size: 17px; line-height: 1.65; color: #cfc4d4; max-width: 36ch; }
    .cd-spread-copy .cd-btn { align-self: flex-start; margin-top: 8px; }

    /* editor's letter */
    .cd-letter { background: linear-gradient(180deg, #ff9ed8, var(--cd-pink) 60%, #f252b0); padding: clamp(70px, 9vw, 120px) 0; color: #fff; }
    .cd-letter .cd-spread-no { color: #7a1e52; }
    .cd-letter .cd-h2 { color: #0B0B10; }
    .cd-letter-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin: 26px 0; }
    .cd-letter-cols p { font-size: 17px; line-height: 1.7; margin: 0; font-weight: 500; }
    .cd-sign { font-family: var(--cd-display); font-size: 22px; margin: 0; }

    /* lookbook */
    .cd-lookbook { padding: clamp(70px, 9vw, 120px) 0; }
    .cd-look-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 34px; }
    .cd-polaroid { background: #fff; padding: 14px 14px 0; margin: 0; transform: rotate(-2deg); box-shadow: 0 18px 40px rgba(0,0,0,0.45); position: relative; }
    .cd-polaroid:nth-child(2) { transform: rotate(2.5deg); }
    .cd-polaroid:nth-child(3) { transform: rotate(-1deg); }
    .cd-polaroid::before { content: ""; position: absolute; top: -14px; left: 50%; transform: translateX(-50%) rotate(-4deg);
      width: 110px; height: 30px; background: rgba(135, 206, 250, 0.75); box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
    .cd-polaroid img { width: 100%; height: 340px; object-fit: cover; filter: saturate(1.2); }
    .cd-polaroid figcaption { font-family: var(--cd-display); font-size: 14px; color: var(--cd-black); padding: 16px 6px 20px; letter-spacing: 0.04em; }

    /* tear-out order form */
    .cd-order { padding: clamp(70px, 9vw, 120px) 0; background: #14141f; border-top: 2px solid rgba(255,110,199,0.4); }
    .cd-tear { background: #FFF7FB; color: #0B0B10; border-radius: 6px; padding: clamp(30px, 5vw, 60px); max-width: 720px; margin: 0 auto;
      box-shadow: 0 30px 80px rgba(0,0,0,0.5); }
    .cd-tear-cut { margin: 0 0 26px; letter-spacing: 0.3em; color: #a8327c; font-size: 13px; white-space: nowrap; overflow: hidden; }
    .cd-tear .cd-h2 { color: #0B0B10; }
    .cd-tear-sub { font-size: 16px; color: #6b5560; margin: 0 0 30px; }
    .cd-tear-items { border: 2px dashed #a8327c; border-radius: 12px; padding: 22px; margin: 0 0 26px; display: grid; gap: 4px; }
    .cd-tear-items legend { font-family: var(--cd-display); font-size: 14px; letter-spacing: 0.1em; padding: 0 12px; color: #a8327c; }
    .cd-tear-items label { display: flex; align-items: center; gap: 14px; padding: 12px 6px; font-weight: 600; font-size: 16px; cursor: pointer; border-bottom: 1px solid #f3d9ea; }
    .cd-tear-items label:last-child { border-bottom: 0; }
    .cd-tear-items input { width: 22px; height: 22px; accent-color: var(--cd-pink); flex: none; }
    .cd-tear-items strong { margin-left: auto; font-family: var(--cd-display); color: #c2267f; }
    .cd-tear-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    .cd-tear-fields label { display: grid; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #6b5560; }
    .cd-tear-fields input { font-family: var(--cd-body); font-size: 16px; font-weight: 600; border: 2px solid #0B0B10; border-radius: 12px; padding: 14px 16px; width: 100%; background: #fff; }
    .cd-tear-fields input:focus { outline: 3px solid var(--cd-pink); outline-offset: 1px; }
    .cd-form-note { margin: 18px 0 0; font-weight: 700; font-size: 16px; color: #c2267f; text-align: center; }
    .cd-form-note:empty { display: none; }
    .cd-tear-fine { margin: 26px 0 0; font-size: 13px; color: #9b8ba3; text-align: center; line-height: 1.7; }

    /* footer */
    .cd-footer { padding: 70px 20px 90px; text-align: center; border-top: 2px solid rgba(255,110,199,0.4); }
    .cd-footer-giant { font-family: var(--cd-display); font-size: clamp(3rem, 14vw, 11rem); line-height: 1; margin: 0 0 24px; }
    .cd-footer p:last-child { color: #9b8ba3; font-size: 14px; margin: 0; }

    @media (max-width: 860px) {
      .cd-spread { grid-template-columns: 1fr; min-height: 0; }
      .cd-spread-photo { min-height: 52vh; }
      .cd-letter-cols { grid-template-columns: 1fr; }
      .cd-look-grid { grid-template-columns: 1fr; max-width: 440px; margin-inline: auto; }
      .cd-tear-fields { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cd-spark { animation: none; }
      .cd-btn { transition: none; }
    }
  </style>
</body>
</html>
