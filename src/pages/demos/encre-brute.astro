---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Encre Brute, fictional tattoo studio, Montréal QC.
// Rebuilt as a FLASH WALL: the homepage IS the flash sheet. Pick a design, claim it.
// Standalone art direction. Neo-brutalism. Not connected to the WEBAO theme system.
const IMG = {
  hero: "https://images.unsplash.com/photo-1568515045052-f9a854d70bfd?q=80&w=1600&auto=format&fit=crop",
  a1: "/demos/encre-brute/01.jpg",
  a2: "/demos/encre-brute/02.jpg",
  a3: "https://images.unsplash.com/photo-1565058379802-bbe93b2f703a?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="encre-brute" locale="en" title="Encre Brute: Tattoo Studio in Montréal" description="Encre Brute: a raw tattoo studio in Montréal. Fine line, blackwork, cover-ups and flash. Four resident artists. Walk-ins welcome." ogImage="https://webao.ca/demos/encre-brute/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet" />
</head>
<body class="eb">

  <header class="eb-topbar">
    <a class="eb-wordmark" href="#top" aria-label="Encre Brute, home">ENCRE BRUTE</a>
    <p class="eb-topbar-tag">MONTRÉAL · EST. 2019</p>
    <a class="eb-btn eb-btn-red" href="#claim">CLAIM FLASH</a>
  </header>

  <main id="top">
    <!-- THE FLASH WALL: the homepage IS the sheet -->
    <section class="eb-wall" aria-label="Flash designs">
      <div class="eb-wall-head">
        <h1 class="eb-h1">PICK ONE.<br />WE INK IT.</h1>
        <p class="eb-wall-sub">Fixed price, fixed size. First come, first served. Tap a design to claim it.</p>
      </div>
      <div class="eb-wall-grid">

        <button type="button" class="eb-flash-btn" data-flash="SERPENT" data-price="$120">
<svg viewBox="0 0 300 260" class="eb-flash-art" role="img" aria-label="Flash design: serpent">
  <rect width="300" height="260" fill="#F4F1EA"/>
  <path d="M230 200 l 14 -30 l 12 28 l 30 -8 l -18 24 l 26 16 l -32 4 l 6 30 l -24 -18 l -20 22 l 2 -32 l -30 2 l 22 -22 z" fill="none" stroke="#111111" stroke-width="5" stroke-linejoin="round"/>
  <path d="M60 205 C 40 155, 95 135, 112 102 C 129 69, 100 52, 130 32 C 150 18, 180 24, 186 42" fill="none" stroke="#111111" stroke-width="17" stroke-linecap="round"/>
  <path d="M186 42 l 28 -8 l -15 24 z" fill="#111111"/>
  <circle cx="197" cy="41" r="4.5" fill="#F4F1EA"/>
  <path d="M214 34 l 18 -9 m -18 9 l -5 11 m 5 -11 l 7 7" stroke="#C80000" stroke-width="5" fill="none" stroke-linecap="round"/>
  <path d="M68 176 l 20 7 M78 150 l 20 5 M93 124 l 18 3 M114 98 l 15 -2" stroke="#111111" stroke-width="5" stroke-linecap="round"/>
</svg><figcaption><span>SERPENT</span><strong>$120</strong></figcaption>
          <span class="eb-claim">CLAIM →</span>
        </button>

        <button type="button" class="eb-flash-btn" data-flash="MOTH" data-price="$90">
<svg viewBox="0 0 300 260" class="eb-flash-art" role="img" aria-label="Flash design: moth">
  <rect width="300" height="260" fill="#F4F1EA"/>
  <path d="M150 92 C 100 40, 38 52, 54 112 C 64 152, 110 152, 136 130 Z" fill="#111111"/>
  <path d="M150 92 C 200 40, 262 52, 246 112 C 236 152, 190 152, 164 130 Z" fill="#111111"/>
  <path d="M140 142 C 110 162, 100 202, 130 212 C 150 217, 150 182, 148 156 Z" fill="#111111"/>
  <path d="M160 142 C 190 162, 200 202, 170 212 C 150 217, 150 182, 152 156 Z" fill="#111111"/>
  <rect x="141" y="82" width="18" height="112" rx="9" fill="#111111"/>
  <path d="M144 84 C 130 62, 114 56, 104 46 M156 84 C 170 62, 186 56, 196 46" stroke="#111111" stroke-width="6" fill="none" stroke-linecap="round"/>
  <circle cx="95" cy="106" r="14" fill="#F4F1EA"/><circle cx="95" cy="106" r="6" fill="#C80000"/>
  <circle cx="205" cy="106" r="14" fill="#F4F1EA"/><circle cx="205" cy="106" r="6" fill="#C80000"/>
</svg><figcaption><span>MOTH</span><strong>$90</strong></figcaption>
          <span class="eb-claim">CLAIM →</span>
        </button>

        <button type="button" class="eb-flash-btn" data-flash="DAGGER" data-price="$110">
<svg viewBox="0 0 300 260" class="eb-flash-art" role="img" aria-label="Flash design: dagger">
  <rect width="300" height="260" fill="#F4F1EA"/>
  <path d="M70 60 l 32 10 M70 122 l 32 6 M230 60 l -32 10 M230 122 l -32 6" stroke="#111111" stroke-width="5" stroke-linecap="round"/>
  <path d="M150 18 L169 40 L158 182 L150 202 L142 182 L131 40 Z" fill="#111111"/>
  <path d="M150 30 L150 168" stroke="#F4F1EA" stroke-width="4"/>
  <rect x="104" y="198" width="92" height="16" fill="#111111"/>
  <rect x="141" y="214" width="18" height="32" fill="#111111"/>
  <circle cx="150" cy="254" r="0" fill="none"/>
  <circle cx="150" cy="248" r="9" fill="#C80000" stroke="#111111" stroke-width="4"/>
</svg><figcaption><span>DAGGER</span><strong>$110</strong></figcaption>
          <span class="eb-claim">CLAIM →</span>
        </button>

        <button type="button" class="eb-flash-btn" data-flash="PEONY" data-price="$140">
<svg viewBox="0 0 300 260" class="eb-flash-art" role="img" aria-label="Flash design: peony">
  <rect width="300" height="260" fill="#F4F1EA"/>
  <g fill="none" stroke="#111111" stroke-width="7">
    <ellipse cx="150" cy="108" rx="34" ry="54"/>
    <ellipse cx="104" cy="130" rx="30" ry="46" transform="rotate(-28 104 130)"/>
    <ellipse cx="196" cy="130" rx="30" ry="46" transform="rotate(28 196 130)"/>
    <ellipse cx="150" cy="168" rx="44" ry="34"/>
  </g>
  <circle cx="150" cy="124" r="16" fill="#C80000"/>
  <path d="M150 202 L150 252" stroke="#111111" stroke-width="8"/>
  <path d="M150 224 C 120 219, 100 204, 94 184 C 120 189, 140 199, 150 224 Z" fill="#111111"/>
  <path d="M150 236 C 180 231, 200 216, 206 196 C 180 201, 160 211, 150 236 Z" fill="#111111"/>
</svg><figcaption><span>PEONY</span><strong>$140</strong></figcaption>
          <span class="eb-claim">CLAIM →</span>
        </button>

        <button type="button" class="eb-flash-btn" data-flash="EYE" data-price="$80">
<svg viewBox="0 0 300 260" class="eb-flash-art" role="img" aria-label="Flash design: eye">
  <rect width="300" height="260" fill="#F4F1EA"/>
  <g stroke="#111111" stroke-width="6" stroke-linecap="round">
    <path d="M150 28 L150 54 M88 48 L104 68 M212 48 L196 68 M52 100 L78 110 M248 100 L222 110"/>
  </g>
  <path d="M48 142 C 94 96, 206 96, 252 142 C 206 188, 94 188, 48 142 Z" fill="none" stroke="#111111" stroke-width="10"/>
  <circle cx="150" cy="142" r="34" fill="#111111"/>
  <circle cx="150" cy="142" r="14" fill="#C80000"/>
  <circle cx="150" cy="142" r="5" fill="#F4F1EA"/>
</svg><figcaption><span>EYE</span><strong>$80</strong></figcaption>
          <span class="eb-claim">CLAIM →</span>
        </button>

        <button type="button" class="eb-flash-btn" data-flash="SKULL ROSE" data-price="$150">
<svg viewBox="0 0 300 260" class="eb-flash-art" role="img" aria-label="Flash design: skull rose">
  <rect width="300" height="260" fill="#F4F1EA"/>
  <path d="M108 92 C 108 56, 192 56, 192 92 C 192 117, 176 127, 171 142 L171 168 L129 168 L129 142 C 124 127, 108 117, 108 92 Z" fill="#111111"/>
  <circle cx="132" cy="106" r="13" fill="#F4F1EA"/>
  <circle cx="168" cy="106" r="13" fill="#F4F1EA"/>
  <path d="M150 120 l -8 15 l 16 0 z" fill="#F4F1EA"/>
  <path d="M136 168 l 0 -13 M146 168 l 0 -13 M156 168 l 0 -13 M166 168 l 0 -13" stroke="#F4F1EA" stroke-width="4"/>
  <g transform="translate(224 196)">
    <circle r="26" fill="none" stroke="#C80000" stroke-width="8"/>
    <path d="M0 -26 C -18 -18, -18 18, 0 26 M0 -26 C 18 -18, 18 18, 0 26" fill="none" stroke="#C80000" stroke-width="5"/>
    <path d="M0 26 L0 58" stroke="#111111" stroke-width="7"/>
    <path d="M0 44 C -20 41, -30 31, -34 21 C -18 23, -6 31, 0 44 Z" fill="#111111"/>
  </g>
</svg><figcaption><span>SKULL ROSE</span><strong>$150</strong></figcaption>
          <span class="eb-claim">CLAIM →</span>
        </button>

      </div>
      <p class="eb-wall-note">Walk-ins welcome · Tue–Sat, 11:00–19:00 · 88, rue Fictive, Montréal QC</p>
    </section>

    <!-- RESIDENT ARTISTS: the margin -->
    <aside class="eb-residents" aria-label="Resident artists">
      <div class="eb-wrap">
        <h2 class="eb-h2">RESIDENTS.</h2>
        <div class="eb-resident-list">
          <article class="eb-resident">
            <img src={IMG.a1} alt="Marc L., blackwork tattoo artist" loading="lazy" decoding="async" />
            <div><h3>MARC L.</h3><p>BLACKWORK / GEOMETRIC</p><p class="eb-avail">Booking Nov 2026</p></div>
            <span class="eb-status eb-status-open">OPEN</span>
          </article>
          <article class="eb-resident">
            <img src={IMG.a2} alt="Léa R., fine line tattoo artist" loading="lazy" decoding="async" />
            <div><h3>LÉA R.</h3><p>FINE LINE / BOTANICAL</p><p class="eb-avail">Booking Oct 2026</p></div>
            <span class="eb-status eb-status-low">2 SPOTS</span>
          </article>
          <article class="eb-resident">
            <img src={IMG.a3} alt="Jo P., neo-traditional tattoo artist" loading="lazy" decoding="async" />
            <div><h3>JO P.</h3><p>NEO-TRADITIONAL / COLOR</p><p class="eb-avail">Booking Dec 2026</p></div>
            <span class="eb-status eb-status-wait">WAITLIST</span>
          </article>
        </div>
        <figure class="eb-shop">
          <img src={IMG.hero} alt="Tattoo artist at work in the Encre Brute studio" loading="lazy" decoding="async" fetchpriority="high" />
          <figcaption>The shop: four stations, one coffee machine, zero small talk about your star sign.</figcaption>
        </figure>
      </div>
    </aside>

    <!-- CLAIM A FLASH -->
    <section class="eb-claim" id="claim">
      <div class="eb-wrap">
        <h2 class="eb-h2 eb-h2-light">CLAIM IT.</h2>
        <p class="eb-lede-light">Tell us which flash and who should ink it. We reply within 48 hours. A $50 deposit holds your slot.</p>
        <form class="eb-form" id="eb-form" novalidate>
          <label>YOUR NAME<input type="text" name="name" required placeholder="Jane Doe" /></label>
          <label>PHONE<input type="tel" name="phone" required placeholder="(514) 555-0100" /></label>
          <label>FLASH DESIGN
            <select name="flash" id="eb-flash-select" required>
              <option value="">Choose…</option>
              <option>SERPENT · $120</option>
              <option>MOTH · $90</option>
              <option>DAGGER · $110</option>
              <option>PEONY · $140</option>
              <option>EYE · $80</option>
              <option>SKULL ROSE · $150</option>
            </select>
          </label>
          <label>ARTIST
            <select name="artist">
              <option>Marc L., blackwork</option>
              <option>Léa R., fine line</option>
              <option>Jo P., neo-traditional</option>
              <option>Whoever is free first</option>
            </select>
          </label>
          <button class="eb-btn eb-btn-red eb-btn-full" type="submit">CLAIM THIS FLASH</button>
          <p class="eb-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- PRICING + AFTERCARE -->
    <section class="eb-prices">
      <div class="eb-wrap eb-prices-grid">
        <div>
          <h2 class="eb-h2">NUMBERS.</h2>
          <table class="eb-table">
            <tbody>
              <tr><td>Consult</td><td><strong>$0</strong></td></tr>
              <tr><td>Shop minimum</td><td><strong>$100</strong></td></tr>
              <tr><td>Custom work</td><td><strong>$180/hr</strong></td></tr>
              <tr><td>Day session</td><td><strong>$900</strong></td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="eb-h2">AFTERCARE.</h2>
          <ol class="eb-after">
            <li>Keep the wrap on for 24 hours, no peeking.</li>
            <li>Wash gently with unscented soap, pat dry.</li>
            <li>No sun, no pool, no gym sauna for 2 weeks.</li>
            <li>Thin layer of balm, twice a day. Thin means thin.</li>
          </ol>
        </div>
      </div>
    </section>
  </main>

  <footer class="eb-footer">
    <p class="eb-footer-giant" aria-hidden="true">ENCRE BRUTE</p>
    <div class="eb-wrap eb-footer-in">
      <p>88, rue Fictive, Montréal QC · Tue–Sat, 11:00–19:00</p>
      <p><a href="tel:+15145550170">(514) 555-0170</a> · <a href="mailto:hello@encre-brute-demo.ca">hello@encre-brute-demo.ca</a></p>
      <p>18+ with ID. No face tattoos on a first visit. © 2026 Encre Brute. Fictional demo.</p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      // Clicking a flash design preselects it in the claim form
      var selectEl = document.getElementById('eb-flash-select');
      document.querySelectorAll('.eb-flash-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var name = btn instanceof HTMLElement ? (btn.dataset.flash || '') : '';
          if (selectEl instanceof HTMLSelectElement && name) {
            for (var i = 0; i < selectEl.options.length; i++) {
              if (selectEl.options[i].text.indexOf(name) === 0) { selectEl.selectedIndex = i; break; }
            }
          }
          document.getElementById('claim')?.scrollIntoView({ behavior: 'smooth' });
        });
      });
      var formEl = document.getElementById('eb-form');
      if (formEl instanceof HTMLFormElement) {
        var claimForm = formEl;
        claimForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = claimForm.querySelector('.eb-form-note');
          if (note) note.textContent = 'Claimed. We will reply within 48 hours to lock your slot.';
          claimForm.reset();
        });
      }
    })();
  </script>

  <style>
    .eb {
      --eb-paper: #FFFFFF;
      --eb-ink: #000000;
      --eb-red: #FF0000;
      --eb-grey: #F2F2F2;
      --eb-font-h: "Archivo Black", system-ui, sans-serif;
      --eb-font-b: system-ui, -apple-system, "Segoe UI", sans-serif;
      margin: 0;
      background: var(--eb-paper);
      color: var(--eb-ink);
      font-family: var(--eb-font-b);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .eb *, .eb *::before, .eb *::after { box-sizing: border-box; }
    .eb img { display: block; max-width: 100%; }
    .eb-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(18px, 4vw, 40px); }

    .eb-topbar {
      display: flex; align-items: center; gap: 24px;
      padding: 14px clamp(18px, 4vw, 40px);
      border-bottom: 3px solid var(--eb-ink);
      background: var(--eb-paper);
      position: sticky; top: 0; z-index: 50;
    }
    .eb-wordmark {
      font-family: var(--eb-font-h);
      font-size: clamp(1.6rem, 3.4vw, 2.6rem);
      letter-spacing: -0.01em; line-height: 1;
      color: var(--eb-ink); text-decoration: none;
    }
    .eb-topbar-tag { font-size: 12px; font-weight: 700; letter-spacing: 0.22em; margin: 0 0 0 auto; }

    .eb-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--eb-font-h); font-size: 15px; letter-spacing: 0.04em;
      padding: 16px 30px; text-decoration: none; cursor: pointer;
      border: 3px solid var(--eb-ink); border-radius: 0;
      box-shadow: 5px 5px 0 var(--eb-ink);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .eb-btn:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--eb-ink); }
    .eb-btn:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--eb-ink); }
    .eb-btn-red { background: var(--eb-red); color: #fff; }
    .eb-btn-full { width: 100%; }

    .eb-h1 { font-family: var(--eb-font-h); font-size: clamp(3rem, 10vw, 7rem); line-height: 0.9; margin: 0 0 18px; letter-spacing: -0.02em; }
    .eb-h2 { font-family: var(--eb-font-h); font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 0.95; margin: 0 0 18px; letter-spacing: -0.01em; }
    .eb-h2-light { color: #fff; }
    .eb-lede-light { color: #fff; font-size: 17px; line-height: 1.55; max-width: 56ch; margin: 0 0 30px; }

    /* the wall */
    .eb-wall { padding: clamp(36px, 5vw, 70px) clamp(18px, 4vw, 40px) clamp(50px, 7vw, 90px); max-width: 1400px; margin: 0 auto; }
    .eb-wall-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 30px; }
    .eb-wall-sub { font-size: 16.5px; font-weight: 600; max-width: 38ch; margin: 0; }
    .eb-wall-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .eb-flash-btn {
      margin: 0; padding: 0; background: var(--eb-paper); cursor: pointer; text-align: left;
      border: 3px solid var(--eb-ink); box-shadow: 6px 6px 0 var(--eb-ink);
      transition: transform 0.12s ease, box-shadow 0.12s ease; font-family: var(--eb-font-b);
      position: relative; display: block; width: 100%;
    }
    .eb-flash-btn:nth-child(odd) { transform: rotate(-1.1deg); }
    .eb-flash-btn:nth-child(even) { transform: rotate(0.9deg); }
    .eb-flash-btn:hover { transform: translate(-2px, -2px) rotate(0deg); box-shadow: 8px 8px 0 var(--eb-ink); }
    .eb-flash-btn .eb-flash-art { width: 100%; height: 250px; display: block; border-bottom: 3px solid var(--eb-ink); }
    .eb-flash-btn figcaption, .eb-flash-btn > div:last-child {
      display: flex; justify-content: space-between; align-items: center;
      padding: 14px 16px; font-family: var(--eb-font-h); font-size: 15px; letter-spacing: 0.03em;
    }
    .eb-flash-btn figcaption strong { background: var(--eb-ink); color: #fff; padding: 4px 10px; }
    .eb-claim {
      position: absolute; top: 12px; left: 12px; font-family: var(--eb-font-h); font-size: 13px;
      background: var(--eb-red); color: #fff; padding: 8px 14px; border: 3px solid var(--eb-ink);
      opacity: 0; transform: translateY(-6px); transition: opacity 0.15s ease, transform 0.15s ease;
    }
    .eb-flash-btn:hover .eb-claim, .eb-flash-btn:focus-visible .eb-claim { opacity: 1; transform: none; }
    .eb-wall-note { margin-top: 26px; font-size: 14px; font-weight: 700; letter-spacing: 0.06em; }

    /* residents margin */
    .eb-residents { background: var(--eb-grey); border-block: 3px solid var(--eb-ink); padding: clamp(50px, 7vw, 90px) 0; }
    .eb-resident-list { display: grid; gap: 0; margin: 28px 0 40px; border: 3px solid var(--eb-ink); box-shadow: 8px 8px 0 var(--eb-ink); background: #fff; }
    .eb-resident { display: grid; grid-template-columns: 96px 1fr auto; gap: 20px; align-items: center; padding: 16px 18px; border-bottom: 3px solid var(--eb-ink); }
    .eb-resident:last-child { border-bottom: 0; }
    .eb-resident img { width: 96px; height: 96px; object-fit: cover; border: 3px solid var(--eb-ink); filter: grayscale(1); }
    .eb-resident h3 { font-family: var(--eb-font-h); font-size: 1.4rem; margin: 0 0 4px; }
    .eb-resident p { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: 0.16em; }
    .eb-avail { color: #555; margin-top: 6px !important; font-weight: 600 !important; letter-spacing: 0.04em !important; }
    .eb-status { font-family: var(--eb-font-h); font-size: 13px; border: 3px solid var(--eb-ink); padding: 10px 14px; box-shadow: 4px 4px 0 var(--eb-ink); white-space: nowrap; }
    .eb-status-open { background: #2bff5e; }
    .eb-status-low { background: var(--eb-red); color: #fff; }
    .eb-status-wait { background: #ffe600; }
    .eb-shop { margin: 0; border: 3px solid var(--eb-ink); box-shadow: 8px 8px 0 var(--eb-ink); background: #fff; }
    .eb-shop img { width: 100%; height: min(380px, 56vw); object-fit: cover; filter: grayscale(1) contrast(1.1); }
    .eb-shop figcaption { padding: 16px 20px; font-size: 14.5px; font-weight: 600; font-style: italic; }

    /* claim */
    .eb-claim { background: var(--eb-ink); padding: clamp(60px, 8vw, 110px) 0; }
    .eb-form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 8px; background: var(--eb-paper); border: 3px solid var(--eb-ink); box-shadow: 8px 8px 0 var(--eb-red); padding: clamp(24px, 4vw, 44px); }
    .eb-form label { display: grid; gap: 10px; font-family: var(--eb-font-h); font-size: 13px; letter-spacing: 0.08em; }
    .eb-form input, .eb-form select { font-family: var(--eb-font-b); font-weight: 600; font-size: 16px; padding: 14px 16px; border: 3px solid var(--eb-ink); border-radius: 0; background: #fff; width: 100%; }
    .eb-form input:focus, .eb-form select:focus { outline: 3px solid var(--eb-red); outline-offset: 2px; }
    .eb-form .eb-btn { grid-column: 1 / -1; }
    .eb-form-note { grid-column: 1 / -1; margin: 0; font-weight: 700; font-size: 15px; text-align: center; }
    .eb-form-note:empty { display: none; }

    /* prices */
    .eb-prices { padding: clamp(60px, 8vw, 110px) 0; border-bottom: 3px solid var(--eb-ink); }
    .eb-prices-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 80px); }
    .eb-table { width: 100%; border-collapse: collapse; margin-top: 24px; border: 3px solid var(--eb-ink); box-shadow: 8px 8px 0 var(--eb-ink); }
    .eb-table td { border: 3px solid var(--eb-ink); padding: 14px 18px; font-size: 15.5px; font-weight: 600; }
    .eb-table td strong { font-family: var(--eb-font-h); }
    .eb-after { margin: 24px 0 0; padding-left: 22px; display: grid; gap: 10px; font-size: 15.5px; font-weight: 600; }

    /* footer */
    .eb-footer { padding: 56px 0 80px; overflow: hidden; text-align: center; }
