  <script>
    (function () {
      var BASE = {
        studio: [420, 580], '1bed': [620, 840], '2bed': [880, 1180],
        '3bed': [1150, 1520], house: [1450, 1950], office: [1800, 2600]
      };
      var NEARBY = ['terrebonne', 'mascouche', 'laval', 'repentigny', 'blainville', 'saint-eustache', 'st-eustache', 'montreal', 'boisbriand'];
      var FSA_CITY: Record<string, string> = { j8: 'gatineau', j9: 'gatineau', k1: 'ottawa', k2: 'ottawa', h1: 'montreal', h2: 'montreal', h3: 'montreal', h4: 'montreal', m1: 'toronto', m2: 'toronto', m3: 'toronto', m4: 'toronto', m5: 'toronto', m6: 'toronto', m7: 'toronto', m8: 'toronto', m9: 'toronto', g1: 'quebec city', g2: 'quebec city', j6: 'terrebonne', j7: 'terrebonne' };
      function norm(s: string) {
        var v = (s || '').trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        var m = v.match(/^([a-z]\d)[a-z]/);
        if (m && FSA_CITY[m[1]]) return FSA_CITY[m[1]];
        return v;
      }
      function round10(n: number) { return Math.round(n / 10) * 10; }
      function money(n: number) { return '$' + n.toLocaleString('en-CA'); }

      var form = document.getElementById('rn-form') as HTMLFormElement | null;
      var progress = document.getElementById('rn-progress') as HTMLElement | null;
      var note = document.getElementById('rn-form-note') as HTMLElement | null;
      var result = document.getElementById('rn-result') as HTMLElement | null;
      function showStep(n: number) {
        form?.querySelectorAll('.rn-step').forEach(function (s) {
          var el = s as HTMLElement;
          el.hidden = Number(el.dataset.step) !== n;
        });
        if (progress) progress.textContent = 'Step ' + n + ' of 3';
        if (note) note.textContent = '';
      }
      function requiredFilled(step: number) {
        var ok = true;
        form?.querySelectorAll('.rn-step[data-step="' + step + '"] [required]').forEach(function (el) {
          var field = el as HTMLInputElement | HTMLSelectElement;
          if (field instanceof HTMLInputElement && field.type === 'checkbox') { if (!field.checked) ok = false; }
          else if (!field.value || !String(field.value).trim()) ok = false;
        });
        return ok;
      }
      form?.querySelectorAll('[data-next]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var step = Number((btn as HTMLElement).dataset.next);
          if (!requiredFilled(step)) {
            if (note) note.textContent = 'Fill in every field on this step first.';
            return;
          }
          showStep(step + 1);
        });
      });
      form?.querySelectorAll('[data-back]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showStep(Number((btn as HTMLElement).dataset.back) - 1);
        });
      });

      form?.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        var step = form?.querySelector('.rn-step:not([hidden])');
        var next = (step?.querySelector('button[data-next]') || null) as HTMLButtonElement | null;
        if (next) { e.preventDefault(); next.click(); }
      });
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!requiredFilled(3)) {
          if (note) note.textContent = 'Add your name, phone, email and text consent first.';
          return;
        }
        var emailEl = document.getElementById('rn-email') as HTMLInputElement | null;
        var phoneEl = document.getElementById('rn-phone') as HTMLInputElement | null;
        var emailVal = emailEl?.value || '';
        if (emailVal.indexOf('@') === -1 || emailVal.indexOf('.', emailVal.indexOf('@')) === -1) {
          if (note) note.textContent = 'Please check your email address: it needs an @ and a dot.';
          emailEl?.focus();
          return;
        }
        var digits = (phoneEl?.value || '').replace(/\D/g, '');
        if (digits.length < 10) {
          if (note) note.textContent = 'Please check your phone number: it needs at least 10 digits.';
          phoneEl?.focus();
          return;
        }
        var size = (document.getElementById('rn-size') as HTMLSelectElement | null)?.value || '2bed';
        var from = norm((document.getElementById('rn-from') as HTMLInputElement | null)?.value || '');
        var to = norm((document.getElementById('rn-to') as HTMLInputElement | null)?.value || '');
        var base = BASE[size as keyof typeof BASE] || BASE['2bed'];
        var factor = 1.0;
        var distLabel = 'Local move';
        if (from && to && from !== to) {
          if (NEARBY.indexOf(to) !== -1 && NEARBY.indexOf(from) !== -1) { factor = 1.3; distLabel = 'Nearby, under 100 km'; }
          else { factor = 1.8; distLabel = 'Long distance'; }
        }
        var add = 0;
        var parts = [];
        if ((document.getElementById('rn-piano') as HTMLInputElement | null)?.checked) { add += 180; parts.push('piano +$180'); }
        if ((document.getElementById('rn-safe') as HTMLInputElement | null)?.checked) { add += 150; parts.push('safe +$150'); }
        if ((document.getElementById('rn-art') as HTMLInputElement | null)?.checked) { add += 120; parts.push('artwork or fragile pieces +$120'); }
        var access = (document.getElementById('rn-access') as HTMLSelectElement | null)?.value || '';
        if (access === 'stairs3') { add += 80; parts.push('stairs, 3rd floor or higher, no elevator +$80'); }
        var packingEl = form?.querySelector('input[name="packing"]:checked') as HTMLInputElement | null;
        var packing = packingEl?.value || 'none';
        if (packing === 'partial') { add += 250; parts.push('partial packing +$250'); }
        if (packing === 'full') { add += 450; parts.push('full packing +$450'); }
        var low = round10(base[0] * factor + add);
        var high = round10(base[1] * factor + add);
        var range = document.getElementById('rn-range') as HTMLElement | null;
        if (range) range.textContent = 'Planning range: ' + money(low) + ' - ' + money(high);
        var bd = document.getElementById('rn-breakdown') as HTMLElement | null;
        if (bd) bd.textContent = distLabel + ' (x' + factor.toFixed(1) + ')' + (parts.length ? '. Add-ons: ' + parts.join(', ') + '.' : '. No add-ons.');
        form?.querySelectorAll('.rn-step').forEach(function (s) { (s as HTMLElement).hidden = true; });
        if (progress) progress.textContent = 'Your range is ready';
        if (result) result.hidden = false;
        if (note) note.textContent = 'Noted. We will call you back within one business hour.';
      });
      document.getElementById('rn-edit-btn')?.addEventListener('click', function () {
        if (result) result.hidden = true;
        showStep(1);
      });
      document.getElementById('rn-video-btn')?.addEventListener('click', function () {
        if (note) note.textContent = 'Noted. We will text you three video survey times within one business hour.';
      });
    })();
  </script>

