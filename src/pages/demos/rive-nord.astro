---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Déménagement Rive-Nord, fictional mover, Terrebonne QC.
// Bold highway service-board voice: charcoal and signal yellow, oversized
// Oswald headlines, availability first, 3-step instant-range calculator in
// the hero, plain-language pricing explainer. All details fictional.
const IMG = {
  hero: "/demos/rive-nord/01.jpg",
  crew: "/demos/rive-nord/02.jpg",
  packing: "/demos/rive-nord/03.jpg",
  truck: "/demos/rive-nord/04.jpg",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="rive-nord" locale="en" title="Déménagement Rive-Nord · Terrebonne movers (450) 555-0193 · See your price in 60 seconds" description="Déménagement Rive-Nord: Terrebonne movers since 2016. Houses, condos and offices across the North Shore and Montreal. See a planning range in 60 seconds, no phone call required." ogImage="https://webao.ca/demos/rive-nord/01.jpg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MovingCompany",
      "name": "Déménagement Rive-Nord",
      "telephone": "+1-450-555-0193",
      "email": "info@demenagementrivenord.ca",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1234, rue Fictive",
        "addressLocality": "Terrebonne",
        "addressRegion": "QC",
        "postalCode": "J6W 1A1",
        "addressCountry": "CA"
      },
      "openingHours": ["Mo-Sa 07:00-19:00", "Su 08:00-17:00"],
      "areaServed": ["Terrebonne", "Mascouche", "Laval", "Repentigny", "Blainville", "Saint-Eustache", "Montreal"]
    }
  </script>
</head>
<body class="rn">
  <a class="rn-skip" href="#rn-main">Skip to content</a>

  <header class="rn-header">
    <div class="rn-header-in">
      <a class="rn-brand" href="#rn-top" aria-label="Déménagement Rive-Nord, back to top">
        <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="2" y="2" width="44" height="44" rx="8" fill="#F2B705" /><path d="M14 38 L24 10 L34 38" fill="none" stroke="#3B3F45" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /><path d="M19 28 h10" stroke="#3B3F45" stroke-width="5" stroke-linecap="round" /></svg>
        <span class="rn-brand-text">RIVE-NORD<span class="rn-brand-sub">DEMENAGEMENT · TERREBONNE</span></span>
      </a>
      <nav class="rn-nav" id="rn-nav" aria-label="Main navigation">
        <a href="#rn-services">Services</a>
        <a href="#rn-pricing">Pricing</a>
        <a href="#rn-reviews">Reviews</a>
        <a href="#rn-how">How it works</a>
        <a href="#rn-contact">Contact</a>
      </nav>
      <div class="rn-header-cta">
        <a class="rn-btn rn-btn-yellow" href="#rn-calculator"><span class="rn-cta-full">Get a quote</span><span class="rn-cta-short">Quote</span></a>
      </div>
    </div>
  </header>

  <main id="rn-main">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="rn-star" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </symbol>
      </defs>
    </svg>
    <!-- HERO: availability first, calculator in the hero -->
    <section class="rn-hero" id="rn-top">
      <div class="rn-hero-in">
        <div class="rn-hero-copy">
          <p class="rn-avail">Crews available. Book fast.</p>
          <h1 class="rn-h1">MOVE FAST.<br />MOVE RIGHT.</h1>
          <p class="rn-lede">Déménagement Rive-Nord is the Terrebonne crew for houses, condos and offices. We load, we drive, and we place every box in the right room.</p>
          <p class="rn-hero-call">
            <a class="rn-call-big" href="tel:+14505550193">Call (450) 555-0193</a>
            <span class="rn-call-note">We answer 7 h to 19 h, Mon to Sat.</span>
          </p>
          <ul class="rn-trust" aria-label="Trust signals">
            <li>RBQ licence 0000-0000-00 (fictional)</li>
            <li>Insured</li>
            <li>Since 2016</li>
            <li>4.8/5 from 132 reviews</li>
          </ul>
        </div>
        <figure class="rn-hero-img">
          <img src={IMG.hero} alt="The back of a moving truck loaded with boxes and furniture, ramp down" width="1024" height="768" decoding="async" fetchpriority="high" />
          <figcaption>Our truck, loaded and ready. Terrebonne to Montreal in one run.</figcaption>
        </figure>
      </div>

      <!-- CALCULATOR -->
      <div class="rn-calc" id="rn-calculator">
        <h2 class="rn-h2">See your price in 60 seconds</h2>
        <p class="rn-calc-sub">Three steps. No phone call required to see your range. We only use your details to call you back about this move, within one business hour.</p>
        <p class="rn-progress" id="rn-progress" aria-live="polite">Step 1 of 3</p>
        <form class="rn-form" id="rn-form" novalidate>
          <div class="rn-step" data-step="1">
            <h3 class="rn-h3">Step 1: Where and when</h3>
            <div class="rn-grid">
              <p class="rn-field">
                <label for="rn-size">Move size</label>
                <select id="rn-size" name="size" required>
                  <option value="">Choose a size</option>
                  <option value="studio">Studio</option>
                  <option value="1bed">1 bedroom</option>
                  <option value="2bed">2 bedrooms</option>
                  <option value="3bed">3 bedrooms</option>
                  <option value="house">House, 4+ bedrooms</option>
                  <option value="office">Office</option>
                </select>
              </p>
              <p class="rn-field">
                <label for="rn-from">Moving from (city or postal code)</label>
                <input id="rn-from" name="from" type="text" required placeholder="Terrebonne" autocomplete="address-level2" />
              </p>
              <p class="rn-field">
                <label for="rn-to">Moving to (city or postal code)</label>
                <input id="rn-to" name="to" type="text" required placeholder="Montreal" autocomplete="address-level2" />
              </p>
              <p class="rn-field">
                <label for="rn-date">Move date</label>
                <input id="rn-date" name="date" type="date" required />
              </p>
            </div>
            <p class="rn-field-note">City names or postal codes are enough for a range. We ask for the full address only when you book.</p>
            <button class="rn-btn rn-btn-yellow" type="button" data-next="1">Next: what is being moved</button>
          </div>

          <div class="rn-step" data-step="2" hidden>
            <h3 class="rn-h3">Step 2: What is being moved</h3>
            <fieldset class="rn-checks">
              <legend>Inventory</legend>
              <label><input type="checkbox" name="inv" value="sofa" /> Sofa and armchairs</label>
              <label><input type="checkbox" name="inv" value="beds" /> Beds and mattresses</label>
              <label><input type="checkbox" name="inv" value="table" /> Table and chairs</label>
              <label><input type="checkbox" name="inv" value="appliances" /> Fridge, washer, dryer</label>
              <label><input type="checkbox" name="inv" value="boxes" /> Boxes, about 20 or more</label>
              <label><input type="checkbox" name="inv" value="desk" /> Desks and shelves</label>
            </fieldset>
            <p class="rn-field-note">Inventory helps the crew plan. It does not change your range.</p>
            <fieldset class="rn-checks">
              <legend>Special items</legend>
              <label><input type="checkbox" id="rn-piano" name="special" value="piano" /> Piano (+$180)</label>
              <label><input type="checkbox" id="rn-safe" name="special" value="safe" /> Safe (+$150)</label>
              <label><input type="checkbox" id="rn-art" name="special" value="artwork" /> Artwork or fragile pieces (+$120)</label>
            </fieldset>
            <p class="rn-field">
              <label for="rn-access">Stairs and elevator</label>
              <select id="rn-access" name="access">
                <option value="easy">Ground floor or elevator at both ends</option>
                <option value="stairs">Stairs, 2nd floor, no elevator</option>
                <option value="stairs3">3rd floor or higher, no elevator (+$80)</option>
              </select>
            </p>
            <p class="rn-field">
              <fieldset class="rn-checks">
                <legend>Packing level</legend>
                <label><input type="radio" name="packing" value="none" checked /> No packing, we move what is boxed</label>
                <label><input type="radio" name="packing" value="partial" /> Partial packing (+$250)</label>
                <label><input type="radio" name="packing" value="full" /> Full packing, we box everything (+$450)</label>
              </fieldset>
            </p>
            <p class="rn-step-nav">
              <button class="rn-btn rn-btn-ghost" type="button" data-back="2">Back</button>
              <button class="rn-btn rn-btn-yellow" type="button" data-next="2">Next: who is moving</button>
            </p>
          </div>

          <div class="rn-step" data-step="3" hidden>
            <h3 class="rn-h3">Step 3: Who is moving</h3>
            <div class="rn-grid">
              <p class="rn-field">
                <label for="rn-name">Full name</label>
                <input id="rn-name" name="name" type="text" required placeholder="Alex Tremblay" autocomplete="name" />
              </p>
              <p class="rn-field">
                <label for="rn-phone">Mobile phone</label>
                <input id="rn-phone" name="phone" type="tel" required placeholder="(450) 555-0000" autocomplete="tel" />
              </p>
              <p class="rn-field">
                <label for="rn-email">Email</label>
                <input id="rn-email" name="email" type="email" required placeholder="alex@example.com" autocomplete="email" />
              </p>
            </div>
            <p class="rn-field rn-consent">
              <label><input type="checkbox" id="rn-consent" name="consent" required /> Yes, text me about my move. No spam, no sharing your number.</label>
            </p>
            <p class="rn-step-nav">
              <button class="rn-btn rn-btn-ghost" type="button" data-back="3">Back</button>
              <button class="rn-btn rn-btn-yellow" type="submit">See my planning range</button>
            </p>
          </div>

          <div class="rn-result" id="rn-result" hidden>
            <h3 class="rn-h3">Your planning range</h3>
            <p class="rn-range" id="rn-range" role="status" aria-live="polite"></p>
            <p id="rn-breakdown"></p>
            <p>This is a planning range, not a binding estimate. A binding estimate requires a 15-minute video survey.</p>
            <p><strong>Video survey:</strong> show us each room on a 15-minute video call and we lock in a binding price before moving day. No visit, no waiting.</p>
            <p>We will call you back within one business hour.</p>
            <p><a class="rn-btn rn-btn-yellow" href="tel:+14505550193">Call (450) 555-0193</a></p>
            <p><button class="rn-btn rn-btn-yellow" type="button" id="rn-video-btn">Book the 15-minute video survey</button></p>
            <p><button class="rn-btn rn-btn-ghost" type="button" id="rn-edit-btn">Change my details</button></p>
          </div>
          <p class="rn-form-note" id="rn-form-note" role="status" aria-live="polite"></p>
        </form>
      <noscript><p>This calculator needs JavaScript. Call (450) 555-0193 and we will give you the range by phone.</p></noscript>
      </div>
    </section>

    <p class="rn-facts">Since 2016 · About 2,400 moves · 7 towns across the North Shore · 4.8/5 from 132 reviews</p>

    <!-- SERVICES -->
    <!-- CREWS THIS WEEK -->
    <section class="rn-crews" id="rn-avail">
      <h2 class="rn-h2">Crews this week</h2>
      <p class="rn-sec-sub">Who is free, and when. Book the slot and the crew is confirmed on the spot.</p>
      <div class="rn-avail-grid">
        <article class="rn-avail-card">
          <p class="rn-avail-day">Today</p>
          <p class="rn-avail-crew"><strong>Karim + Julie</strong> · 2 movers, 16 ft truck</p>
          <p class="rn-avail-slot"><span class="rn-avail-open">2 slots open</span> · 8 h and 13 h</p>
          <a class="rn-btn rn-btn-yellow" href="#rn-calculator">Book this crew</a>
        </article>
        <article class="rn-avail-card">
          <p class="rn-avail-day">Tomorrow</p>
          <p class="rn-avail-crew"><strong>Thomas + Lea</strong> · 3 movers, 20 ft truck</p>
          <p class="rn-avail-slot"><span class="rn-avail-open">1 slot open</span> · 9 h</p>
          <a class="rn-btn rn-btn-yellow" href="#rn-calculator">Book this crew</a>
        </article>
        <article class="rn-avail-card">
          <p class="rn-avail-day">Day after tomorrow</p>
          <p class="rn-avail-crew"><strong>Karim + Thomas</strong> · 3 movers, 20 ft truck</p>
          <p class="rn-avail-slot"><span class="rn-avail-full">Fully booked</span> · next opening the day after</p>
          <a class="rn-btn rn-btn-yellow" href="#rn-calculator">Join the waitlist</a>
        </article>
      </div>
      <p class="rn-avail-note">July 1 is the busiest moving day in Quebec. For a July 1 move, book at least 6 weeks ahead.</p>
    </section>

    <section class="rn-services" id="rn-services">
      <h2 class="rn-h2">What we move</h2>
      <p class="rn-sec-sub">Six jobs, one crew, one price logic. Every job ends with boxes in the right room.</p>
      <div class="rn-rate">
        <div class="rn-rate-row"><div><h3>Local Residential</h3><p>Apartments and houses across Terrebonne and the North Shore. Stairs, elevators and tight hallways, handled.</p></div><div class="rn-rate-side"><p class="rn-rate-price">From $420 for a studio</p><a class="rn-card-cta" href="#rn-calculator">See my price</a></div></div>
        <div class="rn-rate-row"><div><h3>Long-Distance</h3><p>Terrebonne to Montreal, Quebec City and beyond. One crew, one truck, one delivery window you can plan around.</p></div><div class="rn-rate-side"><p class="rn-rate-price">From $1,500 for a 3 bedroom move to Montreal</p><a class="rn-card-cta" href="#rn-calculator">See my price</a></div></div>
        <div class="rn-rate-row"><div><h3>Commercial and Office</h3><p>Desks, servers and files moved over a weekend, so Monday morning starts at the new address.</p></div><div class="rn-rate-side"><p class="rn-rate-price">From $1,800 for a small office</p><a class="rn-card-cta" href="#rn-calculator">See my price</a></div></div>
        <div class="rn-rate-row"><div><h3>Packing and Unpacking</h3><p>We box the kitchen, label every carton and unpack at the other end. You point, we pack.</p></div><div class="rn-rate-side"><p class="rn-rate-price">Partial packing from $250</p><a class="rn-card-cta" href="#rn-calculator">See my price</a></div></div>
        <div class="rn-rate-row"><div><h3>Storage</h3><p>A gap between two leases? Your boxes wait in a dry, locked unit until your new keys work.</p></div><div class="rn-rate-side"><p class="rn-rate-price">Quoted with your move</p><a class="rn-card-cta" href="#rn-calculator">See my price</a></div></div>
        <div class="rn-rate-row"><div><h3>Specialty and Piano</h3><p>Pianos, safes and solid wood pieces moved with straps, sliders and a crew that has done it before.</p></div><div class="rn-rate-side"><p class="rn-rate-price">Piano add-on from $180</p><a class="rn-card-cta" href="#rn-calculator">See my price</a></div></div>
      </div>
      <figure class="rn-wide-img">
        <img src={IMG.packing} alt="Empty moving boxes with blank NAME and CONTENTS labels, ready to pack" width="1024" height="683" loading="lazy" decoding="async" />
        <figcaption>Empty boxes, labelled before anything goes in.</figcaption>
      </figure>
    </section>

    <!-- PRICING EXPLAINER -->
    <section class="rn-pricing" id="rn-pricing">
      <h2 class="rn-h2">How pricing works</h2>
      <p class="rn-sec-sub">Three kinds of estimate, in plain language. Ask which one you are getting before you book.</p>
      <p class="rn-sec-sub">Local means a move inside one city. Nearby is our home area: Terrebonne, Mascouche, Laval, Repentigny, Blainville, Saint-Eustache and Montreal. Anything farther is long distance.</p>
      <dl class="rn-defs">
        <div><dt>Hourly</dt><dd>You pay for the crew and the truck by the hour. Good for small local moves. The clock starts when we arrive and stops when the last box is placed.</dd></div>
        <div><dt>Binding</dt><dd>One fixed total for the items listed on the survey. It does not change on moving day, even if the job runs long.</dd></div>
        <div><dt>Not-to-exceed</dt><dd>A capped total. You pay less if the move weighs in lighter than the survey, never more than the cap.</dd></div>
      </dl>
      <h3 class="rn-h3">What changes a final bill</h3>
      <ul class="rn-bullets">
        <li>More items than listed on the survey</li>
        <li>Stairs with no elevator, or a long carry from truck to door</li>
        <li>Packing added on moving day</li>
        <li>Waiting time at the building, elevator delays or a late key handover</li>
      </ul>
      <div class="rn-valuation">
        <h3 class="rn-h3">Valuation: read this before you sign</h3>
        <p><strong>Full value protection:</strong> if we damage an item, we repair it, replace it, or pay its current value.</p>
        <p><strong>Released value:</strong> the basic cover, 60 cents per pound per item. A 40 lb TV is worth $24 under released value. That is why the full value option exists.</p>
        <p>We walk through both options at booking. No fine print surprise on moving day.</p>
      </div>
      <p class="rn-protect-note">Every move is protected the same way: furniture blankets on wood and leather, stretch wrap on upholstery, floor runners in both homes, and the truck loaded tight so nothing shifts.</p>
    </section>

    <!-- REVIEWS -->
    <section class="rn-reviews" id="rn-reviews">
      <h2 class="rn-h2">Reviews, by move type</h2>
      <p class="rn-review-stars-row" role="img" aria-label="Rated 4.8 out of 5 from 132 reviews"><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><span>4.8/5 from 132 reviews</span></p>
      <p class="rn-sec-sub">Names, neighbourhoods and dates, because a star count alone says nothing. These reviews are written for this fictional demo company.</p>
      <div class="rn-review-grid">
        <article class="rn-review">
          <p class="rn-stars" role="img" aria-label="5 out of 5 stars"><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg></p>
          <p class="rn-review-type">Local move</p>
          <blockquote>Condo on the 8th floor in Terrebonne, elevator booked for 9 h, everything down by noon. Karim checked the loading dock rules before we arrived.</blockquote>
          <p class="rn-review-who">Isabelle, Terrebonne, March 2026</p>
        </article>
        <article class="rn-review">
          <p class="rn-stars" role="img" aria-label="5 out of 5 stars"><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg></p>
          <p class="rn-review-type">Long-distance move</p>
          <blockquote>Lachenaie to Montreal in one day. The truck left at 8 h, we were eating dinner in the new kitchen at 19 h. Every box landed in the room written on it.</blockquote>
          <p class="rn-review-who">Antoine and Sara, Lachenaie, February 2026</p>
        </article>
        <article class="rn-review">
          <p class="rn-stars" role="img" aria-label="5 out of 5 stars"><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg></p>
          <p class="rn-review-type">Office move</p>
          <blockquote>Our whole clinic moved over a Saturday: six treatment rooms, the front desk, and the filing cabinets. Monday morning the first patient walked into a finished room.</blockquote>
          <p class="rn-review-who">David, Mascouche, January 2026</p>
        </article>
        <article class="rn-review">
          <p class="rn-stars" role="img" aria-label="5 out of 5 stars"><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg></p>
          <p class="rn-review-type">Packing</p>
          <blockquote>Julie packed the kitchen in one morning. Every glass survived, and the labels said which shelf each box belonged on. I unpacked in two evenings.</blockquote>
          <p class="rn-review-who">Nathalie, La Plaine, April 2026</p>
        </article>
        <article class="rn-review">
          <p class="rn-stars" role="img" aria-label="4 out of 5 stars"><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg aria-hidden="true"><use href="#rn-star" /></svg><svg class="rn-star-empty" aria-hidden="true"><use href="#rn-star" /></svg></p>
          <p class="rn-review-type">Piano move</p>
          <blockquote>Baby grand from a second-floor living room, down the stairs and into the new place without a scratch. They sent three movers just for the piano and explained the plan before lifting.</blockquote>
          <p class="rn-review-who">Michel, Blainville, May 2026</p>
        </article>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="rn-how" id="rn-how">
      <div class="rn-how-in">
        <div>
          <h2 class="rn-h2">How it works</h2>
          <ol class="rn-steps">
            <li><strong>Book</strong> Get your range in 60 seconds, pick a date, and we confirm the crew and the truck size by phone.</li>
            <li><strong>Load</strong> The crew protects doors, floors and rails, then loads the truck tight, heavy at the bottom, fragile on top.</li>
            <li><strong>Deliver</strong> We unload room by room, place the furniture where you want it, and take the used boxes away.</li>
          </ol>
          <p>Your crew: Karim runs the team, with Julie, Thomas and Lea on the truck. Same faces at loading and at delivery, no day labour picked up on the way.</p>
        </div>
        <figure>
          <img src={IMG.crew} alt="A Rive-Nord mover carrying a stack of labelled boxes to the truck" width="1024" height="768" loading="lazy" decoding="async" />
          <figcaption>Stacked, strapped, and carried in one trip.</figcaption>
        </figure>
      </div>
    </section>

    <!-- SERVICE AREAS -->
    <section class="rn-areas" id="rn-areas">
      <div class="rn-areas-in">
        <div>
          <h2 class="rn-h2">Where we run</h2>
          <p>Home base in Terrebonne: Vieux-Terrebonne, Lachenaie and La Plaine. We also run daily to Mascouche, Laval, Repentigny, Blainville and Saint-Eustache, and weekly Rive-Nord to Montreal runs.</p>
          <p><strong>Parking and elevators:</strong> tell us about the loading zone and the elevator booking when you reserve. Condo moves need a booked elevator slot and a certificate of insurance for the building, and we send both before moving day.</p>
          <p><strong>New construction:</strong> we move into new builds all year. Gravel driveways, no elevator yet, keys handed over the same morning: say so at booking and we bring the floor protection and the extra hands.</p>
          <p>July 1 is the busiest day of the year in Quebec. Book July 1 at least six weeks ahead, or pick June 30 or July 2, which are easier to book.</p>
        </div>
        <figure>
