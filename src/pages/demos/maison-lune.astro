---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Maison Lune, fictional boutique lakeside inn, Magog.
// Standalone art direction. Moonlit dreaminess. Not connected to the WEBAO theme system.
const IMG = {
  hero: "https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=1600&auto=format&fit=crop",
  cabin: "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?q=80&w=1200&auto=format&fit=crop",
  room1: "https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1000&auto=format&fit=crop",
  room2: "https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=1000&auto=format&fit=crop",
  room3: "https://images.unsplash.com/photo-1618773928121-c32242e63f39?q=80&w=1000&auto=format&fit=crop",
  room4: "https://images.unsplash.com/photo-1591088398332-8a7791972843?q=80&w=1000&auto=format&fit=crop",
  dining: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=1000&auto=format&fit=crop",
  canoe: "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=1000&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Maison Lune: Boutique Lakeside Inn in Magog</title>
  <meta name="description" content="Maison Lune: a four-room boutique inn on Lake Memphremagog. Slow mornings, moonlit water, breakfasts worth waking for." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="ml">

  <!-- NAV -->
  <header class="ml-navwrap">
    <nav class="ml-nav" aria-label="Primary">
      <div class="ml-nav-links">
        <a href="#rooms">Rooms</a>
        <a href="#experiences">Experiences</a>
      </div>
      <a class="ml-logo" href="#top" aria-label="Maison Lune, home">
        <span class="ml-moon" aria-hidden="true">☾</span>
        <span>Maison Lune</span>
      </a>
      <div class="ml-nav-links">
        <a href="#story">The house</a>
        <a class="ml-nav-book" href="#book">Reserve</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="ml-hero">
      <div class="ml-hero-bg" aria-hidden="true">
        <img src={IMG.hero} alt="" loading="eager" fetchpriority="high" />
      </div>
      <span class="ml-star ml-s1" aria-hidden="true"></span>
      <span class="ml-star ml-s2" aria-hidden="true"></span>
      <span class="ml-star ml-s3" aria-hidden="true"></span>
      <span class="ml-star ml-s4" aria-hidden="true"></span>
      <span class="ml-star ml-s5" aria-hidden="true"></span>
      <span class="ml-star ml-s6" aria-hidden="true"></span>
      <div class="ml-moonglow" aria-hidden="true"></div>
      <div class="ml-hero-in">
        <p class="ml-eyebrow">A four-room inn · Lake Memphremagog · Magog</p>
        <h1 class="ml-h1">Sleep under<br /><em>a bigger sky</em></h1>
        <p class="ml-lede">Four rooms above the water, breakfasts worth waking for, and nights so quiet you can hear the lake thinking.</p>
        <div class="ml-hero-cta">
          <a class="ml-btn" href="#book">Check availability</a>
          <a class="ml-link" href="#rooms">Meet the rooms ↓</a>
        </div>
      </div>
    </section>

    <!-- STORY -->
    <section class="ml-story" id="story">
      <div class="ml-wrap-narrow">
        <p class="ml-kicker">✦ the house ✦</p>
        <p class="ml-dropcap">Built in 1928 as a summer house for a Montreal watchmaker, Maison Lune spent ninety years watching the lake change its mind. We kept the wide plank floors, the deep window seats, and the habit of doing one thing at a time. There are four rooms, one long breakfast table, and a dock that belongs to whoever wakes first.</p>
        <figure class="ml-story-img">
          <img src={IMG.cabin} alt="The inn on the lake at dusk" loading="lazy" />
          <figcaption>The house from the water, just after the loons go quiet.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ROOMS -->
    <section class="ml-section" id="rooms">
      <div class="ml-wrap">
        <p class="ml-kicker">✦ four rooms, four moods ✦</p>
        <h2 class="ml-h2">Choose your <em>phase</em></h2>
        <div class="ml-rooms">
          <article class="ml-room">
            <div class="ml-room-media"><img src={IMG.room1} alt="The Full Moon room with a view of the lake" loading="lazy" /><span class="ml-phase" aria-hidden="true">●</span></div>
            <div class="ml-room-copy">
              <p class="ml-room-no">Room one</p>
              <h3>Full Moon</h3>
              <p>The corner room, with windows on two sides of the water. Wakes with the sun, sleeps with the moon. The bed faces east for a reason.</p>
              <ul><li>King bed, lake view</li><li>Soaking tub</li><li>Window seat for two</li></ul>
              <p class="ml-room-price">$285 <span>/ night</span></p>
            </div>
          </article>
          <article class="ml-room ml-room-flip">
            <div class="ml-room-media"><img src={IMG.room2} alt="The Half Moon room in soft morning light" loading="lazy" /><span class="ml-phase" aria-hidden="true">◐</span></div>
            <div class="ml-room-copy">
              <p class="ml-room-no">Room two</p>
              <h3>Half Moon</h3>
              <p>Half lake, half pine forest. The quietest room in the house, with a reading chair that has ended more novels than we can count.</p>
              <ul><li>Queen bed, forest side</li><li>Reading nook</li><li>Rain shower</li></ul>
              <p class="ml-room-price">$225 <span>/ night</span></p>
            </div>
          </article>
          <article class="ml-room">
            <div class="ml-room-media"><img src={IMG.room3} alt="The New Moon room, dark and cocoon-like" loading="lazy" /><span class="ml-phase" aria-hidden="true">○</span></div>
            <div class="ml-room-copy">
              <p class="ml-room-no">Room three</p>
              <h3>New Moon</h3>
              <p>Dark, cocooning, made for deep sleep. Blackout shutters, a weighted blanket, and the best mattress we could find in the province.</p>
              <ul><li>King bed, blackout</li><li>Weighted blanket</li><li>Deep soaker tub</li></ul>
              <p class="ml-room-price">$245 <span>/ night</span></p>
            </div>
          </article>
          <article class="ml-room ml-room-flip">
            <div class="ml-room-media"><img src={IMG.room4} alt="The Crescent room with warm wood tones" loading="lazy" /><span class="ml-phase" aria-hidden="true">☾</span></div>
            <div class="ml-room-copy">
              <p class="ml-room-no">Room four</p>
              <h3>Crescent</h3>
              <p>The attic room under the eaves, all warm wood and low light. Made for writers, honeymooners, and anyone avoiding their inbox.</p>
              <ul><li>Queen bed, attic</li><li>Writing desk</li><li>Skylight for stargazing</li></ul>
              <p class="ml-room-price">$195 <span>/ night</span></p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- EXPERIENCES -->
    <section class="ml-exp" id="experiences">
      <div class="ml-wrap">
        <p class="ml-kicker">✦ slow days, well spent ✦</p>
        <h2 class="ml-h2">The <em>rituals</em></h2>
      </div>
      <div class="ml-strip">
        <figure>
          <img src={IMG.canoe} alt="Canoe gliding on the calm morning lake" loading="lazy" />
          <figcaption><strong>Dawn canoe</strong><span>We lend the canoe, the thermos, and the silence. Back by breakfast.</span></figcaption>
        </figure>
        <figure>
          <img src={IMG.dining} alt="Breakfast table set with local food" loading="lazy" />
          <figcaption><strong>The long breakfast</strong><span>Served 8 to 11 at one big table. Nobody is in a hurry, ever.</span></figcaption>
        </figure>
        <figure>
          <img src={IMG.hero} alt="Stars over the mountains at night" loading="lazy" />
          <figcaption><strong>Stargazing deck</strong><span>Blankets, a telescope, and some of the darkest skies south of the Laurentians.</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- BOOKING -->
    <section class="ml-section" id="book">
      <div class="ml-wrap-narrow">
        <div class="ml-book">
          <p class="ml-kicker">✦ reserve directly ✦</p>
          <h2 class="ml-h2">The lake is <em>waiting</em></h2>
          <p class="ml-book-sub">Booking direct means the best rate, the best room, and a jar of our granola on arrival. Two-night minimum on weekends.</p>
          <form class="ml-form" id="ml-form" novalidate>
            <div class="ml-form-row">
              <label>Check-in<input type="date" name="in" required /></label>
              <label>Check-out<input type="date" name="out" required /></label>
            </div>
            <div class="ml-form-row">
              <label>Guests
                <select name="guests">
                  <option>1 guest</option>
                  <option selected>2 guests</option>
                  <option>3 guests</option>
                  <option>4 guests</option>
                </select>
              </label>
              <label>Room
                <select name="room">
                  <option>Full Moon</option>
                  <option>Half Moon</option>
                  <option>New Moon</option>
                  <option>Crescent</option>
                </select>
              </label>
            </div>
            <button class="ml-btn ml-btn-full" type="submit">Check availability</button>
            <p class="ml-form-note" role="status" aria-live="polite"></p>
          </form>
          <p class="ml-book-alt">Prefer a human? Call <a href="tel:+18195550142">(819) 555-0142</a>, we answer between breakfasts.</p>
        </div>
      </div>
    </section>

    <!-- QUOTES -->
    <section class="ml-quotes">
      <div class="ml-wrap-narrow">
        <blockquote>
          <p>"We came for one night and stayed for four. I have never slept like that in my adult life."</p>
          <cite>Hélène & Marc, Montréal</cite>
        </blockquote>
        <blockquote>
          <p>"The breakfast alone is worth the drive. The lake at dawn is almost unfair."</p>
          <cite>Priya, Toronto</cite>
        </blockquote>
      </div>
    </section>
  </main>

  <footer class="ml-footer">
    <p class="ml-footer-moon" aria-hidden="true">☾</p>
    <p class="ml-footer-name">Maison Lune</p>
    <div class="ml-wrap ml-footer-in">
      <p>© 2026 Maison Lune. A fictional demo, dreamed up on purpose.</p>
      <p>12, chemin du Lac Fictif, Magog QC · <a href="tel:+18195550142">(819) 555-0142</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo form: never submits anywhere
    (function () {
      var form = document.getElementById('ml-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.ml-form-note');
        var room = form?.querySelector('select[name="room"]') as HTMLSelectElement | null;
        var name = room ? room.value : 'your room';
        if (note) note.textContent = 'Good news: ' + name + ' is free for those dates. We have penciled you in for 48 hours.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .ml {
      --ml-night: #141B34;
      --ml-night-2: #1D2547;
      --ml-ink: #EDEAE2;
      --ml-silver: #C9D2E8;
      --ml-blush: #E8B4B8;
      --ml-gold: #D9BE7E;
      --ml-serif: "Cormorant Garamond", Georgia, serif;
      --ml-sans: "Jost", system-ui, sans-serif;
      margin: 0;
      background: var(--ml-night);
      color: var(--ml-ink);
      font-family: var(--ml-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ml *, .ml *::before, .ml *::after { box-sizing: border-box; }
    .ml img { display: block; max-width: 100%; }
    .ml-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .ml-wrap-narrow { max-width: 760px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .ml em { font-style: italic; color: var(--ml-blush); }

    /* nav */
    .ml-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .ml-nav {
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 18px clamp(22px, 4vw, 48px);
      background: linear-gradient(180deg, rgba(20,27,52,0.85), rgba(20,27,52,0));
    }
    .ml-nav-links { display: flex; gap: 28px; }
    .ml-nav-links a {
      font-family: var(--ml-sans); font-size: 12.5px; font-weight: 500;
      letter-spacing: 0.24em; text-transform: uppercase; color: var(--ml-silver); text-decoration: none;
    }
    .ml-nav-links a:hover { color: #fff; }
    .ml-logo {
      display: flex; align-items: center; gap: 10px; text-decoration: none;
      font-size: 26px; font-weight: 500; letter-spacing: 0.12em; color: #fff;
    }
    .ml-moon { color: var(--ml-gold); font-size: 24px; }
    .ml-nav-book { border: 1px solid var(--ml-silver); padding: 10px 20px; border-radius: 999px; }
    .ml-nav-book:hover { border-color: #fff; }

    /* type */
    .ml-kicker {
      font-family: var(--ml-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--ml-gold); text-align: center; margin: 0 0 20px;
    }
    .ml-h2 { font-size: clamp(2.6rem, 6vw, 4.4rem); font-weight: 400; line-height: 1.05; text-align: center; margin: 0 0 54px; }
    .ml-eyebrow {
      font-family: var(--ml-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--ml-silver); margin: 0 0 26px;
    }

    /* hero */
    .ml-hero { position: relative; min-height: 100svh; display: grid; place-items: center; overflow: hidden; text-align: center; }
    .ml-hero-bg { position: absolute; inset: -4%; }
    .ml-hero-bg img { width: 100%; height: 100%; object-fit: cover; animation: ml-kenburns 26s ease-in-out infinite alternate; }
    @keyframes ml-kenburns { from { transform: scale(1); } to { transform: scale(1.08); } }
    .ml-hero::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(20,27,52,0.62) 0%, rgba(20,27,52,0.25) 45%, rgba(20,27,52,0.92) 100%);
    }
    .ml-moonglow {
      position: absolute; top: 16%; right: 14%; width: 220px; height: 220px; border-radius: 50%;
      background: radial-gradient(circle, rgba(237,234,226,0.5), rgba(237,234,226,0.12) 45%, transparent 70%);
      filter: blur(6px); animation: ml-glow 7s ease-in-out infinite; z-index: 1;
    }
    @keyframes ml-glow { 50% { opacity: 0.65; transform: scale(1.06); } }
    .ml-star { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #fff; z-index: 1; animation: ml-twinkle 3.4s ease-in-out infinite; }
    .ml-s1 { top: 12%; left: 18%; }
    .ml-s2 { top: 22%; left: 64%; animation-delay: 1.1s; }
    .ml-s3 { top: 8%; left: 42%; animation-delay: 2s; width: 2px; height: 2px; }
    .ml-s4 { top: 30%; left: 30%; animation-delay: 0.6s; width: 2px; height: 2px; }
    .ml-s5 { top: 18%; left: 82%; animation-delay: 2.6s; }
    .ml-s6 { top: 36%; left: 74%; animation-delay: 1.7s; width: 2px; height: 2px; }
    @keyframes ml-twinkle { 50% { opacity: 0.15; } }
    .ml-hero-in { position: relative; z-index: 2; padding: 120px 24px 80px; }
    .ml-h1 { font-size: clamp(3.4rem, 9vw, 7rem); font-weight: 300; line-height: 1.02; margin: 0 0 26px; letter-spacing: 0.01em; }
    .ml-h1 em { font-weight: 400; }
    .ml-lede { font-size: 21px; font-style: italic; color: var(--ml-silver); max-width: 34ch; margin: 0 auto 38px; line-height: 1.6; }
    .ml-hero-cta { display: flex; gap: 26px; align-items: center; justify-content: center; flex-wrap: wrap; }
    .ml-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--ml-sans); font-size: 13px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--ml-night); background: var(--ml-ink); text-decoration: none; cursor: pointer;
      padding: 18px 42px; border-radius: 999px; border: none;
      transition: transform 0.2s ease, background 0.2s ease;
    }
    .ml-btn:hover { transform: translateY(-2px); background: #fff; }
    .ml-btn-full { width: 100%; }
    .ml-link { font-family: var(--ml-sans); font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ml-silver); text-decoration: none; border-bottom: 1px solid var(--ml-silver); padding-bottom: 4px; }
    .ml-link:hover { color: #fff; border-color: #fff; }

    /* story */
    .ml-story { padding: clamp(80px, 10vw, 140px) 0; background: linear-gradient(180deg, var(--ml-night), var(--ml-night-2)); }
    .ml-dropcap { font-size: 23px; line-height: 1.75; font-weight: 400; color: var(--ml-ink); margin: 0 0 44px; }
    .ml-dropcap::first-letter {
      font-size: 4.6em; float: left; line-height: 0.82; padding: 6px 14px 0 0;
      color: var(--ml-gold); font-weight: 500;
    }
    .ml-story-img { margin: 0; }
    .ml-story-img img { border-radius: 4px; width: 100%; height: clamp(280px, 40vw, 460px); object-fit: cover; }
    .ml-story-img figcaption { font-family: var(--ml-sans); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ml-silver); margin-top: 14px; text-align: center; }

    /* rooms */
    .ml-section { padding: clamp(80px, 10vw, 140px) 0; }
    .ml-rooms { display: grid; gap: clamp(60px, 8vw, 110px); }
    .ml-room { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(30px, 5vw, 70px); align-items: center; }
    .ml-room-flip .ml-room-media { order: 2; }
    .ml-room-flip .ml-room-copy { order: 1; text-align: right; }
    .ml-room-flip .ml-room-copy ul { justify-items: end; }
    .ml-room-media { position: relative; margin: 0; }
    .ml-room-media img { width: 100%; height: clamp(320px, 44vw, 520px); object-fit: cover; border-radius: 4px; }
    .ml-phase {
      position: absolute; top: 22px; left: 22px; width: 58px; height: 58px; border-radius: 50%;
      display: grid; place-items: center; font-size: 26px; color: var(--ml-night);
      background: rgba(237, 234, 226, 0.92); backdrop-filter: blur(4px);
    }
    .ml-room-no { font-family: var(--ml-sans); font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ml-gold); margin: 0 0 14px; }
    .ml-room-copy h3 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 400; margin: 0 0 16px; }
    .ml-room-copy p { font-size: 19px; line-height: 1.7; color: var(--ml-silver); margin: 0 0 20px; font-style: italic; }
    .ml-room-copy ul { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 8px; font-family: var(--ml-sans); font-size: 13.5px; letter-spacing: 0.08em; color: var(--ml-ink); }
    .ml-room-copy li::before { content: "✦ "; color: var(--ml-gold); }
    .ml-room-price { font-size: 30px !important; font-style: normal !important; color: var(--ml-ink) !important; }
    .ml-room-price span { font-size: 16px; color: var(--ml-silver); }

    /* experiences strip */
    .ml-exp { padding: clamp(80px, 10vw, 130px) 0; background: var(--ml-night-2); overflow: hidden; }
    .ml-strip { display: flex; gap: 26px; overflow-x: auto; padding: 10px clamp(22px, 4vw, 44px) 30px; scrollbar-width: thin; }
    .ml-strip figure { margin: 0; flex: none; width: min(400px, 80vw); }
    .ml-strip img { width: 100%; height: 300px; object-fit: cover; border-radius: 200px 200px 4px 4px; }
    .ml-strip figcaption { display: grid; gap: 8px; padding-top: 18px; text-align: center; }
    .ml-strip figcaption strong { font-size: 24px; font-weight: 500; }
    .ml-strip figcaption span { font-family: var(--ml-sans); font-size: 14px; color: var(--ml-silver); line-height: 1.6; }

    /* booking */
    .ml-book {
      background: rgba(237, 234, 226, 0.05); border: 1px solid rgba(201, 210, 232, 0.25);
      border-radius: 8px; padding: clamp(36px, 6vw, 64px); text-align: center;
    }
    .ml-book-sub { font-size: 19px; font-style: italic; color: var(--ml-silver); max-width: 44ch; margin: 0 auto 36px; line-height: 1.65; }
    .ml-form { display: grid; gap: 18px; text-align: left; max-width: 560px; margin: 0 auto; }
    .ml-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .ml-form label { display: grid; gap: 10px; font-family: var(--ml-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ml-silver); }
    .ml-form input, .ml-form select {
      font-family: var(--ml-serif); font-size: 19px; color: var(--ml-ink);
      background: transparent; border: none; border-bottom: 1px solid rgba(201, 210, 232, 0.4);
      padding: 10px 2px; width: 100%; color-scheme: dark;
    }
    .ml-form input:focus, .ml-form select:focus { outline: none; border-bottom-color: var(--ml-gold); }
    .ml-form-note { margin: 0; text-align: center; font-size: 18px; font-style: italic; color: var(--ml-blush); }
    .ml-form-note:empty { display: none; }
    .ml-book-alt { margin: 28px 0 0; font-family: var(--ml-sans); font-size: 14px; letter-spacing: 0.06em; color: var(--ml-silver); }
    .ml-book-alt a { color: var(--ml-gold); }

    /* quotes */
    .ml-quotes { padding: 0 0 clamp(80px, 10vw, 130px); }
    .ml-quotes .ml-wrap-narrow { display: grid; gap: 44px; }
    .ml-quotes blockquote { margin: 0; text-align: center; }
    .ml-quotes blockquote p { font-size: clamp(1.5rem, 3.4vw, 2.1rem); font-style: italic; line-height: 1.5; margin: 0 0 14px; color: var(--ml-ink); }
    .ml-quotes cite { font-family: var(--ml-sans); font-style: normal; font-size: 12.5px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ml-gold); }

