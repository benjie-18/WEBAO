---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Maison Lune, fictional lakeside inn, Magog.
// Standalone art direction. Night blues, moon silver. Not connected to the WEBAO theme system.
// Structure: a cabin journal. Dated guest entries with photos; the four rooms are
// revealed through stories, never as cards. The table of contents is the nav.
const IMG = {
  hero: "/demos/maison-lune/01.jpg",
  cabin: "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?q=80&w=1200&auto=format&fit=crop",
  room1: "https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1000&auto=format&fit=crop",
  room2: "https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=1000&auto=format&fit=crop",
  room3: "https://live.staticflickr.com/4094/4782854535_9d45e25d2c_b.jpg",
  room4: "https://images.unsplash.com/photo-1591088398332-8a7791972843?q=80&w=1000&auto=format&fit=crop",
  dining: "/demos/maison-lune/02.jpg",
  canoe: "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=1000&auto=format&fit=crop",
};

const ENTRIES = [
  {
    id: "june-12", date: "June 12", year: "2026", no: "nº 04", phase: "●",
    title: "The loons were loud this morning",
    body: [
      "Woke at five to a pair of loons arguing outside the window. In Full Moon the bed faces east, so the sunrise finished the job. I took the canoe out before breakfast while the lake was still deciding what color to be.",
      "Back at the house, the long table was already loud. Someone had saved me the window seat and the last of the coffee, which is the closest thing to love this journal has recorded.",
    ],
    photo: IMG.canoe, photoAlt: "Canoe gliding on the calm morning lake",
    caption: "The lake at six, before it made up its mind.",
    room: "Full Moon", roomImg: IMG.room1, roomAlt: "The Full Moon room with a view of the lake",
    roomLine: "The corner room, windows on two sides of the water. King bed, soaking tub, $285 a night.",
    weather: "14°C, mist on the water", heard: "Loons, a screen door",
  },
  {
    id: "july-30", date: "July 30", year: "2026", no: "nº 03", phase: "◐",
    title: "The long breakfast ran till noon",
    body: [
      "Nobody left the table. The granola ran out, then the second batch did too, and still nobody moved. Breakfast here is served from eight to eleven, but the table keeps its own hours.",
      "In the afternoon I finished a whole novel in the Half Moon reading chair, the one the house warns you about. Dinner was leftover pie on the dock, eaten with our feet in the water.",
    ],
    photo: IMG.dining, photoAlt: "Breakfast table set with local food",
    caption: "One table, eleven strangers, zero hurry.",
    room: "Half Moon", roomImg: IMG.room2, roomAlt: "The Half Moon room in soft morning light",
    roomLine: "Half lake, half pine forest. The quietest room in the house. Queen bed, reading nook, $225 a night.",
    weather: "28°C, not a breath of wind", heard: "Cutlery, pages turning",
  },
  {
    id: "sept-8", date: "September 8", year: "2026", no: "nº 02", phase: "○",
    title: "The lake turned to glass",
    body: [
      "Not a ripple by seven. We carried the telescope to the deck but the sky was still too bright, so we just watched the mountains double themselves in the water instead.",
      "Then I slept ten hours straight in New Moon. Ten. I have small children; this simply never happens. The blackout shutters deserve their own entry.",
    ],
    photo: IMG.cabin, photoAlt: "The inn on the lake at dusk",
    caption: "The house from the water, just after the loons go quiet.",
    room: "New Moon", roomImg: IMG.room3, roomAlt: "The New Moon room, dark and cocoon-like",
    roomLine: "Dark, cocooning, built for deep sleep. King bed, weighted blanket, $245 a night.",
    weather: "18°C, clear all night", heard: "Nothing, gloriously",
  },
  {
    id: "oct-3", date: "October 3", year: "2026", no: "nº 01", phase: "☾",
    title: "First frost on the dock",
    body: [
      "Woke to white on the boards and steam rising off the water. The attic room keeps its warmth like a secret; we lay under the skylight and watched the stars thin out until the cold won.",
      "Breakfast tasted like the end of something good. We are already arguing about which week to steal next year.",
    ],
    photo: IMG.hero, photoAlt: "Full moon over the lake at night",
    caption: "October does the sky's best work.",
    room: "Crescent", roomImg: IMG.room4, roomAlt: "The Crescent room with warm wood tones",
    roomLine: "The attic under the eaves, all warm wood and low light. Writing desk, skylight for stargazing, $195 a night.",
    weather: "2°C, frost on the dock", heard: "The dock creaking",
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="maison-lune" locale="en" title="Maison Lune: a lakeside inn journal · Magog" description="The Cabin Journal of Maison Lune: dated notes from a four-room inn on Lake Memphremagog. Read the entries, then write your own." ogImage="https://webao.ca/demos/maison-lune/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="ml">

  <!-- TOC NAV -->
  <header class="ml-navwrap">
    <nav class="ml-nav" aria-label="Journal contents">
      <a class="ml-brand" href="#top" aria-label="Maison Lune, back to the cover"><span aria-hidden="true">☾</span> Maison Lune</a>
      <div class="ml-toc" role="list">
        {ENTRIES.map((e) => (
          <a role="listitem" href={"#" + e.id}>{e.date}</a>
        ))}
      </div>
      <a class="ml-reserve" href="#book">Reserve</a>
    </nav>
  </header>

  <main id="top">
    <!-- COVER: typographic, no hero image -->
    <section class="ml-cover" aria-label="Journal cover">
      <div class="ml-wrap-narrow">
        <p class="ml-cover-kicker">Est. 1928 · Lake Memphremagog · Magog</p>
        <h1 class="ml-h1">The Cabin<br /><em>Journal</em></h1>
        <p class="ml-cover-sub">Notes from a four-room inn above the water. Guests write the entries; the lake edits them. Four rooms, one long breakfast table, and a dock that belongs to whoever wakes first.</p>
        <p class="ml-cover-rule" aria-hidden="true">✦ ✦ ✦</p>
      </div>
    </section>

    <!-- ENTRIES -->
    {ENTRIES.map((e) => (
      <article class="ml-entry" id={e.id} aria-labelledby={e.id + "-title"}>
        <div class="ml-wrap-entry">
          <header class="ml-entry-head">
            <p class="ml-entry-no">{e.no} · {e.year}</p>
            <h2 class="ml-entry-date" id={e.id + "-title"}><span class="ml-phase" aria-hidden="true">{e.phase}</span> {e.date}</h2>
            <p class="ml-entry-title"><em>{e.title}</em></p>
          </header>
          <div class="ml-entry-grid">
            <div class="ml-entry-body">
              {e.body.map((p) => (<p>{p}</p>))}
              <figure class="ml-entry-photo">
                <img src={e.photo} alt={e.photoAlt} loading="lazy" decoding="async" />
                <figcaption>{e.caption}</figcaption>
              </figure>
            </div>
            <aside class="ml-margin" aria-label={"Notes for the entry of " + e.date}>
              <figure class="ml-roomfig">
                <img src={e.roomImg} alt={e.roomAlt} loading="lazy" decoding="async" />
                <figcaption><strong>Stayed in: {e.room}</strong><span>{e.roomLine}</span></figcaption>
              </figure>
              <dl class="ml-notes">
                <div><dt>Weather</dt><dd>{e.weather}</dd></div>
                <div><dt>Heard</dt><dd>{e.heard}</dd></div>
              </dl>
            </aside>
          </div>
        </div>
      </article>
    ))}

    <!-- YOUR ENTRY: booking -->
    <section class="ml-book" id="book">
      <div class="ml-wrap-narrow">
        <p class="ml-kicker">✦ your turn ✦</p>
        <h2 class="ml-h2">Your entry <em>starts here</em></h2>
        <p class="ml-book-sub">Booking direct means the best rate, the best room, and a jar of our granola on arrival. Two-night minimum on weekends. Pick the room your story needs.</p>
        <form class="ml-form" id="ml-form" novalidate>
          <div class="ml-form-row">
            <label>Check-in<input type="date" name="in" required /></label>
            <label>Check-out<input type="date" name="out" required /></label>
          </div>
          <div class="ml-form-row">
            <label>Guests
              <select name="guests">
                <option>1 guest</option>
                <option selected>2 guests</option>
                <option>3 guests</option>
                <option>4 guests</option>
              </select>
            </label>
            <label>Room
              <select name="room">
                <option>Full Moon</option>
                <option>Half Moon</option>
                <option>New Moon</option>
                <option>Crescent</option>
              </select>
            </label>
          </div>
          <button class="ml-btn ml-btn-full" type="submit">Check availability</button>
          <p class="ml-form-note" role="status" aria-live="polite"></p>
        </form>
        <p class="ml-book-alt">Prefer a human? Call <a href="tel:+18195550142">(819) 555-0142</a>, we answer between breakfasts.</p>
      </div>
    </section>
  </main>

  <footer class="ml-footer">
    <p class="ml-footer-moon" aria-hidden="true">☾</p>
    <p class="ml-footer-name">Maison Lune</p>
    <div class="ml-wrap ml-footer-in">
      <p>© 2026 Maison Lune. A fictional demo, dreamed up on purpose.</p>
      <p>12, chemin du Lac Fictif, Magog QC · <a href="tel:+18195550142">(819) 555-0142</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo form: never submits anywhere
    (function () {
      var form = document.getElementById('ml-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.ml-form-note');
        var room = form?.querySelector('select[name="room"]') as HTMLSelectElement | null;
        var name = room ? room.value : 'your room';
        if (note) note.textContent = 'Good news: ' + name + ' is free for those dates. We have penciled you in for 48 hours.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .ml {
      --ml-night: #141B34;
      --ml-night-2: #1D2547;
      --ml-page: #1A2140;
      --ml-ink: #EDEAE2;
      --ml-silver: #C9D2E8;
      --ml-dim: #8E97B8;
      --ml-blush: #E8B4B8;
      --ml-gold: #D9BE7E;
      --ml-serif: "Cormorant Garamond", Georgia, serif;
      --ml-sans: "Jost", system-ui, sans-serif;
      margin: 0;
      background: var(--ml-night);
      color: var(--ml-ink);
      font-family: var(--ml-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ml *, .ml *::before, .ml *::after { box-sizing: border-box; }
    .ml img { display: block; max-width: 100%; }
    .ml-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .ml-wrap-narrow { max-width: 720px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .ml-wrap-entry { max-width: 1020px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .ml em { font-style: italic; color: var(--ml-blush); }

    /* toc nav */
    .ml-navwrap { position: sticky; top: 0; z-index: 60; background: rgba(20, 27, 52, 0.92); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(201, 210, 232, 0.16); }
    .ml-nav { display: flex; align-items: center; gap: 22px; padding: 14px clamp(22px, 4vw, 48px); }
    .ml-brand {
      font-family: var(--ml-sans); font-size: 15px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--ml-ink); text-decoration: none; display: flex; align-items: center; gap: 10px; white-space: nowrap;
    }
    .ml-brand span { color: var(--ml-gold); font-size: 19px; }
    .ml-toc { display: flex; gap: 4px; margin-left: auto; overflow-x: auto; }
    .ml-toc a {
      font-family: var(--ml-sans); font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ml-dim); text-decoration: none; padding: 8px 12px; white-space: nowrap;
    }
    .ml-toc a:hover { color: var(--ml-gold); }
    .ml-reserve {
      font-family: var(--ml-sans); font-size: 12.5px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--ml-night); background: var(--ml-gold); text-decoration: none; padding: 10px 20px; border-radius: 999px; white-space: nowrap;
    }
    .ml-reserve:hover { filter: brightness(1.1); }

    /* cover */
    .ml-cover { padding: clamp(90px, 12vw, 150px) 0 clamp(60px, 8vw, 100px); text-align: center; }
    .ml-cover-kicker { font-family: var(--ml-sans); font-size: 12.5px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--ml-dim); margin: 0 0 28px; }
    .ml-h1 { font-size: clamp(3.6rem, 11vw, 7.5rem); line-height: 0.95; font-weight: 500; margin: 0 0 30px; }
    .ml-cover-sub { font-size: clamp(1.15rem, 2.4vw, 1.4rem); line-height: 1.7; color: var(--ml-silver); margin: 0 auto 34px; max-width: 44ch; }
    .ml-cover-rule { color: var(--ml-gold); letter-spacing: 1.2em; margin: 0; text-indent: 1.2em; }

    /* entries */
    .ml-entry { padding: clamp(56px, 8vw, 100px) 0; border-top: 1px solid rgba(201, 210, 232, 0.14); }
    .ml-entry-head { text-align: center; margin-bottom: clamp(30px, 4vw, 48px); }
    .ml-entry-no { font-family: var(--ml-sans); font-size: 12px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--ml-dim); margin: 0 0 14px; }
    .ml-entry-date { font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 500; margin: 0 0 10px; line-height: 1; }
    .ml-phase { color: var(--ml-gold); font-size: 0.7em; vertical-align: 0.18em; margin-right: 0.25em; }
    .ml-entry-title { font-size: clamp(1.3rem, 3vw, 1.7rem); margin: 0; color: var(--ml-silver); }
    .ml-entry-grid { display: grid; grid-template-columns: 1fr 240px; gap: clamp(28px, 5vw, 70px); align-items: start; }
    .ml-entry-body > p { font-size: 1.22rem; line-height: 1.85; margin: 0 0 1.4em; color: var(--ml-ink); }
    .ml-entry-body > p:first-of-type::first-letter {
      font-size: 3.4em; float: left; line-height: 0.82; padding: 0.08em 0.12em 0 0; color: var(--ml-gold); font-weight: 600;
    }
    .ml-entry-photo { margin: 2.2em 0 0; }
    .ml-entry-photo img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border: 1px solid rgba(201, 210, 232, 0.2); }
    .ml-entry-photo figcaption, .ml-roomfig figcaption span { font-family: var(--ml-sans); font-size: 13px; letter-spacing: 0.04em; color: var(--ml-dim); margin-top: 12px; line-height: 1.6; display: block; }

    /* marginalia */
    .ml-margin { border-left: 1px solid rgba(201, 210, 232, 0.2); padding-left: 26px; display: grid; gap: 26px; position: sticky; top: 120px; }
    .ml-roomfig { margin: 0; }
    .ml-roomfig img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border: 1px solid rgba(201, 210, 232, 0.2); filter: sepia(0.22) brightness(0.94); }
    .ml-roomfig figcaption strong { font-family: var(--ml-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ml-gold); display: block; margin-top: 12px; }
    .ml-notes { margin: 0; display: grid; gap: 14px; }
    .ml-notes div { display: grid; gap: 4px; }
    .ml-notes dt { font-family: var(--ml-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ml-dim); }
    .ml-notes dd { margin: 0; font-size: 1.08rem; font-style: italic; color: var(--ml-silver); }

    /* booking */
    .ml-kicker { font-family: var(--ml-sans); font-size: 12.5px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--ml-gold); margin: 0 0 18px; text-align: center; }
    .ml-h2 { font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 500; margin: 0 0 20px; text-align: center; line-height: 1.05; }
    .ml-book { padding: clamp(70px, 10vw, 130px) 0; border-top: 1px solid rgba(201, 210, 232, 0.14); background: var(--ml-night-2); }
    .ml-book-sub { text-align: center; font-size: 1.18rem; line-height: 1.75; color: var(--ml-silver); margin: 0 0 36px; }
    .ml-form { display: grid; gap: 18px; background: var(--ml-night); border: 1px solid rgba(201, 210, 232, 0.18); padding: clamp(26px, 4vw, 40px); }
    .ml-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .ml-form label { display: grid; gap: 8px; font-family: var(--ml-sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ml-dim); }
    .ml-form input, .ml-form select {
      font-family: var(--ml-serif); font-size: 1.1rem; color: var(--ml-ink);
      background: var(--ml-page); border: 1px solid rgba(201, 210, 232, 0.25); padding: 13px 16px; width: 100%; color-scheme: dark;
    }
    .ml-form input:focus, .ml-form select:focus { outline: 2px solid var(--ml-gold); outline-offset: 2px; }
    .ml-btn {
      font-family: var(--ml-sans); font-size: 14px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
      background: var(--ml-gold); color: var(--ml-night); border: none; padding: 18px 34px; cursor: pointer; text-decoration: none; display: inline-block;
    }
    .ml-btn:hover { filter: brightness(1.1); }
    .ml-btn-full { width: 100%; }
    .ml-form-note { margin: 0; color: var(--ml-gold); font-size: 1.1rem; font-style: italic; text-align: center; }
    .ml-form-note:empty { display: none; }
    .ml-book-alt { text-align: center; color: var(--ml-dim); font-size: 1.1rem; margin: 26px 0 0; font-style: italic; }
    .ml-book-alt a { color: var(--ml-gold); }

    /* footer */
    .ml-footer { text-align: center; padding: 70px 0 90px; border-top: 1px solid rgba(201, 210, 232, 0.14); }
    .ml-footer-moon { font-size: 44px; color: var(--ml-gold); margin: 0 0 10px; }
    .ml-footer-name { font-size: 1.9rem; margin: 0 0 22px; }
    .ml-footer-in { display: grid; gap: 8px; color: var(--ml-dim); font-family: var(--ml-sans); font-size: 13.5px; letter-spacing: 0.06em; }
    .ml-footer-in p { margin: 0; }
    .ml-footer-in a { color: var(--ml-gold); }

    @media (max-width: 900px) {
      .ml-entry-grid { grid-template-columns: 1fr; }
      .ml-margin { border-left: none; padding-left: 0; border-top: 1px solid rgba(201, 210, 232, 0.2); padding-top: 26px; position: static; grid-template-columns: 200px 1fr; align-items: start; }
    }
    @media (max-width: 640px) {
      .ml-toc { display: none; }
      .ml-margin { grid-template-columns: 1fr; }
      .ml-form-row { grid-template-columns: 1fr; }
      .ml-entry-body > p { font-size: 1.12rem; }
    }
  </style>
</body>
</html>
