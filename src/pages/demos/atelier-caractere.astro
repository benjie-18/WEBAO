---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Atelier Caractère, fictional high-end type foundry, Montréal.
// Standalone art direction. Luxury typography: ivory, ink, gold, enormous serif.
// Not connected to the WEBAO theme system.
// REBUILD: the page IS a printed specimen. Cover, index, an interactive type
// tester, four family spreads, plates, a price list, and a colophon.
// Typography is the entire visual experience.
const IMG = {
  editorial: "/demos/atelier-caractere/01.jpg",
  stationery: "/demos/atelier-caractere/02.jpg",
  publishing: "/demos/atelier-caractere/03.jpg",
  foundry: "/demos/atelier-caractere/04.jpg",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="atelier-caractere" locale="en" title="Atelier Caractère: Specimen Nº 24 | Fine Type Foundry, Montréal" description="Specimen Nº 24 from Atelier Caractère, fictional Montréal type foundry. Try the type tester, browse four families, read the colophon. Drawn by hand since 2011." ogImage="https://webao.ca/demos/atelier-caractere/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
</head>
<body class="ac">

  <!-- NAV: a running head, like a book -->
  <header class="ac-navwrap">
    <nav class="ac-nav" aria-label="Primary">
      <a class="ac-logo" href="#top" aria-label="Atelier Caractère, home">A<span>C</span></a>
      <p class="ac-running" aria-hidden="true">Specimen Nº 24 · Atelier Caractère · Montréal</p>
      <button class="ac-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="ac-menu">
        <span></span><span></span>
      </button>
      <div class="ac-nav-links" id="ac-menu">
        <a href="#index">Index</a>
        <a href="#tester">Tester</a>
        <a href="#licensing">Licensing</a>
        <a class="ac-nav-cta" href="#contact">Request a license</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- COVER -->
    <section class="ac-cover">
      <p class="ac-cover-no">Specimen Nº 24</p>
      <p class="ac-giant" aria-hidden="true">A<span class="ac-giant-amp">a</span></p>
      <h1 class="ac-cover-title">Atelier <em>Caractère</em></h1>
      <p class="ac-cover-sub">Four families · twenty-one weights · drawn by hand<br />Montréal · MMXI–MMXXVI</p>
      <div class="ac-rule" aria-hidden="true"><span>◆</span></div>
      <p class="ac-cover-note">Letterforms that outlive their century. Turn the page.</p>
    </section>

    <!-- INDEX -->
    <section class="ac-index" id="index">
      <div class="ac-wrap">
        <h2 class="ac-index-title">Index</h2>
        <ol class="ac-toc">
          <li><a href="#tester"><span>I</span> The type tester <em>try before you license</em></a></li>
          <li><a href="#display"><span>II</span> Caractère Display <em>high-contrast didone · 9 weights</em></a></li>
          <li><a href="#texte"><span>III</span> Caractère Texte <em>transitional text serif · 6 weights</em></a></li>
          <li><a href="#italique"><span>IV</span> Caractère Italique <em>calligraphic italic · 4 weights</em></a></li>
          <li><a href="#capitales"><span>V</span> Caractère Capitales <em>ceremonial small caps · 2 weights</em></a></li>
          <li><a href="#inuse"><span>VI</span> Plates <em>our letters, out in the world</em></a></li>
          <li><a href="#licensing"><span>VII</span> Licensing <em>an honest price, forever</em></a></li>
          <li><a href="#colophon"><span>VIII</span> Colophon <em>the foundry, in brief</em></a></li>
        </ol>
      </div>
    </section>

    <!-- TYPE TESTER -->
    <section class="ac-tester" id="tester">
      <div class="ac-wrap">
        <p class="ac-folio">I · The type tester</p>
        <h2 class="ac-h2">Set your own <em>words.</em></h2>
        <div class="ac-test-controls">
          <label class="ac-test-text">Your text
            <input type="text" id="ac-test-input" value="The quick brown fox" maxlength="60" autocomplete="off" />
          </label>
          <label class="ac-test-size">Size
            <input type="range" id="ac-test-size" min="28" max="130" value="72" step="2" />
          </label>
          <div class="ac-test-fams" role="group" aria-label="Choose a family">
            <button type="button" class="ac-fam ac-fam-on" data-fam="display" aria-pressed="true">Display</button>
            <button type="button" class="ac-fam" data-fam="texte" aria-pressed="false">Texte</button>
            <button type="button" class="ac-fam" data-fam="italique" aria-pressed="false">Italique</button>
            <button type="button" class="ac-fam" data-fam="capitales" aria-pressed="false">Capitales</button>
          </div>
        </div>
        <p class="ac-test-preview ac-prev-display" id="ac-test-preview" aria-live="polite">The quick brown fox</p>
        <p class="ac-test-note">Rendered live in the family you chose. Imagine it on your book jacket.</p>
      </div>
    </section>

    <!-- FAMILY SPREADS -->
    <section class="ac-spread" id="display">
      <div class="ac-wrap">
        <p class="ac-folio">II · Caractère Display</p>
        <h2 class="ac-h2">High-contrast <em>didone.</em></h2>
        <p class="ac-spread-class">9 weights · for headlines · cut for sizes above 48 pt</p>
        <p class="ac-alpha ac-w900">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
        <p class="ac-nums ac-w900">0123456789 &amp; § † ‡</p>
        <div class="ac-ramp">
          <p class="ac-r1">The quick brown fox</p>
          <p class="ac-r2">The quick brown fox</p>
          <p class="ac-r3">The quick brown fox jumps over the lazy dog.</p>
        </div>
        <p class="ac-margin-note">Ink traps drawn in by hand. The hairlines will not forgive cheap paper.</p>
      </div>
    </section>

    <section class="ac-spread ac-spread-deep" id="texte">
      <div class="ac-wrap">
        <p class="ac-folio">III · Caractère Texte</p>
        <h2 class="ac-h2">The quiet <em>workhorse.</em></h2>
        <p class="ac-spread-class">6 weights · for long reading · optical sizes 6 to 14 pt</p>
        <p class="ac-alpha ac-w400">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
        <p class="ac-nums ac-w400">0123456789 &amp; § † ‡</p>
        <p class="ac-para">We believe a text face should disappear. Set solid, tracked a touch open, Caractère Texte carries novels, annual reports, and wedding invitations with the same quiet confidence. It asks for nothing and gives everything back.</p>
        <p class="ac-margin-note">True small caps included. Your footnotes will thank you.</p>
      </div>
    </section>

    <section class="ac-spread" id="italique">
      <div class="ac-wrap">
        <p class="ac-folio">IV · Caractère Italique</p>
        <h2 class="ac-h2"><em>Written,</em> not slanted.</h2>
        <p class="ac-spread-class">4 weights · for emphasis · drawn from broad-nib studies</p>
        <p class="ac-alpha ac-italic ac-w600">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
        <p class="ac-nums ac-italic">0123456789 &amp; § † ‡</p>
        <p class="ac-sample ac-italic ac-w600">Elegance is refusal, said with a flourish.</p>
        <p class="ac-margin-note">Drawn from broad-nib studies, never slanted from the roman. There is a difference, and you can feel it.</p>
      </div>
    </section>

    <section class="ac-spread ac-spread-deep" id="capitales">
      <div class="ac-wrap">
        <p class="ac-folio">V · Caractère Capitales</p>
        <h2 class="ac-h2">For <em>occasions.</em></h2>
        <p class="ac-spread-class">2 weights · ceremonial small caps</p>
        <p class="ac-alpha ac-caps ac-w600">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />0123456789</p>
        <p class="ac-sample ac-caps ac-w600">Chapitre premier · Édition limitée</p>
        <p class="ac-margin-note">For title pages, colophons, and very good news.</p>
      </div>
    </section>

    <!-- PLATES -->
    <section class="ac-plates" id="inuse">
      <div class="ac-wrap">
        <p class="ac-folio">VI · Plates</p>
        <h2 class="ac-h2">Our letters, <em>out in the world.</em></h2>
        <div class="ac-plate-grid">
          <figure class="ac-plate">
            <img src={IMG.editorial} alt="Type specimen posters for Baskerville, Sabon and Univers" loading="lazy" decoding="async" />
            <figcaption><span>Plate 1 · Editorial</span>Magazine « Marge », set in Caractère Texte</figcaption>
          </figure>
          <figure class="ac-plate">
            <img src={IMG.stationery} alt="Decorative alphabet in varied display styles" loading="lazy" decoding="async" />
            <figcaption><span>Plate 2 · Stationery</span>Correspondence suite, Caractère Italique</figcaption>
          </figure>
          <figure class="ac-plate">
            <img src={IMG.publishing} alt="Bold geometric alphabet specimen, Caractere Display" loading="lazy" decoding="async" />
            <figcaption><span>Plate 3 · Publishing</span>Book jackets, Caractère Display</figcaption>
          </figure>
        </div>
        <p class="ac-plate-note">A selection of fictional commissions. Real commissions welcome.</p>
      </div>
    </section>

    <!-- LICENSING: a price list, not cards -->
    <section class="ac-licensing" id="licensing">
      <div class="ac-wrap">
        <p class="ac-folio ac-folio-light">VII · Licensing</p>
        <h2 class="ac-h2 ac-h2-light">An honest price, <em>forever.</em></h2>
        <p class="ac-lic-lede">One payment. Yours to keep. Every license includes all four families, all weights, and our famous kerning.</p>
        <table class="ac-price">
          <thead>
            <tr><th scope="col">License</th><th scope="col">Includes</th><th scope="col">Price</th><th scope="col"><span class="ac-sr">Choose</span></th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Bureau</th>
              <td>5 workstations · desktop fonts (OTF) · print and static documents · free updates for life</td>
              <td>$95</td>
              <td><a href="#contact">Choose</a></td>
            </tr>
            <tr>
              <th scope="row">Studio</th>
              <td>20 workstations · desktop + webfonts (WOFF2) · unlimited page views · client work included · free updates for life</td>
              <td>$290</td>
              <td><a href="#contact">Choose</a></td>
            </tr>
            <tr>
              <th scope="row">Maison</th>
              <td>Unlimited workstations · desktop, web, and app embedding · broadcast and signage · priority support, by letter if you wish</td>
              <td>$890</td>
              <td><a href="#contact">Choose</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- COLOPHON -->
    <section class="ac-colophon" id="colophon">
      <div class="ac-wrap ac-col-in">
        <figure class="ac-col-img">
          <img src={IMG.foundry} alt="Colorful letterpress wood type poster on the proofing wall" loading="lazy" decoding="async" />
          <figcaption>The proofing wall, rue de l'Imprimerie.</figcaption>
        </figure>
        <div>
          <p class="ac-folio">VIII · Colophon</p>
          <h2 class="ac-h2">Slow letters,<br />drawn <em>by hand.</em></h2>
          <p>Founded in 2011 in a former print shop on rue de l'Imprimerie, Atelier Caractère is three punchcutters, two apprentices, and one very patient cat. We draw every glyph on paper first. We kern in silence. We proof until the ink behaves.</p>
          <p>We release one family a year. Some years, we release a comma.</p>
          <dl class="ac-col-stats">
            <div><dt>Founded</dt><dd>2011</dd></div>
            <div><dt>Families</dt><dd>24</dd></div>
            <div><dt>Glyphs per family</dt><dd>1,400</dd></div>
            <div><dt>Punchcutters</dt><dd>3</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- CORRESPONDENCE -->
    <section class="ac-contact" id="contact">
      <div class="ac-wrap ac-contact-in">
        <div class="ac-contact-copy">
          <p class="ac-folio">Correspondence</p>
          <h2 class="ac-h2">Write to us.<br /><em>We love letters.</em></h2>
          <p>For licenses, custom typefaces, or simply to talk about serifs. We answer every letter within two business days.</p>
          <ul class="ac-contact-list">
            <li><strong>Atelier</strong><span>418, rue de l'Imprimerie, Montréal QC</span></li>
            <li><strong>Telephone</strong><span><a href="tel:+15145550198">(514) 555-0198</a></span></li>
            <li><strong>Email</strong><span><a href="mailto:bonjour@atelier-caractere.com">bonjour@atelier-caractere.com</a></span></li>
          </ul>
        </div>
        <form class="ac-form" id="ac-form" novalidate>
          <label>Your name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>Interest
            <select name="interest">
              <option>Bureau license</option>
              <option>Studio license</option>
              <option>Maison license</option>
              <option>Custom typeface</option>
              <option>Just talking serifs</option>
            </select>
          </label>
          <label>Your message
            <textarea name="message" rows="4" placeholder="Dear Atelier,"></textarea>
          </label>
          <button class="ac-btn ac-btn-gold" type="submit">Send the letter</button>
          <p class="ac-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="ac-footer">
    <p class="ac-footer-giant" aria-hidden="true">Aa</p>
    <div class="ac-wrap ac-footer-in">
      <p>© 2026 Atelier Caractère. Fictional demo. Set in Caractère Display.</p>
      <p>418, rue de l'Imprimerie, Montréal QC · <a href="tel:+15145550198">(514) 555-0198</a> · <a href="mailto:bonjour@atelier-caractere.com">bonjour@atelier-caractere.com</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      // Mobile menu toggle
      var burgerEl = document.querySelector('.ac-burger');
      var navEl = document.querySelector('.ac-navwrap');
      if (burgerEl instanceof HTMLButtonElement) {
        var burger = burgerEl;
        var nav = navEl;
        burger.addEventListener('click', function () {
          var open = nav ? nav.classList.toggle('ac-nav-open') : false;
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
          burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });
        document.querySelectorAll('.ac-nav-links a').forEach(function (a) {
          a.addEventListener('click', function () {
            if (nav) nav.classList.remove('ac-nav-open');
            burger.setAttribute('aria-expanded', 'false');
            burger.setAttribute('aria-label', 'Open menu');
          });
        });
      }
      // Type tester
      var input = document.getElementById('ac-test-input');
      var size = document.getElementById('ac-test-size');
      var preview = document.getElementById('ac-test-preview');
      var fams = document.querySelectorAll('.ac-fam');
      var updateText = function () {
        if (preview && input instanceof HTMLInputElement) {
          preview.textContent = input.value.trim() === '' ? 'The quick brown fox' : input.value;
        }
      };
      var updateSize = function () {
        if (preview && size instanceof HTMLInputElement) preview.style.fontSize = size.value + 'px';
      };
      if (input instanceof HTMLInputElement) input.addEventListener('input', updateText);
      if (size instanceof HTMLInputElement) size.addEventListener('input', updateSize);
      fams.forEach(function (btn) {
        btn.addEventListener('click', function () {
          fams.forEach(function (b) {
            b.classList.remove('ac-fam-on');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('ac-fam-on');
          btn.setAttribute('aria-pressed', 'true');
          if (preview) {
            preview.className = 'ac-test-preview ac-prev-' + (btn.getAttribute('data-fam') || 'display');
            updateText();
            updateSize();
          }
        });
      });
      updateText();
      updateSize();
      // Demo form: never submits anywhere
      var formEl = document.getElementById('ac-form');
      if (formEl instanceof HTMLFormElement) {
        var form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.ac-form-note');
          if (note) note.textContent = 'Thank you. We will write back within two business days, in a beautiful typeface.';
          form.reset();
        });
      }
    })();
  </script>

  <style>
    .ac {
      --ac-ivory: #F7F3EA;
      --ac-ivory-deep: #EFE8D8;
      --ac-card: #FFFDF8;
      --ac-ink: #0E0D0B;
      --ac-ink-soft: #3A3733;
      --ac-gold: #C6A15B;
      --ac-gold-deep: #96742F;
      --ac-line: rgba(14, 13, 11, 0.18);
      --ac-serif: "Playfair Display", "Didot", Georgia, serif;
      --ac-sans: system-ui, -apple-system, "Segoe UI", sans-serif;
      margin: 0;
      background: var(--ac-ivory);
      color: var(--ac-ink);
      font-family: var(--ac-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ac *, .ac *::before, .ac *::after { box-sizing: border-box; }
    .ac img { display: block; max-width: 100%; }
    .ac-wrap { max-width: 1140px; margin: 0 auto; padding: 0 clamp(24px, 5vw, 48px); }
    .ac-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* folio + headings */
    .ac-folio {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 600;
      letter-spacing: 0.38em; text-transform: uppercase; color: var(--ac-gold-deep);
      margin: 0 0 22px;
    }
    .ac-folio-light { color: var(--ac-gold); }
    .ac-h2 { font-weight: 600; font-size: clamp(2.3rem, 5.2vw, 3.9rem); line-height: 1.08; margin: 0 0 40px; }
    .ac-h2 em { font-style: italic; font-weight: 500; color: var(--ac-gold-deep); }
    .ac-h2-light { color: var(--ac-ivory); }
    .ac-h2-light em { color: var(--ac-gold); }

    /* buttons */
    .ac-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--ac-sans); font-weight: 600; font-size: 12.5px; letter-spacing: 0.24em; text-transform: uppercase;
      padding: 18px 40px; text-decoration: none; cursor: pointer;
      background: var(--ac-ink); color: var(--ac-ivory); border: 1px solid var(--ac-ink);
      transition: background 0.25s ease, color 0.25s ease;
    }
    .ac-btn:hover { background: transparent; color: var(--ac-ink); }
    .ac-btn-gold { background: var(--ac-gold); border-color: var(--ac-gold); color: var(--ac-ink); }
    .ac-btn-gold:hover { background: transparent; color: var(--ac-gold-deep); border-color: var(--ac-gold-deep); }

    /* nav: running head */
    .ac-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .ac-nav {
      display: flex; align-items: center; gap: 20px;
      padding: 14px clamp(24px, 5vw, 56px);
      background: rgba(247, 243, 234, 0.92); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--ac-line);
    }
    .ac-logo {
      font-size: 26px; font-weight: 900; color: var(--ac-ink); text-decoration: none;
      border: 2px solid var(--ac-ink); width: 46px; height: 46px; display: grid; place-items: center;
      letter-spacing: -0.05em;
    }
    .ac-logo span { font-style: italic; font-weight: 500; color: var(--ac-gold-deep); }
    .ac-running {
      font-family: var(--ac-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--ac-ink-soft); margin: 0 auto 0 0;
    }
    .ac-burger { display: none; background: none; border: none; width: 44px; height: 40px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 7px; }
    .ac-burger span { display: block; width: 26px; height: 1.5px; background: var(--ac-ink); }
    .ac-nav-links { display: flex; align-items: center; gap: 6px; }
    .ac-nav-links a {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--ac-ink-soft); text-decoration: none; padding: 10px 14px;
    }
    .ac-nav-links a:hover { color: var(--ac-gold-deep); }
    .ac-nav-cta { border: 1px solid var(--ac-ink); color: var(--ac-ink) !important; margin-left: 10px; }
    .ac-nav-cta:hover { background: var(--ac-ink); color: var(--ac-ivory) !important; }

    /* cover */
    .ac-cover { padding: 170px 0 110px; text-align: center; }
    .ac-cover-no {
      font-family: var(--ac-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.5em; text-transform: uppercase;
      color: var(--ac-gold-deep); margin: 0 0 8px;
    }
    .ac-giant { font-weight: 900; font-size: clamp(11rem, 36vw, 26rem); line-height: 0.85; margin: 0; letter-spacing: -0.02em; }
    .ac-giant-amp { font-style: italic; font-weight: 500; color: var(--ac-gold); }
    .ac-cover-title { font-weight: 600; font-size: clamp(2.4rem, 6vw, 4.2rem); margin: 30px 0 18px; }
    .ac-cover-title em { font-style: italic; color: var(--ac-gold-deep); }
    .ac-cover-sub { font-style: italic; font-size: 18px; color: var(--ac-ink-soft); line-height: 1.7; margin: 0; }
    .ac-rule { display: flex; align-items: center; gap: 18px; margin: 44px auto; max-width: 420px; color: var(--ac-gold); font-size: 11px; }
    .ac-rule::before, .ac-rule::after { content: ""; flex: 1; height: 1px; background: var(--ac-gold); opacity: 0.6; }
    .ac-cover-note { font-style: italic; font-size: 17px; color: var(--ac-ink-soft); margin: 0; }

    /* index */
    .ac-index { padding: 40px 0 110px; }
    .ac-index-title { font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 600; margin: 0 0 40px; }
    .ac-toc { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ac-line); }
    .ac-toc li { border-bottom: 1px solid var(--ac-line); }
    .ac-toc a {
      display: grid; grid-template-columns: 70px 1fr; gap: 24px; align-items: baseline;
      padding: 22px 8px; text-decoration: none; color: var(--ac-ink);
      font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600;
    }
    .ac-toc a:hover { background: var(--ac-card); }
    .ac-toc span { font-family: var(--ac-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.3em; color: var(--ac-gold-deep); }
    .ac-toc em { display: block; font-size: 15px; font-weight: 400; color: var(--ac-ink-soft); }

    /* tester */
    .ac-tester { background: var(--ac-ink); color: var(--ac-ivory); padding: clamp(90px, 11vw, 160px) 0; }
    .ac-tester .ac-h2 { color: var(--ac-ivory); }
    .ac-tester .ac-h2 em { color: var(--ac-gold); }
    .ac-tester .ac-folio { color: var(--ac-gold); }
    .ac-test-controls { display: grid; gap: 26px; margin-bottom: 50px; }
    .ac-test-text, .ac-test-size {
      display: grid; gap: 12px;
      font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
      color: rgba(247, 243, 234, 0.6);
    }
    .ac-test-text input {
      font-family: var(--ac-serif); font-size: 22px; font-style: italic; color: var(--ac-ivory);
      background: transparent; border: none; border-bottom: 1px solid rgba(198, 161, 91, 0.5);
      padding: 10px 2px; width: 100%; border-radius: 0;
    }
    .ac-test-text input:focus { outline: none; border-bottom-color: var(--ac-gold); }
    .ac-test-size input { width: 100%; accent-color: var(--ac-gold); }
    .ac-test-fams { display: flex; gap: 10px; flex-wrap: wrap; }
    .ac-fam {
      font-family: var(--ac-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
      background: transparent; color: rgba(247, 243, 234, 0.6); border: 1px solid rgba(198, 161, 91, 0.4);
      padding: 14px 26px; cursor: pointer; transition: all 0.2s ease;
    }
    .ac-fam:hover { border-color: var(--ac-gold); color: var(--ac-ivory); }
    .ac-fam-on { background: var(--ac-gold); border-color: var(--ac-gold); color: var(--ac-ink); }
    .ac-test-preview {
      margin: 0; line-height: 1.25; word-break: break-word; min-height: 1.4em;
      border-top: 1px solid rgba(198, 161, 91, 0.3); border-bottom: 1px solid rgba(198, 161, 91, 0.3);
      padding: 50px 0;
    }
    .ac-prev-display { font-weight: 900; }
    .ac-prev-texte { font-weight: 400; }
    .ac-prev-italique { font-style: italic; font-weight: 600; }
    .ac-prev-capitales { text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600; }
    .ac-test-note { font-style: italic; color: rgba(247, 243, 234, 0.55); margin: 26px 0 0; font-size: 16px; }

    /* spreads */
    .ac-spread { padding: clamp(90px, 11vw, 160px) 0; border-top: 1px solid var(--ac-line); }
    .ac-spread-deep { background: var(--ac-ivory-deep); }
    .ac-spread-class {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase;
      color: var(--ac-gold-deep); margin: 0 0 44px;
    }
    .ac-alpha { font-size: clamp(1.7rem, 4.4vw, 3.1rem); line-height: 1.35; margin: 0 0 18px; word-break: break-word; }
    .ac-nums { font-size: clamp(1.4rem, 3.4vw, 2.2rem); margin: 0 0 40px; color: var(--ac-ink-soft); }
    .ac-w900 { font-weight: 900; }
    .ac-w600 { font-weight: 600; }
    .ac-w400 { font-weight: 400; }
    .ac-italic { font-style: italic; }
    .ac-caps { text-transform: uppercase; letter-spacing: 0.14em; }
    .ac-ramp { border-top: 1px solid var(--ac-line); border-bottom: 1px solid var(--ac-line); padding: 30px 0; margin-bottom: 34px; display: grid; gap: 14px; }
    .ac-ramp p { margin: 0; }
    .ac-r1 { font-size: 44px; font-weight: 800; }
    .ac-r2 { font-size: 30px; font-weight: 600; }
    .ac-r3 { font-size: 20px; font-weight: 400; color: var(--ac-ink-soft); }
    .ac-para { font-size: 18px; line-height: 1.8; color: var(--ac-ink-soft); max-width: 62ch; margin: 0 0 34px; }
    .ac-sample { font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.3; margin: 0 0 34px; }
    .ac-margin-note {
      font-style: italic; font-size: 15.5px; color: var(--ac-gold-deep); margin: 0;
      border-left: 2px solid var(--ac-gold); padding-left: 18px; max-width: 52ch;
    }

    /* plates */
    .ac-plates { padding: clamp(90px, 11vw, 160px) 0; border-top: 1px solid var(--ac-line); }
    .ac-plate-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 48px); }
    .ac-plate { margin: 0; background: var(--ac-card); border: 1px solid var(--ac-line); padding: 14px; }
    .ac-plate img { width: 100%; height: 380px; object-fit: cover; border: 1px solid var(--ac-line); filter: contrast(1.03); }
    .ac-plate figcaption { padding: 20px 6px 6px; display: grid; gap: 6px; }
    .ac-plate figcaption span {
      font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.26em; text-transform: uppercase;
      color: var(--ac-gold-deep);
    }
    .ac-plate figcaption { font-style: italic; font-size: 15.5px; color: var(--ac-ink-soft); }
    .ac-plate-note { font-style: italic; color: var(--ac-ink-soft); margin: 44px 0 0; text-align: center; }

    /* licensing price list */
    .ac-licensing { background: var(--ac-ink); color: var(--ac-ivory); padding: clamp(90px, 11vw, 160px) 0; }
    .ac-lic-lede { font-size: 18px; font-style: italic; color: rgba(247, 243, 234, 0.72); max-width: 52ch; margin: 0 0 50px; }
    .ac-price { width: 100%; border-collapse: collapse; }
    .ac-price th, .ac-price td { text-align: left; padding: 26px 18px; border-bottom: 1px solid rgba(198, 161, 91, 0.25); vertical-align: top; }
    .ac-price thead th {
      font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
      color: rgba(247, 243, 234, 0.5);
    }
    .ac-price tbody th { font-size: 26px; font-weight: 600; font-style: italic; white-space: nowrap; }
    .ac-price tbody td { font-size: 15.5px; line-height: 1.7; color: rgba(247, 243, 234, 0.8); }
    .ac-price tbody td:nth-child(3) { font-size: 34px; font-weight: 700; color: var(--ac-gold); white-space: nowrap; font-style: normal; }
    .ac-price tbody td:last-child { white-space: nowrap; }
    .ac-price a {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
      color: var(--ac-ivory); text-decoration: none; border: 1px solid var(--ac-gold); padding: 14px 24px; display: inline-block;
    }
    .ac-price a:hover { background: var(--ac-gold); color: var(--ac-ink); }

    /* colophon */
    .ac-colophon { padding: clamp(90px, 11vw, 160px) 0; border-top: 1px solid var(--ac-line); }
    .ac-col-in { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
    .ac-col-img { margin: 0; }
    .ac-col-img img { width: 100%; height: 520px; object-fit: cover; filter: sepia(0.32); }
    .ac-col-img figcaption { font-style: italic; font-size: 14.5px; color: var(--ac-ink-soft); margin: 14px 0 0; }
    .ac-col-in p { font-size: 18px; line-height: 1.8; color: var(--ac-ink-soft); }
    .ac-col-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 44px 0 0; padding: 36px 0 0; border-top: 1px solid var(--ac-line); }
    .ac-col-stats div { display: grid; gap: 6px; }
    .ac-col-stats dt { font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ac-ink-soft); }
    .ac-col-stats dd { margin: 0; font-size: 34px; font-weight: 800; color: var(--ac-gold-deep); }

    /* contact */
    .ac-contact { background: var(--ac-ivory-deep); border-top: 1px solid var(--ac-line); padding: clamp(90px, 11vw, 160px) 0; }
    .ac-contact-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 100px); align-items: start; }
    .ac-contact-copy p { font-size: 18px; line-height: 1.8; color: var(--ac-ink-soft); }
    .ac-contact-list { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--ac-line); }
    .ac-contact-list li { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--ac-line); }
    .ac-contact-list strong { font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ac-gold-deep); padding-top: 4px; }
    .ac-contact-list span { font-size: 17px; }
    .ac-contact-list a { color: var(--ac-ink); }
    .ac-form { display: grid; gap: 30px; padding-top: 8px; }
    .ac-form label { display: grid; gap: 10px; font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ac-ink-soft); }
    .ac-form input, .ac-form select, .ac-form textarea {
      font-family: var(--ac-serif); font-size: 19px; font-style: italic;
      background: transparent; border: none; border-bottom: 1px solid var(--ac-ink);
      padding: 10px 2px; width: 100%; color: var(--ac-ink); border-radius: 0;
    }
    .ac-form input:focus, .ac-form select:focus, .ac-form textarea:focus { outline: none; border-bottom: 2px solid var(--ac-gold-deep); }
    .ac-form-note { margin: 0; font-style: italic; font-size: 17px; color: var(--ac-gold-deep); }
    .ac-form-note:empty { display: none; }

    /* footer */
    .ac-footer { padding: 90px 0 100px; text-align: center; border-top: 1px solid var(--ac-line); overflow: hidden; }
    .ac-footer-giant { font-weight: 900; font-size: clamp(8rem, 30vw, 22rem); line-height: 0.8; margin: 0 0 40px; color: transparent; -webkit-text-stroke: 1px var(--ac-gold); opacity: 0.7; }
    .ac-footer-in { display: grid; gap: 12px; font-size: 15px; color: var(--ac-ink-soft); }
    .ac-footer-in p { margin: 0; font-style: italic; }
    .ac-footer-in a { color: var(--ac-gold-deep); }

    /* responsive */
    @media (max-width: 1020px) {
      .ac-plate-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .ac-plate img { height: 320px; }
      .ac-col-in, .ac-contact-in { grid-template-columns: 1fr; }
      .ac-col-img img { height: 380px; }
    }
    @media (max-width: 860px) {
      .ac-running { display: none; }
      .ac-burger { display: flex; }
      .ac-nav-links {
        display: none; position: absolute; top: 100%; left: 0; right: 0;
        background: var(--ac-ivory); flex-direction: column; align-items: stretch;
        padding: 20px clamp(24px, 5vw, 48px) 28px; gap: 4px; border-bottom: 1px solid var(--ac-line);
      }
      .ac-nav-open .ac-nav-links { display: flex; }
      .ac-nav-links a { padding: 14px 4px; border-bottom: 1px solid var(--ac-line); }
      .ac-nav-cta { margin: 12px 0 0; text-align: center; border: 1px solid var(--ac-ink); }
      .ac-col-stats { grid-template-columns: 1fr 1fr; }
      .ac-contact-list li { grid-template-columns: 1fr; gap: 6px; }
      .ac-toc a { grid-template-columns: 44px 1fr; gap: 14px; }
      .ac-price thead { display: none; }
      .ac-price tr { display: grid; gap: 6px; padding: 10px 0; }
      .ac-price th, .ac-price td { border: none; padding: 4px 0; }
      .ac-price tbody tr { border-bottom: 1px solid rgba(198, 161, 91, 0.25); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ac-btn, .ac-fam { transition: none; }
    }
  </style>
</body>
</html>
