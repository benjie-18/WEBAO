---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Atelier Caractère, fictional high-end type foundry, Montréal.
// Standalone art direction. Luxury typography: ivory, ink, gold, enormous serif. Not connected to the WEBAO theme system.
const IMG = {
  editorial: "https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=1000&auto=format&fit=crop",
  stationery: "https://images.unsplash.com/photo-1471107340929-a87cd0f5b5f3?q=80&w=1000&auto=format&fit=crop",
  publishing: "https://images.unsplash.com/photo-1524578271613-d550eacf6090?q=80&w=1000&auto=format&fit=crop",
  foundry: "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=1200&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Atelier Caractère: Fine Type Foundry | Exceptional Typefaces, Montréal</title>
  <meta name="description" content="Atelier Caractère is a fictional Montréal type foundry. High-contrast display serifs, text faces, and italics, drawn by hand since 2011." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
</head>
<body class="ac">

  <!-- NAV -->
  <header class="ac-navwrap">
    <nav class="ac-nav" aria-label="Primary">
      <a class="ac-logo" href="#top" aria-label="Atelier Caractère, home">Atelier <em>Caractère</em></a>
      <button class="ac-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="ac-menu">
        <span></span><span></span>
      </button>
      <div class="ac-nav-links" id="ac-menu">
        <a href="#collection">Collection</a>
        <a href="#inuse">In use</a>
        <a href="#licensing">Licensing</a>
        <a href="#foundry">Foundry</a>
        <a class="ac-nav-cta" href="#contact">Request a license</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="ac-hero">
      <div class="ac-hero-in">
        <p class="ac-eyebrow">Type foundry · Montréal · since 2011</p>
        <p class="ac-giant" aria-hidden="true">A<span class="ac-giant-amp">a</span></p>
        <h1 class="ac-h1">Letterforms that<br /><em>outlive</em> their century.</h1>
        <div class="ac-rule" aria-hidden="true"><span>◆</span></div>
        <p class="ac-lede">Atelier Caractère draws exceptional typefaces by hand. High-contrast didones, patient text faces, and spirited italics, each spaced and kerned glyph by glyph, for print and for screen.</p>
        <div class="ac-hero-cta">
          <a class="ac-btn" href="#collection">Explore the collection</a>
          <a class="ac-link" href="#licensing">See licensing →</a>
        </div>
      </div>
    </section>

    <!-- COLLECTION -->
    <section class="ac-section" id="collection">
      <div class="ac-wrap">
        <p class="ac-label">The collection</p>
        <h2 class="ac-h2">Four families.<br />One obsession: <em>the letter.</em></h2>

        <article class="ac-spec">
          <header class="ac-spec-head">
            <h3>Caractère Display</h3>
            <p class="ac-spec-class">High-contrast didone · 9 weights · for headlines</p>
          </header>
          <p class="ac-spec-alpha ac-w900">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
          <p class="ac-spec-nums ac-w900">0123456789 &amp; § † ‡</p>
          <div class="ac-ramp">
            <p class="ac-r1">The quick brown fox</p>
            <p class="ac-r2">The quick brown fox</p>
            <p class="ac-r3">The quick brown fox jumps over the lazy dog.</p>
          </div>
          <p class="ac-spec-note">Cut for sizes above 48 pt. Ink traps drawn in by hand.</p>
        </article>

        <article class="ac-spec">
          <header class="ac-spec-head">
            <h3>Caractère Texte</h3>
            <p class="ac-spec-class">Transitional text serif · 6 weights · for long reading</p>
          </header>
          <p class="ac-spec-alpha ac-w400">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
          <p class="ac-spec-nums ac-w400">0123456789 &amp; § † ‡</p>
          <p class="ac-spec-para">We believe a text face should disappear. Set solid, tracked a touch open, Caractère Texte carries novels, annual reports, and wedding invitations with the same quiet confidence. It asks for nothing and gives everything back.</p>
          <p class="ac-spec-note">Optical sizes from 6 to 14 pt. True small caps included.</p>
        </article>

        <article class="ac-spec">
          <header class="ac-spec-head">
            <h3>Caractère Italique</h3>
            <p class="ac-spec-class">Calligraphic italic · 4 weights · for emphasis</p>
          </header>
          <p class="ac-spec-alpha ac-italic">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz</p>
          <p class="ac-spec-nums ac-italic">0123456789 &amp; § † ‡</p>
          <p class="ac-spec-sample ac-italic ac-w600">Elegance is refusal, said with a flourish.</p>
          <p class="ac-spec-note">Drawn from broad-nib studies, not slanted from the roman.</p>
        </article>

        <article class="ac-spec">
          <header class="ac-spec-head">
            <h3>Caractère Capitales</h3>
            <p class="ac-spec-class">Ceremonial small caps · 2 weights · for occasions</p>
          </header>
          <p class="ac-spec-alpha ac-caps">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />0123456789</p>
          <p class="ac-spec-sample ac-caps ac-w600">Chapitre premier · Édition limitée</p>
          <p class="ac-spec-note">For title pages, colophons, and very good news.</p>
        </article>
      </div>
    </section>

    <!-- IN USE -->
    <section class="ac-section ac-inuse" id="inuse">
      <div class="ac-wrap">
        <p class="ac-label">In use</p>
        <h2 class="ac-h2">Our letters, <em>out in the world.</em></h2>
        <div class="ac-use-grid">
          <figure class="ac-use">
            <img src={IMG.editorial} alt="Fountain pen writing on paper, editorial typography" loading="lazy" />
            <figcaption><strong>Editorial</strong><span>Magazine « Marge », set in Caractère Texte</span></figcaption>
          </figure>
          <figure class="ac-use">
            <img src={IMG.stationery} alt="Elegant desk with pen and paper, fine stationery" loading="lazy" />
            <figcaption><strong>Stationery</strong><span>Correspondence suite, Caractère Italique</span></figcaption>
          </figure>
          <figure class="ac-use">
            <img src={IMG.publishing} alt="Dark library shelves of books, fine publishing" loading="lazy" />
            <figcaption><strong>Publishing</strong><span>Book jackets, Caractère Display</span></figcaption>
          </figure>
        </div>
        <p class="ac-use-note">A selection of fictional commissions. Real commissions welcome.</p>
      </div>
    </section>

    <!-- LICENSING -->
    <section class="ac-section ac-licensing" id="licensing">
      <div class="ac-wrap">
        <p class="ac-label ac-label-light">Licensing</p>
        <h2 class="ac-h2 ac-h2-light">An honest price, <em>forever.</em></h2>
        <p class="ac-lic-lede">One payment. Yours to keep. Every license includes all four families, all weights, and our famous kerning.</p>
        <div class="ac-lic-grid">
          <article class="ac-lic">
            <h3>Bureau</h3>
            <p class="ac-lic-price">$95</p>
            <p class="ac-lic-per">one-time · per workstation set</p>
            <ul>
              <li>5 workstations</li>
              <li>Desktop fonts (OTF)</li>
              <li>Print and static documents</li>
              <li>Free updates for life</li>
            </ul>
            <a class="ac-btn ac-btn-outline" href="#contact">Choose Bureau</a>
          </article>
          <article class="ac-lic ac-lic-featured">
            <p class="ac-lic-badge">Most chosen</p>
            <h3>Studio</h3>
            <p class="ac-lic-price">$290</p>
            <p class="ac-lic-per">one-time · for working studios</p>
            <ul>
              <li>20 workstations</li>
              <li>Desktop + webfonts (WOFF2)</li>
              <li>Unlimited page views</li>
              <li>Client work included</li>
              <li>Free updates for life</li>
            </ul>
            <a class="ac-btn ac-btn-gold" href="#contact">Choose Studio</a>
          </article>
          <article class="ac-lic">
            <h3>Maison</h3>
            <p class="ac-lic-price">$890</p>
            <p class="ac-lic-per">one-time · for companies</p>
            <ul>
              <li>Unlimited workstations</li>
              <li>Desktop, web, and app embedding</li>
              <li>Broadcast and signage</li>
              <li>Priority support, by letter if you wish</li>
            </ul>
            <a class="ac-btn ac-btn-outline" href="#contact">Choose Maison</a>
          </article>
        </div>
      </div>
    </section>

    <!-- FOUNDRY -->
    <section class="ac-section" id="foundry">
      <div class="ac-wrap ac-foundry-in">
        <div class="ac-foundry-img">
          <img src={IMG.foundry} alt="Stacks of printed newspapers, the printed word" loading="lazy" />
          <p class="ac-caption">The proofing wall, rue de l'Imprimerie.</p>
        </div>
        <div class="ac-foundry-copy">
          <p class="ac-label">The foundry</p>
          <h2 class="ac-h2">Slow letters,<br />drawn <em>by hand.</em></h2>
          <p>Founded in 2011 in a former print shop on rue de l'Imprimerie, Atelier Caractère is three punchcutters, two apprentices, and one very patient cat. We draw every glyph on paper first. We kern in silence. We proof until the ink behaves.</p>
          <p>We release one family a year. Some years, we release a comma.</p>
          <div class="ac-stats">
            <div><strong>2011</strong><span>founded</span></div>
            <div><strong>24</strong><span>type families</span></div>
            <div><strong>1,400</strong><span>glyphs per family</span></div>
            <div><strong>3</strong><span>punchcutters</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="ac-section ac-contact" id="contact">
      <div class="ac-wrap ac-contact-in">
        <div class="ac-contact-copy">
          <p class="ac-label">Contact</p>
          <h2 class="ac-h2">Write to us.<br /><em>We love letters.</em></h2>
          <p>For licenses, custom typefaces, or simply to talk about serifs. We answer every letter within two business days.</p>
          <ul class="ac-contact-list">
            <li><strong>Atelier</strong><span>418, rue de l'Imprimerie, Montréal QC</span></li>
            <li><strong>Telephone</strong><span><a href="tel:+15145550198">(514) 555-0198</a></span></li>
            <li><strong>Email</strong><span><a href="mailto:bonjour@atelier-caractere.com">bonjour@atelier-caractere.com</a></span></li>
          </ul>
        </div>
        <form class="ac-form" id="ac-form" novalidate>
          <label>Your name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>Interest
            <select name="interest">
              <option>Bureau license</option>
              <option>Studio license</option>
              <option>Maison license</option>
              <option>Custom typeface</option>
              <option>Just talking serifs</option>
            </select>
          </label>
          <label>Your message
            <textarea name="message" rows="4" placeholder="Dear Atelier,"></textarea>
          </label>
          <button class="ac-btn ac-btn-gold" type="submit">Send the letter</button>
          <p class="ac-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="ac-footer">
    <p class="ac-footer-giant" aria-hidden="true">Aa</p>
    <div class="ac-wrap ac-footer-in">
      <p>© 2026 Atelier Caractère. Fictional demo. Set in Caractère Display.</p>
      <p>418, rue de l'Imprimerie, Montréal QC · <a href="tel:+15145550198">(514) 555-0198</a> · <a href="mailto:bonjour@atelier-caractere.com">bonjour@atelier-caractere.com</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      // Mobile menu toggle
      var burger = document.querySelector('.ac-burger') as HTMLButtonElement | null;
      var nav = document.querySelector('.ac-navwrap');
      burger?.addEventListener('click', function () {
        var open = nav?.classList.toggle('ac-nav-open');
        burger?.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      document.querySelectorAll('.ac-nav-links a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav?.classList.remove('ac-nav-open');
          burger?.setAttribute('aria-expanded', 'false');
          burger?.setAttribute('aria-label', 'Open menu');
        });
      });
      // Demo form: never submits anywhere
      var form = document.getElementById('ac-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.ac-form-note');
        if (note) note.textContent = 'Thank you. We will write back within two business days, in a beautiful typeface.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .ac {
      --ac-ivory: #F7F3EA;
      --ac-ivory-deep: #EFE8D8;
      --ac-card: #FFFDF8;
      --ac-ink: #0E0D0B;
      --ac-ink-soft: #3A3733;
      --ac-gold: #C6A15B;
      --ac-gold-deep: #96742F;
      --ac-line: rgba(14, 13, 11, 0.18);
      --ac-serif: "Playfair Display", "Didot", Georgia, serif;
      --ac-sans: system-ui, -apple-system, "Segoe UI", sans-serif;
      margin: 0;
      background: var(--ac-ivory);
      color: var(--ac-ink);
      font-family: var(--ac-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ac *, .ac *::before, .ac *::after { box-sizing: border-box; }
    .ac img { display: block; max-width: 100%; }
    .ac-wrap { max-width: 1140px; margin: 0 auto; padding: 0 clamp(24px, 5vw, 48px); }
    .ac-section { padding: clamp(90px, 11vw, 160px) 0; }

    /* labels + headings */
    .ac-label {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 600;
      letter-spacing: 0.38em; text-transform: uppercase; color: var(--ac-gold-deep);
      margin: 0 0 22px;
    }
    .ac-label-light { color: var(--ac-gold); }
    .ac-h2 { font-weight: 600; font-size: clamp(2.3rem, 5.2vw, 3.9rem); line-height: 1.08; margin: 0 0 56px; }
    .ac-h2 em, .ac-h1 em { font-style: italic; font-weight: 500; color: var(--ac-gold-deep); }
    .ac-h2-light { color: var(--ac-ivory); }
    .ac-h2-light em { color: var(--ac-gold); }

    /* buttons */
    .ac-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--ac-sans); font-weight: 600; font-size: 12.5px; letter-spacing: 0.24em; text-transform: uppercase;
      padding: 18px 40px; text-decoration: none; cursor: pointer;
      background: var(--ac-ink); color: var(--ac-ivory); border: 1px solid var(--ac-ink);
      transition: background 0.25s ease, color 0.25s ease;
    }
    .ac-btn:hover { background: transparent; color: var(--ac-ink); }
    .ac-btn-gold { background: var(--ac-gold); border-color: var(--ac-gold); color: var(--ac-ink); }
    .ac-btn-gold:hover { background: transparent; color: var(--ac-gold-deep); border-color: var(--ac-gold-deep); }
    .ac-btn-outline { background: transparent; color: var(--ac-ink); }
    .ac-btn-outline:hover { background: var(--ac-ink); color: var(--ac-ivory); }
    .ac-link { font-style: italic; font-size: 17px; color: var(--ac-ink); text-decoration: none; border-bottom: 1px solid var(--ac-gold); padding-bottom: 3px; }
    .ac-link:hover { color: var(--ac-gold-deep); }

    /* nav */
    .ac-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .ac-nav {
      display: flex; align-items: center; gap: 20px;
      padding: 18px clamp(24px, 5vw, 56px);
      background: rgba(247, 243, 234, 0.9); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--ac-line);
    }
    .ac-logo { font-size: 24px; font-weight: 700; color: var(--ac-ink); text-decoration: none; margin-right: auto; }
    .ac-logo em { font-style: italic; color: var(--ac-gold-deep); }
    .ac-burger { display: none; background: none; border: none; width: 44px; height: 40px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 7px; }
    .ac-burger span { display: block; width: 26px; height: 1.5px; background: var(--ac-ink); }
    .ac-nav-links { display: flex; align-items: center; gap: 6px; }
    .ac-nav-links a {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--ac-ink-soft); text-decoration: none; padding: 10px 14px;
    }
    .ac-nav-links a:hover { color: var(--ac-gold-deep); }
    .ac-nav-cta { border: 1px solid var(--ac-ink); color: var(--ac-ink) !important; margin-left: 10px; }
    .ac-nav-cta:hover { background: var(--ac-ink); color: var(--ac-ivory) !important; }

    /* hero */
    .ac-hero { padding: 170px 0 110px; text-align: center; position: relative; }
    .ac-hero-in { max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 5vw, 48px); animation: ac-rise 1.1s ease both; }
    @keyframes ac-rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    .ac-eyebrow {
      font-family: var(--ac-sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.4em; text-transform: uppercase;
      color: var(--ac-gold-deep); margin: 0 0 10px;
    }
    .ac-giant { font-weight: 900; font-size: clamp(11rem, 36vw, 26rem); line-height: 0.85; margin: 0; letter-spacing: -0.02em; }
    .ac-giant-amp { font-style: italic; font-weight: 500; color: var(--ac-gold); }
    .ac-h1 { font-weight: 600; font-size: clamp(2.2rem, 5.5vw, 3.8rem); line-height: 1.12; margin: 26px 0 0; }
    .ac-rule { display: flex; align-items: center; gap: 18px; margin: 44px auto; max-width: 420px; color: var(--ac-gold); font-size: 11px; }
    .ac-rule::before, .ac-rule::after { content: ""; flex: 1; height: 1px; background: var(--ac-gold); opacity: 0.6; }
    .ac-lede { font-size: 19px; line-height: 1.75; color: var(--ac-ink-soft); max-width: 58ch; margin: 0 auto 40px; }
    .ac-hero-cta { display: flex; gap: 28px; align-items: center; justify-content: center; flex-wrap: wrap; }

    /* specimens */
    .ac-spec {
      background: var(--ac-card); border: 1px solid var(--ac-line);
      padding: clamp(36px, 5vw, 72px); margin-bottom: 40px;
    }
    .ac-spec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; border-bottom: 1px solid var(--ac-line); padding-bottom: 24px; margin-bottom: 36px; }
    .ac-spec-head h3 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 700; margin: 0; }
    .ac-spec-class { font-family: var(--ac-sans); font-size: 11.5px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ac-gold-deep); margin: 0; }
    .ac-spec-alpha { font-size: clamp(1.6rem, 4vw, 2.9rem); line-height: 1.35; margin: 0 0 18px; word-break: break-word; }
    .ac-spec-nums { font-size: clamp(1.4rem, 3.4vw, 2.2rem); margin: 0 0 36px; color: var(--ac-ink-soft); }
    .ac-w900 { font-weight: 900; }
    .ac-w600 { font-weight: 600; }
    .ac-w400 { font-weight: 400; }
    .ac-italic { font-style: italic; }
    .ac-caps { text-transform: uppercase; letter-spacing: 0.14em; }
    .ac-ramp { border-top: 1px solid var(--ac-line); border-bottom: 1px solid var(--ac-line); padding: 30px 0; margin-bottom: 30px; display: grid; gap: 14px; }
    .ac-ramp p { margin: 0; }
    .ac-r1 { font-size: 44px; font-weight: 800; }
    .ac-r2 { font-size: 30px; font-weight: 600; }
    .ac-r3 { font-size: 20px; font-weight: 400; color: var(--ac-ink-soft); }
    .ac-spec-para { font-size: 18px; line-height: 1.8; color: var(--ac-ink-soft); max-width: 62ch; margin: 0 0 30px; }
    .ac-spec-sample { font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.3; margin: 0 0 30px; }
    .ac-spec-note { font-style: italic; font-size: 15.5px; color: var(--ac-gold-deep); margin: 0; }

    /* in use */
    .ac-inuse { background: var(--ac-ivory-deep); border-block: 1px solid var(--ac-line); }
    .ac-use-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 48px); }
    .ac-use { margin: 0; }
    .ac-use img { width: 100%; height: 380px; object-fit: cover; filter: sepia(0.28) contrast(1.02); }
    .ac-use figcaption { padding-top: 20px; display: grid; gap: 6px; border-top: 1px solid var(--ac-gold); margin-top: 20px; }
    .ac-use figcaption strong { font-size: 22px; font-weight: 700; }
    .ac-use figcaption span { font-style: italic; font-size: 15.5px; color: var(--ac-ink-soft); }
    .ac-use-note { font-style: italic; color: var(--ac-ink-soft); margin: 44px 0 0; text-align: center; }

    /* licensing */
    .ac-licensing { background: var(--ac-ink); color: var(--ac-ivory); }
    .ac-lic-lede { font-size: 18px; font-style: italic; color: rgba(247, 243, 234, 0.72); max-width: 52ch; margin: 0 0 56px; }
    .ac-lic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(198, 161, 91, 0.4); border: 1px solid rgba(198, 161, 91, 0.4); }
    .ac-lic { background: var(--ac-ink); padding: 48px 40px; display: grid; gap: 16px; align-content: start; position: relative; }
    .ac-lic h3 { font-size: 26px; font-weight: 600; font-style: italic; margin: 0; }
    .ac-lic-price { font-size: 54px; font-weight: 700; margin: 0; }
    .ac-lic-per { font-family: var(--ac-sans); font-size: 11.5px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(247, 243, 234, 0.55); margin: 0; }
    .ac-lic ul { list-style: none; margin: 8px 0 16px; padding: 0; display: grid; gap: 12px; font-size: 16px; color: rgba(247, 243, 234, 0.85); }
    .ac-lic li { padding-left: 22px; position: relative; }
    .ac-lic li::before { content: "◆"; position: absolute; left: 0; color: var(--ac-gold); font-size: 10px; top: 4px; }
    .ac-lic-featured { background: #171512; }
    .ac-lic-badge {
      position: absolute; top: 22px; right: 28px; margin: 0;
      font-family: var(--ac-sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
      color: var(--ac-gold); border: 1px solid var(--ac-gold); padding: 8px 14px;
    }

    /* foundry */
    .ac-foundry-in { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
    .ac-foundry-img img { width: 100%; height: 520px; object-fit: cover; filter: sepia(0.32); }
    .ac-caption { font-style: italic; font-size: 14.5px; color: var(--ac-ink-soft); margin: 14px 0 0; }
    .ac-foundry-copy p { font-size: 18px; line-height: 1.8; color: var(--ac-ink-soft); }
    .ac-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 44px; padding-top: 36px; border-top: 1px solid var(--ac-line); }
    .ac-stats div { display: grid; gap: 6px; }
    .ac-stats strong { font-size: 34px; font-weight: 800; color: var(--ac-gold-deep); }
    .ac-stats span { font-family: var(--ac-sans); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ac-ink-soft); }

    /* contact */
    .ac-contact { background: var(--ac-ivory-deep); border-top: 1px solid var(--ac-line); }
    .ac-contact-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 100px); align-items: start; }
    .ac-contact-copy p { font-size: 18px; line-height: 1.8; color: var(--ac-ink-soft); }
    .ac-contact-list { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--ac-line); }
    .ac-contact-list li { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--ac-line); }
    .ac-contact-list strong { font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ac-gold-deep); padding-top: 4px; }
    .ac-contact-list span { font-size: 17px; }
    .ac-contact-list a { color: var(--ac-ink); }
    .ac-form { display: grid; gap: 30px; padding-top: 8px; }
    .ac-form label { display: grid; gap: 10px; font-family: var(--ac-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ac-ink-soft); }
    .ac-form input, .ac-form select, .ac-form textarea {
      font-family: var(--ac-serif); font-size: 19px; font-style: italic;
      background: transparent; border: none; border-bottom: 1px solid var(--ac-ink);
      padding: 10px 2px; width: 100%; color: var(--ac-ink); border-radius: 0;
    }
    .ac-form input:focus, .ac-form select:focus, .ac-form textarea:focus { outline: none; border-bottom: 2px solid var(--ac-gold-deep); }
    .ac-form-note { margin: 0; font-style: italic; font-size: 17px; color: var(--ac-gold-deep); }
    .ac-form-note:empty { display: none; }

    /* footer */
    .ac-footer { padding: 90px 0 100px; text-align: center; border-top: 1px solid var(--ac-line); overflow: hidden; }
    .ac-footer-giant { font-weight: 900; font-size: clamp(8rem, 30vw, 22rem); line-height: 0.8; margin: 0 0 40px; color: transparent; -webkit-text-stroke: 1px var(--ac-gold); opacity: 0.7; }
    .ac-footer-in { display: grid; gap: 12px; font-size: 15px; color: var(--ac-ink-soft); }
    .ac-footer-in p { margin: 0; font-style: italic; }
    .ac-footer-in a { color: var(--ac-gold-deep); }

    /* responsive */
    @media (max-width: 1020px) {
      .ac-use-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .ac-use img { height: 320px; }
      .ac-lic-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .ac-foundry-in, .ac-contact-in { grid-template-columns: 1fr; }
      .ac-foundry-img img { height: 380px; }
    }
    @media (max-width: 860px) {
      .ac-burger { display: flex; }
      .ac-nav-links {
        display: none; position: absolute; top: 100%; left: 0; right: 0;
        background: var(--ac-ivory); flex-direction: column; align-items: stretch;
        padding: 20px clamp(24px, 5vw, 48px) 28px; gap: 4px; border-bottom: 1px solid var(--ac-line);
      }
      .ac-nav-open .ac-nav-links { display: flex; }
      .ac-nav-links a { padding: 14px 4px; border-bottom: 1px solid var(--ac-line); }
      .ac-nav-cta { margin: 12px 0 0; text-align: center; border: 1px solid var(--ac-ink); }
      .ac-stats { grid-template-columns: 1fr 1fr; }
      .ac-contact-list li { grid-template-columns: 1fr; gap: 6px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ac-hero-in { animation: none; }
      .ac-btn { transition: none; }
    }
  </style>
</body>
</html>
