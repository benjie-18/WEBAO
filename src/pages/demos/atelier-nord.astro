---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Atelier Nord · fictional premium auto studio, Brossard QC.
// Rebuilt as dark "mission control". Standalone art direction, not connected
// to the WEBAO theme system by design.
const IMG = {
  hero: "https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=1800&auto=format&fit=crop",
  garage: "https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1200&auto=format&fit=crop",
  detail: "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=1200&auto=format&fit=crop",
  engine: "https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?q=80&w=1200&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Atelier Nord · Precision auto care in Brossard</title>
  <meta name="description" content="Atelier Nord: dealer-level diagnostics, concours detailing and performance work in Brossard. By appointment only." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="an">

  <header class="an-nav">
    <div class="an-nav-in">
      <a class="an-logo" href="#top" aria-label="Atelier Nord · home">
        <span class="an-logo-mark" aria-hidden="true">N/</span>
        <span class="an-logo-text">ATELIER&nbsp;NORD</span>
      </a>
      <nav class="an-links" aria-label="Primary">
        <a href="#services"><span>01</span>Services</a>
        <a href="#bays"><span>02</span>In the bays</a>
        <a href="#process"><span>03</span>Process</a>
        <a href="#contact"><span>04</span>Contact</a>
      </nav>
      <a class="an-btn an-btn-accent an-btn-sm" href="#contact">Book appointment</a>
      <button class="an-burger" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    </div>
    <div class="an-mobile" hidden>
      <a href="#services">Services</a>
      <a href="#bays">In the bays</a>
      <a href="#process">Process</a>
      <a href="#contact">Book appointment</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO: headline left, live bay status right -->
    <section class="an-hero">
      <div class="an-wrap an-hero-grid">
        <div class="an-hero-copy">
          <p class="an-mono an-hero-kicker"><span class="an-live" aria-hidden="true"></span>Brossard QC · by appointment only</p>
          <h1 class="an-h1">Precision<br />has an address.</h1>
          <p class="an-hero-sub">Dealer-level diagnostics, concours-grade detailing and honest performance work, for people who read the spec sheet.</p>
          <div class="an-hero-cta">
            <a class="an-btn an-btn-accent" href="#contact">Book an appointment</a>
            <a class="an-btn an-btn-line" href="#bays">See the bays</a>
          </div>
          <p class="an-mono an-hero-note">Tue to Sat · 8:00 to 18:00 · 3 bays · 2 techs on shift</p>
        </div>
        <aside class="an-panel" aria-label="Live bay status">
          <div class="an-panel-head">
            <p class="an-mono"><span class="an-live" aria-hidden="true"></span>Live bay status</p>
            <p class="an-mono an-panel-upd">Updated 10:42</p>
          </div>
          <div class="an-bay">
            <div class="an-bay-top"><span class="an-mono">Bay 01</span><span class="an-status an-status-busy">In progress</span></div>
            <p class="an-bay-job">Ceramic coating · stage-2 polish</p>
            <p class="an-mono an-bay-eta">Coating at 14:00</p>
          </div>
          <div class="an-bay">
            <div class="an-bay-top"><span class="an-mono">Bay 02</span><span class="an-status an-status-qc">QC check</span></div>
            <p class="an-bay-job">Full diagnostic · intermittent misfire</p>
            <p class="an-mono an-bay-eta">Road test next</p>
          </div>
          <div class="an-bay">
            <div class="an-bay-top"><span class="an-mono">Bay 03</span><span class="an-status an-status-open">Open</span></div>
            <p class="an-bay-job">Available · all services</p>
            <p class="an-mono an-bay-eta">Next slot today 14:30</p>
          </div>
          <a class="an-btn an-btn-accent an-btn-full an-panel-cta" href="#contact">Book Bay 03</a>
        </aside>
      </div>
    </section>

    <!-- SERVICES: spec-table rows -->
    <section class="an-section" id="services">
      <div class="an-wrap">
        <div class="an-sec-head">
          <p class="an-mono">01 / Services</p>
          <h2 class="an-h2">Three disciplines.<br />Zero guesswork.</h2>
        </div>
        <div class="an-specs">
          <article class="an-specrow">
            <span class="an-mono an-specrow-code">S.01</span>
            <div class="an-specrow-main">
              <h3>Diagnostics</h3>
              <p>Oscilloscope-level electrical diagnosis, module coding and 140-point pre-purchase inspections.</p>
            </div>
            <div class="an-chips">
              <span class="an-chip">140-pt report</span>
              <span class="an-chip">Same-day results</span>
              <span class="an-chip">Fixed quote</span>
            </div>
          </article>
          <article class="an-specrow">
            <span class="an-mono an-specrow-code">S.02</span>
            <div class="an-specrow-main">
              <h3>Detailing</h3>
              <p>Multi-stage paint correction, ceramic coatings and full interior resets, documented panel by panel.</p>
            </div>
            <div class="an-chips">
              <span class="an-chip">Multi-stage polish</span>
              <span class="an-chip">5-yr ceramic</span>
              <span class="an-chip">Photo log</span>
            </div>
          </article>
          <article class="an-specrow">
            <span class="an-mono an-specrow-code">S.03</span>
            <div class="an-specrow-main">
              <h3>Performance</h3>
              <p>Suspension geometry, brake upgrades and track preparation, measured on the rack.</p>
            </div>
            <div class="an-chips">
              <span class="an-chip">0.01° accuracy</span>
              <span class="an-chip">In-house dyno</span>
              <span class="an-chip">Track checklist</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- NUMBERS BAND -->
    <section class="an-numbers">
      <div class="an-wrap an-numbers-in">
        <div><strong>4.9</strong><span class="an-mono">avg rating / 186 reviews</span></div>
        <div><strong>12</strong><span class="an-mono">years in operation</span></div>
        <div><strong>3.2k</strong><span class="an-mono">cars through the shop</span></div>
        <div><strong>0</strong><span class="an-mono">upsells you didn't ask for</span></div>
      </div>
    </section>

    <!-- IN THE BAYS: workshop log -->
    <section class="an-section" id="bays">
      <div class="an-wrap">
        <div class="an-sec-head">
          <p class="an-mono">02 / In the bays</p>
          <h2 class="an-h2">Workshop log.</h2>
        </div>
        <div class="an-log-grid">
          <ol class="an-log">
            <li>
              <span class="an-mono an-log-t">10:20 · Bay 02</span>
              <p>Alignment dialled to spec. Road test next.</p>
            </li>
            <li>
              <span class="an-mono an-log-t">09:05 · Bay 03</span>
              <p>Misfire traced to a failing coil driver. Customer approved the fix.</p>
            </li>
            <li>
              <span class="an-mono an-log-t">08:12 · Bay 01</span>
              <p>Stage-2 polish done. Ceramic goes on at 2pm.</p>
            </li>
            <li>
              <span class="an-mono an-log-t">06:40 · Bay 02</span>
              <p>Intake photos taken. GTI on the lift.</p>
            </li>
          </ol>
          <div class="an-log-media">
            <figure class="an-log-fig">
              <img src={IMG.garage} alt="A classic car inside the Atelier Nord workshop" loading="lazy" />
              <figcaption class="an-mono">Bay 02 · 06:40 AM</figcaption>
            </figure>
            <div class="an-log-pair">
              <figure class="an-log-fig">
                <img src={IMG.detail} alt="Blue sports sedan after paint correction" loading="lazy" />
                <figcaption class="an-mono">Bay 01 · correction</figcaption>
              </figure>
              <figure class="an-log-fig">
                <img src={IMG.engine} alt="Engine bay during a diagnostic session" loading="lazy" />
                <figcaption class="an-mono">Bay 03 · diagnostic</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS: numbered timeline -->
    <section class="an-section an-process" id="process">
      <div class="an-wrap">
        <div class="an-sec-head">
          <p class="an-mono">03 / Process</p>
          <h2 class="an-h2">How a visit works.</h2>
        </div>
        <ol class="an-timeline">
          <li>
            <span class="an-mono an-timeline-n">P.01</span>
            <div><h3>Book</h3><p>Pick a slot online or by phone. Tell us symptoms, not solutions. That's our job.</p></div>
          </li>
          <li>
            <span class="an-mono an-timeline-n">P.02</span>
            <div><h3>Inspect</h3><p>Photo intake and a digital inspection on your phone before we touch a bolt.</p></div>
          </li>
          <li>
            <span class="an-mono an-timeline-n">P.03</span>
            <div><h3>Approve</h3><p>Fixed quote, itemized parts. Nothing moves without your explicit yes.</p></div>
          </li>
          <li>
            <span class="an-mono an-timeline-n">P.04</span>
            <div><h3>Drive</h3><p>Torqued, tested, washed. Old parts in a box in the trunk if you want them.</p></div>
          </li>
        </ol>
      </div>
    </section>

    <!-- CONTACT: split -->
    <section class="an-section" id="contact">
      <div class="an-wrap an-contact-grid">
        <div>
          <p class="an-mono">04 / Contact</p>
          <h2 class="an-h2">Book the bay.</h2>
          <p class="an-prose">Appointments Tuesday to Saturday. Emergencies (you know what those are): call.</p>
          <dl class="an-contact-list">
            <div><dt class="an-mono">Phone</dt><dd><a href="tel:+14505550177">(450) 555-0177</a></dd></div>
            <div><dt class="an-mono">Email</dt><dd><a href="mailto:service@atelier-nord-demo.ca">service@atelier-nord-demo.ca</a></dd></div>
            <div><dt class="an-mono">Shop</dt><dd>123, rue Fictive, Brossard QC</dd></div>
            <div><dt class="an-mono">Hours</dt><dd>Tue to Sat · 8am to 6pm</dd></div>
          </dl>
        </div>
        <form class="an-form" id="an-form" novalidate>
          <div class="an-form-row">
            <label class="an-mono">Name<input type="text" name="name" required placeholder="Jane Doe" /></label>
            <label class="an-mono">Phone<input type="tel" name="phone" required placeholder="(450) 555-0000" /></label>
          </div>
          <label class="an-mono">Service
            <select name="service">
              <option>Diagnostics</option>
              <option>Detailing</option>
              <option>Performance</option>
              <option>Pre-purchase inspection</option>
            </select>
          </label>
          <label class="an-mono">Vehicle / symptoms<textarea name="details" rows="4" placeholder="2019 Golf GTI, vibration at 110 km/h…"></textarea></label>
          <button class="an-btn an-btn-accent an-btn-full" type="submit">Request appointment</button>
          <p class="an-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="an-footer">
    <div class="an-wrap an-footer-in">
      <p class="an-logo"><span class="an-logo-mark" aria-hidden="true">N/</span><span class="an-logo-text">ATELIER&nbsp;NORD</span></p>
      <p class="an-footer-note an-mono">© 2026 Atelier Nord · Brossard, QC</p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      var btn = document.querySelector('.an-burger');
      var menu = document.querySelector('.an-mobile');
      btn?.addEventListener('click', function () {
        var isHidden = menu?.hasAttribute('hidden') ?? false;
        if (isHidden) { menu?.removeAttribute('hidden'); } else { menu?.setAttribute('hidden', ''); }
        btn?.setAttribute('aria-expanded', String(isHidden));
        btn?.setAttribute('aria-label', isHidden ? 'Close menu' : 'Open menu');
      });
      menu?.addEventListener('click', function (e) {
        if ((e.target as HTMLElement).tagName === 'A') menu?.setAttribute('hidden', '');
      });
    })();
    (function () {
      var form = document.getElementById('an-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.an-form-note');
        if (note) note.textContent = '✓ Received. We\u2019ll confirm your appointment shortly.';
      });
    })();
  </script>

  <style>
    .an {
      --an-bg: #0A0F1A;
      --an-bg-2: #0E1524;
      --an-card: #121A2C;
      --an-ink: #F2F5F9;
      --an-ink-2: #9AA6BC;
      --an-line: rgba(242, 245, 249, 0.12);
      --an-accent: #3D7BFF;
      --an-accent-soft: rgba(61, 123, 255, 0.14);
      --an-green: #34D399;
      --an-amber: #F5A623;
      --an-font-d: "Space Grotesk", system-ui, sans-serif;
      --an-font-m: "IBM Plex Mono", ui-monospace, monospace;
      margin: 0;
      background: var(--an-bg);
      color: var(--an-ink);
      font-family: var(--an-font-d);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .an *, .an *::before, .an *::after { box-sizing: border-box; }
    .an img { display: block; max-width: 100%; }
    .an-wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(18px, 4vw, 40px); }
    .an-mono { font-family: var(--an-font-m); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; }

    .an-h1 { font-weight: 700; letter-spacing: -0.03em; font-size: clamp(3rem, 8.5vw, 6.2rem); line-height: 0.94; margin: 0; }
    .an-h2 { font-weight: 700; letter-spacing: -0.025em; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; margin: 0; }
    .an-prose { color: var(--an-ink-2); font-size: 15.5px; line-height: 1.7; max-width: 52ch; }

    /* nav */
    .an-nav { position: sticky; top: 0; z-index: 60; background: rgba(10, 15, 26, 0.88); backdrop-filter: blur(14px); border-bottom: 1px solid var(--an-line); }
    .an-nav-in { max-width: 1320px; margin: 0 auto; padding: 14px clamp(18px, 4vw, 40px); display: flex; align-items: center; gap: 30px; }
    .an-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--an-ink); }
    .an-logo-mark { font-family: var(--an-font-m); font-weight: 600; font-size: 15px; background: var(--an-accent); color: #fff; padding: 7px 9px; border-radius: 8px; }
    .an-logo-text { font-weight: 700; font-size: 15px; letter-spacing: 0.14em; }
    .an-links { display: flex; gap: 28px; margin-left: auto; }
    .an-links a { color: var(--an-ink-2); text-decoration: none; font-size: 13.5px; font-weight: 500; display: inline-flex; gap: 8px; align-items: baseline; }
    .an-links a span { font-family: var(--an-font-m); font-size: 10px; color: var(--an-accent); }
    .an-links a:hover { color: var(--an-ink); }
    .an-burger { display: none; margin-left: auto; background: none; border: 0; cursor: pointer; padding: 8px; }
    .an-burger span { display: block; width: 22px; height: 2px; background: var(--an-ink); margin: 5px 0; }
    .an-mobile { display: grid; border-top: 1px solid var(--an-line); }
    .an-mobile[hidden] { display: none; }
    .an-mobile a { padding: 14px 24px; color: var(--an-ink); text-decoration: none; font-weight: 600; border-bottom: 1px solid var(--an-line); }

    .an-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      font-weight: 600; font-size: 14px; padding: 15px 28px; border-radius: 10px;
      text-decoration: none; border: 0; cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .an-btn:hover { transform: translateY(-2px); }
    .an-btn-accent { background: var(--an-accent); color: #fff; box-shadow: 0 12px 30px rgba(61, 123, 255, 0.35); }
    .an-btn-accent:hover { background: #2F6BF0; }
    .an-btn-line { background: transparent; color: var(--an-ink); border: 1px solid var(--an-line); }
    .an-btn-line:hover { border-color: var(--an-ink-2); }
    .an-btn-sm { padding: 11px 20px; font-size: 13px; }
    .an-btn-full { width: 100%; }

    /* hero: split headline / bay panel */
    .an-hero { border-bottom: 1px solid var(--an-line); padding: clamp(56px, 8vw, 110px) 0; background:
      radial-gradient(900px 480px at 12% 0%, rgba(61,123,255,0.10), transparent 60%),
      var(--an-bg); }
    .an-hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
    .an-hero-kicker { color: var(--an-ink-2); display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; }
    .an-live { width: 8px; height: 8px; border-radius: 50%; background: var(--an-green); box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18); animation: an-pulse 2s infinite; flex: none; }
    @keyframes an-pulse { 50% { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0.05); } }
    .an-hero-sub { color: var(--an-ink-2); font-size: 17px; line-height: 1.6; max-width: 46ch; margin: 24px 0 32px; }
    .an-hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }
    .an-hero-note { color: var(--an-ink-2); margin: 0; line-height: 1.8; }

    /* live bay status panel */
    .an-panel {
      background: var(--an-card); border: 1px solid var(--an-line); border-radius: 18px;
      padding: 24px; display: grid; gap: 14px; align-content: start;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
    }
    .an-panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--an-line); }
    .an-panel-head .an-mono { margin: 0; display: inline-flex; align-items: center; gap: 10px; color: var(--an-ink); }
    .an-panel-upd { color: var(--an-ink-2); margin: 0; }
    .an-bay { border: 1px solid var(--an-line); border-radius: 12px; padding: 16px 18px; display: grid; gap: 6px; background: var(--an-bg-2); }
    .an-bay-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .an-bay-top .an-mono { color: var(--an-ink-2); margin: 0; }
    .an-bay-job { margin: 0; font-size: 15px; font-weight: 600; }
    .an-bay-eta { margin: 0; color: var(--an-ink-2); font-size: 10.5px; }
    .an-status {
      font-family: var(--an-font-m); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
      padding: 6px 12px; border-radius: 999px; white-space: nowrap; border: 1px solid;
    }
    .an-status-busy { color: var(--an-accent); border-color: rgba(61,123,255,0.5); background: var(--an-accent-soft); }
    .an-status-qc { color: var(--an-amber); border-color: rgba(245,166,35,0.5); background: rgba(245,166,35,0.1); }
    .an-status-open { color: var(--an-green); border-color: rgba(52,211,153,0.5); background: rgba(52,211,153,0.08); }
    .an-panel-cta { margin-top: 4px; }

    /* sections */
    .an-section { padding: clamp(64px, 9vw, 120px) 0; }
    .an-sec-head { display: grid; gap: 16px; margin-bottom: 40px; }
    .an-sec-head .an-mono { color: var(--an-accent); margin: 0; }

    /* services: spec-table rows */
    .an-specs { border-top: 1px solid var(--an-line); }
    .an-specrow {
      display: grid; grid-template-columns: 90px 1fr auto; gap: 24px; align-items: center;
      padding: 30px 8px; border-bottom: 1px solid var(--an-line);
    }
    .an-specrow-code { color: var(--an-accent); margin: 0; }
    .an-specrow-main h3 { margin: 0 0 8px; font-size: 23px; font-weight: 700; letter-spacing: -0.02em; }
    .an-specrow-main p { margin: 0; color: var(--an-ink-2); font-size: 14.5px; line-height: 1.65; max-width: 60ch; }
    .an-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .an-chip {
      font-family: var(--an-font-m); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--an-ink-2); border: 1px solid var(--an-line); border-radius: 999px; padding: 8px 14px; white-space: nowrap;
    }

    /* numbers band */
    .an-numbers { border-block: 1px solid var(--an-line); background: var(--an-bg-2); }
    .an-numbers-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding-top: 40px; padding-bottom: 40px; }
    .an-numbers-in div { display: flex; flex-direction: column; gap: 8px; }
    .an-numbers-in strong { font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 700; letter-spacing: -0.03em; }
    .an-numbers-in .an-mono { color: var(--an-ink-2); margin: 0; line-height: 1.7; }

    /* workshop log */
    .an-log-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
    .an-log { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--an-line); }
    .an-log li { display: grid; grid-template-columns: 170px 1fr; gap: 18px; padding: 20px 4px; border-bottom: 1px solid var(--an-line); align-items: baseline; }
    .an-log-t { color: var(--an-accent); margin: 0; font-size: 11px; }
    .an-log p { margin: 0; font-size: 15px; line-height: 1.6; }
    .an-log-media { display: grid; gap: 14px; }
    .an-log-fig { margin: 0; position: relative; }
    .an-log-fig img { width: 100%; height: 300px; object-fit: cover; border-radius: 14px; border: 1px solid var(--an-line); }
    .an-log-fig figcaption { position: absolute; left: 14px; bottom: 14px; background: rgba(10,15,26,0.78); backdrop-filter: blur(8px); padding: 8px 14px; border-radius: 8px; border: 1px solid var(--an-line); margin: 0; }
    .an-log-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .an-log-pair img { height: 190px; }

    /* process timeline */
    .an-process { background: var(--an-bg-2); border-block: 1px solid var(--an-line); }
    .an-timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: 760px; }
    .an-timeline li { display: grid; grid-template-columns: 90px 1fr; gap: 24px; padding: 26px 0; border-bottom: 1px solid var(--an-line); position: relative; }
    .an-timeline li:first-child { border-top: 1px solid var(--an-line); }
    .an-timeline-n { color: var(--an-accent); margin: 0; padding-top: 4px; }
    .an-timeline h3 { margin: 0 0 8px; font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
    .an-timeline p { margin: 0; color: var(--an-ink-2); font-size: 14.5px; line-height: 1.65; max-width: 56ch; }

    /* contact */
    .an-contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
    .an-contact-grid > div > .an-mono { color: var(--an-accent); }
    .an-contact-grid .an-h2 { margin: 16px 0 18px; }
    .an-contact-list { margin: 30px 0 0; display: grid; gap: 16px; }
    .an-contact-list div { display: grid; grid-template-columns: 90px 1fr; gap: 12px; align-items: baseline; }
    .an-contact-list .an-mono { margin: 0; color: var(--an-ink-2); }
    .an-contact-list dd { margin: 0; font-size: 15.5px; font-weight: 500; }
    .an-contact-list a { text-decoration: none; color: var(--an-accent); }
    .an-form { background: var(--an-card); border: 1px solid var(--an-line); border-radius: 18px; padding: clamp(24px, 3vw, 34px); display: grid; gap: 16px; }
    .an-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .an-form label { display: grid; gap: 10px; color: var(--an-ink-2); }
    .an-form input, .an-form select, .an-form textarea {
      font-family: var(--an-font-d); font-size: 15px; letter-spacing: 0; text-transform: none;
      padding: 13px 15px; border-radius: 10px; border: 1px solid var(--an-line);
      background: var(--an-bg); color: var(--an-ink); width: 100%;
    }
    .an-form input::placeholder, .an-form textarea::placeholder { color: #5A6579; }
    .an-form input:focus, .an-form select:focus, .an-form textarea:focus { outline: 2px solid var(--an-accent); outline-offset: 1px; border-color: var(--an-accent); }
    .an-form select option { background: var(--an-bg); }
    .an-form-note { margin: 0; font-size: 12.5px; color: var(--an-ink-2); text-align: center; font-family: var(--an-font-m); letter-spacing: 0.04em; }
    .an-form-note:empty { display: none; }

    /* footer */
    .an-footer { border-top: 1px solid var(--an-line); padding: 44px 0; background: var(--an-bg-2); }
    .an-footer-in { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
    .an-footer .an-logo-text { font-size: 13px; }
    .an-footer-note { margin: 0; color: var(--an-ink-2); }

    @media (max-width: 960px) {
      .an-hero-grid, .an-log-grid, .an-contact-grid { grid-template-columns: 1fr; }
      .an-numbers-in { grid-template-columns: 1fr 1fr; }
      .an-specrow { grid-template-columns: 70px 1fr; }
      .an-chips { grid-column: 2; justify-content: flex-start; }
    }
    @media (max-width: 720px) {
      .an-links, .an-nav .an-btn { display: none; }
      .an-burger { display: block; }
      .an-numbers-in { grid-template-columns: 1fr; }
      .an-form-row { grid-template-columns: 1fr; }
      .an-log li { grid-template-columns: 1fr; gap: 6px; }
      .an-log-pair { grid-template-columns: 1fr; }
      .an-timeline li { grid-template-columns: 64px 1fr; gap: 16px; }
      .an-contact-list div { grid-template-columns: 1fr; gap: 4px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .an-live { animation: none; }
      .an-btn { transition: none; }
    }
  </style>
</body>
</html>
