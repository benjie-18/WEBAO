---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: MAXIMAL, fictional maximalist creative collective, Montréal.
// Standalone art direction. Loud, clashing, "more is more". Not connected to the WEBAO theme system.
// REBUILD: collage chaos. The page opens mid-explosion, no clean hero. Services
// are a sticker wall, work is an overlapping scrapbook spread, tiers are
// carnival tickets, and a MAKE IT LOUDER button spawns more stickers live.
const IMG = {
  heroA: "/demos/maximal/01.jpg",
  heroB: "/demos/maximal/02.jpg",
  work1: "https://images.unsplash.com/photo-1541701494587-cb58502866ab?q=80&w=900&auto=format&fit=crop",
  work2: "/demos/maximal/03.jpg",
  work3: "/demos/maximal/04.jpg",
  work4: "https://live.staticflickr.com/6048/6309838030_5a79d8af2c.jpg",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="maximal" locale="en" title="MAXIMAL: More Is More | Maximalist Creative Collective, Montréal" description="MAXIMAL is a fictional maximalist creative collective in Montréal. Branding, web, motion, murals, packaging, and everything at once. Tastefully too much." ogImage="https://webao.ca/demos/maximal/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Playfair+Display:ital,wght@1,500;1,700;1,900&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="mx">

  <!-- NAV -->
  <header class="mx-navwrap">
    <nav class="mx-nav" aria-label="Primary">
      <a class="mx-logo" href="#top" aria-label="MAXIMAL, home">MAXIMAL<span class="mx-logo-star" aria-hidden="true">✸</span></a>
      <button class="mx-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mx-menu">
        <span></span><span></span><span></span>
      </button>
      <div class="mx-nav-links" id="mx-menu">
        <a href="#menu">Menu</a>
        <a href="#messes">Messes</a>
        <a href="#creed">Creed</a>
        <a href="#tickets">Tickets</a>
        <a class="mx-nav-cta" href="#shout">Shout at us</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- COLLAGE EXPLOSION: the page starts mid-blast. No hero section. -->
    <section class="mx-blast" id="blast" aria-label="MAXIMAL intro collage">
      <div class="mx-checker" aria-hidden="true"></div>
      <div class="mx-blast-stage" id="mx-stage">
        <p class="mx-blast-kicker"><span class="mx-tag">Montréal, QC</span> <span class="mx-tag mx-tag-pink">Maximalist creative collective</span> <span class="mx-tag mx-tag-blue">Est. 2019</span></p>
        <h1 class="mx-blast-h1">
          <span class="mx-b1">MORE</span>
          <span class="mx-b2">IS <em>MORE</em></span>
        </h1>
        <p class="mx-blast-lede">We are MAXIMAL, a creative collective allergic to restraint. Branding, websites, motion, murals, packaging, zines, merch, and twelve other things, all at once, on purpose. <strong>Minimalism is a rumor.</strong> We checked.</p>
        <div class="mx-blast-cta">
          <a class="mx-btn mx-btn-pink" href="#tickets">Pick your chaos tier</a>
          <button class="mx-btn mx-btn-lime" id="mx-louder" type="button">Make it louder <span id="mx-count" aria-hidden="true">(0)</span></button>
        </div>
        <figure class="mx-pol mx-pol-a"><img src={IMG.heroA} alt="Maximalist living room, green walls, blue velvet sofa, gallery wall" loading="eager" fetchpriority="high" decoding="async" /><figcaption>mood: LOUD</figcaption></figure>
        <figure class="mx-pol mx-pol-b"><img src={IMG.heroB} alt="Pink and green maximalist salon with layered patterns" loading="lazy" decoding="async" fetchpriority="high" /><figcaption>mood: LOUDER</figcaption></figure>
        <div class="mx-burst mx-burst-a" aria-hidden="true"><span>WOW!</span></div>
        <div class="mx-burst mx-burst-b" aria-hidden="true"><span>100%<br />EXTRA</span></div>
        <p class="mx-sticker mx-st-a" aria-hidden="true">NO BEIGE ALLOWED</p>
        <p class="mx-sticker mx-st-b" aria-hidden="true">TASTE IS A CAGE</p>
      </div>
      <p class="mx-blast-foot">This page is already too much. That is the point. <a href="#menu">Keep scrolling ↓</a></p>
    </section>

    <div class="mx-ticker" aria-hidden="true">
      <div class="mx-ticker-track">
        <span>BRANDING</span><span>✸</span><span>WEB</span><span>✸</span><span>MOTION</span><span>✸</span><span>MURALS</span><span>✸</span><span>PACKAGING</span><span>✸</span><span>ZINES</span><span>✸</span><span>MERCH</span><span>✸</span><span>SIGNAGE</span><span>✸</span>
        <span>BRANDING</span><span>✸</span><span>WEB</span><span>✸</span><span>MOTION</span><span>✸</span><span>MURALS</span><span>✸</span><span>PACKAGING</span><span>✸</span><span>ZINES</span><span>✸</span><span>MERCH</span><span>✸</span><span>SIGNAGE</span><span>✸</span>
      </div>
    </div>

    <!-- STICKER WALL -->
    <section class="mx-wall" id="menu">
      <div class="mx-wrap">
        <p class="mx-kicker">/// the menu (yes, all of it)</p>
        <h2 class="mx-h2">WE DO <span class="mx-underline">EVERYTHING</span><span class="mx-h2-serif">, obviously.</span></h2>
      </div>
      <div class="mx-stickers" aria-label="Services list">
        <p class="mx-stk mx-c1">Brand identity <small>logos with opinions</small></p>
        <p class="mx-stk mx-c2">Web design <small>sites that refuse to whisper</small></p>
        <p class="mx-stk mx-c3">Motion &amp; animation <small>if it moves, twice</small></p>
        <p class="mx-stk mx-c4">Packaging <small>shelf presence you can hear</small></p>
        <p class="mx-stk mx-c5">Murals &amp; signage <small>walls that yell politely</small></p>
        <p class="mx-stk mx-c6">Zines &amp; print <small>ink, staples and all</small></p>
        <p class="mx-stk mx-c2">Art direction <small>chaos, but scheduled</small></p>
        <p class="mx-stk mx-c3">Illustration <small>turned up to eleven</small></p>
        <p class="mx-stk mx-c4">Social content <small>scroll-stoppers</small></p>
        <p class="mx-stk mx-c5">Exhibition design <small>rooms people photograph</small></p>
        <p class="mx-stk mx-c6">Merch drops <small>tees, totes, odd hats</small></p>
        <p class="mx-stk mx-c1">Naming &amp; voice <small>words with glitter</small></p>
      </div>
      <p class="mx-wrap mx-wall-note">Missing something? <a href="#shout">Tell us.</a> We probably do that too. We do dog portraits now. (Fictional dog portraits.)</p>
    </section>

    <div class="mx-ticker mx-ticker-pink" aria-hidden="true">
      <div class="mx-ticker-track">
        <span>PROOF WE CANNOT SIT STILL</span><span>✸</span><span>PROOF WE CANNOT SIT STILL</span><span>✸</span><span>PROOF WE CANNOT SIT STILL</span><span>✸</span>
        <span>PROOF WE CANNOT SIT STILL</span><span>✸</span><span>PROOF WE CANNOT SIT STILL</span><span>✸</span><span>PROOF WE CANNOT SIT STILL</span><span>✸</span>
      </div>
    </div>

    <!-- SCRAPBOOK SPREAD -->
    <section class="mx-scrap" id="messes">
      <div class="mx-wrap">
        <p class="mx-kicker mx-kicker-light">/// recent beautiful messes</p>
        <h2 class="mx-h2 mx-h2-light">THE <span class="mx-h2-serif">scrapbook</span></h2>
      </div>
      <div class="mx-spread">
        <figure class="mx-scrap-item mx-s1">
          <img src={IMG.work1} alt="Colorful abstract paint artwork for Acid Bloom brand identity" loading="lazy" decoding="async" />
          <figcaption><strong>Acid Bloom</strong><span>Brand identity · client cried (happy)</span></figcaption>
          <span class="mx-mini-burst" aria-hidden="true">HOT</span>
        </figure>
        <figure class="mx-scrap-item mx-s2">
          <img src={IMG.work2} alt="Eclectic gallery wall interior for Chrome Dreams" loading="lazy" decoding="async" />
          <figcaption><strong>Chrome Dreams</strong><span>Website · 47 animations, 0 regrets</span></figcaption>
          <span class="mx-tape" aria-hidden="true"></span>
        </figure>
        <figure class="mx-scrap-item mx-s3">
          <img src={IMG.work3} alt="Colorful maximalist living room for Neon District" loading="lazy" decoding="async" />
          <figcaption><strong>Neon District</strong><span>Mural · visible from space (allegedly)</span></figcaption>
        </figure>
        <figure class="mx-scrap-item mx-s4">
          <img src={IMG.work4} alt="Bright paint splash artwork for Paint Fight packaging" loading="lazy" decoding="async" />
          <figcaption><strong>Paint Fight</strong><span>Packaging · went viral-ish</span></figcaption>
          <span class="mx-mini-burst" aria-hidden="true">WOW</span>
        </figure>
        <p class="mx-scrap-note" aria-hidden="true">your logo here, but LOUD →</p>
      </div>
    </section>

    <!-- GRAFFITI CREED -->
    <section class="mx-creed" id="creed">
      <div class="mx-wrap">
        <p class="mx-kicker">/// the maximalist creed (abridged, barely)</p>
        <div class="mx-creed-wall">
          <blockquote class="mx-c1"><p>"Whitespace is just space you forgot to decorate."</p></blockquote>
          <blockquote class="mx-c2"><p>"If it doesn't clash, it doesn't slap."</p></blockquote>
          <blockquote class="mx-c3"><p>"Taste is a cage. We ate the cage. It was delicious."</p></blockquote>
          <blockquote class="mx-c4"><p>"Restraint is a design choice. So is a marching band."</p></blockquote>
        </div>
        <p class="mx-creed-foot">Signed, the twelve of us, in twelve different fonts. <a href="#shout">Argue with us →</a></p>
      </div>
    </section>

    <!-- CARNIVAL TICKETS -->
    <section class="mx-tickets" id="tickets">
      <div class="mx-wrap">
        <p class="mx-kicker mx-kicker-light">/// pricing, but make it loud</p>
        <h2 class="mx-h2 mx-h2-light">CHAOS <span class="mx-h2-serif">tickets</span></h2>
        <p class="mx-ticket-sub">Admit one (1) project to maximum design. Tear along the dotted line.</p>
        <div class="mx-ticket-row">
          <article class="mx-ticket">
            <div class="mx-ticket-stub"><span>ADMIT<br />ONE</span></div>
            <div class="mx-ticket-main">
              <h3>Mild Chaos</h3>
              <p class="mx-price">$2.5k</p>
              <p class="mx-tier-sub">For the chaos-curious.</p>
              <ul>
                <li>One loud thing (logo, site, or poster)</li>
                <li>Two rounds of revisions (we beg for a third)</li>
                <li>One (1) tasteful moment, framed</li>
                <li>Delivery in 3 weeks, glitter included</li>
              </ul>
              <a class="mx-btn mx-btn-dark" href="#shout">Start mild</a>
            </div>
          </article>
          <article class="mx-ticket mx-ticket-hot">
            <div class="mx-ticket-stub"><span>MOST<br />POPULAR</span></div>
            <div class="mx-ticket-main">
              <h3>Full Chaos</h3>
              <p class="mx-price">$8k</p>
              <p class="mx-tier-sub">Our signature. Buckle up.</p>
              <ul>
                <li>Brand identity + website, clashing beautifully</li>
                <li>Motion pack: intros, stickers, loops</li>
                <li>Social templates (30, all loud)</li>
                <li>Unlimited revisions until we all laugh</li>
                <li>Launch confetti (digital, then real)</li>
              </ul>
              <a class="mx-btn mx-btn-pink" href="#shout">Go full chaos</a>
            </div>
          </article>
          <article class="mx-ticket">
            <div class="mx-ticket-stub"><span>ADMIT<br />ONE</span></div>
            <div class="mx-ticket-main">
              <h3>Total Chaos</h3>
              <p class="mx-price">$20k+</p>
              <p class="mx-tier-sub">The everything bagel of design.</p>
              <ul>
                <li>Everything in Full Chaos, plus murals</li>
                <li>Packaging, merch drop, zine</li>
                <li>Launch party art direction</li>
                <li>A marching band (fictional, but loud)</li>
              </ul>
              <a class="mx-btn mx-btn-dark" href="#shout">Go total</a>
            </div>
          </article>
        </div>
        <p class="mx-ticket-note">All prices fictional. All enthusiasm real. Taxes extra, glitter free.</p>
      </div>
    </section>

    <!-- SHOUT -->
    <section class="mx-shout" id="shout">
      <div class="mx-wrap mx-shout-in">
        <div class="mx-shout-copy">
          <p class="mx-kicker mx-kicker-light">/// say hi, loudly</p>
          <h2 class="mx-h2 mx-h2-light">READY FOR <span class="mx-h2-serif">maximum</span> DESIGN?</h2>
          <p class="mx-shout-txt">Tell us about your project. The louder the brief, the faster we reply. Quiet briefs also accepted (we will fix them).</p>
          <div class="mx-mega" aria-hidden="true">📢</div>
          <ul class="mx-shout-list">
            <li><strong>Studio</strong><span>404, boulevard Saint-Laurent, Montréal QC</span></li>
            <li><strong>Phone</strong><span><a href="tel:+15145550142">(514) 555-0142</a></span></li>
            <li><strong>Email</strong><span><a href="mailto:hello@maximal.studio">hello@maximal.studio</a></span></li>
            <li><strong>Hours</strong><span>Mon to Fri, 9 to 6, loud o'clock always</span></li>
          </ul>
        </div>
        <form class="mx-form" id="mx-form" novalidate>
          <h3>Brief us</h3>
          <label>Your name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>Chaos level
            <select name="level">
              <option>Mild Chaos</option>
              <option>Full Chaos</option>
              <option>Total Chaos</option>
              <option>Unsure (we will decide for you)</option>
            </select>
          </label>
          <label>Your project
            <textarea name="message" rows="4" placeholder="Tell us everything. Use caps if needed."></textarea>
          </label>
          <button class="mx-btn mx-btn-lime" type="submit">Send it LOUD</button>
          <p class="mx-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="mx-footer">
    <p class="mx-footer-giant" aria-hidden="true">MAXIMAL</p>
    <div class="mx-wrap mx-footer-in">
      <p>© 2026 MAXIMAL. Fictional demo. No beige was harmed.</p>
      <p>404, boulevard Saint-Laurent, Montréal QC · <a href="tel:+15145550142">(514) 555-0142</a> · <a href="mailto:hello@maximal.studio">hello@maximal.studio</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      // Mobile menu toggle
      var burgerEl = document.querySelector('.mx-burger');
      var navEl = document.querySelector('.mx-navwrap');
      if (burgerEl instanceof HTMLButtonElement) {
        var burger = burgerEl;
        var nav = navEl;
        burger.addEventListener('click', function () {
          var open = nav ? nav.classList.toggle('mx-nav-open') : false;
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
          burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });
        document.querySelectorAll('.mx-nav-links a').forEach(function (a) {
          a.addEventListener('click', function () {
            if (nav) nav.classList.remove('mx-nav-open');
            burger.setAttribute('aria-expanded', 'false');
            burger.setAttribute('aria-label', 'Open menu');
          });
        });
      }
      // MAKE IT LOUDER: spawn random stickers on the collage
      var louderEl = document.getElementById('mx-louder');
      var stageEl = document.getElementById('mx-stage');
      var countEl = document.getElementById('mx-count');
      var words = ['WOW!', 'EXTRA!', 'LOUDER!', 'YES!', 'MORE!', 'BAM!', 'CHAOS!', 'GLITTER!', 'NO BEIGE!', 'TURN IT UP!'];
      var classes = ['mx-st-a', 'mx-st-b', 'mx-st-c', 'mx-st-d'];
      var n = 0;
      if (louderEl && stageEl) {
        var louder = louderEl;
        var stage = stageEl;
        var count = countEl;
        louder.addEventListener('click', function () {
          var el = document.createElement('p');
          el.className = 'mx-sticker mx-spawned ' + classes[n % classes.length];
          el.setAttribute('aria-hidden', 'true');
          el.textContent = words[n % words.length];
          el.style.left = (4 + Math.random() * 88) + '%';
          el.style.top = (4 + Math.random() * 88) + '%';
          el.style.setProperty('--rot', (Math.random() * 24 - 12).toFixed(1) + 'deg');
          stage.appendChild(el);
          n += 1;
          if (count) count.textContent = '(' + n + ')';
          if (n > 40) {
            var old = stage.querySelector('.mx-spawned');
            if (old) old.remove();
          }
        });
      }
      // Demo form: never submits anywhere
      var formEl = document.getElementById('mx-form');
      if (formEl instanceof HTMLFormElement) {
        var form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.mx-form-note');
          if (note) note.textContent = 'Message received. We will reply with at least three exclamation marks!!!';
          form.reset();
        });
      }
    })();
  </script>

  <style>
    .mx {
      --mx-yellow: #F2FF00;
      --mx-pink: #FF2E9A;
      --mx-blue: #2036FF;
      --mx-lime: #8CFF00;
      --mx-ink: #0B0B0C;
      --mx-paper: #FFFDF5;
      --mx-black: "Archivo Black", "Arial Black", sans-serif;
      --mx-serif: "Playfair Display", Georgia, serif;
      --mx-body: "Space Grotesk", system-ui, sans-serif;
      margin: 0;
      background: var(--mx-yellow);
      color: var(--mx-ink);
      font-family: var(--mx-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .mx *, .mx *::before, .mx *::after { box-sizing: border-box; }
    .mx img { display: block; max-width: 100%; }
    .mx-wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }

    /* type */
    .mx-kicker { font-weight: 700; font-size: 13px; letter-spacing: 0.28em; text-transform: uppercase; margin: 0 0 18px; }
    .mx-kicker-light { color: var(--mx-paper); }
    .mx-h2 { font-family: var(--mx-black); font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1; text-transform: uppercase; margin: 0 0 44px; }
    .mx-h2-light { color: var(--mx-paper); }
    .mx-h2-serif { font-family: var(--mx-serif); font-style: italic; font-weight: 700; text-transform: none; letter-spacing: 0; }
    .mx-underline { text-decoration: underline wavy var(--mx-pink) 6px; text-underline-offset: 8px; }

    /* buttons */
    .mx-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      font-family: var(--mx-black); font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 18px 34px; text-decoration: none; cursor: pointer; border: 3px solid var(--mx-ink);
      box-shadow: 6px 6px 0 var(--mx-ink); transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .mx-btn:hover { transform: translate(-2px, -2px); box-shadow: 9px 9px 0 var(--mx-ink); }
    .mx-btn-pink { background: var(--mx-pink); color: #fff; }
    .mx-btn-dark { background: var(--mx-ink); color: var(--mx-yellow); }
    .mx-btn-lime { background: var(--mx-lime); color: var(--mx-ink); }
    .mx-btn span { font-family: var(--mx-body); font-weight: 700; }

    /* nav */
    .mx-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .mx-nav {
      display: flex; align-items: center; gap: 18px;
      padding: 14px clamp(16px, 3vw, 36px);
      background: var(--mx-pink); border-bottom: 4px solid var(--mx-ink);
    }
    .mx-logo {
      font-family: var(--mx-black); font-size: 26px; color: #fff; text-decoration: none;
      letter-spacing: 0.02em; margin-right: auto; display: flex; align-items: center; gap: 6px;
      text-shadow: 3px 3px 0 var(--mx-ink);
    }
    .mx-logo-star { color: var(--mx-yellow); font-size: 22px; }
    .mx-burger { display: none; background: var(--mx-yellow); border: 3px solid var(--mx-ink); width: 48px; height: 44px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
    .mx-burger span { display: block; width: 24px; height: 4px; background: var(--mx-ink); }
    .mx-nav-links { display: flex; align-items: center; gap: 4px; }
    .mx-nav-links a {
      color: #fff; text-decoration: none; font-weight: 700; font-size: 14px; letter-spacing: 0.08em;
      text-transform: uppercase; padding: 10px 14px; border: 2px solid transparent;
    }
    .mx-nav-links a:hover { background: var(--mx-yellow); color: var(--mx-ink); border-color: var(--mx-ink); }
    .mx-nav-cta { background: var(--mx-ink); color: var(--mx-yellow) !important; border: 2px solid var(--mx-ink) !important; }

    /* blast: collage explosion */
    .mx-blast { position: relative; padding: 120px 0 30px; border-bottom: 6px solid var(--mx-ink); overflow: hidden; }
    .mx-checker {
      position: absolute; inset: 0; opacity: 0.14; pointer-events: none;
      background: repeating-conic-gradient(var(--mx-ink) 0% 25%, transparent 0% 50%) 0 0 / 56px 56px;
    }
    .mx-blast-stage {
      position: relative; z-index: 2; max-width: 1200px; margin: 0 auto;
      padding: 40px clamp(20px, 4vw, 40px) 120px; min-height: 92vh;
    }
    .mx-blast-kicker { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 26px; position: relative; z-index: 5; }
    .mx-tag {
      font-weight: 700; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
      background: var(--mx-ink); color: var(--mx-yellow); padding: 8px 14px; transform: rotate(-1.5deg);
    }
    .mx-tag-pink { background: var(--mx-pink); color: #fff; transform: rotate(1.2deg); }
    .mx-tag-blue { background: var(--mx-blue); color: #fff; transform: rotate(-0.8deg); }
    .mx-blast-h1 { font-family: var(--mx-black); margin: 0 0 26px; line-height: 0.88; text-transform: uppercase; position: relative; z-index: 5; }
    .mx-b1 { display: block; font-size: clamp(4.2rem, 17vw, 12rem); color: var(--mx-pink); text-shadow: 5px 5px 0 var(--mx-ink), 10px 10px 0 var(--mx-blue); transform: rotate(-2deg); }
    .mx-b2 { display: block; font-size: clamp(3rem, 12vw, 8.5rem); color: var(--mx-ink); transform: rotate(1.4deg); margin-top: 6px; }
    .mx-b2 em { font-family: var(--mx-serif); font-style: italic; color: var(--mx-blue); }
    .mx-blast-lede {
      position: relative; z-index: 5; font-size: 18px; line-height: 1.55; max-width: 46ch; margin: 0 0 30px;
      background: var(--mx-paper); border: 3px solid var(--mx-ink); padding: 18px 22px;
      box-shadow: 6px 6px 0 var(--mx-ink); transform: rotate(0.6deg);
    }
    .mx-blast-cta { display: flex; gap: 16px; flex-wrap: wrap; position: relative; z-index: 5; }
    .mx-pol { position: absolute; background: #fff; border: 3px solid var(--mx-ink); padding: 12px 12px 8px; margin: 0; box-shadow: 8px 8px 0 var(--mx-ink); width: min(250px, 38vw); z-index: 3; }
    .mx-pol img { width: 100%; height: 170px; object-fit: cover; border: 2px solid var(--mx-ink); }
    .mx-pol figcaption { font-family: var(--mx-black); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; padding: 10px 4px 6px; text-align: center; }
    .mx-pol-a { top: 90px; right: 4%; transform: rotate(5deg); }
    .mx-pol-b { bottom: 60px; right: 16%; transform: rotate(-6deg); }
    .mx-burst {
      position: absolute; z-index: 4; display: flex; align-items: center; justify-content: center;
      text-align: center; font-family: var(--mx-black); text-transform: uppercase;
      clip-path: polygon(100% 50%, 86.7% 59.8%, 93.3% 75%, 76.9% 76.9%, 75% 93.3%, 59.8% 86.7%, 50% 100%, 40.2% 86.7%, 25% 93.3%, 23.1% 76.9%, 6.7% 75%, 13.3% 59.8%, 0% 50%, 13.3% 40.2%, 6.7% 25%, 23.1% 23.1%, 25% 6.7%, 40.2% 13.3%, 50% 0%, 59.8% 13.3%, 75% 6.7%, 76.9% 23.1%, 93.3% 25%, 86.7% 40.2%);
      animation: mx-spin 14s linear infinite;
    }
    @keyframes mx-spin { to { transform: rotate(360deg); } }
    .mx-burst-a { width: 150px; height: 150px; background: var(--mx-lime); top: 300px; right: 30%; font-size: 22px; }
    .mx-burst-b { width: 180px; height: 180px; background: var(--mx-blue); bottom: 200px; left: 2%; font-size: 20px; color: #fff; animation-direction: reverse; }
    .mx-sticker {
      position: absolute; z-index: 4; font-family: var(--mx-black); font-size: 14px; letter-spacing: 0.06em;
      background: var(--mx-paper); border: 3px solid var(--mx-ink); padding: 10px 16px; box-shadow: 4px 4px 0 var(--mx-ink);
      margin: 0;
    }
    .mx-st-a { top: 420px; left: 40%; transform: rotate(-8deg); }
    .mx-st-b { bottom: 90px; left: 8%; transform: rotate(7deg); background: var(--mx-lime); }
    .mx-st-c { background: var(--mx-pink); color: #fff; }
    .mx-st-d { background: var(--mx-blue); color: #fff; }
    .mx-spawned { transform: rotate(var(--rot, -4deg)); animation: mx-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    @keyframes mx-pop { from { transform: scale(0) rotate(var(--rot, -4deg)); } to { transform: scale(1) rotate(var(--rot, -4deg)); } }
    .mx-blast-foot { position: relative; z-index: 5; text-align: center; font-weight: 700; font-size: 15px; margin: 0; padding: 10px 20px 30px; }
    .mx-blast-foot a { color: var(--mx-blue); }

    /* tickers */
    .mx-ticker { position: relative; z-index: 2; background: var(--mx-ink); color: var(--mx-yellow); border-bottom: 6px solid var(--mx-ink); overflow: hidden; padding: 14px 0; }
    .mx-ticker-track { display: inline-flex; gap: 26px; white-space: nowrap; font-family: var(--mx-black); font-size: 20px; letter-spacing: 0.06em; animation: mx-tick 18s linear infinite; }
    @keyframes mx-tick { to { transform: translateX(-50%); } }
    .mx-ticker-pink { background: var(--mx-pink); color: #fff; border-bottom: none; border-top: 6px solid var(--mx-ink); }

    /* sticker wall */
    .mx-wall { background: var(--mx-paper); padding: clamp(70px, 9vw, 120px) 0; border-bottom: 6px solid var(--mx-ink); }
    .mx-stickers {
      position: relative; max-width: 1200px; margin: 0 auto; padding: 30px clamp(20px, 4vw, 40px) 50px;
      display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: center;
    }
    .mx-stk {
      margin: 0; border: 3px solid var(--mx-ink); padding: 18px 24px; box-shadow: 5px 5px 0 var(--mx-ink);
      font-family: var(--mx-black); font-size: 19px; text-transform: uppercase;
      transition: transform 0.15s ease; max-width: 300px;
    }
    .mx-stk small { display: block; font-family: var(--mx-body); font-weight: 500; font-size: 13.5px; text-transform: none; margin-top: 6px; }
    .mx-stk:nth-child(odd) { transform: rotate(-1.6deg); }
    .mx-stk:nth-child(even) { transform: rotate(1.3deg); }
    .mx-stk:nth-child(3n) { transform: rotate(-0.7deg) translateY(8px); }
    .mx-stk:hover { transform: rotate(0deg) scale(1.06) !important; z-index: 2; position: relative; }
    .mx-c1 { background: var(--mx-pink); color: #fff; }
    .mx-c2 { background: var(--mx-blue); color: #fff; }
    .mx-c3 { background: var(--mx-lime); }
    .mx-c4 { background: var(--mx-yellow); }
    .mx-c5 { background: var(--mx-ink); color: var(--mx-paper); }
    .mx-c6 { background: #fff; }
    .mx-wall-note { margin: 10px auto 0; font-size: 16px; }
    .mx-wall-note a { color: var(--mx-blue); font-weight: 700; }

    /* scrapbook */
    .mx-scrap { background: var(--mx-blue); padding: clamp(70px, 9vw, 120px) 0; border-bottom: 6px solid var(--mx-ink); }
    .mx-spread { position: relative; max-width: 1200px; margin: 0 auto; padding: 20px clamp(20px, 4vw, 40px) 60px; min-height: 640px; }
    .mx-scrap-item {
      position: absolute; background: var(--mx-paper); border: 4px solid var(--mx-ink); padding: 12px; margin: 0;
      box-shadow: 8px 8px 0 var(--mx-ink); width: min(360px, 80vw);
    }
    .mx-scrap-item img { width: 100%; height: 230px; object-fit: cover; border: 3px solid var(--mx-ink); }
    .mx-scrap-item figcaption { padding: 14px 6px 8px; display: grid; gap: 4px; }
    .mx-scrap-item figcaption strong { font-family: var(--mx-black); font-size: 20px; text-transform: uppercase; }
    .mx-scrap-item figcaption span { font-size: 14px; font-weight: 500; }
    .mx-s1 { top: 0; left: 4%; transform: rotate(-3deg); z-index: 2; }
    .mx-s2 { top: 60px; right: 6%; transform: rotate(2.5deg); z-index: 1; }
    .mx-s3 { top: 330px; left: 12%; transform: rotate(1.8deg); z-index: 3; }
    .mx-s4 { top: 360px; right: 12%; transform: rotate(-2.2deg); z-index: 2; }
    .mx-mini-burst {
      position: absolute; top: -18px; right: -14px; background: var(--mx-lime); color: var(--mx-ink);
      font-family: var(--mx-black); font-size: 13px; padding: 12px 16px; border: 3px solid var(--mx-ink);
      transform: rotate(10deg); box-shadow: 4px 4px 0 var(--mx-ink);
    }
    .mx-tape {
      position: absolute; top: -14px; left: 50%; width: 120px; height: 30px; transform: translateX(-50%) rotate(-4deg);
      background: rgba(242, 255, 0, 0.85); border-left: 2px dashed var(--mx-ink); border-right: 2px dashed var(--mx-ink);
    }
    .mx-scrap-note {
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%) rotate(-2deg); margin: 0;
      font-family: var(--mx-black); font-size: 18px; text-transform: uppercase; color: var(--mx-yellow);
      background: var(--mx-ink); padding: 14px 26px; border: 3px solid var(--mx-yellow); white-space: nowrap;
    }

    /* creed */
    .mx-creed { background: var(--mx-pink); padding: clamp(70px, 9vw, 120px) 0; border-bottom: 6px solid var(--mx-ink); }
    .mx-creed-wall { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 26px; }
    .mx-creed-wall blockquote { margin: 0; padding: 30px 28px; }
    .mx-creed-wall p { font-family: var(--mx-black); font-size: clamp(1.6rem, 4vw, 2.6rem); line-height: 1.05; text-transform: uppercase; margin: 0; }
    .mx-creed .mx-c1 { transform: rotate(-2deg); color: var(--mx-yellow); text-shadow: 3px 3px 0 var(--mx-ink); }
    .mx-creed .mx-c2 { transform: rotate(1.6deg); color: var(--mx-ink); margin-top: 40px; }
    .mx-creed .mx-c3 { transform: rotate(1deg); color: #fff; text-shadow: 3px 3px 0 var(--mx-blue); }
    .mx-creed .mx-c4 { transform: rotate(-1.4deg); color: var(--mx-lime); text-shadow: 3px 3px 0 var(--mx-ink); margin-top: 40px; }
    .mx-creed-foot { margin: 44px 0 0; font-size: 17px; font-weight: 700; }
    .mx-creed-foot a { color: var(--mx-ink); }

    /* tickets */
    .mx-tickets { background: var(--mx-ink); padding: clamp(70px, 9vw, 120px) 0; border-bottom: 6px solid var(--mx-ink); }
    .mx-ticket-sub { color: var(--mx-paper); font-family: var(--mx-serif); font-style: italic; font-size: 19px; margin: 0 0 40px; }
    .mx-ticket-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; align-items: stretch; }
    .mx-ticket { display: grid; grid-template-columns: 84px 1fr; background: var(--mx-paper); border: 4px solid var(--mx-yellow); }
    .mx-ticket-stub {
      background: var(--mx-yellow); border-right: 3px dashed var(--mx-ink);
      display: grid; place-items: center; padding: 20px 8px;
      font-family: var(--mx-black); font-size: 14px; text-transform: uppercase; text-align: center; line-height: 1.4;
    }
    .mx-ticket-hot .mx-ticket-stub { background: var(--mx-pink); color: #fff; }
    .mx-ticket-main { padding: 30px 28px; display: grid; gap: 12px; align-content: start; }
    .mx-ticket-main h3 { font-family: var(--mx-black); font-size: 26px; text-transform: uppercase; margin: 0; }
    .mx-price { font-family: var(--mx-black); font-size: 44px; margin: 0; color: var(--mx-blue); }
    .mx-tier-sub { font-family: var(--mx-serif); font-style: italic; font-size: 18px; margin: 0; }
    .mx-ticket-main ul { list-style: none; margin: 0 0 10px; padding: 0; display: grid; gap: 10px; font-size: 15px; font-weight: 500; }
    .mx-ticket-main li::before { content: "✸ "; color: var(--mx-pink); font-weight: 700; }
    .mx-ticket-note { color: var(--mx-paper); margin: 30px 0 0; font-size: 14px; }

    /* shout */
    .mx-shout { background: var(--mx-lime); padding: clamp(70px, 9vw, 120px) 0; }
    .mx-shout-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 80px); align-items: start; }
    .mx-shout-txt { font-size: 17px; line-height: 1.6; max-width: 44ch; }
    .mx-mega { font-size: 90px; margin: 10px 0 20px; transform: rotate(-8deg); display: inline-block; animation: mx-wiggle 1.6s ease-in-out infinite; }
    @keyframes mx-wiggle { 50% { transform: rotate(6deg) scale(1.08); } }
    .mx-shout-list { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 14px; }
    .mx-shout-list li { background: var(--mx-paper); border: 3px solid var(--mx-ink); padding: 14px 18px; box-shadow: 5px 5px 0 var(--mx-ink); display: grid; gap: 2px; }
    .mx-shout-list strong { font-family: var(--mx-black); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; }
    .mx-shout-list a { color: var(--mx-blue); font-weight: 700; }
    .mx-form { background: var(--mx-ink); color: var(--mx-paper); padding: clamp(28px, 4vw, 44px); display: grid; gap: 16px; border: 4px solid var(--mx-ink); box-shadow: 10px 10px 0 var(--mx-pink); transform: rotate(0.8deg); }
    .mx-form h3 { font-family: var(--mx-black); font-size: 28px; text-transform: uppercase; color: var(--mx-yellow); margin: 0; }
    .mx-form label { display: grid; gap: 8px; font-weight: 700; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mx-yellow); }
    .mx-form input, .mx-form select, .mx-form textarea {
      font-family: var(--mx-body); font-size: 16px; font-weight: 500;
      background: var(--mx-paper); border: 3px solid var(--mx-yellow); color: var(--mx-ink);
      padding: 14px 16px; width: 100%;
    }
    .mx-form input:focus, .mx-form select:focus, .mx-form textarea:focus { outline: 3px solid var(--mx-pink); outline-offset: 2px; }
    .mx-form .mx-btn-lime { width: 100%; }
    .mx-form-note { margin: 0; color: var(--mx-lime); font-weight: 700; font-size: 15px; }
    .mx-form-note:empty { display: none; }

    /* footer */
    .mx-footer { background: var(--mx-ink); color: var(--mx-paper); padding: 70px 0 90px; text-align: center; overflow: hidden; }
    .mx-footer-giant {
      font-family: var(--mx-black); font-size: clamp(3.6rem, 16vw, 12rem); line-height: 0.9; margin: 0 0 30px;
      color: var(--mx-yellow); text-shadow: 5px 5px 0 var(--mx-pink), 10px 10px 0 var(--mx-blue);
      transform: rotate(-1.5deg);
    }
    .mx-footer-in { display: grid; gap: 10px; font-size: 14px; }
    .mx-footer-in p { margin: 0; }
    .mx-footer-in a { color: var(--mx-yellow); font-weight: 700; }

    /* responsive */
    @media (max-width: 1020px) {
      .mx-ticket-row { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .mx-shout-in { grid-template-columns: 1fr; }
      .mx-spread { min-height: 0; display: grid; gap: 30px; padding-bottom: 90px; }
      .mx-scrap-item { position: relative; top: auto !important; left: auto !important; right: auto !important; width: 100%; max-width: 480px; margin-inline: auto; }
      .mx-scrap-note { bottom: 20px; }
      .mx-burst-b { display: none; }
      .mx-pol-a { top: 60px; }
    }
    @media (max-width: 860px) {
      .mx-burger { display: flex; }
      .mx-nav-links {
        display: none; position: absolute; top: 100%; left: 0; right: 0;
        background: var(--mx-ink); flex-direction: column; align-items: stretch; padding: 18px; gap: 8px;
        border-bottom: 4px solid var(--mx-ink);
      }
      .mx-nav-open .mx-nav-links { display: flex; }
      .mx-nav-links a { color: var(--mx-yellow); border: 2px solid var(--mx-yellow); text-align: center; }
      .mx-nav-links a:hover { background: var(--mx-yellow); color: var(--mx-ink); }
      .mx-creed-wall { grid-template-columns: 1fr; }
      .mx-creed .mx-c2, .mx-creed .mx-c4 { margin-top: 0; }
      .mx-pol-b { display: none; }
      .mx-burst-a { width: 110px; height: 110px; font-size: 16px; top: 260px; right: 4%; }
      .mx-st-b { display: none; }
      .mx-blast-stage { min-height: 0; padding-bottom: 60px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mx-ticker-track, .mx-burst, .mx-mega { animation: none; }
      .mx-btn, .mx-stk { transition: none; }
      .mx-stk:hover { transform: none; }
      .mx-spawned { animation: none; }
    }
  </style>
</body>
</html>
