---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Hexline Systems, fictional neural interface security startup.
// Rebuilt as a TERMINAL. No marketing hero: the page opens with a boot
// sequence, navigation is a command line, and every section reads as terminal
// output. Cybercore art direction: near-black, neon cyan/magenta.
const IMG = {
  hero: "/demos/hexline/01.jpg",
  lock: "https://images.unsplash.com/photo-1614064641938-3bbee52942c7?q=80&w=800&auto=format&fit=crop",
  servers: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=800&auto=format&fit=crop",
  ops: "/demos/hexline/02.jpg",
  neon: "https://images.unsplash.com/photo-1563089145-599997674d42?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>hexline://systems · neural interface security</title>
  <meta name="description" content="Hexline Systems hardens neural interfaces and connected infrastructure. Type help to begin." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="tm">

  <div class="tm-scan" aria-hidden="true"></div>

  <!-- BOOT SEQUENCE -->
  <section class="tm-boot" aria-label="System boot">
    <div class="tm-boot-in">
      <pre class="tm-lines" id="tm-boot" aria-live="polite"></pre>
      <p class="tm-skip"><a href="#cmd">skip boot ↓</a></p>
    </div>
  </section>

  <!-- COMMAND LINE NAV -->
  <div class="tm-cmdwrap" id="cmd">
    <div class="tm-cmd">
      <span class="tm-ps1">visitor@hexline:~$</span>
      <nav class="tm-cmds" aria-label="Commands">
        <button type="button" data-tm-go="protocols">protocols</button>
        <button type="button" data-tm-go="intel">intel</button>
        <button type="button" data-tm-go="access">access</button>
        <button type="button" data-tm-go="uplink">uplink</button>
        <button type="button" data-tm-go="help">help</button>
      </nav>
      <span class="tm-caret" aria-hidden="true">▌</span>
    </div>
  </div>

  <main class="tm-main">
    <!-- HELP -->
    <section class="tm-out" id="help" aria-label="Help output">
      <p class="tm-echo"><span class="tm-ps1">visitor@hexline:~$</span> help</p>
      <div class="tm-block">
        <p><span class="tm-c">protocols</span> · the defensive stack. what we run, in plain terms.</p>
        <p><span class="tm-c">intel</span> · live telemetry from the demo grid.</p>
        <p><span class="tm-c">access</span> · clearance tiers and pricing.</p>
        <p><span class="tm-c">uplink</span> · open a secure channel to a human.</p>
        <br />
        <p>Hexline hardens neural interfaces and connected infrastructure against intrusion, spoofing, and signal theft. Military-grade cryptography, civilian-friendly deployment. Montréal, est. 2024.</p>
      </div>
    </section>

    <!-- PROTOCOLS -->
    <section class="tm-out" id="protocols" aria-label="Protocols output">
      <p class="tm-echo"><span class="tm-ps1">visitor@hexline:~$</span> protocols --list</p>
      <div class="tm-block">
        <p class="tm-ok">4 protocols loaded.</p>
        <br />
        <p><span class="tm-mag">P-01</span> <span class="tm-w">PERIMETER DEFENSE</span></p>
        <p class="tm-dim">Adaptive firewall mesh that learns attacker patterns in real time. Deploys in under 20 minutes.</p>
        <p class="tm-dim">· behavioral threat modeling · auto-isolation of hostile nodes · DDoS absorption to 2.4 Tbps</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.lock} alt="Surveillance feed: encrypted perimeter lock" loading="lazy" />
          <figcaption>feed 01 · perimeter node</figcaption>
        </figure>
        <br />
        <p><span class="tm-mag">P-02</span> <span class="tm-w">NEURAL MESH HARDENING</span></p>
        <p class="tm-dim">End-to-end encryption for brain-computer interfaces. Every signal signed, every channel verified.</p>
        <p class="tm-dim">· post-quantum key exchange · signal integrity attestation · 4ms anomaly response</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.servers} alt="Surveillance feed: neural mesh servers" loading="lazy" />
          <figcaption>feed 02 · mesh core</figcaption>
        </figure>
        <br />
        <p><span class="tm-mag">P-03</span> <span class="tm-w">INTRUSION COUNTERMEASURES</span></p>
        <p class="tm-dim">Active defense that does not wait for permission. Honeypots, tracer injection, court-ready forensics.</p>
        <p class="tm-dim">· deception grid · attribution tracing · automated retaliation within legal bounds</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.ops} alt="Surveillance feed: security operations analyst" loading="lazy" />
          <figcaption>feed 03 · ops desk</figcaption>
        </figure>
        <br />
        <p><span class="tm-mag">P-04</span> <span class="tm-w">ZERO-TRUST IDENTITY</span></p>
        <p class="tm-dim">No implicit trust. Every user, device, and process re-authenticates continuously.</p>
        <p class="tm-dim">· hardware-bound identity keys · granular access policies</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.neon} alt="Surveillance feed: network visualization" loading="lazy" />
          <figcaption>feed 04 · identity graph</figcaption>
        </figure>
      </div>
    </section>

    <!-- INTEL -->
    <section class="tm-out" id="intel" aria-label="Intel output">
      <p class="tm-echo"><span class="tm-ps1">visitor@hexline:~$</span> intel --live</p>
      <div class="tm-block">
        <p><span class="tm-t">[14:02:11]</span> INTRUSION BLOCKED :: origin 185.220.x.x :: node 7 :: action: DROP</p>
        <p><span class="tm-t">[14:02:08]</span> SPOOF ATTEMPT :: neural channel C :: signature mismatch :: neutralized</p>
        <p><span class="tm-t">[14:01:57]</span> SIGNAL INTEGRITY CHECK :: 4,096 nodes :: <span class="tm-ok">all green</span></p>
        <p><span class="tm-t">[14:01:44]</span> ZERO-DAY SIGNATURE v88.2 deployed fleet-wide in 3.1s</p>
        <p><span class="tm-t">[14:01:31]</span> PHANTOM RELAY :: traced to exit node :: terminated</p>
        <p><span class="tm-t">[14:01:02]</span> KEY ROTATION :: mesh-wide :: completed, zero downtime</p>
        <br />
        <figure class="tm-feed tm-feed-wide">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.hero} alt="Surveillance feed: Hexline operations floor" loading="lazy" />
          <figcaption>feed 00 · operations floor, Montréal</figcaption>
        </figure>
        <br />
        <p class="tm-dim">threats blocked today: <span class="tm-w">1,204,883</span> · mesh integrity: <span class="tm-ok">100%</span> · mean response: <span class="tm-w">4ms</span> · breaches to date: <span class="tm-mag">0</span></p>
        <p class="tm-dim">figures are illustrative telemetry from the demo grid. real deployments report to your own SIEM.</p>
      </div>
    </section>

    <!-- ACCESS -->
    <section class="tm-out" id="access" aria-label="Access tiers output">
      <p class="tm-echo"><span class="tm-ps1">visitor@hexline:~$</span> access --tiers</p>
      <div class="tm-block">
        <p class="tm-ok">3 clearance tiers available.</p>
        <br />
        <p><span class="tm-mag">TIER 01</span> <span class="tm-w">SCOUT</span> <span class="tm-dim">······</span> <span class="tm-c">$490/mo</span></p>
        <p class="tm-dim">perimeter defense, 1 site · daily threat digest · standard support SLA</p>
        <br />
        <p><span class="tm-mag">TIER 02</span> <span class="tm-w">SENTINEL</span> <span class="tm-dim">····</span> <span class="tm-c">$1,900/mo</span> <span class="tm-tag">most deployed</span></p>
        <p class="tm-dim">full protocol stack, 5 sites · neural mesh hardening · live telemetry dashboard · priority SLA</p>
        <br />
        <p><span class="tm-mag">TIER 03</span> <span class="tm-w">OVERLORD</span> <span class="tm-dim">····</span> <span class="tm-c">custom</span></p>
        <p class="tm-dim">unlimited sites + air-gapped option · dedicated countermeasure team · custom integrations</p>
        <br />
        <p class="tm-dim">run <span class="tm-c">uplink</span> to request a tier.</p>
      </div>
    </section>

    <!-- UPLINK -->
    <section class="tm-out" id="uplink" aria-label="Uplink output">
      <p class="tm-echo"><span class="tm-ps1">visitor@hexline:~$</span> uplink --open</p>
      <div class="tm-block">
        <p class="tm-ok">secure channel ready. a human responds within one business day.</p>
        <p class="tm-dim">no cold calls. no mailing lists. ever.</p>
        <br />
        <form class="tm-form" id="tm-form" novalidate>
          <label>callsign<input type="text" name="callsign" required placeholder="ghost.actual" autocomplete="nickname" /></label>
          <label>email<input type="email" name="email" required placeholder="you@company.com" autocomplete="email" /></label>
          <label>objective<textarea name="message" rows="3" placeholder="describe the asset to protect"></textarea></label>
          <button type="submit">transmit_</button>
          <p class="tm-form-note" role="status" aria-live="polite"></p>
        </form>
        <br />
        <p class="tm-dim">voice: <a href="tel:+15145550917">(514) 555-0917</a> · mail: <a href="mailto:uplink@hexline.systems">uplink@hexline.systems</a></p>
        <p class="tm-dim">unit 7, 1010 circuit lane, montréal qc</p>
      </div>
    </section>

    <section class="tm-out tm-end" aria-label="End of transmission">
      <p class="tm-echo"><span class="tm-ps1">visitor@hexline:~$</span> <span class="tm-caret" aria-hidden="true">▌</span></p>
    </section>
  </main>

  <footer class="tm-foot">
    <p>hexline systems · © 2026 · fictional demo · no networks were harmed</p>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var bootEl = document.getElementById('tm-boot');
      var lines = [
        'hexline secure boot v4.2.0',
        'checking mesh integrity ............ OK (4,096 nodes)',
        'loading protocols .................. OK (4 loaded)',
        'verifying operator identity ........ GUEST',
        '',
        'welcome, visitor. type a command above, or scroll.',
      ];
      function renderAll() {
        if (!bootEl) return;
        bootEl.textContent = lines.join('\n');
      }
      if (reduced || !bootEl) { renderAll(); }
      else {
        var li = 0, ci = 0, out = '';
        bootEl.textContent = '';
        (function tick() {
          if (li >= lines.length) return;
          var line = lines[li];
          if (ci <= line.length) {
            out += line.charAt(ci) || '';
            ci++;
            bootEl.textContent = out;
            setTimeout(tick, line.charAt(ci - 1) === '.' ? 8 : 26);
          } else {
            out += '\n'; li++; ci = 0;
            setTimeout(tick, 160);
          }
        })();
      }
      document.querySelectorAll('[data-tm-go]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-tm-go');
          var target = id && document.getElementById(id);
          if (target) target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });
      var form = document.getElementById('tm-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.tm-form-note');
        if (note) note.textContent = '> transmission received. uplink established.';
        if (form instanceof HTMLFormElement) form.reset();
      });
    })();
  </script>

  <style>
    .tm {
      --tm-bg: #05070D;
      --tm-panel: #090D17;
      --tm-line: #1B2740;
      --tm-cyan: #00F0FF;
      --tm-mag: #FF2EA6;
      --tm-text: #C9D6E8;
      --tm-dim: #6E7A90;
      --tm-mono: "JetBrains Mono", ui-monospace, monospace;
      margin: 0;
      background: var(--tm-bg);
      color: var(--tm-text);
      font-family: var(--tm-mono);
      font-size: 15px;
      line-height: 1.9;
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .tm *, .tm *::before, .tm *::after { box-sizing: border-box; }
    .tm img { display: block; max-width: 100%; }
    .tm a { color: var(--tm-cyan); }
    .tm-scan {
      position: fixed; inset: 0; z-index: 90; pointer-events: none;
      background: repeating-linear-gradient(180deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 4px);
    }

    /* boot */
    .tm-boot { min-height: 92svh; display: flex; align-items: center; padding: 40px 0; }
    .tm-boot-in { width: min(860px, 100%); margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .tm-lines { margin: 0; white-space: pre-wrap; font-size: clamp(13px, 2.6vw, 16px); color: var(--tm-cyan); min-height: 12em; text-shadow: 0 0 12px rgba(0,240,255,0.35); }
    .tm-skip { margin: 26px 0 0; }
    .tm-skip a { color: var(--tm-dim); font-size: 13px; text-decoration: none; border-bottom: 1px solid var(--tm-line); }

    /* command bar */
    .tm-cmdwrap {
      position: sticky; top: 0; z-index: 60;
      background: rgba(5, 7, 13, 0.94); backdrop-filter: blur(10px);
      border-block: 1px solid var(--tm-line);
    }
    .tm-cmd {
      width: min(1180px, 100%); margin: 0 auto; padding: 14px clamp(20px, 4vw, 40px);
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .tm-ps1 { color: var(--tm-mag); font-weight: 700; white-space: nowrap; }
    .tm-cmds { display: flex; gap: 4px; flex-wrap: wrap; }
    .tm-cmds button {
      font: inherit; background: transparent; border: 1px solid transparent; cursor: pointer;
      color: var(--tm-cyan); padding: 8px 14px; letter-spacing: 0.06em;
    }
    .tm-cmds button:hover { border-color: var(--tm-line); background: rgba(0,240,255,0.06); }
    .tm-caret { color: var(--tm-cyan); animation: tm-blink 1s steps(2, start) infinite; margin-left: auto; }
    @keyframes tm-blink { 50% { opacity: 0; } }

    /* outputs */
    .tm-main { width: min(1180px, 100%); margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px) 40px; }
    .tm-out { padding: clamp(36px, 6vh, 64px) 0; border-bottom: 1px dashed var(--tm-line); scroll-margin-top: 76px; }
    .tm-end { border-bottom: 0; }
    .tm-echo { margin: 0 0 18px; color: var(--tm-text); font-size: 14px; }
    .tm-block { background: var(--tm-panel); border: 1px solid var(--tm-line); padding: clamp(22px, 3.5vw, 36px); }
    .tm-block p { margin: 0; }
    .tm-block br { display: block; content: ""; margin: 6px 0; }
    .tm-c { color: var(--tm-cyan); }
    .tm-mag { color: var(--tm-mag); }
    .tm-w { color: #fff; font-weight: 700; }
    .tm-dim { color: var(--tm-dim); }
    .tm-ok { color: var(--tm-cyan); }
    .tm-t { color: var(--tm-mag); }
    .tm-tag {
      display: inline-block; font-size: 11px; letter-spacing: 0.14em;
      border: 1px solid var(--tm-cyan); color: var(--tm-cyan); padding: 2px 10px; margin-left: 8px;
    }

    .tm-feed { margin: 18px 0 6px; position: relative; border: 1px solid var(--tm-line); max-width: 520px; }
    .tm-feed-wide { max-width: 720px; }
    .tm-feed img { width: 100%; height: 240px; object-fit: cover; filter: saturate(1.25) contrast(1.05) brightness(0.85); }
    .tm-feed-wide img { height: 320px; }
    .tm-feed::after { content: ""; position: absolute; inset: 0; pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0,0,0,.3) 0 1px, transparent 1px 3px); }
    .tm-feed figcaption { font-size: 11px; letter-spacing: 0.2em; color: var(--tm-dim); padding: 8px 12px; background: #02040A; }
    .tm-rec {
      position: absolute; top: 10px; left: 12px; z-index: 2;
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 10px; letter-spacing: 0.22em; color: #FF5C5C;
    }
    .tm-rec::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #FF3B3B; box-shadow: 0 0 8px #FF3B3B; }
    .tm-rec::after { content: "LIVE"; }

    /* uplink form */
    .tm-form { display: grid; gap: 14px; max-width: 560px; margin-top: 8px; }
    .tm-form label { display: grid; gap: 8px; font-size: 12px; letter-spacing: 0.18em; color: var(--tm-dim); }
    .tm-form input, .tm-form textarea {
      font: inherit; font-size: 14px; color: var(--tm-text);
      background: #02040A; border: 1px solid var(--tm-line); padding: 13px 15px; width: 100%;
    }
    .tm-form input:focus, .tm-form textarea:focus { outline: none; border-color: var(--tm-cyan); box-shadow: 0 0 14px rgba(0,240,255,0.22); }
    .tm-form button {
      font: inherit; font-weight: 700; letter-spacing: 0.1em; cursor: pointer;
      background: var(--tm-cyan); color: #05070D; border: 0; padding: 15px;
      transition: filter 0.15s ease;
    }
    .tm-form button:hover { filter: brightness(1.12); }
    .tm-form-note { color: var(--tm-cyan); }
    .tm-form-note:empty { display: none; }

    .tm-foot { text-align: center; padding: 44px 20px 60px; color: var(--tm-dim); font-size: 12.5px; }

    @media (max-width: 640px) {
      .tm { font-size: 13.5px; }
      .tm-caret { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .tm-caret { animation: none; }
      .tm-form button { transition: none; }
    }
  </style>
</body>
</html>
