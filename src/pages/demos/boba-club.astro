---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Boba Club, fictional bubble tea shop, Québec City.
// Standalone art direction. Y2K chrome gloss. Not connected to the WEBAO theme system.
const IMG = {
  hero: "https://images.unsplash.com/photo-1558857563-b371033873b8?q=80&w=1200&auto=format&fit=crop",
  m1: "https://images.unsplash.com/photo-1587080413959-06b859fb107d?q=80&w=800&auto=format&fit=crop",
  m2: "https://images.unsplash.com/photo-1572490122747-3968b75cc699?q=80&w=800&auto=format&fit=crop",
  m3: "https://images.unsplash.com/photo-1541696432-82c6da8ce7bf?q=80&w=800&auto=format&fit=crop",
  m4: "https://images.unsplash.com/photo-1563805042-7684c019e1cb?q=80&w=800&auto=format&fit=crop",
  g1: "https://images.unsplash.com/photo-1551024506-0bccd828d307?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boba Club: Bubble Tea in Québec City</title>
  <meta name="description" content="Boba Club: the happiest bubble tea spot in Québec City. Taro clouds, brown sugar blaze, matcha glitter. Two locations, endless pearls." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bc">

  <!-- PLAYFUL CENTERED NAV -->
  <header class="bc-navwrap">
    <nav class="bc-nav" aria-label="Primary">
      <div class="bc-nav-side">
        <a href="#menu">Menu</a>
        <a href="#builder">Build a drink</a>
      </div>
      <a class="bc-logo" href="#top" aria-label="Boba Club, home">
        <span class="bc-logo-cup" aria-hidden="true">🧋</span>
        <span class="bc-logo-text">BOBA&nbsp;CLUB</span>
      </a>
      <div class="bc-nav-side">
        <a href="#spots">Spots</a>
        <a href="#club" class="bc-nav-join">Join the club</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="bc-hero">
      <span class="bc-spark bc-spark-1" aria-hidden="true">✦</span>
      <span class="bc-spark bc-spark-2" aria-hidden="true">✦</span>
      <span class="bc-spark bc-spark-3" aria-hidden="true">✧</span>
      <span class="bc-spark bc-spark-4" aria-hidden="true">✦</span>
      <div class="bc-hero-copy">
        <p class="bc-pill">✦ NOW POURING IN QUÉBEC CITY ✦</p>
        <h1 class="bc-h1">PEARLS.<br />ICE. <span class="bc-chrome-text">REPEAT.</span></h1>
        <p class="bc-lede">Bubble tea the way it should be: chewy pearls cooked every two hours, real fruit, milk that is actually milk. Come thirsty.</p>
        <div class="bc-hero-cta">
          <a class="bc-btn bc-btn-gloss" href="#menu">See the menu</a>
          <a class="bc-btn bc-btn-chrome" href="#builder">Build my drink</a>
        </div>
        <div class="bc-hero-badges">
          <span class="bc-badge">🧋 24 flavors</span>
          <span class="bc-badge">✦ Pearls every 2 hrs</span>
          <span class="bc-badge">♡ Loved by 12k locals</span>
        </div>
      </div>
      <figure class="bc-hero-media">
        <div class="bc-arch">
          <img src={IMG.hero} alt="Iced bubble tea cup with pearls and a wide straw" loading="eager" fetchpriority="high" />
        </div>
        <span class="bc-sticker bc-sticker-1" aria-hidden="true">100%<br />CHEwy</span>
        <span class="bc-sticker bc-sticker-2" aria-hidden="true">new!<br />✦ glitter<br />topping</span>
      </figure>
    </section>

    <!-- FLAVOR MENU -->
    <section class="bc-section" id="menu">
      <div class="bc-wrap">
        <p class="bc-kicker">✦ the hits ✦</p>
        <h2 class="bc-h2">Flavors that <span class="bc-chrome-text">sparkle</span></h2>
        <p class="bc-sub">All drinks come iced with pearls included. Swap pearls for popping boba, jelly, or pudding, always free.</p>
        <div class="bc-menu">
          <article class="bc-card bc-card-pink">
            <img src={IMG.m1} alt="Taro cloud bubble tea with a creamy top" loading="lazy" />
            <div class="bc-card-in">
              <h3>Taro Cloud</h3>
              <p>Roasted taro whipped into milk, crowned with salted cream foam.</p>
              <p class="bc-price">$6.90</p>
            </div>
          </article>
          <article class="bc-card bc-card-blue">
            <img src={IMG.m2} alt="Brown sugar blaze milk tea with tiger stripes" loading="lazy" />
            <div class="bc-card-in">
              <h3>Brown Sugar Blaze</h3>
              <p>Tiger-stripe brown sugar pearls, torched top, fresh cold milk.</p>
              <p class="bc-price">$7.20</p>
            </div>
          </article>
          <article class="bc-card bc-card-green">
            <img src={IMG.m3} alt="Matcha glitter iced latte with pearls" loading="lazy" />
            <div class="bc-card-in">
              <h3>Matcha Glitter</h3>
              <p>Ceremonial-grade matcha whisked to order, oat milk, edible shimmer.</p>
              <p class="bc-price">$7.50</p>
            </div>
          </article>
          <article class="bc-card bc-card-lav">
            <img src={IMG.m4} alt="Strawberry static fruit tea with pearls" loading="lazy" />
            <div class="bc-card-in">
              <h3>Strawberry Static</h3>
              <p>Real strawberries crushed over jasmine green tea, extra fizzy pearls.</p>
              <p class="bc-price">$6.50</p>
            </div>
          </article>
          <article class="bc-card bc-card-yolk">
            <div class="bc-card-art" aria-hidden="true">🥭</div>
            <div class="bc-card-in">
              <h3>Mango Orbit</h3>
              <p>Alphonso mango slush with coconut jelly rings. Tastes like July.</p>
              <p class="bc-price">$6.90</p>
            </div>
          </article>
          <article class="bc-card bc-card-mint">
            <div class="bc-card-art" aria-hidden="true">🍇</div>
            <div class="bc-card-in">
              <h3>Lychee Prism</h3>
              <p>Lychee green tea with rainbow jelly and a lychee popping pearl core.</p>
              <p class="bc-price">$6.50</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- BUILD YOUR DRINK -->
    <section class="bc-section bc-section-chrome" id="builder">
      <div class="bc-wrap">
        <p class="bc-kicker">✦ your rules ✦</p>
        <h2 class="bc-h2">Build your drink in 3 steps</h2>
        <div class="bc-steps">
          <article class="bc-step">
            <span class="bc-step-n">1</span>
            <h3>Pick your tea</h3>
            <p>Classic milk tea, jasmine green, oolong, Thai tea, or fruit tea. Decaf options for night owls.</p>
          </article>
          <article class="bc-step">
            <span class="bc-step-n">2</span>
            <h3>Pick your pearls</h3>
            <p>Classic tapioca, brown sugar, popping mango, lychee jelly, egg pudding, or go wild and mix three.</p>
          </article>
          <article class="bc-step">
            <span class="bc-step-n">3</span>
            <h3>Pick your vibe</h3>
            <p>Ice level, sugar level, milk swap, extra foam. Your cup, your math. We never judge.</p>
          </article>
        </div>
        <p class="bc-builder-note">Indecisive? Ask for the <strong>"Surprise me"</strong>: our crew invents something off-menu, $6 flat.</p>
      </div>
    </section>

    <!-- GALLERY STRIP -->
    <section class="bc-section" id="gallery">
      <div class="bc-wrap">
        <p class="bc-kicker">✦ fresh from the counter ✦</p>
        <h2 class="bc-h2">Sip, snap, repeat</h2>
      </div>
      <div class="bc-strip">
        <figure><img src={IMG.m2} alt="Close-up of a swirled brown sugar boba drink" loading="lazy" /><figcaption>@boba.club</figcaption></figure>
        <figure><img src={IMG.m1} alt="Taro bubble tea held up against a pastel wall" loading="lazy" /><figcaption>@boba.club</figcaption></figure>
        <figure><img src={IMG.g1} alt="Dessert-style boba drink with whipped topping" loading="lazy" /><figcaption>@boba.club</figcaption></figure>
        <figure><img src={IMG.m4} alt="Pink strawberry boba drink with a wide straw" loading="lazy" /><figcaption>@boba.club</figcaption></figure>
        <figure><img src={IMG.m3} alt="Green matcha boba drink with ice" loading="lazy" /><figcaption>@boba.club</figcaption></figure>
      </div>
    </section>

    <!-- LOCATIONS -->
    <section class="bc-section bc-section-pastel" id="spots">
      <div class="bc-wrap">
        <p class="bc-kicker">✦ come say hi ✦</p>
        <h2 class="bc-h2">Two spots, same sparkle</h2>
        <div class="bc-spots">
          <article class="bc-spot">
            <h3>♡ Old Québec</h3>
            <p>200, rue Fictive<br />Québec City QC</p>
            <p class="bc-spot-hours">Mon–Sun · 10:00–22:00</p>
            <a class="bc-btn bc-btn-gloss bc-btn-sm" href="tel:+14185550100">Call (418) 555-0100</a>
          </article>
          <article class="bc-spot">
            <h3>♡ Sainte-Foy</h3>
            <p>45, rue Fictive<br />Québec City QC</p>
            <p class="bc-spot-hours">Mon–Sun · 11:00–21:00</p>
            <a class="bc-btn bc-btn-gloss bc-btn-sm" href="tel:+14185550101">Call (418) 555-0101</a>
          </article>
        </div>
      </div>
    </section>

    <!-- JOIN -->
    <section class="bc-section" id="club">
      <div class="bc-wrap bc-club">
        <p class="bc-kicker">✦ the inner circle ✦</p>
        <h2 class="bc-h2">Join the Boba Club</h2>
        <p class="bc-sub">Every 8th drink free, secret flavors first, birthday pearls on us. One cute email a month, never more.</p>
        <form class="bc-form" id="bc-form" novalidate>
          <label>YOUR NAME<input type="text" name="name" required placeholder="Alex Tremblay" /></label>
          <label>EMAIL<input type="email" name="email" required placeholder="alex@example.com" /></label>
          <button class="bc-btn bc-btn-chrome" type="submit">Count me in ✦</button>
          <p class="bc-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="bc-footer">
    <p class="bc-footer-giant" aria-hidden="true">BOBA CLUB</p>
    <div class="bc-wrap bc-footer-in">
      <p class="bc-footer-line">© 2026 Boba Club. Fictional demo. No real pearls were harmed.</p>
      <p class="bc-footer-line">200, rue Fictive, Québec City QC · <a href="tel:+14185550100">(418) 555-0100</a></p>
      <p class="bc-footer-line bc-footer-spark" aria-hidden="true">✦ ✧ ✦ ✧ ✦</p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo form: never submits anywhere
    (function () {
      var form = document.getElementById('bc-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.bc-form-note');
        if (note) note.textContent = 'Yay, you are in! Check your inbox for a welcome treat.';
      });
    })();
  </script>

  <style>
    .bc {
      --bc-pink: #FFD6EC;
      --bc-pink-deep: #FF8FC7;
      --bc-lav: #DCCBFF;
      --bc-blue: #C4E4FF;
      --bc-cream: #FFF9F4;
      --bc-ink: #3B2A4A;
      --bc-chrome: linear-gradient(180deg, #ffffff 0%, #e6ecf7 28%, #b9c3d8 50%, #eef3fb 72%, #ffffff 100%);
      --bc-font: "Baloo 2", "Comic Sans MS", system-ui, sans-serif;
      margin: 0;
      background:
        radial-gradient(circle at 12% 8%, var(--bc-pink) 0 220px, transparent 221px),
        radial-gradient(circle at 88% 4%, var(--bc-blue) 0 260px, transparent 261px),
        radial-gradient(circle at 50% 100%, var(--bc-lav) 0 300px, transparent 301px),
        var(--bc-cream);
      color: var(--bc-ink);
      font-family: var(--bc-font);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .bc *, .bc *::before, .bc *::after { box-sizing: border-box; }
    .bc img { display: block; max-width: 100%; }
    .bc-wrap { max-width: 1140px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }

    /* nav */
    .bc-navwrap { position: sticky; top: 12px; z-index: 50; padding: 0 clamp(12px, 3vw, 32px); }
    .bc-nav {
      max-width: 860px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(14px);
      border: 3px solid #fff;
      border-radius: 999px;
      padding: 10px 22px;
      box-shadow: 0 12px 32px rgba(255, 143, 199, 0.28);
    }
    .bc-nav-side { display: flex; gap: 8px; }
    .bc-nav-side a {
      color: var(--bc-ink); text-decoration: none; font-weight: 700; font-size: 15px;
      padding: 10px 18px; border-radius: 999px; transition: background 0.15s ease;
    }
    .bc-nav-side a:hover { background: var(--bc-pink); }
    .bc-nav-join { background: var(--bc-chrome); border: 2px solid #fff; box-shadow: 0 4px 12px rgba(120, 130, 160, 0.3); }
    .bc-logo { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--bc-ink); line-height: 1; }
    .bc-logo-cup { font-size: 30px; filter: drop-shadow(0 3px 0 rgba(255,143,199,0.5)); }
    .bc-logo-text { font-weight: 800; font-size: 17px; letter-spacing: 0.02em; }

    /* type */
    .bc-kicker { text-align: center; font-weight: 700; letter-spacing: 0.3em; font-size: 13px; color: #b0568f; margin: 0 0 12px; }
    .bc-h1 {
      font-weight: 800; font-size: clamp(3.2rem, 9vw, 6.4rem);
      line-height: 0.95; letter-spacing: -0.01em; margin: 0 0 20px;
    }
    .bc-h2 { font-weight: 800; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; text-align: center; margin: 0 0 14px; letter-spacing: -0.01em; }
    .bc-sub { text-align: center; font-size: 16.5px; max-width: 56ch; margin: 0 auto 40px; line-height: 1.6; }
    .bc-chrome-text {
      background: linear-gradient(100deg, #8fa3c8 10%, #ffffff 35%, #9db2d6 55%, #ffffff 75%, #8fa3c8 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      filter: drop-shadow(0 2px 0 rgba(255,255,255,0.9)) drop-shadow(0 4px 8px rgba(140,150,180,0.35));
    }

    /* buttons */
    .bc-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--bc-font); font-weight: 800; font-size: 16px;
      padding: 15px 34px; border-radius: 999px; text-decoration: none; cursor: pointer;
      border: 3px solid #fff; transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .bc-btn:hover { transform: translateY(-3px) scale(1.02); }
    .bc-btn-gloss {
      background: linear-gradient(180deg, var(--bc-pink-deep), #ff6fae);
      color: #fff; text-shadow: 0 1px 2px rgba(150, 20, 80, 0.35);
      box-shadow: 0 10px 24px rgba(255, 111, 174, 0.45), inset 0 2px 0 rgba(255,255,255,0.55);
    }
    .bc-btn-chrome {
      background: var(--bc-chrome); color: var(--bc-ink);
      box-shadow: 0 10px 24px rgba(140, 150, 180, 0.4), inset 0 2px 0 rgba(255,255,255,0.9);
    }
    .bc-btn-sm { font-size: 14px; padding: 11px 24px; }
    .bc-pill {
      display: inline-block; background: #fff; border: 3px solid #fff; border-radius: 999px;
      font-weight: 800; font-size: 13px; letter-spacing: 0.18em;
      padding: 10px 22px; margin: 0 0 24px; color: #b0568f;
      box-shadow: 0 8px 20px rgba(255, 143, 199, 0.35);
    }

    /* hero */
    .bc-hero {
      position: relative;
      display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(30px, 5vw, 70px);
      max-width: 1200px; margin: 0 auto; align-items: center;
      padding: clamp(50px, 7vw, 100px) clamp(20px, 4vw, 40px) clamp(60px, 8vw, 110px);
    }
    .bc-lede { font-size: 18px; line-height: 1.6; max-width: 44ch; margin: 0 0 30px; }
    .bc-hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
    .bc-hero-badges { display: flex; gap: 10px; flex-wrap: wrap; }
    .bc-badge {
      background: rgba(255,255,255,0.85); border: 2px solid #fff; border-radius: 999px;
      padding: 8px 16px; font-size: 13.5px; font-weight: 700;
      box-shadow: 0 6px 14px rgba(180, 160, 220, 0.3);
    }
    .bc-hero-media { position: relative; margin: 0; justify-self: center; }
    .bc-arch {
      border-radius: 999px 999px 48px 48px; overflow: hidden;
      border: 6px solid #fff;
      box-shadow: 0 30px 60px rgba(255, 143, 199, 0.4), 0 12px 0 rgba(220, 203, 255, 0.5);
      transform: rotate(2deg);
    }
    .bc-arch img { width: min(420px, 74vw); height: min(540px, 96vw); object-fit: cover; }
    .bc-sticker {
      position: absolute; display: grid; place-items: center; text-align: center;
      font-weight: 800; font-size: 15px; line-height: 1.15; color: var(--bc-ink);
      border-radius: 50%; border: 3px solid #fff;
      box-shadow: 0 10px 22px rgba(150, 110, 200, 0.4);
    }
    .bc-sticker-1 { width: 118px; height: 118px; top: 6%; left: -34px; background: var(--bc-lav); transform: rotate(-12deg); animation: bc-wobble 4s ease-in-out infinite; }
    .bc-sticker-2 { width: 132px; height: 132px; bottom: 8%; right: -24px; background: var(--bc-blue); transform: rotate(9deg); animation: bc-wobble 5s ease-in-out infinite reverse; }
    .bc-spark { position: absolute; color: #fff; text-shadow: 0 0 12px rgba(255, 143, 199, 0.9); animation: bc-float 5s ease-in-out infinite; pointer-events: none; }
    .bc-spark-1 { top: 12%; left: 6%; font-size: 34px; }
    .bc-spark-2 { top: 30%; right: 4%; font-size: 22px; animation-delay: 1.2s; }
    .bc-spark-3 { bottom: 18%; left: 44%; font-size: 26px; animation-delay: 2.1s; }
    .bc-spark-4 { top: 6%; right: 30%; font-size: 18px; animation-delay: 0.6s; }
    @keyframes bc-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-16px) rotate(18deg); } }
    @keyframes bc-wobble { 0%, 100% { margin-top: 0; } 50% { margin-top: -10px; } }

    /* sections */
    .bc-section { padding: clamp(60px, 8vw, 110px) 0; }
    .bc-section-chrome { background: linear-gradient(180deg, rgba(255,255,255,0.65), rgba(220, 203, 255, 0.35)); border-block: 3px solid #fff; }
    .bc-section-pastel { background: linear-gradient(180deg, var(--bc-pink), var(--bc-lav)); border-block: 3px solid #fff; }

    /* menu cards */
    .bc-menu { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .bc-card {
      border-radius: 36px; overflow: hidden; border: 4px solid #fff;
      box-shadow: 0 18px 40px rgba(190, 130, 210, 0.3);
      transition: transform 0.18s ease;
      display: flex; flex-direction: column;
    }
    .bc-card:hover { transform: translateY(-6px) rotate(-0.6deg); }
    .bc-card img { width: 100%; height: 220px; object-fit: cover; }
    .bc-card-art { height: 220px; display: grid; place-items: center; font-size: 88px; }
    .bc-card-in { padding: 22px 24px 26px; display: grid; gap: 8px; flex: 1; }
    .bc-card-in h3 { margin: 0; font-size: 24px; font-weight: 800; }
    .bc-card-in p { margin: 0; font-size: 14.5px; line-height: 1.55; }
    .bc-price {
      font-size: 22px; font-weight: 800; margin-top: 6px;
      display: inline-block; background: #fff; border-radius: 999px; padding: 4px 18px;
      box-shadow: 0 4px 10px rgba(120, 100, 160, 0.25); justify-self: start;
    }
    .bc-card-pink { background: linear-gradient(160deg, #ffe3f1, var(--bc-pink)); }
    .bc-card-blue { background: linear-gradient(160deg, #e2f1ff, var(--bc-blue)); }
    .bc-card-green { background: linear-gradient(160deg, #e4f7e4, #c8ecC8); }
    .bc-card-lav { background: linear-gradient(160deg, #efe7ff, var(--bc-lav)); }
    .bc-card-yolk { background: linear-gradient(160deg, #fff3d6, #ffe1a8); }
    .bc-card-mint { background: linear-gradient(160deg, #e0fff4, #bdf0dd); }

    /* builder */
    .bc-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
    .bc-step {
      background: rgba(255,255,255,0.9); border: 4px solid #fff; border-radius: 32px;
      padding: 30px 26px; text-align: center;
      box-shadow: 0 16px 34px rgba(150, 140, 200, 0.28);
    }
    .bc-step-n {
      display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%;
      background: var(--bc-chrome); font-size: 28px; font-weight: 800; margin-bottom: 14px;
      border: 3px solid #fff; box-shadow: 0 6px 14px rgba(140, 150, 180, 0.35);
    }
    .bc-step h3 { margin: 0 0 10px; font-size: 22px; font-weight: 800; }
    .bc-step p { margin: 0; font-size: 14.5px; line-height: 1.6; }
    .bc-builder-note { text-align: center; margin: 34px auto 0; font-size: 16px; max-width: 60ch; background: #fff; border-radius: 999px; padding: 14px 28px; border: 3px solid #fff; box-shadow: 0 8px 20px rgba(255, 143, 199, 0.3); width: fit-content; }

    /* gallery strip */
    .bc-strip {
      display: flex; gap: 18px; overflow-x: auto; padding: 10px clamp(20px, 4vw, 40px) 26px;
      scrollbar-width: thin;
    }
    .bc-strip figure {
      margin: 0; flex: none; width: 250px;
      border-radius: 28px; overflow: hidden; border: 4px solid #fff;
      box-shadow: 0 14px 30px rgba(190, 130, 210, 0.3);
      transform: rotate(-1.2deg);
    }
    .bc-strip figure:nth-child(even) { transform: rotate(1.4deg); }
    .bc-strip img { width: 100%; height: 300px; object-fit: cover; }
    .bc-strip figcaption { background: #fff; text-align: center; font-weight: 700; font-size: 13.5px; padding: 10px; color: #b0568f; }

    /* spots */
    .bc-spots { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 40px; }
    .bc-spot {
      background: rgba(255,255,255,0.92); border: 4px solid #fff; border-radius: 36px;
      padding: 36px 32px; text-align: center; display: grid; gap: 10px; justify-items: center;
      box-shadow: 0 18px 40px rgba(160, 120, 200, 0.3);
    }
    .bc-spot h3 { margin: 0; font-size: 28px; font-weight: 800; }
    .bc-spot p { margin: 0; font-size: 15.5px; line-height: 1.6; }
    .bc-spot-hours { font-weight: 800; color: #b0568f; }

    /* join form */
    .bc-club { max-width: 640px; }
    .bc-form {
      background: rgba(255,255,255,0.9); border: 4px solid #fff; border-radius: 40px;
      padding: clamp(26px, 4vw, 44px); display: grid; gap: 18px; margin-top: 34px;
      box-shadow: 0 20px 44px rgba(255, 143, 199, 0.35);
    }
    .bc-form label { display: grid; gap: 8px; font-weight: 800; font-size: 13px; letter-spacing: 0.14em; }
    .bc-form input {
      font-family: var(--bc-font); font-weight: 600; font-size: 16px;
      padding: 14px 22px; border-radius: 999px; border: 3px solid var(--bc-pink);
      background: #fff; color: var(--bc-ink); width: 100%;
    }
    .bc-form input:focus { outline: 3px solid var(--bc-pink-deep); outline-offset: 2px; }
    .bc-form-note { margin: 0; text-align: center; font-weight: 700; font-size: 15px; }
    .bc-form-note:empty { display: none; }

    /* footer */
    .bc-footer { padding: 70px 0 90px; text-align: center; }
    .bc-footer-giant {
      font-weight: 800; font-size: clamp(3rem, 11vw, 8.5rem); line-height: 1; margin: 0 0 26px;
      background: linear-gradient(100deg, #ff8fc7 10%, #ffffff 40%, #b9a8ff 60%, #ffffff 80%, #8fc7ff 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      filter: drop-shadow(0 3px 0 rgba(255,255,255,0.9));
    }
    .bc-footer-in { display: grid; gap: 8px; }
    .bc-footer-line { margin: 0; font-size: 14.5px; font-weight: 600; }
    .bc-footer-line a { color: var(--bc-ink); }
    .bc-footer-spark { color: #b0568f; letter-spacing: 0.6em; font-size: 18px; }

    @media (max-width: 960px) {
      .bc-hero { grid-template-columns: 1fr; text-align: center; }
      .bc-lede { margin-inline: auto; }
      .bc-hero-cta, .bc-hero-badges { justify-content: center; }
      .bc-menu { grid-template-columns: 1fr 1fr; }
      .bc-steps { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    }
    @media (max-width: 680px) {
      .bc-nav { flex-wrap: wrap; justify-content: center; border-radius: 32px; }
      .bc-logo { order: -1; width: 100%; }
      .bc-menu, .bc-spots { grid-template-columns: 1fr; }
      .bc-sticker-1 { left: -8px; }
      .bc-sticker-2 { right: -6px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .bc-spark, .bc-sticker-1, .bc-sticker-2 { animation: none; }
      .bc-btn, .bc-card { transition: none; }
    }
  </style>
</body>
