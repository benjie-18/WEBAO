  <script>
    (function () {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ——— deterministic PRNG + date helpers ——————————————— */
      const mulberry = function (seed: number) {
        let a = seed >>> 0;
        return function () {
          a |= 0; a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      };
      const daySeed = function (iso: string) {
        let h = 2166136261;
        for (let i = 0; i < iso.length; i++) { h ^= iso.charCodeAt(i); h = Math.imul(h, 16777619); }
        return h >>> 0;
      };
      const toISO = function (d: Date) {
        return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
      };
      const parseISO = function (iso: string) {
        const p = iso.split("-").map(Number);
        return new Date(p[0], (p[1] ?? 1) - 1, p[2] ?? 1);
      };
      const addDays = function (iso: string, n: number) {
        const d = parseISO(iso); d.setDate(d.getDate() + n); return toISO(d);
      };

      /* ——— UTC clock ————————————————————————————————————— */
      const utcEl = document.getElementById("nt-utc") as HTMLElement | null;
      const tickUTC = function () {
        if (!utcEl) return;
        const n = new Date();
        utcEl.textContent = "UTC " + String(n.getUTCHours()).padStart(2, "0") + ":" + String(n.getUTCMinutes()).padStart(2, "0") + ":" + String(n.getUTCSeconds()).padStart(2, "0");
      };
      tickUTC();
      window.setInterval(tickUTC, 1000);

      /* ——— starfield (fixed sky, parallax + zoom) ——————————— */
      const sky = document.getElementById("nt-sky") as HTMLCanvasElement | null;
      const skyCtx = sky ? sky.getContext("2d") : null;
      const stars: { x: number; y: number; r: number; tw: number; depth: number; band: boolean }[] = [];
      (function seedStars() {
        const rnd = mulberry(20261112);
        for (let i = 0; i < 460; i++) {
          const band = rnd() < 0.22;
          let x = rnd(); let y = rnd();
          if (band) {
            // Milky-way band along a soft diagonal.
            const t = rnd();
            x = t;
            y = 0.18 + t * 0.4 + (rnd() - 0.5) * 0.16;
          }
          stars.push({
            x, y,
            r: band ? 0.4 + rnd() * 0.9 : 0.5 + rnd() * 1.5,
            tw: rnd() * Math.PI * 2,
            depth: 0.25 + rnd() * 0.75,
            band,
          });
        }
      })();

      let vw = window.innerWidth; let vh = window.innerHeight; let dpr = Math.min(2, window.devicePixelRatio || 1);
      const resizeSky = function () {
        if (!sky) return;
        vw = window.innerWidth; vh = window.innerHeight;
        dpr = Math.min(2, window.devicePixelRatio || 1);
        sky.width = Math.round(vw * dpr); sky.height = Math.round(vh * dpr);
        sky.style.width = vw + "px"; sky.style.height = vh + "px";
        if (skyCtx) skyCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        drawSky(performance.now());
      };
      const drawHorizon = function (ctx: CanvasRenderingContext2D, rise: number) {
        // rise: 0 = sunk below (deep space), 1 = home horizon at footer.
        const baseY = vh * (1.04 - rise * 0.22);
        ctx.fillStyle = "#05070d";
        ctx.beginPath();
        ctx.moveTo(0, vh);
        ctx.lineTo(0, baseY - 24);
        const pts = [[0.08, -10], [0.16, -26], [0.24, -8], [0.34, -30], [0.44, -14], [0.52, -4], [0.6, -22], [0.7, -12], [0.8, -34], [0.88, -16], [0.96, -26], [1, -12]];
        for (let i = 0; i < pts.length; i++) {
          ctx.lineTo(pts[i][0] * vw, baseY + pts[i][1]);
        }
        ctx.lineTo(vw, vh);
        ctx.closePath();
        ctx.fill();
        // Lodge point-light on the ridge.
        if (rise > 0.25) {
          const g = ctx.createRadialGradient(vw * 0.52, baseY - 6, 0, vw * 0.52, baseY - 6, 46);
          g.addColorStop(0, "rgba(183,176,107," + (0.5 * rise).toFixed(3) + ")");
          g.addColorStop(1, "rgba(183,176,107,0)");
          ctx.fillStyle = g;
          ctx.fillRect(vw * 0.52 - 46, baseY - 52, 92, 92);
        }
      };
      let scrollP = 0;
      const drawSky = function (t: number) {
        if (!skyCtx) return;
        const ctx = skyCtx;
        ctx.clearRect(0, 0, vw, vh);
        const sy = window.scrollY || 0;
        const doc = Math.max(1, document.documentElement.scrollHeight - vh);
        scrollP = Math.min(1, Math.max(0, sy / doc));
        // Ascent: ground (p≈0) → atmosphere → deep space; horizon returns near the footer.
        const ascend = Math.min(1, scrollP / 0.22);
        const returnHome = Math.max(0, (scrollP - 0.82) / 0.18);
        const starAlpha = 0.25 + 0.75 * ascend;
        const tw = reduceMotion ? 0 : t / 1400;
        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];
          const px = ((s.x + (reduceMotion ? 0 : sy * 0.000012 * s.depth)) % 1 + 1) % 1 * vw;
          const py = s.y * vh - sy * 0.045 * s.depth;
          const wrapY = ((py % vh) + vh) % vh;
          const flick = reduceMotion ? 1 : 0.75 + 0.25 * Math.sin(tw + s.tw);
          const a = starAlpha * flick * (s.band ? 0.55 : 0.95) * (0.5 + s.depth * 0.5);
          ctx.globalAlpha = Math.min(1, a);
          ctx.fillStyle = s.band ? "#b7b06b" : "#ede8da";
          ctx.beginPath();
          ctx.arc(px, wrapY, s.r * (0.8 + s.depth * 0.5), 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        drawHorizon(ctx, returnHome > 0 ? returnHome : 1 - ascend);
      };
      const skyLoop = function (t: number) {
        drawSky(t);
        requestAnimationFrame(skyLoop);
      };
      if (sky && skyCtx) {
        resizeSky();
        window.addEventListener("resize", resizeSky);
        if (!reduceMotion) requestAnimationFrame(skyLoop);
        else drawSky(0);
        window.addEventListener("scroll", function () { if (reduceMotion) drawSky(0); }, { passive: true });
      }

      /* ——— the orrery ————————————————————————————————————— */
      type OrbitBody = { id: string; r: number; inc: number; phase: number; speed: number; label: string; meta: string };
      const BODIES: OrbitBody[] = [
        { id: "vigil", r: 0.92, inc: 0.34, phase: 0.4, speed: 1.0, label: "Telescope vigil", meta: "0.9 AU · nightly" },
        { id: "walk", r: 1.34, inc: -0.5, phase: 1.9, speed: 0.62, label: "Constellation walk", meta: "1.4 AU · Thu–Sun" },
        { id: "optics", r: 1.76, inc: 0.62, phase: 3.3, speed: 0.4, label: "Optics workshop", meta: "1.9 AU · biweekly" },
        { id: "dome", r: 2.18, inc: -0.22, phase: 4.6, speed: 0.25, label: "Boréal dome", meta: "2.3 AU · stays" },
        { id: "photo", r: 2.6, inc: 0.78, phase: 5.7, speed: 0.16, label: "Astrophoto night", meta: "2.8 AU · monthly" },
      ];
      const ocanvas = document.getElementById("nt-orrery") as HTMLCanvasElement | null;
      const octx = ocanvas ? ocanvas.getContext("2d") : null;
      let yaw = 0.6; let pitch = 0.5; let yawVel = reduceMotion ? 0 : 0.0016;
      let dragging = false; let lastX = 0; let lastY = 0;
      let selected = "vigil";
      const osize = { w: 560, h: 560 };

      const sizeOrrery = function () {
        if (!ocanvas || !octx) return;
        const rect = ocanvas.getBoundingClientRect();
        const csize = Math.max(220, Math.round(rect.width));
        dpr = Math.min(2, window.devicePixelRatio || 1);
        ocanvas.width = Math.round(csize * dpr);
        ocanvas.height = Math.round(csize * dpr);
        osize.w = csize; osize.h = csize;
        octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const project = function (x: number, y: number, z: number) {
        // yaw about Y, then pitch about X, then weak perspective.
        const cy = Math.cos(yaw); const sy2 = Math.sin(yaw);
        const x1 = x * cy + z * sy2;
        const z1 = -x * sy2 + z * cy;
        const cp = Math.cos(pitch); const sp = Math.sin(pitch);
        const y2 = y * cp - z1 * sp;
        const z2 = y * sp + z1 * cp;
        const F = 6.2;
        const k = F / (F + z2);
        const S = Math.min(osize.w, osize.h) * 0.155;
        return { sx: osize.w / 2 + x1 * k * S, sy: osize.h / 2 + y2 * k * S, k, behind: z2 > 0.15 };
      };

      const drawOrrery = function (t: number) {
        if (!octx) return;
        const ctx = octx;
        ctx.clearRect(0, 0, osize.w, osize.h);
        // Sun = the lodge.
        const sunG = ctx.createRadialGradient(osize.w / 2, osize.h / 2, 2, osize.w / 2, osize.h / 2, 26);
        sunG.addColorStop(0, "rgba(216,210,154,0.95)");
        sunG.addColorStop(0.5, "rgba(183,176,107,0.5)");
        sunG.addColorStop(1, "rgba(183,176,107,0)");
        ctx.fillStyle = sunG;
        ctx.beginPath(); ctx.arc(osize.w / 2, osize.h / 2, 26, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = "#ede8da";
        ctx.beginPath(); ctx.arc(osize.w / 2, osize.h / 2, 5.5, 0, Math.PI * 2); ctx.fill();
        ctx.font = "10px 'Courier Prime', monospace";
        ctx.textAlign = "center";
        ctx.fillStyle = "rgba(237,232,218,0.75)";
        ctx.fillText("LA MAISON", osize.w / 2, osize.h / 2 + 42);

        const tt = reduceMotion ? 0 : t / 1000;
        for (let b = 0; b < BODIES.length; b++) {
          const body = BODIES[b];
          const isSel = body.id === selected;
          // Orbit ring.
          ctx.beginPath();
          for (let i = 0; i <= 72; i++) {
            const th = (i / 72) * Math.PI * 2;
            const p = project(Math.cos(th) * body.r, 0, Math.sin(th) * body.r);
            if (i === 0) ctx.moveTo(p.sx, p.sy); else ctx.lineTo(p.sx, p.sy);
          }
          ctx.strokeStyle = isSel ? "rgba(216,210,154,0.85)" : "rgba(183,176,107,0.3)";
          ctx.lineWidth = isSel ? 1.4 : 1;
          ctx.stroke();

          const th = body.phase + tt * body.speed * 0.35;
          const pos = project(Math.cos(th) * body.r, 0, Math.sin(th) * body.r);
          const alpha = pos.behind ? 0.45 : 1;
          ctx.globalAlpha = alpha;
          // Planet bead.
          if (isSel) {
            ctx.beginPath();
            ctx.arc(pos.sx, pos.sy, 11, 0, Math.PI * 2);
            ctx.strokeStyle = "rgba(216,210,154,0.9)";
            ctx.lineWidth = 1;
            ctx.stroke();
          }
          ctx.fillStyle = isSel ? "#d8d29a" : "#b7b06b";
          ctx.beginPath(); ctx.arc(pos.sx, pos.sy, isSel ? 5.5 : 4.2, 0, Math.PI * 2); ctx.fill();
          // Label (only on roomy canvases, or for the selected body).
          if (osize.w >= 300 || isSel) {
            ctx.textAlign = "left";
            ctx.font = (isSel ? "700 " : "") + "10px 'Courier Prime', monospace";
            ctx.fillStyle = isSel ? "rgba(216,210,154,0.95)" : "rgba(237,232,218,0.6)";
            ctx.fillText(body.label.toUpperCase(), pos.sx + 12, pos.sy - 6);
            ctx.font = "9px 'Courier Prime', monospace";
            ctx.fillStyle = "rgba(183,176,107,0.65)";
            ctx.fillText(body.meta, pos.sx + 12, pos.sy + 6);
          }
          ctx.globalAlpha = 1;
        }
      };

      const oLoop = function (t: number) {
        if (!dragging) {
          yaw += yawVel;
          yawVel = yawVel * 0.985 + (reduceMotion ? 0 : 0.0016) * 0.015;
        }
        drawOrrery(t);
        requestAnimationFrame(oLoop);
      };

      const selectBody = function (id: string) {
        selected = id;
        document.querySelectorAll<HTMLElement>(".nt-ephem-row").forEach(function (row) {
          row.classList.toggle("is-sel", row.getAttribute("data-orbit") === id);
        });
        drawOrrery(performance.now());
      };

      if (ocanvas && octx) {
        sizeOrrery();
        window.addEventListener("resize", function () { sizeOrrery(); drawOrrery(performance.now()); });
        selectBody("vigil");
        if (!reduceMotion) requestAnimationFrame(oLoop);
        else drawOrrery(0);

        ocanvas.addEventListener("pointerdown", function (e) {
          dragging = true; lastX = e.clientX; lastY = e.clientY;
          ocanvas.setPointerCapture(e.pointerId);
        });
        ocanvas.addEventListener("pointermove", function (e) {
          if (!dragging) return;
          const dx = e.clientX - lastX; const dy = e.clientY - lastY;
          lastX = e.clientX; lastY = e.clientY;
          yaw += dx * 0.006;
          pitch = Math.max(-0.15, Math.min(1.25, pitch + dy * 0.005));
          yawVel = dx * 0.0004;
          if (reduceMotion) drawOrrery(0);
        });
        const endDrag = function () { dragging = false; };
        ocanvas.addEventListener("pointerup", endDrag);
        ocanvas.addEventListener("pointercancel", endDrag);

        ocanvas.addEventListener("click", function (e) {
          const rect = ocanvas.getBoundingClientRect();
          const mx = e.clientX - rect.left; const my = e.clientY - rect.top;
          const tt = reduceMotion ? 0 : performance.now() / 1000;
          let best = -1; let bestD = 18;
          for (let b = 0; b < BODIES.length; b++) {
            const body = BODIES[b];
            const th = body.phase + tt * body.speed * 0.35;
            const pos = project(Math.cos(th) * body.r, 0, Math.sin(th) * body.r);
            const d = Math.hypot(pos.sx - mx, pos.sy - my);
            if (d < bestD) { bestD = d; best = b; }
          }
          if (best >= 0) selectBody(BODIES[best].id);
        });
      }

      document.querySelectorAll<HTMLElement>(".nt-ephem-row").forEach(function (row) {
        const pick = function () { selectBody(row.getAttribute("data-orbit") ?? "vigil"); };
        row.addEventListener("click", pick);
        row.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); }
        });
      });

      /* ——— moon phase + planner ————————————————————————————— */
      const dateInput = document.getElementById("nt-date") as HTMLInputElement | null;
      const bookDate = document.getElementById("nt-book-date") as HTMLInputElement | null;
      const moonShade = document.getElementById("nt-moon-shade") as SVGPathElement | null;
      const moonHand = document.getElementById("nt-moon-hand") as SVGLineElement | null;
      const moonName = document.getElementById("nt-moon-name") as HTMLElement | null;
      const moonIllum = document.getElementById("nt-moon-illum") as HTMLElement | null;
      const moonNote = document.getElementById("nt-moon-note") as HTMLElement | null;
      const altFill = document.getElementById("nt-alt-fill") as HTMLElement | null;
      const altRead = document.getElementById("nt-alt-read") as HTMLElement | null;
      const azRead = document.getElementById("nt-az-read") as HTMLElement | null;
      const azNeedle = document.getElementById("nt-az-needle") as SVGLineElement | null;
      const fcast = document.getElementById("nt-fcast") as HTMLElement | null;
      const obsBody = document.getElementById("nt-obs-body") as HTMLElement | null;

      const PHASES_EN = ["New moon", "Waxing crescent", "First quarter", "Waxing gibbous", "Full moon", "Waning gibbous", "Last quarter", "Waning crescent"];

      const moonAge = function (iso: string) {
        // Synodic month from a known new moon (2000-01-06 18:14 UTC).
        const ref = Date.UTC(2000, 0, 6, 18, 14);
        const d = parseISO(iso).getTime() + 12 * 3600 * 1000;
        const syn = 29.530588853;
        const days = (d - ref) / 86400000;
        return ((days % syn) + syn) % syn;
      };
      const moonPhaseData = function (iso: string) {
        const age = moonAge(iso);
        const frac = age / 29.530588853;
        const illum = (1 - Math.cos(2 * Math.PI * frac)) / 2;
        const idx = Math.floor((frac * 8) + 0.5) % 8;
        return { age, frac, illum, name: PHASES_EN[idx], waxing: frac < 0.5 };
      };

      const drawMoon = function (iso: string) {
        const ph = moonPhaseData(iso);
        // Terminator: circle + ellipse whose x-radius follows |cos| of phase.
        if (moonShade) {
          // Two-arc terminator: dark semicircle + ellipse return arc.
          // Waxing (northern): dark limb on the left; crescents bulge into the lit side.
          const rx = (Math.abs(Math.cos(2 * Math.PI * ph.frac)) * 34).toFixed(2);
          let d: string;
          if (ph.frac < 0.5) {
            d = "M70 36 A34 34 0 0 0 70 104 A" + rx + " 34 0 0 " + (ph.frac < 0.25 ? 0 : 1) + " 70 36 Z";
          } else {
            d = "M70 36 A34 34 0 0 1 70 104 A" + rx + " 34 0 0 " + (ph.frac < 0.75 ? 0 : 1) + " 70 36 Z";
          }
          moonShade.setAttribute("d", d);
        }
        if (moonHand) {
          const ang = ph.frac * 360 - 90;
          const rad = (ang * Math.PI) / 180;
          moonHand.setAttribute("x2", (70 + Math.cos(rad) * 58).toFixed(1));
          moonHand.setAttribute("y2", (70 + Math.sin(rad) * 58).toFixed(1));
        }
        if (moonName) moonName.textContent = ph.name;
        if (moonIllum) moonIllum.textContent = Math.round(ph.illum * 100) + " % illuminated";
        if (moonNote) {
          if (ph.illum > 0.85) moonNote.textContent = "Full disc. Deep sky washed out; open clusters and planets only.";
          else if (ph.illum < 0.12) moonNote.textContent = "Moonless hours all night. The Milky Way's grain is visible from the ridge.";
          else if (ph.waxing) moonNote.textContent = "Sets after midnight; dark enough for deep sky late.";
          else moonNote.textContent = "Rises after midnight; the first half of the night is dark.";
        }
        return ph;
      };

      type ObjState = { alt: number; az: number };
      const objStates: Record<string, ObjState> = { moon: { alt: 42, az: 140 }, vega: { alt: 55, az: 300 }, aldebaran: { alt: 38, az: 90 }, andromeda: { alt: 47, az: 310 }, saturn: { alt: 25, az: 210 } };
      let activeObj = "moon";

      const OBJ_META: Record<string, { best: number; typ: number }> = {
        moon: { best: 11, typ: 78 }, vega: { best: 7, typ: 72 }, aldebaran: { best: 0, typ: 60 },
        andromeda: { best: 8, typ: 55 }, saturn: { best: 1, typ: 48 },
      };

      const computeObj = function (id: string, iso: string): ObjState {
        const d = parseISO(iso);
        const month = d.getMonth();
        const day = d.getDate();
        const meta = OBJ_META[id];
        const season = Math.cos((2 * Math.PI * (month - meta.best)) / 12);
        const base = meta.typ * (0.3 + 0.7 * Math.max(0, season * 0.5 + 0.5));
        const wave = Math.sin(((day % 29) / 29) * Math.PI * 2 + meta.best);
        const alt = Math.max(4, Math.min(86, Math.round(base * (0.8 + 0.2 * wave))));
        const seedR = mulberry(daySeed(iso + id));
        const az = Math.round((120 + seedR() * 200) % 360);
        return { alt, az };
      };

      const paintReadout = function () {
        const iso = dateInput ? dateInput.value : "2026-12-21";
        const st = computeObj(activeObj, iso);
        objStates[activeObj] = st;
        if (altFill) altFill.style.height = (st.alt / 90 * 100).toFixed(1) + "%";
        if (altRead) altRead.textContent = String(st.alt);
        if (azRead) azRead.textContent = String(st.az);
        if (azNeedle) azNeedle.style.transform = "rotate(" + st.az + "deg)";
      };

      const OBS_POOL = [
        { name: "Moon", type: "Satellite", after: "18 h 40", min: "Binoculars", deep: false },
        { name: "Saturn, ring tilt 3.1°", type: "Planet", after: "19 h 10", min: "80 mm scope", deep: false },
        { name: "Pleiades (M45)", type: "Cluster", after: "21 h 00", min: "Naked eye", deep: false },
        { name: "Orion Nebula (M42)", type: "Nebula", after: "22 h 15", min: "Binoculars", deep: true },
        { name: "Andromeda (M31)", type: "Galaxy", after: "20 h 30", min: "Binoculars", deep: true },
        { name: "Double Cluster", type: "Cluster", after: "23 h 00", min: "Naked eye", deep: false },
        { name: "Jupiter + Galilean moons", type: "Planet", after: "18 h 55", min: "60 mm scope", deep: false },
        { name: "Flame & Horsehead", type: "Nebula", after: "23 h 30", min: "200 mm scope", deep: true },
        { name: "Omega Centauri (grazing)", type: "Cluster", after: "01 h 10", min: "100 mm scope", deep: true },
      ];
      const paintObs = function (iso: string, illum: number) {
        if (!obsBody) return;
        const rnd = mulberry(daySeed(iso + "obs"));
        const picks: typeof OBS_POOL = [];
        const used: Record<number, boolean> = {};
        while (picks.length < 6) {
          const i = Math.floor(rnd() * OBS_POOL.length);
          if (!used[i]) { used[i] = true; picks.push(OBS_POOL[i]); }
        }
        let html = "";
        for (let i = 0; i < picks.length; i++) {
          const o = picks[i];
          const washed = o.deep && illum > 0.72;
          html += "<tr class=\"" + (washed ? "is-washed" : "") + "\"><td>" + o.name + "</td><td class=\"mono\">" + o.type + "</td><td class=\"mono\">" + o.after + "</td><td class=\"mono\">" + o.min +
            (washed ? " <span class=\"nt-washmark\">MOONWASH</span>" : "") + "</td></tr>";
        }
        obsBody.innerHTML = html;
      };

      const paintForecast = function (iso: string) {
        if (!fcast) return;
        let html = "";
        let firstSeeing = 3;
        for (let i = 0; i < 7; i++) {
          const day = addDays(iso, i);
          const rnd = mulberry(daySeed(day));
          const transp = 1 + Math.floor(rnd() * 5);
          const seeing = 1 + Math.floor(rnd() * 5);
          if (i === 0) firstSeeing = seeing;
          const cloud = Math.floor(rnd() * 88);
          const ph = moonPhaseData(day);
          const moonless = Math.round((1 - ph.illum) * 9.6 * 10) / 10;
          const d = parseISO(day);
          html += "<button class=\"nt-fcast-cell" + (i === 0 ? " is-sel" : "") + "\" type=\"button\" data-day=\"" + day + "\" aria-label=" + JSON.stringify("Night of " + (d.getMonth() + 1) + " " + d.getDate()) + ">" +
            "<span class=\"nt-fc-date\">" + String(d.getMonth() + 1).padStart(2, "0") + "/" + String(d.getDate()).padStart(2, "0") + "</span>" +
            "<div class=\"nt-fc-lab\">Transp</div><div class=\"nt-fc-bar\"><i class=\"nt-fc-transp\" style=\"width:" + (transp * 20) + "%\"></i></div>" +
            "<div class=\"nt-fc-lab\">Seeing</div><div class=\"nt-fc-bar\"><i class=\"nt-fc-seeing\" style=\"width:" + (seeing * 20) + "%\"></i></div>" +
            "<div class=\"nt-fc-lab\">Dark h</div><div class=\"nt-fc-bar\"><i class=\"nt-fc-moon\" style=\"width:" + Math.min(100, moonless * 10.4).toFixed(0) + "%\"></i></div>" +
            "<div class=\"nt-fc-cloud\">cloud " + cloud + " %</div></button>";
        }
        fcast.innerHTML = html;
        const seeingEl = document.getElementById("nt-seeing") as HTMLElement | null;
        if (seeingEl) seeingEl.textContent = firstSeeing + "/5";
      };

      const refreshNight = function (iso: string) {
        const ph = drawMoon(iso);
        paintReadout();
        paintForecast(iso);
        paintObs(iso, ph.illum);
      };

      if (dateInput) {
        dateInput.addEventListener("change", function () {
          if (bookDate) bookDate.value = dateInput.value;
          refreshNight(dateInput.value);
        });
        refreshNight(dateInput.value);
      }
      const stepDay = document.getElementById("nt-day-prev");
      const stepNext = document.getElementById("nt-day-next");
      stepDay?.addEventListener("click", function () {
        if (!dateInput) return;
        dateInput.value = addDays(dateInput.value, -1);
        if (bookDate) bookDate.value = dateInput.value;
        refreshNight(dateInput.value);
      });
      stepNext?.addEventListener("click", function () {
        if (!dateInput) return;
        dateInput.value = addDays(dateInput.value, 1);
        if (bookDate) bookDate.value = dateInput.value;
        refreshNight(dateInput.value);
      });
      fcast?.addEventListener("click", function (e) {
        const cell = (e.target as HTMLElement).closest<HTMLElement>(".nt-fcast-cell");
        if (!cell || !dateInput) return;
        dateInput.value = cell.getAttribute("data-day") ?? dateInput.value;
        if (bookDate) bookDate.value = dateInput.value;
        refreshNight(dateInput.value);
      });
      document.querySelectorAll<HTMLButtonElement>(".nt-objchip").forEach(function (chip) {
        chip.addEventListener("click", function () {
          document.querySelectorAll(".nt-objchip").forEach(function (c) { c.setAttribute("aria-pressed", "false"); });
          chip.setAttribute("aria-pressed", "true");
          activeObj = chip.getAttribute("data-obj") ?? "moon";
          paintReadout();
        });
      });

      /* ——— constellation connector ————————————————————————— */
      const CONST_INFO: Record<string, string> = {
        ursa: "Great Bear · circumpolar, never sets · the pointer stars find Polaris, the walk's first lesson.",
        cassiopeia: "Cassiopeia · the W on the meridian after supper · seat of the attendant who named the ridge.",
        cygnus: "Cygnus · the summer cross, flying the Milky Way · best table for binoculars in July.",
        bootes: "Boötes · kite behind the Bear · Arcturus is the bright one; follow the handle's curve.",
      };
      const CONST_TITLES: Record<string, string> = { ursa: "Great Bear", cassiopeia: "Cassiopeia", cygnus: "Cygnus", bootes: "Boötes" };
      const constInfo = document.getElementById("nt-const-info") as HTMLElement | null;

      const drawConst = function (id: string) {
        document.querySelectorAll<SVGPathElement>(".nt-c-line").forEach(function (line) {
          const match = line.getAttribute("data-con-line") === id;
          line.classList.remove("is-draw");
          if (match) {
            // restart animation
            void line.getBoundingClientRect();
            line.classList.add("is-draw");
          } else {
            line.style.opacity = "0.18";
          }
        });
        document.querySelectorAll<SVGPathElement>(".nt-c-line[data-con-line=\"" + id + "\"]").forEach(function (line) { line.style.opacity = "0.9"; });
        if (constInfo) constInfo.innerHTML = "<b>" + CONST_TITLES[id] + "</b> · " + CONST_INFO[id].split("·").slice(1).join("·");
      };
      document.querySelectorAll<HTMLButtonElement>(".nt-cchip").forEach(function (chip) {
        chip.addEventListener("click", function () {
          document.querySelectorAll(".nt-cchip").forEach(function (c) { c.setAttribute("aria-pressed", "false"); });
          chip.setAttribute("aria-pressed", "true");
          drawConst(chip.getAttribute("data-con") ?? "ursa");
        });
      });
      // Draw the default figure once the chart enters view.
      const chartFrame = document.querySelector(".nt-chart-frame");
      if (chartFrame && "IntersectionObserver" in window) {
        const cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { drawConst("ursa"); cio.disconnect(); }
          });
        }, { threshold: 0.35 });
        cio.observe(chartFrame);
      } else if (chartFrame) {
        drawConst("ursa");
      }

      /* ——— booking orbit ————————————————————————————————— */
      const SESS_ORDER = ["vigil", "walk", "optics", "photo"];
      const ANGLES: Record<string, number> = { vigil: 0, walk: 90, optics: 180, photo: 270 };
      const bookRing = document.getElementById("nt-book-ring") as HTMLElement | null;
      const sessionSelect = document.getElementById("nt-session") as HTMLSelectElement | null;
      let sess = "vigil";

      const showPanel = function (id: string) {
        document.querySelectorAll<HTMLElement>(".nt-bpanel").forEach(function (p) {
          if (p.getAttribute("data-panel") === id) p.removeAttribute("hidden");
          else p.setAttribute("hidden", "");
        });
      };
      const selectSess = function (id: string) {
        sess = id;
        const rot = -ANGLES[id];
        if (bookRing) bookRing.style.transform = "rotate(" + rot + "deg)";
        document.querySelectorAll<HTMLElement>(".nt-sess").forEach(function (btn) {
          const a = Number((btn.getAttribute("style") ?? "").match(/--a:\s*(-?\d+)/)?.[1] ?? "0");
          btn.style.transform = "translate(-50%, -50%) rotate(" + (-rot) + "deg) translateY(-46%) rotate(" + (-a - rot) + "deg)";
          btn.setAttribute("aria-pressed", String(btn.getAttribute("data-sess") === id));
        });
        showPanel(id);
        if (sessionSelect) sessionSelect.value = id;
      };
      document.querySelectorAll<HTMLButtonElement>(".nt-sess").forEach(function (btn) {
        btn.addEventListener("click", function () { selectSess(btn.getAttribute("data-sess") ?? "vigil"); });
      });
      sessionSelect?.addEventListener("change", function () { selectSess(sessionSelect.value); });
      // Collapse panels on load (JS only; without JS all four stay readable).
      selectSess("vigil");
      bookRing?.addEventListener("keydown", function (e) {
        if (!bookRing) return;
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          const i = SESS_ORDER.indexOf(sess);
          const n = e.key === "ArrowRight" ? (i + 1) % SESS_ORDER.length : (i + SESS_ORDER.length - 1) % SESS_ORDER.length;
          selectSess(SESS_ORDER[n]);
        }
      });

      /* ——— booking form —————————————————————————————————— */
      const form = document.getElementById("nt-book-form") as HTMLFormElement | null;
      const stamp = document.getElementById("nt-stamp") as HTMLElement | null;
      const stampRef = document.getElementById("nt-stamp-ref") as HTMLElement | null;
      if (form) {
        const formEl: HTMLFormElement = form;
        formEl.addEventListener("submit", function (e) {
          e.preventDefault();
          const name = (document.getElementById("nt-name") as HTMLInputElement | null)?.value.trim() ?? "";
          const email = (document.getElementById("nt-email") as HTMLInputElement | null)?.value ?? "";
          if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            formEl.reportValidity();
            return;
          }
          const ref = "NCT-" + String(Date.now() % 10000).padStart(4, "0");
          if (stampRef) stampRef.textContent = "Ref " + ref + " · " + (sessionSelect?.selectedOptions[0]?.text ?? sess);
          formEl.style.display = "none";
          if (stamp) stamp.classList.add("is-on");
        });
      }

      /* ——— reveal on scroll ——————————————————————————————— */
      const reveals = document.querySelectorAll(".nt-reveal");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        reveals.forEach(function (el) { el.classList.add("is-in"); });
      } else {
        const rio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add("is-in"); rio.unobserve(entry.target); }
          });
        }, { threshold: 0.1, rootMargin: "0px 0px -5% 0px" });
        reveals.forEach(function (el) { rio.observe(el); });
      }
    })();
  </script>
</body>
</html>
