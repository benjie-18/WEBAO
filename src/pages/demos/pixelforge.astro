---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Pixelforge Games, fictional indie game studio, Montreal.
// Rebuilt as an ARCADE CABINET. The page is a game-select screen: it opens on
// attract mode with a blinking INSERT COIN, games are arcade marquee entries
// (not cards), high scores are a leaderboard table, the devlog reads as patch
// notes. 8-bit art direction, CRT scanlines, chunky buttons.
const IMG = {
  hero: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=1600&auto=format&fit=crop",
  game1: "/demos/pixelforge/02.jpg",
  game2: "/demos/pixelforge/01.jpg",
  game3: "/demos/pixelforge/04.png",
  game4: "/demos/pixelforge/03.jpg",
  studio: "https://images.unsplash.com/photo-1556438064-2d7646166914?q=80&w=1000&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pixelforge Games · Insert coin</title>
  <meta name="description" content="Pixelforge Games: fictional indie studio in Montreal. 14 tiny games, 2 million players, zero polygons harmed. Insert coin." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
</head>
<body class="ac">

  <div class="ac-scan" aria-hidden="true"></div>

  <!-- ATTRACT MODE -->
  <header class="ac-attract" id="top">
    <div class="ac-attract-bg" aria-hidden="true"><img src={IMG.hero} alt="" loading="eager" fetchpriority="high" /></div>
    <div class="ac-attract-in">
      <svg class="ac-invader" viewBox="0 0 11 8" shape-rendering="crispEdges" aria-hidden="true">
        <rect x="2" y="0" width="1" height="1"/><rect x="8" y="0" width="1" height="1"/>
        <rect x="3" y="1" width="1" height="1"/><rect x="7" y="1" width="1" height="1"/>
        <rect x="2" y="2" width="7" height="1"/>
        <rect x="1" y="3" width="2" height="1"/><rect x="4" y="3" width="3" height="1"/><rect x="8" y="3" width="2" height="1"/>
        <rect x="0" y="4" width="11" height="1"/>
        <rect x="0" y="5" width="1" height="1"/><rect x="2" y="5" width="7" height="1"/><rect x="10" y="5" width="1" height="1"/>
        <rect x="0" y="6" width="1" height="1"/><rect x="2" y="6" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/><rect x="10" y="6" width="1" height="1"/>
        <rect x="3" y="7" width="2" height="1"/><rect x="6" y="7" width="2" height="1"/>
      </svg>
      <p class="ac-kicker">Pixelforge Games · Montreal · est. 2017</p>
      <h1 class="ac-logo">Pixelforge</h1>
      <p class="ac-tag">Indie games, maximum pixels. 14 shipped, 2M+ players, zero polygons harmed.</p>
      <a class="ac-insert" href="#select"><span class="ac-blink">▶ Insert coin</span></a>
      <p class="ac-hint">1 player · no continues · boss fight fridays</p>
    </div>
  </header>

  <nav class="ac-nav" aria-label="Cabinet menu">
    <a href="#select">Select</a>
    <a href="#scores">Scores</a>
    <a href="#patches">Patches</a>
    <a href="#continue">Continue?</a>
  </nav>

  <main>
    <!-- GAME SELECT: arcade marquees, not cards -->
    <section class="ac-select" id="select" aria-label="Game select">
      <h2 class="ac-h">Select your game</h2>

      <article class="ac-marquee">
        <div class="ac-marquee-art"><img src={IMG.game1} alt="Duskfall Valley marquee art: pixel sunset over mountains and lake" loading="lazy" /></div>
        <div class="ac-marquee-in">
          <p class="ac-mq-k">Cabinet 01 · exploration · solo</p>
          <h3>Duskfall Valley</h3>
          <p>Wander 40 hand-pixelated valleys at golden hour. No enemies, just vibes.</p>
          <a class="ac-btn" href="#continue">Insert coin</a>
        </div>
      </article>

      <article class="ac-marquee">
        <div class="ac-marquee-art"><img src={IMG.game2} alt="Dungeon Delver marquee art: pixel dungeon crawler battle" loading="lazy" /></div>
        <div class="ac-marquee-in">
          <p class="ac-mq-k">Cabinet 02 · roguelike · solo</p>
          <h3>Dungeon Delver</h3>
          <p>99 procedurally generated floors. Bring a torch. And a backup torch.</p>
          <a class="ac-btn" href="#continue">Insert coin</a>
        </div>
      </article>

      <article class="ac-marquee">
        <div class="ac-marquee-art"><img src={IMG.game3} alt="Meadow Tactics marquee art: top-down pixel RPG battle" loading="lazy" /></div>
        <div class="ac-marquee-in">
          <p class="ac-mq-k">Cabinet 03 · tactical RPG · 1-4 players</p>
          <h3>Meadow Tactics</h3>
          <p>Turn-based battles on a hand-pixelated meadow. Think fast, click faster.</p>
          <a class="ac-btn" href="#continue">Insert coin</a>
        </div>
      </article>

      <article class="ac-marquee">
        <div class="ac-marquee-art"><img src={IMG.game4} alt="Blade Pixel marquee art: pixel swordsman sprite" loading="lazy" /></div>
        <div class="ac-marquee-in">
          <p class="ac-mq-k">Cabinet 04 · action · co-op</p>
          <h3>Blade Pixel</h3>
          <p>One sword, 90 dungeons, zero mercy. Plus double jump.</p>
          <a class="ac-btn" href="#continue">Insert coin</a>
        </div>
      </article>
    </section>

    <!-- LEADERBOARD -->
    <section class="ac-scores" id="scores" aria-label="High scores">
      <h2 class="ac-h">High scores</h2>
      <div class="ac-boards">
        <table class="ac-table">
          <caption>Hall of fame · all cabinets</caption>
          <thead><tr><th scope="col">Rank</th><th scope="col">Player</th><th scope="col">Score</th></tr></thead>
          <tbody>
            <tr><td>1st</td><td>AAA</td><td>9,999,990</td></tr>
            <tr><td>2nd</td><td>PIX3L</td><td>8,420,100</td></tr>
            <tr><td>3rd</td><td>NYB</td><td>7,777,777</td></tr>
            <tr><td>4th</td><td>G4M3R</td><td>6,543,210</td></tr>
            <tr class="ac-you"><td>5th</td><td>You?</td><td>0</td></tr>
          </tbody>
        </table>
        <ul class="ac-studio">
          <li><strong>2M+</strong><span>players worldwide</span></li>
          <li><strong>14</strong><span>games shipped</span></li>
          <li><strong>97%</strong><span>positive reviews</span></li>
          <li><strong>∞</strong><span>cups of coffee</span></li>
        </ul>
      </div>
    </section>

    <!-- PATCH NOTES -->
    <section class="ac-patches" id="patches" aria-label="Patch notes">
      <h2 class="ac-h">Patch notes</h2>
      <ol class="ac-notes">
        <li>
          <p class="ac-ver">v2.4.1 <span>2026-09-28</span></p>
          <p>Boss fight #3 is finally beatable. Probably. Our QA tester cried twice, which we are choosing to read as a good sign.</p>
        </li>
        <li>
          <p class="ac-ver">v2.4.0 <span>2026-09-12</span></p>
          <p>The blob can now wear hats. 40 hats. This took three weeks. We regret nothing. Hats ship Friday.</p>
        </li>
        <li>
          <p class="ac-ver">v2.3.7 <span>2026-08-30</span></p>
          <figure><img src={IMG.studio} alt="The Pixelforge team playtesting a build" loading="lazy" /></figure>
          <p>60 players, 12 pizzas, one broken controller (RIP). The new tactics build survived contact with real humans. Barely.</p>
        </li>
      </ol>
    </section>

    <!-- CONTINUE? -->
    <section class="ac-continue" id="continue" aria-label="Continue">
      <h2 class="ac-h ac-h-dark">Continue?</h2>
      <p class="ac-count" aria-hidden="true">9 · 8 · 7 ···</p>
      <p class="ac-continue-copy">One email a month. Patch notes, secret levels, zero spam. Drop a coin (your email) to keep playing.</p>
      <form class="ac-form" id="ac-form" novalidate>
        <div class="ac-slot" aria-hidden="true"><span></span></div>
        <label>Player email<input type="email" name="email" required placeholder="player1@example.com" autocomplete="email" /></label>
        <button class="ac-btn ac-btn-mag" type="submit">+1UP</button>
        <p class="ac-form-note" role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- CONTACT -->
    <section class="ac-contact" aria-label="Contact">
      <div>
        <h2 class="ac-h">The arcade</h2>
        <p>404 Pixel Lane, Suite 8B<br />Montreal, QC H2X 1Y2<br />Open weekdays, 9am to 6pm</p>
      </div>
      <div>
        <h2 class="ac-h">Transmit</h2>
        <p>Press and players:<br /><a href="mailto:press@pixelforge.games">press@pixelforge.games</a><br /><a href="tel:+15145550188">(514) 555-0188</a></p>
      </div>
    </section>
  </main>

  <footer class="ac-foot">
    <p class="ac-over" aria-hidden="true">Game over?<br />Never.</p>
    <p>© 2026 Pixelforge Games. Fictional demo. No pixels were harmed.<br />404 Pixel Lane, Montreal QC</p>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      var form = document.getElementById('ac-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.ac-form-note');
        if (note) note.textContent = 'Coin accepted! +1UP. Check your inbox, player 1.';
        if (form instanceof HTMLFormElement) form.reset();
      });
    })();
  </script>

  <style>
    .ac {
      --ac-navy: #0F0F23;
      --ac-panel: #171733;
      --ac-green: #7CFF6B;
      --ac-mag: #FF6BD6;
      --ac-yel: #FFE45E;
      --ac-white: #EDEDF7;
      --ac-dim: #9a9ac0;
      --ac-display: "Press Start 2P", monospace;
      --ac-body: "VT323", monospace;
      margin: 0;
      background: var(--ac-navy);
      color: var(--ac-white);
      font-family: var(--ac-body);
      font-size: 21px;
      line-height: 1.45;
      overflow-x: clip;
    }
    .ac *, .ac *::before, .ac *::after { box-sizing: border-box; }
    .ac img { display: block; max-width: 100%; image-rendering: pixelated; }
    .ac a { color: inherit; }
    .ac-scan {
      position: fixed; inset: 0; z-index: 90; pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 2px, transparent 2px 4px);
    }
    .ac-scan::after {
      content: ""; position: absolute; inset: 0;
      background: radial-gradient(ellipse 120% 100% at 50% 50%, transparent 60%, rgba(0, 0, 0, 0.45) 100%);
    }

    /* attract mode */
    .ac-attract { position: relative; min-height: 100svh; display: grid; place-items: center; overflow: hidden; }
    .ac-attract-bg { position: absolute; inset: 0; }
    .ac-attract-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.32) saturate(1.3); }
    .ac-attract-bg::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(15,15,35,0.65), rgba(15,15,35,0.2) 45%, rgba(15,15,35,0.92)); }
    .ac-attract-in { position: relative; z-index: 2; text-align: center; padding: 120px 20px 80px; max-width: 900px; }
    .ac-invader { width: 100px; fill: var(--ac-green); margin: 0 auto 24px; filter: drop-shadow(0 0 14px rgba(124,255,107,0.7)); animation: ac-hover 3s ease-in-out infinite; }
    @keyframes ac-hover { 50% { transform: translateY(-12px); } }
    .ac-kicker { font-family: var(--ac-display); font-size: 10px; letter-spacing: 0.18em; color: var(--ac-mag); margin: 0 0 22px; }
    .ac-logo {
      font-family: var(--ac-display); font-size: clamp(2rem, 9vw, 5.6rem); line-height: 1.2; margin: 0 0 20px;
      color: var(--ac-green); text-shadow: 5px 5px 0 #1d5c1d, 0 0 34px rgba(124,255,107,0.55);
    }
    .ac-tag { font-size: 24px; color: var(--ac-white); max-width: 44ch; margin: 0 auto 36px; }
    .ac-insert {
      display: inline-block; font-family: var(--ac-display); font-size: clamp(0.85rem, 3vw, 1.2rem);
      color: var(--ac-yel); text-decoration: none; text-shadow: 3px 3px 0 #7c5c1d;
      padding: 20px 30px; border: 4px solid var(--ac-yel); background: rgba(15,15,35,0.7);
    }
    .ac-blink { animation: ac-blink 1.1s steps(1) infinite; }
    @keyframes ac-blink { 50% { opacity: 0; } }
    .ac-hint { font-family: var(--ac-display); font-size: 9px; color: var(--ac-dim); letter-spacing: 0.14em; margin: 30px 0 0; }

    /* cabinet menu nav */
    .ac-nav {
      position: sticky; top: 0; z-index: 80;
      display: flex; justify-content: center; gap: 6px; flex-wrap: wrap;
      background: rgba(15, 15, 35, 0.96); border-bottom: 4px solid var(--ac-green);
      padding: 12px 16px;
    }
    .ac-nav a { font-family: var(--ac-display); font-size: 10px; color: var(--ac-dim); text-decoration: none; padding: 12px 16px; }
    .ac-nav a:hover { color: var(--ac-yel); }

    .ac-h {
      font-family: var(--ac-display); font-size: clamp(1.2rem, 4.2vw, 2rem); color: var(--ac-yel);
      text-shadow: 4px 4px 0 #7c5c1d; margin: 0 0 40px; line-height: 1.5;
    }
    .ac-h-dark { color: var(--ac-navy); text-shadow: 4px 4px 0 rgba(15,15,35,0.25); }

    .ac-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--ac-display); font-size: 11px;
      background: var(--ac-green); color: #0F0F23; text-decoration: none; cursor: pointer; border: none;
      padding: 15px 22px;
      box-shadow: inset -4px -4px 0 rgba(0,0,0,0.28), inset 4px 4px 0 rgba(255,255,255,0.35), 0 6px 0 #1d5c1d;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .ac-btn:hover { transform: translateY(2px); box-shadow: inset -4px -4px 0 rgba(0,0,0,0.28), inset 4px 4px 0 rgba(255,255,255,0.35), 0 4px 0 #1d5c1d; }
    .ac-btn:active { transform: translateY(6px); box-shadow: inset -4px -4px 0 rgba(0,0,0,0.28), 0 0 0 #1d5c1d; }
    .ac-btn-mag { background: var(--ac-mag); box-shadow: inset -4px -4px 0 rgba(0,0,0,0.28), inset 4px 4px 0 rgba(255,255,255,0.35), 0 6px 0 #7c1d5c; width: 100%; }
    .ac-btn-mag:hover { box-shadow: inset -4px -4px 0 rgba(0,0,0,0.28), inset 4px 4px 0 rgba(255,255,255,0.35), 0 4px 0 #7c1d5c; }

    /* marquees */
    .ac-select { padding: clamp(70px, 9vw, 120px) clamp(20px, 4vw, 40px); max-width: 1180px; margin: 0 auto; }
    .ac-marquee {
      display: grid; grid-template-columns: 340px 1fr;
      background: var(--ac-panel); margin: 0 0 34px;
      border: 4px solid var(--ac-mag);
      box-shadow: 0 0 34px rgba(255, 107, 214, 0.22), inset 0 0 60px rgba(255,107,214,0.05);
    }
    .ac-marquee:nth-child(3) { border-color: var(--ac-yel); box-shadow: 0 0 34px rgba(255,228,94,0.2), inset 0 0 60px rgba(255,228,94,0.05); }
    .ac-marquee:nth-child(4) { border-color: var(--ac-green); box-shadow: 0 0 34px rgba(124,255,107,0.2), inset 0 0 60px rgba(124,255,107,0.05); }
    .ac-marquee:nth-child(5) { border-color: #87CEFA; box-shadow: 0 0 34px rgba(135,206,250,0.2), inset 0 0 60px rgba(135,206,250,0.05); }
    .ac-marquee-art img { width: 100%; height: 100%; min-height: 220px; object-fit: cover; filter: saturate(1.35) contrast(1.05); }
    .ac-marquee-in { padding: clamp(24px, 3.5vw, 40px); display: grid; gap: 12px; align-content: center; justify-items: start; }
    .ac-mq-k { font-family: var(--ac-display); font-size: 9px; color: var(--ac-dim); letter-spacing: 0.1em; margin: 0; }
    .ac-marquee-in h3 { font-family: var(--ac-display); font-size: clamp(1rem, 3vw, 1.5rem); color: var(--ac-white); margin: 0; line-height: 1.5; }
    .ac-marquee-in p { margin: 0; color: var(--ac-dim); font-size: 22px; max-width: 46ch; }

    /* leaderboard */
    .ac-scores { background: #0b0b1a; border-block: 4px solid var(--ac-green); padding: clamp(70px, 9vw, 120px) clamp(20px, 4vw, 40px); }
    .ac-scores .ac-h { max-width: 1180px; margin: 0 auto 40px; }
    .ac-boards { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 30px; align-items: start; }
    .ac-table { width: 100%; border-collapse: collapse; background: var(--ac-panel); font-size: 23px; }
    .ac-table caption { font-family: var(--ac-display); font-size: 10px; color: var(--ac-dim); letter-spacing: 0.12em; padding-bottom: 16px; text-align: left; }
    .ac-table th { font-family: var(--ac-display); font-size: 9px; color: var(--ac-dim); text-align: left; padding: 12px 16px; border-bottom: 2px solid var(--ac-green); letter-spacing: 0.1em; }
    .ac-table td { padding: 14px 16px; border-bottom: 1px solid rgba(154,154,192,0.18); }
    .ac-table td:first-child { font-family: var(--ac-display); font-size: 11px; color: var(--ac-mag); }
    .ac-table td:last-child { color: var(--ac-green); text-align: right; font-variant-numeric: tabular-nums; }
    .ac-table tbody tr:first-child td { background: rgba(255,228,94,0.08); }
    .ac-you td { color: var(--ac-yel) !important; }
    .ac-studio { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .ac-studio li { background: var(--ac-panel); padding: 22px 12px; text-align: center; display: grid; gap: 6px; }
    .ac-studio strong { font-family: var(--ac-display); font-size: 18px; color: var(--ac-mag); }
    .ac-studio span { color: var(--ac-dim); font-size: 20px; }

    /* patch notes */
    .ac-patches { padding: clamp(70px, 9vw, 120px) clamp(20px, 4vw, 40px); max-width: 880px; margin: 0 auto; }
    .ac-notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
    .ac-notes li { background: #0b0b1a; border: 4px solid var(--ac-green); padding: 26px 28px; box-shadow: 8px 8px 0 rgba(124,255,107,0.15); }
    .ac-ver { font-family: var(--ac-display); font-size: 11px; color: var(--ac-yel); margin: 0 0 14px; }
    .ac-ver span { color: var(--ac-dim); margin-left: 12px; }
    .ac-notes li p:last-child { margin: 0; font-size: 22px; }
    .ac-notes figure { margin: 0 0 16px; }
    .ac-notes figure img { width: 100%; height: 220px; object-fit: cover; border: 4px solid #0F0F23; }

    /* continue */
    .ac-continue { background: var(--ac-yel); color: var(--ac-navy); padding: clamp(70px, 9vw, 120px) clamp(20px, 4vw, 40px); text-align: center; }
    .ac-count { font-family: var(--ac-display); font-size: clamp(1rem, 4vw, 1.8rem); color: #7c5c1d; margin: 0 0 18px; }
    .ac-continue-copy { font-size: 23px; max-width: 46ch; margin: 0 auto 34px; color: #4d3d10; }
    .ac-form { max-width: 480px; margin: 0 auto; background: var(--ac-navy); padding: clamp(26px, 4vw, 38px); display: grid; gap: 18px; box-shadow: 12px 12px 0 rgba(15,15,35,0.25); }
    .ac-slot { display: flex; justify-content: center; }
    .ac-slot span { display: block; width: 90px; height: 14px; background: #0b0b1a; border: 3px solid var(--ac-mag); }
    .ac-form label { display: grid; gap: 10px; font-family: var(--ac-display); font-size: 10px; color: var(--ac-green); text-align: left; }
    .ac-form input { font-family: var(--ac-body); font-size: 23px; background: #0b0b1a; border: 3px solid var(--ac-panel); color: var(--ac-white); padding: 13px 16px; width: 100%; }
    .ac-form input:focus { outline: none; border-color: var(--ac-yel); }
    .ac-form-note { margin: 0; color: var(--ac-yel); font-size: 22px; }
    .ac-form-note:empty { display: none; }

    /* contact */
    .ac-contact {
      display: grid; grid-template-columns: 1fr 1fr; gap: 30px;
      max-width: 1180px; margin: 0 auto; padding: clamp(70px, 9vw, 120px) clamp(20px, 4vw, 40px);
    }
    .ac-contact .ac-h { margin-bottom: 20px; }
    .ac-contact p { font-size: 23px; color: var(--ac-dim); margin: 0; line-height: 1.7; }
    .ac-contact a { color: var(--ac-yel); }

    .ac-foot { text-align: center; padding: 70px 20px 90px; border-top: 4px solid var(--ac-mag); }
    .ac-over { font-family: var(--ac-display); font-size: clamp(1.3rem, 6vw, 3.4rem); line-height: 1.6; color: var(--ac-mag); text-shadow: 4px 4px 0 #7c1d5c, 0 0 30px rgba(255,107,214,0.4); margin: 0 0 30px; }
    .ac-foot p:last-child { color: var(--ac-dim); font-size: 20px; margin: 0; line-height: 1.7; }

    @media (max-width: 900px) {
      .ac-marquee { grid-template-columns: 1fr; }
      .ac-marquee-art img { min-height: 0; height: 220px; }
      .ac-boards, .ac-contact { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ac-invader, .ac-blink { animation: none; }
      .ac-blink { opacity: 1; }
      .ac-btn { transition: none; }
    }
  </style>
</body>
</html>
