---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: VHS Dreams, fictional synthwave record label, Montréal.
// Standalone art direction. Chrome, neon, tape hiss. Not connected to the WEBAO theme system.
// Structure: the page IS a mixtape. No hero. The tracklist is the main content,
// artists are Side A / Side B, label info is liner notes.
const IMG = {
  hero: "/demos/vhs-dreams/01.jpg",
  chromeHearts: "https://images.pexels.com/photos/6194264/pexels-photo-6194264.jpeg?auto=compress&cs=tinysrgb&w=800",
  palmStatic: "https://images.unsplash.com/photo-1557672172-298e090bd0f1?q=80&w=800&auto=format&fit=crop",
  neonRequiem: "https://images.unsplash.com/photo-1563089145-599997674d42?q=80&w=800&auto=format&fit=crop",
  artist: "/demos/vhs-dreams/02.jpg",
  tour: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?q=80&w=1400&auto=format&fit=crop",
};

const SIDE_A = [
  { n: 1, title: "Chrome Hearts", artist: "Midnight Runner", dur: "3:42", secs: 222, img: IMG.chromeHearts, imgAlt: "Chrome Hearts single artwork" },
  { n: 2, title: "Palm Static", artist: "Glass Jaguar", dur: "4:05", secs: 245, img: IMG.palmStatic, imgAlt: "Palm Static single artwork" },
  { n: 3, title: "Neon Requiem", artist: "Vector Vixen", dur: "3:58", secs: 238, img: IMG.neonRequiem, imgAlt: "Neon Requiem single artwork" },
  { n: 4, title: "Grid Eater", artist: "Turbo Lazer", dur: "2:57", secs: 177, img: null, imgAlt: "" },
  { n: 5, title: "Sunset Overdrive '86", artist: "Midnight Runner", dur: "4:21", secs: 261, img: null, imgAlt: "" },
];
const SIDE_B = [
  { n: 6, title: "Velvet Static", artist: "Glass Jaguar", dur: "3:36", secs: 216, img: null, imgAlt: "" },
  { n: 7, title: "Laser Rain", artist: "Vector Vixen", dur: "4:12", secs: 252, img: null, imgAlt: "" },
  { n: 8, title: "8-Bit Heartbreak", artist: "Turbo Lazer", dur: "3:04", secs: 184, img: null, imgAlt: "" },
  { n: 9, title: "Last Light on the 401", artist: "Midnight Runner", dur: "5:01", secs: 301, img: null, imgAlt: "" },
];
const ROSTER_A = [
  { name: "Midnight Runner", genre: "Outrun", stat: "1.2M monthly" },
  { name: "Glass Jaguar", genre: "Darkwave", stat: "840K monthly" },
];
const ROSTER_B = [
  { name: "Vector Vixen", genre: "Retrowave", stat: "620K monthly" },
  { name: "Turbo Lazer", genre: "Chiptune", stat: "410K monthly" },
];
const MERCH = [
  { name: "Cassette single", price: "$9", includes: "One chrome cassette, dolby or not. Download code. Holographic sticker pack.", cta: "Grab one" },
  { name: "Vinyl LP", price: "$29", includes: "180g neon splatter vinyl. Gatefold sleeve with poster. Download code plus bonus track.", cta: "Grab one", tag: "Most wanted" },
  { name: "Tape Club", price: "$79/yr", includes: "Every release on cassette, first. Members-only merch drops. Presale codes for every tour.", cta: "Join the club" },
];
const TOUR = [
  { date: "OCT 17", city: "Montréal, QC", venue: "Club Soda", state: "Tickets" },
  { date: "OCT 24", city: "Toronto, ON", venue: "The Danforth", state: "Tickets" },
  { date: "NOV 01", city: "New York, NY", venue: "Webster Hall", state: "Tickets" },
  { date: "NOV 08", city: "Chicago, IL", venue: "Metro", state: "Tickets" },
  { date: "NOV 15", city: "Los Angeles, CA", venue: "The Wiltern", state: "Sold out" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VHS Dreams: Midnight Frequencies Vol. 07 · Synthwave Label</title>
  <meta name="description" content="VHS Dreams Vol. 07: Midnight Frequencies. A synthwave mixtape from Montréal's synthiest record label. Press play." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Yellowtail&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="vd">

  <!-- DECK BAR -->
  <header class="vd-deck">
    <a class="vd-logo" href="#top" aria-label="VHS Dreams, back to the tape">VHS<span>dreams</span></a>
    <nav class="vd-decknav" aria-label="Primary">
      <a href="#tracklist">Tracklist</a>
      <a href="#sides">Artists</a>
      <a href="#liner">Liner notes</a>
      <a href="#tour">Tour</a>
    </nav>
    <p class="vd-nowplaying" aria-live="polite"><span class="vd-np-dot" aria-hidden="true"></span><span id="vd-np-text">Deck idle · pick a track</span></p>
  </header>

  <main id="top">
    <!-- THE TAPE -->
    <section class="vd-tapehead" aria-label="VHS Dreams volume 7, Midnight Frequencies">
      <div class="vd-wrap">
        <p class="vd-kicker">VHS Dreams presents · chrome cassette · 60 min</p>
        <h1 class="vd-h1">Midnight <span class="vd-script">Frequencies</span> <span class="vd-vol">Vol. 07</span></h1>
        <div class="vd-jcard">
          <figure class="vd-cover">
            <img src={IMG.hero} alt="Cover art for Midnight Frequencies: a neon-soaked night drive" loading="eager" fetchpriority="high" />
            <figcaption>J-card cover · art: the 401 at 2 a.m.</figcaption>
          </figure>
          <div class="vd-cassette" id="vd-cassette" aria-hidden="true">
            <div class="vd-shell">
              <div class="vd-label"><span>A</span><i></i><i></i><i></i></div>
              <div class="vd-window">
                <div class="vd-reel vd-reel-l"></div>
                <div class="vd-tape-line"></div>
                <div class="vd-reel vd-reel-r"></div>
              </div>
              <div class="vd-screws"><b></b><b></b><b></b><b></b></div>
            </div>
            <p class="vd-cassette-cap" id="vd-tape-status">Side A · rewound and ready</p>
          </div>
        </div>
        <p class="vd-tape-note">Nine tracks, two sides, zero skips. Recorded to tape at Studio 1984, mixed under neon. Press play on any track; the deck does the rest.</p>
      </div>
    </section>

    <!-- TRACKLIST -->
    <section class="vd-tracklist" id="tracklist" aria-label="Tracklist">
      <div class="vd-wrap">
        <div class="vd-sidehead"><h2 class="vd-h2">Side A</h2><p>19:03 · five tracks</p></div>
        <ol class="vd-tracks" start="1">
          {SIDE_A.map((t) => (
            <li class="vd-track" data-title={t.title} data-artist={t.artist} data-secs={t.secs} data-side="A">
              <button class="vd-play" aria-label={"Play " + t.title + " by " + t.artist}><span aria-hidden="true">▶</span></button>
              <span class="vd-tnum" aria-hidden="true">{String(t.n).padStart(2, "0")}</span>
              {t.img
                ? <img class="vd-tart" src={t.img} alt={t.imgAlt} loading="lazy" />
                : <span class="vd-tart vd-tart-blank" aria-hidden="true">{t.title.charAt(0)}</span>}
              <div class="vd-tmeta">
                <h3>{t.title}</h3>
                <p>{t.artist}</p>
              </div>
              <span class="vd-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span class="vd-dur">{t.dur}</span>
              <span class="vd-progress" aria-hidden="true"><i></i></span>
            </li>
          ))}
        </ol>

        <div class="vd-flip" aria-hidden="true"><span>✦ flip the tape ✦</span></div>

        <div class="vd-sidehead"><h2 class="vd-h2">Side B</h2><p>15:53 · four tracks</p></div>
        <ol class="vd-tracks" start="6">
          {SIDE_B.map((t) => (
            <li class="vd-track" data-title={t.title} data-artist={t.artist} data-secs={t.secs} data-side="B">
              <button class="vd-play" aria-label={"Play " + t.title + " by " + t.artist}><span aria-hidden="true">▶</span></button>
              <span class="vd-tnum" aria-hidden="true">{String(t.n).padStart(2, "0")}</span>
              <span class="vd-tart vd-tart-blank" aria-hidden="true">{t.title.charAt(0)}</span>
              <div class="vd-tmeta">
                <h3>{t.title}</h3>
                <p>{t.artist}</p>
              </div>
              <span class="vd-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span class="vd-dur">{t.dur}</span>
              <span class="vd-progress" aria-hidden="true"><i></i></span>
            </li>
          ))}
        </ol>
        <p class="vd-tape-total">34:56 of 60:00 · plenty of room left for your own mixtape on the flip side.</p>
      </div>
    </section>

    <!-- ARTISTS AS SIDES -->
    <section class="vd-sides" id="sides">
      <div class="vd-wrap">
        <h2 class="vd-h2 vd-h2-center">The two <span class="vd-script">sides</span></h2>
        <p class="vd-sec-sub">Four acts, one frequency. Every VHS Dreams artist records to tape first and asks questions later.</p>
        <div class="vd-side-cols">
          <div class="vd-side-col">
            <h3>Side A</h3>
            <ul>
              {ROSTER_A.map((a) => (
                <li><strong>{a.name}</strong><span>{a.genre} · {a.stat}</span></li>
              ))}
            </ul>
          </div>
          <figure class="vd-crew">
            <img src={IMG.artist} alt="A VHS Dreams artist in the studio, lit by neon" loading="lazy" />
            <figcaption>The crew at Studio 1984</figcaption>
          </figure>
          <div class="vd-side-col">
            <h3>Side B</h3>
            <ul>
              {ROSTER_B.map((a) => (
                <li><strong>{a.name}</strong><span>{a.genre} · {a.stat}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- LINER NOTES -->
    <section class="vd-liner" id="liner">
      <div class="vd-wrap">
        <h2 class="vd-h2 vd-h2-center">Liner <span class="vd-script">notes</span></h2>
        <div class="vd-insert">
          <div>
            <h3>The label</h3>
            <p>VHS Dreams is an independent synthwave label pressing chrome-plated dreams onto cassette since 1984. Analog synths, neon nights, zero skips. Based in Montréal, beamed everywhere.</p>
            <h3>Pressing info</h3>
            <p>Chrome cassette, Dolby, 60 minutes. Neon splatter vinyl limited to 500. Mastered for tape hiss and highway lights.</p>
          </div>
          <div>
            <h3>Thank yous</h3>
            <p>The night bus drivers, the arcade on Sainte-Catherine, everyone who ever rewound with a pencil. You know who you are.</p>
            <h3>Reach the label</h3>
            <p>Demos, bookings, licensing: we listen to every tape, promise.<br />
              <a href="mailto:booking@vhsdreams.example">booking@vhsdreams.example</a><br />
              (514) 555-0199 · 1984, boul. Saint-Laurent, Montréal QC</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MERCH -->
    <section class="vd-merch" id="merch">
      <div class="vd-wrap">
        <h2 class="vd-h2">Feed the <span class="vd-script">deck</span></h2>
        <ul class="vd-merchlist">
          {MERCH.map((m) => (
            <li class="vd-merchrow">
              <div>
                <h3>{m.name} {m.tag && <span class="vd-tag">{m.tag}</span>}</h3>
                <p>{m.includes}</p>
              </div>
              <p class="vd-mprice">{m.price}</p>
              <button class="vd-btn" type="button" data-merch={m.name}>{m.cta}</button>
            </li>
          ))}
        </ul>
        <p class="vd-merch-note" id="vd-merch-note" role="status" aria-live="polite"></p>
      </div>
    </section>

    <!-- TOUR -->
    <section class="vd-tour" id="tour">
      <div class="vd-tour-bg" aria-hidden="true"><img src={IMG.tour} alt="" loading="lazy" /></div>
      <div class="vd-wrap vd-tour-in">
        <h2 class="vd-h2">Neon nights <span class="vd-script">on the road</span></h2>
        <ul class="vd-tourlist">
          {TOUR.map((s) => (
            <li class="vd-show">
              <span class="vd-show-date">{s.date}</span>
              <span class="vd-show-where">{s.city} · {s.venue}</span>
              {s.state === "Sold out"
                ? <span class="vd-soldout">{s.state}</span>
                : <a class="vd-tix" href="#club">{s.state}</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAN CLUB -->
    <section class="vd-club" id="club">
      <div class="vd-wrap-narrow">
        <h2 class="vd-h2 vd-h2-center">Join the <span class="vd-script">fan club</span></h2>
        <p class="vd-sec-sub vd-center">One transmission per month. New drops, presale codes, and tour rumors, beamed straight to your inbox. Zero spam, all signal.</p>
        <form class="vd-form" id="vd-form" novalidate>
          <label class="vd-sr">Email address<input type="email" name="email" required placeholder="you@midnight.fm" /></label>
          <button class="vd-btn vd-btn-big" type="submit">Tune me in</button>
          <p class="vd-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="vd-footer">
    <p class="vd-footer-logo" aria-hidden="true">VHS</p>
    <div class="vd-wrap vd-footer-in">
      <p>© 2026 VHS Dreams. Fictional demo label. No tapes were harmed.</p>
      <p>1984, boul. Saint-Laurent, Montréal QC · <a href="tel:+15145550199">(514) 555-0199</a> · <a href="mailto:booking@vhsdreams.example">booking@vhsdreams.example</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo deck: fake playback. Timers and reels only, no audio, nothing leaves the page.
    (function () {
      var tracks = Array.prototype.slice.call(document.querySelectorAll('.vd-track')) as HTMLElement[];
      var npText = document.getElementById('vd-np-text');
      var cassette = document.getElementById('vd-cassette');
      var tapeStatus = document.getElementById('vd-tape-status');
      var current: HTMLElement | null = null;
      var timer: number | null = null;
      var elapsed = 0;

      function fmt(s: number) {
        var m = Math.floor(s / 60), sec = s % 60;
        return m + ':' + (sec < 10 ? '0' : '') + sec;
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
        if (current) {
          current.classList.remove('is-playing');
          var bar = current.querySelector('.vd-progress i') as HTMLElement | null;
          if (bar) bar.style.width = '0%';
          var btn = current.querySelector('.vd-play') as HTMLElement | null;
          if (btn) { btn.setAttribute('aria-label', (btn.getAttribute('aria-label') || '').replace('Pause ', 'Play ')); var sp0 = btn.querySelector('span'); if (sp0) sp0.textContent = '▶'; }
          current = null;
        }
        if (cassette) cassette.classList.remove('is-playing');
        if (npText) npText.textContent = 'Deck idle · pick a track';
        if (tapeStatus) tapeStatus.textContent = 'Side A · rewound and ready';
      }
      function play(track: HTMLElement) {
        stop();
        current = track;
        elapsed = 0;
        var total = parseInt(track.dataset.secs || '0', 10);
        var title = track.dataset.title || '', artist = track.dataset.artist || '', side = track.dataset.side || '';
        track.classList.add('is-playing');
        var btn = track.querySelector('.vd-play');
        if (btn) { btn.setAttribute('aria-label', 'Pause ' + title + ' by ' + artist); var sp1 = btn.querySelector('span'); if (sp1) sp1.textContent = '❚❚'; }
        if (cassette) cassette.classList.add('is-playing');
        if (tapeStatus) tapeStatus.textContent = 'Side ' + side + ' · rolling';
        timer = window.setInterval(function () {
          elapsed++;
          if (elapsed >= total) {
            var i = tracks.indexOf(track);
            stop();
            if (i > -1 && i + 1 < tracks.length) play(tracks[i + 1]);
            return;
          }
          if (npText) npText.textContent = '▶ ' + title + ' · ' + artist + ' · ' + fmt(elapsed) + ' / ' + fmt(total);
          var bar = track.querySelector('.vd-progress i') as HTMLElement | null;
          if (bar) bar.style.width = (elapsed / total * 100) + '%';
        }, 1000);
        if (npText) npText.textContent = '▶ ' + title + ' · ' + artist + ' · 0:00 / ' + fmt(total);
      }
      tracks.forEach(function (track: HTMLElement) {
        var pbtn = track.querySelector('.vd-play');
        if (pbtn) pbtn.addEventListener('click', function () {
          if (current === track) stop(); else play(track);
        });
        track.addEventListener('keydown', function (e: KeyboardEvent) {
          if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'BUTTON') {
            if (current === track) stop(); else play(track);
          }
        });
      });

      // Merch buttons: demo only
      var note = document.getElementById('vd-merch-note');
      Array.prototype.forEach.call(document.querySelectorAll('[data-merch]'), function (b: HTMLElement) {
        b.addEventListener('click', function () {
          if (note) note.textContent = b.dataset.merch + ' added to your crate. The deck approves.';
        });
      });

      // Demo form: never submits anywhere
      var form = document.getElementById('vd-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var fNote = form?.querySelector('.vd-form-note');
        if (fNote) fNote.textContent = 'You are tuned in. First transmission lands with the new moon.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .vd {
      --vd-bg: #0D0221;
      --vd-bg2: #160538;
      --vd-panel: #1B0740;
      --vd-pink: #FF2079;
      --vd-cyan: #00F0FF;
      --vd-orange: #FF9E00;
      --vd-yellow: #FFD319;
      --vd-purple: #B537F2;
      --vd-white: #FFF6EC;
      --vd-muted: #B9A8D9;
      --vd-display: "Orbitron", "Arial Black", sans-serif;
      --vd-script: "Yellowtail", cursive;
      --vd-body: "Space Grotesk", system-ui, sans-serif;
      margin: 0;
      background: var(--vd-bg);
      color: var(--vd-white);
      font-family: var(--vd-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .vd *, .vd *::before, .vd *::after { box-sizing: border-box; }
    .vd img { display: block; max-width: 100%; }
    .vd-wrap { max-width: 980px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .vd-wrap-narrow { max-width: 640px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .vd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .vd-script { font-family: var(--vd-script); font-weight: 400; color: var(--vd-pink); }

    /* deck bar */
    .vd-deck {
      position: sticky; top: 0; z-index: 60;
      display: flex; align-items: center; gap: 20px;
      padding: 12px clamp(20px, 4vw, 40px);
      background: rgba(13, 2, 33, 0.92); backdrop-filter: blur(12px);
      border-bottom: 2px solid var(--vd-pink);
    }
    .vd-logo { font-family: var(--vd-display); font-weight: 900; font-size: 20px; color: var(--vd-white); text-decoration: none; letter-spacing: 0.04em; }
    .vd-logo span { font-family: var(--vd-script); font-weight: 400; color: var(--vd-cyan); font-size: 22px; margin-left: 4px; }
    .vd-decknav { display: flex; gap: 4px; margin-left: auto; }
    .vd-decknav a { color: var(--vd-muted); text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; padding: 8px 12px; }
    .vd-decknav a:hover { color: var(--vd-cyan); }
    .vd-nowplaying {
      display: flex; align-items: center; gap: 10px; margin: 0; min-width: 0;
      font-family: var(--vd-display); font-size: 12px; letter-spacing: 0.06em; color: var(--vd-cyan);
      background: #05010F; border: 1px solid var(--vd-purple); padding: 9px 14px; border-radius: 4px;
      max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .vd-np-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--vd-pink); flex-shrink: 0; animation: vd-blink 1.2s steps(2) infinite; }
    @keyframes vd-blink { 50% { opacity: 0.25; } }

    /* tape head */
    .vd-tapehead { padding: clamp(60px, 8vw, 110px) 0 20px; text-align: center; position: relative; }
    .vd-tapehead::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 70% 45% at 50% 0%, rgba(181, 55, 242, 0.28), transparent 65%),
        radial-gradient(ellipse 60% 40% at 85% 90%, rgba(255, 32, 121, 0.16), transparent 60%);
    }
    .vd-kicker { font-size: 12.5px; font-weight: 700; letter-spacing: 0.34em; text-transform: uppercase; color: var(--vd-cyan); margin: 0 0 20px; position: relative; }
    .vd-h1 { font-family: var(--vd-display); font-weight: 900; font-size: clamp(2.6rem, 8.5vw, 5.6rem); line-height: 1; margin: 0 0 8px; text-transform: uppercase; position: relative; text-shadow: 0 0 34px rgba(255, 32, 121, 0.45); }
    .vd-h1 .vd-script { font-size: 1.18em; text-transform: none; text-shadow: 0 0 26px rgba(255, 32, 121, 0.6); }
    .vd-vol { display: block; font-size: 0.32em; letter-spacing: 0.5em; color: var(--vd-yellow); margin-top: 14px; text-shadow: none; }

    .vd-jcard { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 60px); align-items: center; margin: clamp(36px, 5vw, 60px) 0 30px; text-align: left; position: relative; }
    .vd-cover { margin: 0; transform: rotate(-2deg); }
    .vd-cover img { width: 100%; aspect-ratio: 1; object-fit: cover; border: 6px solid var(--vd-white); box-shadow: 0 24px 70px rgba(255, 32, 121, 0.3); }
    .vd-cover figcaption { font-size: 13px; color: var(--vd-muted); margin-top: 12px; letter-spacing: 0.04em; }

    /* css cassette */
    .vd-cassette { transform: rotate(1.5deg); }
    .vd-shell {
      position: relative; background: linear-gradient(160deg, #241055, #12042e);
      border: 2px solid var(--vd-purple); border-radius: 14px; padding: 26px 26px 40px;
      box-shadow: 0 24px 70px rgba(0, 240, 255, 0.14);
    }
    .vd-label { display: flex; gap: 8px; align-items: center; background: linear-gradient(90deg, var(--vd-pink), var(--vd-orange), var(--vd-yellow)); border-radius: 6px; padding: 10px 14px; margin-bottom: 22px; }
    .vd-label span { font-family: var(--vd-display); font-weight: 900; font-size: 26px; color: #0D0221; }
    .vd-label i { flex: 1; height: 6px; background: rgba(13, 2, 33, 0.55); border-radius: 3px; }
    .vd-window { display: flex; align-items: center; justify-content: space-between; background: #05010F; border: 2px solid var(--vd-purple); border-radius: 40px; padding: 16px 34px; }
    .vd-reel {
      width: 64px; height: 64px; border-radius: 50%;
      background:
        radial-gradient(circle, #0D0221 16%, transparent 17%),
        conic-gradient(var(--vd-cyan) 0 12%, transparent 12% 25%, var(--vd-cyan) 25% 37%, transparent 37% 50%, var(--vd-cyan) 50% 62%, transparent 62% 75%, var(--vd-cyan) 75% 87%, transparent 87%);
      border: 3px solid var(--vd-muted);
      animation: vd-spin 3.5s linear infinite; animation-play-state: paused;
    }
    .vd-reel-r { animation-direction: reverse; animation-duration: 5s; }
    .vd-cassette.is-playing .vd-reel { animation-play-state: running; }
    @keyframes vd-spin { to { transform: rotate(360deg); } }
    .vd-tape-line { flex: 1; height: 4px; background: #2A1658; margin: 0 10px; border-radius: 2px; }
    .vd-screws b { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--vd-muted); }
    .vd-screws b:nth-child(1) { top: 8px; left: 10px; } .vd-screws b:nth-child(2) { top: 8px; right: 10px; }
    .vd-screws b:nth-child(3) { bottom: 8px; left: 10px; } .vd-screws b:nth-child(4) { bottom: 8px; right: 10px; }
    .vd-cassette-cap { font-family: var(--vd-display); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--vd-cyan); text-align: center; margin: 16px 0 0; }
    .vd-tape-note { max-width: 60ch; margin: 0 auto; color: var(--vd-muted); font-size: 16px; line-height: 1.7; position: relative; }

    /* tracklist */
    .vd-tracklist { padding: clamp(50px, 7vw, 90px) 0; }
    .vd-sidehead { display: flex; align-items: baseline; gap: 18px; border-bottom: 2px solid var(--vd-purple); padding-bottom: 12px; margin-bottom: 6px; }
    .vd-sidehead p { margin: 0 0 0 auto; color: var(--vd-muted); font-size: 14px; letter-spacing: 0.1em; }
    .vd-h2 { font-family: var(--vd-display); font-weight: 900; font-size: clamp(1.7rem, 4.5vw, 2.6rem); text-transform: uppercase; margin: 0; letter-spacing: 0.03em; }
    .vd-h2 .vd-script { text-transform: none; font-size: 1.15em; }
    .vd-h2-center { text-align: center; }
    .vd-tracks { list-style: none; margin: 0; padding: 0; }
    .vd-track {
      position: relative; display: grid; grid-template-columns: auto auto 56px 1fr auto auto; gap: 16px; align-items: center;
      padding: 16px 10px; border-bottom: 1px solid rgba(185, 168, 217, 0.18); cursor: default;
    }
    .vd-track:hover { background: rgba(181, 55, 242, 0.08); }
    .vd-track.is-playing { background: rgba(255, 32, 121, 0.1); }
    .vd-play {
      width: 46px; height: 46px; border-radius: 50%; border: 2px solid var(--vd-cyan); background: transparent;
      color: var(--vd-cyan); font-size: 15px; cursor: pointer; display: grid; place-items: center; transition: transform 0.15s ease;
    }
    .vd-play:hover { transform: scale(1.1); background: rgba(0, 240, 255, 0.12); }
    .vd-track.is-playing .vd-play { border-color: var(--vd-pink); color: var(--vd-pink); }
    .vd-tnum { font-family: var(--vd-display); font-size: 14px; color: var(--vd-muted); }
    .vd-tart { width: 56px; height: 56px; object-fit: cover; border: 1px solid var(--vd-purple); }
    .vd-tart-blank { display: grid; place-items: center; font-family: var(--vd-display); font-weight: 900; font-size: 22px; color: var(--vd-bg); background: linear-gradient(135deg, var(--vd-purple), var(--vd-pink)); }
    .vd-tmeta h3 { margin: 0 0 3px; font-size: 17px; font-weight: 700; }
    .vd-tmeta p { margin: 0; color: var(--vd-muted); font-size: 14px; }
    .vd-eq { display: none; align-items: flex-end; gap: 3px; height: 26px; }
    .vd-eq i { width: 5px; background: var(--vd-cyan); animation: vd-eq 0.9s ease-in-out infinite; animation-play-state: paused; height: 30%; }
    .vd-eq i:nth-child(2) { animation-delay: 0.15s; } .vd-eq i:nth-child(3) { animation-delay: 0.3s; } .vd-eq i:nth-child(4) { animation-delay: 0.45s; }
    @keyframes vd-eq { 50% { height: 100%; } }
    .vd-track.is-playing .vd-eq { display: flex; }
    .vd-track.is-playing .vd-eq i { animation-play-state: running; }
    .vd-dur { font-family: var(--vd-display); font-size: 14px; color: var(--vd-muted); font-variant-numeric: tabular-nums; }
    .vd-track.is-playing .vd-dur { color: var(--vd-yellow); }
    .vd-progress { position: absolute; left: 0; bottom: -1px; width: 100%; height: 3px; background: transparent; }
    .vd-progress i { display: block; height: 100%; width: 0%; background: linear-gradient(90deg, var(--vd-pink), var(--vd-yellow)); }
    .vd-flip { text-align: center; padding: 30px 0; color: var(--vd-yellow); font-family: var(--vd-display); font-size: 14px; letter-spacing: 0.4em; text-transform: uppercase; }
    .vd-tape-total { text-align: center; color: var(--vd-muted); font-size: 14.5px; margin: 26px 0 0; letter-spacing: 0.04em; }

    /* sides / artists */
    .vd-sides { padding: clamp(50px, 7vw, 90px) 0; background: var(--vd-bg2); border-block: 1px solid rgba(185, 168, 217, 0.16); }
    .vd-sec-sub { text-align: center; color: var(--vd-muted); font-size: 16.5px; max-width: 56ch; margin: 14px auto 44px; line-height: 1.7; }
    .vd-center { text-align: center; }
    .vd-side-cols { display: grid; grid-template-columns: 1fr 300px 1fr; gap: clamp(24px, 4vw, 50px); align-items: center; }
    .vd-side-col h3 { font-family: var(--vd-display); font-size: 15px; letter-spacing: 0.4em; color: var(--vd-cyan); margin: 0 0 18px; text-transform: uppercase; }
    .vd-side-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
    .vd-side-col li { border-left: 3px solid var(--vd-pink); padding-left: 18px; display: grid; gap: 4px; }
    .vd-side-col li strong { font-size: 20px; font-weight: 700; }
    .vd-side-col li span { color: var(--vd-muted); font-size: 14px; letter-spacing: 0.06em; }
    .vd-crew { margin: 0; transform: rotate(2deg); }
    .vd-crew img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border: 5px solid var(--vd-white); box-shadow: 0 20px 60px rgba(0, 240, 255, 0.18); }
    .vd-crew figcaption { font-size: 13px; color: var(--vd-muted); margin-top: 10px; text-align: center; }

    /* liner notes */
    .vd-liner { padding: clamp(50px, 7vw, 90px) 0; }
    .vd-insert {
      margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 60px);
      background: var(--vd-white); color: #2A1658; padding: clamp(28px, 5vw, 54px);
      transform: rotate(-0.6deg); box-shadow: 0 24px 70px rgba(255, 32, 121, 0.22);
    }
    .vd-insert h3 { font-family: var(--vd-display); font-size: 14px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--vd-pink); margin: 0 0 10px; }
    .vd-insert h3:not(:first-child) { margin-top: 28px; }
    .vd-insert p { margin: 0; font-size: 15px; line-height: 1.75; }
    .vd-insert a { color: #B537F2; }

    /* merch */
    .vd-merch { padding: clamp(50px, 7vw, 90px) 0; background: var(--vd-bg2); border-block: 1px solid rgba(185, 168, 217, 0.16); }
    .vd-merch .vd-h2 { margin-bottom: 30px; }
    .vd-merchlist { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(185, 168, 217, 0.2); }
    .vd-merchrow { display: grid; grid-template-columns: 1fr auto auto; gap: 24px; align-items: center; padding: 24px 0; border-bottom: 1px solid rgba(185, 168, 217, 0.2); }
    .vd-merchrow h3 { margin: 0 0 6px; font-size: 19px; }
    .vd-merchrow p { margin: 0; color: var(--vd-muted); font-size: 14.5px; line-height: 1.6; }
    .vd-tag { font-family: var(--vd-display); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; background: var(--vd-yellow); color: #0D0221; padding: 5px 10px; border-radius: 3px; vertical-align: 3px; margin-left: 10px; }
    .vd-mprice { font-family: var(--vd-display); font-weight: 700; font-size: 24px; color: var(--vd-cyan); margin: 0; white-space: nowrap; }
    .vd-btn {
      font-family: var(--vd-display); font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      background: var(--vd-pink); color: #fff; border: none; padding: 15px 26px; cursor: pointer; border-radius: 4px; white-space: nowrap;
    }
    .vd-btn:hover { filter: brightness(1.15); box-shadow: 0 8px 26px rgba(255, 32, 121, 0.4); }
    .vd-merch-note { margin: 20px 0 0; color: var(--vd-yellow); font-size: 15.5px; min-height: 1.5em; }
    .vd-merch-note:empty { display: none; }

    /* tour */
    .vd-tour { position: relative; padding: clamp(60px, 8vw, 110px) 0; overflow: hidden; }
    .vd-tour-bg { position: absolute; inset: 0; }
    .vd-tour-bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.22; }
    .vd-tour-bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, var(--vd-bg) 0%, transparent 30%, transparent 70%, var(--vd-bg) 100%); }
    .vd-tour-in { position: relative; }
    .vd-tour-in .vd-h2 { margin-bottom: 30px; }
    .vd-tourlist { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(185, 168, 217, 0.25); }
    .vd-show { display: grid; grid-template-columns: 110px 1fr auto; gap: 20px; align-items: center; padding: 20px 0; border-bottom: 1px solid rgba(185, 168, 217, 0.25); }
    .vd-show-date { font-family: var(--vd-display); font-weight: 700; color: var(--vd-yellow); letter-spacing: 0.1em; }
    .vd-show-where { font-size: 17px; }
    .vd-tix { font-family: var(--vd-display); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--vd-bg); background: var(--vd-cyan); text-decoration: none; padding: 11px 22px; border-radius: 4px; }
    .vd-tix:hover { filter: brightness(1.12); }
    .vd-soldout { font-family: var(--vd-display); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--vd-muted); border: 1px solid var(--vd-muted); padding: 10px 20px; border-radius: 4px; }

    /* fan club */
    .vd-club { padding: clamp(60px, 8vw, 110px) 0; }
    .vd-club .vd-sec-sub { margin-bottom: 34px; }
    .vd-form { display: grid; gap: 18px; }
    .vd-form input {
      font-family: var(--vd-body); font-size: 17px; color: var(--vd-white);
      background: #05010F; border: 1px solid var(--vd-purple); padding: 17px 20px; width: 100%; border-radius: 4px;
    }
    .vd-form input:focus { outline: 2px solid var(--vd-cyan); outline-offset: 2px; }
    .vd-btn-big { width: 100%; padding: 19px; font-size: 15px; }
    .vd-form-note { margin: 0; color: var(--vd-cyan); font-size: 16px; text-align: center; }
    .vd-form-note:empty { display: none; }

    /* footer */
    .vd-footer { padding: 70px 0 90px; text-align: center; border-top: 2px solid var(--vd-pink); }
    .vd-footer-logo { font-family: var(--vd-display); font-weight: 900; font-size: clamp(3rem, 12vw, 7rem); margin: 0 0 20px; background: linear-gradient(180deg, var(--vd-pink), var(--vd-purple), var(--vd-cyan)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .vd-footer-in { display: grid; gap: 10px; color: var(--vd-muted); font-size: 14px; }
    .vd-footer-in p { margin: 0; }
    .vd-footer-in a { color: var(--vd-cyan); }

    @media (max-width: 860px) {
      .vd-decknav { display: none; }
      .vd-nowplaying { margin-left: auto; max-width: 220px; }
      .vd-jcard { grid-template-columns: 1fr; }
      .vd-cover { max-width: 420px; margin: 0 auto; }
      .vd-side-cols { grid-template-columns: 1fr; }
      .vd-crew { max-width: 320px; margin: 0 auto; }
      .vd-insert { grid-template-columns: 1fr; }
      .vd-track { grid-template-columns: auto 44px 1fr auto; }
      .vd-tnum, .vd-tart, .vd-eq { display: none; }
      .vd-merchrow { grid-template-columns: 1fr auto; }
      .vd-merchrow .vd-btn { grid-column: 1 / -1; justify-self: start; }
      .vd-show { grid-template-columns: 1fr auto; }
      .vd-show-date { grid-column: 1 / -1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .vd-reel, .vd-eq i, .vd-np-dot { animation: none; }
      .vd-play { transition: none; }
    }
  </style>
</body>
</html>
