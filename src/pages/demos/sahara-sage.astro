---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Sahara & Sage, fictional bohemian home goods studio, Montréal.
// Standalone art direction. Bohemian: terracotta, sage, sand, arch frames.
// Not connected to the WEBAO theme system.
// REBUILD: shop by room, not by product. Three full room scenes with
// shoppable hotspots woven into the photography. No product cards anywhere.
const IMG = {
  hero: "/demos/sahara-sage/01.jpg",
  throw: "/demos/sahara-sage/02.jpg",
  vase: "/demos/sahara-sage/03.jpg",
  artisan: "/demos/sahara-sage/04.jpg",
  look1: "https://images.unsplash.com/photo-1567016432779-094069958ea5?q=80&w=1000&auto=format&fit=crop",
  look2: "https://i.etsystatic.com/64597397/r/il/7d8bb7/7820596923/il_800x800.7820596923_818k.jpg",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sahara &amp; Sage: Wander the Rooms | Bohemian Home Goods</title>
  <meta name="description" content="Sahara & Sage: bohemian home goods woven, thrown, and knotted by hand. Wander three styled rooms and tap what catches your eye. Textiles, ceramics, macramé." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="ss">

  <!-- NAV -->
  <header class="ss-navwrap">
    <nav class="ss-nav" aria-label="Primary">
      <a class="ss-logo" href="#top" aria-label="Sahara and Sage, home">
        <svg class="ss-sun" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="7" fill="#C67B5C"/><g stroke="#6B4A35" stroke-width="2" stroke-linecap="round"><path d="M16 2v4M16 26v4M2 16h4M26 16h4M6 6l3 3M23 23l3 3M26 6l-3 3M9 23l-3 3"/></g></svg>
        <span>Sahara <em>&amp;</em> Sage</span>
      </a>
      <div class="ss-nav-links">
        <a href="#room-living">Living room</a>
        <a href="#room-bedroom">Bedroom</a>
        <a href="#room-corner">Reading corner</a>
        <a href="#boxes">Boxes</a>
      </div>
      <a class="ss-btn ss-btn-small" href="#contact">Visit the studio</a>
      <button class="ss-burger" id="ss-burger" aria-expanded="false" aria-controls="ss-menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="ss-menu" id="ss-menu" hidden>
      <a href="#room-living">Living room</a>
      <a href="#room-bedroom">Bedroom</a>
      <a href="#room-corner">Reading corner</a>
      <a href="#boxes">Boxes</a>
      <a class="ss-btn" href="#contact">Visit the studio</a>
    </div>
  </header>

  <main id="top">
    <!-- OPENER: text only. No hero image. -->
    <section class="ss-open">
      <div class="ss-wrap ss-open-in">
        <p class="ss-caveat">handmade with love, always</p>
        <h1 class="ss-h1">Wander in.<br /><em>Touch everything.</em></h1>
        <p class="ss-lede">No product grid here. Walk through three of our rooms, tap the little brass dots on what catches your eye, and the pieces introduce themselves. Textiles, ceramics, and macramé, made slowly by 24 artisans.</p>
        <p class="ss-hint"><span class="ss-dot" aria-hidden="true"></span> tap a dot to meet a piece</p>
      </div>
    </section>

    <!-- ROOM 1 -->
    <section class="ss-room" id="room-living">
      <div class="ss-room-head ss-wrap">
        <p class="ss-caveat">room nº 1</p>
        <h2 class="ss-h2">The <em>living room</em></h2>
        <p class="ss-copy">Rattan, layered textiles, and afternoon light. Three pieces live here.</p>
      </div>
      <figure class="ss-scene" data-scene>
        <img src={IMG.hero} alt="Rattan bohemian living room with layered textiles, plants and terracotta cushions" loading="eager" fetchpriority="high" />
        <button class="ss-hot" style="--x: 28%; --y: 62%;" aria-expanded="false" aria-controls="ss-p1"><span aria-hidden="true">1</span><span class="ss-sr">Sahara Throw, $129</span></button>
        <button class="ss-hot" style="--x: 68%; --y: 24%;" aria-expanded="false" aria-controls="ss-p2"><span aria-hidden="true">2</span><span class="ss-sr">Moon Knot Hanging, $96</span></button>
        <button class="ss-hot" style="--x: 56%; --y: 78%;" aria-expanded="false" aria-controls="ss-p3"><span aria-hidden="true">3</span><span class="ss-sr">Dune Vessel Set, $84</span></button>
      </figure>
      <div class="ss-wrap ss-pieces">
        <article class="ss-piece" id="ss-p1" hidden>
          <p class="ss-piece-n">1</p>
          <div><h3>Sahara Throw · $129</h3><p>Hand-loomed cotton and wool, dyed with madder root. Fringed, generous, made for long reads. 4 colours.</p></div>
        </article>
        <article class="ss-piece" id="ss-p2" hidden>
          <p class="ss-piece-n">2</p>
          <div><h3>Moon Knot Hanging · $96</h3><p>A crescent of hand-knotted cotton cord on driftwood. Takes our knotter about six hours. Made to order.</p></div>
        </article>
        <article class="ss-piece" id="ss-p3" hidden>
          <p class="ss-piece-n">3</p>
          <div><h3>Dune Vessel Set · $84</h3><p>Wheel-thrown stoneware in sand and terracotta glazes. Set of 3, no two alike, each signed underneath.</p></div>
        </article>
      </div>
    </section>

    <!-- ROOM 2 -->
    <section class="ss-room ss-room-alt" id="room-bedroom">
      <div class="ss-room-head ss-wrap">
        <p class="ss-caveat">room nº 2</p>
        <h2 class="ss-h2">The <em>bedroom</em></h2>
        <p class="ss-copy">Macramé over the bed, a throw that has seen a hundred slow mornings. Two pieces live here.</p>
      </div>
      <figure class="ss-scene" data-scene>
        <img src={IMG.artisan} alt="Bohemian bedroom with a macrame wall hanging and rattan side table" loading="lazy" />
        <button class="ss-hot" style="--x: 64%; --y: 22%;" aria-expanded="false" aria-controls="ss-p4"><span aria-hidden="true">1</span><span class="ss-sr">Moon Knot Hanging, $96</span></button>
        <button class="ss-hot" style="--x: 38%; --y: 66%;" aria-expanded="false" aria-controls="ss-p5"><span aria-hidden="true">2</span><span class="ss-sr">Sahara Throw, $129</span></button>
      </figure>
      <div class="ss-wrap ss-pieces">
        <article class="ss-piece" id="ss-p4" hidden>
          <p class="ss-piece-n">1</p>
          <div><h3>Moon Knot Hanging · $96</h3><p>Above the bed, where the morning light hits first. Hand-knotted cotton cord on driftwood. Made to order.</p></div>
        </article>
        <article class="ss-piece" id="ss-p5" hidden>
          <p class="ss-piece-n">2</p>
          <div><h3>Sahara Throw · $129</h3><p>Folded at the foot of the bed, always. Hand-loomed, madder-dyed, softer every wash. 4 colours.</p></div>
        </article>
      </div>
    </section>

    <!-- ROOM 3 -->
    <section class="ss-room" id="room-corner">
      <div class="ss-room-head ss-wrap">
        <p class="ss-caveat">room nº 3</p>
        <h2 class="ss-h2">The <em>reading corner</em></h2>
        <p class="ss-copy">One terracotta sofa, one good lamp, zero excuses. Two pieces live here.</p>
      </div>
      <figure class="ss-scene" data-scene>
        <img src={IMG.look1} alt="Terracotta sofa styled with blush cushion and woven market bag" loading="lazy" />
        <button class="ss-hot" style="--x: 34%; --y: 55%;" aria-expanded="false" aria-controls="ss-p6"><span aria-hidden="true">1</span><span class="ss-sr">Sahara Throw, $129</span></button>
        <button class="ss-hot" style="--x: 70%; --y: 72%;" aria-expanded="false" aria-controls="ss-p7"><span aria-hidden="true">2</span><span class="ss-sr">Dune Vessel Set, $84</span></button>
      </figure>
      <div class="ss-wrap ss-pieces">
        <article class="ss-piece" id="ss-p6" hidden>
          <p class="ss-piece-n">1</p>
          <div><h3>Sahara Throw · $129</h3><p>Draped over the arm, ready. The blush colourway was dyed to match this exact sofa. 4 colours.</p></div>
        </article>
        <article class="ss-piece" id="ss-p7" hidden>
          <p class="ss-piece-n">2</p>
          <div><h3>Dune Vessel Set · $84</h3><p>On the side table, holding dried grasses. Wheel-thrown stoneware, set of 3, each signed underneath.</p></div>
        </article>
      </div>
    </section>

    <!-- ARTISAN INTERLUDE -->
    <section class="ss-interlude">
      <div class="ss-wrap ss-inter-in">
        <figure class="ss-arch">
          <img src={IMG.vase} alt="Artisan hands shaping a terracotta vessel on the wheel" loading="lazy" />
        </figure>
        <div>
          <p class="ss-caveat">our people</p>
          <h2 class="ss-h2">Slow made by <em>fast friends</em></h2>
          <p class="ss-copy">We work with 24 independent artisans across Québec and the Maritimes. Every piece is made in small batches, from clay dug and cotton grown as close to home as we can get it. We pay fair, we sign every piece, and we know every maker by name.</p>
          <div class="ss-stats">
            <div><strong>24</strong><span>artisan partners</span></div>
            <div><strong>100%</strong><span>natural materials</span></div>
            <div><strong>0</strong><span>pieces mass-made</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- BOXES: an order ledger, not tiers -->
    <section class="ss-boxes" id="boxes">
      <div class="ss-wrap">
        <p class="ss-caveat ss-center">curated, packed with care</p>
        <h2 class="ss-h2 ss-center">Seasonal <em>boxes</em></h2>
        <p class="ss-copy ss-center ss-max">Four times a year we pack a box of small-batch pieces around a theme. Write to us to reserve yours; past boxes sold out in days.</p>
        <ol class="ss-ledger">
          <li>
            <div><h3>The Wanderer</h3><p>A hand-poured soy candle, mini macramé plant hanger, artisan postcard set, and one surprise textile.</p></div>
            <p class="ss-ledger-price">$89</p>
          </li>
          <li>
            <div><h3>The Nest</h3><p>Everything in The Wanderer, plus a Sahara cushion cover, a hand-thrown mug duo, and a woven wall mini.</p></div>
            <p class="ss-ledger-price">$149</p>
          </li>
          <li>
            <div><h3>The Oasis</h3><p>Everything in The Nest, plus the Moon Knot hanging, a large Dune vessel, and a personal note from a maker.</p></div>
            <p class="ss-ledger-price">$219</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="ss-section" id="contact">
      <div class="ss-wrap ss-contact-in">
        <div>
          <p class="ss-caveat">say hello</p>
          <h2 class="ss-h2">Come by the <em>studio</em></h2>
          <p class="ss-copy">We pour the tea and let you touch everything. Custom orders, wedding registries, or just a chat about clay.</p>
          <address class="ss-addr">
            214, rue des Artisans<br />
            Montréal, QC H2Y 1C6<br />
            <a href="tel:+15145550142">(514) 555-0142</a><br />
            <a href="mailto:hello@saharasage.ca">hello@saharasage.ca</a><br />
            Tue to Sat, 10:00 to 18:00
          </address>
        </div>
        <form class="ss-form" id="ss-form" novalidate>
          <h3>Write to us</h3>
          <label>Name<input type="text" name="name" required placeholder="Amina Diallo" /></label>
          <label>Email<input type="email" name="email" required placeholder="amina@example.com" /></label>
          <label>What are you dreaming of?
            <select name="topic">
              <option>A custom piece</option>
              <option>A seasonal box</option>
              <option>Wholesale inquiry</option>
              <option>Just saying hi</option>
            </select>
          </label>
          <label>Message<textarea name="message" rows="4" placeholder="Tell us about your space..."></textarea></label>
          <button class="ss-btn" type="submit">Send it with love</button>
          <p class="ss-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="ss-footer">
    <p class="ss-footer-mark" aria-hidden="true">S&amp;S</p>
    <div class="ss-wrap ss-footer-in">
      <p>© 2026 Sahara &amp; Sage. Fictional demo studio. All looms imaginary.</p>
      <p>214, rue des Artisans, Montréal QC · <a href="tel:+15145550142">(514) 555-0142</a> · <a href="mailto:hello@saharasage.ca">hello@saharasage.ca</a></p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    (function () {
      // Hotspots: toggle the matching piece annotation.
      document.querySelectorAll('[data-scene]').forEach(function (scene) {
        var hots = scene.querySelectorAll('.ss-hot');
        hots.forEach(function (hot) {
          hot.addEventListener('click', function () {
            var target = document.getElementById(hot.getAttribute('aria-controls') || '');
            var isOpen = hot.getAttribute('aria-expanded') === 'true';
            hots.forEach(function (h) { h.setAttribute('aria-expanded', 'false'); h.classList.remove('ss-hot-on'); });
            scene.parentElement?.querySelectorAll('.ss-piece').forEach(function (p) { p.setAttribute('hidden', ''); });
            if (!isOpen && target) {
              hot.setAttribute('aria-expanded', 'true');
              hot.classList.add('ss-hot-on');
              target.removeAttribute('hidden');
              target.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          });
        });
      });
      // Mobile menu
      var burgerEl = document.getElementById('ss-burger');
      var menuEl = document.getElementById('ss-menu');
      if (burgerEl && menuEl) {
        var burger = burgerEl;
        var menu = menuEl;
        burger.addEventListener('click', function () {
          var open = menu.hasAttribute('hidden');
          if (open) { menu.removeAttribute('hidden'); } else { menu.setAttribute('hidden', ''); }
          burger.setAttribute('aria-expanded', String(open));
          burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        });
        var m = menu;
        m.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            m.setAttribute('hidden', '');
            burger.setAttribute('aria-expanded', 'false');
            burger.setAttribute('aria-label', 'Open menu');
          });
        });
      }
      // Demo form: never submits anywhere
      var formEl = document.getElementById('ss-form');
      if (formEl instanceof HTMLFormElement) {
        var form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.ss-form-note');
          if (note) note.textContent = 'Thank you, kind soul. Your note is on its way and we will reply within two days.';
          form.reset();
        });
      }
    })();
  </script>

  <style>
    .ss {
      --ss-sand: #E8DCC8;
      --ss-sand-deep: #DCCBAA;
      --ss-terra: #C67B5C;
      --ss-terra-deep: #A85F42;
      --ss-sage: #9CAF88;
      --ss-sage-deep: #7A8F68;
      --ss-bark: #6B4A35;
      --ss-bark-deep: #4A3428;
      --ss-cream: #FBF6EC;
      --ss-serif: "Fraunces", Georgia, serif;
      --ss-hand: "Caveat", cursive;
      margin: 0;
      background: var(--ss-cream);
      color: var(--ss-bark-deep);
      font-family: var(--ss-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ss *, .ss *::before, .ss *::after { box-sizing: border-box; }
    .ss img { display: block; max-width: 100%; }
    .ss-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .ss-center { text-align: center; }
    .ss-max { max-width: 56ch; margin-left: auto; margin-right: auto; }
    .ss-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    .ss-caveat {
      font-family: var(--ss-hand); font-size: clamp(1.5rem, 3vw, 2rem);
      color: var(--ss-terra-deep); margin: 0 0 10px; font-weight: 600;
    }
    .ss-h1 {
      font-size: clamp(3rem, 8vw, 5.6rem); line-height: 1.02;
      font-weight: 600; margin: 0 0 22px; letter-spacing: -0.01em;
    }
    .ss-h1 em, .ss-h2 em { font-style: italic; color: var(--ss-terra-deep); }
    .ss-h2 { font-size: clamp(2.1rem, 5vw, 3.4rem); font-weight: 600; margin: 0 0 14px; line-height: 1.08; }
    .ss-lede { font-size: 1.13rem; line-height: 1.75; color: var(--ss-bark); max-width: 52ch; margin: 0 0 26px; }
    .ss-copy { font-size: 1.05rem; line-height: 1.75; color: var(--ss-bark); margin: 0 0 20px; max-width: 52ch; }

    /* buttons */
    .ss-btn {
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--ss-terra); color: #fff; font-family: var(--ss-serif);
      font-weight: 600; font-size: 1.02rem; padding: 15px 34px;
      border-radius: 999px; border: 2px solid var(--ss-terra);
      text-decoration: none; cursor: pointer;
      transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
      box-shadow: 0 6px 18px rgba(198, 123, 92, 0.35);
    }
    .ss-btn:hover { background: var(--ss-terra-deep); border-color: var(--ss-terra-deep); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(198, 123, 92, 0.4); }
    .ss-btn-small { padding: 11px 24px; font-size: 0.95rem; }

    /* nav */
    .ss-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .ss-nav {
      display: flex; align-items: center; gap: 22px;
      padding: 14px clamp(20px, 4vw, 40px);
      background: rgba(251, 246, 236, 0.9); backdrop-filter: blur(12px);
      border-bottom: 2px solid var(--ss-sand-deep);
    }
    .ss-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ss-bark-deep); font-size: 1.35rem; font-weight: 700; margin-right: auto; }
    .ss-logo em { font-style: italic; color: var(--ss-terra-deep); }
    .ss-sun { width: 34px; height: 34px; animation: ss-spin 24s linear infinite; }
    @keyframes ss-spin { to { transform: rotate(360deg); } }
    .ss-nav-links { display: flex; gap: 4px; }
    .ss-nav-links a { color: var(--ss-bark); text-decoration: none; font-weight: 600; font-size: 1rem; padding: 10px 14px; border-radius: 999px; }
    .ss-nav-links a:hover { background: var(--ss-sand); color: var(--ss-bark-deep); }
    .ss-burger { display: none; background: none; border: none; cursor: pointer; padding: 10px; }
    .ss-burger span { display: block; width: 26px; height: 3px; border-radius: 3px; background: var(--ss-bark-deep); margin: 5px 0; }
    .ss-menu { display: none; }

    /* opener: text only */
    .ss-open { padding: 170px 0 90px; }
    .ss-open-in { max-width: 860px; }
    .ss-hint { display: flex; align-items: center; gap: 12px; font-family: var(--ss-hand); font-size: 1.5rem; color: var(--ss-bark); margin: 0; }
    .ss-dot {
      width: 30px; height: 30px; border-radius: 50%; background: var(--ss-terra); color: #fff;
      display: inline-grid; place-items: center; font-family: var(--ss-serif); font-size: 15px; font-weight: 700;
      box-shadow: 0 0 0 6px rgba(198, 123, 92, 0.25);
      animation: ss-pulse 2.4s ease-in-out infinite;
    }
    .ss-dot::after { content: "1"; }
    @keyframes ss-pulse { 50% { box-shadow: 0 0 0 12px rgba(198, 123, 92, 0.12); } }

    /* rooms */
    .ss-room { padding: 40px 0 90px; }
    .ss-room-alt { background: var(--ss-sand); border-block: 2px solid var(--ss-sand-deep); padding: 90px 0; margin: 40px 0; }
    .ss-room-head { margin-bottom: 34px; }
    .ss-scene { position: relative; margin: 0; max-width: 1440px; margin-inline: auto; }
    .ss-scene img { width: 100%; height: clamp(420px, 62vw, 760px); object-fit: cover; display: block; }
    .ss-hot {
      position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%);
      width: 44px; height: 44px; border-radius: 50%;
      background: rgba(198, 123, 92, 0.92); color: #fff; border: 2px solid #fff;
      font-family: var(--ss-serif); font-weight: 700; font-size: 18px; cursor: pointer;
      display: grid; place-items: center;
      box-shadow: 0 0 0 6px rgba(198, 123, 92, 0.25), 0 6px 16px rgba(0,0,0,0.3);
      transition: transform 0.18s ease, background 0.18s ease;
      animation: ss-pulse 2.4s ease-in-out infinite;
    }
    .ss-hot:hover { transform: translate(-50%, -50%) scale(1.15); background: var(--ss-terra-deep); }
    .ss-hot-on { background: var(--ss-bark-deep); animation: none; }
    .ss-pieces { display: grid; gap: 14px; margin-top: 26px; }
    .ss-piece {
      display: flex; gap: 20px; align-items: baseline;
      background: #fff; border: 2px solid var(--ss-sand-deep); border-radius: 20px;
      padding: 22px 26px; box-shadow: 0 10px 26px rgba(107, 74, 53, 0.12);
    }
    .ss-piece[hidden] { display: none; }
    .ss-piece-n {
      flex: none; width: 40px; height: 40px; border-radius: 50%;
      background: var(--ss-terra); color: #fff; display: grid; place-items: center;
      font-weight: 700; font-size: 18px; margin: 0;
    }
    .ss-piece h3 { margin: 0 0 6px; font-size: 1.35rem; font-weight: 600; }
    .ss-piece p { margin: 0; color: var(--ss-bark); line-height: 1.65; font-size: 1rem; }

    /* interlude */
    .ss-interlude { padding: clamp(70px, 9vw, 120px) 0; }
    .ss-inter-in { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(30px, 5vw, 70px); align-items: center; }
    .ss-arch {
      border-radius: 999px 999px 24px 24px; overflow: hidden; margin: 0;
      border: 6px solid var(--ss-sand-deep);
      outline: 2px solid var(--ss-terra); outline-offset: 9px;
      box-shadow: 0 24px 60px rgba(107, 74, 53, 0.25);
      aspect-ratio: 4 / 5;
    }
    .ss-arch img { width: 100%; height: 100%; object-fit: cover; }
    .ss-stats { display: flex; gap: clamp(20px, 4vw, 50px); margin-top: 26px; flex-wrap: wrap; }
    .ss-stats div { display: grid; gap: 4px; }
    .ss-stats strong { font-size: 2.4rem; color: var(--ss-terra-deep); font-weight: 700; }
    .ss-stats span { font-size: 0.92rem; color: var(--ss-bark); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }

    /* boxes ledger */
    .ss-boxes { background: var(--ss-bark-deep); color: var(--ss-cream); padding: clamp(70px, 9vw, 120px) 0; }
    .ss-boxes .ss-h2 { color: var(--ss-cream); }
    .ss-boxes .ss-h2 em { color: var(--ss-sand); }
    .ss-boxes .ss-copy { color: var(--ss-sand); }
    .ss-ledger { list-style: none; margin: 44px 0 0; padding: 0; display: grid; gap: 0; border-top: 2px solid rgba(232, 220, 200, 0.3); }
    .ss-ledger li {
      display: grid; grid-template-columns: 1fr auto; gap: 26px; align-items: baseline;
      padding: 28px 6px; border-bottom: 2px solid rgba(232, 220, 200, 0.3);
    }
    .ss-ledger h3 { margin: 0 0 8px; font-size: 1.6rem; font-weight: 600; }
    .ss-ledger p { margin: 0; color: var(--ss-sand); line-height: 1.65; max-width: 56ch; }
    .ss-ledger-price { font-size: 2.4rem; font-weight: 700; color: var(--ss-terra); margin: 0; font-variant-numeric: tabular-nums; }

    /* contact */
    .ss-section { padding: clamp(70px, 9vw, 120px) 0; }
    .ss-contact-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 5vw, 70px); align-items: start; }
    .ss-addr { font-style: normal; font-size: 1.05rem; line-height: 1.9; color: var(--ss-bark); margin-top: 18px; }
    .ss-addr a { color: var(--ss-terra-deep); font-weight: 600; }
    .ss-form {
      background: #fff; border: 2px solid var(--ss-sand-deep); border-radius: 28px;
      padding: clamp(28px, 4vw, 42px); display: grid; gap: 16px;
      box-shadow: 0 18px 44px rgba(107, 74, 53, 0.14);
    }
    .ss-form h3 { font-size: 1.7rem; margin: 0; font-weight: 600; }
    .ss-form label { display: grid; gap: 8px; font-weight: 600; font-size: 0.95rem; color: var(--ss-bark); }
    .ss-form input, .ss-form select, .ss-form textarea {
      font-family: var(--ss-serif); font-size: 1rem;
      background: var(--ss-cream); border: 2px solid var(--ss-sand-deep); border-radius: 16px;
      padding: 13px 16px; width: 100%; color: var(--ss-bark-deep);
    }
    .ss-form input:focus, .ss-form select:focus, .ss-form textarea:focus { outline: 3px solid var(--ss-sage); outline-offset: 1px; }
    .ss-form-note { margin: 0; font-family: var(--ss-hand); font-size: 1.5rem; color: var(--ss-sage-deep); }
    .ss-form-note:empty { display: none; }

    /* footer */
    .ss-footer { background: var(--ss-sand); border-top: 2px solid var(--ss-sand-deep); padding: 60px 0 80px; text-align: center; }
    .ss-footer-mark { font-family: var(--ss-hand); font-size: 3.4rem; color: var(--ss-terra-deep); margin: 0 0 18px; }
    .ss-footer-in { display: grid; gap: 8px; color: var(--ss-bark); font-size: 0.95rem; }
    .ss-footer-in p { margin: 0; }
    .ss-footer-in a { color: var(--ss-terra-deep); }

    @media (max-width: 900px) {
      .ss-nav-links, .ss-nav > .ss-btn { display: none; }
      .ss-burger { display: block; }
      .ss-menu {
        display: grid; gap: 4px; background: var(--ss-cream);
        border-bottom: 2px solid var(--ss-sand-deep); padding: 14px clamp(20px, 4vw, 40px) 22px;
      }
      .ss-menu[hidden] { display: none; }
      .ss-menu a:not(.ss-btn) { padding: 12px 6px; color: var(--ss-bark-deep); text-decoration: none; font-weight: 600; font-size: 1.1rem; border-bottom: 1px solid var(--ss-sand-deep); }
      .ss-menu .ss-btn { margin-top: 12px; }
      .ss-inter-in, .ss-contact-in { grid-template-columns: 1fr; }
      .ss-inter-in .ss-arch { max-width: 440px; margin: 0 auto; width: 100%; }
      .ss-ledger li { grid-template-columns: 1fr; gap: 8px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ss-sun, .ss-dot, .ss-hot { animation: none; }
      .ss-btn, .ss-hot { transition: none; }
    }
  </style>
</body>
</html>
