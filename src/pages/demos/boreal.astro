    .br-h2 + p, .br-sec-intro { font-size: 17px; line-height: 1.7; color: var(--br-muted); max-width: 62ch; }
    .br section { padding: clamp(48px, 7vh, 80px) 0; scroll-margin-top: 96px; }
    .br-header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid #D9E2E2; }
    .br-header-in { max-width: 1200px; margin: 0 auto; padding: 12px clamp(16px, 4vw, 32px); display: flex; align-items: center; gap: 24px; }
