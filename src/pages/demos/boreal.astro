    .br a:not(.br-cta):not(.br-brand):not(.br-phone):not(.br-phone-big):not(.br-call):not(.br-skip) { color: var(--br-teal); }
    .br :focus-visible { outline: 2px solid #fff; outline-offset: 2px; box-shadow: 0 0 0 4px var(--br-teal); }
