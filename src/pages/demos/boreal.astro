    .br-sticky a { flex: 1; text-align: center; text-decoration: none; font-weight: 600; padding: 12px; border-radius: 8px; min-height: 48px; }
    .br-sticky a:first-child { border: 2px solid var(--br-navy); color: var(--br-navy); }
