    .br-cta, .br-btn { display: inline-block; background: var(--br-teal); color: #fff; font-weight: 600; text-decoration: none; border: 0; border-radius: 8px; padding: 13px 22px; font-size: 16px; cursor: pointer; min-height: 48px; font-family: "Inter", sans-serif; }
