    .br-hero { background: #fff; }
    .br-hero-in { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px); display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 4vw, 56px); align-items: start; }
    .br-eyebrow { color: var(--br-teal); font-weight: 600; letter-spacing: 0.04em; margin: 8px 0 12px; }
