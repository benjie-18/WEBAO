    .br-how { background: #fff; }
    .br-steps { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .br-steps li { border-top: 3px solid var(--br-teal); padding-top: 16px; }
    .br-step-num { font-family: "Sora", sans-serif; font-size: 28px; font-weight: 700; color: var(--br-teal); margin: 0 0 8px; }
    .br-steps h3 { font-family: "Sora", sans-serif; color: var(--br-navy); margin: 0 0 8px; }
    .br-steps p:last-child { line-height: 1.65; margin: 0; }
    .br-protect { background: var(--br-navy); color: #fff; }
    .br-protect .br-h2, .br-protect .br-sec-intro { color: #fff; }
