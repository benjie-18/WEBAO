    .br-form-note:empty { display: none; }
    .br-form-error { font-weight: 600; color: #9B1C1C; }
    .br-form-error:empty { display: none; }

    .br-stats { background: var(--br-navy); color: #fff; }
    .br-stats-in { max-width: 1080px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px); display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; }
    .br-stat-num { font-family: "Sora", sans-serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: #fff; margin: 0 0 6px; }
    .br-stats p:last-child { margin: 0; opacity: 0.85; line-height: 1.5; }
