---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Brume Parfums · fictional fragrance house, Grasse.
// Rebuilt as a SCENT JOURNEY: a linear narrative through dawn, day, dusk
// and night. No cards, no grid. Each fragrance is a full-bleed chapter with
// a sticky chapter rail tracking the time of day. Standalone art direction.
const IMG = {
  aube: "https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&w=1600&auto=format&fit=crop",
  voile: "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=1600&auto=format&fit=crop",
  heure: "https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=1600&auto=format&fit=crop",
  nuit: "https://images.unsplash.com/photo-1518199266791-5375a83190b7?q=80&w=1600&auto=format&fit=crop",
  flowers: "https://images.unsplash.com/photo-1522748906645-95d8adfd52c7?q=80&w=1400&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Brume · A day in four scents</title>
  <meta name="description" content="Brume Parfums: follow one day from dawn to night through four fragrances. Fictional fragrance house." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body class="brm">

  <header class="brm-top">
    <a class="brm-logo" href="#prologue">Brume</a>
    <nav class="brm-links" aria-label="Primary">
      <a href="#aube">Dawn</a>
      <a href="#voile">Day</a>
      <a href="#heure">Dusk</a>
      <a href="#nuit">Night</a>
    </nav>
    <a class="brm-btn" href="#discovery">Discovery set · $45</a>
  </header>

  <!-- Sticky chapter rail: the time of day, always present -->
  <nav class="brm-rail" aria-label="Chapters">
    <a href="#aube" data-chapter="aube"><span class="brm-rail-time">05:47</span><span class="brm-rail-name">Aube</span></a>
    <a href="#voile" data-chapter="voile"><span class="brm-rail-time">12:30</span><span class="brm-rail-name">Voile</span></a>
    <a href="#heure" data-chapter="heure"><span class="brm-rail-time">19:05</span><span class="brm-rail-name">L'Heure Bleue</span></a>
    <a href="#nuit" data-chapter="nuit"><span class="brm-rail-time">23:41</span><span class="brm-rail-name">Nuit</span></a>
  </nav>

  <main>
    <!-- PROLOGUE: a breath, not a hero -->
    <section class="brm-prologue" id="prologue">
      <p class="brm-prologue-kicker">Brume Parfums · Grasse</p>
      <h1 class="brm-prologue-title">One day,<br /><em>four scents.</em></h1>
      <p class="brm-prologue-sub">Wear the weather. Scroll slowly, from first light to last.</p>
      <a class="brm-scrollcue" href="#aube" aria-label="Begin the journey">↓</a>
    </section>

    <!-- CHAPTER 1: DAWN -->
    <section class="brm-chapter brm-dawn" id="aube" data-chapter="aube" aria-labelledby="t-aube">
      <div class="brm-chapter-bg"><img src={IMG.aube} alt="First light over a misty field at dawn" loading="eager" /></div>
      <div class="brm-chapter-in">
        <p class="brm-time">05:47 · Chapter one</p>
        <h2 class="brm-name" id="t-aube">Aube</h2>
        <p class="brm-line">First light through linen curtains. The day has not decided anything yet.</p>
        <ul class="brm-notes">
          <li><span>Top</span>Bergamot, white tea</li>
          <li><span>Heart</span>Orange blossom water</li>
          <li><span>Base</span>Wet stone, pale musk</li>
        </ul>
        <div class="brm-buy"><p class="brm-price">$180 · 50 ml</p><a class="brm-btn" href="#discovery">Try it in the set</a></div>
      </div>
    </section>

    <!-- CHAPTER 2: DAY -->
    <section class="brm-chapter brm-day" id="voile" data-chapter="voile" aria-labelledby="t-voile">
      <div class="brm-chapter-bg"><img src={IMG.voile} alt="Soft daylight over foggy hills" loading="lazy" /></div>
      <div class="brm-chapter-in">
        <p class="brm-time">12:30 · Chapter two</p>
        <h2 class="brm-name" id="t-voile">Voile</h2>
        <p class="brm-line">Midday, sheer as a curtain. Present, but never loud.</p>
        <ul class="brm-notes">
          <li><span>Top</span>Neroli, green fig</li>
          <li><span>Heart</span>Orange blossom, sea salt</li>
          <li><span>Base</span>Driftwood, clean skin</li>
        </ul>
        <div class="brm-buy"><p class="brm-price">$165 · 50 ml</p><a class="brm-btn" href="#discovery">Try it in the set</a></div>
      </div>
    </section>

    <!-- CHAPTER 3: DUSK -->
    <section class="brm-chapter brm-dusk" id="heure" data-chapter="heure" aria-labelledby="t-heure">
      <div class="brm-chapter-bg"><img src={IMG.heure} alt="Mountains at dusk under a violet sky" loading="lazy" /></div>
      <div class="brm-chapter-in">
        <p class="brm-time">19:05 · Chapter three</p>
        <h2 class="brm-name" id="t-heure">L'Heure Bleue</h2>
        <p class="brm-line">The blue hour, when the city softens and everything feels possible.</p>
        <ul class="brm-notes">
          <li><span>Top</span>Violet leaf, pink pepper</li>
          <li><span>Heart</span>Iris, plum skin</li>
          <li><span>Base</span>Cedar, grey amber</li>
        </ul>
        <div class="brm-buy"><p class="brm-price">$195 · 50 ml</p><a class="brm-btn" href="#discovery">Try it in the set</a></div>
      </div>
    </section>

    <!-- CHAPTER 4: NIGHT -->
    <section class="brm-chapter brm-night" id="nuit" data-chapter="nuit" aria-labelledby="t-nuit">
      <div class="brm-chapter-bg"><img src={IMG.nuit} alt="Night sky over dark water" loading="lazy" /></div>
      <div class="brm-chapter-in">
        <p class="brm-time">23:41 · Chapter four</p>
        <h2 class="brm-name" id="t-nuit">Nuit</h2>
        <p class="brm-line">After midnight, nothing to prove. Smoke, spice, and the long way home.</p>
        <ul class="brm-notes">
          <li><span>Top</span>Black pepper, cardamom</li>
          <li><span>Heart</span>Dark rose, incense</li>
          <li><span>Base</span>Oud, amber, vetiver</li>
        </ul>
        <div class="brm-buy"><p class="brm-price">$220 · 50 ml</p><a class="brm-btn" href="#discovery">Try it in the set</a></div>
      </div>
    </section>

    <!-- EPILOGUE: discovery set + atelier -->
    <section class="brm-epilogue" id="discovery" aria-labelledby="discovery-title">
      <div class="brm-epi-in">
        <figure class="brm-epi-img"><img src={IMG.flowers} alt="White flowers in soft morning light" loading="lazy" /></figure>
        <div>
          <h2 class="brm-epi-title" id="discovery-title">The discovery set</h2>
          <p class="brm-epi-sub">All four chapters, 4 × 2 ml. <strong>$45</strong>, credited toward any full bottle.</p>
          <form class="brm-form" id="brm-form">
            <label>Name<input type="text" name="name" required autocomplete="name" /></label>
            <label>Email<input type="email" name="email" required autocomplete="email" /></label>
            <label>A note for the atelier<textarea name="message" rows="3" placeholder="Which chapter are you most curious about?"></textarea></label>
            <button class="brm-btn brm-btn-full" type="submit">Order the discovery set</button>
            <p class="brm-form-done" id="brm-done" hidden>Thank you. The atelier will write to you within two days.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="brm-foot">
    <p>Brume Parfums · fictitious demo site · Grasse</p>
    <p>atelier@brume.example</p>
  </footer>

  <EscapeHatch locale="en" />

  <style>
    .brm { --ink: #f4f1ea; --mut: rgba(244,241,234,.66); --serif: "Cormorant Garamond", serif; --sans: "Jost", system-ui, sans-serif; background: #101418; color: var(--ink); font-family: var(--sans); margin: 0; min-height: 100vh; font-weight: 300; }
    .brm * { box-sizing: border-box; }
    .brm img { display: block; max-width: 100%; }
    .brm em { font-style: italic; }
    .brm .brm-btn { display: inline-block; font-family: var(--sans); font-weight: 400; letter-spacing: .14em; text-transform: uppercase; font-size: 12px; color: var(--ink); text-decoration: none; border: 1px solid rgba(244,241,234,.45); padding: 13px 26px; border-radius: 999px; cursor: pointer; background: transparent; transition: background .3s, color .3s; }
    .brm .brm-btn:hover { background: var(--ink); color: #101418; }
    .brm .brm-btn-full { width: 100%; text-align: center; }

    .brm-top { position: fixed; top: 0; left: 0; right: 0; z-index: 60; display: flex; align-items: center; gap: 26px; padding: 18px 34px; mix-blend-mode: difference; }
    .brm-logo { font-family: var(--serif); font-size: 26px; font-style: italic; color: #fff; text-decoration: none; margin-right: auto; }
    .brm-links { display: flex; gap: 24px; }
    .brm-links a { color: #fff; text-decoration: none; font-size: 13px; letter-spacing: .18em; text-transform: uppercase; opacity: .8; }
    .brm-links a:hover { opacity: 1; }
    .brm-top .brm-btn { border-color: rgba(255,255,255,.5); color: #fff; padding: 10px 20px; }
    .brm-top .brm-btn:hover { background: #fff; color: #000; }

    /* chapter rail */
    .brm-rail { position: fixed; z-index: 60; left: 30px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 4px; mix-blend-mode: difference; }
    .brm-rail a { display: flex; align-items: baseline; gap: 12px; text-decoration: none; color: #fff; opacity: .35; padding: 8px 0; transition: opacity .3s; }
    .brm-rail a.is-active { opacity: 1; }
    .brm-rail-time { font-size: 12px; letter-spacing: .12em; font-variant-numeric: tabular-nums; }
    .brm-rail-name { font-family: var(--serif); font-style: italic; font-size: 17px; }

    /* prologue: a breath */
    .brm-prologue { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 120px 24px 60px; background: radial-gradient(ellipse 80% 60% at 50% 110%, #2a3440 0%, #101418 65%); }
    .brm-prologue-kicker { letter-spacing: .3em; text-transform: uppercase; font-size: 12px; color: var(--mut); margin: 0 0 26px; }
    .brm-prologue-title { font-family: var(--serif); font-weight: 500; font-size: clamp(54px, 10vw, 120px); line-height: 1; margin: 0; letter-spacing: -0.01em; }
    .brm-prologue-sub { color: var(--mut); font-size: 18px; margin: 26px 0 0; max-width: 40ch; line-height: 1.7; }
    .brm-scrollcue { margin-top: 60px; color: var(--ink); text-decoration: none; font-size: 26px; opacity: .6; animation: brm-bob 2.4s ease-in-out infinite; }
    @keyframes brm-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }

    /* chapters: full-bleed scenes */
    .brm-chapter { position: relative; min-height: 108vh; display: flex; align-items: flex-end; overflow: hidden; }
    .brm-chapter-bg { position: absolute; inset: 0; }
    .brm-chapter-bg img { width: 100%; height: 100%; object-fit: cover; }
    .brm-chapter-bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,10,14,.88) 0%, rgba(8,10,14,.25) 55%, rgba(8,10,14,.15) 100%); }
    .brm-dawn .brm-chapter-bg::after { background: linear-gradient(to top, rgba(30,20,16,.9) 0%, rgba(30,20,16,.2) 60%, rgba(30,20,16,.1) 100%); }
    .brm-day .brm-chapter-bg::after { background: linear-gradient(to top, rgba(14,24,30,.9) 0%, rgba(14,24,30,.2) 60%, rgba(14,24,30,.1) 100%); }
    .brm-dusk .brm-chapter-bg::after { background: linear-gradient(to top, rgba(26,16,34,.9) 0%, rgba(26,16,34,.22) 60%, rgba(26,16,34,.12) 100%); }
    .brm-chapter-in { position: relative; z-index: 1; width: 100%; max-width: 900px; margin: 0 auto; padding: 40px 90px 90px 110px; }
    .brm-time { letter-spacing: .28em; text-transform: uppercase; font-size: 12px; color: var(--mut); margin: 0 0 14px; font-variant-numeric: tabular-nums; }
    .brm-name { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: clamp(64px, 12vw, 150px); line-height: .9; margin: 0; letter-spacing: -0.015em; text-shadow: 0 4px 40px rgba(0,0,0,.4); }
    .brm-line { font-family: var(--serif); font-size: clamp(20px, 3vw, 27px); font-style: italic; color: var(--ink); max-width: 34ch; line-height: 1.5; margin: 22px 0 0; }
    .brm-notes { list-style: none; margin: 30px 0 0; padding: 0; display: grid; gap: 10px; max-width: 420px; }
    .brm-notes li { display: grid; grid-template-columns: 64px 1fr; gap: 14px; font-size: 16px; padding: 10px 0; border-bottom: 1px solid rgba(244,241,234,.16); }
    .brm-notes li span { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--mut); padding-top: 3px; }
    .brm-buy { display: flex; align-items: center; gap: 22px; margin-top: 30px; flex-wrap: wrap; }
    .brm-price { font-family: var(--serif); font-size: 24px; font-style: italic; margin: 0; }

    /* epilogue */
    .brm-epilogue { padding: 120px 24px; background: #0c0f13; }
    .brm-epi-in { max-width: 1020px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.1fr; gap: 60px; align-items: center; }
    .brm-epi-img img { width: 100%; height: 520px; object-fit: cover; border-radius: 200px 200px 12px 12px; }
    .brm-epi-title { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: clamp(38px, 5vw, 58px); margin: 0 0 14px; }
    .brm-epi-sub { color: var(--mut); font-size: 17px; line-height: 1.7; margin: 0 0 26px; }
    .brm-epi-sub strong { color: var(--ink); font-weight: 500; }
    .brm-form { display: grid; gap: 14px; }
    .brm-form label { display: grid; gap: 7px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--mut); }
    .brm-form input, .brm-form textarea { font-family: var(--sans); font-weight: 300; font-size: 16px; padding: 13px 14px; border-radius: 4px; border: 1px solid rgba(244,241,234,.25); background: rgba(244,241,234,.06); color: var(--ink); width: 100%; }
    .brm-form input:focus, .brm-form textarea:focus { outline: 1px solid var(--ink); outline-offset: 2px; }
    .brm-form-done { color: var(--ink); font-style: italic; font-family: var(--serif); font-size: 19px; margin: 4px 0 0; }

    .brm-foot { padding: 30px 24px 70px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; background: #0c0f13; }
    .brm-foot p { margin: 0; font-size: 13px; letter-spacing: .1em; color: var(--mut); }

    @media (max-width: 900px) {
      .brm-links { display: none; }
      .brm-rail { left: 0; right: 0; top: auto; bottom: 0; transform: none; flex-direction: row; justify-content: center; background: rgba(10,12,16,.72); backdrop-filter: blur(10px); mix-blend-mode: normal; padding: 6px 4px; gap: 2px; }
      .brm-rail a { flex-direction: column; align-items: center; gap: 2px; padding: 8px 10px; }
      .brm-rail-time { font-size: 10px; }
      .brm-rail-name { font-size: 13px; }
      .brm-chapter-in { padding: 30px 22px 110px; }
      .brm-epi-in { grid-template-columns: 1fr; gap: 36px; }
      .brm-epi-img img { height: 340px; }
      .brm-top { padding: 14px 18px; gap: 14px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .brm * { animation: none !important; transition: none !important; }
    }
  </style>

  <script>
    (function () {
      // Chapter rail highlight
      var links = Array.prototype.slice.call(document.querySelectorAll('.brm-rail a'));
      var chapters = Array.prototype.slice.call(document.querySelectorAll('.brm-chapter'));
      function setActive(id: string) {
        links.forEach(function (a) { a.classList.toggle('is-active', a.getAttribute('data-chapter') === id); });
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) setActive(en.target.getAttribute('data-chapter') || '');
          });
        }, { rootMargin: '-45% 0px -45% 0px' });
        chapters.forEach(function (c) { io.observe(c); });
      }
      // Form
      var form = document.getElementById('brm-form') as HTMLFormElement | null;
      var done = document.getElementById('brm-done');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        if (done) done.hidden = false;
        form?.reset();
      });
    })();
  </script>
</body>
</html>
