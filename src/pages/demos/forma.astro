---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Studio Forma, fictional interior architecture studio, Montréal QC.
// Standalone art direction. Not connected to the WEBAO theme system.
// Structure: BLUEPRINT. The page is a drawing sheet: white lines on blueprint blue,
// a title block header, projects as plan sheets with dimension lines, services as
// a spec schedule, contact as a commissioning title block. No marketing hero.
const IMG = {
  hero: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1800&auto=format&fit=crop",
  p1: "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=1200&auto=format&fit=crop",
  p2: "https://images.unsplash.com/photo-1556912167-f556f1f39fdf?q=80&w=1200&auto=format&fit=crop",
  p3: "https://images.unsplash.com/photo-1620626011761-996317b8d101?q=80&w=1200&auto=format&fit=crop",
  studio: "/demos/forma/01.jpg",
  detail: "/demos/forma/02.jpg",
};
const SHEETS = [
  { no: "A-101", img: IMG.p1, alt: "Warm minimalist living room with curved sofa and oak floors", title: "Atelier Residence", spec: "residential · 320 m² · 2024", note: "A family home composed around a single oak spine: kitchen, library, and stair drawn as one continuous gesture. Plaster walls, honed stone, nothing that shouts.", dim: "18.40 m" },
  { no: "A-102", img: IMG.p2, alt: "Refined kitchen with marble waterfall island and globe pendants", title: "Maison Cèdre", spec: "residential · 210 m² · 2023", note: "A kitchen built for a chef who hates clutter. Concealed storage, a twelve-foot stone island, and light that does the decorating.", dim: "12.00 m" },
  { no: "A-103", img: IMG.p3, alt: "Serene white bathroom with freestanding tub", title: "Bain de Pierre", spec: "residential · 14 m² · 2025", note: "A bath carved from a single palette: limestone, brushed brass, and silence. Proof that small rooms deserve the same rigor as large ones.", dim: "4.20 m" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="forma" locale="en" title="Studio Forma: Space, Composed" description="Studio Forma is a Montréal interior architecture studio. Residential, commercial and material studies, drawn with rigor since 2009." ogImage="https://webao.ca/demos/forma/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body class="fm">

  <EscapeHatch locale="en" />

  <!-- TITLE BLOCK: the header is a drawing title block -->
  <header class="fm-titleblock">
    <div class="fm-tb-cell fm-tb-logo"><span class="fm-logo">FORMA</span><span class="fm-logo-sub">atelier d'architecture intérieure</span></div>
    <div class="fm-tb-cell"><span class="fm-tb-k">Project</span><span class="fm-tb-v">The Studio, Drawn</span></div>
    <div class="fm-tb-cell"><span class="fm-tb-k">Sheet</span><span class="fm-tb-v">A-001</span></div>
    <div class="fm-tb-cell"><span class="fm-tb-k">Scale</span><span class="fm-tb-v">1:1</span></div>
    <div class="fm-tb-cell"><span class="fm-tb-k">Date</span><span class="fm-tb-v">2026-10-04</span></div>
    <nav class="fm-tb-cell fm-tb-nav" aria-label="Sheet index">
      <a href="#sheets">Sheets</a>
      <a href="#schedule">Schedule</a>
      <a href="#office">Office</a>
      <a href="#commission" class="fm-tb-cta">Commission →</a>
    </nav>
  </header>

  <main id="top" class="fm-sheet">

    <!-- DRAWING INDEX: no hero, straight to the sheets -->
    <p class="fm-index-line">· drawing index · three sheets · all dimensions in metres ·</p>
    <h1 class="fm-h1">Space,<br />composed.</h1>

    <div class="fm-sheets" id="sheets">
      {SHEETS.map((s) => (
        <article class="fm-plan" aria-label={"Sheet " + s.no + ": " + s.title}>
          <div class="fm-plan-head">
            <span class="fm-plan-no">{s.no}</span>
            <span class="fm-plan-spec">{s.spec}</span>
          </div>
          <figure class="fm-plan-fig">
            <img src={s.img} alt={s.alt} loading="lazy" decoding="async" />
            <span class="fm-dim fm-dim-h" aria-hidden="true">{s.dim}</span>
          </figure>
          <div class="fm-plan-body">
            <h2 class="fm-plan-title">{s.title}</h2>
            <p>{s.note}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- DETAIL: full-bleed drawing -->
    <figure class="fm-detail">
      <img src={IMG.detail} alt="Architectural concrete detail with dramatic natural light" loading="lazy" decoding="async" />
      <figcaption>detail · Atelier Residence · plaster, honed stone, 1:5</figcaption>
    </figure>

    <!-- SPEC SCHEDULE: services as a schedule table -->
    <section class="fm-schedule" id="schedule" aria-label="Scope of work schedule">
      <h2 class="fm-h2">Scope of work <span class="fm-sched-no">S-01</span></h2>
      <table class="fm-table">
        <thead><tr><th scope="col">Ref</th><th scope="col">Scope</th><th scope="col">Includes</th></tr></thead>
        <tbody>
          <tr><td>S-01</td><td>Full-service residential</td><td>From first sketch to final styling. Architecture, millwork, lighting, furnishings.</td></tr>
          <tr><td>S-02</td><td>Commercial and retail</td><td>Restaurants, boutiques, workplaces where the room is part of the brand.</td></tr>
          <tr><td>S-03</td><td>Colour and material studies</td><td>Palettes, samples, specifications for your own contractor.</td></tr>
          <tr><td>S-04</td><td>Art direction for developers</td><td>Model suites and amenity spaces that sell the building before it is built.</td></tr>
        </tbody>
      </table>
    </section>

    <!-- OFFICE: the site photo -->
    <section class="fm-office" id="office" aria-label="The office">
      <div class="fm-office-grid">
        <figure class="fm-office-fig">
          <img src={IMG.studio} alt="The Studio Forma team at work in the Montreal atelier" loading="lazy" decoding="async" />
          <figcaption>site photo · the atelier, Mile End</figcaption>
        </figure>
        <div>
          <h2 class="fm-h2">Eleven people.<br />One standard.</h2>
          <p>Forma was founded in 2009 by architect Hélène Marchand. The studio remains deliberately small: eleven architects and designers, two projects per principal, and site visits that never get delegated to strangers.</p>
          <p>We publish little and photograph less. Most commissions arrive by referral, which is exactly how we like it.</p>
        </div>
      </div>
    </section>

    <!-- PHASES -->
    <section class="fm-phases" aria-label="How a commission unfolds">
      <h2 class="fm-h2">How a commission unfolds</h2>
      <ol class="fm-phase-list">
        <li><strong>P-1 · Conversation</strong><span>We meet, we listen, we walk your space. No fee, no pitch deck.</span></li>
        <li><strong>P-2 · Study</strong><span>Measured drawings, precedents, and a first direction to react to.</span></li>
        <li><strong>P-3 · Design</strong><span>Drawings, materials, and pricing developed together, in rounds.</span></li>
        <li><strong>P-4 · Realization</strong><span>Site supervision until the last hinge is adjusted.</span></li>
      </ol>
    </section>

    <!-- COMMISSION TITLE BLOCK -->
    <section class="fm-commission" id="commission" aria-label="Begin a project">
      <div class="fm-comm-grid">
        <div>
          <h2 class="fm-h2">Begin a project.</h2>
          <p>We take on a small number of commissions each year. Write a few lines about your space and we will reply within a week.</p>
          <dl class="fm-comm-meta">
            <div><dt>Drawn by</dt><dd>H. Marchand, OAQ</dd></div>
            <div><dt>Checked</dt><dd>Atelier Forma</dd></div>
            <div><dt>Status</dt><dd class="fm-stamp">Accepting 2027</dd></div>
          </dl>
        </div>
        <form class="fm-form" id="fm-form" novalidate>
          <label>Name<input type="text" name="name" required autocomplete="name" placeholder="Hélène Côté" /></label>
          <label>Email<input type="email" name="email" required autocomplete="email" placeholder="helene@example.com" /></label>
          <label>The space<textarea name="message" rows="4" required placeholder="A 1920s duplex in Rosemont, two floors..."></textarea></label>
          <button type="submit">Submit for review</button>
          <p class="fm-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

  </main>

  <footer class="fm-footer">
    <p>FORMA · atelier d'architecture intérieure · Montréal · © 2026 · Fictional demo</p>
  </footer>

  <script>
    (function () {
      var formEl = document.getElementById('fm-form');
      if (formEl instanceof HTMLFormElement) {
        const form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.fm-form-note');
          if (note) note.textContent = 'Received and filed. We reply within a week.';
          form.reset();
        });
      }
    })();
  </script>

<style>
  .fm {
    --fm-blue: #17457E;
    --fm-blue-deep: #0F3563;
    --fm-line: rgba(255,255,255,.85);
    --fm-faint: rgba(255,255,255,.6);
    --fm-serif: "Cormorant Garamond", Georgia, serif;
    --fm-mono: "IBM Plex Mono", ui-monospace, monospace;
    margin: 0;
    background: var(--fm-blue);
    background-image:
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 48px 48px;
    color: #fff;
    font-family: var(--fm-serif);
    font-size: 1.15rem;
    overflow-x: clip;
  }
  .fm *, .fm *::before, .fm *::after { box-sizing: border-box; }
  .fm img { display: block; max-width: 100%; }
  .fm a { color: inherit; }

  /* title block */
  .fm-titleblock {
    display: grid; grid-template-columns: 1.4fr 1fr 0.7fr 0.7fr 0.9fr 1.6fr;
    border-bottom: 2px solid var(--fm-line);
    background: rgba(15,53,99,.55); backdrop-filter: blur(6px);
    position: sticky; top: 0; z-index: 60;
    font-family: var(--fm-mono); font-size: 0.82rem;
  }
  .fm-tb-cell { padding: 14px 18px; border-right: 1px solid rgba(255,255,255,.3); display: flex; flex-direction: column; justify-content: center; gap: 2px; }
  .fm-tb-cell:last-child { border-right: 0; }
  .fm-tb-k { font-size: 0.66rem; letter-spacing: .18em; text-transform: uppercase; color: var(--fm-faint); }
  .fm-tb-v { font-weight: 600; }
  .fm-logo { font-weight: 600; font-size: 1.3rem; letter-spacing: .28em; }
  .fm-logo-sub { font-size: 0.68rem; color: var(--fm-faint); letter-spacing: .06em; }
  .fm-tb-nav { flex-direction: row; align-items: center; gap: 20px; }
  .fm-tb-nav a { text-decoration: none; }
  .fm-tb-nav a:hover { text-decoration: underline; }
  .fm-tb-cta { font-weight: 600; border: 1px solid var(--fm-line); padding: 8px 16px; }

  .fm-sheet { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

  .fm-index-line { font-family: var(--fm-mono); font-size: 0.8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--fm-faint); text-align: center; margin: clamp(48px,7vw,90px) 0 26px; }
  .fm-h1 { font-size: clamp(3.4rem, 9vw, 7rem); line-height: .98; font-weight: 500; margin: 0 0 60px; text-align: center; }
  .fm-h2 { font-size: clamp(2rem, 4.6vw, 3rem); font-weight: 500; margin: 0 0 24px; line-height: 1.05; }

  .fm-sheets { display: grid; gap: clamp(50px, 7vw, 90px); padding-bottom: clamp(60px, 8vw, 110px); }
  .fm-plan { border: 2px solid var(--fm-line); background: rgba(15,53,99,.35); }
  .fm-plan-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap;
    padding: 14px 22px; border-bottom: 2px solid var(--fm-line);
    font-family: var(--fm-mono); font-size: 0.88rem;
  }
  .fm-plan-no { font-weight: 600; font-size: 1.05rem; letter-spacing: .1em; }
  .fm-plan-spec { color: var(--fm-faint); }
  .fm-plan-fig { position: relative; margin: 0; border-bottom: 2px solid var(--fm-line); }
  .fm-plan-fig img { width: 100%; height: clamp(280px, 44vw, 520px); object-fit: cover; filter: saturate(.82) contrast(1.02); }
  .fm-dim {
    position: absolute; font-family: var(--fm-mono); font-size: 0.85rem; letter-spacing: .1em;
    background: var(--fm-blue); padding: 6px 16px; border: 1px solid var(--fm-line);
  }
  .fm-dim-h { bottom: 18px; left: 50%; transform: translateX(-50%); }
  .fm-dim-h::before, .fm-dim-h::after { content: ""; position: absolute; top: 50%; width: 60px; height: 1px; background: var(--fm-line); }
  .fm-dim-h::before { right: 100%; } .fm-dim-h::after { left: 100%; }
  .fm-plan-body { padding: 26px 28px 30px; display: grid; grid-template-columns: 280px 1fr; gap: 10px 34px; align-items: baseline; }
  .fm-plan-title { font-size: 2rem; font-weight: 500; margin: 0; }
  .fm-plan-body p { margin: 0; line-height: 1.6; color: rgba(255,255,255,.88); max-width: 62ch; }

  .fm-detail { margin: 0 0 clamp(60px, 8vw, 110px); border: 2px solid var(--fm-line); }
  .fm-detail img { width: 100%; height: clamp(240px, 36vw, 440px); object-fit: cover; filter: saturate(.8); }
  .fm-detail figcaption { font-family: var(--fm-mono); font-size: 0.82rem; letter-spacing: .08em; padding: 12px 20px; border-top: 2px solid var(--fm-line); color: var(--fm-faint); }

  .fm-schedule { padding-bottom: clamp(60px, 8vw, 110px); }
  .fm-sched-no { font-family: var(--fm-mono); font-size: 1rem; color: var(--fm-faint); letter-spacing: .1em; }
  .fm-table { width: 100%; border-collapse: collapse; font-size: 1.02rem; margin-top: 8px; }
  .fm-table th, .fm-table td { text-align: left; padding: 16px 14px; border-bottom: 1px solid rgba(255,255,255,.35); vertical-align: top; }
  .fm-table th { font-family: var(--fm-mono); font-size: 0.72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--fm-faint); font-weight: 500; }
  .fm-table td:first-child { font-family: var(--fm-mono); white-space: nowrap; }
  .fm-table td:nth-child(2) { font-weight: 600; white-space: nowrap; }
  .fm-table td:last-child { color: rgba(255,255,255,.82); }

  .fm-office { padding-bottom: clamp(60px, 8vw, 110px); }
  .fm-office-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(26px, 5vw, 60px); align-items: center; }
  .fm-office-fig { margin: 0; border: 2px solid var(--fm-line); }
  .fm-office-fig img { width: 100%; height: clamp(260px, 34vw, 420px); object-fit: cover; filter: saturate(.82); }
  .fm-office-fig figcaption { font-family: var(--fm-mono); font-size: 0.8rem; letter-spacing: .08em; padding: 10px 16px; border-top: 2px solid var(--fm-line); color: var(--fm-faint); }
  .fm-office p { line-height: 1.65; color: rgba(255,255,255,.88); }

  .fm-phases { padding-bottom: clamp(60px, 8vw, 110px); }
  .fm-phase-list { list-style: none; margin: 10px 0 0; padding: 0; border-top: 1px solid rgba(255,255,255,.35); }
  .fm-phase-list li {
    display: grid; grid-template-columns: 240px 1fr; gap: 8px 30px; align-items: baseline;
    padding: 20px 4px; border-bottom: 1px solid rgba(255,255,255,.35);
  }
  .fm-phase-list strong { font-family: var(--fm-mono); font-weight: 600; font-size: 1rem; }
  .fm-phase-list span { color: rgba(255,255,255,.82); }

  .fm-commission { border: 2px solid var(--fm-line); background: rgba(15,53,99,.5); margin-bottom: clamp(70px, 9vw, 120px); }
  .fm-comm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(26px, 5vw, 60px); padding: clamp(28px, 5vw, 54px); }
  .fm-comm-grid p { line-height: 1.65; color: rgba(255,255,255,.88); }
  .fm-comm-meta { margin: 26px 0 0; display: grid; gap: 12px; font-family: var(--fm-mono); font-size: 0.9rem; }
  .fm-comm-meta > div { display: grid; grid-template-columns: 110px 1fr; gap: 12px; }
  .fm-comm-meta dt { color: var(--fm-faint); text-transform: uppercase; font-size: 0.72rem; letter-spacing: .16em; }
  .fm-comm-meta dd { margin: 0; }
  .fm-stamp {
    display: inline-block; border: 2px solid #fff; padding: 4px 14px; transform: rotate(-3deg);
    letter-spacing: .14em; font-size: 0.8rem;
  }
  .fm-form label { display: block; font-family: var(--fm-mono); font-size: 0.78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--fm-faint); margin-bottom: 18px; }
  .fm-form input, .fm-form textarea {
    display: block; width: 100%; margin-top: 8px; padding: 13px 15px;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.5);
    color: #fff; font-family: var(--fm-serif); font-size: 1.05rem; letter-spacing: 0; text-transform: none;
  }
  .fm-form input:focus, .fm-form textarea:focus { outline: 1px solid #fff; }
  .fm-form button {
    font-family: var(--fm-mono); font-size: 0.9rem; letter-spacing: .14em; text-transform: uppercase;
    padding: 15px 30px; background: #fff; color: var(--fm-blue-deep); border: 0; cursor: pointer; font-weight: 600;
  }
  .fm-form button:hover { background: var(--fm-faint); }
  .fm-form-note { font-family: var(--fm-mono); font-size: 0.88rem; margin: 14px 0 0; }

  .fm-footer { text-align: center; padding: 30px 20px 90px; font-family: var(--fm-mono); font-size: 0.78rem; letter-spacing: .12em; color: var(--fm-faint); }

  @media (max-width: 900px) {
    .fm-titleblock { grid-template-columns: 1fr 1fr; }
    .fm-tb-cell:nth-child(n+3):nth-child(-n+5) { display: none; }
    .fm-tb-nav { grid-column: 2; }
    .fm-plan-body { grid-template-columns: 1fr; }
    .fm-office-grid, .fm-comm-grid { grid-template-columns: 1fr; }
    .fm-phase-list li { grid-template-columns: 1fr; gap: 4px; }
    .fm-table td:nth-child(2) { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fm-stamp { transform: none; }
  }
</style>
</body>
</html>
