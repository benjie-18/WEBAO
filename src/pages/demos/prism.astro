---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Prism · fictional banking app.
// Rebuilt as the APP ITSELF: a PIN login gate lifts to reveal a working
// glassmorphic dashboard — sidebar, balance, transactions, cards, insights.
// No marketing page. Standalone art direction.
const IMG = {
  phone: "/demos/prism/01.jpg",
  pay: "/demos/prism/02.jpg",
  dashboard: "/demos/prism/03.jpg",
  ava1: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop",
  ava2: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop",
  ava3: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?q=80&w=200&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Prism · Your money, in focus</title>
  <meta name="description" content="Prism demo: sign in and explore a glassmorphic banking dashboard. Fictional product." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="pr">

  <div class="pr-bg" aria-hidden="true"><span class="pr-blob pr-blob-a"></span><span class="pr-blob pr-blob-b"></span><span class="pr-blob pr-blob-c"></span></div>

  <!-- LOGIN GATE: the "landing" is a sign-in, not a hero -->
  <div class="pr-gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
    <div class="pr-gate-card">
      <p class="pr-wordmark">Prism</p>
      <h1 class="pr-gate-title" id="gate-title">Welcome back, Maya</h1>
      <p class="pr-gate-sub">Enter your PIN to open the demo</p>
      <div class="pr-dots" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="pr-pad" role="group" aria-label="PIN pad">
        <button type="button" data-pin="1">1</button><button type="button" data-pin="2">2</button><button type="button" data-pin="3">3</button>
        <button type="button" data-pin="4">4</button><button type="button" data-pin="5">5</button><button type="button" data-pin="6">6</button>
        <button type="button" data-pin="7">7</button><button type="button" data-pin="8">8</button><button type="button" data-pin="9">9</button>
        <button type="button" data-pin="clear" aria-label="Clear">⌫</button><button type="button" data-pin="0">0</button><button type="button" data-pin="skip" aria-label="Skip">→</button>
      </div>
      <button class="pr-skip" id="gate-skip" type="button">Use the demo login instead</button>
      <p class="pr-gate-note">Fictional demo. Any 4 digits work.</p>
    </div>
  </div>

  <!-- THE APP -->
  <div class="pr-app" id="app" aria-hidden="true">
    <aside class="pr-side" aria-label="App navigation">
      <p class="pr-wordmark pr-wordmark-side">Prism</p>
      <nav class="pr-nav">
        <button type="button" class="pr-navbtn is-active" data-view="overview"><span class="pr-ico" aria-hidden="true">◧</span>Overview</button>
        <button type="button" class="pr-navbtn" data-view="cards"><span class="pr-ico" aria-hidden="true">▭</span>Cards</button>
        <button type="button" class="pr-navbtn" data-view="activity"><span class="pr-ico" aria-hidden="true">⇄</span>Activity</button>
        <button type="button" class="pr-navbtn" data-view="insights"><span class="pr-ico" aria-hidden="true">◔</span>Insights</button>
      </nav>
      <div class="pr-user">
        <img src={IMG.ava1} alt="" />
        <div><p class="pr-user-name">Maya Chen</p><p class="pr-user-plan">Prism Plus</p></div>
      </div>
    </aside>

    <main class="pr-main">
      <!-- OVERVIEW -->
      <section class="pr-view is-active" data-view="overview" aria-label="Overview">
        <div class="pr-balance glass">
          <div>
            <p class="pr-label">Total balance</p>
            <p class="pr-bignum">$12,847.20</p>
            <p class="pr-delta">+$1,240.18 this month</p>
          </div>
          <svg class="pr-spark" viewBox="0 0 220 70" aria-hidden="true">
            <defs><linearGradient id="prg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7c5cff" stop-opacity=".5"/><stop offset="1" stop-color="#7c5cff" stop-opacity="0"/></linearGradient></defs>
            <path d="M0,55 C30,50 45,38 70,42 C95,46 110,25 140,28 C170,31 190,14 220,16 L220,70 L0,70 Z" fill="url(#prg)"/>
            <path d="M0,55 C30,50 45,38 70,42 C95,46 110,25 140,28 C170,31 190,14 220,16" fill="none" stroke="#7c5cff" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="pr-actions">
          <button type="button" class="glass pr-action"><span aria-hidden="true">↗</span>Send</button>
          <button type="button" class="glass pr-action"><span aria-hidden="true">↙</span>Request</button>
          <button type="button" class="glass pr-action"><span aria-hidden="true">＋</span>Top up</button>
          <button type="button" class="glass pr-action"><span aria-hidden="true">◈</span>Split</button>
        </div>
        <div class="pr-cols">
          <div class="glass pr-panel">
            <div class="pr-panel-head"><h2>Recent activity</h2><button type="button" class="pr-link" data-goto="activity">See all</button></div>
            <ul class="pr-txns">
              <li><img src={IMG.ava2} alt="" /><div><p>Marcus Webb</p><p class="pr-muted">Dinner split · yesterday</p></div><span class="pr-amt in">+$86.00</span></li>
              <li><img src={IMG.ava3} alt="" /><div><p>Léa Tremblay</p><p class="pr-muted">Concert tickets · Oct 2</p></div><span class="pr-amt out">−$142.50</span></li>
              <li><img src={IMG.ava1} alt="" /><div><p>Salary · Studio Nord</p><p class="pr-muted">Direct deposit · Oct 1</p></div><span class="pr-amt in">+$4,200.00</span></li>
            </ul>
          </div>
          <div class="glass pr-panel pr-shot">
            <div class="pr-panel-head"><h2>Spending rhythm</h2></div>
            <img src={IMG.dashboard} alt="Prism spending dashboard preview" loading="lazy" />
            <p class="pr-muted">Groceries down 18% since you set the alert. Nice.</p>
          </div>
        </div>
      </section>

      <!-- CARDS -->
      <section class="pr-view" data-view="cards" aria-label="Cards" hidden>
        <div class="pr-cols">
          <div class="glass pr-panel">
            <div class="pr-panel-head"><h2>Your cards</h2><span class="pr-pill" id="freeze-pill">Active</span></div>
            <div class="pr-cardart" id="card-art" aria-hidden="true">
              <p class="pr-cardart-brand">Prism</p>
              <p class="pr-cardart-num">5312&nbsp;&nbsp;••••&nbsp;&nbsp;••••&nbsp;&nbsp;8471</p>
              <p class="pr-cardart-name">MAYA CHEN</p>
            </div>
            <div class="pr-cardrow">
              <button type="button" class="pr-toggle" id="freeze-btn" aria-pressed="false"><span class="pr-knob"></span>Freeze card</button>
              <button type="button" class="pr-action glass"><span aria-hidden="true">＋</span>New virtual card</button>
            </div>
          </div>
          <div class="glass pr-panel">
            <div class="pr-panel-head"><h2>Tap to pay</h2></div>
            <img class="pr-payimg" src={IMG.pay} alt="Paying with Prism at a terminal" loading="lazy" />
            <p class="pr-muted">Works with Apple Pay, Google Pay and the Prism band. Limits update in real time, right here.</p>
            <div class="pr-limits">
              <div><p class="pr-muted">Daily limit</p><p class="pr-strong">$2,500</p></div>
              <div><p class="pr-muted">Online</p><p class="pr-strong">$5,000</p></div>
              <div><p class="pr-muted">ATM</p><p class="pr-strong">$800</p></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ACTIVITY -->
      <section class="pr-view" data-view="activity" aria-label="Activity" hidden>
        <div class="glass pr-panel">
          <div class="pr-panel-head"><h2>All activity</h2>
            <div class="pr-filters" role="group" aria-label="Filter transactions">
              <button type="button" class="pr-chip is-on" data-filter="all">All</button>
              <button type="button" class="pr-chip" data-filter="in">Money in</button>
              <button type="button" class="pr-chip" data-filter="out">Money out</button>
            </div>
          </div>
          <ul class="pr-txns" id="txn-list">
            <li data-type="in"><img src={IMG.ava1} alt="" /><div><p>Salary · Studio Nord</p><p class="pr-muted">Oct 1</p></div><span class="pr-amt in">+$4,200.00</span></li>
            <li data-type="out"><img src={IMG.ava3} alt="" /><div><p>Léa Tremblay</p><p class="pr-muted">Concert tickets · Oct 2</p></div><span class="pr-amt out">−$142.50</span></li>
            <li data-type="in"><img src={IMG.ava2} alt="" /><div><p>Marcus Webb</p><p class="pr-muted">Dinner split · Oct 2</p></div><span class="pr-amt in">+$86.00</span></li>
            <li data-type="out"><div class="pr-ava-fallback" aria-hidden="true">☕</div><div><p>Café Pista</p><p class="pr-muted">Oct 3</p></div><span class="pr-amt out">−$6.40</span></li>
            <li data-type="out"><div class="pr-ava-fallback" aria-hidden="true">◈</div><div><p>STM monthly pass</p><p class="pr-muted">Oct 3</p></div><span class="pr-amt out">−$97.00</span></li>
            <li data-type="in"><div class="pr-ava-fallback" aria-hidden="true">✦</div><div><p>Interest · savings vault</p><p class="pr-muted">Oct 4</p></div><span class="pr-amt in">+$12.18</span></li>
          </ul>
        </div>
      </section>

      <!-- INSIGHTS -->
      <section class="pr-view" data-view="insights" aria-label="Insights" hidden>
        <div class="pr-cols">
          <div class="glass pr-panel">
            <div class="pr-panel-head"><h2>October so far</h2><span class="pr-pill">$1,982 spent</span></div>
            <div class="pr-bars">
              <div class="pr-bar-row"><span>Groceries</span><div class="pr-bar"><i style="width:72%"></i></div><b>$486</b></div>
              <div class="pr-bar-row"><span>Transport</span><div class="pr-bar"><i style="width:38%"></i></div><b>$254</b></div>
              <div class="pr-bar-row"><span>Going out</span><div class="pr-bar"><i style="width:55%"></i></div><b>$371</b></div>
              <div class="pr-bar-row"><span>Home</span><div class="pr-bar"><i style="width:84%"></i></div><b>$562</b></div>
              <div class="pr-bar-row"><span>Other</span><div class="pr-bar"><i style="width:29%"></i></div><b>$309</b></div>
            </div>
          </div>
          <div class="glass pr-panel pr-shot">
            <div class="pr-panel-head"><h2>In your pocket</h2></div>
            <img src={IMG.phone} alt="Prism app on a phone" loading="lazy" />
            <p class="pr-muted">Vaults round up every purchase. You are $214 from the Lisbon trip fund.</p>
            <a class="pr-cta" href="#app" data-goto="overview">Back to overview</a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <EscapeHatch locale="en" />

  <style>
    .pr { --ink: #16161f; --mut: #6b6b7d; --vio: #7c5cff; --teal: #2dd4bf; --glass: rgba(255,255,255,.62); --line: rgba(22,22,31,.09); font-family: "Plus Jakarta Sans", system-ui, sans-serif; color: var(--ink); margin: 0; min-height: 100vh; }
    .pr * { box-sizing: border-box; }
    .pr img { display: block; max-width: 100%; }
    .pr .glass { background: var(--glass); backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3); border: 1px solid rgba(255,255,255,.7); box-shadow: 0 12px 40px rgba(90,80,180,.12); border-radius: 20px; }
    .pr .pr-muted { color: var(--mut); font-size: 13px; margin: 2px 0 0; }
    .pr .pr-label { font-size: 13px; font-weight: 600; color: var(--mut); margin: 0 0 6px; }
    .pr .pr-bignum { font-size: clamp(34px, 5vw, 48px); font-weight: 800; letter-spacing: -0.03em; margin: 0; font-variant-numeric: tabular-nums; }
    .pr .pr-wordmark { font-weight: 800; font-size: 26px; letter-spacing: -0.03em; margin: 0; background: linear-gradient(120deg, var(--vio), var(--teal)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    .pr-bg { position: fixed; inset: 0; z-index: -1; background: #eef0fb; overflow: hidden; }
    .pr-blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55; }
    .pr-blob-a { width: 520px; height: 520px; background: #c7b8ff; top: -140px; left: -120px; }
    .pr-blob-b { width: 460px; height: 460px; background: #a8ecdf; bottom: -160px; right: -100px; }
    .pr-blob-c { width: 340px; height: 340px; background: #ffd6e8; top: 38%; left: 44%; }

    /* gate */
    .pr-gate { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(238,240,251,.6); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); transition: opacity .5s ease, visibility .5s; }
    .pr-gate.is-open { opacity: 0; visibility: hidden; pointer-events: none; }
    .pr-gate-card { text-align: center; background: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.9); border-radius: 28px; padding: 40px 44px; box-shadow: 0 30px 80px rgba(90,80,180,.22); max-width: 360px; width: 100%; }
    .pr-gate-title { font-size: 24px; letter-spacing: -0.02em; margin: 14px 0 4px; }
    .pr-gate-sub { color: var(--mut); font-size: 14px; margin: 0 0 20px; }
    .pr-dots { display: flex; gap: 12px; justify-content: center; margin-bottom: 22px; }
    .pr-dots span { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #c9c9d8; transition: background .15s, border-color .15s; }
    .pr-dots span.on { background: var(--vio); border-color: var(--vio); }
    .pr-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
    .pr-pad button { font-family: inherit; font-size: 20px; font-weight: 700; padding: 14px 0; border-radius: 16px; border: 1px solid var(--line); background: rgba(255,255,255,.7); cursor: pointer; color: var(--ink); }
    .pr-pad button:hover { background: #fff; }
    .pr-pad button:active { transform: scale(.96); }
    .pr-skip { background: none; border: 0; color: var(--vio); font-weight: 700; font-size: 14px; cursor: pointer; font-family: inherit; }
    .pr-gate-note { font-size: 12px; color: var(--mut); margin: 14px 0 0; }

    /* app shell */
    .pr-app { display: grid; grid-template-columns: 230px 1fr; gap: 22px; max-width: 1180px; margin: 0 auto; padding: 26px 22px 90px; min-height: 100vh; }
    .pr-app[aria-hidden="true"] { filter: blur(6px); }
    .pr-side { background: rgba(22,22,35,.78); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-radius: 24px; padding: 26px 18px; display: flex; flex-direction: column; gap: 26px; color: #fff; position: sticky; top: 26px; align-self: start; height: calc(100vh - 52px); }
    .pr-wordmark-side { font-size: 22px; padding: 0 8px; }
    .pr-nav { display: flex; flex-direction: column; gap: 6px; }
    .pr-navbtn { display: flex; align-items: center; gap: 12px; background: none; border: 0; color: #b9b9cc; font-family: inherit; font-size: 15px; font-weight: 600; padding: 12px 14px; border-radius: 14px; cursor: pointer; text-align: left; width: 100%; }
    .pr-navbtn:hover { background: rgba(255,255,255,.08); color: #fff; }
    .pr-navbtn.is-active { background: rgba(124,92,255,.28); color: #fff; }
    .pr-ico { font-size: 18px; width: 22px; text-align: center; }
    .pr-user { margin-top: auto; display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(255,255,255,.07); border-radius: 16px; }
    .pr-user img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    .pr-user-name { margin: 0; font-weight: 700; font-size: 14px; }
    .pr-user-plan { margin: 2px 0 0; font-size: 12px; color: #b9b9cc; }

    .pr-main { min-width: 0; }
    .pr-view { display: grid; gap: 18px; }
    .pr-view[hidden] { display: none; }
    .pr-balance { padding: 30px 32px; display: flex; justify-content: space-between; align-items: center; gap: 20px; overflow: hidden; }
    .pr-delta { color: #0d9b6c; font-weight: 700; font-size: 14px; margin: 8px 0 0; }
    .pr-spark { width: 220px; height: 70px; flex-shrink: 0; }
    .pr-actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .pr-action { border: 1px solid rgba(255,255,255,.7); padding: 16px; font-family: inherit; font-size: 14px; font-weight: 700; color: var(--ink); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .pr-action:hover { background: rgba(255,255,255,.85); }
    .pr-action span { font-size: 16px; }
    .pr-cols { display: grid; grid-template-columns: 1.25fr 1fr; gap: 18px; align-items: start; }
    .pr-panel { padding: 24px; }
    .pr-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .pr-panel-head h2 { font-size: 17px; letter-spacing: -0.01em; margin: 0; }
    .pr-link { background: none; border: 0; color: var(--vio); font-weight: 700; font-size: 13px; cursor: pointer; font-family: inherit; }
    .pr-txns { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
    .pr-txns li { display: flex; align-items: center; gap: 12px; padding: 10px 6px; border-radius: 12px; }
    .pr-txns li:hover { background: rgba(255,255,255,.6); }
    .pr-txns img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; }
    .pr-ava-fallback { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #e3dcff, #c9f2ea); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .pr-txns p { margin: 0; font-weight: 600; font-size: 14px; }
    .pr-amt { margin-left: auto; font-weight: 800; font-variant-numeric: tabular-nums; font-size: 14px; }
    .pr-amt.in { color: #0d9b6c; } .pr-amt.out { color: var(--ink); }
    .pr-shot img { width: 100%; border-radius: 14px; margin-bottom: 12px; }
    .pr-payimg { height: 190px; object-fit: cover; }
    .pr-pill { background: rgba(13,155,108,.14); color: #0d9b6c; font-size: 12px; font-weight: 800; padding: 6px 12px; border-radius: 999px; }
    .pr-pill.is-frozen { background: rgba(217,72,59,.14); color: #d9483b; }

    .pr-cardart { border-radius: 20px; padding: 26px; color: #fff; background: linear-gradient(120deg, #3b2f7a, #7c5cff 55%, #2dd4bf); min-height: 190px; display: flex; flex-direction: column; justify-content: space-between; margin-bottom: 16px; transition: filter .3s, opacity .3s; }
    .pr-cardart.is-frozen { filter: grayscale(.8); opacity: .75; }
    .pr-cardart-brand { font-weight: 800; font-size: 20px; margin: 0; letter-spacing: -0.02em; }
    .pr-cardart-num { font-size: 17px; letter-spacing: .14em; margin: 26px 0 6px; font-variant-numeric: tabular-nums; }
    .pr-cardart-name { font-size: 12px; letter-spacing: .2em; margin: 0; opacity: .85; }
    .pr-cardrow { display: flex; gap: 12px; flex-wrap: wrap; }
    .pr-toggle { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--line); background: rgba(255,255,255,.7); border-radius: 999px; padding: 10px 16px 10px 10px; font-family: inherit; font-weight: 700; font-size: 14px; cursor: pointer; color: var(--ink); }
    .pr-knob { width: 40px; height: 24px; border-radius: 999px; background: #c9c9d8; position: relative; transition: background .2s; }
    .pr-knob::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left .2s; box-shadow: 0 1px 4px rgba(0,0,0,.25); }
    .pr-toggle[aria-pressed="true"] .pr-knob { background: #d9483b; }
    .pr-toggle[aria-pressed="true"] .pr-knob::after { left: 19px; }
    .pr-limits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
    .pr-limits > div { background: rgba(255,255,255,.55); border-radius: 12px; padding: 12px; }
    .pr-strong { font-weight: 800; margin: 2px 0 0; font-variant-numeric: tabular-nums; }

    .pr-filters { display: flex; gap: 8px; }
    .pr-chip { border: 1px solid var(--line); background: rgba(255,255,255,.6); border-radius: 999px; padding: 8px 14px; font-family: inherit; font-size: 13px; font-weight: 700; color: var(--mut); cursor: pointer; }
    .pr-chip.is-on { background: var(--ink); color: #fff; border-color: var(--ink); }

    .pr-bars { display: grid; gap: 14px; }
    .pr-bar-row { display: grid; grid-template-columns: 90px 1fr 52px; align-items: center; gap: 12px; font-size: 14px; }
    .pr-bar-row span { color: var(--mut); font-weight: 600; }
    .pr-bar-row b { text-align: right; font-variant-numeric: tabular-nums; }
    .pr-bar { height: 12px; border-radius: 999px; background: rgba(22,22,31,.08); overflow: hidden; }
    .pr-bar i { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--vio), var(--teal)); }
    .pr-cta { display: inline-block; margin-top: 12px; color: var(--vio); font-weight: 700; font-size: 14px; text-decoration: none; }

    @media (max-width: 900px) {
      .pr-app { grid-template-columns: 1fr; padding-bottom: 120px; }
      .pr-side { position: fixed; z-index: 60; left: 12px; right: 12px; bottom: 12px; top: auto; height: auto; flex-direction: row; align-items: center; padding: 10px 12px; gap: 6px; border-radius: 22px; }
      .pr-wordmark-side, .pr-user { display: none; }
      .pr-nav { flex-direction: row; width: 100%; justify-content: space-around; }
      .pr-navbtn { flex-direction: column; gap: 4px; font-size: 11px; padding: 8px 6px; align-items: center; }
      .pr-cols { grid-template-columns: 1fr; }
      .pr-actions { grid-template-columns: repeat(2, 1fr); }
      .pr-balance { flex-direction: column; align-items: flex-start; }
      .pr-bar-row { grid-template-columns: 76px 1fr 48px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pr * { transition: none !important; }
    }
  </style>

  <script>
    (function () {
      var gate = document.getElementById('gate') as HTMLElement | null;
      var app = document.getElementById('app') as HTMLElement | null;
      var dots = Array.prototype.slice.call(document.querySelectorAll('.pr-dots span'));
      var pin = '';
      function paintDots() { dots.forEach(function (d, i) { d.classList.toggle('on', i < pin.length); }); }
      function openApp() {
        gate?.classList.add('is-open');
        app?.setAttribute('aria-hidden', 'false');
        setTimeout(function () { if (gate) gate.style.display = 'none'; }, 600);
      }
      document.querySelectorAll('.pr-pad button').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var v = btn.getAttribute('data-pin');
          if (v === 'skip') { openApp(); return; }
          if (v === 'clear') { pin = pin.slice(0, -1); paintDots(); return; }
          if (pin.length < 4) { pin += v; paintDots(); }
          if (pin.length === 4) { setTimeout(openApp, 250); }
        });
      });
      document.getElementById('gate-skip')?.addEventListener('click', openApp);

      // View switching
      var navBtns = document.querySelectorAll('.pr-navbtn');
      var views = document.querySelectorAll('.pr-view');
      function showView(name: string) {
        navBtns.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-view') === name); });
        views.forEach(function (v) {
          var on = v.getAttribute('data-view') === name;
          v.classList.toggle('is-active', on);
          if (on) { v.removeAttribute('hidden'); } else { v.setAttribute('hidden', ''); }
        });
      }
      navBtns.forEach(function (b) { b.addEventListener('click', function () { showView(b.getAttribute('data-view') || 'overview'); }); });
      document.querySelectorAll('[data-goto]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.preventDefault(); showView(el.getAttribute('data-goto') || 'overview'); });
      });

      // Freeze card
      var freezeBtn = document.getElementById('freeze-btn') as HTMLButtonElement | null;
      var cardArt = document.getElementById('card-art');
      var pill = document.getElementById('freeze-pill');
      freezeBtn?.addEventListener('click', function () {
        if (!freezeBtn) return;
        var frozen = freezeBtn.getAttribute('aria-pressed') === 'true';
        freezeBtn.setAttribute('aria-pressed', String(!frozen));
        cardArt?.classList.toggle('is-frozen', !frozen);
        if (pill) { pill.textContent = frozen ? 'Active' : 'Frozen'; pill.classList.toggle('is-frozen', !frozen); }
      });

      // Activity filters
      var chips = document.querySelectorAll('.pr-chip');
      var rows = document.querySelectorAll('#txn-list li') as NodeListOf<HTMLElement>;
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          chips.forEach(function (c) { c.classList.remove('is-on'); });
          chip.classList.add('is-on');
          var f = chip.getAttribute('data-filter');
          rows.forEach(function (r) {
            r.style.display = (f === 'all' || r.getAttribute('data-type') === f) ? '' : 'none';
          });
        });
      });
    })();
  </script>
</body>
</html>
