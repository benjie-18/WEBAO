---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Verte · zero-waste grocery, Montréal QC.
// Rebuilt as a MARKET STALL: the header IS the weekly harvest board,
// products sit in a dense irregular market grid with chalk price tags,
// and the philosophy is a hand-painted sign. Standalone art direction.
const IMG = {
  hero: "/demos/verte/01.jpg",
  tomatoes: "https://images.unsplash.com/photo-1488459716781-31db52582fe9?q=80&w=800&auto=format&fit=crop",
  bread: "https://images.pexels.com/photos/543276/pexels-photo-543276.jpeg?auto=compress&cs=tinysrgb&w=800",
  greens: "https://images.pexels.com/photos/2280567/pexels-photo-2280567.jpeg?auto=compress&cs=tinysrgb&w=800",
  fruit: "https://images.pexels.com/photos/18624831/pexels-photo-18624831.jpeg?auto=compress&cs=tinysrgb&w=800",
  salad: "https://images.unsplash.com/photo-1540420773420-3366772f4999?q=80&w=800&auto=format&fit=crop",
  prep: "https://images.unsplash.com/photo-1498837167922-ddd27525d352?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verte · Zero-waste grocery · Montréal</title>
  <meta name="description" content="Verte: a zero-waste market stall on King Ouest. This week's harvest, bulk goods, bring your own jars." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Caveat:wght@600;700&family=Karla:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="vt">

  <header class="vt-top">
    <div class="vt-wrap vt-top-in">
      <a class="vt-logo" href="#top">Verte<span class="vt-logo-leaf" aria-hidden="true">.</span></a>
      <nav class="vt-links" aria-label="Primary">
        <a href="#harvest">This week</a>
        <a href="#stall">The stall</a>
        <a href="#sign">Why</a>
        <a href="#visit">Visit</a>
      </nav>
      <a class="vt-btn vt-btn-sm" href="#visit">Reserve a basket</a>
    </div>
  </header>

  <main id="top">

    <!-- THE HEADER IS THE HARVEST BOARD: an A-frame chalkboard, no hero -->
    <div class="vt-wrap">
      <section class="vt-board" aria-labelledby="harvest-title">
        <div class="vt-board-frame">
          <p class="vt-chalk vt-board-week">Week of October 5</p>
          <h1 class="vt-chalk vt-board-title" id="harvest-title">This week<br />at the stall</h1>
          <ul class="vt-chalk vt-board-list">
            <li>Heirloom tomatoes, last of the season</li>
            <li>Macintosh apples, first crates</li>
            <li>Rainbow chard + kale, cut this morning</li>
            <li>Sourdough Friday, preorder by Thursday</li>
          </ul>
          <p class="vt-chalk vt-board-foot">Everything unpackaged. Bring a jar, a bag, a basket, or borrow ours.</p>
        </div>
      </section>
    </div>

    <!-- THE STALL: dense irregular market grid, chalk price tags -->
    <section class="vt-stall" id="stall" aria-labelledby="stall-title">
      <div class="vt-wrap">
        <div class="vt-stall-head">
          <h2 class="vt-h2" id="stall-title">On the tables today</h2>
          <p class="vt-stall-note">Prices change with the harvest. What is gone is gone.</p>
        </div>
        <div class="vt-grid">
          <article class="vt-item vt-item-tall">
            <img src={IMG.tomatoes} alt="Heirloom tomatoes in wooden crates" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">Heirloom tomatoes</span><span class="vt-tag-price">$4.90 / kg</span></div>
          </article>
          <article class="vt-item">
            <img src={IMG.bread} alt="Sourdough loaves on a bakery shelf" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">Sourdough, baked Fri</span><span class="vt-tag-price">$7.50</span></div>
          </article>
          <article class="vt-item">
            <img src={IMG.greens} alt="Fresh leafy greens" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">Rainbow chard</span><span class="vt-tag-price">$3.20 / bunch</span></div>
          </article>
          <article class="vt-item vt-item-wide">
            <img src={IMG.hero} alt="Market produce laid out on the stall" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">The morning haul</span><span class="vt-tag-price">by weight</span></div>
          </article>
          <article class="vt-item">
            <img src={IMG.fruit} alt="Seasonal fruit" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">Macintosh apples</span><span class="vt-tag-price">$3.80 / kg</span></div>
          </article>
          <article class="vt-item vt-item-tall">
            <img src={IMG.salad} alt="Fresh salad greens" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">Salad mix, cut today</span><span class="vt-tag-price">$5.40 / bag</span></div>
          </article>
          <article class="vt-item vt-item-wide">
            <img src={IMG.prep} alt="Vegetables being prepped in the back kitchen" loading="lazy" />
            <div class="vt-tag"><span class="vt-tag-name">Soup of the day, jarred</span><span class="vt-tag-price">$8.00 / jar</span></div>
          </article>
        </div>
        <p class="vt-jar">No jar? Borrow one from the shelf, bring it back whenever. <span class="vt-jar-free">Free, obviously.</span></p>
      </div>
    </section>

    <!-- PHILOSOPHY: a hand-painted shop sign -->
    <section class="vt-signwrap" id="sign" aria-label="Our philosophy">
      <div class="vt-wrap">
        <div class="vt-sign">
          <p class="vt-hand vt-sign-line1">nothing wrapped.</p>
          <p class="vt-hand vt-sign-line2">nothing wasted.</p>
          <p class="vt-sign-small">We buy from 14 Québec farms, take it all unpackaged, and compost what does not sell. The bin behind the counter has been empty for 6 years.</p>
        </div>
      </div>
    </section>

    <!-- VISIT: a pinned paper note + basket reservation -->
    <section class="vt-visit" id="visit" aria-labelledby="visit-title">
      <div class="vt-wrap vt-visit-grid">
        <div class="vt-note">
          <span class="vt-pin" aria-hidden="true"></span>
          <h2 class="vt-h2" id="visit-title">Find the stall</h2>
          <p class="vt-note-line"><strong>4821 King Ouest</strong>, Montréal</p>
          <p class="vt-note-line">Tue to Fri · 9:00 to 19:00<br />Sat · 8:00 to 17:00<br />Sun + Mon · the stall rests</p>
          <p class="vt-note-line vt-note-small">Metro Lionel-Groulx, then a 6-minute walk past the good bakery.</p>
        </div>
        <form class="vt-form" id="basket-form">
          <h3 class="vt-form-title">Reserve a Friday basket</h3>
          <p class="vt-form-sub">$35 of whatever is best that week. We pack it, you pick it up.</p>
          <label>Name<input type="text" name="name" required autocomplete="name" /></label>
          <label>Friday pickup<select name="friday"><option>Oct 10</option><option>Oct 17</option><option>Oct 24</option></select></label>
          <label class="vt-check"><input type="checkbox" name="sourdough" checked /> Add the Friday sourdough (+$7.50)</label>
          <button class="vt-btn vt-btn-full" type="submit">Reserve my basket</button>
          <p class="vt-form-done" id="basket-done" hidden>Done. Your basket will be waiting Friday after 14:00.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="vt-foot">
    <div class="vt-wrap vt-foot-in">
      <p>Verte · fictitious demo site · zero waste since 2018</p>
      <p>bonjour@verte.example · (514) 555-0182</p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <style>
    .vt { --paper: #f6f0dd; --paper2: #efe6cc; --ink: #2b2417; --mut: #6f6350; --board: #243020; --chalk: #f2ecd9; --green: #3f6b34; --tomato: #c2452d; --hand: "Caveat", cursive; --disp: "Fraunces", serif; --body: "Karla", system-ui, sans-serif; background: var(--paper); color: var(--ink); font-family: var(--body); margin: 0; min-height: 100vh; }
    .vt * { box-sizing: border-box; }
    .vt img { display: block; max-width: 100%; }
    .vt .vt-wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
    .vt .vt-h2 { font-family: var(--disp); font-weight: 900; font-size: clamp(28px, 4vw, 42px); letter-spacing: -0.01em; margin: 0; }
    .vt .vt-hand { font-family: var(--hand); }
    .vt .vt-btn { display: inline-block; background: var(--green); color: #fff; font-weight: 700; font-size: 15px; padding: 12px 22px; border-radius: 999px; text-decoration: none; border: 0; cursor: pointer; font-family: var(--body); }
    .vt .vt-btn:hover { background: #2f5227; }
    .vt .vt-btn-sm { padding: 9px 17px; font-size: 13px; }
    .vt .vt-btn-full { width: 100%; }

    .vt-top { position: sticky; top: 0; z-index: 50; background: rgba(246,240,221,.95); backdrop-filter: blur(6px); border-bottom: 2px solid var(--ink); }
    .vt-top-in { display: flex; align-items: center; gap: 22px; padding-top: 12px; padding-bottom: 12px; }
    .vt-logo { font-family: var(--disp); font-weight: 900; font-size: 24px; color: var(--ink); text-decoration: none; margin-right: auto; }
    .vt-logo-leaf { color: var(--green); }
    .vt-links { display: flex; gap: 20px; }
    .vt-links a { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 14px; }
    .vt-links a:hover { color: var(--green); }

    /* harvest board = the header */
    .vt-board { margin: 34px auto 0; max-width: 860px; transform: rotate(-.6deg); }
    .vt-board-frame { background: var(--board); border: 12px solid #4a3826; border-radius: 8px; padding: clamp(26px, 5vw, 52px); box-shadow: 0 20px 50px rgba(43,36,23,.35); position: relative; }
    .vt-chalk { color: var(--chalk); text-shadow: 0 1px 0 rgba(255,255,255,.12); margin: 0; }
    .vt-board-week { font-family: var(--hand); font-size: 24px; color: #e8c86a; transform: rotate(-2deg); display: inline-block; }
    .vt-board-title { font-family: var(--disp); font-weight: 900; font-size: clamp(40px, 7vw, 72px); line-height: .95; letter-spacing: -0.02em; margin: 10px 0 18px; }
    .vt-board-list { list-style: none; padding: 0; font-size: clamp(16px, 2.4vw, 20px); line-height: 1.9; font-weight: 500; }
    .vt-board-list li::before { content: "✳ "; color: #a9c795; }
    .vt-board-foot { margin-top: 18px; font-family: var(--hand); font-size: 22px; color: #cfd8bd; }

    /* the stall: dense irregular grid */
    .vt-stall { margin-top: 70px; }
    .vt-stall-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 22px; }
    .vt-stall-note { font-family: var(--hand); font-size: 21px; color: var(--mut); margin: 0; transform: rotate(-1deg); }
    .vt-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 190px; gap: 10px; }
    .vt-item { position: relative; overflow: hidden; border-radius: 6px; background: var(--paper2); }
    .vt-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .vt-item:hover img { transform: scale(1.05); }
    .vt-item-tall { grid-row: span 2; }
    .vt-item-wide { grid-column: span 2; }
    .vt-tag { position: absolute; left: 10px; bottom: 10px; background: var(--board); color: var(--chalk); border-radius: 4px; padding: 8px 12px; transform: rotate(-1.5deg); box-shadow: 0 4px 12px rgba(0,0,0,.3); display: flex; flex-direction: column; gap: 2px; }
    .vt-tag-name { font-family: var(--hand); font-size: 19px; line-height: 1; }
    .vt-tag-price { font-family: var(--body); font-weight: 700; font-size: 14px; color: #e8c86a; }
    .vt-jar { font-family: var(--hand); font-size: 23px; color: var(--mut); margin: 20px 0 0; }
    .vt-jar-free { color: var(--tomato); font-weight: 700; }

    /* hand-painted sign */
    .vt-signwrap { margin-top: 80px; }
    .vt-sign { background: #31456b; background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.03) 0 90px, transparent 90px 180px); border-radius: 10px; padding: clamp(36px, 6vw, 70px) clamp(24px, 5vw, 60px); text-align: center; box-shadow: 0 20px 50px rgba(43,36,23,.3); transform: rotate(.5deg); }
    .vt-sign-line1, .vt-sign-line2 { color: #f5edd6; font-weight: 700; font-size: clamp(44px, 8vw, 88px); line-height: 1; margin: 0; text-shadow: 2px 2px 0 rgba(0,0,0,.25); }
    .vt-sign-line2 { color: #ffd98a; }
    .vt-sign-small { color: #d9d2bd; max-width: 52ch; margin: 22px auto 0; font-size: 16px; line-height: 1.65; }

    /* visit */
    .vt-visit { margin: 80px 0 90px; }
    .vt-visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-items: start; }
    .vt-note { position: relative; background: #fffdf4; padding: 34px 30px; border-radius: 3px; box-shadow: 0 14px 34px rgba(43,36,23,.22); transform: rotate(-1.2deg); }
    .vt-pin { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); width: 22px; height: 22px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ff9d8a, var(--tomato) 60%, #7e2313); box-shadow: 0 3px 6px rgba(0,0,0,.35); }
    .vt-note .vt-h2 { font-size: clamp(24px, 3vw, 32px); margin-bottom: 14px; }
    .vt-note-line { font-size: 16px; line-height: 1.7; margin: 0 0 12px; }
    .vt-note-small { color: var(--mut); font-size: 14px; }
    .vt-form { background: var(--board); color: var(--chalk); border-radius: 10px; padding: 32px 30px; display: grid; gap: 14px; transform: rotate(.8deg); box-shadow: 0 14px 34px rgba(43,36,23,.3); }
    .vt-form-title { font-family: var(--disp); font-weight: 900; font-size: 24px; margin: 0; }
    .vt-form-sub { margin: 0; color: #cfd8bd; font-size: 15px; }
    .vt-form label { display: grid; gap: 7px; font-size: 13px; font-weight: 700; }
    .vt-form input[type="text"], .vt-form select { font-family: var(--body); font-size: 15px; padding: 11px 12px; border-radius: 7px; border: 1px solid #4a5a44; background: #1c2618; color: var(--chalk); width: 100%; }
    .vt-check { display: flex !important; flex-direction: row !important; align-items: center; gap: 10px; font-weight: 500 !important; }
    .vt-check input { width: 18px; height: 18px; accent-color: var(--green); }
    .vt-form-done { color: #e8c86a; font-family: var(--hand); font-size: 22px; margin: 4px 0 0; }

    .vt-foot { border-top: 2px solid var(--ink); padding: 22px 0 60px; }
    .vt-foot-in { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .vt-foot p { margin: 0; font-size: 14px; color: var(--mut); }

    @media (max-width: 860px) {
      .vt-links { display: none; }
      .vt-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 170px; }
      .vt-visit-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .vt * { transition: none !important; }
    }
  </style>

  <script>
    (function () {
      var form = document.getElementById('basket-form') as HTMLFormElement | null;
      var done = document.getElementById('basket-done');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        if (done) done.hidden = false;
        form?.reset();
      });
    })();
  </script>
</body>
</html>
