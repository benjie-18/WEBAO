---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";

// Demo microsite: Lune Fitness, fictional crossfit gym, Trois-Rivières.
// Standalone art direction. After-dark neon. Not connected to the WEBAO theme system.
const IMG = {
  hero: "/demos/lune/01.jpg",
  gym: "/demos/lune/02.jpg",
  weights: "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=800&auto=format&fit=crop",
  workout: "https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?q=80&w=800&auto=format&fit=crop",
  barbell: "https://images.unsplash.com/photo-1526506118085-60ce8714f8c5?q=80&w=800&auto=format&fit=crop",
  deadlift: "https://images.unsplash.com/photo-1605296867304-46d5465a13f1?q=80&w=800&auto=format&fit=crop",
  training: "https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lune Fitness: CrossFit in Trois-Rivières</title>
  <meta name="description" content="Lune Fitness: Trois-Rivières' after-dark CrossFit box. 5:30am classes, Hyrox prep, open gym till midnight. First week free." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="lf">

  <!-- NAV -->
  <header class="lf-navwrap">
    <nav class="lf-nav" aria-label="Primary">
      <a class="lf-logo" href="#top" aria-label="Lune Fitness, home">LUNE<span class="lf-dot" aria-hidden="true"></span></a>
      <div class="lf-nav-links">
        <a href="#programs">Programs</a>
        <a href="#schedule">Schedule</a>
        <a href="#coaches">Coaches</a>
      </div>
      <a class="lf-btn-volt lf-btn-small" href="#trial">First week free</a>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="lf-hero">
      <div class="lf-hero-bg" aria-hidden="true">
        <img src={IMG.hero} alt="Dark gym glowing with cyan neon lights at night" loading="eager" fetchpriority="high" />
      </div>
      <div class="lf-hero-in">
        <p class="lf-eyebrow">CROSSFIT BOX · TROIS-RIVIÈRES · OPEN TILL MIDNIGHT</p>
        <h1 class="lf-h1">TRAIN<br /><span class="lf-volt">AFTER</span> DARK</h1>
        <p class="lf-lede">The box that never sleeps. Barbells at 5:30am, Hyrox prep at lunch, open gym till midnight. Loud music, chalk everywhere, zero mirrors.</p>
        <div class="lf-hero-cta">
          <a class="lf-btn-volt" href="#trial">Claim your free week</a>
          <a class="lf-btn-ghost" href="#schedule">See the schedule</a>
        </div>
      </div>
      <div class="lf-ticker" aria-hidden="true">
        <div class="lf-ticker-track">
          <span>NO MIRRORS</span><span>✦</span><span>CHALK EVERYWHERE</span><span>✦</span><span>5:30 AM CLUB</span><span>✦</span><span>HYROX PREP</span><span>✦</span><span>OPEN GYM TILL MIDNIGHT</span><span>✦</span>
          <span>NO MIRRORS</span><span>✦</span><span>CHALK EVERYWHERE</span><span>✦</span><span>5:30 AM CLUB</span><span>✦</span><span>HYROX PREP</span><span>✦</span><span>OPEN GYM TILL MIDNIGHT</span><span>✦</span>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="lf-stats">
      <div><strong>850</strong><span>members strong</span></div>
      <div><strong>14</strong><span>coaches on floor</span></div>
      <div><strong>1400</strong><span>m² of iron</span></div>
      <div><strong>05:30</strong><span>first class daily</span></div>
    </section>

    <!-- PROGRAMS -->
    <section class="lf-section" id="programs">
      <div class="lf-wrap">
        <p class="lf-kicker">/// Pick your poison</p>
        <h2 class="lf-h2">Three ways<br />to suffer <span class="lf-volt">happily</span></h2>
        <div class="lf-programs">
          <article class="lf-prog">
            <span class="lf-prog-n" aria-hidden="true">01</span>
            <div>
              <h3>CrossFit</h3>
              <p>The classic. Constantly varied, coach-led, 60 minutes. Scales to every level, humbles every ego. First-timers start with our 3-session On-Ramp.</p>
              <p class="lf-prog-meta">60 MIN · ALL LEVELS · 32 CLASSES / WEEK</p>
            </div>
            <img src={IMG.barbell} alt="Athlete lifting a loaded barbell" loading="lazy" />
          </article>
          <article class="lf-prog">
            <span class="lf-prog-n" aria-hidden="true">02</span>
            <div>
              <h3>Hyrox Prep</h3>
              <p>Eight stations, one brutal race. Our 8-week prep cycle builds your engine with sleds, wall balls, and running intervals that bite back.</p>
              <p class="lf-prog-meta">75 MIN · INTERMEDIATE · 8-WEEK CYCLES</p>
            </div>
            <img src={IMG.deadlift} alt="Athlete mid-deadlift in a dark gym" loading="lazy" />
          </article>
          <article class="lf-prog">
            <span class="lf-prog-n" aria-hidden="true">03</span>
            <div>
              <h3>Open Gym</h3>
              <p>Your program, our equipment. Fourteen racks, two rigs, a full dumbbell wall, and a coach on the floor if your form gets creative.</p>
              <p class="lf-prog-meta">05:30-24:00 · 7 DAYS · COACH ON FLOOR</p>
            </div>
            <img src={IMG.gym} alt="Empty dark gym with racks and weights" loading="lazy" />
          </article>
        </div>
      </div>
    </section>

    <!-- SCHEDULE BOARD -->
    <section class="lf-board" id="schedule">
      <div class="lf-wrap">
        <p class="lf-kicker">/// This week at Lune</p>
        <h2 class="lf-h2">The board <span class="lf-volt">never lies</span></h2>
        <div class="lf-days">
          <div class="lf-day">
            <h3>MON</h3>
            <ul>
              <li><span>05:30</span><span>CrossFit</span></li>
              <li><span>12:15</span><span>Express 30</span></li>
              <li><span>17:30</span><span>Hyrox Prep</span></li>
              <li><span>19:00</span><span>Open Gym</span></li>
            </ul>
          </div>
          <div class="lf-day">
            <h3>TUE</h3>
            <ul>
              <li><span>05:30</span><span>CrossFit</span></li>
              <li><span>12:15</span><span>Weightlifting</span></li>
              <li><span>17:30</span><span>CrossFit</span></li>
              <li><span>19:00</span><span>Open Gym</span></li>
            </ul>
          </div>
          <div class="lf-day">
            <h3>WED</h3>
            <ul>
              <li><span>05:30</span><span>Hyrox Prep</span></li>
              <li><span>12:15</span><span>Express 30</span></li>
              <li><span>17:30</span><span>CrossFit</span></li>
              <li><span>19:00</span><span>Mobility</span></li>
            </ul>
          </div>
          <div class="lf-day">
            <h3>THU</h3>
            <ul>
              <li><span>05:30</span><span>CrossFit</span></li>
              <li><span>12:15</span><span>Weightlifting</span></li>
              <li><span>17:30</span><span>Hyrox Prep</span></li>
              <li><span>19:00</span><span>Open Gym</span></li>
            </ul>
          </div>
          <div class="lf-day">
            <h3>FRI</h3>
            <ul>
              <li><span>05:30</span><span>CrossFit</span></li>
              <li><span>12:15</span><span>Express 30</span></li>
              <li><span>17:30</span><span>Friday Night Lights</span></li>
              <li><span>20:00</span><span>Open Gym</span></li>
            </ul>
          </div>
          <div class="lf-day lf-day-weekend">
            <h3>SAT</h3>
            <ul>
              <li><span>09:00</span><span>Team WOD</span></li>
              <li><span>10:30</span><span>On-Ramp</span></li>
              <li><span>12:00</span><span>Open Gym</span></li>
            </ul>
          </div>
          <div class="lf-day lf-day-weekend">
            <h3>SUN</h3>
            <ul>
              <li><span>10:00</span><span>Long Engine</span></li>
              <li><span>11:30</span><span>Mobility</span></li>
              <li><span>13:00</span><span>Open Gym</span></li>
            </ul>
          </div>
        </div>
        <p class="lf-board-note">Doors open 30 minutes before the first class. Last one out kills the lights.</p>
      </div>
    </section>

    <!-- COACHES -->
    <section class="lf-section" id="coaches">
      <div class="lf-wrap">
        <p class="lf-kicker">/// The loud ones with whistles</p>
        <h2 class="lf-h2">Coached by <span class="lf-volt">maniacs</span> (certified)</h2>
        <div class="lf-coaches">
          <article class="lf-coach">
            <div class="lf-coach-img"><img src={IMG.weights} alt="Coach Marie lifting dumbbells" loading="lazy" /></div>
            <h3>Marie "Motor" Côté</h3>
            <p>Head coach. CF-L3, 9 years. Will remember your PR better than you do.</p>
          </article>
          <article class="lf-coach">
            <div class="lf-coach-img"><img src={IMG.workout} alt="Coach Sam doing battle ropes" loading="lazy" /></div>
            <h3>Sam "Sled" Bérubé</h3>
            <p>Hyrox lead. Ex-sprinter. Believes rest days are a rumor.</p>
          </article>
          <article class="lf-coach">
            <div class="lf-coach-img"><img src={IMG.training} alt="Coach Jo demonstrating a movement" loading="lazy" /></div>
            <h3>Jo "Technique" Lachance</h3>
            <p>Weightlifting nerd. Will fix your snatch and your attitude.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- TRIAL -->
    <section class="lf-trial" id="trial">
      <div class="lf-wrap lf-trial-in">
        <div>
          <p class="lf-kicker lf-kicker-dark">/// Zero risk, all chalk</p>
          <h2 class="lf-h2 lf-h2-dark">Your first week<br />is on us</h2>
          <p class="lf-trial-copy">Seven days. Every class, open gym included. A coach walks you through day one, and nobody tries to sell you anything. If you hate it, you never come back and we pretend this never happened.</p>
          <ul class="lf-trial-list">
            <li>✓ All classes, all week</li>
            <li>✓ On-Ramp intro session</li>
            <li>✓ No card required</li>
          </ul>
        </div>
        <form class="lf-form" id="lf-form" novalidate>
          <h3>Claim it</h3>
          <label>Name<input type="text" name="name" required placeholder="Alex Tremblay" /></label>
          <label>Phone<input type="tel" name="phone" required placeholder="(819) 555-0100" /></label>
          <label>Goal
            <select name="goal">
              <option>Get stronger</option>
              <option>Lose the winter</option>
              <option>Hyrox race</option>
              <option>Just curious</option>
            </select>
          </label>
          <button class="lf-btn-black" type="submit">Start my free week</button>
          <p class="lf-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="lf-footer">
    <p class="lf-footer-giant" aria-hidden="true">LUNE</p>
    <div class="lf-wrap lf-footer-in">
      <p>© 2026 Lune Fitness. Fictional demo. No PRs were harmed.</p>
      <p>77, rue Fictive, Trois-Rivières QC · <a href="tel:+18195550177">(819) 555-0177</a> · Open daily 05:30-24:00</p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo form: never submits anywhere
    (function () {
      var form = document.getElementById('lf-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.lf-form-note');
        if (note) note.textContent = 'You are in. A coach will text you within the hour to set up day one.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .lf {
      --lf-black: #0A0A0B;
      --lf-panel: #131315;
      --lf-line: #26262A;
      --lf-volt: #CCFF00;
      --lf-white: #F4F4F0;
      --lf-gray: #9A9AA0;
      --lf-display: "Anton", "Arial Narrow", sans-serif;
      --lf-body: "Inter", system-ui, sans-serif;
      margin: 0;
      background: var(--lf-black);
      color: var(--lf-white);
      font-family: var(--lf-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .lf *, .lf *::before, .lf *::after { box-sizing: border-box; }
    .lf img { display: block; max-width: 100%; }
    .lf-wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .lf-volt { color: var(--lf-volt); }

    /* nav */
    .lf-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .lf-nav {
      display: flex; align-items: center; gap: 26px;
      padding: 16px clamp(20px, 4vw, 44px);
      background: rgba(10, 10, 11, 0.82); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--lf-line);
    }
    .lf-logo {
      font-family: var(--lf-display); font-size: 30px; letter-spacing: 0.06em;
      color: var(--lf-white); text-decoration: none; display: flex; align-items: center; gap: 8px;
      margin-right: auto;
    }
    .lf-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--lf-volt); box-shadow: 0 0 14px var(--lf-volt); animation: lf-pulse 2s ease-in-out infinite; }
    @keyframes lf-pulse { 50% { opacity: 0.4; } }
    .lf-nav-links { display: flex; gap: 6px; }
    .lf-nav-links a {
      color: var(--lf-gray); text-decoration: none; font-weight: 700; font-size: 13px;
      letter-spacing: 0.18em; text-transform: uppercase; padding: 10px 14px;
    }
    .lf-nav-links a:hover { color: var(--lf-volt); }

    /* buttons */
    .lf-btn-volt, .lf-btn-ghost, .lf-btn-black {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--lf-body); font-weight: 800; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 16px 32px; text-decoration: none; cursor: pointer; border: none;
      clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .lf-btn-volt { background: var(--lf-volt); color: #0A0A0B; }
    .lf-btn-volt:hover { transform: translateY(-2px); filter: brightness(1.08); box-shadow: 0 8px 30px rgba(204, 255, 0, 0.35); }
    .lf-btn-ghost { background: transparent; color: var(--lf-white); outline: 2px solid var(--lf-line); outline-offset: -2px; }
    .lf-btn-ghost:hover { outline-color: var(--lf-volt); color: var(--lf-volt); }
    .lf-btn-black { background: #0A0A0B; color: var(--lf-volt); width: 100%; }
    .lf-btn-small { font-size: 13px; padding: 12px 24px; }

    /* type */
    .lf-kicker { font-weight: 800; font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--lf-volt); margin: 0 0 16px; }
    .lf-kicker-dark { color: #0A0A0B; }
    .lf-h1 {
      font-family: var(--lf-display); font-size: clamp(4rem, 13vw, 11rem);
      line-height: 0.9; letter-spacing: 0.01em; margin: 0 0 24px; text-transform: uppercase;
    }
    .lf-h2 {
      font-family: var(--lf-display); font-size: clamp(2.6rem, 7vw, 5.2rem);
      line-height: 0.95; text-transform: uppercase; margin: 0 0 40px;
    }
    .lf-h2-dark { color: #0A0A0B; }
    .lf-eyebrow { font-weight: 800; font-size: 12.5px; letter-spacing: 0.32em; color: var(--lf-volt); margin: 0 0 22px; }

    /* hero */
    .lf-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
    .lf-hero-bg { position: absolute; inset: 0; }
    .lf-hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.25) contrast(1.15) brightness(0.62); }
    .lf-hero-bg::after {
      content: ""; position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 90% 60% at 70% 20%, rgba(204, 255, 0, 0.14), transparent 60%),
        linear-gradient(180deg, rgba(10,10,11,0.55) 0%, rgba(10,10,11,0.1) 40%, rgba(10,10,11,0.94) 100%);
    }
    .lf-hero-in { position: relative; z-index: 2; max-width: 1200px; width: 100%; margin: 0 auto; padding: 120px clamp(20px, 4vw, 40px) 40px; }
    .lf-lede { font-size: 18px; line-height: 1.6; max-width: 46ch; color: #D8D8D2; margin: 0 0 32px; }
    .lf-hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
    .lf-ticker { position: relative; z-index: 2; background: var(--lf-volt); color: #0A0A0B; overflow: hidden; padding: 12px 0; border-block: 2px solid #0A0A0B; }
    .lf-ticker-track { display: flex; gap: 30px; width: max-content; animation: lf-tick 20s linear infinite; font-family: var(--lf-display); font-size: 20px; letter-spacing: 0.08em; }
    @keyframes lf-tick { to { transform: translateX(-50%); } }

    /* stats */
    .lf-stats {
      display: grid; grid-template-columns: repeat(4, 1fr);
      border-block: 1px solid var(--lf-line); background: var(--lf-panel);
    }
    .lf-stats div { padding: 34px 20px; text-align: center; border-left: 1px solid var(--lf-line); display: grid; gap: 6px; }
    .lf-stats div:first-child { border-left: none; }
    .lf-stats strong { font-family: var(--lf-display); font-size: clamp(2.2rem, 4.5vw, 3.6rem); color: var(--lf-volt); letter-spacing: 0.02em; }
    .lf-stats span { font-size: 12.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lf-gray); }

    /* sections */
    .lf-section { padding: clamp(70px, 9vw, 130px) 0; }

    /* programs */
    .lf-programs { display: grid; gap: 18px; }
    .lf-prog {
      display: grid; grid-template-columns: 110px 1fr 300px; gap: 30px; align-items: center;
      background: var(--lf-panel); border: 1px solid var(--lf-line); padding: 30px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .lf-prog:hover { border-color: var(--lf-volt); transform: translateX(8px); }
    .lf-prog-n { font-family: var(--lf-display); font-size: clamp(3rem, 6vw, 5rem); color: transparent; -webkit-text-stroke: 2px var(--lf-line); line-height: 1; }
    .lf-prog:hover .lf-prog-n { -webkit-text-stroke-color: var(--lf-volt); }
    .lf-prog h3 { font-family: var(--lf-display); font-size: 34px; letter-spacing: 0.03em; margin: 0 0 10px; text-transform: uppercase; }
    .lf-prog p { margin: 0 0 12px; color: #C9C9C2; font-size: 15.5px; line-height: 1.65; }
    .lf-prog-meta { font-size: 12px; font-weight: 800; letter-spacing: 0.22em; color: var(--lf-volt); }
    .lf-prog img { width: 100%; height: 190px; object-fit: cover; filter: grayscale(1) contrast(1.1); border: 1px solid var(--lf-line); }
    .lf-prog:hover img { filter: grayscale(0.2) contrast(1.05); }

    /* schedule board */
    .lf-board { background: var(--lf-panel); border-block: 1px solid var(--lf-line); padding: clamp(70px, 9vw, 130px) 0; }
    .lf-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
    .lf-day { background: var(--lf-black); border: 1px solid var(--lf-line); padding: 18px 14px; }
    .lf-day h3 {
      font-family: var(--lf-display); font-size: 20px; letter-spacing: 0.1em; margin: 0 0 14px;
      color: var(--lf-volt); border-bottom: 1px solid var(--lf-line); padding-bottom: 10px;
    }
    .lf-day-weekend h3 { color: var(--lf-white); }
    .lf-day ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .lf-day li { display: grid; gap: 2px; font-size: 13px; }
    .lf-day li span:first-child { font-weight: 800; color: var(--lf-volt); font-variant-numeric: tabular-nums; }
    .lf-day-weekend li span:first-child { color: var(--lf-gray); }
    .lf-day li span:last-child { color: #C9C9C2; font-weight: 500; }
    .lf-board-note { text-align: center; color: var(--lf-gray); font-size: 14px; margin: 30px 0 0; font-weight: 600; letter-spacing: 0.06em; }

    /* coaches */
    .lf-coaches { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .lf-coach { background: var(--lf-panel); border: 1px solid var(--lf-line); transition: transform 0.2s ease; }
    .lf-coach:hover { transform: translateY(-6px); }
    .lf-coach-img { position: relative; overflow: hidden; }
    .lf-coach-img img { width: 100%; height: 340px; object-fit: cover; filter: grayscale(1) contrast(1.12); transition: filter 0.25s ease, transform 0.25s ease; }
    .lf-coach:hover .lf-coach-img img { filter: grayscale(0) contrast(1); transform: scale(1.03); }
    .lf-coach-img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(204,255,0,0.22)); mix-blend-mode: overlay; }
    .lf-coach h3 { font-family: var(--lf-display); font-size: 24px; letter-spacing: 0.04em; margin: 0; padding: 20px 22px 6px; text-transform: uppercase; }
    .lf-coach p { margin: 0; padding: 0 22px 24px; color: var(--lf-gray); font-size: 14.5px; line-height: 1.6; }

    /* trial */
    .lf-trial { background: var(--lf-volt); color: #0A0A0B; padding: clamp(70px, 9vw, 120px) 0; }
    .lf-trial-in { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
    .lf-trial-copy { font-size: 17px; line-height: 1.65; max-width: 44ch; margin: 0 0 24px; font-weight: 500; }
    .lf-trial-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-weight: 800; font-size: 16px; letter-spacing: 0.02em; }
    .lf-form { background: #0A0A0B; padding: clamp(28px, 4vw, 44px); display: grid; gap: 16px; }
    .lf-form h3 { font-family: var(--lf-display); font-size: 30px; letter-spacing: 0.05em; color: var(--lf-volt); margin: 0; text-transform: uppercase; }
    .lf-form label { display: grid; gap: 8px; font-weight: 800; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lf-gray); }
    .lf-form input, .lf-form select {
      font-family: var(--lf-body); font-size: 16px; font-weight: 600;
      background: var(--lf-panel); border: 1px solid var(--lf-line); color: var(--lf-white);
      padding: 14px 18px; width: 100%;
    }
    .lf-form input:focus, .lf-form select:focus { outline: 2px solid var(--lf-volt); outline-offset: 2px; }
    .lf-form-note { margin: 0; color: var(--lf-volt); font-weight: 700; font-size: 15px; }
    .lf-form-note:empty { display: none; }

    /* footer */
    .lf-footer { padding: 80px 0 90px; text-align: center; overflow: hidden; border-top: 1px solid var(--lf-line); }
    .lf-footer-giant {
      font-family: var(--lf-display); font-size: clamp(4rem, 17vw, 13rem); line-height: 0.9; margin: 0 0 30px;
      color: transparent; -webkit-text-stroke: 2px var(--lf-line); letter-spacing: 0.04em;
    }
    .lf-footer-in { display: grid; gap: 10px; color: var(--lf-gray); font-size: 14px; }
    .lf-footer-in p { margin: 0; }
    .lf-footer-in a { color: var(--lf-volt); }

    @media (max-width: 1020px) {
      .lf-days { grid-template-columns: repeat(4, 1fr); }
      .lf-prog { grid-template-columns: 80px 1fr; }
      .lf-prog img { display: none; }
    }
    @media (max-width: 860px) {
      .lf-nav-links { display: none; }
      .lf-stats { grid-template-columns: 1fr 1fr; }
      .lf-stats div:nth-child(3) { border-left: none; }
      .lf-stats div { border-top: 1px solid var(--lf-line); }
      .lf-stats div:nth-child(-n+2) { border-top: none; }
      .lf-coaches { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
      .lf-trial-in { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .lf-days { grid-template-columns: 1fr 1fr; }
      .lf-prog { grid-template-columns: 1fr; gap: 14px; }
      .lf-prog-n { font-size: 2.6rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lf-ticker-track, .lf-dot { animation: none; }
      .lf-btn-volt, .lf-btn-ghost, .lf-prog, .lf-coach { transition: none; }
    }
  </style>
</body>
