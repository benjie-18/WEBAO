---
import EscapeHatch from "../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../components/demos/DemoSeo.astro";

// Demo microsite: Lune Fitness, fictional crossfit gym, Trois-Rivières.
// Standalone art direction. After-dark neon. Not connected to the WEBAO theme system.
// Structure: a training program. The weekly split IS the nav; each day opens a
// workout ledger (movements, sets x reps), not cards.
const IMG = {
  hero: "/demos/lune/01.jpg",
  gym: "/demos/lune/02.jpg",
  weights: "https://images.unsplash.com/photo-1518310383802-640c2de311b2?q=80&w=800&auto=format&fit=crop",
  workout: "https://images.unsplash.com/photo-1599058917212-d750089bc07e?q=80&w=800&auto=format&fit=crop",
  barbell: "https://images.unsplash.com/photo-1517963879433-6ad2b056d712?q=80&w=800&auto=format&fit=crop",
  deadlift: "https://images.unsplash.com/photo-1605296867304-46d5465a13f1?q=80&w=800&auto=format&fit=crop",
  training: "https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?q=80&w=800&auto=format&fit=crop",
};

const DAYS = [
  { id: "mon", short: "MON", name: "Monday", focus: "Squat day", coach: "Jo", dur: "75 min", img: IMG.barbell, imgAlt: "Athlete lifting a loaded barbell",
    note: "Heavy, slow, perfect. Five sets of five is the whole religion on Mondays.",
    rows: [
      ["Back squat", "5 x 5 @ 80%", "2 min rest, own your depth"],
      ["Front squat", "3 x 3", "Pause 2 sec at the bottom"],
      ["Walking lunge", "3 x 20 steps", "Dumbbells at your sides"],
      ["GHD sit-up", "3 x 20", "Scale to weighted sit-ups"],
    ] },
  { id: "tue", short: "TUE", name: "Tuesday", focus: "Press day", coach: "Marie", dur: "70 min", img: null, imgAlt: "",
    note: "Push heavy, pull harder. Finish with a burner that tests your engine.",
    rows: [
      ["Bench press", "5 x 5", "Spotter on the last two sets"],
      ["Strict press", "4 x 8", "No leg drive, ribs down"],
      ["Weighted dip", "3 x 8", "Add load when 8 feels easy"],
      ["Pull-up", "4 x max", "Strict, full range"],
      ["Metcon, 10-min EMOM", "12 cal bike + 10 push-ups", "Odd min bike, even min push-ups"],
    ] },
  { id: "wed", short: "WED", name: "Wednesday", focus: "Hyrox prep", coach: "Sam", dur: "75 min", img: null, imgAlt: "",
    note: "Eight stations, two rounds, no hiding. Race pace starts here.",
    rows: [
      ["SkiErg", "500 m", "Round 1 and 2"],
      ["Sled push", "2 x 25 m", "Bodyweight on the sled"],
      ["Wall ball", "20 reps", "Unbroken if you can"],
      ["Burpee broad jump", "40 m", "Chest to floor every rep"],
      ["Rowing", "500 m", "Hold your 2k pace + 5 sec"],
      ["Farmer carry", "2 x 50 m", "Heavy, shoulders packed"],
    ] },
  { id: "thu", short: "THU", name: "Thursday", focus: "Deadlift day", coach: "Jo", dur: "75 min", img: IMG.deadlift, imgAlt: "Athlete mid-deadlift in a dark gym",
    note: "The king of lifts gets its own day. Flat back, loud lockout, chalk everywhere.",
    rows: [
      ["Deadlift", "5 x 3 @ 85%", "Reset every rep, no touch and go"],
      ["Romanian deadlift", "4 x 8", "Slow hinge, feel the hamstrings"],
      ["Barbell row", "4 x 10", "Chest supported if it is there"],
      ["Conditioning, 5 rounds", "15 KB swings + 10 burpees", "For time, cap 18 min"],
    ] },
  { id: "fri", short: "FRI", name: "Friday", focus: "Friday Night Lights", coach: "Marie", dur: "60 min", img: null, imgAlt: "",
    note: "One workout, the whole box, music too loud. Partner up or go solo, your call.",
    rows: [
      ["Run", "1 mile", "Together, easy pace"],
      ["Pull-ups", "100 reps", "Partition however you want"],
      ["Push-ups", "200 reps", "Chest to floor"],
      ["Air squats", "300 reps", "Below parallel"],
      ["Run", "1 mile", "Finish together, cheer loud"],
    ] },
  { id: "sat", short: "SAT", name: "Saturday", focus: "Team WOD", coach: "Sam", dur: "60 min", img: null, imgAlt: "",
    note: "Bring a friend, we provide the suffering. Newcomers train free on Saturdays.",
    rows: [
      ["Team WOD", "30-min AMRAP, teams of 3", "One works, two rest, rotate stations"],
      ["On-Ramp intro", "45 min", "First-timers learn the nine basics"],
      ["Open gym", "12:00 onward", "Coach on the floor"],
    ] },
  { id: "sun", short: "SUN", name: "Sunday", focus: "Engine + mobility", coach: "Marie", dur: "60 min", img: null, imgAlt: "",
    note: "Long, slow, boring on purpose. Your heart will thank you by Thursday.",
    rows: [
      ["Long engine", "40 min bike or row", "Conversational pace, nose breathing"],
      ["Mobility flow", "20 min", "Hips, shoulders, thoracic"],
    ] },
];
const COACHES = [
  { img: IMG.weights, alt: "Coach Marie lifting dumbbells", name: "Marie \u201CMotor\u201D Coté", role: "Head coach, CF-L3", line: "Remembers your PR better than you do." },
  { img: IMG.workout, alt: "Coach Sam doing battle ropes", name: "Sam \u201CSled\u201D Bérubé", role: "Hyrox lead, ex-sprinter", line: "Believes rest days are a rumor." },
  { img: IMG.training, alt: "Coach Jo demonstrating a movement", name: "Jo \u201CTechnique\u201D Lachance", role: "Weightlifting, 9 years", line: "Fixes your snatch and your attitude." },
];
const TIERS = [
  { name: "Drop-in", price: "$25", classes: "1 class", gym: "No", extra: "Chalk included" },
  { name: "Monthly", price: "$149", classes: "Unlimited", gym: "Yes, 05:30-24:00", extra: "Pause anytime" },
  { name: "Annual", price: "$1,490", classes: "Unlimited", gym: "Yes, 05:30-24:00", extra: "4 guest passes" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="lune" locale="en" title="Lune Fitness: CrossFit in Trois-Rivières" description="Lune Fitness: Trois-Rivières' after-dark CrossFit box. 5:30am classes, Hyrox prep, open gym till midnight. First week free." ogImage="https://webao.ca/demos/lune/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="lf">

  <!-- NAV: the week IS the nav -->
  <header class="lf-navwrap">
    <nav class="lf-nav" aria-label="Primary">
      <a class="lf-logo" href="#top" aria-label="Lune Fitness, home">LUNE<span class="lf-dot" aria-hidden="true"></span></a>
      <div class="lf-nav-links">
        <a href="#trainers">Trainers</a>
        <a href="#membership">Membership</a>
      </div>
      <a class="lf-btn-volt lf-btn-small" href="#trial">First week free</a>
    </nav>
    <div class="lf-weeknav" role="tablist" aria-label="Training week: pick a day">
      {DAYS.map((d, i) => (
        <button
          class="lf-daytab"
          role="tab"
          id={"tab-" + d.id}
          aria-controls={"panel-" + d.id}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-day={d.id}
        >
          <span class="lf-daytab-short">{d.short}</span>
          <span class="lf-daytab-focus">{d.focus}</span>
        </button>
      ))}
    </div>
  </header>

  <main id="top">
    <!-- THE PROGRAM -->
    <section class="lf-week" id="week" aria-label="This week's training program">
      <div class="lf-band" aria-hidden="true">
        <img src={IMG.hero} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="lf-wrap lf-band-in">
        <p class="lf-eyebrow">SEASON 04 · 8-WEEK STRENGTH CYCLE · TROIS-RIVIÈRES</p>
        <h1 class="lf-h1">THIS WEEK<br />AT <span class="lf-volt">LUNE</span></h1>
        <p class="lf-lede">No philosophy, no fluff. Pick a day above and see exactly what you are lifting, how many reps, and who is yelling at you. The program changes every 8 weeks; the chalk never washes out.</p>
      </div>

      <div class="lf-wrap">
        {DAYS.map((d, i) => (
          <div class="lf-panel" role="tabpanel" id={"panel-" + d.id} aria-labelledby={"tab-" + d.id} hidden={i !== 0}>
            <div class="lf-panel-head">
              <div>
                <h2 class="lf-h2">{d.name} <span class="lf-volt">/ {d.focus}</span></h2>
                <p class="lf-panel-meta">Coach {d.coach} · {d.dur} · Doors open 30 min early</p>
              </div>
              {d.img && <img class="lf-panel-img" src={d.img} alt={d.imgAlt} loading="lazy" decoding="async" />}
            </div>
            <table class="lf-ledger">
              <caption class="lf-sr">Workout for {d.name}: {d.focus}</caption>
              <thead>
                <tr><th scope="col">Movement</th><th scope="col">Sets x reps</th><th scope="col">Notes</th></tr>
              </thead>
              <tbody>
                {d.rows.map((r) => (
                  <tr><td class="lf-move">{r[0]}</td><td class="lf-scheme">{r[1]}</td><td class="lf-note">{r[2]}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="lf-panel-note">{d.note}</p>
          </div>
        ))}
      </div>

      <div class="lf-ticker" aria-hidden="true">
        <div class="lf-ticker-track">
          <span>NO MIRRORS</span><span>✦</span><span>CHALK EVERYWHERE</span><span>✦</span><span>5:30 AM CLUB</span><span>✦</span><span>HYROX PREP</span><span>✦</span><span>OPEN GYM TILL MIDNIGHT</span><span>✦</span>
          <span>NO MIRRORS</span><span>✦</span><span>CHALK EVERYWHERE</span><span>✦</span><span>5:30 AM CLUB</span><span>✦</span><span>HYROX PREP</span><span>✦</span><span>OPEN GYM TILL MIDNIGHT</span><span>✦</span>
        </div>
      </div>
    </section>

    <!-- TRAINERS: a roster, not cards -->
    <section class="lf-section" id="trainers">
      <div class="lf-wrap">
        <h2 class="lf-h2">YOUR <span class="lf-volt">TRAINERS</span></h2>
        <p class="lf-sec-lede">The loud ones with whistles. Certified maniacs, all of them.</p>
        <ol class="lf-roster">
          {COACHES.map((c, i) => (
            <li class="lf-roster-row">
              <span class="lf-roster-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <img src={c.img} alt={c.alt} loading="lazy" decoding="async" />
              <div>
                <h3>{c.name}</h3>
                <p class="lf-roster-role">{c.role}</p>
                <p class="lf-roster-line">{c.line}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- MEMBERSHIP: a table, not cards -->
    <section class="lf-section lf-section-panel" id="membership">
      <div class="lf-wrap">
        <h2 class="lf-h2">MEMBER<span class="lf-volt">SHIP</span></h2>
        <p class="lf-sec-lede">Three tiers, no initiation fee, no 40-page contract. Cancel by text.</p>
        <div class="lf-table-scroll">
          <table class="lf-table">
            <caption class="lf-sr">Membership tiers</caption>
            <thead>
              <tr><th scope="col">Tier</th><th scope="col">Price</th><th scope="col">Classes</th><th scope="col">Open gym</th><th scope="col">Extra</th></tr>
            </thead>
            <tbody>
              {TIERS.map((t) => (
                <tr><th scope="row">{t.name}</th><td class="lf-price">{t.price}</td><td>{t.classes}</td><td>{t.gym}</td><td>{t.extra}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="lf-table-note">Students and first responders get 15% off Monthly and Annual, every day, no questions.</p>
      </div>
    </section>

    <!-- TRIAL -->
    <section class="lf-trial" id="trial">
      <div class="lf-trial-bg" aria-hidden="true"><img src={IMG.gym} alt="" loading="lazy" decoding="async" /></div>
      <div class="lf-wrap lf-trial-in">
        <div>
          <h2 class="lf-h2 lf-h2-dark">YOUR FIRST WEEK<br />IS ON US</h2>
          <p class="lf-trial-copy">Seven days. Every class, open gym included. A coach walks you through day one, and nobody tries to sell you anything. If you hate it, you never come back and we pretend this never happened.</p>
          <ul class="lf-trial-list">
            <li>✓ All classes, all week</li>
            <li>✓ On-Ramp intro session</li>
            <li>✓ No card required</li>
          </ul>
        </div>
        <form class="lf-form" id="lf-form" novalidate>
          <h3>Claim it</h3>
          <label>Name<input type="text" name="name" required placeholder="Alex Tremblay" /></label>
          <label>Phone<input type="tel" name="phone" required placeholder="(819) 555-0100" /></label>
          <label>Goal
            <select name="goal">
              <option>Get stronger</option>
              <option>Lose the winter</option>
              <option>Hyrox race</option>
              <option>Just curious</option>
            </select>
          </label>
          <button class="lf-btn-black" type="submit">Start my free week</button>
          <p class="lf-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="lf-footer">
    <p class="lf-footer-giant" aria-hidden="true">LUNE</p>
    <div class="lf-wrap lf-footer-in">
      <p>© 2026 Lune Fitness. Fictional demo. No PRs were harmed.</p>
      <p>77, rue Fictive, Trois-Rivières QC · <a href="tel:+18195550177">(819) 555-0177</a> · Open daily 05:30-24:00</p>
    </div>
  </footer>

  <EscapeHatch locale="en" />

  <script>
    // Demo form: never submits anywhere
    (function () {
      var form = document.getElementById('lf-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.lf-form-note');
        if (note) note.textContent = 'You are in. A coach will text you within the hour to set up day one.';
        form?.reset();
      });
    })();
    // Weekly split tabs: the week is the nav. Default tab = today.
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.lf-daytab')) as HTMLElement[];
      var panels = Array.prototype.slice.call(document.querySelectorAll('.lf-panel')) as HTMLElement[];
      if (!tabs.length) return;
      function select(tab: HTMLElement, focus: boolean) {
        tabs.forEach(function (t: HTMLElement) {
          var on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (focus && on) t.focus();
        });
        panels.forEach(function (p: HTMLElement) {
          var show = p.id === 'panel-' + tab.dataset.day;
          if (show) p.removeAttribute('hidden'); else p.setAttribute('hidden', '');
        });
      }
      tabs.forEach(function (tab: HTMLElement, i: number) {
        tab.addEventListener('click', function () { select(tab, false); });
        tab.addEventListener('keydown', function (e: KeyboardEvent) {
          var k = e.key;
          var j: number | null = null;
          if (k === 'ArrowRight') j = (i + 1) % tabs.length;
          if (k === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
          if (j !== null) { e.preventDefault(); select(tabs[j], true); }
        });
      });
      // JS weekday: 0=Sun..6=Sat. DAYS order is Mon..Sun.
      var today = (new Date().getDay() + 6) % 7;
      select(tabs[today] || tabs[0], false);
    })();
  </script>

  <style>
    .lf {
      --lf-black: #0A0A0B;
      --lf-panel: #131315;
      --lf-line: #26262A;
      --lf-volt: #CCFF00;
      --lf-white: #F4F4F0;
      --lf-gray: #9A9AA0;
      --lf-display: "Anton", "Arial Narrow", sans-serif;
      --lf-body: "Inter", system-ui, sans-serif;
      margin: 0;
      background: var(--lf-black);
      color: var(--lf-white);
      font-family: var(--lf-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .lf *, .lf *::before, .lf *::after { box-sizing: border-box; }
    .lf img { display: block; max-width: 100%; }
    .lf-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .lf-volt { color: var(--lf-volt); }
    .lf-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* nav */
    .lf-navwrap { position: sticky; top: 0; z-index: 60; background: rgba(10, 10, 11, 0.9); backdrop-filter: blur(14px); border-bottom: 1px solid var(--lf-line); }
    .lf-nav { display: flex; align-items: center; gap: 26px; padding: 14px clamp(20px, 4vw, 44px); }
    .lf-logo {
      font-family: var(--lf-display); font-size: 28px; letter-spacing: 0.06em;
      color: var(--lf-white); text-decoration: none; display: flex; align-items: center; gap: 8px;
      margin-right: auto;
    }
    .lf-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--lf-volt); box-shadow: 0 0 14px var(--lf-volt); animation: lf-pulse 2s ease-in-out infinite; }
    @keyframes lf-pulse { 50% { opacity: 0.4; } }
    .lf-nav-links { display: flex; gap: 6px; }
    .lf-nav-links a { color: var(--lf-gray); text-decoration: none; font-weight: 700; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; padding: 10px 14px; }
    .lf-nav-links a:hover { color: var(--lf-volt); }

    /* the week as nav */
    .lf-weeknav {
      display: grid; grid-template-columns: repeat(7, 1fr);
      border-top: 1px solid var(--lf-line);
      overflow-x: auto;
    }
    .lf-daytab {
      font-family: var(--lf-body); background: transparent; border: none; border-left: 1px solid var(--lf-line);
      color: var(--lf-gray); padding: 12px 8px 14px; cursor: pointer; display: grid; gap: 3px; text-align: center;
      min-width: 96px;
    }
    .lf-daytab:first-child { border-left: none; }
    .lf-daytab-short { font-family: var(--lf-display); font-size: 19px; letter-spacing: 0.12em; color: var(--lf-white); }
    .lf-daytab-focus { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .lf-daytab:hover .lf-daytab-short { color: var(--lf-volt); }
    .lf-daytab[aria-selected="true"] { background: var(--lf-volt); }
    .lf-daytab[aria-selected="true"] .lf-daytab-short, .lf-daytab[aria-selected="true"] .lf-daytab-focus { color: #0A0A0B; }
    .lf-daytab:focus-visible { outline: 2px solid var(--lf-volt); outline-offset: -2px; }

    /* buttons */
    .lf-btn-volt, .lf-btn-black {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--lf-body); font-weight: 800; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 16px 32px; text-decoration: none; cursor: pointer; border: none;
      clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .lf-btn-volt { background: var(--lf-volt); color: #0A0A0B; }
    .lf-btn-volt:hover { filter: brightness(1.08); box-shadow: 0 8px 30px rgba(204, 255, 0, 0.35); }
    .lf-btn-black { background: #0A0A0B; color: var(--lf-volt); width: 100%; }
    .lf-btn-small { font-size: 13px; padding: 12px 24px; }

    /* type */
    .lf-h1 {
      font-family: var(--lf-display); font-size: clamp(3.4rem, 11vw, 8.5rem);
      line-height: 0.92; letter-spacing: 0.01em; margin: 0 0 22px; text-transform: uppercase;
    }
    .lf-h2 {
      font-family: var(--lf-display); font-size: clamp(2.2rem, 6vw, 4rem);
      line-height: 0.95; text-transform: uppercase; margin: 0 0 14px;
    }
    .lf-h2-dark { color: #0A0A0B; }
    .lf-eyebrow { font-weight: 800; font-size: 12.5px; letter-spacing: 0.32em; color: var(--lf-volt); margin: 0 0 22px; }

    /* program band */
    .lf-week { padding-top: 0; }
    .lf-band { position: relative; height: clamp(220px, 34vw, 380px); overflow: hidden; }
    .lf-band img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.25) contrast(1.15) brightness(0.5); }
    .lf-band::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(10,10,11,0.35) 0%, rgba(10,10,11,0.05) 45%, rgba(10,10,11,0.96) 100%);
    }
    .lf-band-in { margin-top: -120px; position: relative; z-index: 2; padding-bottom: 10px; }
    .lf-lede { font-size: 17px; line-height: 1.65; max-width: 52ch; color: #D8D8D2; margin: 0; }

    /* workout panels */
    .lf-panel { border: 1px solid var(--lf-line); background: var(--lf-panel); margin: 34px 0 60px; }
    .lf-panel-head { display: flex; gap: 28px; align-items: center; justify-content: space-between; padding: clamp(24px, 4vw, 40px); border-bottom: 1px solid var(--lf-line); }
    .lf-panel-head .lf-h2 { margin-bottom: 8px; }
    .lf-panel-meta { margin: 0; color: var(--lf-gray); font-weight: 700; font-size: 13.5px; letter-spacing: 0.12em; text-transform: uppercase; }
    .lf-panel-img { width: 220px; height: 150px; object-fit: cover; filter: grayscale(0.6) contrast(1.1); border: 1px solid var(--lf-line); flex-shrink: 0; }
    .lf-ledger { width: 100%; border-collapse: collapse; font-size: 15px; }
    .lf-ledger th, .lf-ledger td { text-align: left; padding: 16px clamp(16px, 3vw, 28px); border-bottom: 1px solid var(--lf-line); vertical-align: top; }
    .lf-ledger thead th { font-size: 11.5px; font-weight: 800; letter-spacing: 0.24em; text-transform: uppercase; color: var(--lf-gray); padding-top: 20px; }
    .lf-ledger tbody tr:last-child td { border-bottom: none; }
    .lf-ledger tbody tr:hover { background: rgba(204, 255, 0, 0.04); }
    .lf-move { font-weight: 700; color: var(--lf-white); }
    .lf-scheme { font-weight: 800; color: var(--lf-volt); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .lf-note { color: var(--lf-gray); }
    .lf-panel-note { margin: 0; padding: 20px clamp(16px, 3vw, 28px); color: #C9C9C2; font-size: 15px; line-height: 1.65; border-top: 1px solid var(--lf-line); font-style: italic; }

    /* ticker */
    .lf-ticker { background: var(--lf-volt); color: #0A0A0B; overflow: hidden; padding: 12px 0; border-block: 2px solid #0A0A0B; }
    .lf-ticker-track { display: flex; gap: 30px; width: max-content; animation: lf-tick 20s linear infinite; font-family: var(--lf-display); font-size: 20px; letter-spacing: 0.08em; }
    @keyframes lf-tick { to { transform: translateX(-50%); } }

    /* sections */
    .lf-section { padding: clamp(70px, 9vw, 120px) 0; }
    .lf-section-panel { background: var(--lf-panel); border-block: 1px solid var(--lf-line); }
    .lf-sec-lede { color: var(--lf-gray); font-size: 16.5px; line-height: 1.65; margin: 0 0 40px; max-width: 52ch; }

    /* roster */
    .lf-roster { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--lf-line); counter-reset: none; }
    .lf-roster-row {
      display: grid; grid-template-columns: 64px 120px 1fr; gap: clamp(16px, 3vw, 34px); align-items: center;
      padding: 22px 0; border-bottom: 1px solid var(--lf-line);
    }
    .lf-roster-row:hover { background: rgba(204, 255, 0, 0.03); }
    .lf-roster-n { font-family: var(--lf-display); font-size: 2.4rem; color: transparent; -webkit-text-stroke: 1.5px var(--lf-line); }
    .lf-roster-row img { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; filter: grayscale(1) contrast(1.1); border: 2px solid var(--lf-line); }
    .lf-roster-row:hover img { filter: grayscale(0.2); border-color: var(--lf-volt); }
    .lf-roster-row h3 { font-family: var(--lf-display); font-size: 26px; letter-spacing: 0.03em; margin: 0 0 4px; text-transform: uppercase; }
    .lf-roster-role { margin: 0 0 6px; color: var(--lf-volt); font-weight: 800; font-size: 12.5px; letter-spacing: 0.2em; text-transform: uppercase; }
    .lf-roster-line { margin: 0; color: var(--lf-gray); font-size: 15px; }

    /* membership table */
    .lf-table-scroll { overflow-x: auto; border: 1px solid var(--lf-line); }
    .lf-table { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 15.5px; background: var(--lf-black); }
    .lf-table th, .lf-table td { text-align: left; padding: 20px 24px; border-bottom: 1px solid var(--lf-line); }
    .lf-table thead th { font-size: 11.5px; font-weight: 800; letter-spacing: 0.24em; text-transform: uppercase; color: var(--lf-gray); }
    .lf-table tbody tr:last-child th, .lf-table tbody tr:last-child td { border-bottom: none; }
    .lf-table tbody th { font-family: var(--lf-display); font-size: 24px; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 400; }
    .lf-table tbody tr:hover { background: rgba(204, 255, 0, 0.04); }
    .lf-price { font-weight: 800; color: var(--lf-volt); font-size: 19px; font-variant-numeric: tabular-nums; }
    .lf-table-note { color: var(--lf-gray); font-size: 14px; margin: 18px 0 0; }

    /* trial */
    .lf-trial { position: relative; background: var(--lf-volt); color: #0A0A0B; padding: clamp(70px, 9vw, 120px) 0; overflow: hidden; }
    .lf-trial-bg { position: absolute; inset: 0; opacity: 0.14; }
    .lf-trial-bg img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.2); }
    .lf-trial-in { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
    .lf-trial-copy { font-size: 17px; line-height: 1.65; max-width: 44ch; margin: 0 0 24px; font-weight: 500; }
    .lf-trial-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-weight: 800; font-size: 16px; }
    .lf-form { background: #0A0A0B; padding: clamp(28px, 4vw, 44px); display: grid; gap: 16px; }
    .lf-form h3 { font-family: var(--lf-display); font-size: 30px; letter-spacing: 0.05em; color: var(--lf-volt); margin: 0; text-transform: uppercase; }
    .lf-form label { display: grid; gap: 8px; font-weight: 800; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lf-gray); }
    .lf-form input, .lf-form select {
      font-family: var(--lf-body); font-size: 16px; font-weight: 600;
      background: var(--lf-panel); border: 1px solid var(--lf-line); color: var(--lf-white);
      padding: 14px 18px; width: 100%;
    }
    .lf-form input:focus, .lf-form select:focus { outline: 2px solid var(--lf-volt); outline-offset: 2px; }
    .lf-form-note { margin: 0; color: var(--lf-volt); font-weight: 700; font-size: 15px; }
    .lf-form-note:empty { display: none; }

    /* footer */
    .lf-footer { padding: 80px 0 90px; text-align: center; overflow: hidden; border-top: 1px solid var(--lf-line); }
    .lf-footer-giant {
      font-family: var(--lf-display); font-size: clamp(4rem, 17vw, 13rem); line-height: 0.9; margin: 0 0 30px;
      color: transparent; -webkit-text-stroke: 2px var(--lf-line); letter-spacing: 0.04em;
    }
    .lf-footer-in { display: grid; gap: 10px; color: var(--lf-gray); font-size: 14px; }
    .lf-footer-in p { margin: 0; }
    .lf-footer-in a { color: var(--lf-volt); }

    @media (max-width: 860px) {
      .lf-nav-links { display: none; }
      .lf-panel-head { flex-direction: column; align-items: flex-start; }
      .lf-panel-img { width: 100%; height: 180px; }
      .lf-roster-row { grid-template-columns: 88px 1fr; }
      .lf-roster-n { display: none; }
      .lf-roster-row img { width: 88px; height: 88px; }
      .lf-trial-in { grid-template-columns: 1fr; }
      .lf-ledger thead { display: none; }
      .lf-ledger tr { display: grid; gap: 4px; padding: 14px clamp(16px, 3vw, 28px); border-bottom: 1px solid var(--lf-line); }
      .lf-ledger th, .lf-ledger td { padding: 0; border: none; }
      .lf-note { font-size: 13.5px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lf-ticker-track, .lf-dot { animation: none; }
      .lf-btn-volt, .lf-daytab { transition: none; }
    }
  </style>
</body>
</html>
