---
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = "en" as const;
const title = "Start your site · WEBAO";
const description = "Start your WEBAO website: tell us who you are, then complete your $149/month subscription.";

// Publishable key is public; safe to embed in frontend code.
const STRIPE_PUBLISHABLE_KEY = "pk_live_51UMzZYE57vVzxI418WAmnlUuIXMLMWtNxjYa6WeWauaSmAhF3xfwaFfdP4D4kJUG2k1nieWrIGSYVMDcy2WYIJ2T00TPmrTePT";
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="section">
    <div class="shell" style="max-width: 640px;">
      <div class="eyebrow">Start your site</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.2rem); line-height:.92; margin-top:12px;">Let's build it.</h1>
      <p class="prose" style="margin-top:12px; max-width: 52ch;">
        Tell us who you are, then complete payment below.
        Your $149/month subscription starts today; we reach out within one business day to kick off your site.
      </p>

      <form id="start-form" class="start-form" novalidate style="margin-top: 28px;">
        <label>Your name
          <input name="name" placeholder="Your name" autocomplete="name" required />
          <span class="field-error mono" data-error="name" hidden></span>
        </label>
        <label>Email
          <input name="email" type="email" placeholder="you@yourbusiness.ca" autocomplete="email" required />
          <span class="field-error mono" data-error="email" hidden></span>
        </label>
        <label>Business name
          <input name="business" placeholder="Your business name" autocomplete="organization" required />
          <span class="field-error mono" data-error="business" hidden></span>
        </label>
        <p class="mono" style="font-size:11px; color: var(--muted); margin: 4px 0 0;">The payment form appears below once your details are valid.</p>
      </form>

      <div class="checkout-card checkout-card--pay" style="margin-top: 20px;">
        <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5; margin-bottom:12px;">SECURE PAYMENT · $149 CAD/MONTH</div>
        <div id="stripe-checkout">
          <div class="mono" style="padding:40px 20px; text-align:center; color: var(--muted); font-size:12.5px;" id="checkout-loading">
            Fill in your details above to load the payment form.
          </div>
        </div>
        <div class="mono" style="margin-top:12px; font-size:10.5px; text-align:center; color: var(--muted);">
          🔒 Encrypted & secure · Powered by Stripe · <a href="/refunds" style="color: var(--accent-text);">Refund policy</a>
        </div>
      </div>

      <p class="mono" style="margin-top:24px; font-size:11px; color: var(--muted); text-align:center;">
        Just have a question? <a href="/contact" style="color: var(--ink);">Contact us</a> instead.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="https://js.stripe.com/v3/"></script>
<script define:vars={{ pk: STRIPE_PUBLISHABLE_KEY }}>
  (function() {
    const form = document.getElementById('start-form');
    const loadingEl = document.getElementById('checkout-loading');
    let checkoutMounted = false;
    let mountInFlight = false;
    const touched = { name: false, email: false, business: false };

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function setFieldError(field, msg) {
      const el = form.querySelector('[data-error="' + field + '"]');
      const input = form.querySelector('[name="' + field + '"]');
      if (el) {
        if (msg) {
          el.textContent = msg;
          el.hidden = false;
        } else {
          el.hidden = true;
        }
      }
      if (input) input.classList.toggle('input-error', !!msg);
    }

    function getFormData() {
      const data = new FormData(form);
      return {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        business: String(data.get('business') || '').trim(),
      };
    }

    // Validate a single field; returns true if valid. Only shows errors for touched fields.
    function validateField(field, value) {
      let msg = null;
      if (field === 'name' && !value) msg = 'Please enter your name.';
      else if (field === 'business' && !value) msg = 'Please enter your business name.';
      else if (field === 'email') {
        if (!value) msg = 'Please enter your email.';
        else if (!EMAIL_RE.test(value)) msg = 'Enter a valid email like name@domain.com.';
      }
      if (touched[field]) setFieldError(field, msg);
      return !msg;
    }

    function allValid(d) {
      return d.name && d.business && EMAIL_RE.test(d.email);
    }

    async function mountCheckout() {
      if (checkoutMounted || mountInFlight) return;
      const d = getFormData();
      if (!allValid(d)) return;
      mountInFlight = true;

      if (!window.Stripe) {
        if (loadingEl) loadingEl.textContent = 'Stripe could not be loaded. Check your connection and refresh.';
        mountInFlight = false;
        return;
      }

      if (loadingEl) loadingEl.textContent = 'Loading secure payment form…';

      try {
        sessionStorage.setItem('webao-checkout', JSON.stringify(d));
        fetch('/api/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({ form: 'start', fields: { ...d, page: location.pathname } }),
        }).catch(() => {});
      } catch (e) {}

      try {
        const stripe = window.Stripe(pk);
        const checkout = await stripe.initEmbeddedCheckout({
          fetchClientSecret: async () => {
            const res = await fetch('/api/checkout/session', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(d),
            });
            const data = await res.json();
            if (!data.ok || !data.clientSecret) {
              throw new Error(data.error || 'Could not start checkout');
            }
            return data.clientSecret;
          },
        });
        checkout.mount('#stripe-checkout');
        checkoutMounted = true;
      } catch (e) {
        console.error('Stripe checkout error:', e);
        if (loadingEl) loadingEl.textContent = 'Payment could not be loaded (' + (e.message || 'unknown error') + '). Please check your connection and re-enter your details.';
        mountInFlight = false;
      }
    }

    if (form) {
      // Live validation on every keystroke; auto-mount payment when all valid.
      form.addEventListener('input', (e) => {
        const input = e.target;
        if (!input || !input.name || !(input.name in touched)) return;
        touched[input.name] = true;
        const d = getFormData();
        validateField(input.name, d[input.name]);
        if (allValid(d)) mountCheckout();
      });
      // Also validate on blur so tabbing through shows errors.
      form.addEventListener('focusout', (e) => {
        const input = e.target;
        if (!input || !input.name || !(input.name in touched)) return;
        touched[input.name] = true;
        const d = getFormData();
        validateField(input.name, d[input.name]);
      });
      // Prevent accidental submit (no button; Enter key)
      form.addEventListener('submit', (e) => e.preventDefault());
    }
  })();
</script>

<style>
  .start-form {
    display: grid;
    gap: 14px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
  }
  .start-form label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .start-form input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--paper-3);
    font-size: 14px;
    color: var(--ink);
  }
  .start-form input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .start-form input.input-error {
    border-color: #c0392b;
  }
  .field-error {
    font-size: 11.5px;
    color: #c0392b;
    margin-top: 2px;
  }
  .checkout-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--card-bg);
  }
  .checkout-card--pay {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  #stripe-checkout {
    min-height: 320px;
    border-radius: 12px;
    overflow: hidden;
  }
</style>
