---
import BaseLayout from "../layouts/BaseLayout.astro";
import StartPage from "../components/pages/StartPage.astro";
import { useTranslations } from "../lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);
---

<BaseLayout title={t.start.metaTitle} description={t.start.metaDescription} locale={locale} pageKey="start">
  <StartPage locale={locale} />
</BaseLayout>
