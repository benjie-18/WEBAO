      },
      fr: {
        loading: "Chargement de votre audit…",
        notFound: "Cet audit est introuvable. Il a peut-être expiré. Lancez un nouvel audit pour un résultat frais.",
        noId: "Aucun audit ici. Lancez un audit gratuit pour obtenir votre score.",
        title: "Votre audit de site web",
        partial: "Le test de vitesse complet n'était pas disponible, donc ce score couvre seulement les bases.",
        strengthsTitle: "Ce qui fonctionne",
