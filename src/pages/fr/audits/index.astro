---
// WEBAO audit result page (shell, FR) — renders one stored audit at
// /fr/audits/<id>. French twin of src/pages/audits/index.astro, same
// structure, French static strings and locale="fr". The worker rewrites
// /fr/audits/<id> to this shell and the script loads the audit from
// GET /api/audit/<id>. The audit record carries its lang, so the content
// renders in the language the audit was run in. Noindex: result URLs are
// personal, not for search. Regenerate from the EN shell when it changes.
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Votre audit de site web · Webao" description="Le résultat de votre audit gratuit de site web WEBAO." locale="fr" noIndex>
  <div class="audit-result-loading" data-audit-result-loading>
    <span class="audit-loading-star" data-audit-result-star aria-hidden="true"></span>
    <p id="audit-status" aria-live="polite">Chargement de votre audit…</p>
    <p class="audit-result-action" data-audit-result-action hidden><a href="/fr/eval" data-audit-result-action-link>Lancer un nouvel audit</a></p>
  </div>

  <div data-audit-result-page hidden>
    <div class="audit-pending-strip" data-audit-pending-strip hidden>
      <p class="audit-pending-countdown" id="audit-countdown" aria-live="polite"></p>
      <div class="audit-pending-bar" aria-hidden="true"><span class="audit-pending-fill" data-audit-pending-fill></span></div>
    </div>

    <section class="audit-hero grain">
      <div class="shell audit-hero-inner">
        <h1 id="audit-title" class="visually-hidden">Votre audit de site web</h1>
        <p class="eyebrow" id="audit-eyebrow">Your website audit</p>
        <p class="audit-result-url mono" id="audit-url"></p>
        <div class="audit-score-wrap">
          <span class="display audit-score" id="audit-score">–</span><span class="display audit-score-of">/100</span>
        </div>
        <p class="audit-pricing-cta"><a href="/fr/tarifs" class="btn btn--primary btn--lg" id="audit-pricing-link">Corriger mon site</a></p>
        <p class="audit-verdict" id="audit-verdict"></p>
        <p class="audit-partial" id="audit-partial" hidden></p>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="audit-bars" id="audit-cats"></div>
        <div class="audit-stats" id="audit-stats" hidden></div>
        <div class="audit-cards">
          <div class="audit-card" id="audit-strengths-card" hidden>
            <h2 id="audit-strengths-title">Ce qui fonctionne</h2>
            <ul id="audit-strengths" class="audit-list audit-list--good"></ul>
          </div>
          <div class="audit-card">
            <h2 id="audit-findings-title">Quoi corriger en premier</h2>
            <p class="audit-findings-note" id="audit-findings-note">Notre équipe sait ce que chaque référence veut dire et comment la corriger.</p>
            <ul id="audit-findings" class="audit-list audit-list--fix"></ul>
            <p class="audit-fix-cta"><a href="/fr/commencer" class="btn btn--primary" id="audit-fix-start">Commencer</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="audit-band grain">
      <div class="shell audit-band-inner">
        <div>
          <p class="eyebrow audit-band-eyebrow" id="audit-report-eyebrow">Rapport complet</p>
          <h2 class="display audit-band-title" id="audit-report-title">Vous voulez le rapport complet?</h2>
          <p class="audit-report-sub" id="audit-report-sub">Laissez votre courriel professionnel et nous vous enverrons le rapport complet, avec chaque point expliqué.</p>
        </div>
        <form id="report-form" class="audit-report-form" novalidate>
          <label class="visually-hidden" for="report-email" id="audit-report-label">Courriel professionnel</label>
          <input id="report-email" name="email" type="email" placeholder="vous@votreentreprise.com" required />
          <button type="submit" class="btn btn--on-dark btn--lg" id="audit-report-button">Envoyez-moi le rapport complet</button>
        </form>
      </div>
      <p id="report-status" class="audit-report-status shell" aria-live="polite"></p>
    </section>

    <p class="shell audit-back"><a href="/fr/eval" id="audit-back-link">Lancer un autre audit</a></p>

    <p class="shell audit-estimate-note" id="audit-estimate-note" hidden>Les valeurs affichées dans le rapport initial sont seulement des estimations et peuvent ne pas refléter les résultats finaux.</p>
  </div>

  <script>
    const STR = {
