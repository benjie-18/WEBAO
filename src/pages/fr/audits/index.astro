          "WA-0168": "Quelque chose sur cette page pourrait en faire plus.",
        },
        verdictExcellent: "Excellent",
        verdictGood: "Bon, avec de la marge",
        verdictWork: "À améliorer",
        verdictUrgent: "À corriger d'urgence",
        catPerformance: "Performance",
        catAccessibility: "Accessibilité",
        catBestPractices: "Bonnes pratiques",
        catSeo: "Référencement",
        metricLcp: "Plus grand élément affiché",
        metricCls: "Décalage de mise en page",
        metricFcp: "Premier élément affiché",
        metricTbt: "Temps de blocage",
        metricSpeed: "Indice de vitesse",
        reportEyebrow: "Rapport complet",
        reportTitle: "Vous voulez le rapport complet?",
        reportSub: "Laissez votre courriel professionnel et nous vous enverrons le rapport complet, avec chaque point expliqué.",
        reportLabel: "Courriel professionnel",
        reportButton: "Envoyez-moi le rapport complet",
        countdown: "Audit complet dans ~",
        almostThere: "Presque terminé…",
        sending: "Envoi…",
        done: "C'est fait. Vérifiez votre boîte de réception pour le rapport complet.",
        failed: "Ça n'a pas fonctionné. Réessayez, ou contactez-nous directement.",
        backLink: "Lancer un autre audit",
        backHref: "/fr/eval",
        pricingCta: "Corriger mon site",
        pricingHref: "/fr/tarifs",
      },
    } as const;

    type Lang = keyof typeof STR;

    function el(id: string): HTMLElement | null {
      return document.getElementById(id);
    }

    function setText(id: string, value: string): void {
      const node = el(id);
      if (node) node.textContent = value;
    }

    function fillList(id: string, items: string[]): void {
      const list = el(id);
      if (!list) return;
      list.innerHTML = "";
      for (const item of items) {
        const li = document.createElement("li");
        li.textContent = item;
        list.appendChild(li);
      }
    }

    function verdictFor(score: number, s: (typeof STR)[Lang]): string {
      if (score >= 90) return s.verdictExcellent;
      if (score >= 70) return s.verdictGood;
      if (score >= 50) return s.verdictWork;
      return s.verdictUrgent;
    }

    function bandFor(score: number): "good" | "mid" | "low" {
      if (score >= 80) return "good";
      if (score >= 50) return "mid";
      return "low";
    }

    type Audit = {
      url: string; score: number; findings: string[]; findingCodes: string[]; strengths: string[];
      categories: Record<string, number>; metrics: Record<string, string>;
      partial: boolean; pending: boolean; lang: Lang; at: number;
    };

    /** The "what to fix" card shows each finding as its WA code plus
     * a vague hint: enough for the visitor to know we know what's
     * wrong, never enough to act on it without us. The real finding
     * text stays in the record for the admin panel. When nothing
     * needs fixing, say so. The partial note carries an empty code
     * and is skipped. */
    function renderFindings(audit: Audit, s: (typeof STR)[Lang]): void {
      const list = el("audit-findings");
      if (!list) return;
      list.innerHTML = "";
      const codes = (audit.findingCodes ?? []).filter((c) => c);
      const hints = (s as { findingHints?: Record<string, string> }).findingHints ?? {};
      const fallback = hints["WA-0000"] ?? "";
      if (codes.length === 0) {
        const li = document.createElement("li");
        li.textContent = s.noIssues;
        list.appendChild(li);
        return;
      }
      for (const code of codes) {
        const li = document.createElement("li");
        const codeEl = document.createElement("span");
        codeEl.className = "mono audit-finding-code";
        codeEl.textContent = code;
        const hint = document.createElement("span");
        hint.className = "audit-finding-hint";
        hint.textContent = hints[code] ?? fallback;
        li.appendChild(codeEl);
        li.appendChild(hint);
        list.appendChild(li);
      }
    }

    /** Count the big score from one value to another over ~0.9s. A
     * newer count-up cancels an older one still running, so a fast
     * full result never fights the first render's count-up. */
    let scoreAnimId = 0;
    function animateScore(from: number, to: number, finish?: () => void): void {
      const scoreEl = el("audit-score");
      const myId = ++scoreAnimId;
      if (!scoreEl || from === to) {
        if (finish) finish();
        return;
      }
      const start = performance.now();
      const dur = 900;
      const step = (now: number): void => {
        if (myId !== scoreAnimId) return;
        const p = Math.min(1, (now - start) / dur);
        scoreEl.textContent = String(Math.round(from + (to - from) * p));
        if (p < 1) requestAnimationFrame(step);
        else if (finish) finish();
      };
      requestAnimationFrame(step);
    }

    /** Ask the worker to run the full PageSpeed audit for this id and
     * hold the request open until it lands (up to ~3 minutes: the
     * worker's PageSpeed budget is 180s). If another run is already in
     * flight, poll the record until it is no longer pending. Throws
     * when the full audit never lands. */
    async function runFullAudit(id: string): Promise<Audit> {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 200_000);
      try {
        const res = await fetch("/api/audit/" + encodeURIComponent(id) + "/full", {
          method: "POST",
          signal: controller.signal,
        });
        const data = await res.json();
        if (!res.ok) throw new Error((data as { error?: string }).error || "Full audit failed");
        if ((data as { running?: boolean }).running) {
          const deadline = Date.now() + 300_000;
          while (Date.now() < deadline) {
            await new Promise((r) => window.setTimeout(r, 5000));
            const g = await fetch("/api/audit/" + encodeURIComponent(id));
            const gd = await g.json();
            const polled = (gd as { audit?: Audit }).audit;
            if (g.ok && polled && !polled.pending) return polled;
          }
          throw new Error("Full audit timed out");
        }
        return (data as { audit: Audit }).audit;
      } finally {
        window.clearTimeout(timeout);
      }
    }

    /** Render the category scores as bars (label, track, number).
     * The rows are built by script, so their styles are global (see
     * the :global rules below): Astro's scoped styles do not reach
     * elements created in JavaScript, which left the old pills
     * unstyled and the scores running together. */
    function renderCategories(cats: Record<string, number> | undefined, s: (typeof STR)[Lang]): void {
      const container = el("audit-cats");
      if (!container) return;
      container.innerHTML = "";
      const labels: Record<string, string> = {
        performance: s.catPerformance,
        accessibility: s.catAccessibility,
        "best-practices": s.catBestPractices,
        seo: s.catSeo,
      };
      for (const [key, value] of Object.entries(cats ?? {})) {
        if (typeof value !== "number" || !labels[key]) continue;
        const pct = Math.round(value * 100);
        const row = document.createElement("div");
        row.className = "audit-bar-row";
        const head = document.createElement("div");
        head.className = "audit-bar-head";
        const name = document.createElement("span");
        name.textContent = labels[key];
        const num = document.createElement("b");
        num.className = "mono";
        num.textContent = String(pct);
        head.appendChild(name);
        head.appendChild(num);
        const track = document.createElement("div");
        track.className = "audit-bar-track";
        const fill = document.createElement("span");
        fill.className = "audit-bar-fill audit-bar-fill--" + bandFor(pct);
        fill.style.width = pct + "%";
        track.appendChild(fill);
        row.appendChild(head);
        row.appendChild(track);
        container.appendChild(row);
      }
      (container as HTMLElement).hidden = container.childElementCount === 0;
    }

    /** Render the headline timings as a stats grid. Hidden while the
     * record has no metrics (the estimate has none). */
    function renderStats(metrics: Record<string, string> | undefined, s: (typeof STR)[Lang]): void {
      const container = el("audit-stats");
      if (!container) return;
      container.innerHTML = "";
      const labels: Record<string, string> = {
        lcp: s.metricLcp,
        cls: s.metricCls,
        fcp: s.metricFcp,
        tbt: s.metricTbt,
        speed: s.metricSpeed,
      };
      const order = ["lcp", "fcp", "speed", "cls", "tbt"];
      for (const key of order) {
        const value = metrics?.[key];
        if (!value || !labels[key]) continue;
        const cell = document.createElement("div");
        cell.className = "audit-stat";
        const num = document.createElement("b");
        num.className = "mono";
        num.textContent = value;
        const label = document.createElement("span");
        label.textContent = labels[key];
        cell.appendChild(num);
        cell.appendChild(label);
        container.appendChild(cell);
      }
      (container as HTMLElement).hidden = container.childElementCount === 0;
    }

    /** Fill the full result in over the initial estimate: show the new
     * categories and findings at once, count the score up, then swap
     * the verdict and its colour. */
    function applyFull(full: Audit, s: (typeof STR)[Lang]): void {
      const scoreEl = el("audit-score");
      const from = scoreEl ? parseInt(scoreEl.textContent || "0", 10) || 0 : 0;
      const to = full.score;
      renderCategories(full.categories, s);
      renderStats(full.metrics, s);
      const strengthsTitle = el("audit-strengths-title");
      const strengths = el("audit-strengths");
      const strengthsCard = el("audit-strengths-card");
      if (strengthsTitle && strengths && strengthsCard) {
        strengthsCard.hidden = full.strengths.length === 0;
        if (full.strengths.length > 0) {
          strengthsTitle.textContent = s.strengthsTitle;
          fillList("audit-strengths", full.strengths);
        }
      }
      setText("audit-findings-title", s.findingsTitle);
      renderFindings(full, s);
      const partial = el("audit-partial");
      if (partial) {
        partial.hidden = !full.partial;
        if (full.partial) partial.textContent = s.partial;
      }
      const note = el("audit-estimate-note");
      if (note) note.hidden = !full.partial;
      const finish = (): void => {
        if (scoreEl) {
          scoreEl.classList.remove("audit-score--good", "audit-score--mid", "audit-score--low");
          scoreEl.classList.add("audit-score--" + bandFor(to));
        }
        setText("audit-verdict", verdictFor(to, s));
      };
      animateScore(from, to, finish);
    }

    async function main(): Promise<void> {
      const loading = document.querySelector("[data-audit-result-loading]");
      const page = document.querySelector("[data-audit-result-page]");
      const status = el("audit-status");
      const star = document.querySelector("[data-audit-result-star]");
      // The id is the segment after "audits", in /audits/<id> and /fr/audits/<id>.
      const parts = window.location.pathname.split("/").filter(Boolean);
      const auditIdx = parts.indexOf("audits");
      const id = auditIdx >= 0 && parts.length > auditIdx + 1 ? parts[auditIdx + 1] : "";
      const action = document.querySelector("[data-audit-result-action]");
      const actionLink = document.querySelector("[data-audit-result-action-link]") as HTMLAnchorElement | null;
      function showAction(s: (typeof STR)[Lang]): void {
        if (action) (action as HTMLElement).hidden = false;
        if (actionLink) {
          actionLink.textContent = s.backLink;
          actionLink.href = s.backHref;
        }
      }
      if (!id) {
        if (star) (star as HTMLElement).hidden = true;
        if (status) status.textContent = STR.en.noId;
        showAction(STR.en);
        return;
      }
      try {
        const res = await fetch("/api/audit/" + encodeURIComponent(id));
        const data = await res.json();
        if (!res.ok) throw new Error((data as { error?: string }).error || "Audit failed");
        const audit = (data as { audit: {
          url: string; score: number; findings: string[]; findingCodes: string[]; strengths: string[];
          categories: Record<string, number>; metrics: Record<string, string>;
          partial: boolean; pending: boolean; lang: Lang; at: number;
        } }).audit;
        const lang: Lang = audit.lang === "fr" ? "fr" : "en";
        const s = STR[lang];
        setText("audit-title", s.title);
        setText("audit-eyebrow", s.title);
        setText("audit-url", audit.url);
        const scoreEl = el("audit-score");
        if (scoreEl) {
          scoreEl.textContent = "0";
          scoreEl.classList.add("audit-score--" + bandFor(audit.score));
          animateScore(0, audit.score);
        }
        setText("audit-verdict", verdictFor(audit.score, s));
        const pricing = el("audit-pricing-link") as HTMLAnchorElement | null;
        if (pricing) {
          pricing.textContent = s.pricingCta;
          pricing.href = s.pricingHref;
        }
        const partial = el("audit-partial");
        if (partial) {
          partial.hidden = !audit.partial;
          if (audit.partial) partial.textContent = s.partial;
        }
        // The initial report's values are estimates: say so in small
        // print at the bottom of the page while the record is partial.
        const note = el("audit-estimate-note");
        if (note) note.hidden = !audit.partial;
        renderCategories(audit.categories, s);
        renderStats(audit.metrics, s);
        const strengthsTitle = el("audit-strengths-title");
        const strengths = el("audit-strengths");
        const strengthsCard = el("audit-strengths-card");
        if (strengthsTitle && strengths && strengthsCard) {
          strengthsCard.hidden = audit.strengths.length === 0;
          if (audit.strengths.length > 0) {
            strengthsTitle.textContent = s.strengthsTitle;
            fillList("audit-strengths", audit.strengths);
          }
        }
        setText("audit-findings-title", s.findingsTitle);
        setText("audit-findings-note", s.findingsNote);
        renderFindings(audit, s);
        const fixStart = el("audit-fix-start") as HTMLAnchorElement | null;
        if (fixStart) {
          fixStart.textContent = s.getStarted;
          fixStart.href = s.getStartedHref;
        }
        setText("audit-report-eyebrow", s.reportEyebrow);
        setText("audit-report-title", s.reportTitle);
        setText("audit-report-sub", s.reportSub);
        setText("audit-report-label", s.reportLabel);
        setText("audit-report-button", s.reportButton);
        const back = el("audit-back-link") as HTMLAnchorElement | null;
        if (back) {
          back.textContent = s.backLink;
          back.href = s.backHref;
        }
        if (loading) (loading as HTMLElement).hidden = true;
        if (page) (page as HTMLElement).hidden = false;

        const form = el("report-form") as HTMLFormElement | null;
        if (form) {
          form.addEventListener("submit", async (e: SubmitEvent) => {
            e.preventDefault();
            const input = el("report-email") as HTMLInputElement | null;
            const email = input ? input.value.trim() : "";
            const reportStatus = el("report-status");
            if (reportStatus) reportStatus.textContent = s.sending;
            try {
              const r = await fetch("/api/audit/report", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id, email }),
              });
              const d = await r.json();
              if (!r.ok) throw new Error((d as { error?: string }).error || "Report request failed");
              if (reportStatus) reportStatus.textContent = s.done;
            } catch (err) {
              if (reportStatus) reportStatus.textContent = s.failed;
            }
          });
        }

        // The full audit is still running: show the countdown and the
        // subtle bar, trigger it, and fill the result in when it lands.
        // A single slow PageSpeed run must not strand the page: if one
        // /full call fails or the record is still pending, poll the
        // record and try again, for up to 10 minutes. If it never
        // lands, the initial estimate stays as it is.
        if (audit.pending) {
          const strip = document.querySelector("[data-audit-pending-strip]");
          const countdownEl = el("audit-countdown");
          const fillEl = document.querySelector("[data-audit-pending-fill]") as HTMLElement | null;
          if (strip) (strip as HTMLElement).hidden = false;
          const ESTIMATE_MS = 180_000;
          // Anchor the countdown and the bar to when the audit was
          // created, not to this page load, so a reload picks the
          // countdown up where it was instead of restarting it.
          const anchorMs = typeof audit.at === "number" ? audit.at : Date.now();
          const fmt = (ms: number): string => {
            const total = Math.max(0, Math.ceil(ms / 1000));
            return Math.floor(total / 60) + ":" + String(total % 60).padStart(2, "0");
          };
          const tick = (): void => {
            const elapsed = Date.now() - anchorMs;
            const remaining = ESTIMATE_MS - elapsed;
            if (countdownEl) countdownEl.textContent = remaining > 0 ? s.countdown + " " + fmt(remaining) : s.almostThere;
            if (fillEl) fillEl.style.width = Math.min(100, (elapsed / ESTIMATE_MS) * 100) + "%";
          };
          tick();
          const timer = window.setInterval(tick, 1000);
          try {
            const deadline = Date.now() + 600_000;
            let full: Audit | null = null;
            while (!full && Date.now() < deadline) {
              try {
                const rec = await runFullAudit(id);
                if (rec && !rec.pending) full = rec;
              } catch {
                // The /full call failed or timed out: fall through to polling.
              }
              if (full) break;
              // Poll the record for a minute: a server-side run may
              // still be finishing (the lock stops a duplicate run
              // while it is).
              const pollUntil = Date.now() + 60_000;
              while (!full && Date.now() < pollUntil && Date.now() < deadline) {
                await new Promise((r) => window.setTimeout(r, 5000));
                try {
                  const g = await fetch("/api/audit/" + encodeURIComponent(id));
                  if (g.ok) {
                    const gd = await g.json();
                    const polled = (gd as { audit?: Audit }).audit;
                    if (polled && !polled.pending) full = polled;
                  }
                } catch {
                  // Keep polling.
                }
              }
              // Still pending: loop and call /full again. By now the
              // server-side lock has expired, so a dead run is retried.
            }
            if (full) applyFull(full, s);
          } finally {
            window.clearInterval(timer);
            if (strip) (strip as HTMLElement).hidden = true;
          }
        }
      } catch (err) {
        if (star) (star as HTMLElement).hidden = true;
        if (status) status.textContent = STR.en.notFound;
        showAction(STR.en);
      }
    }

    void main();

    // Revisiting a completed audit must show the result, not the
    // loading state forever. When the browser restores this page
    // from its back/forward cache, the script does not run again, so
    // a page left while it was loading stays stuck on "Loading your
    // audit". Reloading on a cached restore re-runs the load and
    // renders the stored result.
    window.addEventListener("pageshow", (event: PageTransitionEvent) => {
      if (event.persisted) window.location.reload();
    });
  </script>

