---
// WEBAO audit page (FR) — page d'audit gratuit.
// Live at /fr/eval. Version anglaise : src/pages/audit.astro, même
// structure, texte anglais. À l'envoi, la page est remplacée par
// l'écran de chargement avec l'étoile, puis le visiteur est redirigé
// vers /audits/<id> quand l'audit est terminé. Le formulaire de
// rapport est sur la page de résultats.
import BaseLayout from "../../layouts/BaseLayout.astro";
import StarMark from "../../components/ui/StarMark.astro";
---

<BaseLayout title="Audit gratuit de site web · Webao" description="Voyez comment votre site web se classe, et quoi corriger en premier. Gratuit, sans obligation." locale="fr" pageKey="audit">
  <div data-audit-page>
    <section class="audit-hero grain">
      <div class="shell audit-hero-inner">
        <div class="audit-title-row">
          <span class="audit-hero-star audit-hero-star--left" aria-hidden="true"><StarMark /></span>
          <h1 class="display audit-title">Audit gratuit de site web</h1>
          <span class="audit-hero-star audit-hero-star--right" aria-hidden="true"><StarMark /></span>
        </div>
        <p class="audit-sub">Entrez le site web de votre entreprise. Vous obtenez un score instantané et les premières choses à corriger, gratuitement, sans obligation.</p>
        <form id="audit-form" class="audit-form" novalidate>
          <label class="visually-hidden" for="audit-url">Your website</label>
          <input id="audit-url" name="url" type="text" inputmode="url" autocomplete="url" placeholder="webao.ca" required />
          <button type="submit" class="btn btn--primary btn--lg">Lancer mon audit gratuit</button>
        </form>
        <p id="audit-status" class="audit-status" aria-live="polite"></p>
        <p class="audit-note">Nous vérifions la vitesse, l'accessibilité, les bonnes pratiques et la visibilité dans les recherches avec un test de vitesse indépendant, ainsi que les bases (HTTPS, affichage mobile, titre et description) quand ce test n'est pas disponible. Nous ne partageons jamais votre résultat.</p>
      </div>
    </section>

    <section class="audit-band grain" aria-labelledby="audit-band-h">
      <div class="shell audit-band-inner">
        <div>
          <p class="eyebrow audit-band-eyebrow">Prochaine étape</p>
          <h2 id="audit-band-h" class="display audit-band-title">Vous voulez qu'on corrige ça?</h2>
        </div>
        <a href="/fr/commencer" class="btn btn--on-dark btn--lg">Démarrer un projet</a>
      </div>
    </section>
  </div>

  <!-- Écran de chargement : remplace toute la page pendant l'audit.
    L'étoile tourne de 360 degrés en 0,75 s sur une courbe
    exponentielle, reste immobile 0,75 s, puis recommence. La barre est
    une fausse barre de progression : elle avance par pas imprévisibles
    qui diminuent à mesure qu'elle se remplit, sans jamais dépasser
    92 % avant l'arrivée du vrai résultat. Derrière, des orbes en
    dégradé qui dérivent, des étincelles qui scintillent et une lueur
    qui pulse gardent le fond en mouvement. -->
  <div class="audit-loading grain" data-audit-loading hidden>
    <div class="audit-loading-fx" aria-hidden="true">
      <span class="audit-orb audit-orb--a"></span>
      <span class="audit-orb audit-orb--b"></span>
      <span class="audit-orb audit-orb--c"></span>
      <span class="audit-sparkle" style="left:6%;top:12%;--s:18px;--d:0s;--t:2.6s"></span>
      <span class="audit-sparkle" style="left:12%;top:38%;--s:12px;--d:.7s;--t:3.1s"></span>
      <span class="audit-sparkle" style="left:8%;top:68%;--s:22px;--d:1.2s;--t:2.4s"></span>
      <span class="audit-sparkle" style="left:18%;top:88%;--s:14px;--d:.3s;--t:3.4s"></span>
      <span class="audit-sparkle" style="left:28%;top:8%;--s:12px;--d:1.6s;--t:2.8s"></span>
      <span class="audit-sparkle" style="left:88%;top:10%;--s:20px;--d:.5s;--t:2.5s"></span>
      <span class="audit-sparkle" style="left:92%;top:42%;--s:12px;--d:1.1s;--t:3.2s"></span>
      <span class="audit-sparkle" style="left:85%;top:72%;--s:24px;--d:.2s;--t:2.7s"></span>
      <span class="audit-sparkle" style="left:78%;top:90%;--s:14px;--d:1.4s;--t:3s"></span>
      <span class="audit-sparkle" style="left:38%;top:92%;--s:16px;--d:.9s;--t:2.9s"></span>
      <span class="audit-sparkle" style="left:62%;top:6%;--s:14px;--d:1.8s;--t:2.6s"></span>
      <span class="audit-sparkle" style="left:48%;top:18%;--s:10px;--d:.4s;--t:3.3s"></span>
    </div>
    <div class="audit-loading-inner">
      <span class="audit-loading-glow" aria-hidden="true"></span>
      <span class="audit-loading-star" aria-hidden="true"><StarMark /></span>
      <div class="audit-loading-bar" role="progressbar" aria-label="Audit en cours">
        <div class="audit-loading-fill" data-audit-fill></div>
      </div>
      <p class="audit-loading-status" data-audit-loading-status aria-live="polite">Audit en cours…</p>
    </div>
  </div>

  <script data-astro-rerun>
    // Plain JavaScript on purpose: with data-astro-rerun, astro check
    // treats this block as JS, and any TypeScript annotation in it fails
    // the deploy. Same pattern as the pricing page script.
    function normalizeAuditUrl(raw) {
      var value = (raw || "").trim();
      if (!value) return "";
      if (/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) return value;
      if (value.indexOf("//") === 0) return "https:" + value;
      return "https://" + value;
    }
    function initAudit() {
      var page = document.querySelector("[data-audit-page]");
      var loading = document.querySelector("[data-audit-loading]");
      var form = document.getElementById("audit-form");
      var input = document.getElementById("audit-url");
      var status = document.getElementById("audit-status");
      var fill = document.querySelector("[data-audit-fill]");
      var loadStatus = document.querySelector("[data-audit-loading-status]");
      if (!form || !input || !page || !loading || !fill) return;
      if (form.dataset.auditInit === "1") return;
      form.dataset.auditInit = "1";
      // Reset in case the visitor came back here from the result page:
      // the static HTML starts clean, but a restored page may not.
      page.hidden = false;
      loading.hidden = true;
      fill.style.width = "0%";
      // The status lines never repeat: the four expected ones play first,
      // in order, then the funny ones take over if the audit drags on.
      // When the list runs out the timer stops on the last line.
      var lines = [
        "Test de vitesse en cours…",
        "Vérification de l'accessibilité…",
        "Vérification de la visibilité…",
        "Préparation de votre score…",
        "On polit les pixels…",
        "On demande gentiment au serveur…",
        "On apprend au site à se dépêcher…",
        "On compte les fenêtres pop-up…",
        "On consulte les hamsters de l'internet…",
        "On mesure les mégaoctets…",
        "On démêle le CSS…",
        "Ça prend du temps. Votre site a beaucoup à dire…",
      ];
      var timer = null;
      var stageTimer = null;
      var progress = 0;
      var busy = false;
      function startFakeBar() {
        progress = 4;
        fill.style.width = progress + "%";
        var line = 0;
        if (loadStatus) loadStatus.textContent = lines[0];
        // Unpredictable steps at unpredictable intervals, shrinking as
        // the bar fills, capped at 92% until the real result lands.
        var tick = function () {
          var step = (2 + Math.random() * 7) * (1 - progress / 110);
          progress = Math.min(92, progress + step);
          fill.style.width = progress + "%";
          timer = window.setTimeout(tick, 180 + Math.random() * 380);
        };
        timer = window.setTimeout(tick, 180 + Math.random() * 380);
        stageTimer = window.setInterval(function () {
          line += 1;
          if (line >= lines.length) {
            window.clearInterval(stageTimer);
            return;
          }
          if (loadStatus) loadStatus.textContent = lines[line];
        }, 2600);
      }
      function stopFakeBar() {
        window.clearTimeout(timer);
        window.clearInterval(stageTimer);
      }
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        if (busy) return;
        var url = normalizeAuditUrl(input.value);
        if (!url) {
          if (status) status.textContent = "Entrez l'adresse de votre site web, par exemple webao.ca.";
          input.focus();
          return;
        }
        busy = true;
        if (status) status.textContent = "";
        page.hidden = true;
        loading.hidden = false;
        startFakeBar();
        fetch("/api/audit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url: url, lang: "fr" }),
        })
          .then(function (res) {
            return res.json().then(function (data) { return { res: res, data: data }; });
          })
          .then(function (pair) {
            if (!pair.res.ok || !pair.data.resultUrl) {
              var err = new Error((pair.data && pair.data.error) || "Audit failed");
              err.status = pair.res.status;
              throw err;
            }
            stopFakeBar();
            fill.style.width = "100%";
            window.setTimeout(function () { window.location.href = pair.data.resultUrl; }, 350);
          })
          .catch(function (err) {
            stopFakeBar();
            busy = false;
            loading.hidden = true;
            page.hidden = false;
            fill.style.width = "0%";
            if (status) status.textContent = err && err.status === 503 ? "Le service d'audit est temporairement indisponible. Veuillez réessayer dans quelques instants." : "L'audit n'a pas abouti. Vérifiez l'URL et réessayez.";
            input.focus();
          });
      });
    }
    initAudit();
    if (!window.__webaoAuditPL) {
      window.__webaoAuditPL = true;
      document.addEventListener("astro:page-load", initAudit);
    }
  </script>

  <style>
    .audit-hero {
      position: relative;
      overflow: clip;
      padding-block: clamp(40px, 7vw, 88px) clamp(32px, 5vw, 64px);
      background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
      border-bottom: 1px solid var(--line);
      text-align: center;
    }
    .audit-hero-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .audit-title-row {
      position: relative;
      display: flex;
      align-items: center;
      align-self: stretch;
      justify-content: center;
    }
    .audit-title {
      font-size: clamp(2.6rem, 6vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.02em;
      text-align: center;
    }
    /* Same star as the pricing hero: ink on the left, accent on the
       right, shifted about 40% off the screen edge. The hero clips
       the overflow, so no horizontal scroll. */
    .audit-hero-star {
      --star: clamp(120px, 16vw, 200px);
      position: absolute;
      top: 50%;
      width: var(--star);
      height: var(--star);
      pointer-events: none;
    }
    .audit-hero-star :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }
    .audit-hero-star--left { left: calc((100% - 100vw) / 2 - var(--star) * 0.4); color: var(--ink); opacity: 0.9; transform: translateY(-50%) rotate(-18deg); }
    .audit-hero-star--right { right: calc((100% - 100vw) / 2 - var(--star) * 0.4); color: var(--accent-mid); transform: translateY(-50%) rotate(22deg); }
    @media (max-width: 640px) {
      .audit-hero-star { --star: 80px; }
    }
    .audit-sub {
      max-width: 560px;
      margin: 20px auto 0;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.5;
    }
    .audit-form {
      display: flex;
      gap: 10px;
      width: min(640px, 100%);
      margin: 28px auto 0;
    }
    .audit-form input {
      flex: 1 1 auto;
      min-width: 0;
      padding: 14px 18px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: var(--card-bg);
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .audit-form input:focus {
      outline: none;
      border-color: var(--ink);
      box-shadow: 0 0 0 3px var(--focus-ring);
    }
    .audit-form input::placeholder { color: var(--muted); }
    @media (max-width: 640px) {
      .audit-form { flex-direction: column; }
      .audit-form .btn { width: 100%; }
    }
    .audit-status {
      min-height: 1.5em;
      margin: 14px 0 0;
      color: var(--error-text);
      font-size: 0.95rem;
    }
    .audit-note {
      max-width: 640px;
      margin: 24px auto 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }
    .audit-band {
      background: var(--section-dark-bg);
      color: var(--section-dark-text);
      padding-block: clamp(48px, 7vw, 88px);
    }
    .audit-band-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      align-items: center;
      justify-content: space-between;
    }
    .audit-band-eyebrow { color: rgba(248, 245, 239, 0.5); }
    .audit-band-title {
      font-size: clamp(2rem, 4.6vw, 3.4rem);
      line-height: 0.95;
      margin-top: 10px;
    }
    /* Loading screen: covers the whole viewport, paper gradient, star
       above the bar. The star spins 360 degrees in 0.75s on the
       exponential curve, then holds still for 0.75s: one 1.5s cycle.
       Behind it: three drifting gradient orbs, twinkling sparkles and
       a pulsing glow around the star, plus a shimmer sweeping the bar. */
    .audit-loading {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
      overflow: clip;
    }
    .audit-loading[hidden] { display: none; }
    .audit-loading-fx {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .audit-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(48px);
      opacity: 0.5;
    }
    .audit-orb--a {
      width: 420px;
      height: 420px;
      left: -8%;
      top: 4%;
      background: radial-gradient(circle, var(--bblob-a), transparent 70%);
      animation: audit-orb-drift-a 17s ease-in-out infinite alternate;
    }
    .audit-orb--b {
      width: 380px;
      height: 380px;
      right: -6%;
      bottom: 2%;
      background: radial-gradient(circle, var(--bblob-c), transparent 70%);
      animation: audit-orb-drift-b 14s ease-in-out infinite alternate;
    }
    .audit-orb--c {
      width: 300px;
      height: 300px;
      right: 22%;
      top: -10%;
      background: radial-gradient(circle, var(--bblob-b), transparent 70%);
      opacity: 0.35;
      animation: audit-orb-drift-c 20s ease-in-out infinite alternate;
    }
    @keyframes audit-orb-drift-a {
      from { transform: translate(0, 0) scale(1); }
      to { transform: translate(70px, 90px) scale(1.15); }
    }
    @keyframes audit-orb-drift-b {
      from { transform: translate(0, 0) scale(1.1); }
      to { transform: translate(-80px, -70px) scale(0.95); }
    }
    @keyframes audit-orb-drift-c {
      from { transform: translate(0, 0) rotate(0deg); }
      to { transform: translate(-60px, 110px) rotate(12deg); }
    }
    .audit-sparkle {
      position: absolute;
      width: var(--s, 14px);
      height: var(--s, 14px);
      background: var(--accent);
      clip-path: polygon(50% 0, 63% 37%, 100% 50%, 63% 63%, 50% 100%, 37% 63%, 0 50%, 37% 37%);
      opacity: 0;
      animation: audit-sparkle-twinkle var(--t, 2.8s) ease-in-out var(--d, 0s) infinite;
    }
    .audit-sparkle:nth-child(even) { background: var(--accent-mid); }
    @keyframes audit-sparkle-twinkle {
      0%, 100% { opacity: 0; transform: scale(0.5) rotate(0deg); }
      50% { opacity: 0.9; transform: scale(1) rotate(45deg); }
    }
    .audit-loading-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px;
    }
    .audit-loading-glow {
      position: absolute;
      top: -48px;
      left: 50%;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--accent-glow), transparent 65%);
      filter: blur(12px);
      transform: translateX(-50%);
      animation: audit-glow-pulse 3s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes audit-glow-pulse {
      0%, 100% { opacity: 0.55; transform: translateX(-50%) scale(0.95); }
      50% { opacity: 1; transform: translateX(-50%) scale(1.06); }
    }
    .audit-loading-star {
      width: clamp(96px, 18vw, 140px);
      height: clamp(96px, 18vw, 140px);
      color: var(--accent);
      animation: audit-star-spin 1.5s infinite;
    }
    .audit-loading-star :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }
    @keyframes audit-star-spin {
      0% { transform: rotate(0deg); animation-timing-function: var(--ease-out-expo); }
      50% { transform: rotate(360deg); animation-timing-function: linear; }
      100% { transform: rotate(360deg); }
    }
    /* The shimmer is tied to the bar (the track), never to the fill:
       it sweeps the whole bar width on a fixed loop, so its geometry
       never changes when the fill steps forward and there is nothing
       to jump. At each end of the sweep it is fully off the bar, so
       the wrap back to the start is invisible. */
    .audit-loading-bar {
      position: relative;
      width: min(480px, 80vw);
      height: 10px;
      margin-top: 36px;
      border-radius: 999px;
      background: var(--line);
      overflow: hidden;
    }
    .audit-loading-bar::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: translateX(-100%);
      animation: audit-bar-shimmer 1.8s linear infinite;
      pointer-events: none;
    }
    .audit-loading-fill {
      height: 100%;
      width: 0%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--accent), var(--accent-mid));
      transition: width 240ms ease;
    }
    @keyframes audit-bar-shimmer {
      to { transform: translateX(100%); }
    }
    .audit-loading-status {
      margin: 18px 0 0;
      color: var(--muted);
      font-size: 0.95rem;
      text-align: center;
    }
    @media (prefers-reduced-motion: reduce) {
      .audit-loading-star,
      .audit-orb,
      .audit-sparkle,
      .audit-loading-glow,
      .audit-loading-bar::after { animation: none; }
      .audit-sparkle { opacity: 0.5; }
    }
  </style>
</BaseLayout>
