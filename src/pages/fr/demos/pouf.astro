---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : Pouf Studio, studio fictif de design de personnages 3D et jouets, Montréal.
// Direction artistique autonome : claymorphism. Pastel, gonflé, moelleux. Non liée au système de thème WEBAO.
const IMG = {
  hero: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1600&auto=format&fit=crop",
  boba: "/demos/pouf/01.jpg",
  pup: "/demos/pouf/02.jpg",
  bot: "/demos/pouf/03.jpg",
  cat: "/demos/pouf/04.jpg",
  lab: "https://images.unsplash.com/photo-1558060370-d644479cb6f7?q=80&w=800&auto=format&fit=crop",
  extra: "https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pouf Studio : Personnages 3D moelleux et jouets design</title>
  <meta name="description" content="Pouf Studio designe des personnages 3D doux et dodus et des jouets design à Montréal. Sculpter, tripoter, expédier." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="pf">

  <!-- NAV -->
  <header class="pf-navwrap">
    <nav class="pf-nav" aria-label="Navigation principale">
      <a class="pf-logo" href="#top" aria-label="Pouf Studio, accueil">
        <span class="pf-logo-blob" aria-hidden="true"></span>pouf studio
      </a>
      <div class="pf-nav-links" id="pf-menu">
        <a href="#toys">Jouets</a>
        <a href="#process">Processus</a>
        <a href="#pricing">Tarifs</a>
        <a href="#contact">Contact</a>
      </div>
      <a class="pf-btn pf-btn-small pf-cta" href="#contact">Lancer un projet</a>
      <button class="pf-burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="pf-menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="pf-hero">
      <div class="pf-blob pf-blob-1" aria-hidden="true"></div>
      <div class="pf-blob pf-blob-2" aria-hidden="true"></div>
      <div class="pf-blob pf-blob-3" aria-hidden="true"></div>
      <div class="pf-blob pf-blob-4" aria-hidden="true"></div>
      <div class="pf-wrap pf-hero-in">
        <div class="pf-hero-copy">
          <p class="pf-pill">STUDIO DE DESIGN 3D + JOUETS · MONTRÉAL</p>
          <h1 class="pf-h1">On crée des jouets <span class="pf-h1-pop">à serrer très fort.</span></h1>
          <p class="pf-lede">Pouf Studio, c'est une équipe montréalaise de sculpteurs, de peintres et de testeurs professionnels de moelleux. On transforme vos idées les plus folles en personnages doux, dodus et prêts pour les étagères, pour les marques, les jeux et les collectionneurs.</p>
          <div class="pf-hero-cta">
            <a class="pf-btn pf-btn-peach" href="#toys">Voir les jouets</a>
            <a class="pf-btn pf-btn-mint" href="#contact">Lancer votre projet</a>
          </div>
          <dl class="pf-hero-facts">
            <div><dt>240+</dt><dd>personnages livrés</dd></div>
            <div><dt>38</dt><dd>collabos de marques</dd></div>
            <div><dt>0</dt><dd>angle vif, jamais</dd></div>
          </dl>
        </div>
        <div class="pf-hero-art">
          <div class="pf-hero-frame">
            <img src={IMG.hero} alt="Formes 3D pastel douces dans le style Pouf Studio" loading="eager" fetchpriority="high" />
          </div>
          <div class="pf-sticker pf-sticker-1" aria-hidden="true">100 % moelleux</div>
          <div class="pf-sticker pf-sticker-2" aria-hidden="true">dodu par design</div>
        </div>
      </div>
    </section>

    <!-- TICKER -->
    <div class="pf-ticker" aria-hidden="true">
      <div class="pf-ticker-track">
        <span>Sculpter</span><i>✦</i><span>Tripoter</span><i>✦</i><span>Expédier</span><i>✦</i><span>Peint à la main</span><i>✦</i><span>Dodu par design</span><i>✦</i>
        <span>Sculpter</span><i>✦</i><span>Tripoter</span><i>✦</i><span>Expédier</span><i>✦</i><span>Peint à la main</span><i>✦</i><span>Dodu par design</span><i>✦</i>
      </div>
    </div>

    <!-- GALERIE -->
    <section class="pf-section" id="toys">
      <div class="pf-wrap">
        <p class="pf-kicker">Frais sortis du labo à moelleux</p>
        <h2 class="pf-h2">Nos récents <span class="pf-h2-pop">copains dodus</span></h2>
        <div class="pf-toys">
          <article class="pf-toy pf-tint-peach">
            <div class="pf-toy-img"><img src={IMG.boba} alt="Bulle Boba, figurine vinyle pastel et douce" loading="lazy" /></div>
            <h3>Bulle Boba</h3>
            <p>Figurine vinyle pour une marque de thé aux perles. Épuisée en 9 minutes. On est encore un peu fiers.</p>
            <p class="pf-toy-tag">Vinyle · 12 cm</p>
          </article>
          <article class="pf-toy pf-tint-lav">
            <div class="pf-toy-img"><img src={IMG.pup} alt="Chiot Nuage, personnage en peluche pastel" loading="lazy" /></div>
            <h3>Chiot Nuage</h3>
            <p>Mascotte en peluche pour une appli de sommeil. Testée par 40 tout-petits et un corgi très sérieux.</p>
            <p class="pf-toy-tag">Peluche · 30 cm</p>
          </article>
          <article class="pf-toy pf-tint-mint">
            <div class="pf-toy-img"><img src={IMG.bot} alt="Mochi Bot, robot jouet designer tout en rondeurs" loading="lazy" /></div>
            <h3>Mochi Bot</h3>
            <p>Robot designer pour un lancement de jeu. Note de moelleux : 9,4 sur 10. Bip boup.</p>
            <p class="pf-toy-tag">Résine · 15 cm</p>
          </article>
          <article class="pf-toy pf-tint-sky">
            <div class="pf-toy-img"><img src={IMG.cat} alt="Chat Flan, jouet chat en forme de flan tout doux" loading="lazy" /></div>
            <h3>Chat Flan</h3>
            <p>Copain de bureau pour une fintech qui voulait avoir l'air moins fintech. Mission accomplie.</p>
            <p class="pf-toy-tag">Sofubi · 10 cm</p>
          </article>
        </div>
      </div>
    </section>

    <!-- PROCESSUS -->
    <section class="pf-section pf-section-alt" id="process">
      <div class="pf-wrap">
        <p class="pf-kicker">Comment la magie opère</p>
        <h2 class="pf-h2">Sculpter. Tripoter. <span class="pf-h2-pop">Expédier.</span></h2>
        <div class="pf-steps">
          <article class="pf-step pf-tint-peach">
            <span class="pf-step-n" aria-hidden="true">1</span>
            <h3>Sculpter</h3>
            <p>On dessine, on modélise et on imprime votre personnage en 3D. Vous recevez des aperçus chaque semaine et un nombre illimité de tours de « et si c'était plus rond ? ».</p>
          </article>
          <article class="pf-step pf-tint-lav">
            <span class="pf-step-n" aria-hidden="true">2</span>
            <h3>Tripoter</h3>
            <p>Les prototypes sont tripotés, lâchés, câlinés et mâchouillés (par le corgi) jusqu'à ce que le facteur moelleux soit scientifiquement parfait.</p>
          </article>
          <article class="pf-step pf-tint-mint">
            <span class="pf-step-n" aria-hidden="true">3</span>
            <h3>Expédier</h3>
            <p>Maîtres de peinture, emballage et soutien à la production. Votre jouet part conquérir le monde, prêt pour les étagères et les bureaux.</p>
          </article>
        </div>
        <div class="pf-lab">
          <img src={IMG.lab} alt="Prototypes de jouets colorés alignés dans le labo Pouf Studio" loading="lazy" />
          <div>
            <h3>Dans le labo à moelleux</h3>
            <p>Notre studio du Mile End abrite deux imprimantes 3D, une cabine de peinture qui sent vaguement la vanille et une étagère de plus de 200 blobs de référence. Venez nous voir. Apportez des collations.</p>
            <img class="pf-lab-small" src={IMG.extra} alt="Gros plan sur des matériaux de sculpture pastel" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- TÉMOIGNAGES -->
    <section class="pf-section" id="love">
      <div class="pf-wrap">
        <p class="pf-kicker">Des mots doux de clients doux</p>
        <h2 class="pf-h2">Les gens <span class="pf-h2-pop">adorent</span> le pouf</h2>
        <div class="pf-quotes">
          <blockquote class="pf-quote pf-tint-sky">
            <p>« Pouf a transformé notre mascotte ennuyeuse en peluche que les gens s'arrachent dans les salons. Notre kiosque n'a jamais été aussi câlinable. »</p>
            <cite>Maya R., directrice de marque</cite>
          </blockquote>
          <blockquote class="pf-quote pf-tint-peach">
            <p>« Ils ont demandé "et si c'était plus rond ?" dix-sept fois. La dix-septième fois était la bonne. Notre sociofinancement a été bouclé en un jour. »</p>
            <cite>Devon K., dev de jeux indépendant</cite>
          </blockquote>
          <blockquote class="pf-quote pf-tint-mint">
            <p>« Le prototype est arrivé et tout le bureau a arrêté de travailler pour le tripoter. Chaque centime en valait la peine. Dix sur dix, je retripoterais. »</p>
            <cite>Léa T., fondatrice de startup</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- TARIFS -->
    <section class="pf-section pf-section-alt" id="pricing">
      <div class="pf-wrap">
        <p class="pf-kicker">Choisissez votre gonflé</p>
        <h2 class="pf-h2">Forfaits <span class="pf-h2-pop">moelleux</span></h2>
        <div class="pf-plans">
          <article class="pf-plan pf-tint-lav">
            <h3>Mini Dodu</h3>
            <p class="pf-price">2 900 $</p>
            <p class="pf-plan-sub">Pour tâter le terrain</p>
            <ul>
              <li>Concept du personnage + vues</li>
              <li>Modèle 3D détaillé</li>
              <li>2 rondes de révisions</li>
              <li>Rapport de moelleux (officiel)</li>
            </ul>
            <a class="pf-btn pf-btn-peach" href="#contact">Choisir Mini Dodu</a>
          </article>
          <article class="pf-plan pf-plan-hot pf-tint-peach">
            <p class="pf-plan-badge">Le plus tripoté</p>
            <h3>Dodu</h3>
            <p class="pf-price">7 500 $</p>
            <p class="pf-plan-sub">Notre forfait signature</p>
            <ul>
              <li>Tout du Mini Dodu</li>
              <li>Prototype physique</li>
              <li>Maître de peinture à la main</li>
              <li>Design d'emballage</li>
              <li>Test de mastication du corgi inclus</li>
            </ul>
            <a class="pf-btn pf-btn-plum" href="#contact">Choisir Dodu</a>
          </article>
          <article class="pf-plan pf-tint-mint">
            <h3>Méga Dodu</h3>
            <p class="pf-price">18 000 $</p>
            <p class="pf-plan-sub">Soutien complet à la production</p>
            <ul>
              <li>Tout du Dodu</li>
              <li>Liaison usine + contrôle qualité</li>
              <li>Visuels de campagne de lancement</li>
              <li>Variante édition collector</li>
            </ul>
            <a class="pf-btn pf-btn-peach" href="#contact">Choisir Méga Dodu</a>
          </article>
        </div>
        <p class="pf-plans-note">Chaque forfait inclut un nombre illimité de questions « et si c'était plus rond ? ». Pour vrai.</p>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="pf-section" id="contact">
      <div class="pf-wrap pf-contact-in">
        <div class="pf-contact-copy">
          <p class="pf-kicker">Dites bonjour</p>
          <h2 class="pf-h2">Prêt à devenir <span class="pf-h2-pop">moelleux ?</span></h2>
          <p class="pf-lede-small">Parlez-nous de votre personnage, de votre marque ou de votre idée magnifiquement bizarre. On répond en deux jours ouvrables, généralement avec un croquis.</p>
          <ul class="pf-contact-list">
            <li><strong>Studio</strong> 418 Rue Imaginaire, Montréal QC</li>
            <li><strong>Téléphone</strong> <a href="tel:+15145550142">(514) 555-0142</a></li>
            <li><strong>Courriel</strong> <a href="mailto:hello@pouf.studio">hello@pouf.studio</a></li>
            <li><strong>Heures</strong> Lun au ven, 9 h à 18 h</li>
          </ul>
        </div>
        <form class="pf-form" id="pf-form" novalidate>
          <h3>Lancez votre projet</h3>
          <label>Nom<input type="text" name="name" required placeholder="Sam Gonflé" /></label>
          <label>Courriel<input type="email" name="email" required placeholder="sam@exemple.com" /></label>
          <label>Type de jouet
            <select name="type">
              <option>Figurine vinyle</option>
              <option>Peluche</option>
              <option>Résine / sofubi</option>
              <option>Mascotte pour ma marque</option>
              <option>Quelque chose de glorieusement bizarre</option>
            </select>
          </label>
          <label>Racontez-nous tout<textarea name="message" rows="4" placeholder="Mon personnage est un sorcier croissant endormi qui..."></textarea></label>
          <button class="pf-btn pf-btn-plum" type="submit">Envoyer au labo</button>
          <p class="pf-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="pf-footer">
    <div class="pf-wrap">
      <p class="pf-footer-logo" aria-hidden="true">pouf !</p>
      <p>© 2026 Pouf Studio. Démo fictive. Aucun jouet n'a été blessé (le corgi a essayé).</p>
      <p>418 Rue Imaginaire, Montréal QC · <a href="tel:+15145550142">(514) 555-0142</a> · <a href="mailto:hello@pouf.studio">hello@pouf.studio</a></p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    // Formulaire de démo : ne s'envoie nulle part. Bascule du menu mobile.
    (function () {
      var form = document.getElementById('pf-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.pf-form-note');
        if (note) note.textContent = 'Moelleux reçu ! On vous répond en deux jours ouvrables, croquis en main.';
        form?.reset();
      });
      var burger = document.querySelector('.pf-burger') as HTMLButtonElement | null;
      var menu = document.getElementById('pf-menu');
      burger?.addEventListener('click', function () {
        var open = menu?.classList.toggle('pf-open') ?? false;
        burger?.setAttribute('aria-expanded', String(open));
        burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      });
      menu?.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          menu?.classList.remove('pf-open');
          burger?.setAttribute('aria-expanded', 'false');
          burger?.setAttribute('aria-label', 'Ouvrir le menu');
        });
      });
    })();
  </script>

  <style>
    .pf {
      --pf-cream: #FFF6EC;
      --pf-peach: #FFD9C0;
      --pf-lav: #DCC9FF;
      --pf-mint: #C4F0D4;
      --pf-sky: #C4E3FF;
      --pf-plum: #6C4AB0;
      --pf-ink: #4A3B32;
      --pf-ink-soft: #7A665C;
      --pf-display: "Baloo 2", "Comic Sans MS", cursive;
      --pf-body: "Quicksand", system-ui, sans-serif;
      margin: 0;
      background: var(--pf-cream);
      color: var(--pf-ink);
      font-family: var(--pf-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .pf *, .pf *::before, .pf *::after { box-sizing: border-box; }
    .pf img { display: block; max-width: 100%; }
    .pf-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }

    /* ombres argile */
    .pf-btn, .pf-toy, .pf-step, .pf-plan, .pf-quote, .pf-form, .pf-hero-frame, .pf-pill, .pf-sticker {
      box-shadow:
        inset 3px 3px 6px rgba(255, 255, 255, 0.75),
        inset -4px -4px 8px rgba(122, 102, 92, 0.14),
        10px 12px 24px rgba(122, 102, 92, 0.18);
    }

    /* nav */
    .pf-navwrap { position: fixed; top: 14px; left: 0; right: 0; z-index: 60; padding: 0 clamp(14px, 3vw, 30px); }
    .pf-nav {
      display: flex; align-items: center; gap: 18px;
      background: rgba(255, 246, 236, 0.9); backdrop-filter: blur(12px);
      border: 3px solid #fff; border-radius: 999px;
      padding: 10px 12px 10px 24px;
      max-width: 1180px; margin: 0 auto;
      box-shadow: inset 2px 2px 5px rgba(255,255,255,0.8), 8px 10px 22px rgba(122,102,92,0.16);
    }
    .pf-logo {
      font-family: var(--pf-display); font-weight: 800; font-size: 26px; color: var(--pf-ink);
      text-decoration: none; display: flex; align-items: center; gap: 10px; margin-right: auto;
    }
    .pf-logo-blob {
      width: 30px; height: 30px; border-radius: 46% 54% 55% 45% / 48% 45% 55% 52%;
      background: linear-gradient(135deg, var(--pf-peach), var(--pf-lav));
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.7), 3px 4px 8px rgba(122,102,92,0.2);
      animation: pf-wobble 5s ease-in-out infinite;
    }
    @keyframes pf-wobble { 50% { border-radius: 55% 45% 46% 54% / 52% 55% 45% 48%; transform: rotate(8deg); } }
    .pf-nav-links { display: flex; gap: 4px; }
    .pf-nav-links a {
      color: var(--pf-ink-soft); text-decoration: none; font-weight: 700; font-size: 15px;
      padding: 10px 16px; border-radius: 999px; transition: background 0.2s ease, color 0.2s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pf-nav-links a:hover { background: var(--pf-peach); color: var(--pf-ink); transform: scale(1.06); }
    .pf-burger { display: none; background: var(--pf-peach); border: 3px solid #fff; border-radius: 18px; width: 48px; height: 48px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
    .pf-burger span { display: block; width: 22px; height: 3px; border-radius: 3px; background: var(--pf-ink); }

    /* boutons */
    .pf-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--pf-display); font-weight: 700; font-size: 18px;
      padding: 16px 34px; border-radius: 999px; border: 3px solid #fff;
      text-decoration: none; cursor: pointer; color: var(--pf-ink);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }
    .pf-btn:hover { transform: scale(1.07) rotate(-1.5deg); }
    .pf-btn:active { transform: scale(0.96); }
    .pf-btn-peach { background: var(--pf-peach); }
    .pf-btn-mint { background: var(--pf-mint); }
    .pf-btn-plum { background: var(--pf-plum); color: #fff; }
    .pf-btn-small { font-size: 15px; padding: 12px 24px; }
    .pf-cta { background: var(--pf-lav); }

    /* typo */
    .pf-kicker {
      display: inline-block; font-weight: 700; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase;
      background: #fff; border: 3px solid #fff; border-radius: 999px; padding: 10px 22px; margin: 0 0 20px; color: var(--pf-plum);
    }
    .pf-h1 {
      font-family: var(--pf-display); font-weight: 800; font-size: clamp(3rem, 8.5vw, 6.4rem);
      line-height: 1.02; letter-spacing: -0.01em; margin: 0 0 24px;
    }
    .pf-h1-pop {
      display: inline-block; background: var(--pf-lav); border-radius: 28px; padding: 0 22px 6px;
      border: 3px solid #fff; transform: rotate(-1.5deg);
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.7), 6px 8px 16px rgba(122,102,92,0.18);
    }
    .pf-h2 {
      font-family: var(--pf-display); font-weight: 800; font-size: clamp(2.4rem, 5.5vw, 4rem);
      line-height: 1.05; margin: 0 0 44px;
    }
    .pf-h2-pop {
      display: inline-block; background: var(--pf-mint); border-radius: 22px; padding: 0 18px 4px;
      border: 3px solid #fff; transform: rotate(1.5deg);
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.7), 5px 7px 14px rgba(122,102,92,0.16);
    }
    .pf-pill {
      display: inline-block; background: var(--pf-sky); border: 3px solid #fff; border-radius: 999px;
      font-weight: 700; font-size: 13px; letter-spacing: 0.14em; padding: 12px 24px; margin: 0 0 26px;
    }
    .pf-lede { font-size: 19px; line-height: 1.65; font-weight: 500; color: var(--pf-ink-soft); max-width: 46ch; margin: 0 0 34px; }
    .pf-lede-small { font-size: 17px; line-height: 1.65; color: var(--pf-ink-soft); font-weight: 500; max-width: 42ch; margin: 0 0 28px; }

    /* hero */
    .pf-hero { position: relative; padding: 170px 0 90px; overflow: hidden; }
    .pf-blob { position: absolute; border-radius: 46% 54% 55% 45% / 48% 45% 55% 52%; filter: blur(1px); animation: pf-float 9s ease-in-out infinite; z-index: 0; }
    .pf-blob-1 { width: 340px; height: 340px; background: var(--pf-peach); top: -90px; right: -70px; opacity: 0.7; }
    .pf-blob-2 { width: 220px; height: 220px; background: var(--pf-lav); bottom: 40px; left: -70px; opacity: 0.6; animation-delay: -3s; }
    .pf-blob-3 { width: 130px; height: 130px; background: var(--pf-mint); top: 38%; left: 44%; opacity: 0.55; animation-delay: -6s; }
    .pf-blob-4 { width: 170px; height: 170px; background: var(--pf-sky); bottom: -50px; right: 22%; opacity: 0.6; animation-delay: -1.5s; }
    @keyframes pf-float { 50% { transform: translateY(-26px) rotate(10deg); } }
    .pf-hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(36px, 6vw, 70px); align-items: center; }
    .pf-hero-cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 44px; }
    .pf-hero-facts { display: flex; gap: 14px; margin: 0; padding: 0; flex-wrap: wrap; }
    .pf-hero-facts div {
      background: #fff; border: 3px solid #fff; border-radius: 26px; padding: 16px 24px; text-align: center;
      box-shadow: inset 2px 2px 5px rgba(255,255,255,0.9), 6px 8px 16px rgba(122,102,92,0.14);
      display: grid; gap: 2px;
    }
    .pf-hero-facts dt { font-family: var(--pf-display); font-weight: 800; font-size: 34px; color: var(--pf-plum); }
    .pf-hero-facts dd { margin: 0; font-size: 13.5px; font-weight: 600; color: var(--pf-ink-soft); }
    .pf-hero-art { position: relative; }
    .pf-hero-frame {
      border: 8px solid #fff; border-radius: 48px; overflow: hidden; transform: rotate(2deg);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 16px 22px 0 rgba(255, 157, 122, 0.28), 16px 22px 44px rgba(90, 59, 46, 0.22);
    }
    .pf-hero-frame:hover { transform: rotate(0deg) scale(1.02); }
    .pf-hero-frame img { width: 100%; height: 480px; object-fit: cover; }
    .pf-sticker {
      position: absolute; font-family: var(--pf-display); font-weight: 700; font-size: 17px;
      background: #fff; border: 3px solid #fff; border-radius: 999px; padding: 12px 22px; color: var(--pf-ink);
      animation: pf-bob 4s ease-in-out infinite;
    }
    .pf-sticker-1 { top: -24px; left: -14px; transform: rotate(-8deg); background: var(--pf-mint); }
    .pf-sticker-2 { bottom: -20px; right: 6px; transform: rotate(6deg); background: var(--pf-peach); animation-delay: -2s; }
    @keyframes pf-bob { 50% { translate: 0 -10px; } }

    /* bandeau */
    .pf-ticker { background: var(--pf-plum); color: #fff; overflow: hidden; padding: 16px 0; border-block: 4px solid #fff; }
    .pf-ticker-track { display: flex; gap: 34px; width: max-content; animation: pf-tick 22s linear infinite; font-family: var(--pf-display); font-weight: 700; font-size: 22px; }
    .pf-ticker-track i { font-style: normal; color: var(--pf-peach); }
    @keyframes pf-tick { to { transform: translateX(-50%); } }

    /* sections */
    .pf-section { padding: clamp(70px, 9vw, 120px) 0; }
    .pf-section-alt { background: #fff; border-block: 4px solid #fff; border-radius: 60px; margin: 0 clamp(10px, 3vw, 34px); }

    /* jouets */
    .pf-toys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
    .pf-toy {
      border: 4px solid #fff; border-radius: 36px; padding: 18px 18px 26px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pf-toy:hover { transform: translateY(-10px) rotate(-1deg) scale(1.02); }
    .pf-tint-peach { background: var(--pf-peach); }
    .pf-tint-lav { background: var(--pf-lav); }
    .pf-tint-mint { background: var(--pf-mint); }
    .pf-tint-sky { background: var(--pf-sky); }
    .pf-toy-img { border: 4px solid #fff; border-radius: 26px; overflow: hidden; margin-bottom: 18px; }
    .pf-toy-img img { width: 100%; height: 210px; object-fit: cover; transition: transform 0.35s ease; }
    .pf-toy:hover .pf-toy-img img { transform: scale(1.08); }
    .pf-toy h3 { font-family: var(--pf-display); font-weight: 800; font-size: 26px; margin: 0 0 8px; }
    .pf-toy p { margin: 0 0 12px; font-size: 15px; line-height: 1.6; font-weight: 500; color: var(--pf-ink-soft); }
    .pf-toy-tag { display: inline-block; background: #fff; border-radius: 999px; padding: 8px 18px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

    /* processus */
    .pf-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 56px; }
    .pf-step { border: 4px solid #fff; border-radius: 36px; padding: 34px 30px; position: relative; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .pf-step:hover { transform: translateY(-8px) rotate(1deg); }
    .pf-step-n {
      position: absolute; top: -26px; right: 22px; width: 62px; height: 62px; border-radius: 50%;
      background: #fff; border: 4px solid #fff; display: grid; place-items: center;
      font-family: var(--pf-display); font-weight: 800; font-size: 28px; color: var(--pf-plum);
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.9), 5px 7px 14px rgba(122,102,92,0.18);
    }
    .pf-step h3 { font-family: var(--pf-display); font-weight: 800; font-size: 30px; margin: 0 0 12px; }
    .pf-step p { margin: 0; font-size: 16px; line-height: 1.65; font-weight: 500; color: var(--pf-ink-soft); }
    .pf-lab { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: stretch; }
    .pf-lab > img { width: 100%; height: 100%; min-height: 320px; object-fit: cover; border: 6px solid #fff; border-radius: 40px; box-shadow: inset 2px 2px 5px rgba(255,255,255,0.6), 10px 12px 24px rgba(122,102,92,0.16); }
    .pf-lab > div { background: var(--pf-cream); border: 4px solid #fff; border-radius: 40px; padding: clamp(28px, 4vw, 44px); box-shadow: inset 3px 3px 6px rgba(255,255,255,0.75), 10px 12px 24px rgba(122,102,92,0.14); }
    .pf-lab h3 { font-family: var(--pf-display); font-weight: 800; font-size: 30px; margin: 0 0 14px; }
    .pf-lab p { margin: 0 0 20px; font-size: 16px; line-height: 1.65; color: var(--pf-ink-soft); font-weight: 500; }
    .pf-lab-small { width: 100%; height: 170px; object-fit: cover; border: 4px solid #fff; border-radius: 26px; }

    /* citations */
    .pf-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .pf-quote { border: 4px solid #fff; border-radius: 36px; padding: 32px 30px; margin: 0; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .pf-quote:hover { transform: scale(1.03) rotate(-1deg); }
    .pf-quote p { font-size: 17px; line-height: 1.65; font-weight: 600; margin: 0 0 16px; }
    .pf-quote cite { font-style: normal; font-weight: 700; font-size: 14px; letter-spacing: 0.06em; color: var(--pf-plum); }

    /* tarifs */
    .pf-plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }
    .pf-plan { border: 4px solid #fff; border-radius: 40px; padding: 38px 34px; display: grid; gap: 10px; align-content: start; position: relative; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .pf-plan:hover { transform: translateY(-10px); }
    .pf-plan-hot { transform: scale(1.04); }
    .pf-plan-hot:hover { transform: scale(1.04) translateY(-10px); }
    .pf-plan-badge {
      position: absolute; top: -22px; left: 50%; translate: -50% 0; margin: 0;
      background: var(--pf-plum); color: #fff; font-family: var(--pf-display); font-weight: 700; font-size: 15px;
      border: 3px solid #fff; border-radius: 999px; padding: 8px 22px; white-space: nowrap;
      box-shadow: 4px 6px 12px rgba(122,102,92,0.2);
    }
    .pf-plan h3 { font-family: var(--pf-display); font-weight: 800; font-size: 32px; margin: 0; }
    .pf-price { font-family: var(--pf-display); font-weight: 800; font-size: 52px; margin: 0; color: var(--pf-plum); }
    .pf-plan-sub { margin: 0 0 8px; font-weight: 600; color: var(--pf-ink-soft); }
    .pf-plan ul { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 10px; }
    .pf-plan li { font-size: 15.5px; font-weight: 600; padding-left: 30px; position: relative; line-height: 1.5; }
    .pf-plan li::before { content: "●"; position: absolute; left: 2px; color: var(--pf-plum); font-size: 13px; top: 3px; }
    .pf-plans-note { text-align: center; margin: 34px 0 0; font-weight: 600; color: var(--pf-ink-soft); font-size: 16px; }

    /* contact */
    .pf-contact-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 70px); align-items: start; }
    .pf-contact-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .pf-contact-list li { background: #fff; border: 3px solid #fff; border-radius: 22px; padding: 16px 22px; font-size: 16px; font-weight: 600; box-shadow: inset 2px 2px 5px rgba(255,255,255,0.9), 6px 8px 16px rgba(122,102,92,0.12); }
    .pf-contact-list strong { color: var(--pf-plum); margin-right: 10px; }
    .pf-contact-list a { color: var(--pf-ink); }
    .pf-form { background: var(--pf-lav); border: 4px solid #fff; border-radius: 40px; padding: clamp(28px, 4vw, 44px); display: grid; gap: 16px; }
    .pf-form h3 { font-family: var(--pf-display); font-weight: 800; font-size: 30px; margin: 0; }
    .pf-form label { display: grid; gap: 8px; font-weight: 700; font-size: 14px; letter-spacing: 0.04em; }
    .pf-form input, .pf-form select, .pf-form textarea {
      font-family: var(--pf-body); font-size: 16px; font-weight: 600; color: var(--pf-ink);
      background: #fff; border: 3px solid #fff; border-radius: 20px; padding: 14px 18px; width: 100%;
      box-shadow: inset 3px 3px 7px rgba(122,102,92,0.12);
    }
    .pf-form input:focus, .pf-form select:focus, .pf-form textarea:focus { outline: 3px solid var(--pf-plum); outline-offset: 2px; }
    .pf-form textarea { resize: vertical; }
    .pf-form-note { margin: 0; font-weight: 700; font-size: 16px; color: var(--pf-plum); }
    .pf-form-note:empty { display: none; }

    /* pied de page */
    .pf-footer { background: var(--pf-plum); color: #fff; border-radius: 60px 60px 0 0; margin-top: 40px; padding: 70px 0 90px; text-align: center; }
    .pf-footer-logo { font-family: var(--pf-display); font-weight: 800; font-size: clamp(3.4rem, 10vw, 7rem); margin: 0 0 18px; transform: rotate(-2deg); }
    .pf-footer p { margin: 0 0 10px; font-weight: 600; font-size: 15px; opacity: 0.92; }
    .pf-footer a { color: #fff; }

    @media (max-width: 1020px) {
      .pf-hero-in { grid-template-columns: 1fr; }
      .pf-hero-frame img { height: 380px; }
      .pf-toys { grid-template-columns: 1fr 1fr; }
      .pf-steps, .pf-quotes { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .pf-steps { margin-bottom: 56px; }
      .pf-lab { grid-template-columns: 1fr; }
      .pf-plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
      .pf-plan-hot { transform: none; }
      .pf-plan-hot:hover { transform: translateY(-10px); }
      .pf-contact-in { grid-template-columns: 1fr; }
    }
    @media (max-width: 860px) {
      .pf-burger { display: flex; }
      .pf-nav-links {
        display: none; position: absolute; top: calc(100% + 10px); left: 14px; right: 14px;
        background: #fff; border: 4px solid #fff; border-radius: 30px; padding: 14px;
        flex-direction: column; gap: 4px;
        box-shadow: 10px 14px 28px rgba(122,102,92,0.22);
      }
      .pf-nav-links.pf-open { display: flex; }
      .pf-nav-links a { font-size: 18px; padding: 14px 20px; }
      .pf-cta { display: none; }
      .pf-nav { position: relative; }
    }
    @media (max-width: 640px) {
      .pf-hero { padding-top: 150px; }
      .pf-toys { grid-template-columns: 1fr; }
      .pf-hero-cta .pf-btn { width: 100%; }
      .pf-section-alt { border-radius: 40px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pf-ticker-track, .pf-blob, .pf-logo-blob, .pf-sticker { animation: none; }
      .pf-btn, .pf-toy, .pf-step, .pf-plan, .pf-quote, .pf-hero-frame, .pf-nav-links a { transition: none; }
      .pf-btn:hover, .pf-toy:hover, .pf-step:hover, .pf-plan:hover, .pf-quote:hover { transform: none; }
    }
  </style>
</body>
</html>
