---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : Pouf Studio, studio fictif de design de personnages 3D et jouets, Montréal.
// Direction artistique autonome : claymorphism. Pastel, gonflé, moelleux. Non liée au système de thème WEBAO.
// REFONTE : la page est un labo tout mou. Elle s'ouvre sur une aire de jeu de
// blobs à écraser, les jouets sont des blobs tactiles éparpillés comme des
// spécimens, le processus est un journal de labo, et chaque forfait est un
// pouf qu'on peut pincer. Aucune section standard.
const IMG = {
  hero: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1600&auto=format&fit=crop",
  boba: "/demos/pouf/01.jpg",
  pup: "/demos/pouf/02.jpg",
  bot: "/demos/pouf/03.jpg",
  cat: "/demos/pouf/04.jpg",
  lab: "https://images.unsplash.com/photo-1559454403-b8fb88521f11?q=80&w=800&auto=format&fit=crop",
  extra: "https://images.unsplash.com/photo-1513364776144-60967b0f800f?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pouf Studio : le labo tout mou | Personnages 3D et jouets</title>
  <meta name="description" content="Bienvenue au labo tout mou de Pouf Studio. Pincez les blobs, rencontrez les jouets, lisez le journal de labo. Personnages 3D et jouets tout mous de Montréal." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="pf">

  <!-- NAV -->
  <header class="pf-navwrap">
    <nav class="pf-nav" aria-label="Navigation principale">
      <a class="pf-logo" href="#top" aria-label="Pouf Studio, accueil">
        <span class="pf-logo-blob" aria-hidden="true"></span>pouf studio
      </a>
      <div class="pf-nav-links" id="pf-menu">
        <a href="#lab">Le labo</a>
        <a href="#specimens">Spécimens</a>
        <a href="#log">Journal</a>
        <a href="#puffs">Poufs</a>
      </div>
      <a class="pf-btn pf-btn-small pf-cta" href="#contact">Lancer un projet</a>
      <button class="pf-burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="pf-menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </nav>
  </header>

  <main id="top">
    <!-- THE LAB: a squishable blob playground. No hero copy block. -->
    <section class="pf-lab-open" id="lab" aria-label="Le labo tout mou">
      <div class="pf-play" id="pf-play">
        <button class="pf-blobbtn pf-bb1" type="button" aria-label="Écraser le blob pêche"><span aria-hidden="true"></span></button>
        <button class="pf-blobbtn pf-bb2" type="button" aria-label="Écraser le blob lavande"><span aria-hidden="true"></span></button>
        <button class="pf-blobbtn pf-bb3" type="button" aria-label="Écraser le blob menthe"><span aria-hidden="true"></span></button>
        <button class="pf-blobbtn pf-bb4" type="button" aria-label="Écraser le blob ciel"><span aria-hidden="true"></span></button>
        <div class="pf-lab-copy">
          <p class="pf-pill">STUDIO DE PERSONNAGES 3D + JOUETS · MONTRÉAL</p>
          <h1 class="pf-h1">Bienvenue au<br />labo <span class="pf-h1-pop">tout mou.</span></h1>
          <p class="pf-lede">Ici, tout se pince. Allez-y, écrasez un blob. Pouf Studio dessine des personnages 3D tout mous et des jouets joufflus pour les marques, les jeux et les collectionneurs.</p>
          <p class="pf-squish-count" role="status" aria-live="polite">Blobs écrasés : <strong id="pf-count">0</strong></p>
        </div>
      </div>
    </section>

    <!-- TICKER -->
    <div class="pf-ticker" aria-hidden="true">
      <div class="pf-ticker-track">
        <span>Sculpter</span><i>✦</i><span>Écraser</span><i>✦</i><span>Expédier</span><i>✦</i><span>Peint à la main</span><i>✦</i><span>Joufflu par design</span><i>✦</i>
        <span>Sculpter</span><i>✦</i><span>Écraser</span><i>✦</i><span>Expédier</span><i>✦</i><span>Peint à la main</span><i>✦</i><span>Joufflu par design</span><i>✦</i>
      </div>
    </div>

    <!-- SPECIMENS: toys as tactile blobs, scattered -->
    <section class="pf-specimens" id="specimens">
      <div class="pf-wrap">
        <p class="pf-kicker">Frais sortis du labo</p>
        <h2 class="pf-h2">Nos <span class="pf-h2-pop">spécimens</span></h2>
        <p class="pf-lede-small">Quatre jouets, zéro arête vive. Pincez-en un pour lire sa fiche.</p>
      </div>
      <div class="pf-field">
        <button class="pf-spec pf-tint-peach pf-sp1" type="button" aria-expanded="false">
          <span class="pf-spec-img"><img src={IMG.boba} alt="Boba Blob, figurine en vinyle pastel toute douce" loading="lazy" /></span>
          <span class="pf-spec-name">Boba Blob</span>
          <span class="pf-spec-file">Vinyle · 12 cm. Figurine pour une marque de thé aux perles. Épuisée en 9 minutes. On est encore un peu fiers.</span>
        </button>
        <button class="pf-spec pf-tint-lav pf-sp2" type="button" aria-expanded="false">
          <span class="pf-spec-img"><img src={IMG.pup} alt="Cloud Pup, personnage en peluche pastel" loading="lazy" /></span>
          <span class="pf-spec-name">Cloud Pup</span>
          <span class="pf-spec-file">Peluche · 30 cm. Mascotte pour une appli de sommeil. Testée par 40 tout-petits et un corgi très sérieux.</span>
        </button>
        <button class="pf-spec pf-tint-mint pf-sp3" type="button" aria-expanded="false">
          <span class="pf-spec-img"><img src={IMG.bot} alt="Mochi Bot, robot jouet joufflu" loading="lazy" /></span>
          <span class="pf-spec-name">Mochi Bot</span>
          <span class="pf-spec-file">Résine · 15 cm. Robot design pour un lancement de jeu. Note de mollesse : 9,4 sur 10. Bip boup.</span>
        </button>
        <button class="pf-spec pf-tint-sky pf-sp4" type="button" aria-expanded="false">
          <span class="pf-spec-img"><img src={IMG.cat} alt="Pudding Cat, jouet chat en forme de pouding tout mou" loading="lazy" /></span>
          <span class="pf-spec-name">Pudding Cat</span>
          <span class="pf-spec-file">Sofubi · 10 cm. Copain de bureau pour une fintech qui voulait se sentir moins fintech. Mission accomplie.</span>
        </button>
      </div>
    </section>

    <!-- LAB LOG: the process as experiment notes -->
    <section class="pf-log" id="log">
      <div class="pf-wrap">
        <p class="pf-kicker">Expérience nº 047</p>
        <h2 class="pf-h2">Le <span class="pf-h2-pop">journal de labo</span></h2>
        <ol class="pf-log-list">
          <li class="pf-tint-peach">
            <p class="pf-log-day">Jours 1 à 12 · Sculpter</p>
            <h3>Rendre ça rond</h3>
            <p>On esquisse, on modélise et on imprime votre personnage en 3D. Vous avez des aperçus chaque semaine et des rondes illimitées de « et si c'était plus rond ? ».</p>
          </li>
          <li class="pf-tint-lav">
            <p class="pf-log-day">Jours 13 à 20 · Écraser</p>
            <h3>Pincer scientifiquement</h3>
            <p>Les prototypes sont pincés, échappés, câlinés et mâchouillés (par le corgi) jusqu'à ce que le facteur mollesse soit scientifiquement parfait.</p>
          </li>
          <li class="pf-tint-mint">
            <p class="pf-log-day">Jours 21 à 30 · Expédier</p>
            <h3>L'envoyer dans le monde</h3>
            <p>Maîtres de peinture, emballage et soutien à la production. Votre jouet est lancé, prêt pour les tablettes et les bureaux.</p>
          </li>
        </ol>
        <div class="pf-lab">
          <img src={IMG.lab} alt="Ourson en peluche tout mou, sujet de test au studio" loading="lazy" />
          <div>
            <h3>Dans le labo</h3>
            <p>Notre studio du Mile End abrite deux imprimantes 3D, une cabine de peinture qui sent vaguement la vanille et une étagère de plus de 200 blobs de référence. Venez visiter. Apportez des collations.</p>
            <img class="pf-lab-small" src={IMG.extra} alt="Pinceaux et peinture vive au studio" loading="lazy" />
          </div>
        </div>
        <div class="pf-facts">
          <div><strong>240+</strong><span>personnages expédiés</span></div>
          <div><strong>38</strong><span>collabos de marques</span></div>
          <div><strong>0</strong><span>arête vive, jamais</span></div>
        </div>
      </div>
    </section>

    <!-- FIELD NOTES: testimonials as scattered notes -->
    <section class="pf-notes">
      <div class="pf-wrap">
        <p class="pf-kicker">Épinglé au mur du labo</p>
        <h2 class="pf-h2">Notes de <span class="pf-h2-pop">terrain</span></h2>
      </div>
      <div class="pf-notes-field">
        <blockquote class="pf-note pf-tint-sky pf-n1">
          <p>« Pouf a transformé notre mascotte ennuyante en peluche qu'on s'arrache dans les salons. Notre kiosque n'a jamais été aussi câlinable. »</p>
          <cite>Maya R., directrice de marque</cite>
        </blockquote>
        <blockquote class="pf-note pf-tint-peach pf-n2">
          <p>« Ils ont demandé "et si c'était plus rond ?" dix-sept fois. La dix-septième était la bonne. Notre Kickstarter s'est financé en un jour. »</p>
          <cite>Devon K., dev de jeu indépendant</cite>
        </blockquote>
        <blockquote class="pf-note pf-tint-mint pf-n3">
          <p>« Le prototype est arrivé et tout le bureau a arrêté de travailler pour l'écraser. Ça valait chaque sou. Dix sur dix, on réécraserait. »</p>
          <cite>Léa T., fondatrice de startup</cite>
        </blockquote>
      </div>
    </section>

    <!-- PUFFS: pricing as pokeable puffs -->
    <section class="pf-puffs" id="puffs">
      <div class="pf-wrap">
        <p class="pf-kicker">Choisissez votre pouf</p>
        <h2 class="pf-h2">Forfaits <span class="pf-h2-pop">tout mous</span></h2>
        <p class="pf-lede-small pf-center">Chaque forfait inclut des questions illimitées de type « et si c'était plus rond ? ». Pour vrai.</p>
        <div class="pf-puff-row">
          <article class="pf-puff pf-tint-lav">
            <h3>Mouflon</h3>
            <p class="pf-price">2 900 $</p>
            <p class="pf-puff-sub">Pour tester l'eau</p>
            <ul>
              <li>Concept du personnage + vues</li>
              <li>Modèle 3D détaillé</li>
              <li>2 rondes de révisions</li>
              <li>Rapport de mollesse (officiel)</li>
            </ul>
            <a class="pf-btn pf-btn-peach" href="#contact">Choisir Mouflon</a>
          </article>
          <article class="pf-puff pf-puff-hot pf-tint-peach">
            <p class="pf-puff-badge">Le plus écrasé</p>
            <h3>Joufflu</h3>
            <p class="pf-price">7 500 $</p>
            <p class="pf-puff-sub">Notre forfait signature</p>
            <ul>
              <li>Tout ce qu'il y a dans Mouflon</li>
              <li>Prototype physique</li>
              <li>Maître peint à la main</li>
              <li>Design d'emballage</li>
              <li>Test de mastication du corgi inclus</li>
            </ul>
            <a class="pf-btn pf-btn-plum" href="#contact">Choisir Joufflu</a>
          </article>
          <article class="pf-puff pf-tint-mint">
            <h3>Méga Joufflu</h3>
            <p class="pf-price">18 000 $</p>
            <p class="pf-puff-sub">Soutien complet à la production</p>
            <ul>
              <li>Tout ce qu'il y a dans Joufflu</li>
              <li>Liaison usine + contrôle qualité</li>
              <li>Visuels de campagne de lancement</li>
              <li>Variante édition collectionneur</li>
            </ul>
            <a class="pf-btn pf-btn-peach" href="#contact">Choisir Méga Joufflu</a>
          </article>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="pf-contact" id="contact">
      <div class="pf-wrap pf-contact-in">
        <div class="pf-contact-copy">
          <p class="pf-kicker">Dites bonjour</p>
          <h2 class="pf-h2">Prêt à devenir <span class="pf-h2-pop">tout mou ?</span></h2>
          <p class="pf-lede-small">Parlez-nous de votre personnage, de votre marque ou de votre belle idée bizarre. On répond sous deux jours ouvrables, d'habitude avec une esquisse.</p>
          <ul class="pf-contact-list">
            <li><strong>Studio</strong> 418, rue Imaginaire, Montréal QC</li>
            <li><strong>Téléphone</strong> <a href="tel:+15145550142">(514) 555-0142</a></li>
            <li><strong>Courriel</strong> <a href="mailto:hello@pouf.studio">hello@pouf.studio</a></li>
            <li><strong>Heures</strong> Lun au ven, 9 h à 18 h</li>
          </ul>
        </div>
        <form class="pf-form" id="pf-form" novalidate>
          <h3>Lancez votre projet</h3>
          <label>Nom<input type="text" name="name" required placeholder="Sam Puffington" /></label>
          <label>Courriel<input type="email" name="email" required placeholder="sam@example.com" /></label>
          <label>Type de jouet
            <select name="type">
              <option>Figurine en vinyle</option>
              <option>Peluche</option>
              <option>Résine / sofubi</option>
              <option>Mascotte pour ma marque</option>
              <option>Quelque chose de glorieusement bizarre</option>
            </select>
          </label>
          <label>Dites-nous tout<textarea name="message" rows="4" placeholder="Mon personnage est un sorcier croissant endormi qui..."></textarea></label>
          <button class="pf-btn pf-btn-plum" type="submit">Envoyer au labo</button>
          <p class="pf-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="pf-footer">
    <div class="pf-wrap">
      <p class="pf-footer-logo" aria-hidden="true">pouf!</p>
      <p>© 2026 Pouf Studio. Démo fictive. Aucun jouet n'a été blessé (le corgi a essayé).</p>
      <p>418, rue Imaginaire, Montréal QC · <a href="tel:+15145550142">(514) 555-0142</a> · <a href="mailto:hello@pouf.studio">hello@pouf.studio</a></p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      // Compteur de mollesse pour les blobs de l'aire de jeu
      var count = 0;
      var countEl = document.getElementById('pf-count');
      document.querySelectorAll('.pf-blobbtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          count += 1;
          if (countEl) countEl.textContent = String(count);
        });
      });
      // Spécimens : pincer pour ouvrir la fiche
      document.querySelectorAll('.pf-spec').forEach(function (spec) {
        spec.addEventListener('click', function () {
          var open = spec.getAttribute('aria-expanded') === 'true';
          document.querySelectorAll('.pf-spec').forEach(function (s) {
            s.setAttribute('aria-expanded', 'false');
            s.classList.remove('pf-spec-open');
          });
          if (!open) {
            spec.setAttribute('aria-expanded', 'true');
            spec.classList.add('pf-spec-open');
          }
        });
      });
      // Menu mobile
      var burgerEl = document.querySelector('.pf-burger');
      var menuEl = document.getElementById('pf-menu');
      if (burgerEl instanceof HTMLButtonElement) {
        var burger = burgerEl;
        var menu = menuEl;
        burger.addEventListener('click', function () {
          var open = menu ? menu.classList.toggle('pf-open') : false;
          burger.setAttribute('aria-expanded', String(open));
          burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
        });
        if (menu) {
          var m = menu;
          m.querySelectorAll('a').forEach(function (a) {
            a.addEventListener('click', function () {
              m.classList.remove('pf-open');
              burger.setAttribute('aria-expanded', 'false');
              burger.setAttribute('aria-label', 'Ouvrir le menu');
            });
          });
        }
      }
      // Formulaire démo : ne soumet jamais rien
      var formEl = document.getElementById('pf-form');
      if (formEl instanceof HTMLFormElement) {
        var form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.pf-form-note');
          if (note) note.textContent = 'Mollesse reçue ! On répond sous deux jours ouvrables, esquisse en main.';
          form.reset();
        });
      }
    })();
  </script>

  <style>
    .pf {
      --pf-cream: #FFF6EC;
      --pf-peach: #FFD9C0;
      --pf-lav: #DCC9FF;
      --pf-mint: #C4F0D4;
      --pf-sky: #C4E3FF;
      --pf-plum: #6C4AB0;
      --pf-ink: #4A3B32;
      --pf-ink-soft: #7A665C;
      --pf-display: "Baloo 2", "Comic Sans MS", cursive;
      --pf-body: "Quicksand", system-ui, sans-serif;
      margin: 0;
      background: var(--pf-cream);
      color: var(--pf-ink);
      font-family: var(--pf-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .pf *, .pf *::before, .pf *::after { box-sizing: border-box; }
    .pf img { display: block; max-width: 100%; }
    .pf-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .pf-center { text-align: center; }

    /* clay shadows */
    .pf-btn, .pf-blobbtn, .pf-spec, .pf-note, .pf-puff, .pf-form, .pf-pill, .pf-log-list li, .pf-lab > div {
      box-shadow:
        inset 3px 3px 6px rgba(255, 255, 255, 0.75),
        inset -4px -4px 8px rgba(122, 102, 92, 0.14),
        10px 12px 24px rgba(122, 102, 92, 0.18);
    }

    /* nav */
    .pf-navwrap { position: fixed; top: 14px; left: 0; right: 0; z-index: 60; padding: 0 clamp(14px, 3vw, 30px); }
    .pf-nav {
      display: flex; align-items: center; gap: 18px;
      background: rgba(255, 246, 236, 0.9); backdrop-filter: blur(12px);
      border: 3px solid #fff; border-radius: 999px;
      padding: 10px 12px 10px 24px;
      max-width: 1180px; margin: 0 auto;
      box-shadow: inset 2px 2px 5px rgba(255,255,255,0.8), 8px 10px 22px rgba(122,102,92,0.16);
    }
    .pf-logo {
      font-family: var(--pf-display); font-weight: 800; font-size: 26px; color: var(--pf-ink);
      text-decoration: none; display: flex; align-items: center; gap: 10px; margin-right: auto;
    }
    .pf-logo-blob {
      width: 30px; height: 30px; border-radius: 46% 54% 55% 45% / 48% 45% 55% 52%;
      background: linear-gradient(135deg, var(--pf-peach), var(--pf-lav));
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.7), 3px 4px 8px rgba(122,102,92,0.2);
      animation: pf-wobble 5s ease-in-out infinite;
    }
    @keyframes pf-wobble { 50% { border-radius: 55% 45% 46% 54% / 52% 55% 45% 48%; transform: rotate(8deg); } }
    .pf-nav-links { display: flex; gap: 4px; }
    .pf-nav-links a {
      color: var(--pf-ink-soft); text-decoration: none; font-weight: 700; font-size: 15px;
      padding: 10px 16px; border-radius: 999px; transition: background 0.2s ease, color 0.2s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pf-nav-links a:hover { background: var(--pf-peach); color: var(--pf-ink); transform: scale(1.06); }
    .pf-burger { display: none; background: var(--pf-peach); border: 3px solid #fff; border-radius: 18px; width: 48px; height: 48px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
    .pf-burger span { display: block; width: 22px; height: 3px; border-radius: 3px; background: var(--pf-ink); }

    /* buttons */
    .pf-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--pf-display); font-weight: 700; font-size: 18px;
      padding: 16px 34px; border-radius: 999px; border: 3px solid #fff;
      text-decoration: none; cursor: pointer; color: var(--pf-ink);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }
    .pf-btn:hover { transform: scale(1.07) rotate(-1.5deg); }
    .pf-btn:active { transform: scale(0.96); }
    .pf-btn-peach { background: var(--pf-peach); }
    .pf-btn-mint { background: var(--pf-mint); }
    .pf-btn-plum { background: var(--pf-plum); color: #fff; }
    .pf-btn-small { font-size: 15px; padding: 12px 24px; }
    .pf-cta { background: var(--pf-lav); }

    /* type */
    .pf-kicker {
      display: inline-block; font-weight: 700; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase;
      background: #fff; border: 3px solid #fff; border-radius: 999px; padding: 10px 22px; margin: 0 0 20px; color: var(--pf-plum);
    }
    .pf-h1 {
      font-family: var(--pf-display); font-weight: 800; font-size: clamp(3rem, 8.5vw, 6.4rem);
      line-height: 1.02; letter-spacing: -0.01em; margin: 0 0 24px;
    }
    .pf-h1-pop {
      display: inline-block; background: var(--pf-lav); border-radius: 28px; padding: 0 22px 6px;
      border: 3px solid #fff; transform: rotate(-1.5deg);
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.7), 6px 8px 16px rgba(122,102,92,0.18);
    }
    .pf-h2 {
      font-family: var(--pf-display); font-weight: 800; font-size: clamp(2.4rem, 5.5vw, 4rem);
      line-height: 1.05; margin: 0 0 30px;
    }
    .pf-h2-pop {
      display: inline-block; background: var(--pf-mint); border-radius: 22px; padding: 0 18px 4px;
      border: 3px solid #fff; transform: rotate(1.5deg);
      box-shadow: inset 2px 2px 4px rgba(255,255,255,0.7), 5px 7px 14px rgba(122,102,92,0.16);
    }
    .pf-pill {
      display: inline-block; background: var(--pf-sky); border: 3px solid #fff; border-radius: 999px;
      font-weight: 700; font-size: 13px; letter-spacing: 0.14em; padding: 12px 24px; margin: 0 0 26px;
    }
    .pf-lede { font-size: 19px; line-height: 1.65; font-weight: 500; color: var(--pf-ink-soft); max-width: 46ch; margin: 0 0 24px; }
    .pf-lede-small { font-size: 17px; line-height: 1.65; color: var(--pf-ink-soft); font-weight: 500; max-width: 52ch; margin: 0 0 28px; }
    .pf-squish-count { font-size: 18px; font-weight: 700; color: var(--pf-plum); margin: 0; }
    .pf-squish-count strong { font-size: 26px; }

    /* lab opener: blob playground */
    .pf-lab-open { padding: 130px 0 70px; overflow: hidden; }
    .pf-play {
      position: relative; max-width: 1280px; margin: 0 auto; min-height: 88vh;
      padding: 60px clamp(20px, 4vw, 40px);
      display: grid; align-content: center;
    }
    .pf-lab-copy { position: relative; z-index: 5; max-width: 560px; }
    .pf-blobbtn {
      position: absolute; z-index: 1; border: 4px solid #fff; cursor: pointer; padding: 0;
      transition: transform 0.45s cubic-bezier(0.34, 1.8, 0.5, 1);
      animation: pf-float 8s ease-in-out infinite;
    }
    .pf-blobbtn span { display: block; width: 100%; height: 100%; border-radius: inherit; }
    .pf-blobbtn:active { transform: scale(0.72, 0.6) !important; transition-duration: 0.08s; }
    .pf-bb1 {
      width: 300px; height: 280px; top: 4%; right: 6%;
      border-radius: 46% 54% 55% 45% / 48% 45% 55% 52%;
      background: linear-gradient(135deg, var(--pf-peach), #FFB98A);
    }
    .pf-bb2 {
      width: 200px; height: 220px; bottom: 8%; right: 22%;
      border-radius: 55% 45% 46% 54% / 52% 55% 45% 48%;
      background: linear-gradient(135deg, var(--pf-lav), #B79CFF);
      animation-delay: -2.5s;
    }
    .pf-bb3 {
      width: 150px; height: 150px; top: 12%; right: 34%;
      border-radius: 50% 50% 52% 48% / 55% 48% 52% 45%;
      background: linear-gradient(135deg, var(--pf-mint), #9FE8BC);
      animation-delay: -5s;
    }
    .pf-bb4 {
      width: 120px; height: 130px; bottom: 22%; right: 4%;
      border-radius: 48% 52% 55% 45% / 50% 46% 54% 50%;
      background: linear-gradient(135deg, var(--pf-sky), #9CCBFF);
      animation-delay: -1.2s;
    }
    @keyframes pf-float { 50% { translate: 0 -24px; } }

    /* ticker */
    .pf-ticker { background: var(--pf-plum); color: #fff; overflow: hidden; padding: 16px 0; border-block: 4px solid #fff; }
    .pf-ticker-track { display: flex; gap: 34px; width: max-content; animation: pf-tick 22s linear infinite; font-family: var(--pf-display); font-weight: 700; font-size: 22px; }
    .pf-ticker-track i { font-style: normal; color: var(--pf-peach); }
    @keyframes pf-tick { to { transform: translateX(-50%); } }

    /* specimens */
    .pf-specimens { padding: clamp(70px, 9vw, 120px) 0 40px; }
    .pf-field { position: relative; max-width: 1280px; margin: 20px auto 0; min-height: 700px; padding: 0 clamp(20px, 4vw, 40px); }
    .pf-spec {
      position: absolute; border: 4px solid #fff; cursor: pointer; padding: 22px;
      display: grid; gap: 12px; justify-items: center; text-align: center;
      font-family: var(--pf-body); color: var(--pf-ink);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      width: min(300px, 70vw);
    }
    .pf-spec:hover { transform: scale(1.05) rotate(0deg) !important; z-index: 6; }
    .pf-sp1 { border-radius: 48% 52% 55% 45% / 52% 48% 55% 45%; top: 0; left: 6%; transform: rotate(-4deg); }
    .pf-sp2 { border-radius: 55% 45% 48% 52% / 48% 55% 45% 52%; top: 60px; right: 8%; transform: rotate(3deg); }
    .pf-sp3 { border-radius: 52% 48% 45% 55% / 55% 52% 48% 45%; bottom: 40px; left: 14%; transform: rotate(2deg); }
    .pf-sp4 { border-radius: 45% 55% 52% 48% / 48% 45% 55% 52%; bottom: 0; right: 16%; transform: rotate(-3deg); }
    .pf-spec-img { width: 170px; height: 170px; border-radius: 50%; overflow: hidden; border: 4px solid #fff; }
    .pf-spec-img img { width: 100%; height: 100%; object-fit: cover; }
    .pf-spec-name { font-family: var(--pf-display); font-weight: 800; font-size: 26px; }
    .pf-spec-file { display: none; font-size: 15px; line-height: 1.6; font-weight: 500; color: var(--pf-ink-soft); max-width: 34ch; }
    .pf-spec-open { border-radius: 36px !important; z-index: 7; width: min(340px, 84vw); }
    .pf-spec-open .pf-spec-file { display: block; }
    .pf-tint-peach { background: var(--pf-peach); }
    .pf-tint-lav { background: var(--pf-lav); }
    .pf-tint-mint { background: var(--pf-mint); }
    .pf-tint-sky { background: var(--pf-sky); }

    /* lab log */
    .pf-log { background: #fff; border-block: 4px solid #fff; border-radius: 60px; margin: 40px clamp(10px, 3vw, 34px) 0; padding: clamp(70px, 9vw, 110px) 0; }
    .pf-log-list { list-style: none; margin: 0 0 56px; padding: 0; display: grid; gap: 22px; }
    .pf-log-list li { border: 4px solid #fff; border-radius: 36px; padding: 30px 34px; position: relative; }
    .pf-log-list li:nth-child(odd) { transform: rotate(-0.6deg); }
    .pf-log-list li:nth-child(even) { transform: rotate(0.6deg); }
    .pf-log-day { font-weight: 700; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pf-plum); margin: 0 0 8px; }
    .pf-log-list h3 { font-family: var(--pf-display); font-weight: 800; font-size: 30px; margin: 0 0 10px; }
    .pf-log-list p { margin: 0; font-size: 16px; line-height: 1.65; font-weight: 500; color: var(--pf-ink-soft); }
    .pf-lab { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: stretch; }
    .pf-lab > img { width: 100%; height: 100%; min-height: 320px; object-fit: cover; border: 6px solid #fff; border-radius: 40px; }
    .pf-lab > div { background: var(--pf-cream); border: 4px solid #fff; border-radius: 40px; padding: clamp(28px, 4vw, 44px); }
    .pf-lab h3 { font-family: var(--pf-display); font-weight: 800; font-size: 30px; margin: 0 0 14px; }
    .pf-lab p { margin: 0 0 20px; font-size: 16px; line-height: 1.65; color: var(--pf-ink-soft); font-weight: 500; }
    .pf-lab-small { width: 100%; height: 170px; object-fit: cover; border: 4px solid #fff; border-radius: 26px; }
    .pf-facts { display: flex; gap: 14px; margin: 44px 0 0; padding: 0; flex-wrap: wrap; justify-content: center; }
    .pf-facts div {
      background: #fff; border: 3px solid #fff; border-radius: 26px; padding: 16px 28px; text-align: center;
      box-shadow: inset 2px 2px 5px rgba(255,255,255,0.9), 6px 8px 16px rgba(122,102,92,0.14);
      display: grid; gap: 2px;
    }
    .pf-facts strong { font-family: var(--pf-display); font-weight: 800; font-size: 34px; color: var(--pf-plum); }
    .pf-facts span { font-size: 13.5px; font-weight: 600; color: var(--pf-ink-soft); }

    /* field notes */
    .pf-notes { padding: clamp(70px, 9vw, 110px) 0 20px; }
    .pf-notes-field { position: relative; max-width: 1280px; margin: 0 auto; min-height: 420px; padding: 0 clamp(20px, 4vw, 40px); }
    .pf-note { position: absolute; border: 4px solid #fff; border-radius: 30px; padding: 28px 30px; margin: 0; width: min(360px, 82vw); }
    .pf-note p { font-size: 16.5px; line-height: 1.65; font-weight: 600; margin: 0 0 14px; }
    .pf-note cite { font-style: normal; font-weight: 700; font-size: 14px; letter-spacing: 0.06em; color: var(--pf-plum); }
    .pf-n1 { top: 0; left: 5%; transform: rotate(-3deg); }
    .pf-n2 { top: 40px; right: 6%; transform: rotate(2.4deg); }
    .pf-n3 { bottom: 0; left: 32%; transform: rotate(-1.6deg); }

    /* puffs */
    .pf-puffs { padding: clamp(70px, 9vw, 110px) 0; }
    .pf-puff-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; margin-top: 20px; }
    .pf-puff {
      border: 4px solid #fff; border-radius: 44% 56% 52% 48% / 56% 48% 52% 44%; padding: 48px 36px;
      display: grid; gap: 10px; align-content: start; justify-items: center; text-align: center;
      position: relative; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pf-puff:hover { transform: translateY(-10px) scale(1.02); }
    .pf-puff-hot { border-radius: 52% 48% 46% 54% / 48% 54% 46% 52%; }
    .pf-puff-badge {
      position: absolute; top: -20px; left: 50%; translate: -50% 0; margin: 0;
      background: var(--pf-plum); color: #fff; font-family: var(--pf-display); font-weight: 700; font-size: 15px;
      border: 3px solid #fff; border-radius: 999px; padding: 8px 22px; white-space: nowrap;
      box-shadow: 4px 6px 12px rgba(122,102,92,0.2);
    }
    .pf-puff h3 { font-family: var(--pf-display); font-weight: 800; font-size: 32px; margin: 0; }
    .pf-price { font-family: var(--pf-display); font-weight: 800; font-size: 52px; margin: 0; color: var(--pf-plum); }
    .pf-puff-sub { margin: 0 0 8px; font-weight: 600; color: var(--pf-ink-soft); }
    .pf-puff ul { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 10px; }
    .pf-puff li { font-size: 15.5px; font-weight: 600; line-height: 1.5; }
    .pf-puff li::before { content: "● "; color: var(--pf-plum); font-size: 13px; }

    /* contact */
    .pf-contact { padding: clamp(70px, 9vw, 110px) 0; }
    .pf-contact-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 70px); align-items: start; }
    .pf-contact-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .pf-contact-list li { background: #fff; border: 3px solid #fff; border-radius: 22px; padding: 16px 22px; font-size: 16px; font-weight: 600; box-shadow: inset 2px 2px 5px rgba(255,255,255,0.9), 6px 8px 16px rgba(122,102,92,0.12); }
    .pf-contact-list strong { color: var(--pf-plum); margin-right: 10px; }
    .pf-contact-list a { color: var(--pf-ink); }
    .pf-form { background: var(--pf-lav); border: 4px solid #fff; border-radius: 40px; padding: clamp(28px, 4vw, 44px); display: grid; gap: 16px; }
    .pf-form h3 { font-family: var(--pf-display); font-weight: 800; font-size: 30px; margin: 0; }
    .pf-form label { display: grid; gap: 8px; font-weight: 700; font-size: 14px; letter-spacing: 0.04em; }
    .pf-form input, .pf-form select, .pf-form textarea {
      font-family: var(--pf-body); font-size: 16px; font-weight: 600; color: var(--pf-ink);
      background: #fff; border: 3px solid #fff; border-radius: 20px; padding: 14px 18px; width: 100%;
      box-shadow: inset 3px 3px 7px rgba(122,102,92,0.12);
    }
    .pf-form input:focus, .pf-form select:focus, .pf-form textarea:focus { outline: 3px solid var(--pf-plum); outline-offset: 2px; }
    .pf-form textarea { resize: vertical; }
    .pf-form-note { margin: 0; font-weight: 700; font-size: 16px; color: var(--pf-plum); }
    .pf-form-note:empty { display: none; }

    /* footer */
    .pf-footer { background: var(--pf-plum); color: #fff; border-radius: 60px 60px 0 0; margin-top: 40px; padding: 70px 0 90px; text-align: center; }
    .pf-footer-logo { font-family: var(--pf-display); font-weight: 800; font-size: clamp(3.4rem, 10vw, 7rem); margin: 0 0 18px; transform: rotate(-2deg); }
    .pf-footer p { margin: 0 0 10px; font-weight: 600; font-size: 15px; opacity: 0.92; }
    .pf-footer a { color: #fff; }

    @media (max-width: 1020px) {
      .pf-field { min-height: 0; display: grid; gap: 26px; padding-bottom: 20px; }
      .pf-spec { position: relative; top: auto !important; left: auto !important; right: auto !important; bottom: auto !important; width: 100%; max-width: 420px; margin-inline: auto; border-radius: 36px !important; transform: none !important; }
      .pf-notes-field { min-height: 0; display: grid; gap: 26px; }
      .pf-note { position: relative; top: auto !important; left: auto !important; right: auto !important; bottom: auto !important; width: 100%; max-width: 520px; margin-inline: auto; }
      .pf-lab { grid-template-columns: 1fr; }
      .pf-puff-row { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
      .pf-contact-in { grid-template-columns: 1fr; }
      .pf-play { min-height: 0; }
      .pf-bb1 { width: 190px; height: 180px; }
      .pf-bb2 { width: 140px; height: 150px; }
      .pf-bb3, .pf-bb4 { display: none; }
    }
    @media (max-width: 860px) {
      .pf-burger { display: flex; }
      .pf-nav-links {
        display: none; position: absolute; top: calc(100% + 10px); left: 14px; right: 14px;
        background: #fff; border: 4px solid #fff; border-radius: 30px; padding: 14px;
        flex-direction: column; gap: 4px;
        box-shadow: 10px 14px 28px rgba(122,102,92,0.22);
      }
      .pf-nav-links.pf-open { display: flex; }
      .pf-nav-links a { font-size: 18px; padding: 14px 20px; }
      .pf-cta { display: none; }
      .pf-nav { position: relative; }
    }
    @media (max-width: 640px) {
      .pf-lab-open { padding-top: 120px; }
      .pf-bb1 { top: 0; right: 0; width: 140px; height: 130px; }
      .pf-bb2 { bottom: 0; right: 8%; width: 110px; height: 120px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pf-ticker-track, .pf-blobbtn, .pf-logo-blob { animation: none; }
      .pf-btn, .pf-spec, .pf-puff, .pf-nav-links a { transition: none; }
      .pf-btn:hover, .pf-spec:hover, .pf-puff:hover { transform: none; }
    }
  </style>
</body>
</html>
