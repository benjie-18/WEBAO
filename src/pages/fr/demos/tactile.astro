---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Site de démonstration : Tactile, marque fictive de domotique, Portland.
// Direction artistique autonome. Neumorphisme intégral. Non relié au système de thème WEBAO.
// Structure : CONFIGURATEUR DE PIÈCE. La page EST un panneau de pièce interactif;
// les échantillons de finition et les commandes en direct modifient la photo en temps réel.
const IMG = {
  living: "/demos/tactile/01.jpg",
  lounge: "/demos/tactile/02.jpg",
  bedroom: "/demos/tactile/03.jpg",
  kitchen: "https://images.pexels.com/photos/6920631/pexels-photo-6920631.jpeg?auto=compress&cs=tinysrgb&w=800",
};
const ROOMS = [
  { id: "living", label: "Salon", img: IMG.living, alt: "Salon calme baigné de lumière douce", devices: "6 appareils", temp: 21, scene: "Scène du soir prête" },
  { id: "lounge", label: "Boudoir", img: IMG.lounge, alt: "Boudoir chaleureux éclairé par une lampe", devices: "4 appareils", temp: 20, scene: "Mode cinéma armé" },
  { id: "bedroom", label: "Chambre", img: IMG.bedroom, alt: "Chambre paisible aux tons neutres", devices: "5 appareils", temp: 19, scene: "Réveil à 7h00" },
  { id: "kitchen", label: "Cuisine", img: IMG.kitchen, alt: "Cuisine moderne et lumineuse", devices: "7 appareils", temp: 22, scene: "Enceinte en lecture" },
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="tactile" locale="fr" title="Tactile : la maison intelligente qui a du tact" description="Tactile fabrique des commandes domotiques que l'on sent. Hubs au toucher doux, interrupteurs généreux et automatisation paisible pour chaque pièce." ogImage="https://webao.ca/demos/tactile/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="tx">

  <EscapeHatch locale="fr" />

  <!-- Barre de configurateur -->
  <header class="tx-bar">
    <a class="tx-logo" href="#top" aria-label="Tactile, accueil">
      <span class="tx-logo-dot" aria-hidden="true"></span>tactile
    </a>
    <nav aria-label="Principal">
      <a href="#room">La pièce</a>
      <a href="#specify">Spécifications</a>
      <a href="#kits">Coffrets</a>
    </nav>
    <a class="tx-btn tx-btn-small" href="#contact">Adopter Tactile</a>
  </header>

  <main id="top">

    <!-- LA PIÈCE : le configurateur est la page -->
    <section class="tx-room" id="room" aria-label="Configurateur de pièce interactif">
      <div class="tx-wrap">
        <p class="tx-kicker">Le configurateur</p>
        <h1 class="tx-h1">Appuyez.<br />Cette pièce est en direct.</h1>
        <p class="tx-sub">Choisissez une pièce, une finition, puis tamisez les lumières et ajustez la température. Chaque commande ci-dessous reproduit le vrai comportement du matériel, ici même.</p>

        <div class="tx-panel" id="tx-panel">
          <!-- onglets de pièces -->
          <div class="tx-tabs" role="tablist" aria-label="Choisir une pièce">
            {ROOMS.map((r, i) => (
              <button class="tx-tab tx-press" type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-room={r.id}>{r.label}</button>
            ))}
          </div>

          <!-- visualisation de la pièce -->
          <div class="tx-stage">
            <div class="tx-img-frame">
              <img id="tx-room-img" src={ROOMS[0].img} alt={ROOMS[0].alt} loading="eager" fetchpriority="high" decoding="async" />
              <div class="tx-stage-meta">
                <p id="tx-room-label"><strong>{ROOMS[0].label}</strong> · {ROOMS[0].devices} · <span id="tx-room-temp">{ROOMS[0].temp}</span>°</p>
                <p id="tx-room-scene">{ROOMS[0].scene}</p>
              </div>
            </div>
          </div>

          <!-- échantillons de finition -->
          <div class="tx-swatches" role="group" aria-label="Choisir une finition">
            <p class="tx-ctl-label">Finition</p>
            <div class="tx-swatch-row">
              <button class="tx-swatch tx-press is-active" type="button" data-finish="linen" aria-pressed="true" title="Lin"><span style="background:#EDE6DA"></span>Lin</button>
              <button class="tx-swatch tx-press" type="button" data-finish="oak" aria-pressed="false" title="Chêne"><span style="background:#C8A97E"></span>Chêne</button>
              <button class="tx-swatch tx-press" type="button" data-finish="slate" aria-pressed="false" title="Ardoise"><span style="background:#8FA8C8"></span>Ardoise</button>
              <button class="tx-swatch tx-press" type="button" data-finish="moss" aria-pressed="false" title="Mousse"><span style="background:#A8C3A0"></span>Mousse</button>
            </div>
          </div>

          <!-- commandes en direct -->
          <div class="tx-ctls">
            <div class="tx-ctl">
              <p class="tx-ctl-label">Lumières <span id="tx-light-val">72%</span></p>
              <input class="tx-slider" id="tx-light" type="range" min="10" max="100" value="72" aria-label="Luminosité" />
            </div>
            <div class="tx-ctl">
              <p class="tx-ctl-label">Température <span id="tx-temp-val">21°</span></p>
              <div class="tx-temp-row">
                <button class="tx-round tx-press" type="button" data-temp="-1" aria-label="Plus frais">−</button>
                <button class="tx-round tx-press" type="button" data-temp="1" aria-label="Plus chaud">+</button>
                <button class="tx-toggle" type="button" role="switch" aria-checked="false" aria-label="Scène du soir"><span class="tx-toggle-knob"></span></button>
                <span class="tx-ctl-hint">Scène du soir</span>
              </div>
            </div>
            <div class="tx-ctl">
              <p class="tx-ctl-label">Stores <span id="tx-blind-val">35%</span></p>
              <input class="tx-slider" id="tx-blind" type="range" min="0" max="100" value="35" aria-label="Ouverture des stores" />
            </div>
          </div>

          <p class="tx-panel-note">38k maisons adoucies · 4,9 note moyenne · 12ms réponse au toucher</p>
        </div>
      </div>
    </section>

    <!-- CE QUE NOUS SPÉCIFIONS : une liste, pas des cartes -->
    <section class="tx-specify" id="specify">
      <div class="tx-wrap">
        <p class="tx-kicker">Ce que nous spécifions</p>
        <h2 class="tx-h2">Six commandes.<br />Rien à apprendre.</h2>
        <dl class="tx-speclist">
          <div><dt>Variateur</dt><dd>Appuyez, glissez, c'est fait. Rien que le déclic vaut le coup.</dd></div>
          <div><dt>Anneau thermostat</dt><dd>Tournez-le comme un bouton de volume. Il apprend votre semaine, puis reste simple.</dd></div>
          <div><dt>Curseur de store</dt><dd>Glissez pour la lumière du matin, maintenez pour le mode cinéma total.</dd></div>
          <div><dt>Bouton de scène</dt><dd>Un geste : lumières basses, stores baissés, thermostat chaud.</dd></div>
          <div><dt>Anneau enceinte</dt><dd>Un gros anneau de volume, parce que le minuscule bouton plus n'a jamais marché dans l'urgence.</dd></div>
          <div><dt>Interrupteur de porte</dt><dd>Verrouillée, déverrouillée, avec un déclic audible depuis la cuisine.</dd></div>
        </dl>
        <div class="tx-tech">
          <span>Wi-Fi 6 · Thread · Matter</span>
          <span>12 ms en local</span>
          <span>Pile bouton, 2 ans</span>
          <span>Sur l'appareil, sans micro infonuagique</span>
          <span>Apple Home · Google · Alexa</span>
          <span>Garantie 3 ans, sans questions</span>
        </div>
      </div>
    </section>

    <!-- TRANSFORMATIONS : un film, pas une grille -->
    <section class="tx-strip">
      <div class="tx-wrap">
        <p class="tx-kicker">Adoucies en un week-end</p>
        <h2 class="tx-h2">Des pièces apaisées</h2>
      </div>
      <div class="tx-film" role="list" aria-label="Transformations de pièces">
        {ROOMS.map((r) => (
          <figure class="tx-frame" role="listitem">
            <img src={r.img} alt={r.alt} loading="lazy" decoding="async" />
            <figcaption><strong>{r.label}</strong><span>{r.devices} · entièrement tactile</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- COFFRETS : une liste de prix, pas des cartes -->
    <section class="tx-kits" id="kits">
      <div class="tx-wrap">
        <p class="tx-kicker">Coffrets de départ</p>
        <h2 class="tx-h2">Commencez par une douce pression</h2>
        <div class="tx-pricelist">
          <a class="tx-row" href="#contact">
            <div><h3>Départ</h3><p>Une pièce, entièrement tactile. 1 hub · 2 variateurs · 1 anneau thermostat.</p></div>
            <span class="tx-amount">149 $</span>
          </a>
          <a class="tx-row tx-row-hot" href="#contact">
            <div><h3>Maison <em>le préféré</em></h3><p>Tout le rez-de-chaussée. 2 hubs · 6 variateurs · 1 anneau · 2 curseurs de store.</p></div>
            <span class="tx-amount">349 $</span>
          </a>
          <a class="tx-row" href="#contact">
            <div><h3>Pro</h3><p>Chaque pièce, plus l'installation. 4 hubs · 12 variateurs · 2 anneaux · installation soignée.</p></div>
            <span class="tx-amount">699 $</span>
          </a>
        </div>
        <figure class="tx-quote">
          <blockquote>« Mes enfants se disputent pour savoir qui appuiera sur le bouton de la soirée. Rien que le déclic vaut le coup. »</blockquote>
          <figcaption><strong>Mara J.</strong> · Portland, coffret Maison</figcaption>
        </figure>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="tx-contact" id="contact">
      <div class="tx-wrap tx-contact-grid">
        <div>
          <p class="tx-kicker">Dites bonjour</p>
          <h2 class="tx-h2">Adoucissons<br />votre maison</h2>
          <p class="tx-sub">Parlez-nous de votre chez-vous et nous dessinerons le coffret idéal. De vrais humains répondent en un jour.</p>
          <address class="tx-address">
            <p><strong>Tactile Home Co.</strong></p>
            <p>418, rue Alder, bureau 200<br />Portland, OR 97204</p>
            <p><a href="tel:+15035550194">(503) 555-0194</a></p>
            <p><a href="mailto:bonjour@tactilehome.example">bonjour@tactilehome.example</a></p>
          </address>
        </div>
        <form class="tx-form" id="tx-form" novalidate>
          <label class="tx-field"><span>Votre nom</span><input class="tx-input" type="text" name="name" required autocomplete="name" placeholder="Ada Lovelace" /></label>
          <label class="tx-field"><span>Courriel</span><input class="tx-input" type="email" name="email" required autocomplete="email" placeholder="ada@example.com" /></label>
          <label class="tx-field"><span>Quel coffret vous tente?</span>
            <select class="tx-input" name="kit">
              <option>Départ, 149 $</option>
              <option>Maison, 349 $</option>
              <option>Pro, 699 $</option>
              <option>Pas encore certain</option>
            </select>
          </label>
          <label class="tx-field"><span>Parlez-nous de votre maison</span><textarea class="tx-input" name="message" rows="4" placeholder="Appartement deux chambres, beaucoup de lampes..."></textarea></label>
          <button class="tx-btn" type="submit">Envoyer</button>
          <p class="tx-form-note" id="tx-form-note" role="status" hidden></p>
        </form>
      </div>
    </section>

  </main>

  <footer class="tx-footer">
    <div class="tx-wrap">
      <a class="tx-logo" href="#top" aria-label="Tactile, accueil"><span class="tx-logo-dot" aria-hidden="true"></span>tactile</a>
      <p>Des commandes douces pour des maisons calmes. Conçu à Portland.</p>
      <p class="tx-fine">Site de démonstration fictif créé par WEBAO. Tactile Home Co. n'existe pas.</p>
    </div>
  </footer>

  <script define:vars={{ rooms: ROOMS }}>
    (function () {
      var panel = document.getElementById('tx-panel');
      var img = document.getElementById('tx-room-img');
      var label = document.getElementById('tx-room-label');
      var scene = document.getElementById('tx-room-scene');
      var tempVal = document.getElementById('tx-temp-val');
      var roomTemp = document.getElementById('tx-room-temp');
      var light = document.getElementById('tx-light');
      var lightVal = document.getElementById('tx-light-val');
      var blind = document.getElementById('tx-blind');
      var blindVal = document.getElementById('tx-blind-val');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function applyLight() {
        if (!img || !(light instanceof HTMLInputElement)) return;
        var v = parseInt(light.value, 10);
        if (lightVal) lightVal.textContent = v + '%';
        if (reduce) { img.style.transition = 'none'; }
        img.style.filter = 'brightness(' + (0.45 + (v / 100) * 0.65) + ')';
      }
      function applyBlind() {
        if (!(blind instanceof HTMLInputElement)) return;
        if (blindVal) blindVal.textContent = blind.value + '%';
      }

      var tabs = panel ? panel.querySelectorAll('.tx-tab') : [];
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var id = tab.getAttribute('data-room');
          var r = null;
          for (var i = 0; i < rooms.length; i++) { if (rooms[i].id === id) r = rooms[i]; }
          if (!r || !img) return;
          tabs.forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
          img.setAttribute('src', r.img);
          img.setAttribute('alt', r.alt);
          if (label) label.innerHTML = '<strong>' + r.label + '</strong> · ' + r.devices + ' · <span id="tx-room-temp">' + r.temp + '</span>°';
          if (scene) scene.textContent = r.scene;
          roomTemp = document.getElementById('tx-room-temp');
          if (tempVal) tempVal.textContent = r.temp + '°';
        });
      });

      var FINISH = { linen: '#EDE6DA', oak: '#C8A97E', slate: '#8FA8C8', moss: '#A8C3A0' };
      var swatches = panel ? panel.querySelectorAll('.tx-swatch') : [];
      swatches.forEach(function (sw) {
        sw.addEventListener('click', function () {
          swatches.forEach(function (s) { s.classList.remove('is-active'); s.setAttribute('aria-pressed', 'false'); });
          sw.classList.add('is-active');
          sw.setAttribute('aria-pressed', 'true');
          var f = sw.getAttribute('data-finish') || 'linen';
          if (panel) panel.style.setProperty('--accent', FINISH[f] || FINISH.linen);
        });
      });

      var tbtns = panel ? panel.querySelectorAll('[data-temp]') : [];
      tbtns.forEach(function (b) {
        b.addEventListener('click', function () {
          var d = parseInt(b.getAttribute('data-temp') || '0', 10);
          var cur = tempVal ? parseInt(tempVal.textContent || '21', 10) : 21;
          var next = Math.min(28, Math.max(16, cur + d));
          if (tempVal) tempVal.textContent = next + '°';
          if (roomTemp) roomTemp.textContent = String(next);
        });
      });

      var toggle = panel ? panel.querySelector('.tx-toggle') : null;
      if (toggle) toggle.addEventListener('click', function () {
        var on = toggle.getAttribute('aria-checked') === 'true';
        toggle.setAttribute('aria-checked', on ? 'false' : 'true');
        if (light instanceof HTMLInputElement) {
          light.value = on ? '72' : '28';
          applyLight();
        }
      });

      if (light) light.addEventListener('input', applyLight);
      if (blind) blind.addEventListener('input', applyBlind);
      applyLight();
      applyBlind();

      var form = document.getElementById('tx-form');
      if (form instanceof HTMLFormElement) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = document.getElementById('tx-form-note');
          if (note) {
            note.hidden = false;
            note.textContent = 'Reçu. Un vrai humain répondra en un jour avec votre esquisse de coffret.';
          }
          form.reset();
        });
      }
    })();
  </script>

<style>
  .tx {
    --bg: #E0E5EC;
    --ink: #4c566a;
    --ink-soft: #7b8499;
    --dark: #a3b1c6;
    --light: #ffffff;
    --accent: #EDE6DA;
    --radius: 26px;
    background: var(--bg);
    color: var(--ink);
    font-family: "Nunito", system-ui, sans-serif;
    overflow-x: clip;
    line-height: 1.6;
    margin: 0;
  }
  .tx *, .tx *::before, .tx *::after { box-sizing: border-box; }
  .tx img { display: block; max-width: 100%; }
  .tx a { color: inherit; }
  .tx-wrap { width: min(1080px, 92%); margin-inline: auto; }

  .tx-press { transition: box-shadow .18s ease, transform .18s ease; }
  .tx-press:active { transform: translateY(1px); }

  .tx-bar {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; gap: 26px;
    padding: 14px clamp(18px, 4vw, 40px);
    background: rgba(224, 229, 236, 0.88);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 6px 18px rgba(163, 177, 198, 0.45);
  }
  .tx-bar nav { display: flex; gap: 22px; margin-left: auto; font-weight: 700; font-size: 0.95rem; }
  .tx-bar nav a { text-decoration: none; opacity: 0.75; }
  .tx-bar nav a:hover { opacity: 1; }
  .tx-logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 900; font-size: 1.25rem; text-decoration: none; }
  .tx-logo-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--bg); box-shadow: 3px 3px 7px var(--dark), -3px -3px 7px var(--light), inset 2px 2px 4px var(--dark); }

  .tx-btn {
    display: inline-block; padding: 14px 28px; border: 0; border-radius: 999px;
    background: var(--bg); color: var(--ink); font: inherit; font-weight: 800; text-decoration: none; cursor: pointer;
    box-shadow: 6px 6px 14px var(--dark), -6px -6px 14px var(--light);
  }
  .tx-btn:hover { box-shadow: 8px 8px 20px var(--dark), -8px -8px 20px var(--light); }
  .tx-btn-small { padding: 10px 20px; font-size: 0.9rem; }

  .tx-kicker { font-weight: 800; font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 10px; }
  .tx-h1 { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.04; font-weight: 900; margin: 0 0 14px; letter-spacing: -0.01em; }
  .tx-h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.08; font-weight: 900; margin: 0 0 18px; }
  .tx-sub { color: var(--ink-soft); font-size: 1.08rem; max-width: 60ch; }

  .tx-room { padding: clamp(48px, 8vw, 96px) 0 24px; }
  .tx-panel {
    margin-top: 30px; padding: clamp(20px, 4vw, 40px);
    background: var(--bg); border-radius: 34px;
    box-shadow: 12px 12px 30px var(--dark), -12px -12px 30px var(--light);
    border-top: 6px solid var(--accent);
  }
  .tx-tabs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
  .tx-tab {
    padding: 11px 20px; border: 0; border-radius: 999px; background: var(--bg); color: var(--ink);
    font: inherit; font-weight: 800; cursor: pointer;
    box-shadow: 5px 5px 12px var(--dark), -5px -5px 12px var(--light);
  }
  .tx-tab[aria-selected="true"] { box-shadow: inset 5px 5px 12px var(--dark), inset -5px -5px 12px var(--light); }

  .tx-stage { margin-bottom: 26px; }
  .tx-img-frame {
    border-radius: var(--radius); overflow: hidden; position: relative;
    box-shadow: inset 8px 8px 20px rgba(76, 86, 106, 0.35);
    background: #c9d2de;
  }
  .tx-img-frame img { width: 100%; height: clamp(280px, 46vw, 480px); object-fit: cover; transition: filter .5s ease; }
  .tx-stage-meta {
    position: absolute; left: 18px; bottom: 16px; right: 18px;
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap;
    background: rgba(224, 229, 236, 0.82); backdrop-filter: blur(8px);
    border-radius: 16px; padding: 10px 18px;
    box-shadow: 4px 4px 12px rgba(163, 177, 198, 0.6);
  }
  .tx-stage-meta p { margin: 0; font-size: 0.95rem; }
  .tx-stage-meta p:last-child { color: var(--ink-soft); font-weight: 700; }

  .tx-swatches { margin-bottom: 26px; }
  .tx-ctl-label { font-weight: 800; font-size: 0.9rem; color: var(--ink-soft); margin: 0 0 10px; }
  .tx-ctl-label span { color: var(--ink); }
  .tx-swatch-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .tx-swatch {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 9px 18px 9px 10px; border: 0; border-radius: 999px; background: var(--bg);
    font: inherit; font-weight: 800; font-size: 0.92rem; color: var(--ink); cursor: pointer;
    box-shadow: 5px 5px 12px var(--dark), -5px -5px 12px var(--light);
  }
  .tx-swatch span { width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 2px 2px 5px rgba(76,86,106,.35); }
  .tx-swatch.is-active { box-shadow: inset 5px 5px 12px var(--dark), inset -5px -5px 12px var(--light); }

  .tx-ctls { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-bottom: 8px; }
  .tx-slider { width: 100%; appearance: none; -webkit-appearance: none; height: 14px; border-radius: 999px; background: var(--bg); box-shadow: inset 4px 4px 10px var(--dark), inset -4px -4px 10px var(--light); outline: none; }
  .tx-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 30px; height: 30px; border-radius: 50%; background: var(--bg); box-shadow: 4px 4px 10px var(--dark), -4px -4px 10px var(--light); cursor: pointer; }
  .tx-slider::-moz-range-thumb { width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--bg); box-shadow: 4px 4px 10px var(--dark), -4px -4px 10px var(--light); cursor: pointer; }
  .tx-temp-row { display: flex; align-items: center; gap: 12px; }
  .tx-round {
    width: 52px; height: 52px; border: 0; border-radius: 50%; background: var(--bg); color: var(--ink);
    font: inherit; font-size: 1.5rem; font-weight: 800; cursor: pointer;
    box-shadow: 5px 5px 12px var(--dark), -5px -5px 12px var(--light);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .tx-toggle {
    width: 64px; height: 34px; border: 0; border-radius: 999px; background: var(--bg); cursor: pointer; position: relative;
    box-shadow: inset 4px 4px 10px var(--dark), inset -4px -4px 10px var(--light);
  }
  .tx-toggle-knob {
    position: absolute; top: 5px; left: 5px; width: 24px; height: 24px; border-radius: 50%; background: var(--bg);
