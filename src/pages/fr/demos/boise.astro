---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Demo microsite: Boisé Paysage, fictional landscaping atelier, Gatineau QC.
// Standalone art direction. Deep forest greens, cream, elegant serif.
// Not connected to the WEBAO theme system.
// Structure : un calendrier saisonnier. La page est une année au jardin : printemps, été,
// automne, hiver en chapitres. Les services sont ce qu'on fait chaque saison. Les saisons
// sont la navigation.
const IMG = {
  hero: "/demos/boise/01.jpg",
  hands: "/demos/boise/02.jpg",
  path: "https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?q=80&w=1000&auto=format&fit=crop",
  yard: "https://images.unsplash.com/photo-1598902108854-10e335adac99?q=80&w=1000&auto=format&fit=crop",
  design: "/demos/boise/03.jpg",
  lawn: "/demos/boise/04.jpg",
};

const SEASONS = [
  {
    id: "spring", name: "Printemps", months: "Avril – mai", fleuron: "❧",
    img: IMG.hands, imgAlt: "Mains qui plantent des semis dans la terre noire",
    caption: "Plantation de printemps, Chelsea",
    intro: "La terre se réveille affamée. On nettoie, on divise, on plante, et toute l'année se joue en six semaines environ.",
    ground: ["Nettoyage et bordures", "Division des vivaces", "Plantations et tourbe"],
    wedo: ["Visites de nettoyage printanier", "Plans de plantation selon votre lumière", "Tourbe et nouvelles plates-bandes installées"],
    note: "Le printemps se remplit dès mars. Les premiers messages ont les meilleures dates.",
  },
  {
    id: "summer", name: "Été", months: "Juin – août", fleuron: "❧",
    img: IMG.lawn, imgAlt: "Une pelouse verte et dense en été",
    caption: "La grande pelouse, Chelsea",
    intro: "Le jardin se pavane et demande très peu. On reste honnête : bordures nettes, eau réglée, et une pelouse qui ne voit jamais de produits chimiques.",
    ground: ["Taille et pincement", "Réglage de l'irrigation", "Pelouse au naturel"],
    wedo: ["Visites d'entretien saisonnier", "Irrigation installée et réglée", "Tournées de taille estivale"],
    note: "Un jardin entretenu en août a l'air facile. Il ne l'est pas. C'est le but.",
  },
  {
    id: "autumn", name: "Automne", months: "Septembre – octobre", fleuron: "❧",
    img: IMG.path, imgAlt: "Une allée de jardin couverte de feuilles d'automne",
    caption: "L'allée des fougères, Aylmer",
    intro: "Le jardin paie ses dettes. On plante le printemps pour lequel vous nous remercierez, on borde tout le monde, et on laisse les feuilles travailler où elles tombent.",
    ground: ["Bulbes pour le printemps", "Protection hivernale", "Paillis de feuilles, pas d'ensachage"],
    wedo: ["Service de mise au lit d'automne", "Plantation de bulbes par centaines", "Protection hivernale des plantes fragiles"],
    note: "Les feuilles sont de l'engrais gratuit. On les déchiquette sur place, sans sacs.",
  },
  {
    id: "winter", name: "Hiver", months: "Novembre – mars", fleuron: "❧",
    img: IMG.design, imgAlt: "Un plan d'aménagement esquissé sur papier",
    caption: "Planification d'hiver, l'atelier",
    intro: "Le jardin dort et on dessine. L'hiver, c'est quand on dessine les plates-bandes de l'an prochain, qu'on taille les fruitiers et qu'on gère la neige.",
    ground: ["Déneigement et déglaçage", "Plan des plates-bandes de l'an prochain", "Taille des fruitiers"],
    wedo: ["Séances de planification d'hiver", "Contrats de neige, en toute discrétion", "Taille des arbres fruitiers"],
    note: "Les plus beaux jardins se dessinent en janvier et se plantent en mai.",
  },
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boisé Paysage : une année au jardin · Gatineau</title>
  <meta name="description" content="Boisé Paysage : un atelier d'aménagement à Gatineau, au rythme des saisons. Plantation printanière, entretien estival, mise au lit automnale, planification hivernale." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body class="bs">

  <!-- SEASON NAV -->
  <header class="bs-navwrap">
    <nav class="bs-nav" aria-label="Les saisons">
      <a class="bs-logo" href="#top" aria-label="Boisé Paysage, retour à la couverture">Boisé <em>Paysage</em></a>
      <div class="bs-seasons-nav">
        {SEASONS.map((s) => (
          <a href={"#" + s.id}>{s.name}</a>
        ))}
      </div>
      <a class="bs-cta" href="#begin">Créer un jardin</a>
    </nav>
  </header>

  <main id="top">
    <!-- COVER -->
    <section class="bs-cover" aria-label="Une année au jardin">
      <div class="bs-wrap-narrow">
        <p class="bs-kicker">Atelier d'aménagement · Gatineau, Outaouais · depuis 2011</p>
        <h1 class="bs-h1">Une année au<br /><em>jardin</em></h1>
        <p class="bs-cover-sub">Un jardin n'est jamais fini. Il s'entretient. Notre travail suit l'année, pas la facture : quatre saisons, quatre chapitres, un jardin plus beau chaque année.</p>
        <p class="bs-fleuron" aria-hidden="true">❧</p>
      </div>
    </section>

    <!-- SEASON CHAPTERS -->
    {SEASONS.map((s) => (
      <section class="bs-season" id={s.id} aria-label={s.name}>
        <div class="bs-wrap">
          <header class="bs-season-head">
            <p class="bs-fleuron" aria-hidden="true">{s.fleuron}</p>
            <p class="bs-months">{s.months}</p>
            <h2 class="bs-h2">{s.name}</h2>
            <p class="bs-season-intro">{s.intro}</p>
          </header>
          <div class="bs-season-grid">
            <figure class="bs-season-photo">
              <img src={s.img} alt={s.imgAlt} loading="lazy" />
              <figcaption>{s.caption}</figcaption>
            </figure>
            <div class="bs-season-cols">
              <div>
                <h3>Dans la terre</h3>
                <ul>
                  {s.ground.map((g) => (<li>{g}</li>))}
                </ul>
              </div>
              <div>
                <h3>Ce qu'on fait</h3>
                <ul>
                  {s.wedo.map((w) => (<li>{w}</li>))}
                </ul>
              </div>
            </div>
          </div>
          <p class="bs-season-note"><em>{s.note}</em></p>
        </div>
      </section>
    ))}

    <!-- BEGIN -->
    <section class="bs-begin" id="begin">
      <div class="bs-begin-bg" aria-hidden="true"><img src={IMG.hero} alt="" loading="lazy" /></div>
      <div class="bs-wrap bs-begin-in">
        <div class="bs-begin-copy">
          <p class="bs-kicker bs-kicker-light">Commencer</p>
          <h2 class="bs-h2 bs-h2-light">Parlez-nous de<br /><em>votre terrain.</em></h2>
          <p>Les visites sont gratuites à Gatineau, et on répond à chaque message en deux jours ouvrables. Chaque projet commence par une marche : on regarde votre lumière, votre sol, votre drainage, et votre vraie façon de vivre dehors.</p>
          <div class="bs-gardens">
            <figure>
              <img src={IMG.yard} alt="L'allée des fougères, un jardin d'ombre à Aylmer" loading="lazy" />
              <figcaption>L'allée des fougères · Aylmer</figcaption>
            </figure>
          </div>
          <address class="bs-address">
            Atelier · 456, rue Fictive, Gatineau QC<br />
            <a href="tel:+18195550117">(819) 555-0117</a> · Lun–ven, 8 h–17 h
          </address>
        </div>
        <form class="bs-form" id="bs-form" novalidate>
          <h3>Créer un jardin</h3>
          <label>Votre nom<input type="text" name="name" required placeholder="Alex Tremblay" /></label>
          <label>Courriel<input type="email" name="email" required placeholder="alex@example.com" /></label>
          <label>Votre projet
            <select name="project">
              <option>Choisir…</option>
              <option>Aménagement complet</option>
              <option>Forfait d'entretien saisonnier</option>
              <option>Pierre ou allées</option>
              <option>Autre chose</option>
            </select>
          </label>
          <label>À propos de votre terrain<textarea name="land" rows="4" placeholder="Soleil, ombre, pente, rêves…"></textarea></label>
          <button class="bs-btn" type="submit">Envoyer à l'atelier</button>
          <p class="bs-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="bs-footer">
    <p class="bs-fleuron" aria-hidden="true">❧</p>
    <div class="bs-wrap bs-footer-in">
      <p>© 2026 Boisé Paysage. Atelier fictif de démonstration. Aucune pelouse n'a été blessée.</p>
      <p>456, rue Fictive, Gatineau QC · <a href="tel:+18195550117">(819) 555-0117</a></p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    // Formulaire démo : ne soumet rien nulle part
    (function () {
      var form = document.getElementById('bs-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.bs-form-note');
        if (note) note.textContent = 'Reçu. Camille vous répondra sous deux jours ouvrables pour planifier la marche.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .bs {
      --bs-forest: #1E3D2B;
      --bs-forest-deep: #142A1E;
      --bs-cream: #F4F1E6;
      --bs-cream-2: #EAE5D3;
      --bs-moss: #7A8B5C;
      --bs-sage: #B7C4A8;
      --bs-bark: #4A3B2A;
      --bs-serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
      margin: 0;
      background: var(--bs-cream);
      color: var(--bs-forest);
      font-family: var(--bs-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .bs *, .bs *::before, .bs *::after { box-sizing: border-box; }
    .bs img { display: block; max-width: 100%; }
    .bs-wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .bs-wrap-narrow { max-width: 720px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .bs em { font-style: italic; }

    /* season nav */
    .bs-navwrap { position: sticky; top: 0; z-index: 60; background: rgba(244, 241, 230, 0.92); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(30, 61, 43, 0.18); }
    .bs-nav { display: flex; align-items: center; gap: 26px; max-width: 1120px; margin: 0 auto; padding: 14px clamp(22px, 4vw, 44px); }
    .bs-logo { font-size: 24px; font-weight: 600; color: var(--bs-forest); text-decoration: none; margin-right: auto; }
    .bs-logo em { color: var(--bs-moss); }
    .bs-seasons-nav { display: flex; gap: 4px; }
    .bs-seasons-nav a { font-size: 17px; font-weight: 500; color: var(--bs-bark); text-decoration: none; padding: 8px 14px; border-radius: 999px; }
    .bs-seasons-nav a:hover { background: var(--bs-cream-2); color: var(--bs-forest-deep); }
    .bs-cta {
      font-size: 16.5px; font-weight: 600; color: var(--bs-cream); text-decoration: none;
      background: var(--bs-forest); padding: 11px 24px; border-radius: 999px; white-space: nowrap;
    }
    .bs-cta:hover { background: var(--bs-forest-deep); }

    /* cover */
    .bs-cover { padding: clamp(90px, 12vw, 150px) 0 clamp(60px, 8vw, 100px); text-align: center; }
    .bs-kicker { font-size: 15px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--bs-moss); margin: 0 0 26px; font-weight: 600; }
    .bs-kicker-light { color: var(--bs-sage); }
    .bs-h1 { font-size: clamp(3.8rem, 12vw, 8rem); line-height: 0.95; font-weight: 500; margin: 0 0 28px; }
    .bs-h1 em, .bs-h2 em { color: var(--bs-moss); }
    .bs-cover-sub { font-size: clamp(1.2rem, 2.6vw, 1.45rem); line-height: 1.75; color: var(--bs-bark); margin: 0 auto 30px; max-width: 46ch; }
    .bs-fleuron { font-size: 30px; color: var(--bs-moss); margin: 0; }

    /* season chapters */
    .bs-season { padding: clamp(64px, 9vw, 120px) 0; border-top: 1px solid rgba(30, 61, 43, 0.16); }
    .bs-season:nth-of-type(even) { background: var(--bs-cream-2); }
    .bs-season-head { text-align: center; margin-bottom: clamp(34px, 5vw, 56px); }
    .bs-season-head .bs-fleuron { margin-bottom: 14px; }
    .bs-months { font-size: 16px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--bs-moss); margin: 0 0 12px; font-weight: 600; }
    .bs-h2 { font-size: clamp(3rem, 9vw, 5.6rem); line-height: 0.95; font-weight: 500; margin: 0 0 20px; }
    .bs-h2-light { color: var(--bs-cream); }
    .bs-h2-light em { color: var(--bs-sage); }
    .bs-season-intro { font-size: clamp(1.2rem, 2.6vw, 1.45rem); line-height: 1.7; color: var(--bs-bark); margin: 0 auto; max-width: 52ch; font-style: italic; }
    .bs-season-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 5vw, 70px); align-items: start; margin-bottom: 30px; }
    .bs-season:nth-of-type(odd) .bs-season-photo { order: 2; }
    .bs-season-photo { margin: 0; }
    .bs-season-photo img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 4px; box-shadow: 0 24px 60px rgba(20, 42, 30, 0.18); }
    .bs-season-photo figcaption { font-size: 16px; font-style: italic; color: var(--bs-bark); margin-top: 12px; }
    .bs-season-cols { display: grid; gap: 34px; }
    .bs-season-cols h3 { font-size: 15px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--bs-moss); margin: 0 0 14px; }
    .bs-season-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .bs-season-cols li { font-size: 21px; line-height: 1.45; padding-left: 30px; position: relative; }
    .bs-season-cols li::before { content: "❧"; position: absolute; left: 0; color: var(--bs-moss); font-size: 17px; }
    .bs-season-note { text-align: center; font-size: 20px; color: var(--bs-bark); margin: 0; }

    /* begin */
    .bs-begin { position: relative; padding: clamp(80px, 10vw, 130px) 0; overflow: hidden; background: var(--bs-forest-deep); }
    .bs-begin-bg { position: absolute; inset: 0; opacity: 0.25; }
    .bs-begin-bg img { width: 100%; height: 100%; object-fit: cover; }
    .bs-begin-in { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 80px); align-items: start; }
    .bs-begin-copy { color: var(--bs-cream); }
    .bs-begin-copy > p:not(.bs-kicker):not(.bs-fleuron) { font-size: 19px; line-height: 1.75; color: #DCD6C2; margin: 0 0 28px; max-width: 44ch; }
    .bs-gardens { display: grid; gap: 14px; margin-bottom: 28px; }
    .bs-gardens figure { margin: 0; }
    .bs-gardens img { width: 100%; aspect-ratio: 16/8; object-fit: cover; border-radius: 4px; }
    .bs-gardens figcaption { font-size: 15px; font-style: italic; color: var(--bs-sage); margin-top: 8px; }
    .bs-address { font-style: normal; font-size: 18px; line-height: 1.8; color: #DCD6C2; }
    .bs-address a { color: var(--bs-sage); }
    .bs-form { background: var(--bs-cream); border-radius: 6px; padding: clamp(28px, 4vw, 44px); display: grid; gap: 18px; color: var(--bs-forest); }
    .bs-form h3 { font-size: 30px; font-weight: 600; margin: 0; }
    .bs-form label { display: grid; gap: 8px; font-size: 14px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--bs-bark); }
    .bs-form input, .bs-form select, .bs-form textarea {
      font-family: var(--bs-serif); font-size: 18px; color: var(--bs-forest);
      background: #fff; border: 1px solid var(--bs-sage); border-radius: 4px; padding: 13px 16px; width: 100%;
    }
    .bs-form input:focus, .bs-form select:focus, .bs-form textarea:focus { outline: 2px solid var(--bs-moss); outline-offset: 2px; }
    .bs-btn {
      font-family: var(--bs-serif); font-size: 19px; font-weight: 600; letter-spacing: 0.06em;
      background: var(--bs-forest); color: var(--bs-cream); border: none; border-radius: 999px;
      padding: 16px 30px; cursor: pointer;
    }
    .bs-btn:hover { background: var(--bs-forest-deep); }
    .bs-form-note { margin: 0; color: var(--bs-moss); font-size: 18px; font-style: italic; }
    .bs-form-note:empty { display: none; }

    /* footer */
    .bs-footer { text-align: center; padding: 70px 0 90px; }
    .bs-footer .bs-fleuron { margin-bottom: 20px; }
    .bs-footer-in { display: grid; gap: 8px; color: var(--bs-bark); font-size: 17px; }
    .bs-footer-in p { margin: 0; }
    .bs-footer-in a { color: var(--bs-forest); }

    @media (max-width: 900px) {
      .bs-seasons-nav { display: none; }
      .bs-season-grid { grid-template-columns: 1fr; }
      .bs-season:nth-of-type(odd) .bs-season-photo { order: 0; }
      .bs-begin-in { grid-template-columns: 1fr; }
    }
  </style>
</body>
</html>
