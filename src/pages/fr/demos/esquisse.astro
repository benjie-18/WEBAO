---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Site de démonstration : Esquisse, studio fictif de concepts architecturaux, Montréal.
// Direction artistique autonome. Croquis conceptuel : papier, crayon, aquarelle.
// Structure : CARNET OUVERT. Pas de hero. La page s'ouvre sur une page de croquis;
// les projets sont des doubles pages avec annotations en marge; le contact est
// « commander un croquis ».
const IMG = {
  hero: "/demos/esquisse/01.jpg",
  maison: "/demos/esquisse/02.jpg",
  atelier: "/demos/esquisse/03.jpg",
  serre: "/demos/esquisse/04.jpg",
  pavillon: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?q=80&w=900&auto=format&fit=crop",
};
const PROJECTS = [
  { img: IMG.maison, alt: "Aquarelle d'un chalet au bord d'un lac", title: "Maison Brume", date: "page 12 · mars", note: "Un chalet au bord d'un lac des Laurentides. Une longue fenêtre, un poêle à bois, zéro corridor. En cours d'aquarelle.", tags: "résidentiel · 180 m² · concept", margin: "la cliente a versé une larme. bon signe." },
  { img: IMG.atelier, alt: "Croquis de l'atelier d'une peintre au mur courbe", title: "Atelier Lumen", date: "page 27 · mai", note: "L'atelier d'une peintre, avec un mur nord courbe qui capte une lumière douce toute la journée. Le toit se soulève comme un souffle retenu.", tags: "atelier · 90 m² · en développement", margin: "la lumière du nord = éclairage gratuit" },
  { img: IMG.serre, alt: "Croquis d'une serre sur un toit", title: "Serre Urbaine", date: "page 41 · juillet", note: "Une serre sur le toit d'un café du Mile End. Des tomates en haut, des espressos en bas, tout le monde est content.", tags: "commercial · 60 m² · permis obtenu", margin: "le permis a pris 4 mois. ça valait le coup." },
  { img: IMG.pavillon, alt: "Intérieur chaleureux en bois du pavillon construit", title: "Pavillon Cèdre", date: "page 58 · construit en 2025", note: "Un pavillon de lecture en cèdre pour un jardin public. Ça sent la boîte de crayons, ça accueille douze rêveurs.", tags: "public · 45 m² · construit en 2025", margin: "celui-ci a quitté le carnet !" },
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="esquisse" locale="fr" title="Esquisse : Concepts architecturaux, dessinés d'abord" description="Esquisse est un studio de concepts à Montréal. Chaque bâtiment commence par un gribouillis : croquis sur napperon, études à l'aquarelle, puis plans." ogImage="https://webao.ca/demos/esquisse/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet" />
</head>
<body class="esq">

  <EscapeHatch locale="fr" />

  <!-- reliure du carnet -->
  <div class="esq-binding" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>

  <!-- mini navigation en marge -->
  <nav class="esq-margin-nav" aria-label="Index du carnet">
    <a class="esq-logo" href="#top" aria-label="Esquisse, accueil">
      <svg viewBox="0 0 40 40" width="30" height="30" aria-hidden="true"><path d="M6 30 L7 12 L20 6 L19 7 L33 13 L32 30 Z" fill="none" stroke="#3A3A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 30 L17 20 L23 21 L22 30" fill="none" stroke="#3A3A3A" stroke-width="2" stroke-linecap="round"/></svg>
      <span>Esquisse</span>
    </a>
    <div class="esq-index">
      <a href="#p12">p.12</a>
      <a href="#p27">p.27</a>
      <a href="#p41">p.41</a>
      <a href="#p58">p.58</a>
      <a href="#commission" class="esq-index-cta">commander →</a>
    </div>
  </nav>

  <main id="top" class="esq-book">

    <!-- PAGE D'OUVERTURE : pas de hero, juste un croquis en cours -->
    <section class="esq-page esq-opening" aria-label="Page d'ouverture du carnet">
      <p class="esq-pageno">p.1 · octobre</p>
      <figure class="esq-sketch">
        <img src={IMG.hero} alt="Croquis conceptuel au crayon et à l'aquarelle en cours" loading="eager" fetchpriority="high" decoding="async" />
        <span class="esq-tape" aria-hidden="true"></span>
      </figure>
      <h1 class="esq-h1">Chaque bâtiment<br />commence par <span class="esq-scribble">un gribouillis.</span></h1>
      <p class="esq-lede">Nous sommes Esquisse, un petit studio qui dessine maisons, ateliers et pavillons à l'ancienne : le crayon d'abord, l'aquarelle ensuite, les plans seulement quand l'idée l'a mérité.</p>
      <p class="esq-margin-note">← cette page est encore humide</p>
      <a class="esq-turn" href="#p12" aria-label="Tourner à la première page de projet">tournez la page ↓</a>
    </section>

    <!-- DOUBLES PAGES DE PROJETS -->
    {PROJECTS.map((p, i) => (
      <section class="esq-page esq-spread" id={["p12","p27","p41","p58"][i]} aria-label={"Projet : " + p.title}>
        <p class="esq-pageno">{p.date}</p>
        <div class="esq-spread-grid">
          <figure class="esq-sketch">
            <img src={p.img} alt={p.alt} loading="lazy" decoding="async" />
            <span class="esq-tape" aria-hidden="true"></span>
          </figure>
          <div class="esq-spread-copy">
            <h2 class="esq-h2">{p.title}</h2>
            <p class="esq-tags">{p.tags}</p>
            <p>{p.note}</p>
            <p class="esq-margin-note">↳ {p.margin}</p>
          </div>
        </div>
      </section>
    ))}

    <!-- MÉTHODE : notes en marge sur une longue page -->
    <section class="esq-page esq-process" aria-label="Notre façon de travailler">
      <p class="esq-pageno">p.73 · méthode</p>
      <h2 class="esq-h2">Du napperon <span class="esq-scribble">au plan</span></h2>
      <ol class="esq-steps">
        <li><h3>Le Napperon</h3><p>On visite votre terrain, crayon en main, sans idée préconçue. Au deuxième café, les premières lignes apparaissent. Laides, honnêtes, pleines de promesses.</p></li>
        <li><h3>Le Mur à Gribouillis</h3><p>Une semaine, cent vignettes épinglées au mur du studio. On garde les trois qui nous font sourire et on recycle le reste.</p></li>
        <li><h3>L'Aquarelle</h3><p>Études de volumétrie, de lumière et de matériaux en lavis pâles. Vous voyez comment le soleil du matin tombera vraiment sur votre table de cuisine.</p></li>
        <li><h3>Le Plan</h3><p>C'est seulement là que la CAO entre en scène. Des dessins prêts pour le permis, fidèles au croquis du début.</p></li>
      </ol>
      <p class="esq-margin-note">on gomme beaucoup. on en est fiers.</p>
    </section>

    <!-- NOTES ÉPINGLÉES -->
    <section class="esq-page esq-notes" aria-label="Notes de clients">
      <p class="esq-pageno">p.81 · notes épinglées</p>
      <div class="esq-note-wall">
        <blockquote class="esq-note esq-tilt-l">
          <p>« Ils sont arrivés avec des aquarelles au lieu de rendus. Six mois plus tard, on emménageait dans le croquis. »</p>
          <cite>Marc et Léa D., clients de la Maison Brume</cite>
        </blockquote>
        <blockquote class="esq-note esq-tilt-r">
          <p>« Une ligne droite, c'est une décision prise trop vite. On gomme beaucoup, et on en est fiers. »</p>
          <cite>règle du studio nº 4</cite>
        </blockquote>
        <blockquote class="esq-note esq-tilt-l">
          <p>« Le pavillon coule un peu quand il pleut de côté. On l'aime quand même. Il a été dessiné sous la pluie. »</p>
          <cite>le comité du jardin</cite>
        </blockquote>
      </div>
    </section>

    <!-- TARIFS : choisissez un crayon -->
    <section class="esq-page esq-pricing" aria-label="Tarifs">
      <p class="esq-pageno">p.90 · choisissez un crayon</p>
      <h2 class="esq-h2">Choisissez <span class="esq-scribble">un crayon</span></h2>
      <div class="esq-pencils">
        <article class="esq-pencil">
          <h3>Esquisse Rapide <span>950 $</span></h3>
          <ul><li>Visite du site et séance napperon</li><li>Un concept, dessiné à la main</li><li>Deux semaines, du début à la fin</li></ul>
        </article>
        <article class="esq-pencil esq-pencil-hot">
          <h3>Concept Complet <span>3 800 $</span></h3>
          <ul><li>Trois concepts parmi lesquels choisir</li><li>Rendus aquarelle et maquette de volumétrie</li><li>Études de lumière pour chaque saison</li><li>Estimation des coûts avec un constructeur</li></ul>
        </article>
        <article class="esq-pencil">
          <h3>Bâtiment Signature <span>Sur mesure</span></h3>
          <ul><li>Tout le Concept Complet</li><li>Jeu de dessins prêt pour le permis</li><li>Visites de chantier pendant la construction</li></ul>
        </article>
      </div>
    </section>

    <!-- COMMANDE : apportez-nous un napperon -->
    <section class="esq-page esq-commission" id="commission" aria-label="Commander un croquis">
      <p class="esq-pageno">p.99 · dernière page</p>
      <h2 class="esq-h2">Apportez-nous <span class="esq-scribble">un napperon.</span></h2>
      <p class="esq-lede">Une photo d'un croquis sur napperon compte. Une phrase aussi. Dites-nous ce dont vous rêvez et nous apporterons les crayons.</p>
      <form class="esq-form" id="esq-form" novalidate>
        <label>Votre nom<input type="text" name="name" required autocomplete="name" placeholder="Jeanne Tremblay" /></label>
        <label>Courriel<input type="email" name="email" required autocomplete="email" placeholder="jeanne@example.com" /></label>
        <label>Le rêve<textarea name="message" rows="4" required placeholder="Une petite cabane avec une longue fenêtre..."></textarea></label>
        <button class="esq-btn" type="submit">L'épingler au mur</button>
        <p class="esq-form-note" role="status" aria-live="polite"></p>
      </form>
      <p class="esq-margin-note">← nous répondons avec un croquis, pas un devis</p>
      <address class="esq-addr">Esquisse Studio · 412, rue Fictive, Montréal QC · <a href="tel:+15145550134">(514) 555-0134</a></address>
    </section>

  </main>

  <footer class="esq-footer">
    <p>© 2026 Esquisse. Démo fictive. Tous les bâtiments commencent par des gribouillis.</p>
  </footer>

  <script>
    (function () {
      var formEl = document.getElementById('esq-form');
      if (formEl instanceof HTMLFormElement) {
        const form = formEl;
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var note = form.querySelector('.esq-form-note');
          if (note) note.textContent = 'Épinglé. Nous répondrons avec un croquis, pas un devis.';
          form.reset();
        });
      }
    })();
  </script>

<style>
  .esq {
    --esq-paper: #F7F2E8;
    --esq-ink: #3A3A3A;
    --esq-faint: #8a8272;
    --esq-blue: #7FA8C9;
    --esq-ochre: #D9A441;
    --esq-serif: "Cormorant Garamond", Georgia, serif;
    --esq-hand: "Caveat", cursive;
    margin: 0;
    background: var(--esq-paper);
    background-image: radial-gradient(rgba(58,58,58,.06) 1px, transparent 1px);
    background-size: 26px 26px;
    color: var(--esq-ink);
    font-family: var(--esq-serif);
    font-size: 1.12rem;
    overflow-x: clip;
  }
  .esq *, .esq *::before, .esq *::after { box-sizing: border-box; }
  .esq img { display: block; max-width: 100%; }
  .esq a { color: inherit; }

  .esq-binding {
    position: fixed; left: 0; top: 0; bottom: 0; width: 34px; z-index: 60;
    display: flex; flex-direction: column; justify-content: space-evenly; align-items: center;
    background: linear-gradient(90deg, rgba(58,58,58,.12), transparent);
  }
  .esq-binding i { width: 16px; height: 16px; border-radius: 50%; border: 3px solid var(--esq-faint); background: var(--esq-paper); }

  .esq-margin-nav {
    position: fixed; top: 0; right: 0; z-index: 60;
    display: flex; align-items: center; gap: 26px;
    padding: 16px clamp(16px, 3vw, 34px);
    font-family: var(--esq-hand); font-size: 1.25rem;
  }
  .esq-logo { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-size: 1.5rem; font-weight: 700; }
  .esq-index { display: flex; gap: 16px; align-items: center; }
  .esq-index a { text-decoration: none; color: var(--esq-faint); }
  .esq-index a:hover { color: var(--esq-ink); }
  .esq-index-cta { color: var(--esq-ink) !important; border-bottom: 2px solid var(--esq-ochre); }

  .esq-book { max-width: 1060px; margin: 0 auto; padding: 0 clamp(20px, 6vw, 70px) 0 calc(clamp(20px, 6vw, 70px) + 20px); }

  .esq-page {
    position: relative; padding: clamp(70px, 10vw, 120px) 0;
    border-bottom: 2px dashed rgba(58,58,58,.18);
  }
  .esq-page:last-child { border-bottom: 0; }
  .esq-pageno {
    font-family: var(--esq-hand); font-size: 1.2rem; color: var(--esq-faint);
    margin: 0 0 26px;
  }
  .esq-h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: 1.02; font-weight: 500; margin: 26px 0 18px; }
  .esq-h2 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.05; font-weight: 500; margin: 0 0 20px; }
  .esq-scribble { position: relative; white-space: nowrap; }
  .esq-scribble::after {
    content: ""; position: absolute; left: -4px; right: -6px; bottom: 2px; height: 12px;
    background: rgba(217,164,65,.35); z-index: -1; transform: rotate(-1.2deg); border-radius: 2px;
  }
  .esq-lede { font-size: 1.3rem; line-height: 1.55; max-width: 56ch; }
  .esq-margin-note {
    font-family: var(--esq-hand); font-size: 1.35rem; color: var(--esq-faint);
    margin: 18px 0 0; transform: rotate(-1deg);
  }

  .esq-sketch { position: relative; margin: 0; display: inline-block; max-width: 100%; }
  .esq-sketch img {
    border: 1px solid rgba(58,58,58,.25); border-radius: 3px;
    box-shadow: 0 18px 44px rgba(58,58,58,.16);
    filter: sepia(.14) contrast(.97);
  }
  .esq-tape {
    position: absolute; top: -14px; left: 50%; transform: translateX(-50%) rotate(-2deg);
    width: 120px; height: 30px; background: rgba(217,164,65,.4);
    border-left: 1px dashed rgba(58,58,58,.3); border-right: 1px dashed rgba(58,58,58,.3);
  }
  .esq-opening .esq-sketch { margin-bottom: 10px; }
  .esq-opening .esq-sketch img { max-height: 46vh; width: auto; margin: 0 auto; }
  .esq-turn { display: inline-block; margin-top: 26px; font-family: var(--esq-hand); font-size: 1.5rem; text-decoration: none; border-bottom: 2px solid var(--esq-blue); }

  .esq-spread-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 5vw, 60px); align-items: start; }
  .esq-spread:nth-of-type(even) .esq-spread-grid > .esq-sketch { order: 2; }
  .esq-spread .esq-sketch img { width: 100%; }
  .esq-spread .esq-sketch { transform: rotate(-.7deg); }
  .esq-spread:nth-of-type(even) .esq-sketch { transform: rotate(.8deg); }
  .esq-tags { font-family: var(--esq-hand); font-size: 1.25rem; color: var(--esq-faint); margin: 6px 0 12px; }
  .esq-spread-copy p { line-height: 1.6; }

  .esq-steps { list-style: none; margin: 30px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; counter-reset: step; }
  .esq-steps li { border-top: 3px solid var(--esq-ink); padding-top: 14px; }
  .esq-steps li:nth-child(2) { transform: translateY(14px); }
  .esq-steps li:nth-child(3) { transform: translateY(28px); }
  .esq-steps li:nth-child(4) { transform: translateY(42px); }
  .esq-steps h3 { font-family: var(--esq-hand); font-size: 1.7rem; margin: 0 0 8px; }
  .esq-steps p { font-size: 1.02rem; line-height: 1.55; color: #55504a; margin: 0; }
  .esq-process { padding-bottom: clamp(100px, 14vw, 170px); }

  .esq-note-wall { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 10px; }
  .esq-note {
    flex: 1 1 240px; margin: 0; padding: 26px;
    background: #FFFBEF; border: 1px solid rgba(58,58,58,.14);
    box-shadow: 0 14px 30px rgba(58,58,58,.12);
    font-size: 1.15rem; line-height: 1.5;
  }
  .esq-note cite { display: block; margin-top: 12px; font-family: var(--esq-hand); font-size: 1.25rem; color: var(--esq-faint); font-style: normal; }
  .esq-tilt-l { transform: rotate(-1.4deg); }
  .esq-tilt-r { transform: rotate(1.2deg); }

  .esq-pencils { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 26px; }
  .esq-pencil { border: 2px solid var(--esq-ink); border-radius: 4px; padding: 24px; background: rgba(255,255,255,.4); }
  .esq-pencil h3 { font-family: var(--esq-hand); font-size: 1.8rem; margin: 0 0 12px; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .esq-pencil h3 span { font-size: 1.4rem; color: var(--esq-faint); }
  .esq-pencil ul { margin: 0; padding-left: 20px; line-height: 1.7; }
  .esq-pencil-hot { background: #FFF3D6; border-color: var(--esq-ochre); transform: rotate(-.8deg); }

  .esq-form { max-width: 560px; margin-top: 26px; }
  .esq-form label { display: block; font-family: var(--esq-hand); font-size: 1.4rem; margin-bottom: 16px; }
  .esq-form input, .esq-form textarea {
    display: block; width: 100%; margin-top: 6px; padding: 12px 14px;
    background: rgba(255,255,255,.55); border: 1.5px solid var(--esq-ink); border-radius: 3px;
    font-family: var(--esq-serif); font-size: 1.05rem; color: var(--esq-ink);
  }
  .esq-form input:focus, .esq-form textarea:focus { outline: 2px solid var(--esq-blue); }
  .esq-btn {
    font-family: var(--esq-hand); font-size: 1.5rem; padding: 10px 30px; cursor: pointer;
    background: var(--esq-ink); color: var(--esq-paper); border: 0; border-radius: 3px;
    transform: rotate(-1deg);
  }
  .esq-btn:hover { background: #222; }
  .esq-form-note { font-family: var(--esq-hand); font-size: 1.4rem; color: #4a7a3f; margin: 14px 0 0; }
  .esq-addr { margin-top: 30px; font-style: normal; color: var(--esq-faint); }
  .esq-addr a { color: var(--esq-ink); }

  .esq-footer { text-align: center; padding: 40px 20px 100px; color: var(--esq-faint); font-family: var(--esq-hand); font-size: 1.25rem; }

  @media (max-width: 820px) {
    .esq-spread-grid { grid-template-columns: 1fr; }
    .esq-spread:nth-of-type(even) .esq-spread-grid > .esq-sketch { order: 0; }
    .esq-steps { grid-template-columns: 1fr 1fr; }
    .esq-steps li:nth-child(n) { transform: none; }
    .esq-pencils { grid-template-columns: 1fr; }
    .esq-index a:not(.esq-index-cta) { display: none; }
    .esq-binding { width: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .esq-sketch, .esq-note, .esq-pencil-hot, .esq-btn, .esq-margin-note { transform: none !important; }
  }
</style>
</body>
</html>
