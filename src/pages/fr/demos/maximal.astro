---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : MAXIMAL, collectif créatif maximaliste fictif, Montréal.
// Direction artistique autonome. Fort, contrasté, « plus, c'est plus ». Sans lien avec le thème WEBAO.
const IMG = {
  heroA: "/demos/maximal/01.jpg",
  heroB: "/demos/maximal/02.jpg",
  work1: "https://images.unsplash.com/photo-1541701494587-cb58502866ab?q=80&w=900&auto=format&fit=crop",
  work2: "/demos/maximal/03.jpg",
  work3: "/demos/maximal/04.jpg",
  work4: "https://images.unsplash.com/photo-1515405295579-ba7b45403062?q=80&w=900&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MAXIMAL : Plus, c'est plus | Collectif créatif maximaliste, Montréal</title>
  <meta name="description" content="MAXIMAL est un collectif créatif maximaliste fictif à Montréal. Image de marque, web, animation, murales, emballage, et tout en même temps. Trop, avec goût." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Playfair+Display:ital,wght@1,500;1,700;1,900&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="mx">

  <!-- NAV -->
  <header class="mx-navwrap">
    <nav class="mx-nav" aria-label="Navigation principale">
      <a class="mx-logo" href="#top" aria-label="MAXIMAL, accueil">MAXIMAL<span class="mx-logo-star" aria-hidden="true">✸</span></a>
      <button class="mx-burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mx-menu">
        <span></span><span></span><span></span>
      </button>
      <div class="mx-nav-links" id="mx-menu">
        <a href="#services">Services</a>
        <a href="#work">Réalisations</a>
        <a href="#manifesto">Manifeste</a>
        <a href="#tiers">Formules chaos</a>
        <a class="mx-nav-cta" href="#contact">Lancez le chaos</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- HERO : délibérément surchargé -->
    <section class="mx-hero">
      <div class="mx-checker" aria-hidden="true"></div>
      <div class="mx-hero-in">
        <p class="mx-eyebrow"><span class="mx-tag">Montréal, QC</span> <span class="mx-tag mx-tag-pink">Collectif créatif maximaliste</span> <span class="mx-tag mx-tag-blue">Depuis 2019</span></p>
        <h1 class="mx-h1">
          <span class="mx-line1">PLUS,</span>
          <span class="mx-line2">C'EST <em>PLUS</em></span>
        </h1>
        <p class="mx-lede">Nous sommes MAXIMAL, un collectif créatif allergique à la retenue. Image de marque, sites web, animation, murales, emballage, fanzines, produits dérivés, et douze autres choses, tout en même temps, exprès. <strong>Le minimalisme est une rumeur.</strong> On a vérifié.</p>
        <div class="mx-hero-cta">
          <a class="mx-btn mx-btn-pink" href="#tiers">Choisissez votre chaos</a>
          <a class="mx-btn mx-btn-ghost" href="#work">Voyez le beau gâchis</a>
        </div>
        <div class="mx-polaroids">
          <figure class="mx-polaroid mx-p1"><img src={IMG.heroA} alt="Salon maximaliste, murs verts, sofa bleu, mur de cadres" loading="eager" fetchpriority="high" /><figcaption>ambiance : FORT</figcaption></figure>
          <figure class="mx-polaroid mx-p2"><img src={IMG.heroB} alt="Salon maximaliste rose et vert aux motifs superposés" loading="lazy" /><figcaption>ambiance : PLUS FORT</figcaption></figure>
        </div>
      </div>
      <div class="mx-burst mx-burst-1" aria-hidden="true"><span>WOW!</span></div>
      <div class="mx-burst mx-burst-2" aria-hidden="true"><span>100%<br />EN PLUS</span></div>
      <div class="mx-sticker mx-sticker-1" aria-hidden="true">BEIGE INTERDIT</div>
      <div class="mx-ticker" aria-hidden="true">
        <div class="mx-ticker-track">
          <span>IMAGE DE MARQUE</span><span>✸</span><span>WEB</span><span>✸</span><span>ANIMATION</span><span>✸</span><span>MURALES</span><span>✸</span><span>EMBALLAGE</span><span>✸</span><span>FANZINES</span><span>✸</span><span>PRODUITS DÉRIVÉS</span><span>✸</span><span>SIGNALÉTIQUE</span><span>✸</span>
          <span>IMAGE DE MARQUE</span><span>✸</span><span>WEB</span><span>✸</span><span>ANIMATION</span><span>✸</span><span>MURALES</span><span>✸</span><span>EMBALLAGE</span><span>✸</span><span>FANZINES</span><span>✸</span><span>PRODUITS DÉRIVÉS</span><span>✸</span><span>SIGNALÉTIQUE</span><span>✸</span>
        </div>
      </div>
    </section>

    <!-- MUR DE SERVICES -->
    <section class="mx-section mx-services" id="services">
      <div class="mx-wrap">
        <p class="mx-kicker">/// le menu (oui, tout)</p>
        <h2 class="mx-h2">ON FAIT <span class="mx-underline">TOUT</span><span class="mx-h2-serif">, évidemment.</span></h2>
        <div class="mx-service-wall">
          <article class="mx-svc mx-c1"><h3>Image de marque</h3><p>Des logos qui ont des opinions. Des systèmes qui tiennent la route.</p></article>
          <article class="mx-svc mx-c2"><h3>Design web</h3><p>Des sites qui refusent de chuchoter.</p></article>
          <article class="mx-svc mx-c3"><h3>Animation</h3><p>Si ça peut bouger, ça doit bouger. Deux fois.</p></article>
          <article class="mx-svc mx-c4"><h3>Emballage</h3><p>Une présence en rayon qu'on entend.</p></article>
          <article class="mx-svc mx-c5"><h3>Murales et signalétique</h3><p>Des murs, mais qui crient poliment.</p></article>
          <article class="mx-svc mx-c6"><h3>Fanzines et imprimé</h3><p>De l'encre sur du papier, agrafes comprises.</p></article>
          <article class="mx-svc mx-c1"><h3>Direction artistique</h3><p>Du chaos, mais planifié.</p></article>
          <article class="mx-svc mx-c2"><h3>Illustration</h3><p>Dessiné à la main, puis monté à onze.</p></article>
          <article class="mx-svc mx-c3"><h3>Contenu social</h3><p>Des accroche-regards, des casse-pouces.</p></article>
          <article class="mx-svc mx-c4"><h3>Design d'exposition</h3><p>Des salles que les gens photographient.</p></article>
          <article class="mx-svc mx-c5"><h3>Produits dérivés</h3><p>T-shirts, fourre-tout et chapeaux douteux.</p></article>
          <article class="mx-svc mx-c6"><h3>Nommage et ton</h3><p>Des mots avec des paillettes dessus.</p></article>
        </div>
        <p class="mx-wall-note">Il manque quelque chose? <a href="#contact">Dites-le-nous.</a> On fait probablement ça aussi. On fait des portraits de chiens maintenant. (Des portraits de chiens fictifs.)</p>
      </div>
    </section>

    <!-- PORTFOLIO CHAOTIQUE -->
    <section class="mx-section mx-work" id="work">
      <div class="mx-wrap">
        <p class="mx-kicker mx-kicker-light">/// la preuve qu'on ne tient pas en place</p>
        <h2 class="mx-h2 mx-h2-light">NOS RÉCENTS <span class="mx-h2-serif">beaux</span> GÂCHIS</h2>
        <div class="mx-grid">
          <figure class="mx-tile mx-t1">
            <img src={IMG.work1} alt="Œuvre abstraite colorée pour l'identité Acid Bloom" loading="lazy" />
            <figcaption><strong>Acid Bloom</strong><span>Identité visuelle · le client a pleuré (de joie)</span></figcaption>
            <span class="mx-mini-burst" aria-hidden="true">TOP</span>
          </figure>
          <figure class="mx-tile mx-t2">
            <img src={IMG.work2} alt="Intérieur éclectique, mur de cadres pour Chrome Dreams" loading="lazy" />
            <figcaption><strong>Chrome Dreams</strong><span>Site web · 47 animations, 0 regret</span></figcaption>
          </figure>
          <figure class="mx-tile mx-t3">
            <img src={IMG.work3} alt="Salon maximaliste coloré pour Neon District" loading="lazy" />
            <figcaption><strong>Neon District</strong><span>Murale · visible de l'espace (soi-disant)</span></figcaption>
            <span class="mx-tape" aria-hidden="true"></span>
          </figure>
          <figure class="mx-tile mx-t4">
            <img src={IMG.work4} alt="Éclaboussures de peinture vives pour l'emballage Paint Fight" loading="lazy" />
            <figcaption><strong>Paint Fight</strong><span>Emballage · devenu viral-ish</span></figcaption>
          </figure>
          <figure class="mx-tile mx-t5 mx-tile-css">
            <div class="mx-tile-css-in" aria-hidden="true">✸</div>
            <figcaption><strong>Votre logo ici</strong><span>Mais en plus fort · créneau libre</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- MANIFESTE -->
    <section class="mx-section mx-manifesto" id="manifesto">
      <div class="mx-wrap">
        <p class="mx-kicker">/// le manifeste maximaliste (abrégé, à peine)</p>
        <h2 class="mx-h2">BON. <span class="mx-h2-serif">voici ce qu'on croit.</span></h2>
        <div class="mx-mani">
          <blockquote class="mx-m1"><p>« L'espace blanc, c'est juste de l'espace qu'on a oublié de décorer. »</p></blockquote>
          <blockquote class="mx-m2"><p>« Si ça ne jure pas, ça ne claque pas. »</p></blockquote>
          <blockquote class="mx-m3"><p>« Le bon goût est une cage. On a mangé la cage. C'était délicieux. »</p></blockquote>
          <blockquote class="mx-m4"><p>« La retenue est un choix de design. La fanfare aussi. »</p></blockquote>
        </div>
        <p class="mx-mani-foot">Signé, nous douze, en douze polices différentes. <a href="#contact">Venez débattre →</a></p>
      </div>
    </section>

    <!-- FORMULES CHAOS -->
    <section class="mx-section mx-tiers" id="tiers">
      <div class="mx-wrap">
        <p class="mx-kicker mx-kicker-light">/// des prix, mais en version forte</p>
        <h2 class="mx-h2 mx-h2-light">FORMULES <span class="mx-h2-serif">chaos</span></h2>
        <div class="mx-tier-grid">
          <article class="mx-tier">
            <h3>Chaos doux</h3>
            <p class="mx-price">2,5 k$<span> / projet</span></p>
            <p class="mx-tier-sub">Pour les curieux du chaos.</p>
            <ul>
              <li>Une chose forte (logo, site ou affiche)</li>
              <li>Deux rondes de révisions (on en supplie une troisième)</li>
              <li>Un (1) moment de bon goût, encadré</li>
              <li>Livraison en 3 semaines, paillettes incluses</li>
            </ul>
            <a class="mx-btn mx-btn-dark" href="#contact">Commencer doux</a>
          </article>
          <article class="mx-tier mx-tier-hot">
            <span class="mx-mini-burst mx-mini-burst-lg" aria-hidden="true">LE PLUS POPULAIRE !!</span>
            <h3>Chaos total</h3>
            <p class="mx-price">8 k$<span> / projet</span></p>
            <p class="mx-tier-sub">Notre signature. Attachez vos tuques.</p>
            <ul>
              <li>Identité visuelle + site web, en beau désaccord</li>
              <li>Pack animation : intros, autocollants, boucles</li>
              <li>Gabarits sociaux (30, tous forts)</li>
              <li>Révisions illimitées jusqu'à ce qu'on rie tous</li>
              <li>Confettis de lancement (numériques, puis vrais)</li>
            </ul>
            <a class="mx-btn mx-btn-pink" href="#contact">Passer en chaos total</a>
          </article>
          <article class="mx-tier">
            <h3>Chaos absolu</h3>
            <p class="mx-price">20 k$+<span> / projet</span></p>
            <p class="mx-tier-sub">Le bagel tout garni du design.</p>
            <ul>
              <li>Tout du Chaos total, plus des murales</li>
              <li>Emballage, produits dérivés, fanzine</li>
              <li>Direction artistique de la fête de lancement</li>
              <li>Une fanfare (fictive, mais forte)</li>
            </ul>
            <a class="mx-btn mx-btn-dark" href="#contact">Passer en absolu</a>
          </article>
        </div>
        <p class="mx-tier-note">Tous les prix sont fictifs. Tout l'enthousiasme est réel. Taxes en sus, paillettes gratuites.</p>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="mx-section mx-contact" id="contact">
      <div class="mx-wrap mx-contact-in">
        <div class="mx-contact-copy">
          <p class="mx-kicker mx-kicker-light">/// dites bonjour, fort</p>
          <h2 class="mx-h2 mx-h2-light">PRÊT POUR UN DESIGN <span class="mx-h2-serif">maximum</span>?</h2>
          <p class="mx-contact-txt">Parlez-nous de votre projet. Plus le brief est fort, plus on répond vite. Les briefs discrets sont aussi acceptés (on les arrangera).</p>
          <ul class="mx-contact-list">
            <li><strong>Studio</strong><span>404, boulevard Saint-Laurent, Montréal QC</span></li>
            <li><strong>Téléphone</strong><span><a href="tel:+15145550142">(514) 555-0142</a></span></li>
            <li><strong>Courriel</strong><span><a href="mailto:hello@maximal.studio">hello@maximal.studio</a></span></li>
            <li><strong>Heures</strong><span>Lun au ven, 9 h à 18 h, l'heure forte en tout temps</span></li>
          </ul>
        </div>
        <form class="mx-form" id="mx-form" novalidate>
          <h3>Briefez-nous</h3>
          <label>Votre nom
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>Courriel
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>Niveau de chaos
            <select name="level">
              <option>Chaos doux</option>
              <option>Chaos total</option>
              <option>Chaos absolu</option>
              <option>Incertain (on décidera pour vous)</option>
            </select>
          </label>
          <label>Votre projet
            <textarea name="message" rows="4" placeholder="Dites-nous tout. Les majuscules sont permises."></textarea>
          </label>
          <button class="mx-btn mx-btn-lime" type="submit">Envoyer fort</button>
          <p class="mx-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="mx-footer">
    <p class="mx-footer-giant" aria-hidden="true">MAXIMAL</p>
    <div class="mx-wrap mx-footer-in">
      <p>© 2026 MAXIMAL. Démo fictive. Aucun beige n'a été maltraité.</p>
      <p>404, boulevard Saint-Laurent, Montréal QC · <a href="tel:+15145550142">(514) 555-0142</a> · <a href="mailto:hello@maximal.studio">hello@maximal.studio</a></p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      // Menu mobile
      var burger = document.querySelector('.mx-burger') as HTMLButtonElement | null;
      var nav = document.querySelector('.mx-navwrap');
      burger?.addEventListener('click', function () {
        var open = nav?.classList.toggle('mx-nav-open');
        burger?.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      });
      document.querySelectorAll('.mx-nav-links a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav?.classList.remove('mx-nav-open');
          burger?.setAttribute('aria-expanded', 'false');
          burger?.setAttribute('aria-label', 'Ouvrir le menu');
        });
      });
      // Formulaire de démo : ne s'envoie nulle part
      var form = document.getElementById('mx-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.mx-form-note');
        if (note) note.textContent = 'Message reçu. On vous répondra avec au moins trois points d\u2019exclamation !!!';
        form?.reset();
      });
    })();
  </script>

  <style>
    .mx {
      --mx-yellow: #F2FF00;
      --mx-pink: #FF2E9A;
      --mx-blue: #2036FF;
      --mx-lime: #8CFF00;
      --mx-ink: #0B0B0C;
      --mx-paper: #FFFDF5;
      --mx-black: "Archivo Black", "Arial Black", sans-serif;
      --mx-serif: "Playfair Display", Georgia, serif;
      --mx-body: "Space Grotesk", system-ui, sans-serif;
      margin: 0;
      background: var(--mx-yellow);
      color: var(--mx-ink);
      font-family: var(--mx-body);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .mx *, .mx *::before, .mx *::after { box-sizing: border-box; }
    .mx img { display: block; max-width: 100%; }
    .mx-wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .mx-section { padding: clamp(70px, 9vw, 130px) 0; position: relative; }

    /* type */
    .mx-kicker { font-weight: 700; font-size: 13px; letter-spacing: 0.28em; text-transform: uppercase; margin: 0 0 18px; }
    .mx-kicker-light { color: var(--mx-paper); }
    .mx-h2 { font-family: var(--mx-black); font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1; text-transform: uppercase; margin: 0 0 44px; }
    .mx-h2-light { color: var(--mx-paper); }
    .mx-h2-serif { font-family: var(--mx-serif); font-style: italic; font-weight: 700; text-transform: none; letter-spacing: 0; }
    .mx-underline { text-decoration: underline wavy var(--mx-pink) 6px; text-underline-offset: 8px; }

    /* buttons */
    .mx-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--mx-black); font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 18px 34px; text-decoration: none; cursor: pointer; border: 3px solid var(--mx-ink);
      box-shadow: 6px 6px 0 var(--mx-ink); transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .mx-btn:hover { transform: translate(-2px, -2px); box-shadow: 9px 9px 0 var(--mx-ink); }
    .mx-btn-pink { background: var(--mx-pink); color: #fff; }
    .mx-btn-dark { background: var(--mx-ink); color: var(--mx-yellow); }
    .mx-btn-lime { background: var(--mx-lime); color: var(--mx-ink); width: 100%; }
    .mx-btn-ghost { background: var(--mx-paper); color: var(--mx-ink); }

    /* nav */
    .mx-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .mx-nav {
      display: flex; align-items: center; gap: 18px;
      padding: 14px clamp(16px, 3vw, 36px);
      background: var(--mx-pink); border-bottom: 4px solid var(--mx-ink);
    }
    .mx-logo {
      font-family: var(--mx-black); font-size: 26px; color: #fff; text-decoration: none;
      letter-spacing: 0.02em; margin-right: auto; display: flex; align-items: center; gap: 6px;
      text-shadow: 3px 3px 0 var(--mx-ink);
    }
    .mx-logo-star { color: var(--mx-yellow); font-size: 22px; }
    .mx-burger { display: none; background: var(--mx-yellow); border: 3px solid var(--mx-ink); width: 48px; height: 44px; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
    .mx-burger span { display: block; width: 24px; height: 4px; background: var(--mx-ink); }
    .mx-nav-links { display: flex; align-items: center; gap: 4px; }
    .mx-nav-links a {
      color: #fff; text-decoration: none; font-weight: 700; font-size: 14px; letter-spacing: 0.08em;
      text-transform: uppercase; padding: 10px 14px; border: 2px solid transparent;
    }
    .mx-nav-links a:hover { background: var(--mx-yellow); color: var(--mx-ink); border-color: var(--mx-ink); }
    .mx-nav-cta { background: var(--mx-ink); color: var(--mx-yellow) !important; border: 2px solid var(--mx-ink) !important; }

    /* hero */
    .mx-hero { position: relative; overflow: hidden; padding: 130px 0 0; border-bottom: 6px solid var(--mx-ink); }
    .mx-checker {
      position: absolute; inset: 0; opacity: 0.16; pointer-events: none;
      background: repeating-conic-gradient(var(--mx-ink) 0% 25%, transparent 0% 50%) 0 0 / 56px 56px;
    }
    .mx-hero-in { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px) 70px; }
    .mx-eyebrow { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 26px; }
    .mx-tag {
      font-weight: 700; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
      background: var(--mx-ink); color: var(--mx-yellow); padding: 8px 14px; transform: rotate(-1.5deg);
    }
    .mx-tag-pink { background: var(--mx-pink); color: #fff; transform: rotate(1.2deg); }
    .mx-tag-blue { background: var(--mx-blue); color: #fff; transform: rotate(-0.8deg); }
    .mx-h1 { font-family: var(--mx-black); margin: 0 0 26px; line-height: 0.88; text-transform: uppercase; }
    .mx-line1 { display: block; font-size: clamp(4.2rem, 17vw, 12rem); color: var(--mx-pink); text-shadow: 5px 5px 0 var(--mx-ink), 10px 10px 0 var(--mx-blue); transform: rotate(-2deg); }
    .mx-line2 { display: block; font-size: clamp(3rem, 12vw, 8.5rem); color: var(--mx-ink); transform: rotate(1.4deg); margin-top: 6px; }
    .mx-line2 em { font-family: var(--mx-serif); font-style: italic; color: var(--mx-blue); -webkit-text-stroke: 0; }
    .mx-lede { font-size: 18px; line-height: 1.55; max-width: 52ch; margin: 0 0 30px; background: var(--mx-paper); border: 3px solid var(--mx-ink); padding: 18px 22px; box-shadow: 6px 6px 0 var(--mx-ink); transform: rotate(0.6deg); }
    .mx-hero-cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 44px; }
    .mx-polaroids { display: flex; gap: 26px; flex-wrap: wrap; }
    .mx-polaroid { background: #fff; border: 3px solid var(--mx-ink); padding: 12px 12px 8px; margin: 0; box-shadow: 8px 8px 0 var(--mx-ink); width: 250px; }
    .mx-polaroid img { width: 100%; height: 180px; object-fit: cover; border: 2px solid var(--mx-ink); }
    .mx-polaroid figcaption { font-family: var(--mx-black); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; padding: 10px 4px 6px; text-align: center; }
    .mx-p1 { transform: rotate(-4deg); }
    .mx-p2 { transform: rotate(3deg); margin-top: 26px; }

    /* starbursts + stickers */
    .mx-burst {
      position: absolute; z-index: 3; display: flex; align-items: center; justify-content: center;
      text-align: center; font-family: var(--mx-black); text-transform: uppercase;
      clip-path: polygon(100% 50%, 86.7% 59.8%, 93.3% 75%, 76.9% 76.9%, 75% 93.3%, 59.8% 86.7%, 50% 100%, 40.2% 86.7%, 25% 93.3%, 23.1% 76.9%, 6.7% 75%, 13.3% 59.8%, 0% 50%, 13.3% 40.2%, 6.7% 25%, 23.1% 23.1%, 25% 6.7%, 40.2% 13.3%, 50% 0%, 59.8% 13.3%, 75% 6.7%, 76.9% 23.1%, 93.3% 25%, 86.7% 40.2%);
      animation: mx-spin 14s linear infinite;
    }
    @keyframes mx-spin { to { transform: rotate(360deg); } }
    .mx-burst-1 { width: 150px; height: 150px; background: var(--mx-lime); top: 150px; right: 6%; font-size: 22px; color: var(--mx-ink); }
    .mx-burst-2 { width: 190px; height: 190px; background: var(--mx-blue); bottom: 120px; right: 12%; font-size: 20px; color: #fff; animation-direction: reverse; }
    .mx-sticker {
      position: absolute; z-index: 3; font-family: var(--mx-black); font-size: 14px; letter-spacing: 0.06em;
      background: var(--mx-paper); border: 3px solid var(--mx-ink); padding: 10px 16px; box-shadow: 4px 4px 0 var(--mx-ink);
    }
    .mx-sticker-1 { top: 420px; left: 4%; transform: rotate(-8deg); }

    /* ticker */
    .mx-ticker { position: relative; z-index: 2; background: var(--mx-ink); color: var(--mx-yellow); border-top: 4px solid var(--mx-ink); overflow: hidden; padding: 14px 0; }
    .mx-ticker-track { display: inline-flex; gap: 26px; white-space: nowrap; font-family: var(--mx-black); font-size: 20px; letter-spacing: 0.06em; animation: mx-tick 18s linear infinite; }
    @keyframes mx-tick { to { transform: translateX(-50%); } }

    /* services wall */
    .mx-services { background: var(--mx-paper); border-bottom: 6px solid var(--mx-ink); }
    .mx-service-wall { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .mx-svc { border: 3px solid var(--mx-ink); padding: 22px 20px; box-shadow: 5px 5px 0 var(--mx-ink); transition: transform 0.15s ease; }
    .mx-svc:hover { transform: rotate(0deg) scale(1.04) !important; }
    .mx-svc h3 { font-family: var(--mx-black); font-size: 19px; text-transform: uppercase; margin: 0 0 8px; }
    .mx-svc p { margin: 0; font-size: 14.5px; line-height: 1.5; }
    .mx-c1 { background: var(--mx-pink); color: #fff; transform: rotate(-1.2deg); }
    .mx-c2 { background: var(--mx-blue); color: #fff; transform: rotate(0.9deg); }
    .mx-c3 { background: var(--mx-lime); transform: rotate(-0.7deg); }
    .mx-c4 { background: var(--mx-yellow); transform: rotate(1.1deg); }
    .mx-c5 { background: var(--mx-ink); color: var(--mx-paper); transform: rotate(-0.9deg); }
    .mx-c6 { background: #fff; transform: rotate(0.8deg); }
    .mx-wall-note { margin: 34px 0 0; font-size: 16px; }
    .mx-wall-note a { color: var(--mx-blue); font-weight: 700; }

    /* work grid */
    .mx-work { background: var(--mx-blue); border-bottom: 6px solid var(--mx-ink); }
    .mx-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
    .mx-tile { position: relative; background: var(--mx-paper); border: 4px solid var(--mx-ink); padding: 12px; margin: 0; box-shadow: 8px 8px 0 var(--mx-ink); }
    .mx-tile img { width: 100%; height: 240px; object-fit: cover; border: 3px solid var(--mx-ink); }
    .mx-tile figcaption { padding: 14px 6px 8px; display: grid; gap: 4px; }
    .mx-tile figcaption strong { font-family: var(--mx-black); font-size: 20px; text-transform: uppercase; }
    .mx-tile figcaption span { font-size: 14px; font-weight: 500; }
    .mx-t1 { transform: rotate(-1.6deg); }
    .mx-t2 { transform: rotate(1.3deg); margin-top: 24px; }
    .mx-t3 { transform: rotate(-0.8deg); }
    .mx-t4 { transform: rotate(1.8deg); }
    .mx-t5 { transform: rotate(-1.1deg); margin-top: 24px; }
    .mx-tile-css-in {
      height: 240px; border: 3px dashed var(--mx-ink); display: flex; align-items: center; justify-content: center;
      font-size: 90px; color: var(--mx-pink);
      background: repeating-conic-gradient(var(--mx-yellow) 0% 25%, var(--mx-paper) 0% 50%) 0 0 / 44px 44px;
    }
    .mx-mini-burst {
      position: absolute; top: -18px; right: -14px; background: var(--mx-lime); color: var(--mx-ink);
      font-family: var(--mx-black); font-size: 13px; padding: 12px 16px; border: 3px solid var(--mx-ink);
      transform: rotate(10deg); box-shadow: 4px 4px 0 var(--mx-ink);
    }
    .mx-mini-burst-lg { font-size: 15px; padding: 14px 20px; }
    .mx-tape {
      position: absolute; top: -14px; left: 50%; width: 120px; height: 30px; transform: translateX(-50%) rotate(-4deg);
      background: rgba(242, 255, 0, 0.85); border-left: 2px dashed var(--mx-ink); border-right: 2px dashed var(--mx-ink);
    }

    /* manifesto */
    .mx-manifesto { background: var(--mx-pink); border-bottom: 6px solid var(--mx-ink); }
    .mx-mani { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
    .mx-mani blockquote { margin: 0; border: 4px solid var(--mx-ink); padding: 30px 28px; box-shadow: 8px 8px 0 var(--mx-ink); }
    .mx-mani p { font-family: var(--mx-black); font-size: clamp(1.4rem, 3vw, 2.1rem); line-height: 1.15; text-transform: uppercase; margin: 0; }
    .mx-m1 { background: var(--mx-yellow); transform: rotate(-1.4deg); }
    .mx-m2 { background: var(--mx-ink); color: var(--mx-paper); transform: rotate(1.2deg); margin-top: 30px !important; }
    .mx-m3 { background: var(--mx-lime); transform: rotate(0.9deg); }
    .mx-m4 { background: var(--mx-paper); transform: rotate(-1deg); margin-top: 30px !important; }
    .mx-mani-foot { margin: 36px 0 0; font-size: 17px; font-weight: 700; }
    .mx-mani-foot a { color: var(--mx-ink); }

    /* tiers */
    .mx-tiers { background: var(--mx-ink); border-bottom: 6px solid var(--mx-ink); }
    .mx-tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; align-items: stretch; }
    .mx-tier { position: relative; background: var(--mx-paper); border: 4px solid var(--mx-yellow); padding: 34px 30px; display: grid; gap: 14px; align-content: start; }
    .mx-tier h3 { font-family: var(--mx-black); font-size: 26px; text-transform: uppercase; margin: 0; }
    .mx-price { font-family: var(--mx-black); font-size: 44px; margin: 0; color: var(--mx-blue); }
    .mx-price span { font-size: 16px; font-family: var(--mx-body); font-weight: 500; color: var(--mx-ink); }
    .mx-tier-sub { font-family: var(--mx-serif); font-style: italic; font-size: 18px; margin: 0; }
    .mx-tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 15px; font-weight: 500; }
    .mx-tier li::before { content: "✸ "; color: var(--mx-pink); font-weight: 700; }
    .mx-tier-hot { background: var(--mx-yellow); transform: rotate(-1deg) scale(1.03); border-color: var(--mx-pink); }
    .mx-tier-note { color: var(--mx-paper); margin: 30px 0 0; font-size: 14px; }

    /* contact */
    .mx-contact { background: var(--mx-lime); }
    .mx-contact-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 80px); align-items: start; }
    .mx-contact-txt { font-size: 17px; line-height: 1.6; max-width: 44ch; }
    .mx-contact-list { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 14px; }
    .mx-contact-list li { background: var(--mx-paper); border: 3px solid var(--mx-ink); padding: 14px 18px; box-shadow: 5px 5px 0 var(--mx-ink); display: grid; gap: 2px; }
    .mx-contact-list strong { font-family: var(--mx-black); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; }
    .mx-contact-list a { color: var(--mx-blue); font-weight: 700; }
    .mx-form { background: var(--mx-ink); color: var(--mx-paper); padding: clamp(28px, 4vw, 44px); display: grid; gap: 16px; border: 4px solid var(--mx-ink); box-shadow: 10px 10px 0 var(--mx-pink); transform: rotate(0.8deg); }
    .mx-form h3 { font-family: var(--mx-black); font-size: 28px; text-transform: uppercase; color: var(--mx-yellow); margin: 0; }
    .mx-form label { display: grid; gap: 8px; font-weight: 700; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mx-yellow); }
    .mx-form input, .mx-form select, .mx-form textarea {
      font-family: var(--mx-body); font-size: 16px; font-weight: 500;
      background: var(--mx-paper); border: 3px solid var(--mx-yellow); color: var(--mx-ink);
      padding: 14px 16px; width: 100%;
    }
    .mx-form input:focus, .mx-form select:focus, .mx-form textarea:focus { outline: 3px solid var(--mx-pink); outline-offset: 2px; }
    .mx-form-note { margin: 0; color: var(--mx-lime); font-weight: 700; font-size: 15px; }
    .mx-form-note:empty { display: none; }

    /* footer */
    .mx-footer { background: var(--mx-ink); color: var(--mx-paper); padding: 70px 0 90px; text-align: center; overflow: hidden; }
    .mx-footer-giant {
      font-family: var(--mx-black); font-size: clamp(3.6rem, 16vw, 12rem); line-height: 0.9; margin: 0 0 30px;
      color: var(--mx-yellow); text-shadow: 5px 5px 0 var(--mx-pink), 10px 10px 0 var(--mx-blue);
      transform: rotate(-1.5deg);
    }
    .mx-footer-in { display: grid; gap: 10px; font-size: 14px; }
    .mx-footer-in p { margin: 0; }
    .mx-footer-in a { color: var(--mx-yellow); font-weight: 700; }

    /* responsive */
    @media (max-width: 1020px) {
      .mx-service-wall { grid-template-columns: repeat(3, 1fr); }
      .mx-grid { grid-template-columns: 1fr 1fr; }
      .mx-t2, .mx-t5 { margin-top: 0; }
      .mx-tier-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
      .mx-tier-hot { transform: rotate(-1deg); }
      .mx-contact-in { grid-template-columns: 1fr; }
      .mx-burst-2 { display: none; }
    }
    @media (max-width: 860px) {
      .mx-burger { display: flex; }
      .mx-nav-links {
        display: none; position: absolute; top: 100%; left: 0; right: 0;
        background: var(--mx-ink); flex-direction: column; align-items: stretch; padding: 18px; gap: 8px;
        border-bottom: 4px solid var(--mx-ink);
      }
      .mx-nav-open .mx-nav-links { display: flex; }
      .mx-nav-links a { color: var(--mx-yellow); border: 2px solid var(--mx-yellow); text-align: center; }
      .mx-nav-links a:hover { background: var(--mx-yellow); color: var(--mx-ink); }
      .mx-mani { grid-template-columns: 1fr; }
      .mx-m2, .mx-m4 { margin-top: 0 !important; }
      .mx-burst-1 { width: 110px; height: 110px; font-size: 16px; top: 120px; right: 4%; }
      .mx-sticker-1 { display: none; }
    }
    @media (max-width: 640px) {
      .mx-service-wall { grid-template-columns: 1fr 1fr; }
      .mx-grid { grid-template-columns: 1fr; }
      .mx-p2 { margin-top: 0; }
      .mx-lede { transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mx-ticker-track, .mx-burst { animation: none; }
      .mx-btn, .mx-svc { transition: none; }
      .mx-svc:hover { transform: none; }
    }
  </style>
</body>
</html>
