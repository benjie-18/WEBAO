  <script>
    (function () {
      var menuBtn = document.getElementById('br-menu-btn') as HTMLButtonElement | null;
      var nav = document.getElementById('br-nav') as HTMLElement | null;
      menuBtn?.addEventListener('click', function () {
        var open = nav?.classList.toggle('br-nav-open');
        menuBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
        if (menuBtn) menuBtn.textContent = open ? 'Fermer' : 'Menu';
      });
      nav?.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav?.classList.remove('br-nav-open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', 'Ouvrir le menu');
          if (menuBtn) menuBtn.textContent = 'Menu';
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav?.classList.contains('br-nav-open')) {
          nav?.classList.remove('br-nav-open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', 'Ouvrir le menu');
          if (menuBtn) menuBtn.textContent = 'Menu';
        }
      });
      document.addEventListener('click', function (e) {
        var t = e.target as HTMLElement | null;
        var header = document.querySelector('.br-header') as HTMLElement | null;
        if (nav?.classList.contains('br-nav-open') && header && t && !header.contains(t)) {
          nav?.classList.remove('br-nav-open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', 'Ouvrir le menu');
          if (menuBtn) menuBtn.textContent = 'Menu';
        }
      });

      var BASE = {
        studio: [420, 580], '1bed': [620, 840], '2bed': [880, 1180],
        '3bed': [1150, 1520], house: [1450, 1950], office: [1800, 2600]
      };
      var REGION: Record<string, string> = {
        gatineau: 'outaouais', hull: 'outaouais', aylmer: 'outaouais', ottawa: 'outaouais',
        cantley: 'outaouais', chelsea: 'outaouais', 'masson-angers': 'outaouais', buckingham: 'outaouais',
        montreal: 'mtl', laval: 'mtl', longueuil: 'mtl', brossard: 'mtl', repentigny: 'mtl',
        terrebonne: 'mtl', blainville: 'mtl', 'saint-eustache': 'mtl', 'st-eustache': 'mtl', mascouche: 'mtl', boisbriand: 'mtl',
        toronto: 'toronto', sherbrooke: 'sherbrooke', 'trois-rivieres': 'trois-rivieres', 'quebec city': 'quebec', quebec: 'quebec', kingston: 'kingston'
      };
      var FSA_CITY: Record<string, string> = { j8: 'gatineau', j9: 'gatineau', k1: 'ottawa', k2: 'ottawa', h1: 'montreal', h2: 'montreal', h3: 'montreal', h4: 'montreal', m1: 'toronto', m2: 'toronto', m3: 'toronto', m4: 'toronto', m5: 'toronto', m6: 'toronto', m7: 'toronto', m8: 'toronto', m9: 'toronto', g1: 'quebec city', g2: 'quebec city', j6: 'terrebonne', j7: 'terrebonne' };
      function norm(s: string) {
        var v = (s || '').toLowerCase().trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        var m = v.match(/^([a-z]\d)[a-z]/);
        if (m && FSA_CITY[m[1]]) return FSA_CITY[m[1]];
        return v;
      }
      function regionOf(place: string) {
        var k = Object.keys(REGION).find(function (key) { return place.indexOf(key) !== -1; });
        return k ? REGION[k] : '';
      }
      function distanceFactor(from: string, to: string) {
        var f = norm(from), t = norm(to);
        if (!f || !t) return { factor: 1.0, label: 'Local' };
        if (f === t) return { factor: 1.0, label: 'Local' };
        var rf = regionOf(f), rt = regionOf(t);
        if (rf && rf === rt) {
          if (rf === 'outaouais') return { factor: 1.0, label: 'Local' };
          return { factor: 1.3, label: 'À proximité, moins de 100 km' };
        }
        if (rf && rt) return { factor: 1.8, label: 'Longue distance' };
        return { factor: 1.3, label: 'À proximité, moins de 100 km' };
      }
      function round10(n: number) { return Math.round(n / 10) * 10; }
      function money(n: number) { return n.toLocaleString('fr-CA') + ' $'; }

      var form = document.getElementById('br-form') as HTMLFormElement | null;
      var progress = document.getElementById('br-progress') as HTMLElement | null;
      var result = document.getElementById('br-result') as HTMLElement | null;
      var formError = document.getElementById('br-form-error') as HTMLElement | null;
      function showFormError(msg: string) { if (formError) formError.textContent = msg; }
      function showStep(n: number) {
        form?.querySelectorAll('.br-step').forEach(function (s) {
          (s as HTMLElement).hidden = s.getAttribute('data-step') !== String(n);
        });
        if (progress) progress.textContent = 'Étape ' + n + ' sur 3';
        if (result) result.hidden = true;
        if (formError) formError.textContent = '';
        var vn = document.getElementById('br-video-note');
        if (vn) vn.textContent = '';
      }
      form?.querySelectorAll('[data-next]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = parseInt(btn.getAttribute('data-next') || '1', 10);
          if (target === 2) {
            var size = document.getElementById('br-size') as HTMLSelectElement | null;
            var from = document.getElementById('br-from') as HTMLInputElement | null;
            var to = document.getElementById('br-to') as HTMLInputElement | null;
            var date = document.getElementById('br-date') as HTMLInputElement | null;
            if (!size?.value || !from?.value || !to?.value || !date?.value) {
              showFormError('Veuillez remplir la taille du déménagement, les deux villes et la date du déménagement d\u2019abord.');
              var firstEmpty = !size?.value ? size : !from?.value ? from : !to?.value ? to : date;
              firstEmpty?.focus();
              return;
            }
          }
          showStep(target);
        });
      });
      form?.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        var step = form?.querySelector('.br-step:not([hidden])');
        var next = (step?.querySelector('button[data-next]:not(.br-btn-ghost)') || null) as HTMLButtonElement | null;
        if (next) { e.preventDefault(); next.click(); }
      });
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var size = document.getElementById('br-size') as HTMLSelectElement | null;
        var from = document.getElementById('br-from') as HTMLInputElement | null;
        var to = document.getElementById('br-to') as HTMLInputElement | null;
        var name = document.getElementById('br-name') as HTMLInputElement | null;
        var mobile = document.getElementById('br-mobile') as HTMLInputElement | null;
        var email = document.getElementById('br-email') as HTMLInputElement | null;
        var consent = document.getElementById('br-consent') as HTMLInputElement | null;
        if (!size?.value || !from?.value || !to?.value || !name?.value || !mobile?.value || !email?.value || !consent?.checked) {
          showFormError('Veuillez remplir chaque champ et cocher la case de consentement par texto pour voir votre fourchette.');
          var firstEmpty = !size?.value ? size : !from?.value ? from : !to?.value ? to : !name?.value ? name : !mobile?.value ? mobile : !email?.value ? email : consent;
          firstEmpty?.focus();
          return;
        }
        var emailVal = email?.value || '';
        if (emailVal.indexOf('@') === -1 || emailVal.indexOf('.', emailVal.indexOf('@')) === -1) {
          showFormError('Vérifiez votre courriel : il doit contenir un @ et un point.');
          email?.focus();
          return;
        }
        var digits = (mobile?.value || '').replace(/\D/g, '');
        if (digits.length < 10) {
          showFormError('Vérifiez votre numéro : il doit contenir au moins 10 chiffres.');
          mobile?.focus();
          return;
        }
        var base = BASE[size?.value as keyof typeof BASE] || BASE['2bed'];
        var d = distanceFactor(from?.value || '', to?.value || '');
        var add = 0;
        var parts = [];
        if ((document.getElementById('br-piano') as HTMLInputElement | null)?.checked) { add += 180; parts.push('piano +180 $'); }
        if ((document.getElementById('br-safe') as HTMLInputElement | null)?.checked) { add += 150; parts.push('coffre-fort +150 $'); }
        if ((document.getElementById('br-art') as HTMLInputElement | null)?.checked) { add += 120; parts.push('grande oeuvre d\u2019art ou miroir +120 $'); }
        var access = document.getElementById('br-access') as HTMLSelectElement | null;
        if (access?.value === 'stairs3') { add += 80; parts.push('escaliers, troisième étage ou plus, sans ascenseur +80 $'); }
        var packing = form?.querySelector('input[name="packing"]:checked') as HTMLInputElement | null;
        if (packing?.value === 'partial') { add += 250; parts.push('emballage partiel +250 $'); }
        if (packing?.value === 'full') { add += 450; parts.push('emballage complet +450 $'); }
        var low = round10(base[0] * d.factor + add);
        var high = round10(base[1] * d.factor + add);
        var range = document.getElementById('br-range') as HTMLElement | null;
        if (range) range.textContent = money(low) + ' à ' + money(high);
        var breakdown = document.getElementById('br-breakdown') as HTMLElement | null;
        if (breakdown) {
          breakdown.textContent = 'Base ' + money(base[0]) + ' à ' + money(base[1]) + ', fois le facteur ' + d.label + ' ' + d.factor.toFixed(1).replace('.', ',') + (parts.length ? ', plus ' + parts.join(', ') : ', aucun ajout') + ', arrondi aux 10 $ près.';
        }
        if (result) result.hidden = false;
        if (progress) progress.textContent = 'Votre fourchette est prête';
        result?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
      });
      document.getElementById('br-edit-btn')?.addEventListener('click', function () {
        showStep(1);
      });
      document.getElementById('br-video-btn')?.addEventListener('click', function () {
        var note = document.getElementById('br-video-note') as HTMLElement | null;
        if (note) note.textContent = 'Noté. On vous enverra trois heures de visite vidéo par texto dans un délai d\u2019une heure ouvrable.';
      });
    })();
  </script>

  <style>
