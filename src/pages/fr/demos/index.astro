---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DemosPage from "../../../components/pages/DemosPage.astro";
import { useTranslations } from "../../../lib/i18n";
import { demos } from "../../../lib/demos";
import { HIDDEN_DEMOS } from "../../../lib/demo-seo";

const locale = "fr" as const;
const t = useTranslations(locale);

// ItemList structured data: presents the catalog to search engines as a list
// of portfolio pieces (rich-result eligible) in canonical catalog order.
// The client-side session shuffle is per visitor and cannot be represented in
// prerendered SEO data, so this static list intentionally does not match each
// visitor's shuffled view.
const visibleDemos = demos.filter((demo) => !HIDDEN_DEMOS.has(demo.id));
const itemListSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t.meta.demos.title,
  numberOfItems: visibleDemos.length,
  itemListElement: visibleDemos.map((demo, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: demo.name,
    url: `https://webao.ca/fr/demos/${demo.id}/`,
  })),
});
---

<BaseLayout title={t.meta.demos.title} description={t.meta.demos.description} locale={locale} pageKey="demos">
  <script slot="head" type="application/ld+json" set:html={itemListSchema} />
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Baloo+2:wght@700&family=Fraunces:ital,wght@1,600&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet" />
  </Fragment>
  <DemosPage locale={locale} />
</BaseLayout>
