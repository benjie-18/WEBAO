        <div class="snk-foot-col">
          <h4>Entreprise</h4>
          <a href="#snk-top">Notre histoire</a>
          <a href="#snk-reviews">Visites du coffre</a>
          <a href="#snk-alerts">Carrières</a>
          <a href="#snk-alerts">Contact</a>
        </div>
      </div>
      <div class="snk-legal">
        <span>© 2026 Sneaker Pro — entreprise fictive créée à des fins de démonstration.</span>
        <span>Montréal (QC) · Réalisé par <b>WebAO</b></span>
      </div>
    </div>
  </footer>

  <div class="snk-toast" id="snk-toast" role="status" aria-live="polite"><i aria-hidden="true"></i><span id="snk-toast-text"></span></div>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      var root = document.documentElement;
      var themeBtn = document.getElementById("snk-theme") as HTMLButtonElement | null;
      var syncTheme = function () {
        var light = root.getAttribute("data-theme") === "light";
        if (themeBtn) {
          themeBtn.setAttribute("aria-pressed", String(light));
          themeBtn.setAttribute("aria-label", light ? "Passer en mode sombre" : "Passer en mode clair");
        }
      };
      syncTheme();
      themeBtn?.addEventListener("click", function () {
        var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("snk-theme", next); } catch (e) {}
        syncTheme();
      });

      // Menu mobile
      var nav = document.getElementById("snk-nav");
      var burger = document.getElementById("snk-burger") as HTMLButtonElement | null;
      burger?.addEventListener("click", function () {
        var open = nav?.classList.toggle("is-open") ?? false;
        burger?.setAttribute("aria-expanded", String(open));
      });
      nav?.querySelectorAll(".snk-nav-links a").forEach(function (link) {
        link.addEventListener("click", function () {
          nav?.classList.remove("is-open");
          burger?.setAttribute("aria-expanded", "false");
        });
      });

      // Révélation au défilement
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var reveals = document.querySelectorAll(".snk-reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach(function (el) { el.classList.add("is-in"); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
        reveals.forEach(function (el) { io.observe(el); });
      }

      // Inclinaison du héros (pointeur uniquement)
      var tilt = document.getElementById("snk-tilt");
      var frame = document.getElementById("snk-frame");
      if (tilt && frame && !reduce && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        const tiltEl: HTMLElement = tilt;
        const frameEl: HTMLElement = frame;
        tiltEl.addEventListener("pointermove", function (e) {
          var r = tiltEl.getBoundingClientRect();
          var x = (e.clientX - r.left) / r.width - 0.5;
          var y = (e.clientY - r.top) / r.height - 0.5;
          frameEl.style.transform = "rotateY(" + (x * 9) + "deg) rotateX(" + (-y * 9) + "deg)";
        });
        tiltEl.addEventListener("pointerleave", function () {
          frameEl.style.transform = "";
        });
      }

      // Filtres produits
      var chips = document.querySelectorAll<HTMLButtonElement>(".snk-chip[data-filter]");
      var products = document.querySelectorAll<HTMLElement>(".snk-product[data-cat]");
      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          var f = chip.getAttribute("data-filter") ?? "all";
          chips.forEach(function (c) { c.setAttribute("aria-pressed", String(c === chip)); });
          products.forEach(function (p) {
            p.hidden = f !== "all" && p.getAttribute("data-cat") !== f;
          });
        });
      });

      // Compteur de panier + notification
      var count = 0;
      var countEl = document.getElementById("snk-count");
      var bagBtn = document.getElementById("snk-bag");
      var toast = document.getElementById("snk-toast");
      var toastText = document.getElementById("snk-toast-text");
      var toastTimer: ReturnType<typeof setTimeout> | undefined;
      var showToast = function (msg: string) {
        if (!toast || !toastText) return;
        var toastEl: HTMLElement = toast;
        var textEl: HTMLElement = toastText;
        textEl.textContent = msg;
        toastEl.classList.add("is-show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toastEl.classList.remove("is-show"); }, 2400);
      };
      document.querySelectorAll<HTMLButtonElement>(".snk-add").forEach(function (btn) {
        btn.addEventListener("click", function () {
          count += 1;
          if (countEl) {
            countEl.textContent = String(count);
            countEl.classList.remove("is-bump");
            void countEl.offsetWidth;
            countEl.classList.add("is-bump");
          }
          bagBtn?.setAttribute("aria-label", "Panier, " + count + (count === 1 ? " article" : " articles"));
          showToast("Ajouté — " + (btn.getAttribute("data-name") ?? "article"));
        });
      });
      bagBtn?.addEventListener("click", function () {
        showToast(count === 0 ? "Votre panier est vide — le drop vous attend." : count + (count === 1 ? " paire" : " paires") + " dans votre panier (démo).");
      });

      // Formulaire d'alertes
      var form = document.getElementById("snk-alert-form") as HTMLFormElement | null;
      var done = document.getElementById("snk-alert-done");
      if (form) {
        var formEl: HTMLFormElement = form;
        formEl.addEventListener("submit", function (e) {
          e.preventDefault();
          var email = (formEl.querySelector("input") as HTMLInputElement | null)?.value ?? "";
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            showToast("Entrez un courriel valide pour recevoir l'alerte.");
            return;
          }
          formEl.hidden = true;
          var note = formEl.parentElement?.querySelector<HTMLElement>(".snk-form-note");
          if (note) note.hidden = true;
          if (done) done.hidden = false;
        });
      }

      // Compte à rebours vers le prochain vendredi 10 h (heure locale)
      var dd = document.getElementById("snk-dd");
      var hh = document.getElementById("snk-hh");
      var mm = document.getElementById("snk-mm");
      var ss = document.getElementById("snk-ss");
      var pad = function (n: number) { return n < 10 ? "0" + n : String(n); };
      var nextDrop = function () {
        var now = new Date();
        var d = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 10, 0, 0, 0);
        var delta = (5 - d.getDay() + 7) % 7;
        d.setDate(d.getDate() + delta);
        if (d.getTime() <= now.getTime()) d.setDate(d.getDate() + 7);
        return d;
      };
      var target = nextDrop();
      var tick = function () {
        var ms = Math.max(0, target.getTime() - Date.now());
        if (ms === 0) { target = nextDrop(); return; }
        var s = Math.floor(ms / 1000);
        if (dd) dd.textContent = pad(Math.floor(s / 86400));
        if (hh) hh.textContent = pad(Math.floor(s / 3600) % 24);
        if (mm) mm.textContent = pad(Math.floor(s / 60) % 60);
        if (ss) ss.textContent = pad(s % 60);
      };
      tick();
      setInterval(tick, 1000);

      // Compteurs animés
      var stats = document.querySelectorAll<HTMLElement>("strong[data-count]");
      var runCount = function (el: HTMLElement) {
        var literal = el.getAttribute("data-literal");
        if (literal) { el.textContent = literal; return; }
        var end = Number(el.getAttribute("data-count") ?? "0");
        var suffix = el.getAttribute("data-suffix") ?? "";
        if (reduce) { el.textContent = end.toLocaleString("fr-CA") + suffix; return; }
        var t0 = performance.now();
        var dur = 1400;
        var step = function (now: number) {
          var p = Math.min(1, (now - t0) / dur);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(end * eased).toLocaleString("fr-CA") + suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if (!("IntersectionObserver" in window)) {
        stats.forEach(runCount);
      } else {
        var sio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              runCount(entry.target as HTMLElement);
              sio.unobserve(entry.target);
            }
          });
        }, { threshold: 0.4 });
        stats.forEach(function (el) { sio.observe(el); });
      }
    })();
  </script>
</body>
</html>
