---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : Plomberie Leduc, plombier fictif, Longueuil QC.
// Badge de service vintage américain : crème/rouge/bleu marine, étoiles, héritage depuis 1987.
// Direction artistique autonome. Hors du système de thème WEBAO.
const IMG = {
  hero: "/demos/leduc/01.jpg",
  portrait: "/demos/leduc/02.jpg",
  tools: "/demos/leduc/03.jpg",
  wrench: "/demos/leduc/04.jpg",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Plomberie Leduc : plombier à Longueuil depuis 1987</title>
  <meta name="description" content="Plomberie Leduc : le plombier familial de Longueuil depuis 1987. Débouchage, chauffe-eau, réparation de fuites. Urgences 24/7. Bien réparé du premier coup." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="ld">

  <!-- BANDEAU URGENCE -->
  <div class="ld-ticker" role="note" aria-label="Avis de service d'urgence">
    <div class="ld-ticker-track">
      <span>Tuyau éclaté? Plus d'eau chaude? Appelez le <a href="tel:+14505550134">(450) 555-0134</a></span><span class="ld-ticker-star" aria-hidden="true">★</span>
      <span>Service d'urgence 24/7, jours fériés inclus</span><span class="ld-ticker-star" aria-hidden="true">★</span>
      <span>Tuyau éclaté? Plus d'eau chaude? Appelez le <a href="tel:+14505550134">(450) 555-0134</a></span><span class="ld-ticker-star" aria-hidden="true">★</span>
      <span>Service d'urgence 24/7, jours fériés inclus</span><span class="ld-ticker-star" aria-hidden="true">★</span>
    </div>
  </div>

  <!-- EN-TÊTE -->
  <header class="ld-header">
    <a class="ld-brand" href="#top" aria-label="Plomberie Leduc, accueil">
      <svg class="ld-brand-badge" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="29" fill="#B23A2E" />
        <circle cx="32" cy="32" r="24" fill="none" stroke="#F6EFDD" stroke-width="2" stroke-dasharray="4 3" />
        <path d="M32 14l4.9 10 11 1.6-8 7.8 1.9 11L32 39.4l-9.8 5 1.9-11-8-7.8 11-1.6z" fill="#F6EFDD" />
      </svg>
      <span class="ld-brand-text">Plomberie <strong>Leduc</strong><small>Longueuil · Depuis 1987</small></span>
    </a>
    <nav class="ld-nav" aria-label="Principal">
      <a href="#services">Services</a>
      <a href="#story">Notre histoire</a>
      <a href="#reviews">Avis</a>
      <a href="#quote">Soumission</a>
    </nav>
    <a class="ld-phone" href="tel:+14505550134">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
      (450) 555-0134
    </a>
  </header>

  <main id="top">
    <!-- HÉROS -->
    <section class="ld-hero">
      <div class="ld-hero-copy">
        <p class="ld-kicker"><span aria-hidden="true">★ ★ ★</span> Depuis 1987 · Longueuil QC <span aria-hidden="true">★ ★ ★</span></p>
        <h1 class="ld-h1">Bien réparé<br />du premier coup.</h1>
        <p class="ld-lede">Trois générations de Leduc gardent l'eau de Longueuil en mouvement. Prix fixes annoncés d'avance, couvre-chaussures à chaque visite et garantie de main-d'oeuvre écrite.</p>
        <div class="ld-hero-cta">
          <a class="ld-btn ld-btn-red" href="tel:+14505550134">Appeler le (450) 555-0134</a>
          <a class="ld-btn ld-btn-outline" href="#quote">Soumission gratuite</a>
        </div>
        <ul class="ld-hero-points">
          <li>Licence RBQ · Entièrement assuré</li>
          <li>Prix fixes annoncés d'avance</li>
          <li>Garantie de 5 ans sur la main-d'oeuvre</li>
        </ul>
      </div>
      <div class="ld-hero-visual">
        <div class="ld-seal" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="ld-seal-ring">
            <defs><path id="ld-circle-fr" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
            <circle cx="100" cy="100" r="96" fill="#1F3A5C" />
            <circle cx="100" cy="100" r="88" fill="none" stroke="#C9A227" stroke-width="2" />
            <text font-size="15.5" letter-spacing="4.5" fill="#F6EFDD" font-family="'Zilla Slab', serif" font-weight="700">
              <textPath href="#ld-circle-fr">PLOMBERIE LEDUC · DEPUIS 1987 · LONGUEUIL QC ·</textPath>
            </text>
            <path d="M100 58l12.6 25.6 28.2 4.1-20.4 19.9 4.8 28.1L100 122.2l-25.2 13.5 4.8-28.1-20.4-19.9 28.2-4.1z" fill="#C9A227" />
          </svg>
        </div>
        <figure class="ld-hero-photo">
          <img src={IMG.hero} alt="Un plombier Leduc réparant un évier avec des outils professionnels" loading="eager" fetchpriority="high" />
          <figcaption>Au travail dans le Vieux-Longueuil</figcaption>
        </figure>
      </div>
    </section>

    <!-- BARRE DE CONFIANCE -->
    <section class="ld-trust" aria-label="Pourquoi les propriétaires font confiance à Leduc">
      <div class="ld-trust-item"><strong>38</strong><span>ans d'activité</span></div>
      <div class="ld-trust-item"><strong>12 400+</strong><span>maisons desservies</span></div>
      <div class="ld-trust-item"><strong>4,9<span class="ld-star">★</span></strong><span>note moyenne</span></div>
      <div class="ld-trust-item"><strong>3</strong><span>générations de Leduc</span></div>
    </section>

    <!-- SERVICES -->
    <section class="ld-section" id="services">
      <div class="ld-wrap">
        <p class="ld-kicker ld-kicker-center">Le menu des services</p>
        <h2 class="ld-h2 ld-center">Ce qu'on répare, installe<br />et entretient.</h2>
        <p class="ld-sub ld-center">Prix fixes annoncés avant qu'on touche à quoi que ce soit. Jamais de surprises.</p>
        <div class="ld-cards">
          <article class="ld-card">
            <div class="ld-card-tag">Le plus demandé</div>
            <h3>Débouchage de drains</h3>
            <p>Éviers, toilettes, conduites principales. Inspection caméra incluse pour voir le bouchon vous-même.</p>
            <p class="ld-price">à partir de <strong>89 $</strong></p>
          </article>
          <article class="ld-card">
            <h3>Chauffe-eau</h3>
            <p>Installation et réparation, avec ou sans réservoir. On repart avec le vieux et on enregistre votre garantie.</p>
            <p class="ld-price">à partir de <strong>1 190 $</strong></p>
          </article>
          <article class="ld-card">
            <h3>Détection de fuites</h3>
            <p>Détection acoustique et thermique pour trouver les fuites cachées sans ouvrir vos murs.</p>
            <p class="ld-price">à partir de <strong>129 $</strong></p>
          </article>
          <article class="ld-card">
            <h3>Plomberie de salle de bain</h3>
            <p>Plomberie brute pour salle de bain neuve ou rénovée, avec permis et inspection, en coordination avec votre entrepreneur.</p>
            <p class="ld-price">à partir de <strong>2 400 $</strong></p>
          </article>
        </div>
        <div class="ld-more">
          <img src={IMG.tools} alt="Une clé à tuyau vintage, fidèle après des années de service" loading="lazy" />
          <div>
            <h3>Pas au menu? Demandez quand même.</h3>
            <p>Si l'eau y passe, on l'a probablement déjà réparé. Pompes de puisard, clapets antiretour, robinets extérieurs, conduites de gaz : un seul appel suffit.</p>
            <a class="ld-btn ld-btn-navy" href="#quote">Décrire votre problème</a>
          </div>
        </div>
      </div>
    </section>

    <!-- HISTOIRE -->
    <section class="ld-section ld-story" id="story">
      <div class="ld-wrap ld-story-grid">
        <figure class="ld-story-photo">
          <img src={IMG.portrait} alt="Un plombier Leduc en uniforme tenant une clé, souriant" loading="lazy" />
          <figcaption>Réal Leduc, fondateur, répond encore au téléphone certains matins.</figcaption>
        </figure>
        <div>
          <p class="ld-kicker">Notre histoire</p>
          <h2 class="ld-h2">Trois générations<br />sous un même badge.</h2>
          <p class="ld-prose">Réal Leduc a commencé en 1987 avec une fourgonnette usagée, une boîte à outils offerte par son père et une règle qu'il répète encore : laisser chaque maison plus propre qu'on l'a trouvée. Son fils Marc s'est joint à lui en 2004. Sa petite-fille Léa, compagnon licenciée depuis 2021, tient la ligne d'urgence aujourd'hui.</p>
          <ol class="ld-timeline">
            <li><strong>1987</strong><span>Réal fonde Plomberie Leduc dans un garage de Longueuil.</span></li>
            <li><strong>2004</strong><span>Marc, deuxième génération, obtient sa carte de compagnon.</span></li>
            <li><strong>2021</strong><span>Léa, troisième génération, prend la ligne 24/7.</span></li>
          </ol>
        </div>
      </div>
    </section>

    <!-- AVIS -->
    <section class="ld-section" id="reviews">
      <div class="ld-wrap">
        <p class="ld-kicker ld-kicker-center">Le bouche-à-oreille</p>
        <h2 class="ld-h2 ld-center">Longueuil garde<br />notre numéro.</h2>
        <div class="ld-reviews">
          <blockquote class="ld-review">
            <p class="ld-stars" aria-label="5 étoiles sur 5">★★★★★</p>
            <p>« Sous-sol inondé à 2 h du matin. Léa était là à 3 h, calme comme tout. La facture correspondait au devis au dollar près. »</p>
            <cite>Chantal B., Fatima</cite>
          </blockquote>
          <blockquote class="ld-review">
            <p class="ld-stars" aria-label="5 étoiles sur 5">★★★★★</p>
            <p>« Ils ont remplacé notre chauffe-eau et reparti avec le vieux. Couvre-chaussures, toiles de protection, toute la routine respectueuse. »</p>
            <cite>Robert D., Vieux-Longueuil</cite>
          </blockquote>
          <blockquote class="ld-review">
            <p class="ld-stars" aria-label="5 étoiles sur 5">★★★★★</p>
            <p>« Troisième plombier appelé pour la même fuite mystère. Le premier qui l'a vraiment trouvée. C'est tout dire. »</p>
            <cite>Amina K., Greenfield Park</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ZONE DESSERVIE -->
    <section class="ld-area">
      <div class="ld-wrap">
        <h2 class="ld-h2 ld-center">Fiers de servir la Rive-Sud.</h2>
        <ul class="ld-area-list">
          <li>Longueuil</li><li>Brossard</li><li>Boucherville</li><li>Saint-Lambert</li><li>Greenfield Park</li><li>Saint-Hubert</li><li>La Prairie</li><li>Candiac</li>
        </ul>
      </div>
    </section>

    <!-- SOUMISSION -->
    <section class="ld-section ld-quote" id="quote">
      <div class="ld-wrap ld-quote-grid">
        <div>
          <p class="ld-kicker">Soumission</p>
          <h2 class="ld-h2">Dites-nous ce qui<br />se passe.</h2>
          <p class="ld-prose">Décrivez le problème et on vous rappelle en moins d'une heure ouvrable avec un prix fixe. Les urgences passent devant : appelez directement le <a href="tel:+14505550134">(450) 555-0134</a>.</p>
          <img class="ld-quote-img" src={IMG.wrench} alt="Une clé à molette bien usée, l'originale du fondateur" loading="lazy" />
        </div>
        <form class="ld-form" id="ld-form" novalidate>
          <label>Votre nom<input type="text" name="name" required placeholder="Jeanne Tremblay" autocomplete="name" /></label>
          <label>Téléphone<input type="tel" name="phone" required placeholder="(450) 555-0000" autocomplete="tel" /></label>
          <label>De quoi avez-vous besoin?
            <select name="service" required>
              <option value="">Choisir un service…</option>
              <option>Débouchage de drains</option>
              <option>Chauffe-eau</option>
              <option>Détection et réparation de fuites</option>
              <option>Plomberie de salle de bain</option>
              <option>Autre chose</option>
            </select>
          </label>
          <label class="ld-form-wide">Décrivez le problème<textarea name="message" rows="4" placeholder="L'évier de cuisine se vide lentement et glougloute…"></textarea></label>
          <button class="ld-form-wide ld-btn ld-btn-red" type="submit">Demander mon rappel</button>
          <p class="ld-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <!-- PIED DE PAGE -->
  <footer class="ld-footer">
    <div class="ld-wrap ld-footer-grid">
      <div>
        <p class="ld-footer-brand">Plomberie <strong>Leduc</strong></p>
        <p>1234, rue Fictive<br />Longueuil QC J4K 1A1</p>
        <p>Licence RBQ : 0000-0000-00 (fictive)</p>
      </div>
      <div>
        <p class="ld-footer-h">Heures</p>
        <p>Lun–Ven 7 h à 18 h<br />Sam 8 h à 14 h<br />Urgences : 24/7</p>
      </div>
      <div>
        <p class="ld-footer-h">Appelez le badge</p>
        <a class="ld-footer-phone" href="tel:+14505550134">(450) 555-0134</a>
      </div>
    </div>
    <p class="ld-fine">© 2026 Plomberie Leduc. Site de démonstration fictif, pas une vraie entreprise.</p>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      var form = document.getElementById('ld-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.ld-form-note');
        if (note) note.textContent = 'Demande reçue. On vous rappelle en moins d\u2019une heure ouvrable.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .ld {
      --ld-cream: #F6EFDD;
      --ld-cream-2: #EFE4CB;
      --ld-red: #B23A2E;
      --ld-red-dark: #8E2B22;
      --ld-navy: #1F3A5C;
      --ld-navy-dark: #152A45;
      --ld-gold: #C9A227;
      --ld-ink: #2A2118;
      --ld-slab: "Zilla Slab", Georgia, "Times New Roman", serif;
      margin: 0;
      background: var(--ld-cream);
      color: var(--ld-ink);
      font-family: var(--ld-slab);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ld *, .ld *::before, .ld *::after { box-sizing: border-box; }
    .ld img { display: block; max-width: 100%; }
    .ld-wrap { max-width: 1160px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px); }
    .ld-center { text-align: center; }

    .ld-ticker { background: var(--ld-red); color: var(--ld-cream); overflow: hidden; white-space: nowrap; border-bottom: 3px solid var(--ld-navy); }
    .ld-ticker-track { display: inline-flex; align-items: center; gap: 28px; padding: 10px 0; animation: ld-tick 28s linear infinite; font-weight: 600; letter-spacing: 0.04em; font-size: 15px; }
    .ld-ticker-track a { color: #fff; font-weight: 700; }
    .ld-ticker-star { color: var(--ld-gold); }
    @keyframes ld-tick { to { transform: translateX(-50%); } }

    .ld-header {
      display: flex; align-items: center; gap: 28px;
      padding: 16px clamp(20px, 5vw, 48px); max-width: 1280px; margin: 0 auto;
      border-bottom: 2px solid var(--ld-ink);
    }
    .ld-brand { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--ld-ink); }
    .ld-brand-badge { width: 52px; height: 52px; flex: none; }
    .ld-brand-text { font-size: 21px; line-height: 1.05; display: grid; }
    .ld-brand-text strong { font-weight: 700; letter-spacing: 0.06em; }
    .ld-brand-text small { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.65; font-weight: 500; }
    .ld-nav { display: flex; gap: 26px; margin-left: auto; }
    .ld-nav a { color: var(--ld-ink); text-decoration: none; font-weight: 600; font-size: 16.5px; letter-spacing: 0.02em; border-bottom: 2px solid transparent; }
    .ld-nav a:hover { border-bottom-color: var(--ld-red); }
    .ld-phone {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--ld-navy); color: var(--ld-cream); text-decoration: none;
      font-weight: 700; padding: 12px 20px; border-radius: 999px; font-size: 16px;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .ld-phone:hover { background: var(--ld-navy-dark); transform: translateY(-1px); }

    .ld-hero {
      display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(30px, 5vw, 70px); align-items: center;
      max-width: 1280px; margin: 0 auto; padding: clamp(48px, 8vh, 96px) clamp(20px, 5vw, 48px);
      background-image: repeating-linear-gradient(90deg, transparent 0 46px, rgba(31,58,92,0.045) 46px 48px);
    }
    .ld-kicker { font-size: 14px; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ld-red); margin: 0 0 18px; }
    .ld-kicker-center { text-align: center; }
    .ld-h1 { font-size: clamp(2.9rem, 6.4vw, 5.2rem); line-height: 0.98; letter-spacing: 0.01em; margin: 0 0 22px; font-weight: 700; }
    .ld-lede { font-size: 18.5px; line-height: 1.65; max-width: 46ch; margin: 0 0 30px; font-weight: 500; }
    .ld-hero-cta { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 30px; }
    .ld-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--ld-slab); font-weight: 700; font-size: 17px; letter-spacing: 0.03em;
      padding: 15px 30px; border-radius: 10px; text-decoration: none; cursor: pointer; border: 3px solid transparent;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }
    .ld-btn-red { background: var(--ld-red); color: #fff; box-shadow: 4px 4px 0 var(--ld-navy); }
    .ld-btn-red:hover { background: var(--ld-red-dark); transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ld-navy); }
    .ld-btn-outline { border-color: var(--ld-navy); color: var(--ld-navy); background: transparent; }
    .ld-btn-outline:hover { background: var(--ld-navy); color: var(--ld-cream); }
    .ld-btn-navy { background: var(--ld-navy); color: var(--ld-cream); }
    .ld-btn-navy:hover { background: var(--ld-navy-dark); transform: translateY(-2px); }
    .ld-hero-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-weight: 600; font-size: 16px; }
    .ld-hero-points li::before { content: "★ "; color: var(--ld-gold); }
    .ld-hero-visual { position: relative; display: grid; justify-items: center; }
    .ld-seal { width: min(210px, 44vw); position: absolute; top: -34px; right: 2%; z-index: 2; filter: drop-shadow(0 10px 18px rgba(31,58,92,0.3)); }
    .ld-seal-ring { width: 100%; height: auto; animation: ld-spin 26s linear infinite; }
    @keyframes ld-spin { to { transform: rotate(360deg); } }
    .ld-hero-photo { margin: 46px 0 0; width: 100%; border: 4px solid var(--ld-ink); border-radius: 190px 190px 14px 14px; overflow: hidden; background: var(--ld-cream-2); }
    .ld-hero-photo img { width: 100%; height: min(480px, 62vw); object-fit: cover; }
    .ld img { filter: sepia(0.22) saturate(0.96) contrast(1.01); }
    .ld-hero-photo figcaption { text-align: center; font-size: 13.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; padding: 12px; background: var(--ld-cream); }

    .ld-trust { background: var(--ld-navy); color: var(--ld-cream); display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1280px; margin: 0 auto; border-radius: 18px; overflow: hidden; }
    .ld-trust-item { padding: 30px 18px; text-align: center; border-left: 1px dashed rgba(246,239,221,0.35); display: grid; gap: 6px; }
    .ld-trust-item:first-child { border-left: 0; }
    .ld-trust-item strong { font-size: clamp(1.7rem, 3vw, 2.5rem); font-weight: 700; letter-spacing: 0.02em; }
    .ld-trust-item span { font-size: 13.5px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8; font-weight: 500; }
    .ld-star { color: var(--ld-gold); }

    .ld-section { padding: clamp(72px, 10vh, 130px) 0; }
    .ld-h2 { font-size: clamp(2rem, 4.4vw, 3.3rem); line-height: 1.02; margin: 0 0 18px; font-weight: 700; letter-spacing: 0.01em; }
    .ld-sub { font-size: 17px; font-weight: 500; opacity: 0.75; margin: 0 0 44px; }
    .ld-prose { font-size: 17.5px; line-height: 1.75; font-weight: 500; max-width: 56ch; }
    .ld-prose a { color: var(--ld-red); font-weight: 700; }

    .ld-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .ld-card {
      background: #FFFDF6; border: 3px solid var(--ld-ink); border-radius: 14px; padding: 28px 24px;
      position: relative; transition: transform 0.16s ease, box-shadow 0.16s ease;
    }
    .ld-card:hover { transform: translateY(-6px) rotate(-0.5deg); box-shadow: 7px 7px 0 var(--ld-red); }
    .ld-card-tag {
      position: absolute; top: -15px; left: 20px; background: var(--ld-gold); color: var(--ld-ink);
      font-size: 12.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
      padding: 5px 12px; border: 2px solid var(--ld-ink); border-radius: 999px; transform: rotate(-3deg);
    }
    .ld-card h3 { font-size: 21px; margin: 6px 0 12px; font-weight: 700; }
    .ld-card p { font-size: 15.5px; line-height: 1.6; margin: 0 0 16px; font-weight: 500; opacity: 0.85; }
    .ld-price { font-size: 15px !important; letter-spacing: 0.06em; }
    .ld-price strong { font-size: 26px; color: var(--ld-red); }
    .ld-more { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(26px, 4vw, 54px); align-items: center; margin-top: 56px; background: var(--ld-cream-2); border: 3px dashed var(--ld-navy); border-radius: 18px; padding: clamp(24px, 4vw, 44px); }
    .ld-more img { width: 100%; height: 300px; object-fit: cover; border-radius: 12px; border: 3px solid var(--ld-ink); }
    .ld-more h3 { font-size: 24px; margin: 0 0 12px; }
    .ld-more p { font-size: 16.5px; line-height: 1.65; font-weight: 500; margin: 0 0 22px; }

    .ld-story { background: var(--ld-navy); color: var(--ld-cream); }
    .ld-story .ld-kicker { color: var(--ld-gold); }
    .ld-story-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(30px, 5vw, 70px); align-items: start; }
    .ld-story-photo { margin: 0; border: 4px solid var(--ld-gold); border-radius: 14px; overflow: hidden; transform: rotate(-1.5deg); }
    .ld-story-photo img { width: 100%; height: min(520px, 72vw); object-fit: cover; }
    .ld-story-photo figcaption { background: var(--ld-navy-dark); padding: 12px 16px; font-size: 13.5px; letter-spacing: 0.06em; font-weight: 500; }
    .ld-story .ld-prose { color: rgba(246,239,221,0.88); }
    .ld-timeline { list-style: none; margin: 34px 0 0; padding: 0; display: grid; gap: 0; border-left: 3px solid var(--ld-gold); }
    .ld-timeline li { padding: 4px 0 26px 26px; position: relative; display: grid; gap: 4px; }
    .ld-timeline li::before { content: "★"; position: absolute; left: -14px; top: 2px; background: var(--ld-navy); color: var(--ld-gold); font-size: 18px; padding: 0 4px; }
    .ld-timeline strong { font-size: 22px; color: var(--ld-gold); letter-spacing: 0.04em; }
    .ld-timeline span { font-size: 16px; font-weight: 500; color: rgba(246,239,221,0.85); }

    .ld-reviews { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
    .ld-review {
      margin: 0; background: #FFFDF6; border: 3px solid var(--ld-ink); border-radius: 6px 22px 6px 22px;
      padding: 28px 26px; position: relative; transition: transform 0.16s ease;
    }
    .ld-review:hover { transform: rotate(0.6deg) scale(1.015); }
    .ld-review::after {
      content: "LEDUC ★ APPROUVÉ"; position: absolute; bottom: 14px; right: 16px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.2em; color: var(--ld-red);
      border: 2px solid var(--ld-red); border-radius: 6px; padding: 4px 8px; transform: rotate(-6deg); opacity: 0.85;
    }
    .ld-stars { color: var(--ld-gold); font-size: 19px; letter-spacing: 3px; margin: 0 0 14px; text-shadow: 1px 1px 0 var(--ld-ink); }
    .ld-review p:nth-of-type(2) { font-size: 16.5px; line-height: 1.65; font-weight: 500; margin: 0 0 18px; }
    .ld-review cite { font-style: normal; font-weight: 700; font-size: 14.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ld-navy); }

    .ld-area { background: var(--ld-cream-2); border-block: 3px solid var(--ld-ink); padding: clamp(48px, 7vh, 80px) 0; }
    .ld-area-list { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .ld-area-list li {
      font-weight: 700; font-size: 16px; letter-spacing: 0.05em;
      border: 2.5px solid var(--ld-navy); border-radius: 999px; padding: 9px 20px; background: var(--ld-cream);
      transition: background 0.15s ease, color 0.15s ease;
    }
    .ld-area-list li:hover { background: var(--ld-navy); color: var(--ld-cream); }

    .ld-quote-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(30px, 5vw, 64px); align-items: start; }
    .ld-quote-img { width: 100%; height: 260px; object-fit: cover; border: 3px solid var(--ld-ink); border-radius: 14px; margin-top: 30px; }
    .ld-form { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; background: #FFFDF6; border: 3px solid var(--ld-ink); border-radius: 16px; padding: clamp(24px, 4vw, 40px); box-shadow: 8px 8px 0 var(--ld-cream-2); }
    .ld-form-wide { grid-column: 1 / -1; }
    .ld-form label { display: grid; gap: 8px; font-weight: 700; font-size: 14.5px; letter-spacing: 0.06em; text-transform: uppercase; }
    .ld-form input, .ld-form select, .ld-form textarea {
      font-family: var(--ld-slab); font-size: 16px; font-weight: 500;
      border: 2.5px solid var(--ld-ink); border-radius: 8px; padding: 12px 14px; background: #fff; color: var(--ld-ink); width: 100%;
    }
    .ld-form input:focus, .ld-form select:focus, .ld-form textarea:focus { outline: 3px solid var(--ld-gold); outline-offset: 1px; }
    .ld-form-note { margin: 0; font-weight: 600; font-size: 15.5px; color: var(--ld-navy); }
    .ld-form-note:empty { display: none; }

    .ld-footer { background: var(--ld-ink); color: var(--ld-cream); padding: clamp(48px, 7vh, 80px) 0 30px; }
    .ld-footer-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 34px; margin-bottom: 40px; }
    .ld-footer-brand { font-size: 26px; margin: 0 0 14px; }
    .ld-footer p { font-size: 15.5px; line-height: 1.7; font-weight: 500; opacity: 0.85; margin: 0 0 10px; }
    .ld-footer-h { font-size: 13px !important; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ld-gold); opacity: 1 !important; }
    .ld-footer-phone { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; color: var(--ld-cream); text-decoration: none; letter-spacing: 0.02em; }
    .ld-footer-phone:hover { color: var(--ld-gold); }
    .ld-fine { text-align: center; font-size: 13px; opacity: 0.6; border-top: 1px solid rgba(246,239,221,0.2); padding-top: 24px; margin: 0; }

    @media (max-width: 980px) {
      .ld-cards { grid-template-columns: repeat(2, 1fr); }
      .ld-reviews { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; margin-top: 36px; }
      .ld-story-grid, .ld-quote-grid, .ld-more { grid-template-columns: 1fr; }
      .ld-hero { grid-template-columns: 1fr; }
      .ld-hero-visual { max-width: 520px; margin: 0 auto; width: 100%; }
      .ld-trust { grid-template-columns: repeat(2, 1fr); }
      .ld-trust-item:nth-child(3) { border-left: 0; }
    }
    @media (max-width: 640px) {
      .ld-nav { display: none; }
      .ld-header { justify-content: space-between; }
      .ld-cards { grid-template-columns: 1fr; }
      .ld-form { grid-template-columns: 1fr; }
      .ld-footer-grid { grid-template-columns: 1fr; }
      .ld-seal { top: -24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ld-ticker-track, .ld-seal-ring { animation: none; }
      .ld-card, .ld-review, .ld-btn, .ld-phone { transition: none; }
    }
  </style>
</body>
</html>
