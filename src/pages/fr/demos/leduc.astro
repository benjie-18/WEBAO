---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Démo : Plomberie Leduc, plombier fictif, Longueuil QC.
// Reconstruite URGENCE D'ABORD. Tout le haut de page est l'appel d'urgence :
// numéro géant, promesse de réponse en 20 minutes. Les services sont une
// simple liste de prix, l'histoire tient en un paragraphe, le contact c'est
// le numéro de téléphone, encore. Badge vintage americana : crème/rouge/marine.
const IMG = {
  hero: "/demos/leduc/01.jpg",
  portrait: "/demos/leduc/02.jpg",
  tools: "/demos/leduc/03.jpg",
  wrench: "/demos/leduc/04.jpg",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="leduc" locale="fr" title="Plomberie Leduc · Tuyau éclaté? (450) 555-0134 · Plombier à Longueuil" description="Plomberie Leduc : le plombier familial de Longueuil depuis 1987. Tuyau éclaté, plus d'eau chaude, drain bouché? On répond en 20 minutes, 24/7." ogImage="https://webao.ca/demos/leduc/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="em">

  <!-- TOUT LE HAUT DE PAGE EST L'APPEL D'URGENCE -->
  <header class="em-hero">
    <p class="em-badge">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="29" fill="#B23A2E" />
        <circle cx="32" cy="32" r="24" fill="none" stroke="#F6EFDD" stroke-width="2" stroke-dasharray="4 3" />
        <path d="M32 14l4.9 10 11 1.6-8 7.8 1.9 11L32 39.4l-9.8 5 1.9-11-8-7.8 11-1.6z" fill="#F6EFDD" />
      </svg>
      Plomberie Leduc · Longueuil · depuis 1987
    </p>
    <h1 class="em-h1">Tuyau éclaté?<br />Plus d'eau chaude?</h1>
    <a class="em-number" href="tel:+14505550134">(450) 555-0134</a>
    <p class="em-promise"><span class="em-dot" aria-hidden="true"></span>On répond en 20 minutes. Jour, nuit, jours fériés.</p>
    <p class="em-sub">C'est un Leduc qui décroche, pas un centre d'appels. Si l'eau est là où elle ne devrait pas être, appelez maintenant et on vous guide pour couper l'eau pendant que la camionnette roule.</p>
  </header>

  <main>
    <!-- LISTE DE PRIX, pas de cartes -->
    <section class="em-list" aria-label="Liste de prix">
      <h2 class="em-h2">La liste de prix</h2>
      <p class="em-note">Tarifs fixes, annoncés avant qu'on lève une clé.</p>
      <dl>
        <div><dt>Débouchage de drains <span>éviers, toilettes, conduites principales · inspection caméra incluse</span></dt><dd>à partir de 89 $</dd></div>
        <div><dt>Détection de fuites <span>acoustique et thermique, sans murs arrachés</span></dt><dd>à partir de 129 $</dd></div>
        <div><dt>Chauffe-eau <span>avec ou sans réservoir, installé · l'ancien repris</span></dt><dd>à partir de 1 190 $</dd></div>
        <div><dt>Plomberie de salle de bain <span>avec permis, inspectée, coordonnée avec votre entrepreneur</span></dt><dd>à partir de 2 400 $</dd></div>
        <div><dt>Pompe de puisard et clapet <span>protection contre les inondations de sous-sol</span></dt><dd>à partir de 640 $</dd></div>
        <div><dt>Robinets extérieurs et gaz <span>si l'eau ou le gaz y passe</span></dt><dd>devis</dd></div>
      </dl>
      <figure class="em-tools">
        <img src={IMG.tools} alt="Une vieille clé à tuyau gardée depuis des années de service" loading="lazy" decoding="async" />
        <img src={IMG.wrench} alt="La clé d'origine du fondateur" loading="lazy" decoding="async" />
      </figure>
    </section>

    <!-- UN PARAGRAPHE. C'est la section à propos. -->
    <section class="em-about">
      <div class="em-about-in">
        <img src={IMG.portrait} alt="Réal Leduc, fondateur, en uniforme" loading="lazy" decoding="async" />
        <div>
          <h2 class="em-h2">Trois générations, un badge.</h2>
          <p>Réal Leduc a commencé en 1987 avec une camionnette usagée et une règle qu'il répète encore : laissez chaque maison plus propre qu'à votre arrivée. Son fils Marc s'est joint en 2004; sa petite-fille Léa, compagnon agréée depuis 2021, tient la ligne 24/7 aujourd'hui. Plus de 12 400 maisons, note moyenne de 4,9, garantie de 5 ans sur la main-d'œuvre, par écrit.</p>
        </div>
        <img class="em-about-job" src={IMG.hero} alt="Un plombier Leduc répare un évier" loading="lazy" decoding="async" fetchpriority="high" />
      </div>
    </section>

    <!-- PAS URGENT? Un coupon de rappel, puis le numéro encore -->
    <section class="em-callback">
      <h2 class="em-h2">Pas urgent?</h2>
      <p class="em-note">Laissez votre numéro. On vous rappelle dans l'heure ouvrable.</p>
      <form class="em-form" id="em-form" novalidate>
        <label class="em-sr" for="em-phone">Numéro de téléphone</label>
        <input id="em-phone" type="tel" name="phone" required placeholder="(450) 555-0000" autocomplete="tel" />
        <button type="submit">Rappelez-moi</button>
      </form>
      <p class="em-form-note" role="status" aria-live="polite"></p>
    </section>

    <section class="em-again">
      <p class="em-again-k">De l'eau là où elle ne devrait pas être?</p>
      <a class="em-number em-number-sm" href="tel:+14505550134">(450) 555-0134</a>
    </section>
  </main>

  <footer class="em-foot">
    <p>Plomberie Leduc · 1234, rue Fictive, Longueuil QC · Licence RBQ 0000-0000-00 (fictive)<br />
    Lun–ven 7 h–18 h, sam 8 h–14 h · urgences 24/7 · © 2026</p>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      var form = document.getElementById('em-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = document.querySelector('.em-form-note');
        if (note) note.textContent = 'Noté. On vous rappellera dans l\u2019heure ouvrable.';
        if (form instanceof HTMLFormElement) form.reset();
      });
    })();
  </script>

  <style>
    .em {
      --em-cream: #F6EFDD;
      --em-red: #B23A2E;
      --em-red-dark: #8E2B22;
      --em-navy: #1F3A5C;
      --em-gold: #C9A227;
      --em-ink: #2A2118;
      --em-slab: "Zilla Slab", Georgia, serif;
      margin: 0;
      background: var(--em-cream);
      color: var(--em-ink);
      font-family: var(--em-slab);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .em *, .em *::before, .em *::after { box-sizing: border-box; }
    .em img { display: block; max-width: 100%; filter: sepia(0.22) saturate(0.96); }
    .em a { color: inherit; }

    .em-hero {
      background: var(--em-red);
      color: #FFF8EC;
      text-align: center;
      padding: clamp(40px, 8vh, 84px) clamp(20px, 5vw, 48px) clamp(48px, 9vh, 96px);
      border-bottom: 6px solid var(--em-navy);
    }
    .em-badge {
      display: inline-flex; align-items: center; gap: 12px;
      margin: 0 0 30px; font-weight: 600; font-size: 15px; letter-spacing: 0.12em;
    }
    .em-badge svg { width: 40px; height: 40px; }
    .em-h1 {
      margin: 0 0 10px;
      font-size: clamp(3rem, 11vw, 7rem);
      line-height: 0.95; letter-spacing: 0.01em; font-weight: 700;
    }
    .em-number {
      display: inline-block;
      font-weight: 700; letter-spacing: 0.01em; text-decoration: none;
      font-size: clamp(2.6rem, 10vw, 6.2rem);
      margin: 18px 0 8px; padding: 6px 22px;
      border: 4px solid #FFF8EC; border-radius: 18px;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .em-number:hover { background: #FFF8EC; color: var(--em-red); }
    .em-promise {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      font-size: clamp(1.1rem, 3vw, 1.5rem); font-weight: 600; margin: 14px 0 22px;
    }
    .em-dot { width: 12px; height: 12px; border-radius: 50%; background: #3DFF7A; flex: none; animation: em-pulse 1.8s infinite; }
    @keyframes em-pulse { 50% { box-shadow: 0 0 0 8px rgba(61,255,122,0.15); } }
    .em-sub { max-width: 56ch; margin: 0 auto; font-size: 16.5px; line-height: 1.7; opacity: 0.92; font-weight: 500; }

    .em-list { max-width: 820px; margin: 0 auto; padding: clamp(48px, 8vh, 88px) clamp(20px, 5vw, 48px); }
    .em-h2 { font-size: clamp(1.9rem, 5vw, 2.9rem); margin: 0 0 6px; letter-spacing: 0.01em; }
    .em-note { font-size: 15.5px; opacity: 0.7; font-weight: 500; margin: 0 0 30px; }
    .em-list dl { margin: 0; border-top: 3px solid var(--em-ink); }
    .em-list dl div {
      display: flex; justify-content: space-between; align-items: baseline; gap: 20px;
      padding: 20px 2px; border-bottom: 1px solid rgba(42,33,24,0.18);
    }
    .em-list dt { font-size: 18px; font-weight: 700; }
    .em-list dt span { display: block; font-size: 14px; font-weight: 500; opacity: 0.65; margin-top: 4px; }
    .em-list dd { margin: 0; font-size: 20px; font-weight: 700; color: var(--em-red); white-space: nowrap; }
    .em-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 34px 0 0; }
    .em-tools img { width: 100%; height: 200px; object-fit: cover; border: 3px solid var(--em-ink); border-radius: 10px; }

    .em-about { background: var(--em-navy); color: var(--em-cream); }
    .em-about-in {
      max-width: 1080px; margin: 0 auto; padding: clamp(48px, 8vh, 88px) clamp(20px, 5vw, 48px);
      display: grid; grid-template-columns: 200px 1fr 240px; gap: clamp(24px, 4vw, 48px); align-items: center;
    }
    .em-about img { border-radius: 12px; border: 3px solid var(--em-gold); }
    .em-about-in > img:first-child { width: 200px; height: 240px; object-fit: cover; transform: rotate(-2deg); }
    .em-about-job { width: 240px; height: 200px; object-fit: cover; transform: rotate(1.5deg); }
    .em-about .em-h2 { color: var(--em-gold); }
    .em-about p { font-size: 17.5px; line-height: 1.75; font-weight: 500; margin: 14px 0 0; max-width: 52ch; color: rgba(246,239,221,0.9); }

    .em-callback { max-width: 620px; margin: 0 auto; padding: clamp(48px, 8vh, 88px) clamp(20px, 5vw, 48px) 0; text-align: center; }
    .em-form { display: flex; gap: 10px; margin-top: 8px; }
    .em-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .em-form input {
      flex: 1; font-family: var(--em-slab); font-size: 18px; padding: 15px 18px;
      border: 3px solid var(--em-ink); border-radius: 10px; background: #FFFDF6; color: var(--em-ink); min-width: 0;
    }
    .em-form input:focus { outline: 3px solid var(--em-gold); outline-offset: 1px; }
    .em-form button {
      font-family: var(--em-slab); font-weight: 700; font-size: 17px;
      background: var(--em-navy); color: var(--em-cream); border: 0; border-radius: 10px;
      padding: 15px 26px; cursor: pointer; white-space: nowrap;
      box-shadow: 4px 4px 0 var(--em-ink); transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .em-form button:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--em-ink); }
    .em-form-note { font-weight: 600; color: var(--em-navy); min-height: 1.6em; }
    .em-form-note:empty { display: none; }

    .em-again { text-align: center; padding: clamp(40px, 7vh, 72px) 20px clamp(48px, 8vh, 88px); }
    .em-again-k { font-size: 20px; font-weight: 600; margin: 0 0 6px; }
    .em-number-sm { font-size: clamp(2.2rem, 8vw, 4.4rem); border-color: var(--em-red); color: var(--em-red); }
    .em-number-sm:hover { background: var(--em-red); color: #FFF8EC; }

    .em-foot { background: var(--em-ink); color: rgba(246,239,221,0.75); text-align: center; padding: 36px 20px; font-size: 13.5px; line-height: 1.9; font-weight: 500; }
    .em-foot p { margin: 0; }

    @media (max-width: 860px) {
      .em-about-in { grid-template-columns: 1fr; justify-items: center; text-align: center; }
      .em-about-in > img:first-child { width: 160px; height: 190px; }
      .em-about-job { width: 100%; max-width: 420px; }
      .em-about p { margin-inline: auto; }
      .em-form { flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      .em-dot { animation: none; }
      .em-number, .em-form button { transition: none; }
    }
  </style>
</body>
</html>
