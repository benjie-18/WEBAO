---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Démo : Lattice · application de productivité modulaire fictive, Toronto.
// Reconstruite comme UNE SEULE GRILLE BENTO GÉANTE : aucune section. Nav,
// titre, stats, modules, tarifs, témoignages, formulaire de contact et pied
// de page sont tous des cellules dans une seule grille continue.
// Direction artistique autonome.
const IMG = {
  desk: "/demos/lattice/01.jpg",
  planner: "/demos/lattice/02.jpg",
  team: "https://images.unsplash.com/photo-1553877522-43269d4ea984?q=80&w=800&auto=format&fit=crop",
  notes: "https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=800&auto=format&fit=crop",
  office: "https://images.unsplash.com/photo-1524758631624-e2822e304c36?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="lattice" locale="fr" title="Lattice · Chaque outil. Une grille." description="Démo Lattice : une appli de productivité modulaire présentée comme une seule grille bento géante. Produit fictif." ogImage="https://webao.ca/demos/lattice/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="bx">

  <!-- THE WHOLE PAGE: one bento grid -->
  <main class="bx-grid" id="top">

    <!-- nav cell -->
    <nav class="bx-cell bx-nav" aria-label="Principale">
      <a class="bx-logo" href="#top"><span class="bx-logo-box" aria-hidden="true"></span>Lattice</a>
      <div class="bx-nav-links">
        <a href="#cell-modules">Modules</a>
        <a href="#cell-pricing">Tarifs</a>
        <a href="#cell-contact">Contact</a>
      </div>
      <a class="bx-cta" href="#cell-contact">Commencer gratuitement</a>
    </nav>

    <!-- headline cell -->
    <header class="bx-cell bx-hero">
      <p class="bx-mono bx-hero-kicker">Productivité modulaire · Toronto</p>
      <h1 class="bx-h1">Chaque outil.<br />Une <span class="bx-lime">grille.</span></h1>
      <p class="bx-hero-sub">Lattice emboîte documents, tableaux, clavardage et automatisations dans un seul espace de travail à l'image exacte de votre équipe.</p>
      <a class="bx-cta" href="#cell-contact">Bâtissez votre grille</a>
    </header>

    <!-- focus score cell -->
    <div class="bx-cell bx-stat">
      <p class="bx-mono">Score de concentration · cette semaine</p>
      <p class="bx-bignum">92<span class="bx-lime">%</span></p>
      <p class="bx-mono bx-dim">En hausse de 6 points depuis lundi</p>
    </div>

    <!-- today cell -->
    <div class="bx-cell bx-today">
      <p class="bx-mono">Aujourd'hui · 4 en cours</p>
      <ul class="bx-checks">
        <li><span class="bx-box bx-done" aria-hidden="true">✓</span>Livrer le parcours d'accueil</li>
        <li><span class="bx-box bx-done" aria-hidden="true">✓</span>Revoir le tableau de sprint</li>
        <li><span class="bx-box" aria-hidden="true"></span>Rédiger les notes de lancement</li>
        <li><span class="bx-box" aria-hidden="true"></span>1 à 1 avec Priya</li>
      </ul>
    </div>

    <!-- image cell: desk -->
    <figure class="bx-cell bx-imgcell">
      <img src={IMG.desk} alt="Un bureau calme avec un portable qui affiche Lattice" loading="lazy" decoding="async" />
    </figure>

    <!-- hours saved cell -->
    <div class="bx-cell bx-stat">
      <p class="bx-mono">Heures économisées</p>
      <p class="bx-bignum">11.4<span class="bx-lime">h</span></p>
      <p class="bx-mono bx-dim">Les automatisations ont fait le plate</p>
    </div>

    <!-- calendar cell -->
    <div class="bx-cell bx-cal">
      <p class="bx-mono">Octobre</p>
      <div class="bx-cal-grid" aria-hidden="true">
        <span></span><span></span><span>1</span><span>2</span><span>3</span><span class="bx-cal-now">4</span><span>5</span>
        <span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span>
      </div>
      <p class="bx-mono bx-dim">2 réunions aujourd'hui. Les deux auraient pu être une cellule.</p>
    </div>

    <!-- team pulse cell -->
    <div class="bx-cell bx-pulse">
      <p class="bx-mono">Pouls de l'équipe · en direct</p>
      <div class="bx-dots" aria-hidden="true"><span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span></span><span></span></div>
      <p class="bx-pulse-line">4 sur 6 en ligne</p>
    </div>

    <!-- image cell: planner, wide -->
    <figure class="bx-cell bx-imgcell bx-wide">
      <img src={IMG.planner} alt="Une page d'agenda remplie d'une mise en page hebdomadaire Lattice" loading="lazy" decoding="async" />
    </figure>

    <!-- modules: four small cells -->
    <div class="bx-cell bx-mod" id="cell-modules">
      <p class="bx-mod-ico" aria-hidden="true">▤</p>
      <h2>Documents</h2>
      <p>Des notes qui se lient entre elles.</p>
    </div>
    <div class="bx-cell bx-mod">
      <p class="bx-mod-ico" aria-hidden="true">▦</p>
      <h2>Tableaux</h2>
      <p>Du kanban sans la culpabilité du kanban.</p>
    </div>
    <div class="bx-cell bx-mod">
      <p class="bx-mod-ico" aria-hidden="true">◭</p>
      <h2>Clavardage</h2>
      <p>Des fils qui restent là où est le travail.</p>
    </div>
    <div class="bx-cell bx-mod">
      <p class="bx-mod-ico" aria-hidden="true">⚙</p>
      <h2>Automatisations</h2>
      <p>Des règles qui classent, relancent et rappellent.</p>
    </div>

    <!-- workflow: three step cells -->
    <div class="bx-cell bx-step">
      <p class="bx-mono bx-lime">Capturer</p>
      <p>Déposez tout. Lattice trie avant que vous ayez fini votre café.</p>
    </div>
    <div class="bx-cell bx-step">
      <p class="bx-mono bx-lime">Organiser</p>
      <p>Glissez les cellules jusqu'à ce que la semaine ressemble à une semaine que vous voulez.</p>
    </div>
    <div class="bx-cell bx-step">
      <p class="bx-mono bx-lime">Livrer</p>
      <p>Partagez un seul lien. Tout le monde voit la même grille, en direct.</p>
    </div>

    <!-- pricing: three cells -->
    <div class="bx-cell bx-price" id="cell-pricing">
      <h2>Départ</h2>
      <p class="bx-bignum">$0</p>
      <p class="bx-dim">3 tableaux · 1 automatisation<br />Jusqu'à 5 coéquipiers</p>
      <a class="bx-ghost" href="#cell-contact">Commencer gratuitement</a>
    </div>
    <div class="bx-cell bx-price bx-price-hot">
      <p class="bx-mono bx-lime">Le plus choisi</p>
      <h2>Studio</h2>
      <p class="bx-bignum">$12<span class="bx-per">/mois</span></p>
      <p class="bx-dim">Cellules illimitées · 50 automatisations<br />Invités + historique des versions</p>
      <a class="bx-cta" href="#cell-contact">Essayer Studio</a>
    </div>
    <div class="bx-cell bx-price">
      <h2>Entreprise</h2>
      <p class="bx-bignum">Sur demande</p>
      <p class="bx-dim">SSO · journal d'audit · grille dédiée<br />Un humain en renfort</p>
      <a class="bx-ghost" href="#cell-contact">Contacter les ventes</a>
    </div>

    <!-- testimonial cell -->
    <blockquote class="bx-cell bx-quote">
      <p>« On a supprimé quatre applis en une semaine. La grille les a juste avalées. »</p>
      <footer class="bx-mono bx-dim">Amara O. · cheffe des opérations, Fern Studio</footer>
    </blockquote>

    <!-- image cell: team -->
    <figure class="bx-cell bx-imgcell">
      <img src={IMG.team} alt="Une équipe produit autour d'une table qui planifie sur un tableau blanc" loading="lazy" decoding="async" />
    </figure>

    <!-- contact form cell -->
    <div class="bx-cell bx-contact" id="cell-contact">
      <h2 class="bx-h2">Obtenez votre grille</h2>
      <form id="bx-form">
        <label>Courriel professionnel<input type="email" name="email" required autocomplete="email" placeholder="vous@studio.com" /></label>
        <label>Taille de l'équipe<select name="size"><option>Juste moi</option><option>2 à 10</option><option>11 à 50</option><option>50+</option></select></label>
        <button class="bx-cta bx-cta-full" type="submit">Réclamer mon espace</button>
        <p class="bx-mono bx-form-done" id="bx-done" hidden>Grille réservée. Vérifiez votre boîte courriel.</p>
      </form>
    </div>

    <!-- image cell: notes -->
    <figure class="bx-cell bx-imgcell">
      <img src={IMG.notes} alt="Notes manuscrites à côté d'un tableau Lattice" loading="lazy" decoding="async" />
    </figure>

    <!-- image cell: office, wide-ish -->
    <figure class="bx-cell bx-imgcell bx-wide2">
      <img src={IMG.office} alt="Un bureau de studio lumineux avec une table de travail partagée" loading="lazy" decoding="async" />
    </figure>

    <!-- footer cell -->
    <footer class="bx-cell bx-foot">
      <p class="bx-mono">Lattice · site de démonstration fictif · Toronto</p>
      <p class="bx-mono bx-dim">hello@lattice.example · (416) 555-0133</p>
    </footer>
  </main>

  <EscapeHatch locale="fr" />

  <style>
    .bx { --bg: #0e0f0c; --cell: #171814; --cell2: #1e2019; --ink: #f2f3ea; --mut: #9a9c8d; --lime: #c8f04a; --line: #2a2c23; --mono: "IBM Plex Mono", ui-monospace, monospace; --sans: "Space Grotesk", system-ui, sans-serif; background: var(--bg); color: var(--ink); font-family: var(--sans); margin: 0; min-height: 100vh; }
    .bx * { box-sizing: border-box; }
    .bx img { display: block; max-width: 100%; }
    .bx .bx-mono { font-family: var(--mono); font-size: 12px; letter-spacing: .05em; }
    .bx .bx-dim { color: var(--mut); }
    .bx .bx-lime { color: var(--lime); }
    .bx .bx-h1 { font-size: clamp(38px, 5.5vw, 68px); line-height: .98; letter-spacing: -0.03em; margin: 14px 0 0; font-weight: 700; }
    .bx .bx-h2 { font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.02em; margin: 0 0 18px; }
    .bx .bx-bignum { font-size: clamp(34px, 4vw, 52px); font-weight: 700; letter-spacing: -0.03em; margin: 10px 0; font-variant-numeric: tabular-nums; }
    .bx .bx-per { font-size: 16px; color: var(--mut); letter-spacing: 0; }
    .bx .bx-cta { display: inline-block; background: var(--lime); color: #141505; font-weight: 700; font-size: 15px; padding: 12px 24px; border-radius: 999px; text-decoration: none; border: 0; cursor: pointer; font-family: var(--sans); }
    .bx .bx-cta:hover { background: #d9ff63; }
    .bx .bx-cta-full { width: 100%; }
    .bx .bx-ghost { display: inline-block; margin-top: 14px; color: var(--ink); font-weight: 600; font-size: 14px; text-decoration: none; border: 1px solid var(--line); padding: 10px 20px; border-radius: 999px; }
    .bx .bx-ghost:hover { border-color: var(--lime); color: var(--lime); }

    /* the grid IS the page */
    .bx-grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(120px, auto); gap: 14px; max-width: 1240px; margin: 0 auto; padding: 22px 20px 90px; }
    .bx-cell { background: var(--cell); border: 1px solid var(--line); border-radius: 18px; padding: 26px; min-width: 0; }
    .bx-cell h2 { font-size: 19px; margin: 0 0 8px; letter-spacing: -0.01em; }
    .bx-cell p { margin: 0; }

    .bx-nav { grid-column: span 12; display: flex; align-items: center; gap: 26px; padding: 16px 26px; }
    .bx-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 19px; color: var(--ink); text-decoration: none; margin-right: auto; }
    .bx-logo-box { width: 22px; height: 22px; border-radius: 6px; background: linear-gradient(135deg, var(--lime), #7ddf6a); }
    .bx-nav-links { display: flex; gap: 22px; }
    .bx-nav-links a { color: var(--mut); text-decoration: none; font-size: 14px; font-weight: 500; }
    .bx-nav-links a:hover { color: var(--ink); }

    .bx-hero { grid-column: span 8; grid-row: span 2; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; background: linear-gradient(140deg, var(--cell2), var(--cell)); }
    .bx-hero-kicker { color: var(--lime); text-transform: uppercase; }
    .bx-hero-sub { color: var(--mut); font-size: 17px; line-height: 1.6; max-width: 44ch; margin: 16px 0 22px; }
    .bx-stat { grid-column: span 4; display: flex; flex-direction: column; justify-content: center; }
    .bx-today { grid-column: span 4; }
    .bx-checks { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; font-size: 14px; }
    .bx-checks li { display: flex; align-items: center; gap: 10px; color: var(--mut); }
    .bx-box { width: 18px; height: 18px; border-radius: 6px; border: 1.5px solid var(--mut); display: inline-flex; align-items: center; justify-content: center; font-size: 12px; color: #141505; flex-shrink: 0; }
    .bx-box.bx-done { background: var(--lime); border-color: var(--lime); }

    .bx-imgcell { padding: 0; overflow: hidden; grid-column: span 4; min-height: 220px; }
    .bx-imgcell img { width: 100%; height: 100%; object-fit: cover; }
    .bx-wide { grid-column: span 8; }
    .bx-wide2 { grid-column: span 7; }

    .bx-cal { grid-column: span 4; }
    .bx-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin: 12px 0; font-size: 12px; text-align: center; color: var(--mut); }
    .bx-cal-grid span { padding: 6px 0; border-radius: 8px; }
    .bx-cal-now { background: var(--lime); color: #141505; font-weight: 700; }

    .bx-pulse { grid-column: span 4; }
    .bx-dots { display: flex; gap: 8px; margin: 14px 0 10px; }
    .bx-dots span { width: 14px; height: 14px; border-radius: 50%; background: var(--line); }
    .bx-dots span.on { background: var(--lime); box-shadow: 0 0 10px rgba(200,240,74,.6); }
    .bx-pulse-line { font-size: 14px; color: var(--mut); }

    .bx-mod { grid-column: span 3; }
    .bx-mod-ico { font-size: 26px; color: var(--lime); margin-bottom: 12px; }
    .bx-mod p:last-child { color: var(--mut); font-size: 14px; margin-top: 6px; line-height: 1.55; }

    .bx-step { grid-column: span 4; }
    .bx-step .bx-mono { text-transform: uppercase; font-weight: 600; }
    .bx-step p:last-child { color: var(--mut); font-size: 14px; margin-top: 10px; line-height: 1.6; }

    .bx-price { grid-column: span 4; display: flex; flex-direction: column; align-items: flex-start; }
    .bx-price .bx-dim { font-size: 14px; line-height: 1.7; margin-bottom: 6px; }
    .bx-price-hot { background: linear-gradient(150deg, #20241a, var(--cell)); border-color: #4a522f; }

    .bx-quote { grid-column: span 8; display: flex; flex-direction: column; justify-content: center; }
    .bx-quote p { font-size: clamp(20px, 2.6vw, 28px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
    .bx-quote footer { margin-top: 14px; }

    .bx-contact { grid-column: span 5; }
    .bx-contact form { display: grid; gap: 12px; }
    .bx-contact label { display: grid; gap: 7px; font-size: 13px; font-weight: 600; color: var(--mut); }
    .bx-contact input, .bx-contact select { font-family: var(--sans); font-size: 15px; padding: 11px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); width: 100%; }
    .bx-contact input:focus, .bx-contact select:focus { outline: 2px solid var(--lime); outline-offset: 1px; }
    .bx-form-done { color: var(--lime); }

    .bx-foot { grid-column: span 5; display: flex; flex-direction: column; justify-content: center; gap: 8px; }

    @media (max-width: 900px) {
      .bx-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 14px 14px 80px; }
      .bx-nav, .bx-hero, .bx-wide, .bx-wide2, .bx-quote { grid-column: span 2 !important; }
      .bx-stat, .bx-today, .bx-imgcell, .bx-cal, .bx-pulse, .bx-mod, .bx-step, .bx-price, .bx-contact, .bx-foot { grid-column: span 1 !important; }
      .bx-nav-links { display: none; }
      .bx-hero { grid-row: auto; }
      .bx-cell { padding: 20px; border-radius: 14px; }
      .bx-mod { grid-column: span 1 !important; }
      .bx-price, .bx-step, .bx-contact { grid-column: span 2 !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      .bx * { transition: none !important; }
    }
  </style>

  <script>
    (function () {
      var form = document.getElementById('bx-form') as HTMLFormElement | null;
      var done = document.getElementById('bx-done');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        if (done) done.hidden = false;
        form?.reset();
      });
    })();
  </script>
</body>
</html>
