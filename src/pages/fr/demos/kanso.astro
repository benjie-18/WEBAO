---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Demo microsite: Kanso, fictional Japanese tea house, Montréal QC.
// Rebuilt as CEREMONY: one idea per screen, vast whitespace, a vertical meditative rhythm.
// No cards. The tea menu is a single vertical list. The visit is a quiet footer.
// Standalone art direction. Extreme restraint. Not connected to the WEBAO theme system.
const IMG = {
  hero: "/demos/kanso/01.jpg",
  philo: "https://images.unsplash.com/photo-1564890369478-c89ca6d9cde9?q=80&w=1000&auto=format&fit=crop",
  visit: "/demos/kanso/02.jpg",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="kanso" locale="fr" title="Kanso : Maison de thé japonaise à Montréal" description="Kanso : une maison de thé japonaise paisible à Montréal. Matcha de cérémonie, gyokuro et wagashi de saison. Douze places, une salle, sans hâte." ogImage="https://webao.ca/demos/kanso/01.jpg" />


</head>
<body class="ks">

  <header class="ks-nav">
    <a class="ks-logo" href="#top" aria-label="Kanso, accueil">簡 素</a>
    <nav class="ks-links" aria-label="Navigation principale">
      <a href="#menu">Thés</a>
      <a href="#visit">Nous trouver</a>
    </nav>
  </header>

  <main id="top">
    <!-- I. LE NOM -->
    <section class="ks-screen">
      <p class="ks-vertical" lang="ja" aria-hidden="true">茶</p>
      <h1 class="ks-h1">Kanso</h1>
      <p class="ks-sub">Une maison de thé paisible à Montréal.</p>
    </section>

    <!-- II. LA SALLE -->
    <figure class="ks-screen ks-media">
      <img src={IMG.hero} alt="Un salon de thé japonais serein avec tatamis, table basse et service à thé" loading="eager" fetchpriority="high" decoding="async" />
    </figure>

    <!-- III. LA SIMPLICITÉ -->
    <section class="ks-screen">
      <p class="ks-idea">Kanso veut dire simplicité.</p>
    </section>

    <!-- IV. LA PRATIQUE -->
    <section class="ks-screen">
      <p class="ks-vertical" lang="ja" aria-hidden="true">侘 寂</p>
      <p class="ks-prose">La salle compte douze places et un long comptoir en cèdre. Il n'y a ni musique, ni tableau de menu, ni hâte. L'eau est chauffée au degré exact que chaque thé demande, puis versée lentement, à la main.</p>
    </section>

    <!-- V. LE VERSEMENT -->
    <figure class="ks-screen ks-media">
      <img src={IMG.philo} alt="Une théière en céramique et une tasse de thé chaud sur un plateau en bois" loading="lazy" decoding="async" />
    </figure>

    <!-- VI. LE TEMPS -->
    <section class="ks-screen">
      <p class="ks-prose">On sert le thé comme on le sert depuis quatre cents ans : fouetté, pas pressé. La plupart des invités restent une heure. Certains restent pour la pluie. Les deux nous vont.</p>
      <p class="ks-sign">Aiko et Marc, vos hôtes</p>
    </section>

    <!-- VII. LES THÉS -->
    <section class="ks-screen ks-screen-tea" id="menu">
      <p class="ks-idea">Ce que nous versons.</p>
      <p class="ks-note">La liste suit les saisons. Ce qui est écrit ici, c'est ce que nous avons aujourd'hui.</p>
      <ul class="ks-teas">
        <li><div><h2>Gyokuro <span lang="ja">玉露</span></h2><p>Cultivé à l'ombre, brièvement étuvé. Doux, corsé, presque immobile. Servi en petite tasse, trois versements.</p></div><span class="ks-price">14 $</span></li>
        <li><div><h2>Sencha <span lang="ja">煎茶</span></h2><p>Première récolte d'Uji. Vif et végétal, avec une finale nette et courte.</p></div><span class="ks-price">9 $</span></li>
        <li><div><h2>Matcha de cérémonie <span lang="ja">抹茶</span></h2><p>Tencha moulu à la pierre, fouetté à la commande dans une eau à 70 °C. Dense, vif, silencieux.</p></div><span class="ks-price">11 $</span></li>
        <li><div><h2>Hojicha <span lang="ja">ほうじ茶</span></h2><p>Bancha torréfié. Chaud, noisette, peu de caféine. Le thé du soir.</p></div><span class="ks-price">8 $</span></li>
        <li><div><h2>Genmaicha <span lang="ja">玄米茶</span></h2><p>Sencha au riz brun grillé. Grillé et doux. Un bon premier thé.</p></div><span class="ks-price">7 $</span></li>
        <li><div><h2>Wagashi du jour <span lang="ja">和菓子</span></h2><p>Une petite douceur, faite chaque matin. Aujourd'hui : mochi au yomogi et kinako.</p></div><span class="ks-price">6 $</span></li>
      </ul>
    </section>

    <!-- VIII. LE FOUET -->
    <figure class="ks-screen ks-media">
      <img src={IMG.visit} alt="Une main fouettant le matcha avec un chasen en bambou dans un bol en céramique" loading="lazy" decoding="async" />
    </figure>

    <!-- IX. ÉCRIRE À L'AVANCE -->
    <section class="ks-screen" id="visit">
      <p class="ks-idea">Venez doucement.</p>
      <p class="ks-prose ks-prose-center">Pour les groupes de cinq et plus, ou la cérémonie du thé du dimanche, écrivez-nous à l'avance. On répond en un jour.</p>
      <form class="ks-form" id="ks-form" novalidate>
        <label>Votre nom<input type="text" name="name" required placeholder="Jeanne Tremblay" /></label>
        <label>Courriel<input type="email" name="email" required placeholder="jeanne@exemple.com" /></label>
        <label class="ks-form-wide">Quelques mots<textarea name="message" rows="3" placeholder="Cérémonie du dimanche pour six, fin octobre…"></textarea></label>
        <button class="ks-form-wide" type="submit">Envoyer</button>
        <p class="ks-form-note" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <!-- X. LE PIED DE PAGE SILENCIEUX -->
  <footer class="ks-footer">
    <p class="ks-fact">12, rue Fictive, Montréal QC</p>
    <p class="ks-fact">Mar–dim, 10 h–18 h. Fermé le lundi.</p>
    <p class="ks-fact"><a href="tel:+15145550180">(514) 555-0180</a></p>
    <p class="ks-fact">Douze places. Sans réservation bienvenus; les week-ends se remplissent avant midi.</p>
    <p class="ks-mark" lang="ja" aria-hidden="true">簡素</p>
    <p class="ks-fine">© 2026 Kanso. Démo fictive.</p>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    // Formulaire démo : ne soumet rien nulle part
    (function () {
      var form = document.getElementById('ks-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.ks-form-note');
        if (note) note.textContent = 'Merci. On vous écrit en retour en un jour.';
      });
    })();
  </script>

  <style>
    .ks {
      --ks-paper: #E9E4D8;
      --ks-ink: #1A1815;
      --ks-ink-soft: rgba(26, 24, 21, 0.62);
      --ks-rule: rgba(26, 24, 21, 0.22);
      --ks-serif: Georgia, "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", YuMincho, serif;
      margin: 0;
      background: var(--ks-paper);
      color: var(--ks-ink);
      font-family: var(--ks-serif);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .ks *, .ks *::before, .ks *::after { box-sizing: border-box; }
    .ks img { display: block; max-width: 100%; }

    .ks-nav {
      display: flex; align-items: baseline; justify-content: space-between;
      padding: 30px clamp(24px, 6vw, 64px);
      max-width: 1280px; margin: 0 auto;
    }
    .ks-logo { text-decoration: none; color: var(--ks-ink); font-size: 22px; letter-spacing: 0.5em; }
    .ks-links { display: flex; gap: clamp(20px, 4vw, 48px); }
    .ks-links a { color: var(--ks-ink-soft); text-decoration: none; font-size: 12.5px; letter-spacing: 0.32em; text-transform: uppercase; }
    .ks-links a:hover { color: var(--ks-ink); }

    /* une idée par écran */
    .ks-screen {
      min-height: 88vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 40px clamp(24px, 8vw, 80px);
    }
    .ks-media { padding: 0; }
    .ks-media img { width: 100%; height: 88vh; object-fit: cover; filter: saturate(0.92) contrast(1.03); }

    .ks-vertical { writing-mode: vertical-rl; font-size: 15px; letter-spacing: 0.6em; color: var(--ks-ink-soft); margin: 0 0 44px; }
    .ks-h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); font-weight: 400; letter-spacing: 0.28em; text-indent: 0.28em; margin: 0 0 20px; }
    .ks-sub { font-size: 15px; color: var(--ks-ink-soft); letter-spacing: 0.12em; margin: 0; font-style: italic; }
    .ks-idea { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 400; letter-spacing: 0.08em; margin: 0 0 26px; }
    .ks-prose { font-size: 17px; line-height: 2.1; color: var(--ks-ink-soft); margin: 0; max-width: 52ch; }
    .ks-prose-center { text-align: center; }
    .ks-sign { font-style: italic; color: var(--ks-ink); font-size: 15px; margin: 40px 0 0; }
    .ks-note { font-size: 14px; font-style: italic; color: var(--ks-ink-soft); margin: 0 0 60px; }

    /* la liste des thés */
    .ks-screen-tea { min-height: 0; padding-top: 14vh; padding-bottom: 14vh; text-align: left; align-items: stretch; max-width: 760px; margin: 0 auto; }
    .ks-screen-tea .ks-idea, .ks-screen-tea .ks-note { text-align: center; }
    .ks-teas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ks-rule); width: 100%; }
    .ks-teas li { display: flex; justify-content: space-between; gap: 30px; align-items: baseline; padding: 34px 4px; border-bottom: 1px solid var(--ks-rule); }
    .ks-teas h2 { margin: 0 0 10px; font-size: 21px; font-weight: 400; letter-spacing: 0.08em; }
    .ks-teas h2 span { font-size: 15px; color: var(--ks-ink-soft); letter-spacing: 0.3em; margin-left: 12px; }
    .ks-teas p { margin: 0; font-size: 14.5px; line-height: 1.9; color: var(--ks-ink-soft); max-width: 52ch; }
    .ks-price { font-size: 17px; letter-spacing: 0.06em; white-space: nowrap; }

    /* le formulaire */
    #visit .ks-prose { margin-bottom: 60px; }
    .ks-form { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; width: 100%; max-width: 640px; margin: 0 auto; text-align: left; }
    .ks-form-wide { grid-column: 1 / -1; }
    .ks-form label { display: grid; gap: 10px; font-size: 11.5px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ks-ink-soft); }
    .ks-form input, .ks-form textarea {
      font-family: var(--ks-serif); font-size: 15.5px; letter-spacing: 0.03em;
      background: transparent; border: 0; border-bottom: 1px solid var(--ks-rule);
      padding: 10px 2px; color: var(--ks-ink); width: 100%; border-radius: 0;
    }
    .ks-form input:focus, .ks-form textarea:focus { outline: none; border-bottom-color: var(--ks-ink); }
    .ks-form button {
      font-family: var(--ks-serif); font-size: 13px; letter-spacing: 0.34em; text-transform: uppercase;
      background: transparent; color: var(--ks-ink); border: 1px solid var(--ks-ink);
      padding: 18px; cursor: pointer; transition: background 0.2s ease, color 0.2s ease;
      justify-self: center; min-width: 240px;
    }
    .ks-form button:hover { background: var(--ks-ink); color: var(--ks-paper); }
    .ks-form-note { grid-column: 1 / -1; margin: 0; text-align: center; font-style: italic; font-size: 14.5px; color: var(--ks-ink-soft); }
    .ks-form-note:empty { display: none; }

    /* pied de page silencieux */
    .ks-footer { padding: 16vh 24px 12vh; text-align: center; border-top: 1px solid var(--ks-rule); }
    .ks-fact { margin: 10px 0; font-size: 14px; letter-spacing: 0.18em; color: var(--ks-ink-soft); }
    .ks-fact a { color: var(--ks-ink); }
    .ks-mark { font-size: 24px; letter-spacing: 0.6em; text-indent: 0.6em; margin: 44px 0 30px; color: var(--ks-ink-soft); }
    .ks-fine { font-size: 12px; letter-spacing: 0.22em; color: var(--ks-ink-soft); margin: 0; }

    @media (max-width: 620px) {
      .ks-nav { flex-direction: column; gap: 18px; align-items: center; }
      .ks-screen { min-height: 80vh; }
      .ks-form { grid-template-columns: 1fr; }
      .ks-form button { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ks-form button { transition: none; }
    }
  </style>
</body>
</html>
