---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Demo microsite: Pixelforge Games, fictional indie game studio, Montreal.
// Standalone art direction. 8-bit pixel art, CRT scanlines, chunky buttons.
// Not connected to the WEBAO theme system.
const IMG = {
  hero: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=1600&auto=format&fit=crop",
  game1: "/demos/pixelforge/02.jpg",
  game2: "/demos/pixelforge/01.jpg",
  game3: "/demos/pixelforge/04.png",
  game4: "/demos/pixelforge/03.jpg",
  studio: "https://images.unsplash.com/photo-1556438064-2d7646166914?q=80&w=1000&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pixelforge Games : jeux indé, pixels au max</title>
  <meta name="description" content="Pixelforge Games : studio indé fictif à Montréal. 14 petits jeux, 2 millions de joueurs, zéro polygone blessé. Appuie sur start." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
</head>
<body class="pf">

  <!-- CRT overlay -->
  <div class="pf-scan" aria-hidden="true"></div>

  <!-- NAV -->
  <header class="pf-navwrap">
    <nav class="pf-nav" aria-label="Principal">
      <a class="pf-logo" href="#top" aria-label="Pixelforge Games, accueil"><span class="pf-logo-fx">PIXELFORGE</span></a>
      <div class="pf-nav-links">
        <a href="#games">Jeux</a>
        <a href="#scores">Scores</a>
        <a href="#devlog">Journal</a>
        <a href="#contact">Contact</a>
      </div>
      <a class="pf-btn pf-btn-small" href="#games">Jouer</a>
      <button class="pf-burger" id="pf-burger" aria-expanded="false" aria-controls="pf-mobilemenu" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="pf-mobilemenu" id="pf-mobilemenu">
      <a href="#games">Jeux</a>
      <a href="#scores">Scores</a>
      <a href="#devlog">Journal</a>
      <a href="#contact">Contact</a>
      <a class="pf-btn" href="#games">Jouer</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="pf-hero">
      <div class="pf-hero-bg" aria-hidden="true"><img src={IMG.hero} alt="" loading="eager" fetchpriority="high" /></div>
      <div class="pf-pixels" aria-hidden="true">
        <span class="pf-pxl p1"></span><span class="pf-pxl p2"></span><span class="pf-pxl p3"></span>
        <span class="pf-pxl p4"></span><span class="pf-pxl p5"></span><span class="pf-pxl p6"></span>
      </div>
      <div class="pf-hero-in">
        <svg class="pf-invader" viewBox="0 0 11 8" shape-rendering="crispEdges" aria-hidden="true">
          <rect x="2" y="0" width="1" height="1"/><rect x="8" y="0" width="1" height="1"/>
          <rect x="3" y="1" width="1" height="1"/><rect x="7" y="1" width="1" height="1"/>
          <rect x="2" y="2" width="7" height="1"/>
          <rect x="1" y="3" width="2" height="1"/><rect x="4" y="3" width="3" height="1"/><rect x="8" y="3" width="2" height="1"/>
          <rect x="0" y="4" width="11" height="1"/>
          <rect x="0" y="5" width="1" height="1"/><rect x="2" y="5" width="7" height="1"/><rect x="10" y="5" width="1" height="1"/>
          <rect x="0" y="6" width="1" height="1"/><rect x="2" y="6" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/><rect x="10" y="6" width="1" height="1"/>
          <rect x="3" y="7" width="2" height="1"/><rect x="6" y="7" width="2" height="1"/>
        </svg>
        <p class="pf-eyebrow">1UP · DEPUIS 2017 · MONTRÉAL, QC</p>
        <h1 class="pf-h1">PIXEL<br />FORGE</h1>
        <p class="pf-lede">Jeux indé, pixels au max. Petite équipe, gros sprites, et des boss qui se défendent. Zéro polygone blessé.</p>
        <div class="pf-hpbar" aria-label="Niveau de hype : 100 sur 100">
          <span class="pf-hp-label">HYPE</span>
          <span class="pf-hp-track"><span class="pf-hp-fill"></span></span>
          <span class="pf-hp-num">100/100</span>
        </div>
        <a class="pf-press" href="#games"><span class="pf-blink">▶ APPUIE SUR START</span></a>
      </div>
      <div class="pf-ticker" aria-hidden="true">
        <div class="pf-ticker-track">
          <span>INSÈRE UNE PIÈCE</span><span>◆</span><span>SANS CONTINUE</span><span>◆</span><span>BOSS DU VENDREDI</span><span>◆</span><span>PIXELS &gt; POLYGONES</span><span>◆</span>
          <span>INSÈRE UNE PIÈCE</span><span>◆</span><span>SANS CONTINUE</span><span>◆</span><span>BOSS DU VENDREDI</span><span>◆</span><span>PIXELS &gt; POLYGONES</span><span>◆</span>
        </div>
      </div>
    </section>

    <!-- GAMES -->
    <section class="pf-section" id="games">
      <div class="pf-wrap">
        <p class="pf-kicker">&gt;_ choisis ta quête</p>
        <h2 class="pf-h2">NOS JEUX</h2>
        <p class="pf-sub">Quatre cartouches. Essais infinis. Choisis ton poison, joueur un.</p>
        <div class="pf-carts">
          <article class="pf-cart">
            <div class="pf-cart-grip" aria-hidden="true"></div>
            <div class="pf-cart-art"><img src={IMG.game1} alt="Jaquette de Duskfall Valley, coucher de soleil pixel sur montagnes et lac" loading="lazy" /></div>
            <div class="pf-cart-body">
              <h3>DUSKFALL VALLEY</h3>
              <p class="pf-genre">EXPLORATION · SOLO</p>
              <p>Explorez 40 vallées dessinées pixel par pixel à l'heure dorée. Aucun ennemi, que des ondes.</p>
              <a class="pf-btn pf-btn-small" href="#coin">Insère une pièce</a>
            </div>
          </article>
          <article class="pf-cart">
            <div class="pf-cart-grip" aria-hidden="true"></div>
            <div class="pf-cart-art"><img src={IMG.game2} alt="Jaquette de Dungeon Delver, combat de donjon en pixel art" loading="lazy" /></div>
            <div class="pf-cart-body">
              <h3>DUNGEON DELVER</h3>
              <p class="pf-genre">ROGUELIKE · SOLO</p>
              <p>99 étages générés au hasard. Apporte une torche. Et une torche de rechange.</p>
              <a class="pf-btn pf-btn-small" href="#coin">Insère une pièce</a>
            </div>
          </article>
          <article class="pf-cart">
            <div class="pf-cart-grip" aria-hidden="true"></div>
            <div class="pf-cart-art"><img src={IMG.game3} alt="Jaquette de Meadow Tactics, combat RPG pixel vu du dessus avec HUD" loading="lazy" /></div>
            <div class="pf-cart-body">
              <h3>MEADOW TACTICS</h3>
              <p class="pf-genre">RPG TACTIQUE · 1-4 JOUEURS</p>
              <p>Des batailles au tour par tour dans une prairie dessinée à la main. Réfléchis vite, clique plus vite.</p>
              <a class="pf-btn pf-btn-small" href="#coin">Insère une pièce</a>
            </div>
          </article>
          <article class="pf-cart">
            <div class="pf-cart-grip" aria-hidden="true"></div>
            <div class="pf-cart-art"><img src={IMG.game4} alt="Jaquette de Blade Pixel, sprite d'épéiste en pixel art" loading="lazy" /></div>
            <div class="pf-cart-body">
              <h3>BLADE PIXEL</h3>
              <p class="pf-genre">ACTION · COOP</p>
              <p>Une épée, 90 donjons, zéro pitié. Et le pouvoir de l'amitié (plus le double saut).</p>
              <a class="pf-btn pf-btn-small" href="#coin">Insère une pièce</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- HIGH SCORES -->
    <section class="pf-scores" id="scores">
      <div class="pf-wrap">
        <p class="pf-kicker">&gt;_ panthéon</p>
        <h2 class="pf-h2">MEILLEURS SCORES</h2>
        <div class="pf-score-grid">
          <div class="pf-score-box">
            <h3>MEILLEURS JOUEURS</h3>
            <ol class="pf-board">
              <li><span class="pf-rank">1ER</span><span class="pf-name">AAA</span><span class="pf-pts">9 999 990</span></li>
              <li><span class="pf-rank">2E</span><span class="pf-name">PIX3L</span><span class="pf-pts">8 420 100</span></li>
              <li><span class="pf-rank">3E</span><span class="pf-name">NYB</span><span class="pf-pts">7 777 777</span></li>
              <li><span class="pf-rank">4E</span><span class="pf-name">G4M3R</span><span class="pf-pts">6 543 210</span></li>
              <li><span class="pf-rank">5E</span><span class="pf-name">TOI ?</span><span class="pf-pts">0</span></li>
            </ol>
          </div>
          <div class="pf-stat-box">
            <h3>STATS DU STUDIO</h3>
            <ul class="pf-stats">
              <li><strong>2 M+</strong><span>joueurs dans le monde</span></li>
              <li><strong>14</strong><span>jeux publiés</span></li>
              <li><strong>97 %</strong><span>d'avis positifs</span></li>
              <li><strong>∞</strong><span>tasses de café</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DEVLOG -->
    <section class="pf-section" id="devlog">
      <div class="pf-wrap">
        <p class="pf-kicker">&gt;_ transmission de la forge</p>
        <h2 class="pf-h2">JOURNAL DE DEV</h2>
        <div class="pf-logs">
          <article class="pf-dialog">
            <p class="pf-dialog-head">2026-09-28 :: BOSS Nº 3</p>
            <p>&gt; Le boss nº 3 est enfin battable. Probablement. Notre testeur a pleuré deux fois, ce qu'on choisit d'interpréter comme bon signe.</p>
          </article>
          <article class="pf-dialog">
            <p class="pf-dialog-head">2026-09-12 :: DLC BLOB QUEST</p>
            <p>&gt; Le blob peut maintenant porter des chapeaux. 40 chapeaux. Trois semaines de travail. Zéro regret. Les chapeaux sortent vendredi.</p>
          </article>
          <article class="pf-dialog">
            <div class="pf-dialog-img"><img src={IMG.studio} alt="L'équipe Pixelforge en séance de test" loading="lazy" /></div>
            <p class="pf-dialog-head">2026-08-30 :: SOIRÉE DE TEST</p>
            <p>&gt; 60 joueurs, 12 pizzas, une manette brisée (RIP). Starfall Tactics a survécu au contact avec de vrais humains. De justesse.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- NEWSLETTER -->
    <section class="pf-coin" id="coin">
      <div class="pf-wrap pf-coin-in">
        <div>
          <p class="pf-kicker pf-kicker-dark">&gt;_ 25 cents bien investis</p>
          <h2 class="pf-h2 pf-h2-dark">INSÈRE<br />UNE PIÈCE</h2>
          <p class="pf-coin-copy">Un courriel par mois. Notes de version, niveaux secrets, zéro spam. Désabonne-toi et on fera comme si tu n'avais jamais existé.</p>
        </div>
        <form class="pf-form" id="pf-coin-form" novalidate>
          <div class="pf-slot" aria-hidden="true"><span></span></div>
          <label>Courriel du joueur<input type="email" name="email" required placeholder="joueur1@example.com" /></label>
          <button class="pf-btn pf-btn-mag" type="submit">+1UP</button>
          <p class="pf-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="pf-section" id="contact">
      <div class="pf-wrap">
        <p class="pf-kicker">&gt;_ point de sauvegarde</p>
        <h2 class="pf-h2">CONTACT</h2>
        <div class="pf-contact-grid">
          <div class="pf-dialog pf-contact-box">
            <p class="pf-dialog-head">L'ARCADE</p>
            <p>404, allée Pixel, bureau 8B<br />Montréal, QC H2X 1Y2<br />Ouvert en semaine, 9 h à 18 h</p>
          </div>
          <div class="pf-dialog pf-contact-box">
            <p class="pf-dialog-head">TRANSMETS UN MESSAGE</p>
            <p>Presse et joueurs :<br /><a href="mailto:presse@pixelforge.games">presse@pixelforge.games</a><br /><a href="tel:+15145550188">(514) 555-0188</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="pf-footer">
    <p class="pf-footer-giant" aria-hidden="true">PARTIE TERMINÉE ?<br />JAMAIS.</p>
    <div class="pf-wrap pf-footer-in">
      <p>© 2026 Pixelforge Games. Démo fictive. Aucun pixel n'a été blessé.</p>
      <p>404, allée Pixel, Montréal QC · <a href="tel:+15145550188">(514) 555-0188</a> · <a href="mailto:presse@pixelforge.games">presse@pixelforge.games</a></p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    // Demo: mobile menu + form never submits anywhere
    (function () {
      var burger = document.getElementById('pf-burger');
      var menu = document.getElementById('pf-mobilemenu');
      burger?.addEventListener('click', function () {
        var open = menu?.classList.toggle('pf-open');
        burger?.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      });
      menu?.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          menu?.classList.remove('pf-open');
          burger?.setAttribute('aria-expanded', 'false');
        });
      });
      var form = document.getElementById('pf-coin-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.pf-form-note');
        if (note) note.textContent = 'PIÈCE ACCEPTÉE ! +1UP. Vérifie ta boîte courriel, joueur 1.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .pf {
      --pf-navy: #0F0F23;
      --pf-panel: #171733;
      --pf-green: #7CFF6B;
      --pf-mag: #FF6BD6;
      --pf-yel: #FFE45E;
      --pf-white: #EDEDF7;
      --pf-dim: #9a9ac0;
      --pf-display: "Press Start 2P", monospace;
      --pf-body: "VT323", monospace;
      margin: 0;
      background: var(--pf-navy);
      color: var(--pf-white);
      font-family: var(--pf-body);
      font-size: 21px;
      line-height: 1.45;
      overflow-x: clip;
    }
    .pf *, .pf *::before, .pf *::after { box-sizing: border-box; }
    .pf img { display: block; max-width: 100%; image-rendering: pixelated; }
    .pf-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }

    /* CRT scanlines */
    .pf-scan {
      position: fixed; inset: 0; z-index: 90; pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 2px, transparent 2px 4px);
    }
    .pf-scan::after {
      content: ""; position: absolute; inset: 0;
      background: radial-gradient(ellipse 120% 100% at 50% 50%, transparent 60%, rgba(0, 0, 0, 0.45) 100%);
    }

    /* nav */
    .pf-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 80; }
    .pf-nav {
      display: flex; align-items: center; gap: 20px;
      padding: 14px clamp(20px, 4vw, 40px);
      background: rgba(15, 15, 35, 0.94);
      border-bottom: 4px solid var(--pf-green);
    }
    .pf-logo { text-decoration: none; margin-right: auto; }
    .pf-logo-fx { font-family: var(--pf-display); font-size: 15px; color: var(--pf-green); text-shadow: 3px 3px 0 #1d5c1d, 0 0 18px rgba(124, 255, 107, 0.6); }
    .pf-nav-links { display: flex; gap: 2px; }
    .pf-nav-links a {
      font-family: var(--pf-display); font-size: 10px; color: var(--pf-dim);
      text-decoration: none; padding: 12px 14px;
    }
    .pf-nav-links a:hover { color: var(--pf-yel); }
    .pf-burger { display: none; background: none; border: none; cursor: pointer; padding: 10px; flex-direction: column; gap: 5px; }
    .pf-burger span { display: block; width: 26px; height: 4px; background: var(--pf-green); }
    .pf-mobilemenu {
      display: none; flex-direction: column; gap: 2px;
      background: rgba(15, 15, 35, 0.98); border-bottom: 4px solid var(--pf-green);
      padding: 12px clamp(20px, 4vw, 40px) 22px;
    }
    .pf-mobilemenu.pf-open { display: flex; }
    .pf-mobilemenu a:not(.pf-btn) { font-family: var(--pf-display); font-size: 11px; color: var(--pf-white); text-decoration: none; padding: 13px 4px; }

    /* chunky pixel buttons */
    .pf-btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--pf-display); font-size: 12px;
      background: var(--pf-green); color: #0F0F23; text-decoration: none; cursor: pointer; border: none;
      padding: 15px 22px;
      box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.28), inset 4px 4px 0 rgba(255, 255, 255, 0.35), 0 6px 0 #1d5c1d;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .pf-btn:hover { transform: translateY(2px); box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.28), inset 4px 4px 0 rgba(255, 255, 255, 0.35), 0 4px 0 #1d5c1d; }
    .pf-btn:active { transform: translateY(6px); box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.28), inset 4px 4px 0 rgba(255, 255, 255, 0.35), 0 0 0 #1d5c1d; }
    .pf-btn-mag { background: var(--pf-mag); box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.28), inset 4px 4px 0 rgba(255, 255, 255, 0.35), 0 6px 0 #7c1d5c; width: 100%; }
    .pf-btn-mag:hover { box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.28), inset 4px 4px 0 rgba(255, 255, 255, 0.35), 0 4px 0 #7c1d5c; }
    .pf-btn-small { font-size: 10px; padding: 13px 18px; }

    /* type */
    .pf-kicker { font-family: var(--pf-display); font-size: 11px; color: var(--pf-green); margin: 0 0 18px; letter-spacing: 0.04em; }
    .pf-kicker-dark { color: #7c5c1d; }
    .pf-h2 { font-family: var(--pf-display); font-size: clamp(1.4rem, 4.5vw, 2.4rem); color: var(--pf-yel); text-shadow: 4px 4px 0 #7c5c1d; margin: 0 0 16px; line-height: 1.35; }
    .pf-h2-dark { color: var(--pf-navy); text-shadow: 4px 4px 0 rgba(15, 15, 35, 0.25); }
    .pf-sub { color: var(--pf-dim); font-size: 23px; margin: 0 0 42px; max-width: 52ch; }
    .pf-eyebrow { font-family: var(--pf-display); font-size: 10px; letter-spacing: 0.2em; color: var(--pf-mag); margin: 0 0 20px; }

    /* hero */
    .pf-hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
    .pf-hero-bg { position: absolute; inset: 0; }
    .pf-hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.35) saturate(1.3); }
    .pf-hero-bg::after { content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(15,15,35,0.6), rgba(15,15,35,0.15) 45%, rgba(15,15,35,0.95)); }
    .pf-pixels { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
    .pf-pxl { position: absolute; width: 10px; height: 10px; animation: pf-rise 6s linear infinite; }
    .pf-pxl.p1 { left: 12%; bottom: -20px; background: var(--pf-green); }
    .pf-pxl.p2 { left: 28%; bottom: -20px; background: var(--pf-mag); animation-delay: 1.2s; }
    .pf-pxl.p3 { left: 55%; bottom: -20px; background: var(--pf-yel); animation-delay: 2.4s; }
    .pf-pxl.p4 { left: 72%; bottom: -20px; background: var(--pf-green); animation-delay: 3.1s; }
    .pf-pxl.p5 { left: 88%; bottom: -20px; background: var(--pf-mag); animation-delay: 4s; }
    .pf-pxl.p6 { left: 42%; bottom: -20px; background: var(--pf-yel); animation-delay: 5s; }
    @keyframes pf-rise { to { transform: translateY(-110vh); } }
    .pf-hero-in { position: relative; z-index: 2; max-width: 1180px; width: 100%; margin: 0 auto; padding: 130px clamp(20px, 4vw, 40px) 36px; text-align: center; }
    .pf-invader { width: 110px; fill: var(--pf-green); margin: 0 auto 26px; filter: drop-shadow(0 0 14px rgba(124, 255, 107, 0.7)); animation: pf-hover 3s ease-in-out infinite; }
    @keyframes pf-hover { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
    .pf-h1 {
      font-family: var(--pf-display); font-size: clamp(2.2rem, 10vw, 6.5rem); line-height: 1.15; margin: 0 0 22px;
      color: var(--pf-green); text-shadow: 5px 5px 0 #1d5c1d, 0 0 34px rgba(124, 255, 107, 0.55);
    }
    .pf-lede { font-size: 25px; color: var(--pf-white); max-width: 40ch; margin: 0 auto 28px; }
    .pf-hpbar { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 0 0 30px; font-family: var(--pf-display); font-size: 10px; }
    .pf-hp-label { color: var(--pf-yel); }
    .pf-hp-track { width: min(320px, 50vw); height: 22px; background: #2a0f1e; border: 3px solid var(--pf-mag); }
    .pf-hp-fill { display: block; height: 100%; width: 100%;
      background: repeating-linear-gradient(90deg, var(--pf-green) 0 8px, #5ce04c 8px 16px);
      animation: pf-shimmer 2s linear infinite; }
    @keyframes pf-shimmer { to { background-position: 32px 0; } }
    .pf-hp-num { color: var(--pf-white); }
    .pf-press { display: inline-block; font-family: var(--pf-display); font-size: clamp(0.9rem, 3vw, 1.3rem); color: var(--pf-yel);
      text-decoration: none; text-shadow: 3px 3px 0 #7c5c1d; padding: 18px 26px; border: 4px solid var(--pf-yel); background: rgba(15,15,35,0.7); }
    .pf-blink { animation: pf-blink 1.1s steps(1) infinite; }
    @keyframes pf-blink { 50% { opacity: 0; } }
    .pf-ticker { position: relative; z-index: 2; background: var(--pf-green); color: #0F0F23; overflow: hidden; padding: 11px 0; border-block: 4px solid #0F0F23; }
    .pf-ticker-track { display: flex; gap: 26px; width: max-content; animation: pf-tick 16s linear infinite; font-family: var(--pf-display); font-size: 13px; white-space: nowrap; }
    @keyframes pf-tick { to { transform: translateX(-50%); } }

    /* sections */
    .pf-section { padding: clamp(70px, 9vw, 120px) 0; }

    /* cartridges */
    .pf-carts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
    .pf-cart {
      background: var(--pf-panel); margin: 4px;
      box-shadow: 0 -4px 0 0 var(--pf-mag), 0 4px 0 0 var(--pf-mag), -4px 0 0 0 var(--pf-mag), 4px 0 0 0 var(--pf-mag);
      transition: transform 0.15s ease;
      display: flex; flex-direction: column;
    }
    .pf-cart:nth-child(2) { box-shadow: 0 -4px 0 0 var(--pf-yel), 0 4px 0 0 var(--pf-yel), -4px 0 0 0 var(--pf-yel), 4px 0 0 0 var(--pf-yel); }
    .pf-cart:nth-child(3) { box-shadow: 0 -4px 0 0 var(--pf-green), 0 4px 0 0 var(--pf-green), -4px 0 0 0 var(--pf-green), 4px 0 0 0 var(--pf-green); }
    .pf-cart:nth-child(4) { box-shadow: 0 -4px 0 0 #87CEFA, 0 4px 0 0 #87CEFA, -4px 0 0 0 #87CEFA, 4px 0 0 0 #87CEFA; }
    .pf-cart:hover { transform: translateY(-8px); }
    .pf-cart-grip { height: 26px; background: repeating-linear-gradient(90deg, #0F0F23 0 12px, transparent 12px 24px); border-bottom: 4px solid #0F0F23; }
    .pf-cart-art img { width: 100%; height: 170px; object-fit: cover; filter: saturate(1.3) contrast(1.05); border-bottom: 4px solid #0F0F23; image-rendering: pixelated; }
    .pf-cart-body { padding: 22px 20px 26px; display: grid; gap: 10px; flex: 1; }
    .pf-cart-body h3 { font-family: var(--pf-display); font-size: 13px; color: var(--pf-white); margin: 0; line-height: 1.6; }
    .pf-genre { font-family: var(--pf-display); font-size: 9px; color: var(--pf-yel); margin: 0; letter-spacing: 0.06em; }
    .pf-cart-body p { margin: 0; color: var(--pf-dim); font-size: 20px; }
    .pf-cart-body .pf-btn { margin-top: 8px; justify-self: start; }

    /* scores */
    .pf-scores { background: #0b0b1a; border-block: 4px solid var(--pf-green); padding: clamp(70px, 9vw, 120px) 0; }
    .pf-score-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 30px; }
    .pf-score-box, .pf-stat-box { background: var(--pf-panel); padding: 30px; margin: 4px;
      box-shadow: 0 -4px 0 0 var(--pf-green), 0 4px 0 0 var(--pf-green), -4px 0 0 0 var(--pf-green), 4px 0 0 0 var(--pf-green); }
    .pf-score-box h3, .pf-stat-box h3 { font-family: var(--pf-display); font-size: 13px; color: var(--pf-yel); margin: 0 0 22px; }
    .pf-board { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .pf-board li { display: grid; grid-template-columns: 64px 1fr auto; gap: 12px; align-items: center; font-size: 23px; padding: 10px 12px; background: rgba(15, 15, 35, 0.6); }
    .pf-board li:first-child { background: rgba(255, 228, 94, 0.12); border: 2px solid var(--pf-yel); }
    .pf-rank { font-family: var(--pf-display); font-size: 10px; color: var(--pf-mag); }
    .pf-name { color: var(--pf-white); letter-spacing: 0.1em; }
    .pf-pts { color: var(--pf-green); font-variant-numeric: tabular-nums; }
    .pf-stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .pf-stats li { display: grid; gap: 4px; text-align: center; padding: 18px 8px; background: rgba(15, 15, 35, 0.6); }
    .pf-stats strong { font-family: var(--pf-display); font-size: 20px; color: var(--pf-mag); }
    .pf-stats span { font-size: 19px; color: var(--pf-dim); }

    /* devlog dialog boxes */
    .pf-logs { display: grid; gap: 26px; max-width: 860px; }
    .pf-dialog {
      background: #0b0b1a; border: 4px solid var(--pf-green); padding: 26px 28px; margin: 4px;
      box-shadow: 8px 8px 0 rgba(124, 255, 107, 0.18);
    }
    .pf-dialog-head { font-family: var(--pf-display); font-size: 10px; color: var(--pf-yel); margin: 0 0 14px; letter-spacing: 0.06em; }
    .pf-dialog p { margin: 0; font-size: 22px; color: var(--pf-white); }
    .pf-dialog-img { margin: 0 0 18px; border: 4px solid #0F0F23; }
    .pf-dialog-img img { width: 100%; height: 260px; object-fit: cover; }

    /* coin newsletter */
    .pf-coin { background: var(--pf-yel); padding: clamp(70px, 9vw, 120px) 0; }
    .pf-coin-in { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
    .pf-coin-copy { font-size: 23px; color: #4d3d10; max-width: 40ch; margin: 0; }
    .pf-form { background: var(--pf-navy); padding: clamp(28px, 4vw, 40px); display: grid; gap: 18px; margin: 4px;
      box-shadow: 0 -4px 0 0 var(--pf-navy), 0 4px 0 0 var(--pf-navy), -4px 0 0 0 var(--pf-navy), 4px 0 0 0 var(--pf-navy), 12px 12px 0 rgba(15, 15, 35, 0.25); }
    .pf-slot { display: flex; justify-content: center; }
    .pf-slot span { display: block; width: 90px; height: 14px; background: #0b0b1a; border: 3px solid var(--pf-mag); }
    .pf-form label { display: grid; gap: 10px; font-family: var(--pf-display); font-size: 10px; color: var(--pf-green); letter-spacing: 0.08em; }
    .pf-form input {
      font-family: var(--pf-body); font-size: 23px;
      background: #0b0b1a; border: 3px solid var(--pf-panel); color: var(--pf-white);
      padding: 13px 16px; width: 100%;
    }
    .pf-form input:focus { outline: none; border-color: var(--pf-yel); }
    .pf-form-note { margin: 0; color: var(--pf-yel); font-size: 22px; }
    .pf-form-note:empty { display: none; }

    /* contact */
    .pf-contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; max-width: 960px; }
    .pf-contact-box p { font-size: 23px; }
    .pf-contact-box a { color: var(--pf-yel); }

    /* footer */
    .pf-footer { padding: 80px 0 90px; text-align: center; border-top: 4px solid var(--pf-mag); overflow: hidden; }
    .pf-footer-giant { font-family: var(--pf-display); font-size: clamp(1.4rem, 7vw, 4rem); line-height: 1.5; margin: 0 0 30px;
      color: var(--pf-mag); text-shadow: 4px 4px 0 #7c1d5c, 0 0 30px rgba(255, 107, 214, 0.4); }
    .pf-footer-in { display: grid; gap: 10px; color: var(--pf-dim); font-size: 20px; }
    .pf-footer-in p { margin: 0; }
    .pf-footer-in a { color: var(--pf-green); }

    @media (max-width: 1020px) {
      .pf-carts { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 860px) {
      .pf-nav-links, .pf-nav > .pf-btn { display: none; }
      .pf-burger { display: flex; }
      .pf-score-grid { grid-template-columns: 1fr; }
      .pf-coin-in { grid-template-columns: 1fr; }
      .pf-contact-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .pf-carts { grid-template-columns: 1fr; max-width: 400px; margin-inline: auto; }
      .pf-board li { grid-template-columns: 52px 1fr auto; font-size: 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pf-ticker-track, .pf-pxl, .pf-invader, .pf-blink, .pf-hp-fill { animation: none; }
      .pf-blink { opacity: 1; }
      .pf-btn, .pf-cart { transition: none; }
    }
  </style>
</body>
</html>
