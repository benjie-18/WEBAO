              <div class="ls-wm-row"><span>Nouage + perte</span><b>1.2 m</b></div>
              <div class="ls-wm-row"><span>Chaîne totale</span><b id="wm-total">7.2 m</b></div>
              <div class="ls-wm-row"><span>Fil requis</span><b id="wm-kg">≈ 1.44 kg</b></div>
