  <EscapeHatch locale="fr" />

  <script>
    (function () {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ——— state ————————————————————————————————— */
      const state = {
        warp: "#24314f",
        weft: "#d3c2a0",
        pat: "twill",
        epi: 24,
        tension: "working" as "slack" | "working" | "bridge",
      };
      const draft: number[][] = [];
      const DRAFT_DEFAULT = function (r: number, c: number) { return ((((c - r) % 4) + 4) % 4) < 2 ? 1 : 0; };
      for (let r = 0; r < 8; r++) { draft.push([]); for (let c = 0; c < 8; c++) { draft[r].push(DRAFT_DEFAULT(r, c)); } }

      const PAT_NAMES: Record<string, string> = { plain: "toile", twill: "sergé 2/2", herringbone: "chevrons", overshot: "dérobé", custom: "pointage perso" };
      const PAT_FACTOR: Record<string, number> = { plain: 1, twill: 1.1, herringbone: 1.15, overshot: 1.55, custom: 1.3 };
      const shade = function (hex: string, amt: number) {
        const n = parseInt(hex.slice(1), 16);
        const r = Math.min(255, Math.max(0, (n >> 16) + amt));
        const g = Math.min(255, Math.max(0, ((n >> 8) & 255) + amt));
        const b = Math.min(255, Math.max(0, (n & 255) + amt));
        return "rgb(" + r + "," + g + "," + b + ")";
      };

      /* ——— weave renderer ————————————————————————— */
      const warpTop = function (i: number, j: number) {
        switch (state.pat) {
          case "plain": return (i + j) % 2 === 0;
          case "twill": return ((((i - j) % 4) + 4) % 4) < 2;
          case "herringbone": {
            const dir = Math.floor(i / 10) % 2;
            const x = dir === 0 ? (i - j) : (i + j);
            return ((x % 4) + 4) % 4 < 2;
          }
          case "overshot": {
            if (j % 4 === 0 || j % 4 === 2) return (i + j / 2) % 2 === 0; // tabby ground alternates each tabby pick
            return i % 4 === 2; // pattern floats: over 3, under 1
          }
          default: return draft[j % 8][i % 8] === 1; // custom: raised harness = warp floats on top
        }
      };

      const cloth = document.getElementById("ls-cloth") as HTMLCanvasElement | null;
      const cctx = cloth ? cloth.getContext("2d") : null;
      const clothSize = { w: 720, h: 480 };
      const TEN_GAP: Record<string, number> = { slack: 0.34, working: 0.2, bridge: 0.1 };

      const sizeCloth = function () {
        if (!cloth || !cctx) return;
        const rect = cloth.getBoundingClientRect();
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        clothSize.w = Math.max(240, Math.round(rect.width));
        clothSize.h = Math.max(200, Math.round(rect.height));
        cloth.width = Math.round(clothSize.w * dpr);
        cloth.height = Math.round(clothSize.h * dpr);
        cctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      let weaveRaf = 0;
      const drawCloth = function (progress: number) {
        if (!cctx) return;
        const ctx = cctx;
        const W = clothSize.w; const H = clothSize.h;
        ctx.fillStyle = "#17171b";
        ctx.fillRect(0, 0, W, H);
        const ends = Math.max(24, Math.round(6 * state.epi)); // 6-inch sample
        const cw = W / ends;
        const gap = TEN_GAP[state.tension];
        const tw = Math.max(1.5, cw * (1 - gap));
        const rows = Math.max(24, Math.round(H / cw));
        const ch = H / rows;
        const weftTop = state.weft;
        const warpCol = state.warp;
        const tabby = "#d3c2a0";
        const fell = Math.max(1, Math.floor(rows * progress));

        for (let j = 0; j < fell; j++) {
          const y = j * ch;
          for (let i = 0; i < ends; i++) {
            const x = i * cw;
            const up = warpTop(i, j);
            if (up) {
              // warp thread floating: vertical cylinder
              ctx.fillStyle = warpCol;
              ctx.fillRect(x + (cw - tw) / 2, y - 0.5, tw, ch + 1);
              ctx.fillStyle = shade(warpCol, 34);
              ctx.fillRect(x + (cw - tw) / 2, y - 0.5, Math.max(1, tw * 0.3), ch + 1);
              ctx.fillStyle = "rgba(0,0,0,0.28)";
              ctx.fillRect(x + (cw - tw) / 2 + tw - 1, y - 0.5, 1, ch + 1);
            } else {
              // weft passing: horizontal cylinder
              let col = weftTop;
              if (state.pat === "overshot" && (j % 4 === 0 || j % 4 === 2)) col = tabby;
              ctx.fillStyle = col;
              ctx.fillRect(x - 0.5, y + (ch - tw) / 2, cw + 1, tw);
              ctx.fillStyle = shade(col, 30);
              ctx.fillRect(x - 0.5, y + (ch - tw) / 2, cw + 1, Math.max(1, tw * 0.3));
              ctx.fillStyle = "rgba(0,0,0,0.3)";
              ctx.fillRect(x - 0.5, y + (ch - tw) / 2 + tw - 1, cw + 1, 1);
            }
          }
        }
        // fell line where the cloth is still being made
        if (progress < 1) {
          const fy = fell * ch;
          ctx.strokeStyle = "rgba(160,47,62,0.9)";
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(0, fy + 0.5);
          ctx.lineTo(W, fy + 0.5);
          ctx.stroke();
        }
        // reed shadow at the top edge
        const g = ctx.createLinearGradient(0, 0, 0, 18);
        g.addColorStop(0, "rgba(0,0,0,0.45)");
        g.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, W, 18);
      };

      const weave = function (animate: boolean) {
        if (!cctx) return;
        cancelAnimationFrame(weaveRaf);
        if (!animate || reduceMotion) { drawCloth(1); return; }
        const t0 = performance.now();
        const dur = 750;
        const step = function (t: number) {
          const p = Math.min(1, (t - t0) / dur);
          drawCloth(1 - Math.pow(1 - p, 2));
          if (p < 1) weaveRaf = requestAnimationFrame(step);
        };
        weaveRaf = requestAnimationFrame(step);
      };

      /* ——— meta readouts ————————————————————————— */
      const setText = function (id: string, v: string) { const el = document.getElementById(id); if (el) el.textContent = v; };
      const syncMeta = function () {
        setText("ls-meta-pat", PAT_NAMES[state.pat]);
        const wName = document.querySelector("#ls-warp-spools [aria-pressed='true']")?.getAttribute("data-name")?.toLowerCase() ?? "";
        const fName = document.querySelector("#ls-weft-spools [aria-pressed='true']")?.getAttribute("data-name")?.toLowerCase() ?? "";
        setText("ls-meta-warp", wName);
        setText("ls-meta-weft", fName);
        setText("ls-meta-epi", state.epi + " EPI");
        setText("ls-meta-ten", TEN_NAMES[state.tension]);
        const ends = Math.max(24, Math.round(6 * state.epi));
        setText("ls-meta-px", (clothSize.w / ends).toFixed(1));
        setText("ls-epi-read", state.epi + " EPI");
        setText("ls-hand", state.epi < 17 ? "aéré, drapé marqué" : state.epi < 29 ? "souple, beau drapé" : state.epi < 40 ? "ferme, stable" : "rigide, tapis");
        setText("ls-calc-echo", state.epi + " EPI · " + PAT_NAMES[state.pat]);
        const sl = document.getElementById("ls-epi") as HTMLInputElement | null;
        if (sl) sl.style.setProperty("--ls-fill", (((state.epi - 12) / 36) * 100).toFixed(1) + "%");
        renderCalc();
      };

      /* ——— controls ————————————————————————————————— */
      const spinSpool = function (btn: HTMLElement) {
        btn.classList.remove("is-spin");
        void btn.getBoundingClientRect();
        btn.classList.add("is-spin");
      };
      const wireSpools = function (groupId: string, key: "warp" | "weft") {
        const group = document.getElementById(groupId);
        if (!group) return;
        group.querySelectorAll<HTMLButtonElement>(".ls-spool").forEach(function (btn) {
          btn.addEventListener("click", function () {
            group.querySelectorAll(".ls-spool").forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
            btn.setAttribute("aria-pressed", "true");
            (state as Record<string, unknown>)[key] = btn.getAttribute("data-col");
            spinSpool(btn);
            syncMeta();
            weave(true);
          });
        });
      };
      wireSpools("ls-warp-spools", "warp");
      wireSpools("ls-weft-spools", "weft");

      document.querySelectorAll<HTMLButtonElement>(".ls-pat").forEach(function (btn) {
        btn.addEventListener("click", function () {
          document.querySelectorAll(".ls-pat").forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
          btn.setAttribute("aria-pressed", "true");
          state.pat = btn.getAttribute("data-pat") ?? "twill";
          syncMeta();
          weave(true);
        });
      });

      const epiInput = document.getElementById("ls-epi") as HTMLInputElement | null;
      epiInput?.addEventListener("input", function () {
        state.epi = Number(epiInput.value);
        syncMeta();
        weave(true);
      });
      document.querySelectorAll<HTMLButtonElement>(".ls-tension button").forEach(function (btn) {
        btn.addEventListener("click", function () {
          document.querySelectorAll(".ls-tension button").forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
          btn.setAttribute("aria-pressed", "true");
          state.tension = (btn.getAttribute("data-ten") ?? "working") as typeof state.tension;
          syncMeta();
          weave(true);
        });
      });

      /* ——— draft editor ————————————————————————— */
      // La grille 8×8 est dans le HTML (lisible sans JS) ; on la câble ici.
      const grid = document.getElementById("ls-draftgrid");
      if (grid) {
        grid.querySelectorAll<HTMLButtonElement>(".ls-cell").forEach(function (cell, idx) {
          const rr = Math.floor(idx / 8); const cc = idx % 8;
          cell.addEventListener("click", function () {
            draft[rr][cc] = draft[rr][cc] ? 0 : 1;
            cell.classList.toggle("on", draft[rr][cc] === 1);
            cell.setAttribute("aria-pressed", String(draft[rr][cc] === 1));
            const el = document.getElementById("ls-draft-state");
            if (el) el.textContent = "Pointage modifié : " + countOn(draft) + " cases levées";
            drawDraftSample(true);
          });
        });
      }
      const countOn = function (g: number[][]) { let n = 0; g.forEach(function (row) { row.forEach(function (v) { n += v; }); }); return n; };

      const dsample = document.getElementById("ls-draft-sample") as HTMLCanvasElement | null;
      const dctx = dsample ? dsample.getContext("2d") : null;
      const drawDraftSample = function (animate: boolean) {
        if (!dctx || !dsample) return;
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        const rect = dsample.getBoundingClientRect();
        const w = Math.max(200, Math.round(rect.width)); const h = 300;
        dsample.width = Math.round(w * dpr); dsample.height = Math.round(h * dpr);
        dctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const draw = function (prog: number) {
          dctx.fillStyle = "#f6f1e4";
          dctx.fillRect(0, 0, w, h);
          const cw = w / 40; const rows = Math.floor(h / cw);
          const fell = Math.floor(rows * prog);
          for (let j = 0; j < fell; j++) {
            for (let i = 0; i < 40; i++) {
              const up = draft[j % 8][i % 8] === 1;
              const x = i * cw; const y = j * cw;
              if (up) {
                dctx.fillStyle = "#24314f";
                dctx.fillRect(x + cw * 0.2, y, cw * 0.6, cw + 0.5);
                dctx.fillStyle = "#3d4d73";
                dctx.fillRect(x + cw * 0.2, y, cw * 0.18, cw + 0.5);
              } else {
                dctx.fillStyle = "#a02f3e";
                dctx.fillRect(x, y + cw * 0.2, cw + 0.5, cw * 0.6);
                dctx.fillStyle = "#c2505e";
                dctx.fillRect(x, y + cw * 0.2, cw + 0.5, cw * 0.18);
              }
            }
          }
        };
        cancelAnimationFrame(draftRaf);
        if (!animate || reduceMotion) { draw(1); return; }
        const t0 = performance.now();
        const step = function (t: number) {
          const p = Math.min(1, (t - t0) / 600);
          draw(p);
          if (p < 1) draftRaf = requestAnimationFrame(step);
        };
        draftRaf = requestAnimationFrame(step);
      };
      let draftRaf = 0;

      document.getElementById("ls-use-draft")?.addEventListener("click", function () {
        state.pat = "custom";
        document.querySelectorAll(".ls-pat").forEach(function (b) {
          b.setAttribute("aria-pressed", String(b.getAttribute("data-pat") === "custom"));
        });
        syncMeta();
        weave(true);
        document.getElementById("ls-loom")?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
      });
      document.getElementById("ls-reset-draft")?.addEventListener("click", function () {
        for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) draft[r][c] = DRAFT_DEFAULT(r, c);
        document.querySelectorAll<HTMLElement>(".ls-cell").forEach(function (cell, idx) {
          const r = Math.floor(idx / 8); const c = idx % 8;
          cell.classList.toggle("on", draft[r][c] === 1);
          cell.setAttribute("aria-pressed", String(draft[r][c] === 1));
        });
        const el = document.getElementById("ls-draft-state");
        if (el) el.textContent = "Pointage : montage sergé 2/2";
        drawDraftSample(true);
      });

      /* ——— calculator ————————————————————————— */
      const RATES: Record<string, number> = { wool: 0.016, linen: 0.013, blend: 0.0145 };
      const FINISH: Record<string, number> = { fringe: 15, hem: 25, hand: 40 };
      const widthSel = document.getElementById("ls-width") as HTMLSelectElement | null;
      const lenInput = document.getElementById("ls-length") as HTMLInputElement | null;
      const fibSel = document.getElementById("ls-fibre") as HTMLSelectElement | null;
      const finSel = document.getElementById("ls-finish") as HTMLSelectElement | null;
      const money = function (n: number) { return "C$" + n.toFixed(2); };
      const TEN_NAMES: Record<string, string> = { slack: "molle", working: "de travail", bridge: "maximale" };
      const renderCalc = function () {
        if (!widthSel || !lenInput || !fibSel || !finSel) return;
        const width = Number(widthSel.value);
        const len = Number(lenInput.value);
        const rate = RATES[fibSel.value] ?? 0.016;
        const pf = PAT_FACTOR[state.pat] ?? 1;
        setText("ls-len-read", len.toFixed(1) + " m");
        const ends = Math.round((width / 2.54) * state.epi);
        const warpLen = len + 1.4;
        const warpCost = ends * warpLen * rate;
        const picks = Math.round(len * 39.37 * state.epi);
        const weftCost = picks * (width / 100) * rate;
        const hours = (picks * pf) / 300;
        const labour = hours * 48;
        const yarn = warpCost + weftCost;
        const finish = FINISH[finSel.value] ?? 25;
        const total = Math.ceil((yarn + labour + finish) / 5) * 5;
        setText("ls-o-ends", ends.toLocaleString("en-CA"));
        setText("ls-o-warp", warpLen.toFixed(1) + " m/end · " + money(warpCost));
        setText("ls-o-picks", picks.toLocaleString("en-CA"));
        setText("ls-o-weft", money(weftCost));
        setText("ls-o-hours", hours.toFixed(1) + " h × C$48");
        setText("ls-o-mid", money(yarn) + " + " + money(labour));
        setText("ls-o-finish", money(finish));
        setText("ls-o-total", "C$" + total);
      };
      [widthSel, lenInput, fibSel, finSel].forEach(function (el) {
        el?.addEventListener("input", renderCalc);
        el?.addEventListener("change", renderCalc);
      });

      /* ——— warp order ————————————————————————— */
      const gPerM: Record<string, number> = { wool: 0.25, linen: 0.16, blend: 0.21 };
      const ow = document.getElementById("ls-o-width") as HTMLInputElement | null;
      const od = document.getElementById("ls-o-dent") as HTMLSelectElement | null;
      const oc = document.getElementById("ls-cpd") as HTMLSelectElement | null;
      const ol = document.getElementById("ls-o-len") as HTMLInputElement | null;
      const oy = document.getElementById("ls-o-yarn") as HTMLSelectElement | null;
      const renderWarp = function () {
        if (!ow || !od || !oc || !ol || !oy) return;
        const width = Math.max(20, Math.min(150, Number(ow.value) || 100));
        const ends = Math.round((width / 10) * Number(od.value) * Number(oc.value));
        const total = (Number(ol.value) || 6) + 1.2;
        const kg = (ends * total * (gPerM[oy.value] ?? 0.25)) / 1000;
        // Weft per 10 cm of cloth: 10 cm of picks × width of the piece.
        setText("wm-ends", ends.toLocaleString("en-CA"));
        setText("wm-total", total.toFixed(1) + " m");
        setText("wm-kg", "≈ " + kg.toFixed(2) + " kg");
        setText("wm-weft", ((ends / 10) * (gPerM[oy.value] ?? 0.25)).toFixed(1) + " g");
      };
      [ow, od, oc, ol, oy].forEach(function (el) {
        el?.addEventListener("input", renderWarp);
        el?.addEventListener("change", renderWarp);
      });

      const orderForm = document.getElementById("ls-order-form") as HTMLFormElement | null;
      const stamp = document.getElementById("ls-stamp");
      orderForm?.addEventListener("submit", function (e) {
        e.preventDefault();
        const name = (document.getElementById("ls-o-name") as HTMLInputElement | null)?.value.trim() ?? "";
        const email = (document.getElementById("ls-o-email") as HTMLInputElement | null)?.value ?? "";
        if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          orderForm.reportValidity();
          return;
        }
        const ref = "LR-" + String(Date.now() % 10000).padStart(4, "0");
        const refEl = document.getElementById("ls-stamp-ref");
        if (refEl) refEl.textContent = "Réf. " + ref + " · " + ((document.getElementById("wm-ends")?.textContent ?? "800") + " ends");
        orderForm.style.display = "none";
        stamp?.classList.add("is-on");
      });

      /* ——— shuttle travels with the scroll ————————————— */
      const shuttle = document.getElementById("ls-shuttle") as HTMLElement | null;
      const track = shuttle?.parentElement;
      let shRaf = 0;
      const moveShuttle = function () {
        if (!shuttle || !track || reduceMotion) return;
        cancelAnimationFrame(shRaf);
        shRaf = requestAnimationFrame(function () {
          const doc = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const p = Math.min(1, Math.max(0, window.scrollY / doc));
          const tri = 1 - Math.abs(2 * ((p * 6) % 1) - 1); // six passes down the page
          const span = track.clientWidth - shuttle.offsetWidth;
          shuttle.style.transform = "translateX(" + (tri * span).toFixed(1) + "px)";
          document.documentElement.style.setProperty("--ls-fell", (18 + p * 64).toFixed(1) + "%");
        });
      };
      window.addEventListener("scroll", moveShuttle, { passive: true });
      window.addEventListener("resize", moveShuttle);

      /* ——— weft-pass reveals ————————————————————————— */
      const rows = document.querySelectorAll(".ls-row");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        rows.forEach(function (r) { r.classList.add("is-in"); });
      } else {
        const io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add("is-in"); io.unobserve(entry.target); }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -4% 0px" });
        rows.forEach(function (r) { io.observe(r); });
      }

      /* ——— boot ————————————————————————————————— */
      const boot = function () {
        sizeCloth();
        syncMeta();
        weave(false);
        drawDraftSample(false);
        renderCalc();
        renderWarp();
        moveShuttle();
      };
      boot();
      window.addEventListener("resize", function () {
        sizeCloth();
        weave(false);
        syncMeta();
      });
    })();
  </script>
</body>
</html>
