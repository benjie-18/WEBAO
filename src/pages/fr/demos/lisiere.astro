---
import DemoSeo from "../../../components/demos/DemoSeo.astro";
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
// Démo microsite: Lisière · atelier de tissage fictif, Danville (Québec).
// The page IS the loom: fixed warp threads, selvedge rails, weft-pass sections,
// draft-notation navigation, a live weave configurator. No banner, no cards.
---
<!DOCTYPE html>
<html lang="fr" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <DemoSeo
    demoId="lisiere"
    locale="fr"
    title="Lisière — Atelier de tissage à la main · Danville"
    description="Atelier de tissage fictif au Québec construit comme un métier : configurateur de tissage en direct, éditeur de pointage, registre de prix et commandes de chaîne. Démo de design, pas une vraie entreprise."
    ogImage="https://webao.ca/demos/lisiere/01.jpg"
  />

  <script is:inline>
    // Sans JS, la toile reste dans son état fini, statique.
    document.documentElement.classList.add("ls-js");
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Vollkorn:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Anonymous+Pro:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ls-linen: #ece5d4;
      --ls-linen-2: #e4dbc6;
      --ls-linen-3: #dbd0b6;
      --ls-wool: #d3c2a0;
      --ls-indigo: #24314f;
      --ls-indigo-2: #1a2338;
      --ls-madder: #a02f3e;
      --ls-madder-2: #7f2331;
      --ls-char: #26262a;
      --ls-ink: #241f1a;
      --ls-ink-2: rgba(36, 31, 26, 0.7);
      --ls-ink-3: rgba(36, 31, 26, 0.48);
      --ls-paper: #f6f1e4;
      --ls-rail: 42px;
      --ls-warp-gap: 17px;
      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 96px; }
    body {
      background: var(--ls-linen);
      color: var(--ls-ink);
      font-family: "Vollkorn", Georgia, serif;
      font-size: 17px;
      line-height: 1.62;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; background: none; border: none; color: inherit; }
    ::selection { background: var(--ls-indigo); color: var(--ls-paper); }
    :focus-visible { outline: 2px solid var(--ls-madder); outline-offset: 2px; }

    .ls-mono { font-family: "Anonymous Pro", "Courier New", monospace; font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; }
    .ls-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ——— The loom frame: selvedge rails + fixed warp ——————————————— */
    .ls-warp {
      position: fixed; top: 0; bottom: 0; left: var(--ls-rail); right: var(--ls-rail);
      z-index: 2; pointer-events: none;
      background-image:
        repeating-linear-gradient(90deg,
          rgba(36, 49, 79, 0.5) 0 1.5px, transparent 1.5px 3px,
          rgba(211, 194, 160, 0.55) 3px 4.5px, transparent 4.5px var(--ls-warp-gap));
      background-size: var(--ls-warp-gap) 100%;
      opacity: 0.9;
    }
    .ls-warp::after {
      /* fell line: the weaving edge creeps down slightly with scroll (JS nudges --ls-fell) */
      content: ""; position: absolute; left: 0; right: 0; top: var(--ls-fell, 34%);
      border-top: 1px dashed rgba(160, 47, 62, 0.35);
    }
    .ls-selvedge {
      position: fixed; top: 0; bottom: 0; width: var(--ls-rail); z-index: 5; pointer-events: none;
      background:
        repeating-linear-gradient(0deg, var(--ls-indigo) 0 7px, var(--ls-linen-3) 7px 9px, var(--ls-madder) 9px 12px, var(--ls-linen-3) 12px 14px),
        var(--ls-char);
      box-shadow: inset 0 0 0 1px rgba(36, 31, 26, 0.4);
    }
    .ls-selvedge.is-left { left: 0; border-right: 2px solid var(--ls-char); }
    .ls-selvedge.is-right { right: 0; border-left: 2px solid var(--ls-char); }

    /* ——— Sticky breast beam: brand + draft nav + shuttle track ————— */
    .ls-beam {
      position: sticky; top: 0; z-index: 40;
      background: var(--ls-linen-2);
      border-bottom: 1px solid var(--ls-char);
      box-shadow: 0 1px 0 var(--ls-linen-3), 0 6px 18px rgba(36, 31, 26, 0.12);
      margin: 0 var(--ls-rail);
    }
    .ls-beam-in { display: flex; align-items: center; gap: 22px; padding: 10px 16px 8px; }
    .ls-wordmark {
      font-family: "Vollkorn", serif; font-weight: 700; font-size: 19px; letter-spacing: 0.26em;
      text-indent: 0.26em; color: var(--ls-ink); display: flex; align-items: center; gap: 10px; flex: none;
    }
    .ls-wordmark svg { width: 16px; height: 16px; }
    .ls-draftnav { display: flex; gap: 4px; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
    .ls-draftnav::-webkit-scrollbar { display: none; }
    .ls-draftnav a {
      display: flex; align-items: center; gap: 8px; padding: 7px 10px;
      font-family: "Anonymous Pro", monospace; font-size: 10.5px; letter-spacing: 0.13em; text-transform: uppercase;
      color: var(--ls-ink-2); white-space: nowrap;
      border: 1px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .ls-draftnav a:hover, .ls-draftnav a:focus-visible { background: var(--ls-paper); border-color: var(--ls-char); color: var(--ls-ink); }
    .ls-draftnav svg { width: 14px; height: 18px; flex: none; shape-rendering: crispEdges; }
    .ls-draftnav svg rect { stroke: var(--ls-ink-3); stroke-width: 0.6; fill: none; }
    .ls-draftnav svg rect.on { fill: var(--ls-char); stroke: var(--ls-char); }
    .ls-draftnav a:hover svg rect.on { fill: var(--ls-madder); stroke: var(--ls-madder); }

    .ls-track { position: relative; height: 14px; border-top: 1px solid var(--ls-linen-3); background: var(--ls-paper); overflow: hidden; }
    .ls-track::before {
      content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 1.5px;
      background: var(--ls-madder); opacity: 0.55;
    }
    .ls-shuttle {
      position: absolute; top: 1.5px; left: 0; width: 54px; height: 11px;
      transform: translateX(0); will-change: transform;
    }
    .ls-shuttle svg { display: block; width: 100%; height: 100%; }

    /* ——— Woven bands ————————————————————————————————— */
    .ls-band { position: relative; padding: 9vh 0; }
    .ls-band-in { position: relative; margin: 0 var(--ls-rail); padding: 0 clamp(16px, 4vw, 54px); }
    .ls-over { position: relative; z-index: 3; background: var(--ls-linen); }
    .ls-under { position: relative; z-index: 1; }

    .ls-eyebrow { color: var(--ls-madder); margin-bottom: 14px; display: flex; align-items: center; gap: 12px; }
    .ls-eyebrow::after { content: ""; flex: 1; height: 1px; background: rgba(36, 31, 26, 0.25); }
    .ls-h2 {
      font-family: "Vollkorn", serif; font-weight: 600;
      font-size: clamp(1.7rem, 3.4vw, 2.6rem); line-height: 1.12; letter-spacing: -0.01em;
      max-width: 26ch; text-wrap: balance; margin-bottom: 16px;
    }
    .ls-lede { font-size: 18px; max-width: 58ch; color: var(--ls-ink-2); }

    /* row-by-row weft reveal */
    .ls-row { position: relative; transition: opacity 0.55s ease, transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: var(--ls-d, 0ms); }
    html.js .ls-row { opacity: 0; transform: translateX(var(--ls-from, -26px)); }
    .ls-row:nth-child(even) { --ls-from: 26px; }
    html.js .ls-row.is-in { opacity: 1; transform: none; }
    .ls-row.is-in::before {
      content: ""; position: absolute; top: -10px; left: 0; right: 0; height: 1.5px;
      background: linear-gradient(90deg, var(--ls-indigo), var(--ls-madder) 70%, transparent);
      transform-origin: left; animation: ls-beat 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--ls-d, 0ms) + 150ms);
    }
    @keyframes ls-beat { from { transform: scaleX(0); } to { transform: scaleX(1); } }

    /* ——— Band I · woven title row ———————————————————————— */
    .ls-titleband { padding-top: 7vh; padding-bottom: 4vh; }
    .ls-title-kicker { color: var(--ls-madder); margin-bottom: 18px; }
    .ls-h1 {
      font-family: "Vollkorn", serif; font-weight: 700;
      font-size: clamp(3.2rem, 11vw, 7.5rem); line-height: 0.96; letter-spacing: 0.02em;
      color: var(--ls-ink); position: relative; z-index: 1; /* warp crosses the name */
    }
    .ls-h1 em { font-style: italic; font-weight: 400; color: var(--ls-indigo); }
    .ls-title-deck { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; margin-top: 30px; position: relative; z-index: 3; }
    .ls-title-deck p { max-width: 52ch; }
    .ls-title-deck .ls-facts { list-style: none; border-top: 1.5px solid var(--ls-char); }
    .ls-title-deck .ls-facts li {
      display: flex; justify-content: space-between; gap: 14px; padding: 8px 0;
      border-bottom: 1px solid rgba(36, 31, 26, 0.22);
      font-family: "Anonymous Pro", monospace; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--ls-ink-2);
    }
    .ls-title-deck .ls-facts b { color: var(--ls-madder); font-weight: 700; }
    .ls-title-plate { margin-top: 40px; position: relative; z-index: 1; }
    .ls-title-plate img { width: 100%; max-height: 46vh; object-fit: cover; filter: saturate(0.92); }

    /* ——— Band II · the loom configurator ————————————————— */
    .ls-loom { display: grid; grid-template-columns: minmax(240px, 320px) 1fr; gap: 34px; align-items: start; }
    .ls-controls { display: flex; flex-direction: column; gap: 26px; }
    .ls-ctl h3 {
      font-family: "Anonymous Pro", monospace; font-size: 11px; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--ls-ink-2); margin-bottom: 12px; font-weight: 700;
    }
    .ls-spools { display: flex; gap: 10px; flex-wrap: wrap; }
    .ls-spool {
      width: 56px; display: flex; flex-direction: column; align-items: center; gap: 5px;
      padding: 6px 2px; border: 1px solid transparent; transition: border-color 0.2s, background 0.2s;
    }
    .ls-spool:hover { background: var(--ls-paper); border-color: rgba(36, 31, 26, 0.35); }
    .ls-spool[aria-pressed="true"] { border-color: var(--ls-char); background: var(--ls-paper); }
    .ls-spool[aria-pressed="true"] .ls-spool-lab { color: var(--ls-madder); font-weight: 700; }
    .ls-spool svg { width: 34px; height: 34px; }
    .ls-spool .ls-bobbin { transform-origin: 50% 50%; }
    .ls-spool.is-spin .ls-bobbin { animation: ls-spin 0.8s cubic-bezier(0.3, 0.7, 0.3, 1) 1; }
    @keyframes ls-spin { to { transform: rotate(360deg); } }
    .ls-spool-lab { font-family: "Anonymous Pro", monospace; font-size: 8.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ls-ink-2); }

    .ls-patterns { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
    .ls-pat {
      padding: 8px 4px 6px; border: 1px solid rgba(36, 31, 26, 0.4); background: var(--ls-paper);
      display: flex; flex-direction: column; align-items: center; gap: 5px;
      font-family: "Anonymous Pro", monospace; font-size: 8.5px; letter-spacing: 0.05em; text-transform: uppercase;
      color: var(--ls-ink-2); transition: background 0.2s, color 0.2s, border-color 0.2s;
      min-width: 0;
    }
    .ls-pat:hover { border-color: var(--ls-char); }
    .ls-pat[aria-pressed="true"] { background: var(--ls-char); color: var(--ls-paper); border-color: var(--ls-char); }
    .ls-pat svg { width: 26px; height: 26px; shape-rendering: crispEdges; }
    .ls-pat svg rect { fill: transparent; stroke: rgba(36, 31, 26, 0.35); stroke-width: 0.6; }
    .ls-pat svg rect.on { fill: var(--ls-char); }
    .ls-pat[aria-pressed="true"] svg rect.on { fill: var(--ls-linen); }
    .ls-pat[aria-pressed="true"] svg rect { stroke: rgba(246, 241, 228, 0.5); }

    .ls-slider-row { display: flex; flex-direction: column; gap: 8px; }
    .ls-slider-row input[type="range"] {
      -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 0;
      background: linear-gradient(90deg, var(--ls-madder) var(--ls-fill, 33%), rgba(36, 31, 26, 0.2) var(--ls-fill, 33%));
      outline: none; cursor: pointer;
    }
    .ls-slider-row input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none; width: 18px; height: 26px; border-radius: 2px;
      background: var(--ls-char); border: 2px solid var(--ls-linen); box-shadow: 0 1px 4px rgba(36, 31, 26, 0.4);
      transition: transform 0.15s;
    }
    .ls-slider-row input[type="range"]::-webkit-slider-thumb:hover { transform: scaleY(1.1); }
    .ls-slider-row input[type="range"]::-moz-range-thumb {
      width: 16px; height: 24px; border-radius: 2px;
      background: var(--ls-char); border: 2px solid var(--ls-linen);
    }
    .ls-slider-labels { display: flex; justify-content: space-between; color: var(--ls-ink-3); }
    .ls-readout { font-family: "Anonymous Pro", monospace; font-size: 12px; color: var(--ls-ink); letter-spacing: 0.06em; }
    .ls-readout b { color: var(--ls-madder); font-weight: 700; }

    .ls-tension { display: flex; gap: 0; border: 1px solid var(--ls-char); width: fit-content; }
    .ls-tension button {
      font-family: "Anonymous Pro", monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 8px 13px; border-right: 1px solid var(--ls-char); color: var(--ls-ink-2); background: var(--ls-paper);
      transition: background 0.2s, color 0.2s;
    }
    .ls-tension button:last-child { border-right: 0; }
    .ls-tension button[aria-pressed="true"] { background: var(--ls-indigo); color: var(--ls-paper); }

    .ls-cloth-wrap { position: relative; border: 2px solid var(--ls-char); background: var(--ls-char); }
    .ls-cloth-wrap::before, .ls-cloth-wrap::after {
      /* woven edge lines inside the frame */
      content: ""; position: absolute; top: 0; bottom: 0; width: 6px; z-index: 2;
      background: repeating-linear-gradient(180deg, var(--ls-linen-3) 0 4px, var(--ls-char) 4px 6px); opacity: 0.8;
    }
    .ls-cloth-wrap::before { left: 0; }
    .ls-cloth-wrap::after { right: 0; }
    #ls-cloth {
      display: block; width: 100%; height: min(58vh, 480px);
      /* JS-off fallback: a CSS plain weave so a textile always shows */
      background:
        repeating-linear-gradient(90deg, var(--ls-indigo) 0 4px, transparent 4px 8px),
        repeating-linear-gradient(0deg, var(--ls-wool) 0 4px, transparent 4px 8px),
        var(--ls-linen-3);
    }
    .ls-cloth-meta {
      display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: space-between;
      margin-top: 10px; color: var(--ls-ink-2);
    }
    .ls-cloth-meta b { color: var(--ls-madder); font-weight: 700; }

    /* ——— Band III · draft editor ————————————————————————— */
    .ls-draftband { display: grid; grid-template-columns: 1fr minmax(260px, 360px); gap: 34px; align-items: start; }
    .ls-draftgrid-wrap { border: 1.5px solid var(--ls-char); background: var(--ls-paper); padding: 14px; width: fit-content; max-width: 100%; overflow-x: auto; }
    .ls-draftgrid { display: grid; grid-template-columns: repeat(8, 34px); grid-auto-rows: 34px; gap: 2px; }
    .ls-cell {
      border: 1px solid rgba(36, 31, 26, 0.5); background: var(--ls-linen);
      transition: background 0.12s;
      position: relative;
    }
    .ls-cell:hover { border-color: var(--ls-madder); }
    .ls-cell.on { background: var(--ls-char); box-shadow: inset 0 0 0 2px var(--ls-linen); }
    .ls-cell.on:hover { background: var(--ls-madder); }
    .ls-draft-axis { display: grid; grid-template-columns: repeat(8, 34px); gap: 2px; margin-bottom: 6px; }
    .ls-draft-axis span { font-family: "Anonymous Pro", monospace; font-size: 9px; text-align: center; color: var(--ls-ink-3); }
    .ls-draft-legend { display: flex; justify-content: space-between; gap: 14px; margin-top: 10px; flex-wrap: wrap; color: var(--ls-ink-3); }
    .ls-draft-actions { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
    .ls-btn {
      font-family: "Anonymous Pro", monospace; font-size: 11px; letter-spacing: 0.13em; text-transform: uppercase;
      padding: 11px 18px; background: var(--ls-char); color: var(--ls-paper);
      transition: background 0.2s, transform 0.15s;
    }
    .ls-btn:hover { background: var(--ls-madder); }
    .ls-btn:active { transform: translateY(1px); }
    .ls-btn.is-ghost { background: transparent; color: var(--ls-ink); border: 1px solid var(--ls-char); }
    .ls-btn.is-ghost:hover { background: var(--ls-char); color: var(--ls-paper); }
    #ls-draft-sample {
      display: block; width: 100%; height: 300px; border: 2px solid var(--ls-char);
      background:
        repeating-linear-gradient(90deg, var(--ls-char) 0 3px, transparent 3px 6px),
        repeating-linear-gradient(0deg, var(--ls-linen-3) 0 3px, transparent 3px 6px),
        var(--ls-paper);
    }

    /* ——— shared indigo ledger panels ——————————————————————— */
    .ls-indigo-panel { background: var(--ls-indigo); color: var(--ls-paper); padding: clamp(22px, 3.4vw, 40px); position: relative; z-index: 3; }
    .ls-indigo-panel .ls-eyebrow { color: var(--ls-wool); }
    .ls-indigo-panel .ls-eyebrow::after { background: rgba(246, 241, 228, 0.25); }
    .ls-indigo-panel .ls-lede { color: rgba(246, 241, 228, 0.78); }

    .ls-yarn-ledger { list-style: none; margin-top: 26px; }
    .ls-yarn-ledger li {
      display: grid; grid-template-columns: 120px 1fr auto; gap: 8px 20px; align-items: baseline;
      padding: 13px 0; border-top: 1px solid rgba(246, 241, 228, 0.22);
      font-family: "Anonymous Pro", monospace; font-size: 12px; letter-spacing: 0.05em;
    }
    .ls-yarn-ledger li:last-child { border-bottom: 1px solid rgba(246, 241, 228, 0.22); }
    .ls-yarn-ledger .y-name { color: var(--ls-wool); text-transform: uppercase; font-weight: 700; }
    .ls-yarn-ledger .y-spec { color: rgba(246, 241, 228, 0.75); text-transform: none; }
    .ls-yarn-ledger .y-lot { color: #e79aa4; white-space: nowrap; }

    .ls-plate-full { margin-top: 36px; }
    .ls-plate-full img { width: 100%; max-height: 52vh; object-fit: cover; }
    .ls-plate-cap { position: relative; z-index: 3; background: var(--ls-linen); padding: 12px 14px; display: inline-block; margin-top: -1px; color: var(--ls-ink-2); border-left: 3px solid var(--ls-madder); }

    /* ——— Band IV · calculator ———————————————————————————— */
    .ls-calc { display: grid; grid-template-columns: minmax(240px, 330px) 1fr; gap: 34px; align-items: start; }
    .ls-field { margin-bottom: 18px; }
    .ls-field label { display: block; font-family: "Anonymous Pro", monospace; font-size: 10.5px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--ls-ink-2); margin-bottom: 7px; }
    .ls-field select, .ls-field input[type="number"], .ls-field input[type="text"], .ls-field input[type="email"], .ls-field input[type="date"], .ls-field textarea {
      width: 100%; font-family: "Anonymous Pro", monospace; font-size: 13px;
      background: var(--ls-paper); color: var(--ls-ink);
      border: 1px solid var(--ls-char); border-radius: 0; padding: 11px 12px;
    }
    .ls-field textarea { resize: vertical; min-height: 70px; }
    .ls-field select:focus, .ls-field input:focus, .ls-field textarea:focus { outline: 2px solid var(--ls-madder); outline-offset: 1px; }
    .ls-ledger { border-top: 2px solid var(--ls-char); }
    .ls-ledger-row {
      display: grid; grid-template-columns: 1fr auto; gap: 16px; padding: 12px 4px;
      border-bottom: 1px solid rgba(36, 31, 26, 0.25);
      font-family: "Anonymous Pro", monospace; font-size: 13px; letter-spacing: 0.04em;
    }
    .ls-ledger-row span:first-child { color: var(--ls-ink-2); text-transform: uppercase; font-size: 11px; letter-spacing: 0.1em; align-self: center; }
    .ls-ledger-row b { font-weight: 700; color: var(--ls-ink); }
    .ls-ledger-row.is-total { border-bottom: 3px double var(--ls-char); border-top: 2px solid var(--ls-char); font-size: 17px; }
    .ls-ledger-row.is-total b { color: var(--ls-madder); font-size: 22px; }
    .ls-ledger-note { margin-top: 12px; color: var(--ls-ink-3); }

    /* ——— Band V · pieces (draw-down table, not cards) ——————————— */
    .ls-drawdown { width: 100%; border-collapse: collapse; position: relative; z-index: 3; background: var(--ls-linen); }
    .ls-drawdown th {
      text-align: left; font-family: "Anonymous Pro", monospace; font-size: 10px; letter-spacing: 0.15em;
      text-transform: uppercase; color: var(--ls-ink-2); font-weight: 700;
      padding: 10px 12px; border-bottom: 2px solid var(--ls-char);
    }
    .ls-drawdown td { padding: 15px 12px; border-bottom: 1px solid rgba(36, 31, 26, 0.25); vertical-align: top; }
    .ls-drawdown td:first-child { font-weight: 600; }
    .ls-drawdown .mono { font-family: "Anonymous Pro", monospace; font-size: 12px; color: var(--ls-ink-2); }
    .ls-drawdown .price { font-family: "Anonymous Pro", monospace; font-weight: 700; color: var(--ls-madder); white-space: nowrap; }
    .ls-drawdown tr:hover td { background: var(--ls-paper); }

    /* ——— Band VI · warp order ———————————————————————————— */
    .ls-order { display: grid; grid-template-columns: 1.15fr minmax(250px, 340px); gap: 36px; align-items: start; }
    .ls-order-form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .ls-order-form .ls-wide { grid-column: 1 / -1; }
    .ls-warp-math { border: 1.5px solid var(--ls-char); background: var(--ls-paper); padding: 20px 18px; position: relative; }
    .ls-warp-math h3 { font-family: "Anonymous Pro", monospace; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 14px; color: var(--ls-ink-2); font-weight: 700; }
    .ls-wm-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed rgba(36, 31, 26, 0.3); font-family: "Anonymous Pro", monospace; font-size: 12.5px; }
    .ls-wm-row b { color: var(--ls-madder); font-weight: 700; }
    .ls-wm-formula { margin-top: 12px; font-family: "Anonymous Pro", monospace; font-size: 10.5px; color: var(--ls-ink-3); line-height: 1.7; text-transform: none; letter-spacing: 0.02em; }
    .ls-stamp {
      display: none; margin-top: 22px; padding: 18px 20px; border: 2.5px solid var(--ls-madder);
      color: var(--ls-madder); font-family: "Anonymous Pro", monospace; letter-spacing: 0.12em;
      transform: rotate(-1.5deg); background: rgba(160, 47, 62, 0.06); text-align: center;
    }
    .ls-stamp.is-on { display: block; }
    .ls-stamp b { display: block; font-size: 15px; margin-bottom: 6px; }
    .ls-stamp small { color: var(--ls-ink-2); letter-spacing: 0.06em; }

    /* ——— Band VII · atelier facts (through the warp) ————————— */
    .ls-factsband { position: relative; z-index: 1; }
    .ls-facts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1.5px solid var(--ls-char); border-bottom: 1.5px solid var(--ls-char); }
    .ls-fact {
      padding: 22px 20px; border-right: 1px solid rgba(36, 31, 26, 0.3);
      background: rgba(236, 229, 212, 0.82); /* translucent so warp ghosts through */
    }
    .ls-fact:last-child { border-right: 0; }
    .ls-fact h3 { font-family: "Anonymous Pro", monospace; font-size: 10.5px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ls-madder); margin-bottom: 10px; font-weight: 700; }
    .ls-fact p { font-size: 15.5px; color: var(--ls-ink-2); }
    .ls-fact p b { color: var(--ls-ink); font-weight: 600; }

    /* ——— Footer: cut off the loom ————————————————————————— */
    .ls-fringe { margin: 10vh var(--ls-rail) 0; height: 46px; position: relative; z-index: 3;
      background:
        repeating-linear-gradient(90deg, var(--ls-char) 0 3px, transparent 3px 14px),
        repeating-linear-gradient(90deg, var(--ls-indigo) 6px 9px, transparent 9px 14px);
      -webkit-mask-image: linear-gradient(180deg, #000 0 40%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 0 40%, transparent 100%);
    }
    .ls-foot { background: var(--ls-char); color: rgba(246, 241, 228, 0.75); margin: 0 var(--ls-rail); padding: 40px clamp(16px, 4vw, 54px) 46px; position: relative; z-index: 3; }
    .ls-label {
      border: 1px solid rgba(246, 241, 228, 0.4); padding: 22px 24px; max-width: 760px;
      background:
        repeating-linear-gradient(0deg, transparent 0 6px, rgba(246, 241, 228, 0.05) 6px 7px);
    }
    .ls-label h2 { font-family: "Vollkorn", serif; font-weight: 600; font-size: 22px; letter-spacing: 0.18em; color: var(--ls-paper); margin-bottom: 10px; }
    .ls-label p { font-size: 15px; max-width: 60ch; }
    .ls-foot-cols { display: flex; flex-wrap: wrap; gap: 26px 48px; margin-top: 28px; font-family: "Anonymous Pro", monospace; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; }
    .ls-foot-cols a:hover { color: var(--ls-wool); }
    .ls-foot-cols ul { list-style: none; display: flex; flex-direction: column; gap: 7px; }
    .ls-legal {
      display: flex; flex-wrap: wrap; gap: 8px 26px; justify-content: space-between;
      margin-top: 30px; padding-top: 16px; border-top: 1px solid rgba(246, 241, 228, 0.22);
      font-family: "Anonymous Pro", monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
      color: rgba(246, 241, 228, 0.55);
    }

    /* ——— responsive ————————————————————————————————— */
    @media (max-width: 960px) {
      .ls-loom, .ls-calc, .ls-order, .ls-draftband, .ls-title-deck { grid-template-columns: 1fr; }
      .ls-facts-grid { grid-template-columns: 1fr; }
      .ls-fact { border-right: 0; border-bottom: 1px solid rgba(36, 31, 26, 0.3); }
      .ls-fact:last-child { border-bottom: 0; }
      .ls-order-form { grid-template-columns: 1fr; }
    }
    @media (max-width: 680px) {
      :root { --ls-rail: 18px; --ls-warp-gap: 13px; }
      .ls-beam-in { flex-wrap: wrap; gap: 8px 14px; padding: 8px 10px; }
      .ls-draftnav { margin-left: 0; width: 100%; order: 3; }
      .ls-patterns { grid-template-columns: repeat(3, 1fr); }
      .ls-draftgrid { grid-template-columns: repeat(8, 30px); grid-auto-rows: 30px; }
      .ls-draft-axis { grid-template-columns: repeat(8, 30px); }
      .ls-drawdown, .ls-drawdown tbody, .ls-drawdown tr, .ls-drawdown td { display: block; width: 100%; }
      .ls-drawdown thead { display: none; }
      .ls-drawdown tr { border-bottom: 2px solid var(--ls-char); padding: 8px 0; }
      .ls-drawdown td { border: 0; padding: 4px 12px; }
      .ls-yarn-ledger li { grid-template-columns: 1fr; gap: 3px; }
      .ls-h1 { font-size: clamp(2.6rem, 15vw, 4rem); }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important; transition-delay: 0ms !important;
      }
      html.js .ls-row { opacity: 1; transform: none; }
      .ls-row.is-in::before { animation: none; transform: none; }
    }
  </style>
  <script is:inline>document.documentElement.classList.remove("no-js");document.documentElement.classList.add("js");</script>
</head>
<body>
  <div class="ls-selvedge is-left" aria-hidden="true"></div>
  <div class="ls-selvedge is-right" aria-hidden="true"></div>
  <div class="ls-warp" aria-hidden="true"></div>

  <header class="ls-beam">
    <div class="ls-beam-in">
      <a class="ls-wordmark" href="#ls-top">
        <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="1" width="14" height="14" fill="none" stroke="#241f1a"/><path d="M1 5h14M1 9h14M5 1v14M9 1v14" stroke="#a02f3e" stroke-width="1.4"/></svg>
        LISIÈRE
      </a>
      <nav class="ls-draftnav" aria-label="Navigation par pointage">
        <a href="#ls-loom"><svg viewBox="0 0 14 18" aria-hidden="true"><rect class="on" x="1" y="1" width="3" height="3"/><rect x="5" y="1" width="3" height="3"/><rect class="on" x="9" y="1" width="3" height="3"/><rect x="1" y="5" width="3" height="3"/><rect class="on" x="5" y="5" width="3" height="3"/><rect x="9" y="5" width="3" height="3"/><rect class="on" x="1" y="9" width="3" height="3"/><rect x="5" y="9" width="3" height="3"/><rect class="on" x="9" y="9" width="3" height="3"/><rect x="1" y="13" width="3" height="3"/><rect class="on" x="5" y="13" width="3" height="3"/><rect x="9" y="13" width="3" height="3"/></svg>Métier</a>
        <a href="#ls-draft"><svg viewBox="0 0 14 18" aria-hidden="true"><rect class="on" x="1" y="1" width="3" height="3"/><rect class="on" x="5" y="1" width="3" height="3"/><rect x="9" y="1" width="3" height="3"/><rect x="1" y="5" width="3" height="3"/><rect class="on" x="5" y="5" width="3" height="3"/><rect class="on" x="9" y="5" width="3" height="3"/><rect x="1" y="9" width="3" height="3"/><rect x="5" y="9" width="3" height="3"/><rect class="on" x="9" y="9" width="3" height="3"/><rect class="on" x="1" y="13" width="3" height="3"/><rect x="5" y="13" width="3" height="3"/><rect x="9" y="13" width="3" height="3"/></svg>Pointage</a>
        <a href="#ls-yarns"><svg viewBox="0 0 14 18" aria-hidden="true"><rect x="1" y="1" width="3" height="3"/><rect class="on" x="5" y="1" width="3" height="3"/><rect x="9" y="1" width="3" height="3"/><rect class="on" x="1" y="5" width="3" height="3"/><rect class="on" x="5" y="5" width="3" height="3"/><rect class="on" x="9" y="5" width="3" height="3"/><rect x="1" y="9" width="3" height="3"/><rect class="on" x="5" y="9" width="3" height="3"/><rect x="9" y="9" width="3" height="3"/><rect x="1" y="13" width="3" height="3"/><rect x="5" y="13" width="3" height="3"/><rect class="on" x="9" y="13" width="3" height="3"/></svg>Fils</a>
        <a href="#ls-calc"><svg viewBox="0 0 14 18" aria-hidden="true"><rect class="on" x="1" y="1" width="3" height="3"/><rect x="5" y="1" width="3" height="3"/><rect x="9" y="1" width="3" height="3"/><rect class="on" x="1" y="5" width="3" height="3"/><rect class="on" x="5" y="5" width="3" height="3"/><rect x="9" y="5" width="3" height="3"/><rect x="1" y="9" width="3" height="3"/><rect class="on" x="5" y="9" width="3" height="3"/><rect class="on" x="9" y="9" width="3" height="3"/><rect x="1" y="13" width="3" height="3"/><rect x="5" y="13" width="3" height="3"/><rect class="on" x="9" y="13" width="3" height="3"/></svg>Registre</a>
        <a href="#ls-order"><svg viewBox="0 0 14 18" aria-hidden="true"><rect x="1" y="1" width="3" height="3"/><rect class="on" x="5" y="1" width="3" height="3"/><rect x="9" y="1" width="3" height="3"/><rect class="on" x="1" y="5" width="3" height="3"/><rect x="5" y="5" width="3" height="3"/><rect class="on" x="9" y="5" width="3" height="3"/><rect class="on" x="1" y="9" width="3" height="3"/><rect x="5" y="9" width="3" height="3"/><rect class="on" x="9" y="9" width="3" height="3"/><rect x="1" y="13" width="3" height="3"/><rect class="on" x="5" y="13" width="3" height="3"/><rect class="on" x="9" y="13" width="3" height="3"/></svg>Commande</a>
      </nav>
    </div>
    <div class="ls-track" aria-hidden="true">
      <div class="ls-shuttle" id="ls-shuttle">
        <svg viewBox="0 0 54 11"><path d="M2 5.5 L10 1.5 H44 L52 5.5 L44 9.5 H10 Z" fill="#241f1a"/><rect x="16" y="3" width="22" height="5" fill="#a02f3e"/><circle cx="27" cy="5.5" r="1.6" fill="#ece5d4"/></svg>
      </div>
    </div>
  </header>

  <main id="ls-top">
    <!-- Band I · the title row, half-woven under the warp -->
    <section class="ls-band ls-titleband" aria-labelledby="ls-h1">
      <div class="ls-band-in">
        <p class="ls-title-kicker ls-mono">Atelier de tissage à la main · Danville (Québec) · fondé en 2019 (fictif)</p>
        <h1 class="ls-h1" id="ls-h1">Lisière<em>.</em></h1>
        <div class="ls-title-deck">
          <div class="ls-row" style="--ls-d: 60ms">
            <p class="ls-lede">Un atelier à un métier, où la page est sous tension. Les fils vont du haut vers le bas; chaque bande que vous traversez est une trame qu'on bat à coups de peigne. Choisissez vos couleurs plus bas et la toile se retisse sous vos yeux.</p>
          </div>
          <div class="ls-row" style="--ls-d: 160ms">
            <ul class="ls-facts">
              <li><span>Métier</span><b>Louët 8 harnais, 100 cm</b></li>
              <li><span>Densité par défaut</span><b>24 EPI, sergé 2/2</b></li>
              <li><span>Saison</span><b>Chaînes d'hiver, 6 à 10 semaines</b></li>
              <li><span>Ligne des commandes</span><b>+1 819 555-0173</b></li>
            </ul>
          </div>
        </div>
        <div class="ls-title-plate ls-row" style="--ls-d: 260ms">
          <img src="/demos/lisiere/01.jpg" alt="Vue macro des fils de chaîne en lin et indigo passant dans le peigne du métier, avec une ligne de trame garance juste battue" width="1536" height="1024" decoding="async" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- Band II · the loom configurator -->
    <section class="ls-band" id="ls-loom" aria-labelledby="ls-loom-h">
      <div class="ls-band-in ls-over">
        <div class="ls-row">
          <p class="ls-eyebrow ls-mono">Navette I · le métier</p>
          <h2 class="ls-h2" id="ls-loom-h">Chaîne, trame, et ça se bat</h2>
          <p class="ls-lede">Quatre fils, quatre structures, une densité qu'on entend la navette changer d'avis. Chaque choix relance l'échantillon ci-dessous, fil par fil.</p>
        </div>

        <div class="ls-loom" style="margin-top: 34px;">
          <div class="ls-controls ls-row" style="--ls-d: 120ms">
            <div class="ls-ctl">
              <h3>Fils de chaîne</h3>
              <div class="ls-spools" role="group" aria-label="Couleur de chaîne" id="ls-warp-spools">
                <button class="ls-spool" type="button" aria-pressed="true" data-col="#24314f" data-name="Indigo" aria-label="Couleur de chaîne indigo">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#24314f"/><rect x="11" y="10" width="12" height="1.6" fill="#3d4d73"/><rect x="11" y="15" width="12" height="1.6" fill="#3d4d73"/><rect x="11" y="20" width="12" height="1.6" fill="#3d4d73"/></g></svg>
                  <span class="ls-spool-lab">Indigo</span>
                </button>
                <button class="ls-spool" type="button" aria-pressed="false" data-col="#d3c2a0" data-name="Linen" aria-label="Couleur de chaîne lin écru">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#d3c2a0"/><rect x="11" y="10" width="12" height="1.6" fill="#efe4c8"/><rect x="11" y="15" width="12" height="1.6" fill="#efe4c8"/><rect x="11" y="20" width="12" height="1.6" fill="#efe4c8"/></g></svg>
                  <span class="ls-spool-lab">Linen</span>
                </button>
                <button class="ls-spool" type="button" aria-pressed="false" data-col="#a02f3e" data-name="Madder" aria-label="Couleur de chaîne garance">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#a02f3e"/><rect x="11" y="10" width="12" height="1.6" fill="#c2505e"/><rect x="11" y="15" width="12" height="1.6" fill="#c2505e"/><rect x="11" y="20" width="12" height="1.6" fill="#c2505e"/></g></svg>
                  <span class="ls-spool-lab">Madder</span>
                </button>
                <button class="ls-spool" type="button" aria-pressed="false" data-col="#26262a" data-name="Charcoal" aria-label="Couleur de chaîne charbon">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#26262a"/><rect x="11" y="10" width="12" height="1.6" fill="#4a4a52"/><rect x="11" y="15" width="12" height="1.6" fill="#4a4a52"/><rect x="11" y="20" width="12" height="1.6" fill="#4a4a52"/></g></svg>
                  <span class="ls-spool-lab">Charcoal</span>
                </button>
              </div>
            </div>

            <div class="ls-ctl">
              <h3>Trames</h3>
              <div class="ls-spools" role="group" aria-label="Couleur de trame" id="ls-weft-spools">
                <button class="ls-spool" type="button" aria-pressed="false" data-col="#24314f" data-name="Indigo" aria-label="Couleur de trame indigo">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#24314f"/><rect x="11" y="10" width="12" height="1.6" fill="#3d4d73"/><rect x="11" y="15" width="12" height="1.6" fill="#3d4d73"/><rect x="11" y="20" width="12" height="1.6" fill="#3d4d73"/></g></svg>
                  <span class="ls-spool-lab">Indigo</span>
                </button>
                <button class="ls-spool" type="button" aria-pressed="true" data-col="#d3c2a0" data-name="Linen" aria-label="Couleur de trame lin écru">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#d3c2a0"/><rect x="11" y="10" width="12" height="1.6" fill="#efe4c8"/><rect x="11" y="15" width="12" height="1.6" fill="#efe4c8"/><rect x="11" y="20" width="12" height="1.6" fill="#efe4c8"/></g></svg>
                  <span class="ls-spool-lab">Linen</span>
                </button>
                <button class="ls-spool" type="button" aria-pressed="false" data-col="#a02f3e" data-name="Madder" aria-label="Couleur de trame garance">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#a02f3e"/><rect x="11" y="10" width="12" height="1.6" fill="#c2505e"/><rect x="11" y="15" width="12" height="1.6" fill="#c2505e"/><rect x="11" y="20" width="12" height="1.6" fill="#c2505e"/></g></svg>
                  <span class="ls-spool-lab">Madder</span>
                </button>
                <button class="ls-spool" type="button" aria-pressed="false" data-col="#26262a" data-name="Charcoal" aria-label="Couleur de trame charbon">
                  <svg viewBox="0 0 34 34" aria-hidden="true"><g class="ls-bobbin"><rect x="8" y="4" width="18" height="3" fill="#241f1a"/><rect x="8" y="27" width="18" height="3" fill="#241f1a"/><rect x="11" y="7" width="12" height="20" fill="#26262a"/><rect x="11" y="10" width="12" height="1.6" fill="#4a4a52"/><rect x="11" y="15" width="12" height="1.6" fill="#4a4a52"/><rect x="11" y="20" width="12" height="1.6" fill="#4a4a52"/></g></svg>
                  <span class="ls-spool-lab">Charcoal</span>
                </button>
              </div>
            </div>

            <div class="ls-ctl">
              <h3>Structure</h3>
              <div class="ls-patterns" role="group" aria-label="Weave structure">
                <button class="ls-pat" type="button" aria-pressed="false" data-pat="plain" aria-label="Toile">
                  <svg viewBox="0 0 26 26" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="9" y="1" width="6" height="6"/><rect x="17" y="1" width="6" height="6"/><rect x="5" y="9" width="6" height="6"/><rect x="13" y="9" width="6" height="6"/><rect x="21" y="9" width="6" height="6"/><rect x="1" y="17" width="6" height="6"/><rect x="9" y="17" width="6" height="6"/><rect x="17" y="17" width="6" height="6"/></svg>
                  Toile
                </button>
                <button class="ls-pat" type="button" aria-pressed="true" data-pat="twill" aria-label="Sergé 2/2">
                  <svg viewBox="0 0 26 26" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="9" y="1" width="6" height="6"/><rect x="5" y="9" width="6" height="6"/><rect x="13" y="9" width="6" height="6"/><rect x="21" y="9" width="6" height="6"/><rect x="1" y="17" width="6" height="6"/><rect x="9" y="17" width="6" height="6"/><rect x="17" y="17" width="6" height="6"/></svg>
                  Sergé
                </button>
                <button class="ls-pat" type="button" aria-pressed="false" data-pat="herringbone" aria-label="Chevrons">
                  <svg viewBox="0 0 26 26" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="9" y="1" width="6" height="6"/><rect x="5" y="9" width="6" height="6"/><rect x="13" y="9" width="6" height="6"/><rect x="17" y="9" width="6" height="6"/><rect x="21" y="9" width="6" height="6"/><rect x="1" y="17" width="6" height="6"/><rect x="9" y="17" width="6" height="6"/><rect x="17" y="17" width="6" height="6"/></svg>
                  Chevrons
                </button>
                <button class="ls-pat" type="button" aria-pressed="false" data-pat="overshot" aria-label="Overshot (dérobé)">
                  <svg viewBox="0 0 26 26" aria-hidden="true"><rect x="1" y="1" width="6" height="6"/><rect x="17" y="1" width="6" height="6"/><rect x="1" y="9" width="6" height="6"/><rect x="5" y="9" width="6" height="6"/><rect x="9" y="9" width="6" height="6"/><rect x="13" y="9" width="6" height="6"/><rect x="17" y="17" width="6" height="6"/><rect x="21" y="17" width="6" height="6"/></svg>
                  Dérobé
                </button>
                <button class="ls-pat" type="button" aria-pressed="false" data-pat="custom" aria-label="Pointage personnalisé">
