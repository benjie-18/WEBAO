              <input type="email" id="ls-o-email" name="email" autocomplete="email" required placeholder="vous@exemple.com" />
            </div>
            <div class="ls-wide" style="display:flex; gap:14px; align-items:center; flex-wrap:wrap;">
              <button class="ls-btn" type="submit">Envoyer la commande de chaîne</button>
