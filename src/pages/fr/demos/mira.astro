---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Démo : Mira Cantine · cantine fictive au feu de bois, Vieux-Montréal.
// Reconstruite MENU D'ABORD. Le menu est la page d'accueil : il s'ouvre
// directement sur le menu du soir, sans héros ni section philosophique.
// Le mot de la cheffe est une note en marge. Réservations plus bas.
// Direction artistique autonome.
const IMG = {
  hero: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=1800&auto=format&fit=crop",
  interior: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=1200&auto=format&fit=crop",
  table: "/demos/mira/02.jpg",
  dish: "https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=1200&auto=format&fit=crop",
  fire: "/demos/mira/01.jpg",
  oven: "/demos/mira/03.jpg",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="mira" locale="fr" title="Mira Cantine · Le menu du soir · Vieux-Montréal" description="Mira Cantine : le menu du soir. Petites assiettes au feu de bois, vins nature, Vieux-Montréal. Du mardi au dimanche. Réservations recommandées." ogImage="https://webao.ca/demos/mira/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="mn">

  <header class="mn-bar">
    <a class="mn-brand" href="#top">Mira <em>cantine</em></a>
    <nav aria-label="Sections">
      <a href="#menu">Menu</a>
      <a href="#room">La salle</a>
      <a href="#visit">Nous trouver</a>
    </nav>
    <a class="mn-res" href="#reserve">Réserver</a>
  </header>

  <main id="top">
    <!-- LE MENU EST LA PAGE D'ACCUEIL. Pas de héros. -->
    <section class="mn-menu" id="menu">
      <div class="mn-sheet">
        <p class="mn-dateline">Vieux-Montréal · <span data-mn-date>Ce soir</span> · imprimé à 17 h</p>
        <h1 class="mn-title">Ce soir<em>,</em> <span>des braises</span></h1>

        <div class="mn-courses">
          <div class="mn-course">
            <h2>Pour commencer</h2>
            <ul>
              <li><div><strong>Poireaux grillés, noisettes</strong><span>vinaigrette au beurre noisette</span></div><b>14</b></li>
              <li><div><strong>Betteraves des braises</strong><span>chèvre fouetté, crumble de seigle</span></div><b>15</b></li>
              <li><div><strong>Sardines grillées</strong><span>citron, piment, pain grillé</span></div><b>16</b></li>
              <li><div><strong>Burrata, tomate fumée</strong><span>huile de basilic, fleur de sel</span></div><b>18</b></li>
            </ul>
          </div>
          <div class="mn-course">
            <h2>Du feu</h2>
            <ul>
              <li><div><strong>Demi-poulet al mattone</strong><span>jus, citron brûlé</span></div><b>29</b></li>
              <li><div><strong>Faux-filet vieilli</strong><span>beurre à la moelle, cresson</span></div><b>42</b></li>
              <li><div><strong>Chou-fleur rôti entier</strong><span>romesco, amande, herbes</span></div><b>24</b></li>
              <li><div><strong>Omble chevalier, carottes des braises</strong><span>beurre blanc, aneth</span></div><b>34</b></li>
            </ul>
          </div>
          <div class="mn-course">
            <h2>Douceurs</h2>
            <ul>
              <li><div><strong>Panna cotta au miel brûlé</strong><span>pollen d'abeille</span></div><b>12</b></li>
              <li><div><strong>Chocolat, huile d'olive, sel</strong><span>cuit à la braise, à partager</span></div><b>14</b></li>
              <li><div><strong>Riz au lait du four à bois</strong><span>coing poché</span></div><b>11</b></li>
            </ul>
            <p class="mn-wine"><em>Vins :</em> plus de 120 bouteilles nature. Demandez ce qui est ouvert.</p>
          </div>
        </div>

        <!-- mot de la cheffe, en note marginale -->
        <aside class="mn-aside">
          <p class="mn-aside-k">Un mot de Mira</p>
          <p>« Tout ce qui est dans votre assiette a d'abord rencontré la flamme. Le menu change avec le marché, alors ce que vous avez aimé en mars sera peut-être parti en mai. C'est le marché, et c'est très bien ainsi. »</p>
        </aside>

        <figure class="mn-plate">
          <img src={IMG.hero} alt="L'assiette du soir chez Mira Cantine" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption>L'assiette du soir, la plupart des soirs</figcaption>
        </figure>
      </div>
    </section>

    <!-- interlude de feu -->
    <section class="mn-fire" aria-label="Le four à bois">
      <img src={IMG.fire} alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <p>Un four. Chêne et érable. <em>Allumé à midi, chaque jour.</em></p>
    </section>

    <!-- la salle : trois petites images -->
    <section class="mn-room" id="room">
      <div class="mn-room-in">
        <figure><img src={IMG.table} alt="Une table de petites assiettes à partager" loading="lazy" decoding="async" /><figcaption>À partager</figcaption></figure>
        <figure><img src={IMG.dish} alt="Une assiette de saison chez Mira Cantine" loading="lazy" decoding="async" /><figcaption>Au menu ce soir</figcaption></figure>
        <figure><img src={IMG.oven} alt="Les flammes dans le four à bois" loading="lazy" decoding="async" /><figcaption>Le four, toujours allumé</figcaption></figure>
      </div>
    </section>

    <!-- nous trouver + réserver -->
    <section class="mn-visit" id="visit">
      <div class="mn-visit-in">
        <div class="mn-hours">
          <img src={IMG.interior} alt="La salle de Mira Cantine, couleur ambre" loading="lazy" decoding="async" />
          <h2>Heures et adresse</h2>
          <dl>
            <div><dt>Mar. au jeu.</dt><dd>17 h 30 – 22 h</dd></div>
            <div><dt>Ven. au sam.</dt><dd>17 h 30 – 23 h</dd></div>
            <div><dt>Dimanche</dt><dd>16 h – 21 h</dd></div>
            <div><dt>Lundi</dt><dd>fermé, le four se repose</dd></div>
          </dl>
          <address>123, rue Fictive, Montréal QC<br /><a href="tel:+15145550198">(514) 555-0198</a></address>
          <p class="mn-small">Sans réservation au bar. La salle se remplit, alors réservez d'avance.</p>
        </div>
        <form class="mn-form" id="reserve" novalidate>
          <h2>Réserver <em>une table</em></h2>
          <div class="mn-row">
            <label>Date<input type="date" name="date" required /></label>
            <label>Convives
              <select name="guests">
                <option>2 convives</option><option>1 convive</option><option>3 convives</option>
                <option>4 convives</option><option>5 convives</option><option>6 convives</option>
                <option>7 convives</option><option>8 convives</option>
              </select>
            </label>
          </div>
          <label>Nom<input type="text" name="name" required placeholder="Jeanne Tremblay" autocomplete="name" /></label>
          <label>Téléphone<input type="tel" name="phone" required placeholder="(514) 555-0000" autocomplete="tel" /></label>
          <button type="submit">Demander cette table</button>
          <p class="mn-form-note" role="status" aria-live="polite"></p>
          <p class="mn-small">Les tables de 1 à 8 se réservent ici. Pour 9 et plus, appelez-nous.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="mn-foot">
    <p class="mn-foot-brand">Mira <em>cantine</em></p>
    <p>123, rue Fictive, Montréal QC · (514) 555-0198<br />© 2026 Mira Cantine</p>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      var d = document.querySelector('[data-mn-date]');
      if (d) {
        try {
          d.textContent = new Date().toLocaleDateString('fr-CA', { weekday: 'long', month: 'long', day: 'numeric' });
        } catch (e) {}
      }
      var form = document.getElementById('reserve');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.mn-form-note');
        if (note) note.textContent = '✓ Très bon choix. On vous confirme la table sous peu.';
      });
    })();
  </script>

  <style>
    .mn {
      --mn-cream: #F6EFE1;
      --mn-ink: #221610;
      --mn-ink2: #5C4B3E;
      --mn-terra: #C2481F;
      --mn-line: rgba(34, 22, 16, 0.16);
      --mn-serif: "Fraunces", Georgia, serif;
      --mn-sans: "Inter", system-ui, sans-serif;
      margin: 0;
      background: var(--mn-cream);
      color: var(--mn-ink);
      font-family: var(--mn-sans);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .mn *, .mn *::before, .mn *::after { box-sizing: border-box; }
    .mn img { display: block; max-width: 100%; }
    .mn a { color: inherit; }

    .mn-bar {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; gap: 26px;
      padding: 13px clamp(20px, 4vw, 40px);
      background: rgba(246, 239, 225, 0.94); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--mn-line);
    }
    .mn-brand { font-family: var(--mn-serif); font-weight: 700; font-size: 23px; text-decoration: none; margin-right: auto; letter-spacing: -0.02em; }
    .mn-brand em { font-style: italic; font-weight: 400; color: var(--mn-terra); font-size: 16px; }
    .mn-bar nav { display: flex; gap: 22px; }
    .mn-bar nav a { text-decoration: none; font-size: 14px; font-weight: 500; color: var(--mn-ink2); }
    .mn-bar nav a:hover { color: var(--mn-terra); }
    .mn-res {
      font-size: 13.5px; font-weight: 600; text-decoration: none;
      border: 1.5px solid var(--mn-ink); border-radius: 999px; padding: 9px 20px;
      transition: background 0.16s ease, color 0.16s ease;
    }
    .mn-res:hover { background: var(--mn-ink); color: var(--mn-cream); }

    .mn-menu { padding: clamp(36px, 6vh, 72px) clamp(16px, 4vw, 40px) clamp(56px, 8vh, 96px); display: flex; justify-content: center; }
    .mn-sheet {
      width: min(1060px, 100%);
      background: #FFFDF6;
      border: 1px solid var(--mn-line);
      box-shadow: 0 24px 60px rgba(34, 22, 16, 0.1);
      padding: clamp(36px, 6vw, 72px) clamp(24px, 5vw, 64px);
      position: relative;
    }
    .mn-dateline { text-align: center; font-family: var(--mn-serif); font-style: italic; font-size: 15px; color: var(--mn-ink2); margin: 0 0 18px; }
    .mn-title {
      font-family: var(--mn-serif); font-weight: 600; text-align: center;
      font-size: clamp(2.8rem, 8vw, 5.6rem); line-height: 1; letter-spacing: -0.02em; margin: 0 0 8px;
    }
    .mn-title em { font-style: normal; color: var(--mn-terra); }
    .mn-title span { display: block; font-style: italic; font-weight: 400; font-size: 0.52em; margin-top: 10px; color: var(--mn-ink2); }

    .mn-courses { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 5vw, 64px); margin-top: clamp(36px, 5vw, 56px); }
    .mn-course h2 {
      font-family: var(--mn-serif); font-style: italic; font-weight: 400; font-size: 23px;
      margin: 0 0 22px; padding-bottom: 14px; border-bottom: 1px solid var(--mn-line);
    }
    .mn-course ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
    .mn-course li { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
    .mn-course li div strong { display: block; font-size: 15px; font-weight: 600; margin-bottom: 4px; }
    .mn-course li div span { font-family: var(--mn-serif); font-style: italic; font-size: 13px; color: var(--mn-ink2); }
    .mn-course li b { font-family: var(--mn-serif); font-weight: 600; font-size: 15px; }
    .mn-course li::after { content: ""; flex: 1; order: 2; border-bottom: 1px dotted var(--mn-line); margin-bottom: 5px; min-width: 14px; }
    .mn-course li div { order: 1; }
    .mn-course li b { order: 3; }
    .mn-wine { font-family: var(--mn-serif); font-size: 14.5px; color: var(--mn-ink2); margin: 30px 0 0; }
    .mn-wine em { color: var(--mn-terra); }

    .mn-aside {
      margin: clamp(36px, 5vw, 56px) 0 0; padding: 24px 28px;
      border-left: 2px solid var(--mn-terra);
      background: var(--mn-cream);
      max-width: 560px;
    }
    .mn-aside-k { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mn-terra); margin: 0 0 12px; }
    .mn-aside p:last-child { font-family: var(--mn-serif); font-style: italic; font-size: 16.5px; line-height: 1.7; margin: 0; }

    .mn-plate { margin: clamp(36px, 5vw, 56px) 0 0; max-width: 640px; }
    .mn-plate img { width: 100%; height: 340px; object-fit: cover; border-radius: 8px; }
    .mn-plate figcaption { font-family: var(--mn-serif); font-style: italic; font-size: 13.5px; color: var(--mn-ink2); margin-top: 10px; }

    .mn-fire { position: relative; overflow: clip; }
    .mn-fire img { width: 100%; height: clamp(280px, 44vh, 460px); object-fit: cover; filter: brightness(0.55) saturate(1.2); }
    .mn-fire p {
      position: absolute; inset: 0; display: grid; place-content: center; text-align: center;
      margin: 0; padding: 0 24px;
      font-family: var(--mn-serif); font-style: italic; font-size: clamp(1.6rem, 4.5vw, 2.8rem); color: #FFF8EE;
      text-shadow: 0 2px 18px rgba(0,0,0,0.6);
    }
    .mn-fire p em { color: #F3C9A8; }

    .mn-room { padding: clamp(48px, 7vh, 84px) clamp(16px, 4vw, 40px); }
    .mn-room-in { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 1180px; margin: 0 auto; }
    .mn-room figure { margin: 0; }
    .mn-room img { width: 100%; height: clamp(220px, 30vw, 360px); object-fit: cover; border-radius: 8px; }
    .mn-room figcaption { font-family: var(--mn-serif); font-style: italic; font-size: 14px; color: var(--mn-ink2); margin-top: 10px; }

    .mn-visit { padding: 0 clamp(16px, 4vw, 40px) clamp(64px, 9vh, 110px); }
    .mn-visit-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); max-width: 1080px; margin: 0 auto; align-items: start; }
    .mn-hours img { width: 100%; height: 240px; object-fit: cover; border-radius: 12px; margin-bottom: 26px; }
    .mn-hours h2, .mn-form h2 { font-family: var(--mn-serif); font-weight: 600; font-size: 30px; letter-spacing: -0.015em; margin: 0 0 20px; }
    .mn-form h2 em { font-style: italic; font-weight: 400; color: var(--mn-terra); }
    .mn-hours dl { margin: 0 0 20px; display: grid; gap: 0; border-top: 1px solid var(--mn-line); }
    .mn-hours dl div { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--mn-line); font-size: 14.5px; }
    .mn-hours dt { font-weight: 600; }
    .mn-hours dd { margin: 0; color: var(--mn-ink2); }
    .mn-hours address { font-style: normal; font-size: 15.5px; line-height: 1.9; margin-bottom: 6px; }
    .mn-hours address a { color: var(--mn-terra); font-weight: 600; text-decoration: none; }
    .mn-small { font-size: 13px; color: var(--mn-ink2); font-style: italic; font-family: var(--mn-serif); line-height: 1.6; }
    .mn-form { display: grid; gap: 16px; }
    .mn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .mn-form label { display: grid; gap: 8px; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mn-ink2); }
    .mn-form input, .mn-form select {
      font: inherit; font-size: 15px; text-transform: none; letter-spacing: 0; color: var(--mn-ink);
      padding: 13px 15px; border: 1.5px solid var(--mn-line); border-radius: 10px; background: #FFFDF7; width: 100%;
    }
    .mn-form input:focus, .mn-form select:focus { outline: 2px solid var(--mn-terra); outline-offset: 1px; }
    .mn-form button {
      background: var(--mn-terra); color: #FFF8EE; border: 0; border-radius: 999px;
      font-weight: 600; font-size: 15px; padding: 16px; cursor: pointer;
      transition: background 0.16s ease, transform 0.16s ease;
    }
    .mn-form button:hover { background: #9E3715; transform: translateY(-2px); }
    .mn-form-note { margin: 0; font-family: var(--mn-serif); font-style: italic; color: var(--mn-terra); text-align: center; }
    .mn-form-note:empty { display: none; }

    .mn-foot { border-top: 1px solid var(--mn-line); padding: 48px 20px 56px; text-align: center; }
    .mn-foot-brand { font-family: var(--mn-serif); font-size: 32px; font-weight: 600; margin: 0 0 12px; letter-spacing: -0.02em; }
    .mn-foot-brand em { font-style: italic; font-weight: 400; color: var(--mn-terra); font-size: 20px; }
    .mn-foot p:last-child { margin: 0; font-size: 12.5px; line-height: 1.8; color: var(--mn-ink2); }

    @media (max-width: 900px) {
      .mn-courses, .mn-visit-in { grid-template-columns: 1fr; }
      .mn-room-in { grid-template-columns: 1fr; }
      .mn-bar nav { display: none; }
    }
    @media (max-width: 560px) {
      .mn-row { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mn-res, .mn-form button { transition: none; }
    }
  </style>
</body>
</html>
