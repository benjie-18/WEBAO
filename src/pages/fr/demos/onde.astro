---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";
// Demo microsite: ONDE · marque audio audiophile fictive, Longueuil QC.
---
<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <DemoSeo demoId="onde" locale="fr" title="ONDE — Casques et enceintes audiophiles · Longueuil" description="ONDE est une marque audio fictive de Longueuil : casque Aura X1, écouteurs Pulse Buds et enceinte Mono One — ANC adaptatif, audio spatial, essai de 45 jours à la maison. Démo e-commerce en chrome liquide. Entreprise fictive de démonstration." ogImage="https://webao.ca/demos/onde/01.jpg" />

  <script is:inline>
    // Applique le thème enregistré avant le premier rendu pour éviter un flash.
    try {
      var t = localStorage.getItem("onde-theme");
      if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Manrope:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --od-bg: #f4f2f8;
      --od-ink: #17141d;
      --od-muted: rgba(23, 20, 29, 0.64);
      --od-faint: rgba(23, 20, 29, 0.42);
      --od-accent: #d946ef;
      --od-accent-ink: #b01fc7;
      --od-violet: #8b5cf6;
      --od-indigo: #4f46e5;
      --od-glass: rgba(255, 255, 255, 0.55);
      --od-glass-strong: rgba(255, 255, 255, 0.78);
      --od-line: rgba(23, 20, 29, 0.1);
      --od-line-bright: rgba(217, 70, 239, 0.4);
      --od-card: rgba(255, 255, 255, 0.6);
      --od-shadow: 0 24px 60px rgba(84, 52, 122, 0.14);
      --od-on-accent: #ffffff;
    }
    [data-theme="dark"] {
      --od-bg: #0b0a10;
      --od-ink: #f6f3fa;
      --od-muted: rgba(246, 243, 250, 0.64);
      --od-faint: rgba(246, 243, 250, 0.4);
      --od-accent: #e879f9;
      --od-accent-ink: #f0abfc;
      --od-violet: #a78bfa;
      --od-indigo: #818cf8;
      --od-glass: rgba(255, 255, 255, 0.05);
      --od-glass-strong: rgba(255, 255, 255, 0.09);
      --od-line: rgba(255, 255, 255, 0.11);
      --od-line-bright: rgba(232, 121, 249, 0.5);
      --od-card: rgba(18, 15, 26, 0.55);
      --od-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
      --od-on-accent: #14061a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 84px; }
    body {
      background: var(--od-bg);
      color: var(--od-ink);
      font-family: "Manrope", system-ui, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      transition: background 0.4s ease, color 0.4s ease;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; background: none; border: none; color: inherit; }
    ::selection { background: var(--od-accent); color: var(--od-on-accent); }

    /* Fond nacre ------------------------------------------------------------- */
    .od-mesh { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .od-mesh i {
      position: absolute; border-radius: 50%; filter: blur(100px);
      animation: od-drift 26s ease-in-out infinite alternate;
    }
    .od-mesh i:nth-child(1) { width: 55vw; height: 55vw; top: -20vw; left: -14vw; background: radial-gradient(circle, rgba(217, 70, 239, 0.32), transparent 68%); }
    .od-mesh i:nth-child(2) { width: 48vw; height: 48vw; top: 10vh; right: -16vw; background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 68%); animation-delay: -9s; }
    .od-mesh i:nth-child(3) { width: 36vw; height: 36vw; bottom: -12vw; left: 24vw; background: radial-gradient(circle, rgba(79, 70, 229, 0.2), transparent 70%); animation-delay: -17s; }
    [data-theme="dark"] .od-mesh i:nth-child(1) { background: radial-gradient(circle, rgba(217, 70, 239, 0.22), transparent 68%); }
    [data-theme="dark"] .od-mesh i:nth-child(2) { background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 68%); }
    [data-theme="dark"] .od-mesh i:nth-child(3) { background: radial-gradient(circle, rgba(79, 70, 229, 0.18), transparent 70%); }
    @keyframes od-drift {
      from { transform: translate3d(0, 0, 0) scale(1); }
      to { transform: translate3d(4vw, 6vh, 0) scale(1.14); }
    }

    .od-wrap { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .od-mono { font-family: "Space Mono", monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }

    /* Nav --------------------------------------------------------------------- */
    .od-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 60;
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      background: color-mix(in srgb, var(--od-bg) 72%, transparent);
      border-bottom: 1px solid var(--od-line);
    }
    .od-nav-in {
      max-width: 1180px; margin: 0 auto; padding: 13px 24px;
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px;
    }
    .od-logo { font-family: "Syne", sans-serif; font-weight: 800; font-size: 17px; letter-spacing: 0.22em; display: flex; align-items: center; gap: 9px; }
    .od-logo .od-wave-mark { display: inline-flex; align-items: flex-end; gap: 2.5px; height: 15px; }
    .od-logo .od-wave-mark i { width: 3px; border-radius: 2px; background: linear-gradient(180deg, var(--od-accent), var(--od-violet)); animation: od-eq 1.3s ease-in-out infinite; }
    .od-logo .od-wave-mark i:nth-child(1) { height: 6px; animation-delay: 0s; }
    .od-logo .od-wave-mark i:nth-child(2) { height: 14px; animation-delay: 0.18s; }
    .od-logo .od-wave-mark i:nth-child(3) { height: 9px; animation-delay: 0.36s; }
    .od-logo .od-wave-mark i:nth-child(4) { height: 13px; animation-delay: 0.54s; }
    @keyframes od-eq { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.45); } }
    .od-nav-links { display: flex; gap: 24px; align-items: center; justify-content: center; }
    .od-nav-links a { font-size: 13.5px; font-weight: 600; color: var(--od-muted); transition: color 0.2s; position: relative; }
    .od-nav-links a::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; border-radius: 2px;
      background: linear-gradient(90deg, var(--od-accent), var(--od-violet));
      transform: scaleX(0); transform-origin: left; transition: transform 0.25s ease;
    }
    .od-nav-links a:hover { color: var(--od-ink); }
    .od-nav-links a:hover::after { transform: scaleX(1); }
    .od-tools { display: flex; align-items: center; gap: 10px; justify-content: flex-end; }
    .od-lang { display: inline-flex; border: 1px solid var(--od-line); border-radius: 99px; overflow: hidden; background: var(--od-glass); }
    .od-lang a, .od-lang span { font-family: "Space Mono", monospace; font-size: 10.5px; letter-spacing: 0.08em; padding: 5px 10px; }
    .od-lang a { color: var(--od-faint); }
    .od-lang a:hover { color: var(--od-ink); }
    .od-lang span { background: linear-gradient(120deg, var(--od-accent), var(--od-violet)); color: #fff; font-weight: 700; }
    .od-iconbtn {
      width: 38px; height: 38px; border-radius: 12px; border: 1px solid var(--od-line);
      display: inline-flex; align-items: center; justify-content: center; position: relative;
      background: var(--od-glass); transition: border-color 0.2s, transform 0.15s;
    }
    .od-iconbtn:hover { border-color: var(--od-line-bright); }
    .od-iconbtn:active { transform: scale(0.94); }
    .od-iconbtn svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .od-iconbtn .od-sun { display: none; }
    [data-theme="dark"] .od-iconbtn .od-moon { display: none; }
    [data-theme="dark"] .od-iconbtn .od-sun { display: block; }
    .od-bag-count {
      position: absolute; top: -5px; right: -5px; min-width: 17px; height: 17px; padding: 0 4px;
      border-radius: 99px; background: linear-gradient(120deg, var(--od-accent), var(--od-violet));
      color: #fff; font-family: "Space Mono", monospace; font-size: 10px; font-weight: 700;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .od-bag-count.is-bump { animation: od-bump 0.45s cubic-bezier(0.2, 1.6, 0.4, 1); }
    @keyframes od-bump { 0% { transform: scale(1); } 40% { transform: scale(1.45); } 100% { transform: scale(1); } }
    .od-burger { display: none; }

    /* Héros -------------------------------------------------------------------- */
    .od-hero { padding: 148px 0 0; text-align: center; }
    .od-drop-pill {
      display: inline-flex; align-items: center; gap: 9px; padding: 7px 15px;
      border-radius: 99px; border: 1px solid var(--od-line-bright);
      background: var(--od-glass); backdrop-filter: blur(12px);
      color: var(--od-accent-ink); font-weight: 600;
    }
    .od-drop-pill i { width: 7px; height: 7px; border-radius: 50%; background: var(--od-accent); box-shadow: 0 0 10px var(--od-accent); animation: od-pulse 1.6s ease-in-out infinite; }
    @keyframes od-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    .od-h1 {
      font-family: "Syne", sans-serif; font-weight: 800;
      font-size: clamp(2.7rem, 7vw, 5.2rem); line-height: 1.02; letter-spacing: -0.025em;
      margin: 24px auto 20px; max-width: 15ch; text-wrap: balance;
    }
    .od-h1 em {
      font-style: normal;
      background: linear-gradient(100deg, var(--od-accent) 5%, var(--od-violet) 55%, var(--od-indigo) 105%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .od-hero-sub { color: var(--od-muted); font-size: 17.5px; max-width: 54ch; margin: 0 auto; }
    .od-ctas { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; justify-content: center; }
    .od-btn {
      display: inline-flex; align-items: center; gap: 9px; padding: 15px 27px;
      border-radius: 99px; font-weight: 700; font-size: 14.5px;
      transition: transform 0.18s, box-shadow 0.25s, border-color 0.2s;
    }
    .od-btn:active { transform: scale(0.97); }
    .od-btn-primary {
      background: linear-gradient(120deg, var(--od-accent), var(--od-violet) 90%);
      color: #fff; box-shadow: 0 10px 34px rgba(217, 70, 239, 0.35);
    }
    .od-btn-primary:hover { box-shadow: 0 14px 44px rgba(217, 70, 239, 0.5); transform: translateY(-2px); }
    .od-btn-ghost { border: 1px solid var(--od-line); background: var(--od-glass); backdrop-filter: blur(12px); color: var(--od-ink); }
    .od-btn-ghost:hover { border-color: var(--od-line-bright); transform: translateY(-2px); }
    .od-hero-stats { display: flex; gap: 34px; margin-top: 34px; flex-wrap: wrap; justify-content: center; }
    .od-hero-stats div { display: flex; flex-direction: column; gap: 2px; align-items: center; }
    .od-hero-stats strong { font-family: "Syne", sans-serif; font-size: 19px; font-weight: 800; }
    .od-hero-stats span { color: var(--od-faint); font-size: 12px; }

    .od-hero-stage { position: relative; max-width: 1020px; margin: 56px auto 0; perspective: 1300px; }
    .od-hero-card {
      position: relative; border-radius: 28px; overflow: hidden;
      border: 1px solid var(--od-line); background: var(--od-card);
      box-shadow: var(--od-shadow);
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      transform-style: preserve-3d; transition: transform 0.15s ease-out;
      animation: od-float 8s ease-in-out infinite;
      will-change: transform;
    }
    @keyframes od-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -11px; } }
    .od-hero-card img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
    .od-hero-chip {
      position: absolute; top: 18px; right: 18px; padding: 10px 16px; border-radius: 99px;
      background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(14px);
      border: 1px solid rgba(217, 70, 239, 0.35); color: #b01fc7;
      font-family: "Syne", sans-serif; font-weight: 800; font-size: 14px;
    }
    [data-theme="dark"] .od-hero-chip { background: rgba(11, 10, 16, 0.66); color: #f0abfc; }
    .od-hero-tag {
      position: absolute; left: 16px; bottom: 16px; padding: 9px 14px; border-radius: 14px;
      background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.6); color: #17141d;
      display: flex; align-items: center; gap: 10px;
    }
    [data-theme="dark"] .od-hero-tag { background: rgba(11, 10, 16, 0.66); border-color: rgba(255,255,255,.14); color: #f6f3fa; }
    .od-hero-tag b { color: var(--od-accent-ink); font-weight: 700; }
    [data-theme="dark"] .od-hero-tag b { color: #f0abfc; }
    .od-hero-wave {
      position: absolute; left: 50%; bottom: -26px; transform: translateX(-50%);
      display: flex; align-items: flex-end; gap: 4px; height: 52px; padding: 0 22px;
      background: var(--od-glass-strong); backdrop-filter: blur(16px);
      border: 1px solid var(--od-line-bright); border-radius: 99px; box-shadow: var(--od-shadow);
    }
    .od-hero-wave i { width: 4px; border-radius: 3px; background: linear-gradient(180deg, var(--od-accent), var(--od-violet)); animation: od-eq 1.2s ease-in-out infinite; }
    .od-hero-wave i:nth-child(1) { height: 14px; animation-delay: 0s; }
    .od-hero-wave i:nth-child(2) { height: 26px; animation-delay: 0.12s; }
    .od-hero-wave i:nth-child(3) { height: 18px; animation-delay: 0.24s; }
    .od-hero-wave i:nth-child(4) { height: 34px; animation-delay: 0.36s; }
    .od-hero-wave i:nth-child(5) { height: 22px; animation-delay: 0.48s; }
    .od-hero-wave i:nth-child(6) { height: 30px; animation-delay: 0.6s; }
    .od-hero-wave i:nth-child(7) { height: 15px; animation-delay: 0.72s; }

    /* Bandeau -------------------------------------------------------------------- */
    .od-marquee {
      margin: 76px 0 0; border-top: 1px solid var(--od-line); border-bottom: 1px solid var(--od-line);
      overflow: hidden; background: var(--od-glass); backdrop-filter: blur(10px);
    }
    .od-marquee-in { display: flex; width: max-content; animation: od-scroll 28s linear infinite; }
    .od-marquee:hover .od-marquee-in { animation-play-state: paused; }
    .od-marquee span {
      font-family: "Space Mono", monospace; font-size: 11.5px; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--od-muted); padding: 13px 0; white-space: nowrap;
    }
    .od-marquee span i { color: var(--od-accent-ink); font-style: normal; padding: 0 18px; }
    @keyframes od-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* Sections ---------------------------------------------------------------------- */
    .od-section { padding: 110px 0 0; }
    .od-eyebrow { color: var(--od-accent-ink); margin-bottom: 16px; }
    .od-h2 {
      font-family: "Syne", sans-serif; font-weight: 800;
      font-size: clamp(1.7rem, 3.5vw, 2.8rem); line-height: 1.07; letter-spacing: -0.02em;
      max-width: 24ch; text-wrap: balance;
    }
    .od-section-sub { color: var(--od-muted); margin-top: 14px; max-width: 56ch; }
    .od-center { text-align: center; }
    .od-center .od-h2, .od-center .od-section-sub { margin-left: auto; margin-right: auto; }

    .od-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .od-reveal.is-in { opacity: 1; transform: none; }

    /* Innovation ---------------------------------------------------------------------- */
    .od-tech-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; margin-top: 44px; align-items: stretch; }
    .od-card {
      border: 1px solid var(--od-line); border-radius: 24px; padding: 26px 24px;
      background: var(--od-card); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.3s, box-shadow 0.3s;
      position: relative; overflow: hidden;
    }
    .od-card:hover { transform: translateY(-6px); border-color: var(--od-line-bright); box-shadow: var(--od-shadow); }

    .od-lab { display: flex; flex-direction: column; gap: 18px; }
    .od-lab-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .od-lab-head h3 { font-family: "Syne", sans-serif; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; }
    .od-lab-pct { font-family: "Syne", sans-serif; font-weight: 800; font-size: 42px; line-height: 1; letter-spacing: -0.03em;
      background: linear-gradient(100deg, var(--od-accent), var(--od-violet));
      -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums;
    }
    .od-wave {
      display: flex; align-items: flex-end; gap: 3px; height: 120px;
      padding: 14px 16px; border-radius: 18px;
      background: var(--od-glass); border: 1px solid var(--od-line); overflow: hidden;
    }
    .od-wave i {
      flex: 1; min-width: 3px; border-radius: 3px; background: linear-gradient(180deg, var(--od-accent), var(--od-violet));
      opacity: 0.85; transition: height 0.18s ease;
    }
    .od-slider-row { display: flex; flex-direction: column; gap: 10px; }
    .od-slider-row input[type="range"] {
      -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 99px;
      background: linear-gradient(90deg, var(--od-accent) var(--od-fill, 65%), var(--od-line) var(--od-fill, 65%));
      outline: none; cursor: pointer;
    }
    .od-slider-row input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%;
      background: #fff; border: 3px solid var(--od-accent);
      box-shadow: 0 4px 14px rgba(217, 70, 239, 0.4); transition: transform 0.15s;
    }
    .od-slider-row input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.12); }
    .od-slider-row input[type="range"]::-moz-range-thumb {
      width: 24px; height: 24px; border-radius: 50%;
      background: #fff; border: 3px solid var(--od-accent);
      box-shadow: 0 4px 14px rgba(217, 70, 239, 0.4);
    }
    .od-lab-label { display: flex; justify-content: space-between; gap: 12px; color: var(--od-faint); }
    .od-lab-state { color: var(--od-accent-ink); font-weight: 700; }

    .od-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .od-mini h3 { font-family: "Syne", sans-serif; font-size: 15.5px; font-weight: 800; margin-bottom: 8px; letter-spacing: -0.01em; }
    .od-mini p { color: var(--od-muted); font-size: 13.5px; line-height: 1.6; }
    .od-mini p b { color: var(--od-accent-ink); font-weight: 700; }
    .od-mini-ico {
      width: 42px; height: 42px; border-radius: 14px; margin-bottom: 16px;
      background: var(--od-glass-strong); border: 1px solid var(--od-line);
      display: flex; align-items: center; justify-content: center; color: var(--od-accent-ink);
    }
    .od-mini-ico svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

    /* Collection ------------------------------------------------------------------------ */
    .od-products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
    .od-product { display: flex; flex-direction: column; }
    .od-product-img {
      position: relative; border-radius: 22px; overflow: hidden; border: 1px solid var(--od-line);
      background: var(--od-glass); aspect-ratio: 4 / 3;
    }
    .od-product-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .od-product:hover .od-product-img img { transform: scale(1.06); }
    .od-badge {
      position: absolute; top: 14px; left: 14px; padding: 6px 12px; border-radius: 99px;
      background: rgba(255, 255, 255, 0.74); backdrop-filter: blur(12px); border: 1px solid rgba(217, 70, 239, 0.3);
      color: #b01fc7; font-family: "Space Mono", monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
    }
    [data-theme="dark"] .od-badge { background: rgba(11, 10, 16, 0.66); color: #f0abfc; border-color: rgba(232, 121, 249, 0.35); }
    .od-badge b { font-weight: 700; }
    .od-product-body { padding: 18px 6px 0; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .od-product-cat { color: var(--od-faint); }
    .od-product h3 { font-family: "Syne", sans-serif; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; }
    .od-product p { color: var(--od-muted); font-size: 13.5px; flex: 1; }
    .od-finish { color: var(--od-faint); font-size: 12px; }
    .od-finish b { color: var(--od-ink); font-weight: 700; }
    .od-swatches { display: flex; gap: 8px; margin-top: 2px; }
    .od-swatch {
      width: 24px; height: 24px; border-radius: 50%; border: 2px solid transparent; padding: 2px;
      background-clip: content-box; transition: transform 0.15s, border-color 0.2s; cursor: pointer;
    }
    .od-swatch[aria-pressed="true"] { border-color: var(--od-accent); }
    .od-swatch:hover { transform: scale(1.12); }
    .od-swatch:focus-visible { outline: 2px solid var(--od-violet); outline-offset: 2px; }
