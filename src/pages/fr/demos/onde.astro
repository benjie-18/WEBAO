    .od-socials svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .od-foot-col h4 { font-family: "Space Mono", monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--od-faint); margin-bottom: 16px; }
    .od-foot-col a { display: block; color: var(--od-muted); font-size: 13.5px; padding: 5px 0; transition: color 0.2s; }
    .od-foot-col a:hover { color: var(--od-accent-ink); }
    .od-legal {
      margin-top: 52px; padding-top: 24px; border-top: 1px solid var(--od-line);
      display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap;
      color: var(--od-faint); font-size: 12px;
    }

    /* Notification ---------------------------------------------------------------------------- */
    .od-toast {
      position: fixed; bottom: 26px; left: 50%; transform: translate(-50%, 80px); z-index: 80;
      padding: 14px 22px; border-radius: 99px; border: 1px solid var(--od-line-bright);
      background: var(--od-glass-strong); backdrop-filter: blur(18px);
      color: var(--od-ink); font-size: 14px; font-weight: 600; box-shadow: var(--od-shadow);
      opacity: 0; pointer-events: none; transition: transform 0.4s cubic-bezier(0.2, 1.4, 0.4, 1), opacity 0.3s;
      display: flex; align-items: center; gap: 10px;
    }
    .od-toast i { width: 8px; height: 8px; border-radius: 50%; background: var(--od-accent); box-shadow: 0 0 10px var(--od-accent); }
    .od-toast.is-show { transform: translate(-50%, 0); opacity: 1; }

    /* Réactif ---------------------------------------------------------------------------------- */
    @media (max-width: 1020px) {
      .od-tech-grid { grid-template-columns: 1fr; }
      .od-products { grid-template-columns: repeat(2, 1fr); }
      .od-quotes { grid-template-columns: 1fr; }
      .od-stats { grid-template-columns: repeat(2, 1fr); }
      .od-foot-grid { grid-template-columns: 1fr 1fr; }
      .od-cta { grid-template-columns: 1fr; padding: 44px 32px; }
