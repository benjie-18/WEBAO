      .od-nav-links a { padding: 13px 0; border-bottom: 1px solid var(--od-line); font-size: 15px; }
      .od-nav-links a::after { display: none; }
      .od-nav-links a:last-child { border-bottom: 0; }
      .od-burger { display: inline-flex; }
      .od-products { grid-template-columns: 1fr; }
      .od-mini-grid { grid-template-columns: 1fr; }
      .od-form-row { flex-direction: column; }
      .od-form .od-btn { justify-content: center; }
      .od-section { padding-top: 84px; }
      .od-foot-grid { grid-template-columns: 1fr; gap: 30px; }
      .od-hero-stats { gap: 22px; }
      .od-score-row { flex-direction: column; align-items: flex-start; }
      .od-score-row p { text-align: left; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      .od-reveal { opacity: 1; transform: none; }
    }
