    .od-press:hover .od-press-in { animation-play-state: paused; }
    .od-press span {
      font-family: "Syne", sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 0.24em;
      text-transform: uppercase; color: var(--od-faint); padding: 15px 0; white-space: nowrap;
      transition: color 0.2s;
    }
    .od-press span:hover { color: var(--od-ink); }
    .od-press span i { color: var(--od-accent-ink); font-style: normal; padding: 0 26px; font-size: 10px; vertical-align: 2px; }
    .od-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 34px; }
    .od-quote {
