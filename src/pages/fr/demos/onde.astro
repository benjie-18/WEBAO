  <div class="od-toast" id="od-toast" role="status" aria-live="polite"><i aria-hidden="true"></i><span id="od-toast-text"></span></div>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      const root = document.documentElement;

      // Thème ------------------------------------------------------------------
      const themeBtn = document.getElementById("od-theme") as HTMLButtonElement | null;
      const syncTheme = function () {
        const light = root.getAttribute("data-theme") !== "dark";
        if (themeBtn) {
          themeBtn.setAttribute("aria-pressed", String(!light));
          themeBtn.setAttribute("aria-label", light ? "Passer en mode sombre" : "Passer en mode clair");
        }
      };
      syncTheme();
      themeBtn?.addEventListener("click", function () {
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("onde-theme", next); } catch (e) {}
        syncTheme();
      });

      // Menu mobile ------------------------------------------------------------
      const nav = document.getElementById("od-nav");
      const burger = document.getElementById("od-burger") as HTMLButtonElement | null;
      burger?.addEventListener("click", function () {
        const open = nav?.classList.toggle("is-open") ?? false;
        burger?.setAttribute("aria-expanded", String(open));
      });
      nav?.querySelectorAll(".od-nav-links a").forEach(function (link) {
        link.addEventListener("click", function () {
          nav?.classList.remove("is-open");
          burger?.setAttribute("aria-expanded", "false");
        });
      });

      // Révélation au défilement -----------------------------------------------
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll(".od-reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach(function (el) { el.classList.add("is-in"); });
      } else {
        const io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -6% 0px" });
        reveals.forEach(function (el) { io.observe(el); });
      }

      // Parallaxe du héros + inclinaison ----------------------------------------
      const stage = document.getElementById("od-stage");
      const heroCard = document.getElementById("od-hero-card");
      if (stage && heroCard && !reduce) {
        let raf = 0;
        const onScroll = function () {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(function () {
            const r = stage.getBoundingClientRect();
            if (r.bottom > 0 && r.top < window.innerHeight) {
              const shift = (window.innerHeight - r.top) * 0.03;
              // La parallaxe vit sur #od-stage : la carte garde son flottement
              // (od-float anime `translate`) et son tilt (`transform`) en paix.
              stage.style.translate = "0 " + (-shift * 0.4).toFixed(1) + "px";
            }
          });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
          stage.addEventListener("pointermove", function (e) {
            const r = stage.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            heroCard.style.transform = "rotateY(" + (x * 7).toFixed(2) + "deg) rotateX(" + (-y * 7).toFixed(2) + "deg)";
          });
          stage.addEventListener("pointerleave", function () {
            heroCard.style.transform = "";
          });
        }
      }

      // Labo ANC ----------------------------------------------------------------
      const waveEl = document.getElementById("od-wave");
      const ancInput = document.getElementById("od-anc") as HTMLInputElement | null;
      const pctEl = document.getElementById("od-pct");
      const stateEl = document.getElementById("od-state");
      const bars: HTMLElement[] = [];
      if (waveEl) {
        for (let i = 0; i < 44; i++) {
          const bar = document.createElement("i");
          const base = 26 + 58 * Math.abs(Math.sin(i * 0.55)) + 16 * Math.abs(Math.cos(i * 1.7));
          bar.dataset.base = String(Math.min(100, Math.round(base)));
          bar.style.height = "20%";
          waveEl.appendChild(bar);
          bars.push(bar);
        }
      }
      const paintWave = function (value: number) {
        const amp = 0.14 + (value / 100) * 0.86;
        bars.forEach(function (bar) {
          const base = Number(bar.dataset.base ?? "40");
          bar.style.height = Math.max(6, Math.round(base * amp)) + "%";
        });
        if (pctEl) pctEl.textContent = value + " %";
        if (ancInput) ancInput.style.setProperty("--od-fill", value + "%");
        if (stateEl) {
          stateEl.textContent = value < 34 ? "Monde : vivant" : value < 67 ? "Monde : adouci" : "Monde : muet";
        }
      };
      if (ancInput) {
        paintWave(Number(ancInput.value));
        ancInput.addEventListener("input", function () { paintWave(Number(ancInput.value)); });
      }

      // Finitions ------------------------------------------------------------------
      document.querySelectorAll<HTMLElement>(".od-product").forEach(function (card) {
        const label = card.querySelector<HTMLElement>("[data-finish-label]");
        card.querySelectorAll<HTMLButtonElement>(".od-swatch").forEach(function (sw) {
          sw.addEventListener("click", function () {
            card.querySelectorAll(".od-swatch").forEach(function (s) { s.setAttribute("aria-pressed", "false"); });
            sw.setAttribute("aria-pressed", "true");
            if (label) label.textContent = sw.getAttribute("data-finish") ?? "";
          });
        });
      });

      // Compteur de panier + notification --------------------------------------------
      let count = 0;
      const countEl = document.getElementById("od-count");
      const bagBtn = document.getElementById("od-bag");
      const toast = document.getElementById("od-toast");
      const toastText = document.getElementById("od-toast-text");
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      const showToast = function (msg: string) {
        if (!toast || !toastText) return;
        const toastEl: HTMLElement = toast;
        const textEl: HTMLElement = toastText;
        textEl.textContent = msg;
        toastEl.classList.add("is-show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toastEl.classList.remove("is-show"); }, 2400);
      };
      document.querySelectorAll<HTMLButtonElement>(".od-add").forEach(function (btn) {
        btn.addEventListener("click", function () {
          count += 1;
          if (countEl) {
            countEl.textContent = String(count);
            countEl.classList.remove("is-bump");
            void countEl.offsetWidth;
            countEl.classList.add("is-bump");
          }
          bagBtn?.setAttribute("aria-label", "Panier, " + count + (count === 1 ? " article" : " articles"));
          showToast("Ajouté — " + (btn.getAttribute("data-name") ?? "article"));
        });
      });
      bagBtn?.addEventListener("click", function () {
        showToast(count === 0 ? "Votre panier est vide — la collection vous attend." : count + (count === 1 ? " article" : " articles") + " dans votre panier (démo).");
      });

      // Formulaire d'alertes ------------------------------------------------------------
      const form = document.getElementById("od-alert-form") as HTMLFormElement | null;
      const done = document.getElementById("od-alert-done");
      if (form) {
        const formEl: HTMLFormElement = form;
        formEl.addEventListener("submit", function (e) {
          e.preventDefault();
          const email = (formEl.querySelector("input") as HTMLInputElement | null)?.value ?? "";
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            showToast("Entrez un courriel valide pour recevoir les alertes.");
            return;
          }
          formEl.hidden = true;
          const note = formEl.parentElement?.querySelector<HTMLElement>(".od-form-note");
          if (note) note.hidden = true;
          if (done) done.hidden = false;
        });
      }

      // Compteurs animés -------------------------------------------------------------------
      const stats = document.querySelectorAll<HTMLElement>("strong[data-count]");
      const runCount = function (el: HTMLElement) {
        const end = Number(el.getAttribute("data-count") ?? "0");
        const suffix = el.getAttribute("data-suffix") ?? "";
        if (reduce) { el.textContent = end.toLocaleString("fr-CA") + suffix; return; }
        const t0 = performance.now();
        const dur = 1400;
        const step = function (now: number) {
          const p = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(end * eased).toLocaleString("fr-CA") + suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if (!("IntersectionObserver" in window)) {
        stats.forEach(runCount);
      } else {
        const sio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              runCount(entry.target as HTMLElement);
              sio.unobserve(entry.target);
            }
          });
        }, { threshold: 0.4 });
        stats.forEach(function (el) { sio.observe(el); });
      }
    })();
  </script>
