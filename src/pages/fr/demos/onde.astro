    .od-foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 36px; }
    .od-foot-brand p { color: var(--od-muted); font-size: 13.5px; margin-top: 14px; max-width: 34ch; }
    .od-socials { display: flex; gap: 10px; margin-top: 20px; }
