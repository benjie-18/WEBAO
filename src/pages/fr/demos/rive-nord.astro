    .rn-rate-side .rn-rate-price { margin: 0 0 6px; }
    .rn-card-cta { margin-top: auto; font-weight: 700; color: var(--rn-charcoal); text-decoration: underline; text-decoration-color: var(--rn-yellow); text-decoration-thickness: 3px; }
    .rn-wide-img { margin: 36px 0 0; }
    .rn-wide-img img { width: 100%; height: 340px; object-fit: cover; border-radius: 12px; }

    .rn-how { background: var(--rn-charcoal); color: #fff; }
    .rn-how-in {
      max-width: 1180px; margin: 0 auto; padding: clamp(48px, 8vh, 84px) clamp(16px, 4vw, 32px);
      display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: center;
    }
    .rn-how .rn-h2 { color: #fff; }
    .rn-steps { list-style: none; margin: 0 0 22px; padding: 0; }
    .rn-steps li { font-size: 16.5px; line-height: 1.65; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.2); }
    .rn-steps strong { display: block; font-family: var(--rn-oswald); text-transform: uppercase; font-size: 1.4rem; margin-bottom: 4px; }
    .rn-how p { font-size: 16px; line-height: 1.65; color: rgba(255,255,255,0.9); }
    .rn-how img { width: 100%; height: 380px; object-fit: cover; border-radius: 12px; border: 4px solid var(--rn-yellow); }

    .rn-checklist {
      list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 28px;
    }
    .rn-checklist li { font-weight: 600; font-size: 16px; }
    .rn-checklist li::before { content: "\2713  "; color: #1E7B34; }

    .rn-pricing { background: #fff; max-width: none; }
    .rn-pricing > * { max-width: 1180px; margin-left: auto; margin-right: auto; }
    .rn-defs { margin: 0 0 32px; }
    .rn-defs > div { border-top: 2px solid var(--rn-charcoal); padding: 18px 0; }
    .rn-defs dt { font-family: var(--rn-oswald); text-transform: uppercase; font-size: 1.3rem; margin: 0 0 8px; color: var(--rn-charcoal); }
    .rn-defs dd { margin: 0; font-size: 15.5px; line-height: 1.65; max-width: 72ch; }
    .rn-valuation p { font-size: 15.5px; line-height: 1.65; }
    .rn-bullets { font-size: 16px; line-height: 1.7; margin: 0 0 32px; padding-left: 22px; }
    .rn-valuation { background: var(--rn-plaster); border: 2px solid var(--rn-charcoal); border-radius: 12px; padding: 24px 28px; }
    .rn-valuation .rn-h3 { color: var(--rn-charcoal); }

    .rn-review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .rn-review {
      background: #fff; border-radius: 12px; padding: 24px; border: 2px solid var(--rn-charcoal);
      display: flex; flex-direction: column;
    }
    .rn-review-type {
      margin: 0 0 8px; font-weight: 700; font-size: 13px; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--rn-charcoal);
    }
    .rn-stars { margin: 0 0 12px; color: #B8860B; font-size: 18px; letter-spacing: 2px; }
    .rn-review blockquote { margin: 0 0 16px; font-size: 16px; line-height: 1.65; }
    .rn-review-who { margin: auto 0 0; font-size: 14px; font-weight: 600; color: rgba(27,29,33,0.7); }

    .rn-areas { background: var(--rn-charcoal); color: #fff; }
    .rn-areas-in {
      max-width: 1180px; margin: 0 auto; padding: clamp(48px, 8vh, 84px) clamp(16px, 4vw, 32px);
      display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: center;
    }
    .rn-areas .rn-h2 { color: #fff; }
    .rn-areas p { font-size: 16.5px; line-height: 1.7; color: rgba(255,255,255,0.92); }
    .rn-areas img { width: 100%; height: 380px; object-fit: cover; border-radius: 12px; border: 4px solid var(--rn-yellow); }

    .rn-faq-list { margin: 0; }
    .rn-faq-list div { border-bottom: 2px solid var(--rn-charcoal); padding: 20px 0; }
    .rn-faq-list dt { font-family: var(--rn-oswald); text-transform: uppercase; font-size: 1.25rem; color: var(--rn-charcoal); margin-bottom: 6px; }
    .rn-faq-list dd { margin: 0; font-size: 16px; line-height: 1.65; max-width: 72ch; }

    .rn-contact { background: var(--rn-yellow); text-align: center; padding: clamp(48px, 8vh, 84px) clamp(16px, 4vw, 32px); }
    .rn-contact .rn-h2 { margin-bottom: 8px; }
    .rn-contact-lede { font-size: 17px; font-weight: 600; margin: 0 0 20px; }
    .rn-call-light { background: var(--rn-charcoal); color: #fff; }
    .rn-contact-mail { font-weight: 700; font-size: 18px; }
    .rn-contact p { font-size: 16.5px; line-height: 1.7; }

    .rn-foot { background: var(--rn-charcoal); color: rgba(255,255,255,0.8); text-align: center; padding: 36px 20px 24px; font-size: 14px; line-height: 1.9; }
    .rn-foot p { margin: 0; }

    .rn-sticky {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 950;
      display: none; gap: 10px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgba(59,63,69,0.97); border-top: 3px solid var(--rn-yellow);
    }
    .rn-sticky a {
      flex: 1; text-align: center; text-decoration: none; font-weight: 700; font-size: 16px;
      padding: 13px 10px; border-radius: 8px; min-height: 48px;
    }
    .rn-sticky a:first-child { background: #fff; color: var(--rn-charcoal); }
    .rn-sticky a:last-child { background: var(--rn-yellow); color: var(--rn-charcoal); }

    @media (max-width: 900px) {
      .rn-hero-in, .rn-how-in, .rn-areas-in { grid-template-columns: 1fr; }
      .rn-review-grid { grid-template-columns: 1fr 1fr; }
      .rn-menu-btn { display: block; }
      .rn-nav {
        display: none; flex-basis: 100%; flex-direction: column; margin: 0;
      }
      .rn-nav-open { display: flex; }
      .rn-header-cta { margin-left: 0; }
      .rn-header-stars { display: none; }
    }
    @media (max-width: 640px) {
      .rn-grid, .rn-review-grid, .rn-checklist { grid-template-columns: 1fr; }
      .rn-rate-row { grid-template-columns: 1fr; }
      .rn-rate-side { text-align: left; }
      .rn-sticky { display: flex; }
      /* Lift the shared EscapeHatch above the sticky bar so Call stays tappable; !important beats the component's scoped rule. */
      :global(.demo-exit) { bottom: calc(84px + env(safe-area-inset-bottom, 0px)) !important; }
      .rn-header-phone { display: none; }
      .rn-wide-img img, .rn-how img, .rn-areas img { height: 240px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .rn-btn, .rn-call-big { transition: none; }
    }
  </style>
</body>
</html>
