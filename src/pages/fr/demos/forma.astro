---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : Studio Forma, studio d'architecture intérieure fictif, Montréal QC.
// Luxe minimaliste éditorial occidental : os/charbon, grands blancs, filets fins,
// grandes images de projets, mélange raffiné serif/sans. Aucun motif japonais.
// Direction artistique autonome. Hors du système de thème WEBAO.
const IMG = {
  hero: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1800&auto=format&fit=crop",
  p1: "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=1200&auto=format&fit=crop",
  p2: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=1200&auto=format&fit=crop",
  p3: "https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?q=80&w=1200&auto=format&fit=crop",
  studio: "https://images.unsplash.com/photo-1617806118233-18e1de247200?q=80&w=1000&auto=format&fit=crop",
  detail: "https://images.unsplash.com/photo-1615874959474-d609969a20ed?q=80&w=1000&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Studio Forma : architecture intérieure à Montréal</title>
  <meta name="description" content="Studio Forma : architecture intérieure à Montréal. Intérieurs résidentiels et commerciaux composés avec retenue. Voyez nos projets et commencez un mandat." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="fm">

  <!-- NAVIGATION -->
  <header class="fm-nav">
    <a class="fm-wordmark" href="#top" aria-label="Studio Forma, accueil">Forma<sup>®</sup></a>
    <nav class="fm-links" aria-label="Principal">
      <a href="#projects">Projets</a>
      <a href="#practice">Pratique</a>
      <a href="#studio">Studio</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <!-- HÉROS -->
    <section class="fm-hero">
      <figure class="fm-hero-media">
        <img src={IMG.hero} alt="Un salon luxueux et serein baigné de lumière douce avec mobilier sculptural" loading="eager" fetchpriority="high" />
      </figure>
      <div class="fm-hero-copy">
        <p class="fm-meta">Architecture intérieure · Montréal, depuis 2009</p>
        <h1 class="fm-h1">L'espace,<br />composé.</h1>
        <p class="fm-hero-note">Des intérieurs résidentiels et commerciaux dessinés avec retenue, bâtis pour durer plus longtemps que les tendances.</p>
      </div>
    </section>

    <!-- MANIFESTE -->
    <section class="fm-manifesto">
      <div class="fm-wrap">
        <p class="fm-rule-label">La pratique</p>
        <p class="fm-manifesto-text">Nous croyons qu'une pièce devrait vous porter comme un bon tailleur porte une épaule : avec précision, en silence, sans demander l'attention. Moins de matériaux, mieux choisis. Moins de décoration, plus de proportion.</p>
        <p class="fm-manifesto-sub">Chaque mandat commence par votre façon d'habiter, pas par la façon dont une pièce se photographie. La photo suit.</p>
      </div>
    </section>

    <!-- PROJETS -->
    <section class="fm-projects" id="projects">
      <div class="fm-wrap">
        <div class="fm-section-head">
          <p class="fm-meta">Réalisations choisies</p>
          <h2 class="fm-h2">Projets</h2>
        </div>

        <article class="fm-project">
          <span class="fm-project-no" aria-hidden="true">01</span>
          <figure class="fm-project-media fm-reveal">
            <img src={IMG.p1} alt="Salon minimaliste chaleureux avec canapé courbe et plancher de chêne" loading="lazy" />
          </figure>
          <div class="fm-project-copy">
            <h3>Résidence Atelier</h3>
            <p class="fm-project-meta">Outremont · 2024 · 280 m²</p>
            <p>Une maison familiale composée autour d'une seule épine de chêne : cuisine, bibliothèque et escalier dessinés d'un seul geste. Murs de plâtre, pierre adoucie, rien qui crie.</p>
          </div>
        </article>

        <article class="fm-project fm-flip">
          <span class="fm-project-no" aria-hidden="true">02</span>
          <figure class="fm-project-media fm-reveal">
            <img src={IMG.p2} alt="Cuisine raffinée avec îlot de pierre et douce lumière naturelle" loading="lazy" />
          </figure>
          <div class="fm-project-copy">
            <h3>Maison Cèdre</h3>
            <p class="fm-project-meta">Westmount · 2023 · 340 m²</p>
            <p>Une cuisine pensée pour un chef qui déteste le fouillis. Rangement dissimulé, îlot de pierre de douze pieds, et une lumière qui fait la décoration.</p>
          </div>
        </article>

        <article class="fm-project">
          <span class="fm-project-no" aria-hidden="true">03</span>
          <figure class="fm-project-media fm-reveal">
            <img src={IMG.p3} alt="Salle de bain apaisante en pierre avec robinetterie laiton brossé" loading="lazy" />
          </figure>
          <div class="fm-project-copy">
            <h3>Bain de pierre</h3>
            <p class="fm-project-meta">Vieux-Montréal · 2025 · 45 m²</p>
            <p>Un bain taillé dans une seule palette : calcaire, laiton brossé et silence. La preuve que les petites pièces méritent la même rigueur que les grandes.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="fm-services" id="practice">
      <div class="fm-wrap">
        <div class="fm-section-head">
          <p class="fm-meta">Services</p>
          <h2 class="fm-h2">Ce que nous prenons en charge</h2>
        </div>
        <ul class="fm-service-list">
          <li>
            <div><h3>Résidentiel clé en main</h3><p>De la première esquisse au stylisme final. Architecture, menuiserie, éclairage et mobilier sous un même toit.</p></div>
            <span>01</span>
          </li>
          <li>
            <div><h3>Commercial et détail</h3><p>Restaurants, boutiques et bureaux où la pièce fait partie de la marque.</p></div>
            <span>02</span>
          </li>
          <li>
            <div><h3>Études de couleur et matière</h3><p>Palettes, échantillons et devis descriptifs pour votre propre entrepreneur.</p></div>
            <span>03</span>
          </li>
          <li>
            <div><h3>Direction artistique pour promoteurs</h3><p>Unités modèles et espaces communs qui vendent l'immeuble avant sa construction.</p></div>
            <span>04</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- STUDIO -->
    <section class="fm-studio" id="studio">
      <div class="fm-wrap fm-studio-grid">
        <figure class="fm-studio-media fm-reveal">
          <img src={IMG.studio} alt="Une chambre apaisée avec literie de lin et douce lumière du matin" loading="lazy" />
        </figure>
        <div>
          <p class="fm-meta">Le studio</p>
          <h2 class="fm-h2">Onze personnes.<br />Une seule exigence.</h2>
          <p class="fm-prose">Forma a été fondé en 2009 par l'architecte Hélène Marchand. Le studio reste volontairement petit : onze architectes et designers, deux projets par associé, et des visites de chantier jamais déléguées à des inconnus.</p>
          <p class="fm-prose">On publie peu et on photographie moins. La plupart des mandats arrivent par recommandation, et c'est très bien ainsi.</p>
          <dl class="fm-studio-facts">
            <div><dt>Fondation</dt><dd>2009, Montréal</dd></div>
            <div><dt>Équipe</dt><dd>11 architectes et designers</dd></div>
            <div><dt>Réalisés</dt><dd>140 intérieurs</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- INTERMÈDE -->
    <section class="fm-interlude">
      <figure class="fm-interlude-media fm-reveal">
        <img src={IMG.detail} alt="Gros plan d'un fauteuil sculptural devant un mur de plâtre" loading="lazy" />
        <figcaption>Détail, Résidence Atelier</figcaption>
      </figure>
    </section>

    <!-- DÉMARCHE -->
    <section class="fm-process">
      <div class="fm-wrap">
        <div class="fm-section-head">
          <p class="fm-meta">Démarche</p>
          <h2 class="fm-h2">Comment se déroule un mandat</h2>
        </div>
        <ol class="fm-process-list">
          <li><strong>Conversation</strong><span>On se rencontre, on écoute, on visite votre espace. Sans frais, sans présentation.</span></li>
          <li><strong>Étude</strong><span>Relevés, précédents et une première direction à commenter.</span></li>
          <li><strong>Conception</strong><span>Plans, matériaux et prix développés ensemble, par étapes.</span></li>
          <li><strong>Réalisation</strong><span>Suivi de chantier jusqu'au dernier ajustement de penture.</span></li>
        </ol>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="fm-contact" id="contact">
      <div class="fm-wrap">
        <p class="fm-meta">Mandats</p>
        <h2 class="fm-h2">Commencer un projet.</h2>
        <p class="fm-prose">Nous prenons un petit nombre de mandats chaque année. Écrivez quelques lignes sur votre espace et nous répondrons en une semaine.</p>
        <div class="fm-contact-grid">
          <div class="fm-contact-info">
            <p><span>Studio</span>210, rue Fictive, Montréal QC</p>
            <p><span>Téléphone</span><a href="tel:+15145550148">(514) 555-0148</a></p>
            <p><span>Courriel</span><a href="mailto:studio@exemple.com">studio@exemple.com</a></p>
          </div>
          <form class="fm-form" id="fm-form" novalidate>
            <label>Votre nom<input type="text" name="name" required placeholder="Jeanne Tremblay" autocomplete="name" /></label>
            <label>Courriel<input type="email" name="email" required placeholder="jeanne@exemple.com" autocomplete="email" /></label>
            <label class="fm-form-wide">À propos de votre projet<textarea name="message" rows="4" placeholder="Un duplex des années 1920 à Rosemont, cuisine et deux salles de bain…"></textarea></label>
            <button class="fm-form-wide" type="submit">Envoyer la demande</button>
            <p class="fm-form-note" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="fm-footer">
    <div class="fm-wrap fm-footer-grid">
      <a class="fm-wordmark" href="#top">Forma<sup>®</sup></a>
      <p>210, rue Fictive, Montréal QC · (514) 555-0148</p>
      <p>© 2026 Studio Forma. Site de démonstration fictif.</p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      var form = document.getElementById('fm-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.fm-form-note');
        if (note) note.textContent = 'Merci. Le studio répondra en une semaine.';
        form?.reset();
      });
      var els = document.querySelectorAll('.fm-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('fm-in'); io.unobserve(en.target); }
          });
        }, { threshold: 0.12 });
        els.forEach(function (el) { io.observe(el); });
      } else {
        els.forEach(function (el) { el.classList.add('fm-in'); });
      }
    })();
  </script>

  <style>
    .fm {
      --fm-bone: #EFEAE2;
      --fm-bone-2: #E7E0D2;
      --fm-charcoal: #232220;
      --fm-ink-soft: rgba(35, 34, 32, 0.62);
      --fm-hairline: #D9D3C5;
      --fm-bronze: #A68A5B;
      --fm-serif: "Marcellus", Georgia, "Times New Roman", serif;
      --fm-sans: "Inter", "Helvetica Neue", Arial, sans-serif;
      margin: 0;
      background: var(--fm-bone);
      color: var(--fm-charcoal);
      font-family: var(--fm-sans);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .fm *, .fm *::before, .fm *::after { box-sizing: border-box; }
    .fm img { display: block; max-width: 100%; }
    .fm-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(24px, 6vw, 64px); }

    .fm-meta { font-size: 11.5px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--fm-ink-soft); margin: 0 0 26px; }
    .fm-h1 { font-family: var(--fm-serif); font-weight: 400; font-size: clamp(3.4rem, 8vw, 7rem); line-height: 1; letter-spacing: 0.01em; margin: 0; }
    .fm-h2 { font-family: var(--fm-serif); font-weight: 400; font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.05; margin: 0; }
    .fm-prose { font-size: 16.5px; font-weight: 300; line-height: 1.85; color: var(--fm-ink-soft); max-width: 56ch; margin: 0 0 22px; }
    .fm-prose a, .fm-contact-info a { color: var(--fm-charcoal); }

    .fm-nav {
      display: flex; align-items: baseline; justify-content: space-between;
      padding: 30px clamp(24px, 6vw, 64px); max-width: 1440px; margin: 0 auto;
    }
    .fm-wordmark { font-family: var(--fm-serif); font-size: 27px; letter-spacing: 0.14em; text-decoration: none; color: var(--fm-charcoal); }
    .fm-wordmark sup { font-size: 11px; letter-spacing: 0; }
    .fm-links { display: flex; gap: clamp(22px, 4vw, 46px); }
    .fm-links a { color: var(--fm-ink-soft); text-decoration: none; font-size: 13px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; }
    .fm-links a:hover { color: var(--fm-charcoal); }

    .fm-hero { max-width: 1440px; margin: 0 auto; padding: 0 clamp(24px, 6vw, 64px); }
    .fm-hero-media { margin: 0; overflow: hidden; }
    .fm-hero-media img { width: 100%; height: min(78vh, 760px); object-fit: cover; transform: scale(1.04); animation: fm-settle 2.4s ease forwards; }
    @keyframes fm-settle { to { transform: scale(1); } }
    .fm-hero-copy { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: end; padding: 54px 0 clamp(60px, 9vh, 110px); border-bottom: 1px solid var(--fm-hairline); }
    .fm-hero-copy .fm-meta { margin: 0 0 20px; grid-column: 1 / -1; }
    .fm-hero-note { font-size: 15px; font-weight: 300; line-height: 1.7; color: var(--fm-ink-soft); max-width: 30ch; margin: 0; text-align: right; }

    .fm-manifesto { padding: clamp(90px, 14vh, 170px) 0; border-bottom: 1px solid var(--fm-hairline); }
    .fm-rule-label { font-size: 11.5px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--fm-bronze); margin: 0 0 40px; }
    .fm-manifesto-text { font-family: var(--fm-serif); font-size: clamp(1.7rem, 3.6vw, 2.9rem); line-height: 1.35; max-width: 26ch; margin: 0 0 34px; }
    .fm-manifesto-sub { font-size: 15.5px; font-weight: 300; color: var(--fm-ink-soft); margin: 0; max-width: 52ch; line-height: 1.8; }

    .fm-projects { padding: clamp(90px, 13vh, 160px) 0; }
    .fm-section-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--fm-hairline); padding-bottom: 26px; margin-bottom: clamp(50px, 7vh, 90px); }
    .fm-section-head .fm-meta { margin: 0; }
    .fm-project { display: grid; grid-template-columns: 70px 1fr 0.72fr; gap: clamp(24px, 4vw, 56px); align-items: start; padding: clamp(44px, 6vh, 80px) 0; border-bottom: 1px solid var(--fm-hairline); }
    .fm-project-no { font-family: var(--fm-serif); font-size: 15px; color: var(--fm-bronze); letter-spacing: 0.2em; padding-top: 8px; }
    .fm-project-media { margin: 0; overflow: hidden; }
    .fm-project-media img { width: 100%; height: min(560px, 70vw); object-fit: cover; transition: transform 1.1s ease; }
    .fm-project-media:hover img { transform: scale(1.035); }
    .fm-project-copy { padding-top: 6px; }
    .fm-project-copy h3 { font-family: var(--fm-serif); font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.2rem); margin: 0 0 10px; }
    .fm-project-meta { font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--fm-ink-soft); margin: 0 0 22px; font-weight: 500; }
    .fm-project-copy p:last-child { font-size: 15.5px; font-weight: 300; line-height: 1.8; color: var(--fm-ink-soft); margin: 0; }
    .fm-flip { direction: rtl; }
    .fm-flip > * { direction: ltr; }
    .fm-reveal { opacity: 0; transform: translateY(34px); transition: opacity 0.9s ease, transform 0.9s ease; }
    .fm-reveal.fm-in { opacity: 1; transform: none; }

    .fm-services { padding: 0 0 clamp(90px, 13vh, 160px); }
    .fm-service-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--fm-hairline); }
    .fm-service-list li {
      display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: baseline;
      padding: 38px 6px; border-bottom: 1px solid var(--fm-hairline);
      transition: padding 0.25s ease, background 0.25s ease;
    }
    .fm-service-list li:hover { padding-left: 22px; background: rgba(166,138,91,0.06); }
    .fm-service-list h3 { font-family: var(--fm-serif); font-weight: 400; font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: 0 0 10px; }
    .fm-service-list p { font-size: 15px; font-weight: 300; line-height: 1.7; color: var(--fm-ink-soft); margin: 0; max-width: 62ch; }
    .fm-service-list > li > span { font-family: var(--fm-serif); color: var(--fm-bronze); font-size: 15px; letter-spacing: 0.18em; }

    .fm-studio { background: var(--fm-bone-2); padding: clamp(90px, 13vh, 160px) 0; }
    .fm-studio-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(40px, 6vw, 90px); align-items: center; }
    .fm-studio-media { margin: 0; }
    .fm-studio-media img { width: 100%; height: min(620px, 80vw); object-fit: cover; }
    .fm-studio-facts { margin: 36px 0 0; display: grid; gap: 0; border-top: 1px solid var(--fm-hairline); max-width: 420px; }
    .fm-studio-facts div { display: flex; justify-content: space-between; gap: 20px; padding: 15px 2px; border-bottom: 1px solid var(--fm-hairline); }
    .fm-studio-facts dt { font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--fm-ink-soft); font-weight: 500; }
    .fm-studio-facts dd { margin: 0; font-size: 15px; font-weight: 400; }

    .fm-interlude { padding: clamp(70px, 10vh, 130px) 0 0; }
    .fm-interlude-media { margin: 0 auto; max-width: 1440px; padding: 0 clamp(24px, 6vw, 64px); }
    .fm-interlude-media img { width: 100%; height: min(52vh, 480px); object-fit: cover; }
    .fm-interlude-media figcaption { font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--fm-ink-soft); padding: 16px 2px 0; }

    .fm-process { padding: clamp(90px, 13vh, 160px) 0; }
    .fm-process-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px; counter-reset: fm-step; }
    .fm-process-list li { border-top: 1px solid var(--fm-charcoal); padding-top: 24px; display: grid; gap: 12px; align-content: start; }
    .fm-process-list li::before { counter-increment: fm-step; content: "0" counter(fm-step); font-size: 12px; letter-spacing: 0.3em; color: var(--fm-bronze); font-weight: 500; }
    .fm-process-list strong { font-family: var(--fm-serif); font-weight: 400; font-size: 21px; }
    .fm-process-list span { font-size: 14.5px; font-weight: 300; line-height: 1.7; color: var(--fm-ink-soft); }

    .fm-contact { border-top: 1px solid var(--fm-hairline); padding: clamp(90px, 13vh, 160px) 0; }
    .fm-contact .fm-h2 { margin-bottom: 24px; }
    .fm-contact-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(40px, 6vw, 90px); margin-top: 56px; align-items: start; }
    .fm-contact-info { display: grid; gap: 26px; }
    .fm-contact-info p { margin: 0; font-size: 16px; font-weight: 300; line-height: 1.7; display: grid; gap: 6px; }
    .fm-contact-info span { font-size: 11.5px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--fm-ink-soft); font-weight: 500; }
    .fm-contact-info a { font-size: 19px; font-weight: 400; }
    .fm-form { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
    .fm-form-wide { grid-column: 1 / -1; }
    .fm-form label { display: grid; gap: 10px; font-size: 11.5px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--fm-ink-soft); font-weight: 500; }
    .fm-form input, .fm-form textarea {
      font-family: var(--fm-sans); font-size: 16px; font-weight: 300; color: var(--fm-charcoal);
      background: transparent; border: 0; border-bottom: 1px solid var(--fm-hairline);
      padding: 12px 2px; width: 100%; border-radius: 0;
    }
    .fm-form input:focus, .fm-form textarea:focus { outline: none; border-bottom-color: var(--fm-charcoal); }
    .fm-form button {
      font-family: var(--fm-sans); font-size: 12.5px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase;
      background: var(--fm-charcoal); color: var(--fm-bone); border: 0; padding: 20px; cursor: pointer;
      transition: background 0.25s ease; justify-self: start; min-width: 260px;
    }
    .fm-form button:hover { background: #000; }
    .fm-form-note { margin: 0; font-size: 14.5px; font-weight: 300; font-style: italic; color: var(--fm-ink-soft); }
    .fm-form-note:empty { display: none; }

    .fm-footer { border-top: 1px solid var(--fm-hairline); padding: 44px 0 54px; }
    .fm-footer-grid { display: grid; grid-template-columns: auto 1fr auto; gap: 26px; align-items: center; }
    .fm-footer p { margin: 0; font-size: 13px; font-weight: 300; letter-spacing: 0.08em; color: var(--fm-ink-soft); }
    .fm-footer-grid p:nth-child(2) { text-align: center; }

    @media (max-width: 980px) {
      .fm-project { grid-template-columns: 44px 1fr; }
      .fm-project-copy { grid-column: 2; }
      .fm-flip { direction: ltr; }
      .fm-studio-grid, .fm-contact-grid { grid-template-columns: 1fr; }
      .fm-process-list { grid-template-columns: repeat(2, 1fr); }
      .fm-hero-copy { grid-template-columns: 1fr; }
      .fm-hero-note { text-align: left; }
    }
    @media (max-width: 640px) {
      .fm-links { display: none; }
      .fm-form { grid-template-columns: 1fr; }
      .fm-form button { width: 100%; }
      .fm-footer-grid { grid-template-columns: 1fr; text-align: center; }
      .fm-footer-grid p:nth-child(2) { text-align: center; }
      .fm-process-list { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fm-hero-media img { animation: none; transform: none; }
      .fm-reveal { opacity: 1; transform: none; transition: none; }
      .fm-project-media img, .fm-service-list li, .fm-form button { transition: none; }
    }
  </style>
