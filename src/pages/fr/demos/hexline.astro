---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : Hexline Systems, startup fictive de sécurité des interfaces neuronales.
// Reconstruite comme un TERMINAL. Pas de héros marketing : la page s'ouvre sur
// une séquence de démarrage, la navigation est une ligne de commande, et chaque
// section se lit comme une sortie de terminal. Cybercore : noir, cyan/magenta.
const IMG = {
  hero: "/demos/hexline/01.jpg",
  lock: "https://images.unsplash.com/photo-1614064641938-3bbee52942c7?q=80&w=800&auto=format&fit=crop",
  servers: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=800&auto=format&fit=crop",
  ops: "/demos/hexline/02.jpg",
  neon: "https://images.unsplash.com/photo-1563089145-599997674d42?q=80&w=800&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>hexline://systems · sécurité des interfaces neuronales</title>
  <meta name="description" content="Hexline Systems sécurise les interfaces neuronales et les infrastructures connectées. Tapez help pour commencer." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body class="tm">
  <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">hexline://systems — sécurité des interfaces neuronales</h1>

  <div class="tm-scan" aria-hidden="true"></div>

  <!-- SÉQUENCE DE DÉMARRAGE -->
  <section class="tm-boot" aria-label="Démarrage du système">
    <div class="tm-boot-in">
      <pre class="tm-lines" id="tm-boot" aria-live="polite"></pre>
      <p class="tm-skip"><a href="#cmd">passer le démarrage ↓</a></p>
    </div>
  </section>

  <!-- NAVIGATION EN LIGNE DE COMMANDE -->
  <div class="tm-cmdwrap" id="cmd">
    <div class="tm-cmd">
      <span class="tm-ps1">visiteur@hexline:~$</span>
      <nav class="tm-cmds" aria-label="Commandes">
        <button type="button" data-tm-go="protocols">protocoles</button>
        <button type="button" data-tm-go="intel">renseignement</button>
        <button type="button" data-tm-go="access">acces</button>
        <button type="button" data-tm-go="uplink">liaison</button>
        <button type="button" data-tm-go="help">aide</button>
      </nav>
      <span class="tm-caret" aria-hidden="true">▌</span>
    </div>
  </div>

  <main class="tm-main">
    <!-- AIDE -->
    <section class="tm-out" id="help" aria-label="Sortie d'aide">
      <p class="tm-echo"><span class="tm-ps1">visiteur@hexline:~$</span> aide</p>
      <div class="tm-block">
        <p><span class="tm-c">protocoles</span> · la pile défensive. ce qu'on fait tourner, en clair.</p>
        <p><span class="tm-c">renseignement</span> · télémétrie en direct de la grille de démo.</p>
        <p><span class="tm-c">acces</span> · niveaux d'habilitation et tarifs.</p>
        <p><span class="tm-c">liaison</span> · ouvrir un canal sécurisé vers un humain.</p>
        <br />
        <p>Hexline sécurise les interfaces neuronales et les infrastructures connectées contre l'intrusion, l'usurpation et le vol de signal. Cryptographie de niveau militaire, déploiement simple. Montréal, depuis 2024.</p>
      </div>
    </section>

    <!-- PROTOCOLES -->
    <section class="tm-out" id="protocols" aria-label="Sortie des protocoles">
      <p class="tm-echo"><span class="tm-ps1">visiteur@hexline:~$</span> protocoles --liste</p>
      <div class="tm-block">
        <p class="tm-ok">4 protocoles chargés.</p>
        <br />
        <p><span class="tm-mag">P-01</span> <span class="tm-w">DÉFENSE DU PÉRIMÈTRE</span></p>
        <p class="tm-dim">Maillage de pare-feu adaptatif qui apprend les tactiques d'attaque en temps réel. Déployé en moins de 20 minutes.</p>
        <p class="tm-dim">· modélisation comportementale des menaces · isolement auto des nœuds hostiles · absorption DDoS jusqu'à 2,4 Tbps</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.lock} alt="Flux de surveillance : verrou de périmètre chiffré" loading="lazy" />
          <figcaption>flux 01 · nœud de périmètre</figcaption>
        </figure>
        <br />
        <p><span class="tm-mag">P-02</span> <span class="tm-w">DURCISSEMENT DU MAILLAGE NEURONAL</span></p>
        <p class="tm-dim">Chiffrement de bout en bout pour les interfaces cerveau-machine. Chaque signal signé, chaque canal vérifié.</p>
        <p class="tm-dim">· échange de clés post-quantique · attestation d'intégrité du signal · réponse en 4 ms</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.servers} alt="Flux de surveillance : serveurs du maillage neuronal" loading="lazy" />
          <figcaption>flux 02 · cœur du maillage</figcaption>
        </figure>
        <br />
        <p><span class="tm-mag">P-03</span> <span class="tm-w">CONTRE-MESURES D'INTRUSION</span></p>
        <p class="tm-dim">Défense active qui n'attend pas la permission. Leurres, injection de traceurs, criminalistique recevable.</p>
        <p class="tm-dim">· grille de leurres · traçage d'attribution · représailles automatiques dans les limites légales</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.ops} alt="Flux de surveillance : analyste en opérations de sécurité" loading="lazy" />
          <figcaption>flux 03 · table des opérations</figcaption>
        </figure>
        <br />
        <p><span class="tm-mag">P-04</span> <span class="tm-w">IDENTITÉ ZÉRO-CONFIANCE</span></p>
        <p class="tm-dim">Aucune confiance implicite. Chaque utilisateur, appareil et processus se ré-authentifie en continu.</p>
        <p class="tm-dim">· clés d'identité liées au matériel · politiques d'accès granulaires</p>
        <figure class="tm-feed">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.neon} alt="Flux de surveillance : visualisation du réseau" loading="lazy" />
          <figcaption>flux 04 · graphe d'identité</figcaption>
        </figure>
      </div>
    </section>

    <!-- RENSEIGNEMENT -->
    <section class="tm-out" id="intel" aria-label="Sortie du renseignement">
      <p class="tm-echo"><span class="tm-ps1">visiteur@hexline:~$</span> renseignement --direct</p>
      <div class="tm-block">
        <p><span class="tm-t">[14:02:11]</span> INTRUSION BLOQUÉE :: origine 185.220.x.x :: nœud 7 :: action : REJET</p>
        <p><span class="tm-t">[14:02:08]</span> TENTATIVE D'USURPATION :: canal neuronal C :: signature non conforme :: neutralisée</p>
        <p><span class="tm-t">[14:01:57]</span> VÉRIFICATION D'INTÉGRITÉ :: 4 096 nœuds :: <span class="tm-ok">tous verts</span></p>
        <p><span class="tm-t">[14:01:44]</span> SIGNATURE ZÉRO-JOUR v88.2 déployée sur le parc en 3,1 s</p>
        <p><span class="tm-t">[14:01:31]</span> RELAIS FANTÔME :: tracé jusqu'au nœud de sortie :: terminé</p>
        <p><span class="tm-t">[14:01:02]</span> ROTATION DES CLÉS :: maillage complet :: terminée, zéro interruption</p>
        <br />
        <figure class="tm-feed tm-feed-wide">
          <span class="tm-rec" aria-hidden="true"></span>
          <img src={IMG.hero} alt="Flux de surveillance : salle des opérations Hexline" loading="lazy" />
          <figcaption>flux 00 · salle des opérations, Montréal</figcaption>
        </figure>
        <br />
        <p class="tm-dim">menaces bloquées aujourd'hui : <span class="tm-w">1 204 883</span> · intégrité du maillage : <span class="tm-ok">100 %</span> · réponse moyenne : <span class="tm-w">4 ms</span> · brèches à ce jour : <span class="tm-mag">0</span></p>
        <p class="tm-dim">chiffres illustratifs de la grille de démo. les déploiements réels rapportent à votre SIEM.</p>
      </div>
    </section>

    <!-- ACCÈS -->
    <section class="tm-out" id="access" aria-label="Sortie des niveaux d'accès">
      <p class="tm-echo"><span class="tm-ps1">visiteur@hexline:~$</span> acces --niveaux</p>
      <div class="tm-block">
        <p class="tm-ok">3 niveaux d'habilitation offerts.</p>
        <br />
        <p><span class="tm-mag">NIVEAU 01</span> <span class="tm-w">ÉCLAIREUR</span> <span class="tm-dim">······</span> <span class="tm-c">490 $/mois</span></p>
        <p class="tm-dim">défense du périmètre, 1 site · résumé quotidien des menaces · soutien standard</p>
        <br />
        <p><span class="tm-mag">NIVEAU 02</span> <span class="tm-w">SENTINELLE</span> <span class="tm-dim">····</span> <span class="tm-c">1 900 $/mois</span> <span class="tm-tag">le plus déployé</span></p>
        <p class="tm-dim">pile complète, 5 sites · durcissement du maillage neuronal · tableau de télémétrie · soutien prioritaire</p>
        <br />
        <p><span class="tm-mag">NIVEAU 03</span> <span class="tm-w">SEIGNEUR</span> <span class="tm-dim">····</span> <span class="tm-c">sur mesure</span></p>
        <p class="tm-dim">sites illimités + option isolée · équipe de contre-mesures dédiée · intégrations sur mesure</p>
        <br />
        <p class="tm-dim">lancez <span class="tm-c">liaison</span> pour demander un niveau.</p>
      </div>
    </section>

    <!-- LIAISON -->
    <section class="tm-out" id="uplink" aria-label="Sortie de liaison">
      <p class="tm-echo"><span class="tm-ps1">visiteur@hexline:~$</span> liaison --ouvrir</p>
      <div class="tm-block">
        <p class="tm-ok">canal sécurisé prêt. un humain répond dans un jour ouvrable.</p>
        <p class="tm-dim">aucun appel à froid. aucune infolettre. jamais.</p>
        <br />
        <form class="tm-form" id="tm-form" novalidate>
          <label>indicatif<input type="text" name="callsign" required placeholder="fantome.reel" autocomplete="nickname" /></label>
          <label>courriel<input type="email" name="email" required placeholder="vous@entreprise.com" autocomplete="email" /></label>
          <label>objectif<textarea name="message" rows="3" placeholder="décrivez l'actif à protéger"></textarea></label>
          <button type="submit">transmettre_</button>
          <p class="tm-form-note" role="status" aria-live="polite"></p>
        </form>
        <br />
        <p class="tm-dim">voix : <a href="tel:+15145550917">(514) 555-0917</a> · courriel : <a href="mailto:uplink@hexline.systems">uplink@hexline.systems</a></p>
        <p class="tm-dim">unité 7, 1010 circuit lane, montréal qc</p>
      </div>
    </section>

    <section class="tm-out tm-end" aria-label="Fin de transmission">
      <p class="tm-echo"><span class="tm-ps1">visiteur@hexline:~$</span> <span class="tm-caret" aria-hidden="true">▌</span></p>
    </section>
  </main>

  <footer class="tm-foot">
    <p>hexline systems · © 2026 · démo fictive · aucun réseau n'a été blessé</p>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var bootEl = document.getElementById('tm-boot');
      var lines = [
        'hexline secure boot v4.2.0',
        'vérification du maillage ............ OK (4 096 nœuds)',
        'chargement des protocoles ........... OK (4 chargés)',
        'vérification de l\u2019identité ........ INVITÉ',
        '',
        'bienvenue, visiteur. tapez une commande ci-dessus, ou défilez.',
      ];
      function renderAll() {
        if (!bootEl) return;
        bootEl.textContent = lines.join('\n');
      }
      if (reduced || !bootEl) { renderAll(); }
      else {
        var li = 0, ci = 0, out = '';
        bootEl.textContent = '';
        (function tick() {
          if (li >= lines.length) return;
          var line = lines[li];
          if (ci <= line.length) {
            out += line.charAt(ci) || '';
            ci++;
            bootEl.textContent = out;
            setTimeout(tick, line.charAt(ci - 1) === '.' ? 8 : 26);
          } else {
            out += '\n'; li++; ci = 0;
            setTimeout(tick, 160);
          }
        })();
      }
      document.querySelectorAll('[data-tm-go]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-tm-go');
          var target = id && document.getElementById(id);
          if (target) target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });
      var form = document.getElementById('tm-form');
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.tm-form-note');
        if (note) note.textContent = '> transmission reçue. liaison établie.';
        if (form instanceof HTMLFormElement) form.reset();
      });
    })();
  </script>

  <style>
    .tm {
      --tm-bg: #05070D;
      --tm-panel: #090D17;
      --tm-line: #1B2740;
      --tm-cyan: #00F0FF;
      --tm-mag: #FF2EA6;
      --tm-text: #C9D6E8;
      --tm-dim: #6E7A90;
      --tm-mono: "JetBrains Mono", ui-monospace, monospace;
      margin: 0;
      background: var(--tm-bg);
      color: var(--tm-text);
      font-family: var(--tm-mono);
      font-size: 15px;
      line-height: 1.9;
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .tm *, .tm *::before, .tm *::after { box-sizing: border-box; }
    .tm img { display: block; max-width: 100%; }
    .tm a { color: var(--tm-cyan); }
    .tm-scan {
      position: fixed; inset: 0; z-index: 90; pointer-events: none;
      background: repeating-linear-gradient(180deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 4px);
    }

    .tm-boot { min-height: 92svh; display: flex; align-items: center; padding: 40px 0; }
    .tm-boot-in { width: min(860px, 100%); margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .tm-lines { margin: 0; white-space: pre-wrap; font-size: clamp(13px, 2.6vw, 16px); color: var(--tm-cyan); min-height: 12em; text-shadow: 0 0 12px rgba(0,240,255,0.35); }
    .tm-skip { margin: 26px 0 0; }
    .tm-skip a { color: var(--tm-dim); font-size: 13px; text-decoration: none; border-bottom: 1px solid var(--tm-line); }

    .tm-cmdwrap {
      position: sticky; top: 0; z-index: 60;
      background: rgba(5, 7, 13, 0.94); backdrop-filter: blur(10px);
      border-block: 1px solid var(--tm-line);
    }
    .tm-cmd {
      width: min(1180px, 100%); margin: 0 auto; padding: 14px clamp(20px, 4vw, 40px);
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .tm-ps1 { color: var(--tm-mag); font-weight: 700; white-space: nowrap; }
    .tm-cmds { display: flex; gap: 4px; flex-wrap: wrap; }
    .tm-cmds button {
      font: inherit; background: transparent; border: 1px solid transparent; cursor: pointer;
      color: var(--tm-cyan); padding: 8px 14px; letter-spacing: 0.06em;
    }
    .tm-cmds button:hover { border-color: var(--tm-line); background: rgba(0,240,255,0.06); }
    .tm-caret { color: var(--tm-cyan); animation: tm-blink 1s steps(2, start) infinite; margin-left: auto; }
    @keyframes tm-blink { 50% { opacity: 0; } }

    .tm-main { width: min(1180px, 100%); margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px) 40px; }
    .tm-out { padding: clamp(36px, 6vh, 64px) 0; border-bottom: 1px dashed var(--tm-line); scroll-margin-top: 76px; }
    .tm-end { border-bottom: 0; }
    .tm-echo { margin: 0 0 18px; color: var(--tm-text); font-size: 14px; }
    .tm-block { background: var(--tm-panel); border: 1px solid var(--tm-line); padding: clamp(22px, 3.5vw, 36px); }
    .tm-block p { margin: 0; }
    .tm-block br { display: block; content: ""; margin: 6px 0; }
    .tm-c { color: var(--tm-cyan); }
    .tm-mag { color: var(--tm-mag); }
    .tm-w { color: #fff; font-weight: 700; }
    .tm-dim { color: var(--tm-dim); }
    .tm-ok { color: var(--tm-cyan); }
    .tm-t { color: var(--tm-mag); }
    .tm-tag {
      display: inline-block; font-size: 11px; letter-spacing: 0.14em;
      border: 1px solid var(--tm-cyan); color: var(--tm-cyan); padding: 2px 10px; margin-left: 8px;
    }

    .tm-feed { margin: 18px 0 6px; position: relative; border: 1px solid var(--tm-line); max-width: 520px; }
    .tm-feed-wide { max-width: 720px; }
    .tm-feed img { width: 100%; height: 240px; object-fit: cover; filter: saturate(1.25) contrast(1.05) brightness(0.85); }
    .tm-feed-wide img { height: 320px; }
    .tm-feed::after { content: ""; position: absolute; inset: 0; pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0,0,0,.3) 0 1px, transparent 1px 3px); }
    .tm-feed figcaption { font-size: 11px; letter-spacing: 0.2em; color: var(--tm-dim); padding: 8px 12px; background: #02040A; }
    .tm-rec {
      position: absolute; top: 10px; left: 12px; z-index: 2;
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 10px; letter-spacing: 0.22em; color: #FF5C5C;
    }
    .tm-rec::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #FF3B3B; box-shadow: 0 0 8px #FF3B3B; }
    .tm-rec::after { content: "EN DIRECT"; }

    .tm-form { display: grid; gap: 14px; max-width: 560px; margin-top: 8px; }
    .tm-form label { display: grid; gap: 8px; font-size: 12px; letter-spacing: 0.18em; color: var(--tm-dim); }
    .tm-form input, .tm-form textarea {
      font: inherit; font-size: 14px; color: var(--tm-text);
      background: #02040A; border: 1px solid var(--tm-line); padding: 13px 15px; width: 100%;
    }
    .tm-form input:focus, .tm-form textarea:focus { outline: none; border-color: var(--tm-cyan); box-shadow: 0 0 14px rgba(0,240,255,0.22); }
    .tm-form button {
      font: inherit; font-weight: 700; letter-spacing: 0.1em; cursor: pointer;
      background: var(--tm-cyan); color: #05070D; border: 0; padding: 15px;
      transition: filter 0.15s ease;
    }
    .tm-form button:hover { filter: brightness(1.12); }
    .tm-form-note { color: var(--tm-cyan); }
    .tm-form-note:empty { display: none; }

    .tm-foot { text-align: center; padding: 44px 20px 60px; color: var(--tm-dim); font-size: 12.5px; }

    @media (max-width: 640px) {
      .tm { font-size: 13.5px; }
      .tm-caret { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .tm-caret { animation: none; }
      .tm-form button { transition: none; }
    }
  </style>
</body>
</html>
