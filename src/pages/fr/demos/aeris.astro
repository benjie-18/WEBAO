---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Démo : AERIS, entreprise fictive de technologie propre, Québec.
// Direction artistique autonome. Frutiger Aero : aqua lustré, dégradés aurore,
// orbes de verre, reflets, nature rosée et tech. Non relié au thème WEBAO.
const IMG = {
  hero: "/demos/aeris/01.jpg",
  chip: "/demos/aeris/02.jpg",
  solar: "https://images.unsplash.com/photo-1509391366360-2e959784a276?q=80&w=1000&auto=format&fit=crop",
  hills: "https://images.unsplash.com/photo-1501854140801-50d01698950b?q=80&w=1000&auto=format&fit=crop",
  leaves: "/demos/aeris/03.jpg",
  wave: "https://images.unsplash.com/photo-1439405326854-014607f694d7?q=80&w=1600&auto=format&fit=crop",
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AERIS : une tech propre fraîche comme la rosée</title>
  <meta name="description" content="AERIS : une énergie domestique qui apprend, s'adapte et rayonne. Toits solaires, stockage intelligent et réseau qui aime la nature. Obtenez votre scan énergétique gratuit." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,600&display=swap" rel="stylesheet" />
</head>
<body class="fa">

  <!-- NAV -->
  <header class="fa-navwrap">
    <nav class="fa-nav" aria-label="Navigation principale">
      <a class="fa-logo" href="#top" aria-label="AERIS, accueil">
        <span class="fa-orb-logo" aria-hidden="true"></span>
        <span>AERIS</span>
      </a>
      <div class="fa-nav-links">
        <a href="#tech">Technologie</a>
        <a href="#produits">Produits</a>
        <a href="#impact">Impact</a>
        <a href="#forfaits">Forfaits</a>
      </div>
      <a class="fa-gel fa-gel-small" href="#contact">Scan gratuit</a>
      <button class="fa-burger" id="fa-burger" aria-expanded="false" aria-controls="fa-menu" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="fa-menu" id="fa-menu" hidden>
      <a href="#tech">Technologie</a>
      <a href="#produits">Produits</a>
      <a href="#impact">Impact</a>
      <a href="#forfaits">Forfaits</a>
      <a class="fa-gel" href="#contact">Scan gratuit</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="fa-hero">
      <div class="fa-hero-bg" aria-hidden="true">
        <img src={IMG.hero} alt="Gouttes d'eau brillantes sur une feuille bien verte" loading="eager" fetchpriority="high" />
      </div>
      <div class="fa-aurora" aria-hidden="true"></div>
      <div class="fa-orb fa-orb-1" aria-hidden="true"></div>
      <div class="fa-orb fa-orb-2" aria-hidden="true"></div>
      <div class="fa-orb fa-orb-3" aria-hidden="true"></div>
      <div class="fa-flare" aria-hidden="true"></div>
      <div class="fa-hero-in">
        <div class="fa-glass-card">
          <p class="fa-eyebrow">TECH PROPRE · FONDÉE EN 2024 · QUÉBEC</p>
          <h1 class="fa-h1">Une énergie fraîche<br />comme la <em>rosée du matin</em></h1>
          <p class="fa-lede">AERIS apprend comment votre maison respire, puis l'alimente avec le soleil, le vent et le stockage, le tout dans un tableau de bord lumineux. Des factures plus légères. Une empreinte plus douce. Zéro devoir.</p>
          <div class="fa-hero-cta">
            <a class="fa-gel" href="#contact">Mon scan gratuit</a>
            <a class="fa-gel fa-gel-ghost" href="#produits">Voir les produits</a>
          </div>
          <div class="fa-hero-stats">
            <div><strong>38 %</strong><span>baisse moyenne</span></div>
            <div><strong>12 k</strong><span>maisons alimentées</span></div>
            <div><strong>0</strong><span>panne en 2025</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGIE -->
    <section class="fa-section" id="tech">
      <div class="fa-wrap">
        <p class="fa-kicker">Sous le verre</p>
        <h2 class="fa-h2">Une tech qui fait la <em>photosynthèse</em></h2>
        <div class="fa-panels">
          <article class="fa-panel">
            <div class="fa-panel-img"><img src={IMG.chip} alt="Gros plan d'une puce énergétique AERIS lumineuse" loading="lazy" /></div>
            <div class="fa-panel-body">
              <h3>Helio Core</h3>
              <p>Une puce de la taille d'un ongle qui lit le rythme énergétique de votre maison 200 fois par seconde et redirige le courant avant qu'un seul watt ne se perde.</p>
            </div>
          </article>
          <article class="fa-panel">
            <div class="fa-panel-img"><img src={IMG.leaves} alt="Gouttes de rosée étincelantes sur une feuille au petit matin" loading="lazy" /></div>
            <div class="fa-panel-body">
              <h3>Dew Grid</h3>
              <p>Les quartiers partagent le soleil stocké grâce à un réseau maillé qui se comporte comme une forêt : chaque feuille nourrit la canopée.</p>
            </div>
          </article>
          <article class="fa-panel">
            <div class="fa-panel-img"><img src={IMG.wave} alt="Vague cristalline au soleil" loading="lazy" /></div>
            <div class="fa-panel-body">
              <h3>Aqua Buffer</h3>
              <p>Le surplus solaire de l'été devient la chaleur de l'hiver, stocké dans des réservoirs d'eau si efficaces qu'on dirait de la science-fiction.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- PRODUITS -->
    <section class="fa-products" id="produits">
      <div class="fa-wrap">
        <p class="fa-kicker">La gamme</p>
        <h2 class="fa-h2">De beaux objets pour une maison <em>plus verte</em></h2>
        <div class="fa-prod-grid">
          <article class="fa-prod">
            <img src={IMG.solar} alt="Panneaux solaires AERIS brillant sur un toit" loading="lazy" />
            <div class="fa-prod-body">
              <span class="fa-badge">Meilleur vendeur</span>
              <h3>Aura Roof</h3>
              <p>Des tuiles solaires au fini verre qui ressemblent à un étang à midi. 22 % d'efficacité, à l'épreuve de la grêle, magnifiques depuis la rue.</p>
              <p class="fa-prod-price">dès 8 900 $ <span>installé</span></p>
            </div>
          </article>
          <article class="fa-prod">
            <img src={IMG.hills} alt="Collines vertes sous un ciel bleu limpide" loading="lazy" />
            <div class="fa-prod-body">
              <span class="fa-badge fa-badge-green">Nouveau</span>
              <h3>Nimbus Pack</h3>
              <p>Une batterie murale de la taille d'une affiche. Stocke une pleine journée de soleil pour une semaine de tempête.</p>
              <p class="fa-prod-price">dès 4 200 $ <span>installé</span></p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- IMPACT -->
    <section class="fa-impact" id="impact">
      <div class="fa-wrap fa-impact-in">
        <div>
          <p class="fa-kicker">Des preuves, pas des promesses</p>
          <h2 class="fa-h2">Des chiffres qui <em>étincellent</em></h2>
          <p class="fa-copy">Chaque maison AERIS partage ses données (anonymement) pour que tout le réseau devienne plus intelligent. Voici ce que 12 000 maisons ont accompli l'an dernier.</p>
          <a class="fa-gel" href="#contact">Rejoindre le réseau</a>
        </div>
        <div class="fa-counters">
          <div class="fa-counter"><strong>41 GWh</strong><span>d'énergie propre partagée</span></div>
          <div class="fa-counter"><strong>18 400 t</strong><span>de CO₂ évitées</span></div>
          <div class="fa-counter"><strong>96 %</strong><span>nous recommanderaient</span></div>
          <div class="fa-counter"><strong>3,2 ans</strong><span>retour moyen</span></div>
        </div>
      </div>
    </section>

    <!-- FORFAITS -->
    <section class="fa-section" id="forfaits">
      <div class="fa-wrap">
        <p class="fa-kicker">Simple comme l'eau</p>
        <h2 class="fa-h2">Choisissez votre <em>courant</em></h2>
        <div class="fa-tiers">
          <article class="fa-tier">
            <h3>Brise</h3>
            <p class="fa-tier-price">29 $<span>/mois</span></p>
            <p class="fa-tier-sub">Locataires et petits condos</p>
            <ul>
              <li>Moniteur Helio Core branché</li>
              <li>Application tableau de bord Glow</li>
              <li>Rapport d'économies mensuel</li>
            </ul>
            <a class="fa-gel fa-gel-ghost" href="#contact">Commencer léger</a>
          </article>
          <article class="fa-tier fa-tier-hot">
            <span class="fa-badge">Le plus populaire</span>
            <h3>Ruisseau</h3>
            <p class="fa-tier-price">59 $<span>/mois</span></p>
            <p class="fa-tier-sub">Maisons familiales, contrôle total</p>
            <ul>
              <li>Tout ce que contient Brise</li>
              <li>Batterie Nimbus Pack en location</li>
              <li>Crédits de partage Dew Grid</li>
              <li>Mode secours anti-tempête</li>
            </ul>
            <a class="fa-gel" href="#contact">Suivre le courant</a>
          </article>
          <article class="fa-tier">
            <h3>Rivière</h3>
            <p class="fa-tier-price">119 $<span>/mois</span></p>
            <p class="fa-tier-sub">Grandes maisons et commerces</p>
            <ul>
              <li>Tout ce que contient Ruisseau</li>
              <li>Installation Aura Roof prioritaire</li>
              <li>Stockage de chaleur Aqua Buffer</li>
              <li>Coach énergie dédié</li>
            </ul>
            <a class="fa-gel fa-gel-ghost" href="#contact">Faire des vagues</a>
          </article>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="fa-contact" id="contact">
      <div class="fa-wrap fa-contact-in">
        <div class="fa-glass-card">
          <p class="fa-kicker">Gratuit, sans attache</p>
          <h2 class="fa-h2">Le <em>scan énergétique</em> de votre maison</h2>
          <p class="fa-copy">Répondez à quatre questions et notre modèle Helio dessinera le potentiel solaire de votre maison, en mots simples, sous 24 heures.</p>
          <address class="fa-addr">
            88, rue de l'Aurore<br />
            Québec, QC G1K 2B7<br />
            <a href="tel:+14185550193">(418) 555-0193</a><br />
            <a href="mailto:hello@aeristech.ca">hello@aeristech.ca</a>
          </address>
        </div>
        <form class="fa-form" id="fa-form" novalidate>
          <h3>Lancez votre scan</h3>
          <label>Nom<input type="text" name="name" required placeholder="Léa Morin" /></label>
          <label>Courriel<input type="email" name="email" required placeholder="lea@exemple.com" /></label>
          <label>Type d'habitation
            <select name="home">
              <option>Maison unifamiliale</option>
              <option>Condo / appartement</option>
              <option>Duplex / triplex</option>
              <option>Petit commerce</option>
            </select>
          </label>
          <label>Ensoleillement du toit
            <select name="sun">
              <option>Beaucoup de soleil</option>
              <option>Un peu d'ombre</option>
              <option>Surtout ombragé</option>
              <option>Aucune idée, surprenez-moi</option>
            </select>
          </label>
          <button class="fa-gel" type="submit">Scanner ma maison</button>
          <p class="fa-form-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="fa-footer">
    <div class="fa-wrap fa-footer-in">
      <p class="fa-footer-logo" aria-hidden="true">AERIS</p>
      <p>© 2026 AERIS Technologies. Entreprise de démo fictive. Aucun watt n'a été maltraité.</p>
      <p>88, rue de l'Aurore, Québec QC · <a href="tel:+14185550193">(418) 555-0193</a> · <a href="mailto:hello@aeristech.ca">hello@aeristech.ca</a></p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    (function () {
      const burger = document.getElementById('fa-burger');
      const menu = document.getElementById('fa-menu');
      if (burger && menu) {
        burger.addEventListener('click', function () {
          var open = menu.hasAttribute('hidden');
          if (open) { menu.removeAttribute('hidden'); } else { menu.setAttribute('hidden', ''); }
          burger.setAttribute('aria-expanded', String(open));
          burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
        });
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            menu.setAttribute('hidden', '');
            burger.setAttribute('aria-expanded', 'false');
            burger.setAttribute('aria-label', 'Ouvrir le menu');
          });
        });
      }
      var form = document.getElementById('fa-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.fa-form-note');
        if (note) note.textContent = 'Scan demandé! Votre portrait énergétique personnalisé arrivera dans votre boîte sous 24 heures.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .fa {
      --fa-aqua: #4FC3F7;
      --fa-aqua-deep: #29A9E0;
      --fa-green: #7ED957;
      --fa-green-deep: #4CAF50;
      --fa-teal: #0B3D4A;
      --fa-teal-deep: #072A33;
      --fa-white: #FFFFFF;
      --fa-mist: #EAF7FD;
      --fa-ink: #0E2A33;
      --fa-sans: "Nunito", "Segoe UI", system-ui, sans-serif;
      margin: 0;
      background: linear-gradient(180deg, #EAF7FD 0%, #D8F0FB 30%, #EAF7FD 100%);
      color: var(--fa-ink);
      font-family: var(--fa-sans);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .fa *, .fa *::before, .fa *::after { box-sizing: border-box; }
    .fa img { display: block; max-width: 100%; }
    .fa-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }

    .fa-kicker {
      font-weight: 900; font-size: 0.85rem; letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--fa-aqua-deep); margin: 0 0 14px;
    }
    .fa-h1 { font-size: clamp(2.6rem, 6.5vw, 4.8rem); line-height: 1.04; font-weight: 900; margin: 0 0 20px; letter-spacing: -0.01em; }
    .fa-h2 { font-size: clamp(2rem, 4.8vw, 3.2rem); font-weight: 900; margin: 0 0 26px; line-height: 1.08; }
    .fa-h1 em, .fa-h2 em { font-style: normal; background: linear-gradient(100deg, var(--fa-aqua-deep), var(--fa-green-deep)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .fa-lede { font-size: 1.1rem; line-height: 1.7; color: #2C4A55; max-width: 46ch; margin: 0 0 28px; font-weight: 600; }
    .fa-copy { font-size: 1.05rem; line-height: 1.7; color: #2C4A55; margin: 0 0 22px; max-width: 50ch; font-weight: 600; }

    .fa-gel {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--fa-sans); font-weight: 800; font-size: 1rem;
      color: #fff; text-decoration: none; cursor: pointer; border: none;
      padding: 15px 36px; border-radius: 999px;
      background: linear-gradient(180deg, #7ED957 0%, #4FC3F7 100%);
      box-shadow:
        inset 0 2px 3px rgba(255, 255, 255, 0.75),
        inset 0 -3px 6px rgba(11, 61, 74, 0.25),
        0 8px 22px rgba(79, 195, 247, 0.45);
      text-shadow: 0 1px 2px rgba(11, 61, 74, 0.3);
      transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
      position: relative; overflow: hidden;
    }
    .fa-gel::before {
      content: ""; position: absolute; top: 3px; left: 8%; right: 8%; height: 42%;
      border-radius: 999px; background: linear-gradient(180deg, rgba(255,255,255,0.65), rgba(255,255,255,0));
      pointer-events: none;
    }
    .fa-gel:hover { transform: translateY(-2px) scale(1.02); filter: brightness(1.05); box-shadow: inset 0 2px 3px rgba(255,255,255,0.75), inset 0 -3px 6px rgba(11,61,74,0.25), 0 12px 28px rgba(79,195,247,0.55); }
    .fa-gel-ghost {
      background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(234,247,253,0.9));
      color: var(--fa-teal); text-shadow: none;
      box-shadow: inset 0 2px 3px rgba(255,255,255,0.9), inset 0 -2px 5px rgba(79,195,247,0.25), 0 6px 18px rgba(79,195,247,0.3);
      border: 1px solid rgba(79, 195, 247, 0.5);
    }
    .fa-gel-small { padding: 11px 26px; font-size: 0.92rem; }

    .fa-navwrap { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
    .fa-nav {
      display: flex; align-items: center; gap: 22px;
      padding: 12px clamp(20px, 4vw, 40px);
      background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(234,247,253,0.75));
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(79, 195, 247, 0.35);
      box-shadow: 0 4px 18px rgba(79, 195, 247, 0.15);
    }
    .fa-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fa-teal); font-weight: 900; font-size: 1.5rem; letter-spacing: 0.12em; margin-right: auto; }
    .fa-orb-logo {
      width: 34px; height: 34px; border-radius: 50%;
      background: radial-gradient(circle at 32% 28%, #ffffff 0%, #BDEBFF 18%, #4FC3F7 45%, #0B3D4A 100%);
      box-shadow: inset -3px -5px 8px rgba(11,61,74,0.4), 0 4px 12px rgba(79,195,247,0.5);
    }
    .fa-nav-links { display: flex; gap: 4px; }
    .fa-nav-links a { color: var(--fa-teal); text-decoration: none; font-weight: 800; font-size: 0.98rem; padding: 10px 15px; border-radius: 999px; }
    .fa-nav-links a:hover { background: rgba(79, 195, 247, 0.18); }
    .fa-burger { display: none; background: none; border: none; cursor: pointer; padding: 10px; }
    .fa-burger span { display: block; width: 26px; height: 3px; border-radius: 3px; background: var(--fa-teal); margin: 5px 0; }
    .fa-menu { display: none; }

    .fa-hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; padding: 130px 0 70px; }
    .fa-hero-bg { position: absolute; inset: 0; }
    .fa-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
    .fa-hero-bg::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(100deg, rgba(234, 247, 253, 0.92) 20%, rgba(234, 247, 253, 0.45) 55%, rgba(11, 61, 74, 0.25) 100%);
    }
    .fa-aurora {
      position: absolute; inset: -10%;
      background:
        radial-gradient(ellipse 45% 30% at 20% 15%, rgba(126, 217, 87, 0.5), transparent 70%),
        radial-gradient(ellipse 50% 32% at 75% 25%, rgba(79, 195, 247, 0.55), transparent 70%),
        radial-gradient(ellipse 40% 28% at 50% 85%, rgba(79, 195, 247, 0.35), transparent 70%);
      animation: fa-aurora 14s ease-in-out infinite alternate;
      pointer-events: none;
    }
    @keyframes fa-aurora { to { transform: translate(4%, 6%) scale(1.06); opacity: 0.85; } }
    .fa-orb { position: absolute; border-radius: 50%; pointer-events: none; animation: fa-float 9s ease-in-out infinite; }
    .fa-orb::after {
      content: ""; position: absolute; top: 12%; left: 16%; width: 34%; height: 22%;
      border-radius: 50%; background: radial-gradient(ellipse, rgba(255,255,255,0.95), rgba(255,255,255,0));
      transform: rotate(-24deg);
    }
    .fa-orb-1 { width: 150px; height: 150px; top: 14%; right: 8%; background: radial-gradient(circle at 32% 28%, #ffffff 0%, #BDEBFF 22%, #4FC3F7 55%, #0B3D4A 110%); box-shadow: inset -8px -12px 24px rgba(11,61,74,0.45), 0 10px 30px rgba(79,195,247,0.5); }
    .fa-orb-2 { width: 92px; height: 92px; bottom: 18%; right: 26%; background: radial-gradient(circle at 32% 28%, #ffffff 0%, #DFF5C8 22%, #7ED957 55%, #2E7D32 115%); box-shadow: inset -6px -9px 18px rgba(46,125,50,0.45), 0 8px 24px rgba(126,217,87,0.5); animation-delay: -3s; }
    .fa-orb-3 { width: 60px; height: 60px; top: 46%; right: 16%; background: radial-gradient(circle at 32% 28%, #ffffff 0%, #BDEBFF 25%, #4FC3F7 60%, #0B3D4A 115%); box-shadow: inset -4px -6px 12px rgba(11,61,74,0.4), 0 6px 18px rgba(79,195,247,0.45); animation-delay: -6s; }
    @keyframes fa-float { 50% { transform: translateY(-26px); } }
    .fa-flare {
      position: absolute; top: 8%; left: 55%; width: 220px; height: 220px; pointer-events: none;
      background: radial-gradient(circle, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.25) 28%, transparent 60%);
      animation: fa-flare 7s ease-in-out infinite alternate;
    }
    @keyframes fa-flare { to { opacity: 0.55; transform: scale(1.2); } }
    .fa-hero-in { position: relative; z-index: 2; width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); }
    .fa-glass-card {
      max-width: 620px; padding: clamp(30px, 4vw, 48px);
      background: linear-gradient(160deg, rgba(255,255,255,0.72), rgba(234,247,253,0.55));
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      border-radius: 32px; border: 1px solid rgba(255,255,255,0.8);
      box-shadow: inset 0 2px 6px rgba(255,255,255,0.8), inset 0 -3px 10px rgba(79,195,247,0.35), 0 20px 50px rgba(11,61,74,0.18);
      position: relative; overflow: hidden;
    }
    .fa-glass-card::before {
      content: ""; position: absolute; top: 0; left: 6%; right: 6%; height: 46%;
      background: linear-gradient(180deg, rgba(255,255,255,0.5), rgba(255,255,255,0));
      border-radius: 0 0 50% 50% / 0 0 24px 24px; pointer-events: none;
    }
