---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";

// Demo microsite: AERIS, fictional clean-tech company, Québec City.
// Standalone art direction. Frutiger Aero: glossy aqua, aurora gradients,
// dewy nature meets tech. Not connected to the WEBAO theme system.
// Structure : une page produit. Un seul produit (Aeris One), style Apple : grands visuels
// lustrés, gros plans sur les fonctions, fiche technique en tableau, navigation minimale.
const IMG = {
  hero: "/demos/aeris/01.jpg",
  chip: "/demos/aeris/02.jpg",
  solar: "https://images.unsplash.com/photo-1509391366360-2e959784a276?q=80&w=1000&auto=format&fit=crop",
  hills: "https://images.unsplash.com/photo-1501854140801-50d01698950b?q=80&w=1000&auto=format&fit=crop",
  leaves: "/demos/aeris/03.jpg",
  wave: "https://images.unsplash.com/photo-1439405326854-014607f694d7?q=80&w=1600&auto=format&fit=crop",
};

const FEATURES = [
  {
    img: IMG.chip, alt: "La puce Helio Core, faiblement luminescente",
    kick: "Helio Core", title: "Réfléchit 200 fois par seconde",
    copy: "Une puce de la taille d'un ongle qui lit le rythme énergétique de votre maison 200 fois par seconde et redirige le courant avant qu'un seul watt ne se perde. Elle apprend quand vous vous douchez, quand vous rechargez, quand le soleil se montre, et optimise tout en silence.",
  },
  {
    img: IMG.solar, alt: "Tuiles solaires au fini verre qui captent le soleil",
    kick: "Verre Aura", title: "Boit le soleil",
    copy: "Des tuiles solaires au fini verre qui ressemblent à un étang à midi. 22 % d'efficacité, à l'épreuve de la grêle, et magnifiques depuis la rue. Votre toit cesse d'être un toit et devient une centrale.",
  },
  {
    img: IMG.hills, alt: "Collines vertes sous un ciel lumineux",
    kick: "Dew Grid", title: "Partage avec la rue",
    copy: "Les quartiers partagent le soleil stocké grâce à un réseau maillé qui se comporte comme une forêt : chaque feuille nourrit la canopée. Votre surplus alimente la thermopompe du voisin; le leur recharge votre voiture.",
  },
  {
    img: IMG.wave, alt: "Eau claire qui capte la lumière",
    kick: "Aqua Buffer", title: "Garde l'été pour l'hiver",
    copy: "Le surplus solaire de l'été devient la chaleur de l'hiver, stocké dans des réservoirs d'eau si efficaces qu'on dirait de la science-fiction. Février tourne avec juillet.",
  },
];

const SPECS = [
  ["Modèle", "Aeris One (2026)"],
  ["Solaire", "Tuiles en verre Aura · 22 % d'efficacité · à l'épreuve de la grêle"],
  ["Stockage", "Cellule Nimbus · 13,5 kWh · secours anti-tempête"],
  ["Puce", "Helio Core · 200 lectures par seconde"],
  ["Appli", "Tableau de bord Glow · iOS et Android"],
  ["Réseau", "Réseau maillé Dew Grid · partagez avec votre rue"],
  ["Installation", "2 jours · équipe certifiée · zéro dommage au toit"],
  ["Garantie", "25 ans panneaux · 10 ans batterie"],
];

const IMPACT = [
  ["41 GWh", "d'énergie propre partagée"],
  ["18 400 t", "de CO₂ évitées"],
  ["96 %", "nous recommanderaient"],
  ["3,2 ans", "retour moyen"],
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aeris One : le pod d'énergie domestique · AERIS</title>
  <meta name="description" content="Découvrez Aeris One : verre solaire, puce intelligente et stockage anti-tempête dans un seul pod lumineux. Dès 8 900 $ installé. Scan énergétique gratuit." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="fa">

  <!-- MINIMAL NAV -->
  <header class="fa-navwrap">
    <nav class="fa-nav" aria-label="Primary">
      <a class="fa-logo" href="#top" aria-label="AERIS, accueil">AERIS</a>
      <a class="fa-nav-product" href="#one">Aeris One</a>
      <a class="fa-nav-link" href="#specs">Fiche</a>
      <a class="fa-buy" href="#buy">Acheter</a>
    </nav>
  </header>

  <main id="top">
    <!-- PRODUCT HERO -->
    <section class="fa-hero" id="one" aria-label="Aeris One">
      <div class="fa-hero-bg" aria-hidden="true"><img src={IMG.hero} alt="" loading="eager" fetchpriority="high" /></div>
      <div class="fa-wrap fa-hero-in">
        <p class="fa-new">Nouveau</p>
        <h1 class="fa-h1">Aeris One</h1>
        <p class="fa-tagline">Une énergie fraîche comme la rosée du matin.</p>
        <p class="fa-price">Dès 8 900 $ installé</p>
        <div class="fa-hero-cta">
          <a class="fa-btn-gloss" href="#buy">Acheter Aeris One</a>
          <a class="fa-link" href="#specs">Voir la fiche ↓</a>
        </div>
      </div>
      <div class="fa-bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="fa-highlights" aria-label="Aeris One highlights">
      <div class="fa-wrap fa-hl-row">
        <div><strong>38%</strong><span>baisse moyenne</span></div>
        <div><strong>12k</strong><span>maisons alimentées</span></div>
        <div><strong>0</strong><span>panne en 2025</span></div>
      </div>
    </section>

    <!-- FEATURE DEEP DIVES -->
    <section class="fa-features" aria-label="Features">
      <div class="fa-wrap">
        <p class="fa-kicker">Sous le verre</p>
        <h2 class="fa-h2">Un pod.<br />Quatre superpouvoirs.</h2>
      </div>
      {FEATURES.map((f, i) => (
        <div class={"fa-feat" + (i % 2 === 1 ? " fa-feat-flip" : "")}>
          <div class="fa-feat-media"><img src={f.img} alt={f.alt} loading="lazy" /></div>
          <div class="fa-feat-copy">
            <p class="fa-feat-kick">{f.kick}</p>
            <h3>{f.title}</h3>
            <p>{f.copy}</p>
          </div>
        </div>
      ))}
    </section>

    <!-- SPEC SHEET -->
    <section class="fa-specs" id="specs">
      <div class="fa-wrap-narrow">
        <p class="fa-kicker">Fiche technique</p>
        <h2 class="fa-h2">Les petits caractères,<br />enfin lisibles.</h2>
        <table class="fa-table">
          <caption class="fa-sr">Fiche technique d'Aeris One</caption>
          <tbody>
            {SPECS.map((s) => (
              <tr><th scope="row">{s[0]}</th><td>{s[1]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- IMPACT -->
    <section class="fa-impact" aria-label="Impact">
      <div class="fa-impact-bg" aria-hidden="true"><img src={IMG.leaves} alt="" loading="lazy" /></div>
      <div class="fa-wrap fa-impact-in">
        <h2 class="fa-h2 fa-h2-light">12 000 maisons.<br />Un réseau plus intelligent.</h2>
        <p class="fa-impact-sub">Chaque maison AERIS partage ses données (anonymement) pour que tout le réseau devienne plus intelligent. Voici ce que le parc a accompli l'an dernier.</p>
        <div class="fa-impact-row">
          {IMPACT.map((s) => (
            <div><strong>{s[0]}</strong><span>{s[1]}</span></div>
          ))}
        </div>
      </div>
    </section>

    <!-- BUY -->
    <section class="fa-buysec" id="buy">
      <div class="fa-wrap-narrow">
        <p class="fa-kicker">Gratuit, sans attache</p>
        <h2 class="fa-h2">Commencez par un scan.</h2>
        <p class="fa-buy-sub">Répondez à quatre questions et notre modèle Helio dessinera le potentiel solaire de votre maison, en mots simples, sous 24 heures. À vous de décider ensuite.</p>
        <div class="fa-buybox">
          <div class="fa-buybox-price">
            <p class="fa-buybox-name">Aeris One</p>
            <p class="fa-buybox-amount">Dès 8 900 $ <span>installé</span></p>
            <p class="fa-buybox-fine">Financement à 0 % disponible · garantie panneaux de 25 ans</p>
          </div>
          <form class="fa-form" id="fa-form" novalidate>
            <h3>Votre scan énergétique gratuit</h3>
            <label>Nom<input type="text" name="name" required placeholder="Alex Tremblay" /></label>
            <label>Courriel<input type="email" name="email" required placeholder="alex@example.com" /></label>
            <div class="fa-form-row">
              <label>Type d'habitation
                <select name="home">
                  <option>Maison unifamiliale</option>
                  <option>Condo / appartement</option>
                  <option>Duplex / triplex</option>
                  <option>Petit commerce</option>
                </select>
              </label>
              <label>Ensoleillement du toit
                <select name="sun">
                  <option>Beaucoup de soleil</option>
                  <option>Un peu d'ombre</option>
                  <option>Surtout ombragé</option>
                  <option>Aucune idée, surprenez-moi</option>
                </select>
              </label>
            </div>
            <button class="fa-btn-gloss fa-btn-full" type="submit">Scanner ma maison</button>
            <p class="fa-form-note" role="status" aria-live="polite"></p>
          </form>
        </div>
        <address class="fa-address">
          88, rue de l'Aurore, Québec, QC G1K 2B7<br />
          <a href="tel:+14185550193">(418) 555-0193</a> · <a href="mailto:hello@aeristech.ca">hello@aeristech.ca</a>
        </address>
      </div>
    </section>
  </main>

  <footer class="fa-footer">
    <div class="fa-wrap fa-footer-in">
      <p class="fa-footer-logo">AERIS</p>
      <p>© 2026 AERIS. Démo fictive. L'avenir est couvert de rosée.</p>
    </div>
  </footer>

  <EscapeHatch locale="fr" />

  <script>
    // Formulaire démo : ne soumet rien nulle part
    (function () {
      var form = document.getElementById('fa-form') as HTMLFormElement | null;
      form?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = form?.querySelector('.fa-form-note');
        if (note) note.textContent = 'Scan demandé. Notre modèle Helio dessinera votre potentiel solaire sous 24 heures.';
        form?.reset();
      });
    })();
  </script>

  <style>
    .fa {
      --fa-aqua: #4FC3F7;
      --fa-aqua-deep: #29A9E0;
      --fa-green: #7ED957;
      --fa-teal: #0B3D4A;
      --fa-teal-deep: #072A33;
      --fa-white: #FFFFFF;
      --fa-mist: #EAF7FD;
      --fa-ink: #0E2A33;
      --fa-sans: "Nunito", "Segoe UI", system-ui, sans-serif;
      margin: 0;
      background: linear-gradient(180deg, #F4FBFF 0%, #E4F4FC 40%, #F4FBFF 100%);
      color: var(--fa-ink);
      font-family: var(--fa-sans);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .fa *, .fa *::before, .fa *::after { box-sizing: border-box; }
    .fa img { display: block; max-width: 100%; }
    .fa-wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .fa-wrap-narrow { max-width: 760px; margin: 0 auto; padding: 0 clamp(22px, 4vw, 44px); }
    .fa-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* minimal nav */
    .fa-navwrap { position: sticky; top: 0; z-index: 60; background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(18px) saturate(1.6); border-bottom: 1px solid rgba(11, 61, 74, 0.1); }
    .fa-nav { display: flex; align-items: center; gap: 30px; max-width: 1120px; margin: 0 auto; padding: 14px clamp(22px, 4vw, 44px); }
    .fa-logo { font-weight: 900; font-size: 19px; letter-spacing: 0.14em; color: var(--fa-ink); text-decoration: none; margin-right: auto; }
    .fa-nav-product { font-weight: 800; font-size: 14.5px; color: var(--fa-ink); text-decoration: none; }
    .fa-nav-link { font-weight: 700; font-size: 14.5px; color: #4A6B76; text-decoration: none; }
    .fa-nav-link:hover, .fa-nav-product:hover { color: var(--fa-aqua-deep); }
    .fa-buy {
      font-weight: 800; font-size: 14px; color: #fff; text-decoration: none;
      background: linear-gradient(180deg, var(--fa-aqua), var(--fa-aqua-deep));
      padding: 10px 26px; border-radius: 999px; box-shadow: 0 6px 18px rgba(41, 169, 224, 0.4), inset 0 1px 0 rgba(255,255,255,0.5);
    }
    .fa-buy:hover { filter: brightness(1.06); }

    /* product hero */
    .fa-hero { position: relative; min-height: 92svh; display: flex; align-items: center; overflow: hidden; }
    .fa-hero-bg { position: absolute; inset: 0; }
    .fa-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
    .fa-hero-bg::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(234, 247, 253, 0.75) 0%, rgba(234, 247, 253, 0.25) 45%, rgba(234, 247, 253, 0.92) 100%);
    }
    .fa-hero-in { position: relative; text-align: center; padding-top: 60px; padding-bottom: 60px; }
    .fa-new { font-weight: 800; font-size: 15px; color: var(--fa-aqua-deep); letter-spacing: 0.2em; text-transform: uppercase; margin: 0 0 14px; }
    .fa-h1 { font-size: clamp(3.6rem, 12vw, 7.5rem); font-weight: 900; letter-spacing: -0.02em; margin: 0 0 12px; color: var(--fa-teal-deep); text-shadow: 0 2px 30px rgba(255,255,255,0.8); }
    .fa-tagline { font-size: clamp(1.4rem, 3.4vw, 2rem); font-weight: 700; color: var(--fa-teal); margin: 0 0 10px; }
    .fa-price { font-size: 17px; font-weight: 600; color: #4A6B76; margin: 0 0 34px; }
    .fa-hero-cta { display: flex; gap: 26px; align-items: center; justify-content: center; flex-wrap: wrap; }
    .fa-btn-gloss {
      display: inline-block; font-weight: 800; font-size: 17px; color: #fff; text-decoration: none; cursor: pointer; border: none; font-family: var(--fa-sans);
      background: linear-gradient(180deg, #6FD3F9 0%, var(--fa-aqua-deep) 55%, #1E96CE 100%);
      padding: 17px 44px; border-radius: 999px;
      box-shadow: 0 12px 32px rgba(41, 169, 224, 0.45), inset 0 2px 2px rgba(255,255,255,0.55), inset 0 -3px 6px rgba(7, 42, 51, 0.25);
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .fa-btn-gloss:hover { transform: translateY(-2px); filter: brightness(1.05); }
    .fa-link { font-weight: 800; font-size: 17px; color: var(--fa-aqua-deep); text-decoration: none; }
    .fa-link:hover { text-decoration: underline; }
    .fa-bubbles i { position: absolute; border-radius: 50%; background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.9), rgba(79,195,247,0.35)); border: 1px solid rgba(255,255,255,0.7); animation: fa-float 9s ease-in-out infinite; }
    .fa-bubbles i:nth-child(1) { width: 70px; height: 70px; left: 8%; bottom: 12%; }
    .fa-bubbles i:nth-child(2) { width: 44px; height: 44px; left: 16%; bottom: 30%; animation-delay: -2s; }
    .fa-bubbles i:nth-child(3) { width: 90px; height: 90px; right: 10%; bottom: 18%; animation-delay: -4s; }
    .fa-bubbles i:nth-child(4) { width: 36px; height: 36px; right: 22%; bottom: 40%; animation-delay: -6s; }
    .fa-bubbles i:nth-child(5) { width: 56px; height: 56px; left: 46%; bottom: 8%; animation-delay: -3s; }
    @keyframes fa-float { 50% { transform: translateY(-46px); } }

    /* highlights */
    .fa-highlights { padding: 56px 0; }
    .fa-hl-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: center; }
    .fa-hl-row div { display: grid; gap: 6px; }
    .fa-hl-row strong { font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 900; color: var(--fa-teal-deep); letter-spacing: -0.02em; }
    .fa-hl-row span { font-weight: 700; font-size: 14.5px; color: #4A6B76; }

    /* features */
    .fa-features { padding: clamp(40px, 6vw, 90px) 0; }
    .fa-kicker { font-weight: 800; font-size: 14px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--fa-aqua-deep); margin: 0 0 16px; }
    .fa-h2 { font-size: clamp(2.4rem, 6vw, 4.2rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.02; margin: 0 0 20px; color: var(--fa-teal-deep); }
    .fa-h2-light { color: #fff; text-shadow: 0 2px 24px rgba(7, 42, 51, 0.5); }
    .fa-feat { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 90px); align-items: center; max-width: 1120px; margin: 0 auto; padding: clamp(40px, 6vw, 80px) clamp(22px, 4vw, 44px); }
    .fa-feat-flip .fa-feat-media { order: 2; }
    .fa-feat-media img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 28px; box-shadow: 0 30px 80px rgba(11, 61, 74, 0.22), inset 0 2px 0 rgba(255,255,255,0.6); }
    .fa-feat-kick { font-weight: 800; font-size: 14px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--fa-aqua-deep); margin: 0 0 14px; }
    .fa-feat-copy h3 { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 900; letter-spacing: -0.01em; margin: 0 0 16px; color: var(--fa-teal-deep); }
    .fa-feat-copy p:last-child { font-size: 18px; line-height: 1.75; color: #33505B; margin: 0; max-width: 44ch; }

    /* spec sheet */
    .fa-specs { padding: clamp(60px, 8vw, 110px) 0; }
    .fa-specs .fa-kicker, .fa-specs .fa-h2 { text-align: center; }
    .fa-table { width: 100%; border-collapse: collapse; margin-top: 40px; font-size: 16.5px; background: rgba(255,255,255,0.65); backdrop-filter: blur(8px); border-radius: 20px; overflow: hidden; box-shadow: 0 20px 60px rgba(11, 61, 74, 0.12); }
    .fa-table th, .fa-table td { text-align: left; padding: 18px 28px; border-bottom: 1px solid rgba(11, 61, 74, 0.1); vertical-align: top; }
    .fa-table tr:last-child th, .fa-table tr:last-child td { border-bottom: none; }
    .fa-table th { font-weight: 800; color: var(--fa-teal-deep); white-space: nowrap; width: 34%; }
    .fa-table td { color: #33505B; }

    /* impact */
    .fa-impact { position: relative; padding: clamp(80px, 10vw, 140px) 0; overflow: hidden; }
    .fa-impact-bg { position: absolute; inset: 0; }
    .fa-impact-bg img { width: 100%; height: 100%; object-fit: cover; }
    .fa-impact-bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,42,51,0.55), rgba(7,42,51,0.35)); }
    .fa-impact-in { position: relative; text-align: center; }
    .fa-impact-sub { color: #EAF7FD; font-size: 18px; line-height: 1.7; max-width: 52ch; margin: 0 auto 44px; }
    .fa-impact-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .fa-impact-row div { display: grid; gap: 6px; background: rgba(255,255,255,0.14); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3); border-radius: 20px; padding: 28px 16px; }
    .fa-impact-row strong { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; color: #fff; }
    .fa-impact-row span { font-size: 14px; font-weight: 700; color: #D8F0FB; }

    /* buy */
    .fa-buysec { padding: clamp(70px, 9vw, 120px) 0; }
    .fa-buysec .fa-kicker, .fa-buysec .fa-h2 { text-align: center; }
    .fa-buy-sub { text-align: center; font-size: 18px; line-height: 1.7; color: #33505B; max-width: 52ch; margin: 0 auto 40px; }
    .fa-buybox {
      display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 0; overflow: hidden;
      background: rgba(255,255,255,0.8); backdrop-filter: blur(12px); border-radius: 28px;
      box-shadow: 0 30px 90px rgba(11, 61, 74, 0.16); border: 1px solid rgba(255,255,255,0.8);
    }
    .fa-buybox-price { background: linear-gradient(160deg, var(--fa-teal), var(--fa-teal-deep)); color: #fff; padding: clamp(30px, 5vw, 54px); display: flex; flex-direction: column; justify-content: center; }
    .fa-buybox-name { font-weight: 900; font-size: 26px; margin: 0 0 10px; }
    .fa-buybox-amount { font-weight: 900; font-size: clamp(2rem, 4.5vw, 3rem); margin: 0 0 14px; color: var(--fa-green); letter-spacing: -0.01em; }
    .fa-buybox-amount span { font-size: 16px; font-weight: 700; color: #BFE3F2; }
    .fa-buybox-fine { margin: 0; color: #BFE3F2; font-size: 14.5px; line-height: 1.6; }
    .fa-form { padding: clamp(30px, 5vw, 54px); display: grid; gap: 18px; }
    .fa-form h3 { font-size: 22px; font-weight: 900; margin: 0; color: var(--fa-teal-deep); }
    .fa-form label { display: grid; gap: 8px; font-weight: 800; font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #4A6B76; }
    .fa-form input, .fa-form select {
      font-family: var(--fa-sans); font-size: 16.5px; font-weight: 600; color: var(--fa-ink);
      background: #fff; border: 2px solid #D8ECF5; border-radius: 14px; padding: 14px 18px; width: 100%;
    }
    .fa-form input:focus, .fa-form select:focus { outline: 3px solid var(--fa-aqua); outline-offset: 1px; border-color: var(--fa-aqua-deep); }
    .fa-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .fa-btn-full { width: 100%; text-align: center; }
    .fa-form-note { margin: 0; color: var(--fa-aqua-deep); font-weight: 700; font-size: 16px; text-align: center; }
    .fa-form-note:empty { display: none; }
    .fa-address { font-style: normal; text-align: center; margin: 36px 0 0; color: #4A6B76; font-size: 15.5px; line-height: 1.8; }
    .fa-address a { color: var(--fa-aqua-deep); font-weight: 700; }

    /* footer */
    .fa-footer { padding: 60px 0 90px; text-align: center; }
    .fa-footer-in { display: grid; gap: 8px; color: #4A6B76; font-size: 14.5px; }
