---
import EscapeHatch from "../../../components/demos/EscapeHatch.astro";
import DemoSeo from "../../../components/demos/DemoSeo.astro";

// Demo microsite: Clinique Sora, fictional physiotherapy and wellness clinic, Brossard QC.
// Rebuilt as an APPOINTMENT BOOK: schedule-first. Day tabs, time slots, practitioner roster,
// treatment menu. Clinic info is secondary.
// Standalone art direction. Soft clinical calm. Not connected to the WEBAO theme system.
const IMG = {
  physio: "/demos/sora/01.jpg",
  massage: "/demos/sora/04.jpg",
  team1: "/demos/sora/02.jpg",
  team2: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=700&auto=format&fit=crop",
  team3: "/demos/sora/03.jpg",
};
const DAYS = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi"];
const SLOTS: Record<string, { t: string; taken?: boolean }[]> = {
  Lundi: [{ t: "8:00" }, { t: "9:30", taken: true }, { t: "11:00" }, { t: "14:00", taken: true }, { t: "16:30" }, { t: "18:00" }],
  Mardi: [{ t: "8:00", taken: true }, { t: "10:00" }, { t: "12:30" }, { t: "15:00" }, { t: "17:00", taken: true }, { t: "19:00" }],
  Mercredi: [{ t: "9:00" }, { t: "10:30" }, { t: "13:00", taken: true }, { t: "15:30" }, { t: "17:30" }],
  Jeudi: [{ t: "8:30" }, { t: "10:00", taken: true }, { t: "11:30" }, { t: "14:30" }, { t: "16:00", taken: true }, { t: "18:30" }],
  Vendredi: [{ t: "8:00" }, { t: "9:30" }, { t: "11:00", taken: true }, { t: "13:30" }],
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DemoSeo demoId="sora" locale="fr" title="Clinique Sora : Physiothérapie et bien-être à Brossard" description="Clinique Sora : clinique de physiothérapie et bien-être à Brossard. Physio, massothérapie, réadaptation posturale. Réservez votre évaluation en ligne en moins d'une minute." ogImage="https://webao.ca/demos/sora/01.jpg" />


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="sr">

  <header class="sr-nav">
    <a class="sr-brand" href="#top" aria-label="Clinique Sora, accueil">
      <span class="sr-brand-dot" aria-hidden="true"></span>
      <span>Clinique <strong>Sora</strong></span>
    </a>
    <p class="sr-nav-note">Brossard QC · nouveaux patients acceptés</p>
    <a class="sr-nav-book" href="#book">Réserver</a>
  </header>

  <main id="top">
    <!-- LE CAHIER DE RENDEZ-VOUS -->
    <section class="sr-book" id="book">
      <div class="sr-wrap">
        <h1 class="sr-h1">Réservez votre<br />évaluation.</h1>
        <p class="sr-lede">Choisissez un jour, une heure, dites-nous qui vous êtes. Soixante minutes, en tête-à-tête, avec un plan que vous pourrez vraiment suivre. On confirme par texto.</p>

        <div class="sr-daytabs" role="tablist" aria-label="Choisir un jour">
          {DAYS.map((d, i) => (
            <button type="button" role="tab" class={`sr-daytab${i === 0 ? " is-active" : ""}`} data-day={d} aria-selected={i === 0 ? "true" : "false"}>{d.slice(0, 3)}</button>
          ))}
        </div>

        <div class="sr-slots" id="sr-slots" aria-label="Heures disponibles"></div>

        <form class="sr-bookform" id="sr-book-form" novalidate>
          <p class="sr-picked" id="sr-picked" role="status" aria-live="polite">Choisissez un jour et une heure ci-dessus.</p>
          <input type="hidden" name="slot" id="sr-slot-input" />
          <label>Service
            <select name="service" required>
              <option value="">Choisir…</option>
              <option>Évaluation en physiothérapie</option>
              <option>Massothérapie</option>
              <option>Réadaptation sportive</option>
              <option>Réadaptation posturale</option>
            </select>
          </label>
          <label>Votre nom<input type="text" name="name" required placeholder="Jeanne Tremblay" autocomplete="name" /></label>
          <label>Téléphone<input type="tel" name="phone" required placeholder="(450) 555-0000" autocomplete="tel" /></label>
          <button type="submit">Demander la réservation</button>
          <p class="sr-book-note" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- L'ÉQUIPE -->
    <section class="sr-roster">
      <div class="sr-wrap">
        <h2 class="sr-h2">Qui vous recevra.</h2>
        <ul class="sr-roster-list">
          <li>
            <img src={IMG.team1} alt="Dre Amélie Roy, physiothérapeute" loading="lazy" decoding="async" />
            <div><h3>Dre Amélie Roy, pht</h3><p>Physiothérapie · Fondatrice. Douze ans à soigner dos, genoux et guerriers du week-end.</p></div>
            <span class="sr-next">Prochain : lun. 11:00</span>
          </li>
          <li>
            <img src={IMG.team2} alt="Jean-Philippe Côté, massothérapeute" loading="lazy" decoding="async" />
            <div><h3>Jean-Philippe Côté</h3><p>Massothérapie. Deep tissue et massage sportif avec une touche douce.</p></div>
            <span class="sr-next">Prochain : mar. 15:00</span>
          </li>
          <li>
            <img src={IMG.team3} alt="Sara Nguyen, kinésiologue" loading="lazy" decoding="async" />
            <div><h3>Sara Nguyen, kin.</h3><p>Kinésiologie · Réadaptation. Programmes maison et retours au sport.</p></div>
            <span class="sr-next">Prochain : mer. 9:00</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- MENU DES SOINS -->
    <section class="sr-menu">
      <div class="sr-wrap sr-narrow">
        <h2 class="sr-h2">Menu des soins.</h2>
        <ul class="sr-menu-list">
          <li><div><h3>Évaluation en physiothérapie</h3><p>Maux de dos et de cou, blessures articulaires, réadaptation post-chirurgicale. Thérapie manuelle et programme maison.</p></div><span>60 min · 95 $</span></li>
          <li><div><h3>Suivi en physiothérapie</h3><p>Soins continus, avec votre plan ajusté à mesure que vous progressez.</p></div><span>45 min · 85 $</span></li>
          <li><div><h3>Massothérapie</h3><p>Massage thérapeutique et deep tissue pour les tensions, la récupération, et une détente qui dure.</p></div><span>60 min · 105 $</span></li>
          <li><div><h3>Réadaptation sportive</h3><p>Entorses, claquages et retours au sport planifiés autour de votre saison.</p></div><span>45 min · 90 $</span></li>
          <li><div><h3>Réadaptation posturale</h3><p>Douleurs liées au bureau, rééducation posturale et conseils ergonomiques pour la vraie vie.</p></div><span>45 min · 85 $</span></li>
          <li><div><h3>Soins périnataux</h3><p>Accompagnement pendant la grossesse et le post-partum : plancher pelvien, maux de dos, retour au mouvement.</p></div><span>60 min · 100 $</span></li>
          <li><div><h3>Réadaptation vestibulaire</h3><p>Étourdissements et vertiges traités par repositionnement précis et travail d'équilibre.</p></div><span>45 min · 95 $</span></li>
        </ul>
        <figure class="sr-menu-media">
          <img src={IMG.physio} alt="Une physiothérapeute guidant le mouvement de l'épaule d'une patiente" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <!-- COMMENT ÇA SE PASSE -->
    <section class="sr-how">
      <div class="sr-wrap sr-narrow">
        <h2 class="sr-h2">Comment ça se passe.</h2>
        <p><strong>On écoute d'abord.</strong> Votre histoire, votre douleur, vos objectifs. Toute l'histoire, pas un formulaire à cocher.</p>
        <p><strong>On évalue à fond.</strong> Dépistage du mouvement et tests manuels pour trouver la vraie cause, pas juste le symptôme.</p>
        <p><strong>On soigne et on enseigne.</strong> Thérapie manuelle à la clinique, exercices simples à la maison, et un plan avec une ligne d'arrivée.</p>
        <figure class="sr-how-media">
          <img src={IMG.massage} alt="Une séance de massothérapie paisible dans une douce lumière" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sr-faqwrap">
      <div class="sr-wrap sr-narrow">
        <h2 class="sr-h2">Bon à savoir.</h2>
        <div class="sr-faq">
          <details><summary>Faut-il une référence d'un médecin?</summary><p>Non. Vous pouvez réserver directement. Certains assureurs exigent une référence pour le remboursement, alors vérifiez votre régime si vous voulez réclamer.</p></details>
          <details><summary>Facturez-vous les assurances directement?</summary><p>Oui, pour la plupart des grands assureurs. Apportez votre carte et on s'occupe de la paperasse à l'accueil.</p></details>
          <details><summary>Quoi porter?</summary><p>Ce dans quoi vous bougez confortablement. On a des cabines privées et des jaquettes au besoin.</p></details>
          <details><summary>Des rendez-vous en soirée?</summary><p>Oui. On est ouverts lun–ven 8 h–20 h et sam 9 h–14 h.</p></details>
        </div>
      </div>
    </section>
  </main>

  <footer class="sr-footer">
    <div class="sr-wrap sr-footer-grid">
      <div>
        <p class="sr-footer-brand">Clinique <strong>Sora</strong></p>
        <p>789, rue Fictive, bureau 200<br />Brossard QC J4Z 1A1</p>
      </div>
      <div>
        <p class="sr-footer-h">Heures</p>
        <p>Lun–ven 8 h–20 h<br />Sam 9 h–14 h</p>
      </div>
      <div>
        <p class="sr-footer-h">Réserver</p>
        <a class="sr-footer-phone" href="tel:+14505550162">(450) 555-0162</a>
        <p><a href="#book">Réservation en ligne ↑</a></p>
      </div>
    </div>
    <p class="sr-fine">© 2026 Clinique Sora. Site de démonstration fictif, pas une vraie clinique. Facturation directe à la plupart des assureurs.</p>
  </footer>

  <EscapeHatch locale="fr" />

  <script define:vars={{ slots: SLOTS }}>
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.sr-daytab'));
      var wrap = document.getElementById('sr-slots');
      var picked = document.getElementById('sr-picked');
      var hiddenEl = document.getElementById('sr-slot-input');
      function setSlot(v) { if (hiddenEl instanceof HTMLInputElement) hiddenEl.value = v; }
      function getSlot() { return hiddenEl instanceof HTMLInputElement ? hiddenEl.value : ''; }
      var current = tabs.length ? tabs[0].getAttribute('data-day') : '';

      function render(day) {
        if (!wrap) return;
        wrap.innerHTML = '';
        (slots[day] || []).forEach(function (s) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'sr-slot' + (s.taken ? ' is-taken' : '');
          b.textContent = s.t;
          b.disabled = !!s.taken;
          if (s.taken) b.setAttribute('aria-label', s.t + ', pris');
          b.addEventListener('click', function () {
            wrap?.querySelectorAll('.sr-slot').forEach(function (x) { x.classList.remove('is-picked'); });
            b.classList.add('is-picked');
            setSlot(day + ' ' + s.t);
            if (picked) picked.textContent = 'Choisi : ' + day + ' à ' + s.t + '. Maintenant, dites-nous qui vous êtes.';
          });
          wrap.appendChild(b);
        });
      }
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          current = tab.getAttribute('data-day') || '';
          setSlot('');
          if (picked) picked.textContent = 'Choisissez une heure ci-dessus.';
          render(current);
        });
      });
      render(current);

      var formEl = document.getElementById('sr-book-form');
      formEl?.addEventListener('submit', function (e) {
        e.preventDefault();
        var note = formEl?.querySelector('.sr-book-note');
        var slot = getSlot();
        if (!slot) {
          if (note) note.textContent = "Choisissez d'abord un jour et une heure.";
          return;
        }
        if (note) note.textContent = 'Demande reçue pour ' + slot + '. On vous texte sous peu pour confirmer.';
        if (formEl instanceof HTMLFormElement) formEl.reset();
        if (picked) picked.textContent = 'Choisissez un jour et une heure ci-dessus.';
      });
    })();
  </script>

  <style>
    .sr {
      --sr-white: #FFFFFF;
      --sr-mist: #EAF1F1;
      --sr-mist-2: #DDE9E9;
      --sr-teal: #5E8B8B;
      --sr-teal-deep: #3E6262;
      --sr-ink: #2E3A3A;
      --sr-ink-soft: rgba(46, 58, 58, 0.66);
      --sr-sans: "Nunito", "Segoe UI", system-ui, sans-serif;
      margin: 0;
      background: var(--sr-white);
      color: var(--sr-ink);
      font-family: var(--sr-sans);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    .sr *, .sr *::before, .sr *::after { box-sizing: border-box; }
    .sr img { display: block; max-width: 100%; }
    .sr-wrap { max-width: 1160px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 48px); }
    .sr-narrow { max-width: 780px; margin-inline: auto; }
    .sr-h1 { font-size: clamp(2.8rem, 6vw, 4.8rem); font-weight: 800; line-height: 1.04; letter-spacing: -0.01em; margin: 0 0 18px; }
    .sr-h2 { font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 30px; }
    .sr-lede { font-size: 18px; line-height: 1.65; color: var(--sr-ink-soft); margin: 0 0 36px; max-width: 52ch; font-weight: 600; }

    .sr-nav {
      position: sticky; top: 0; z-index: 20;
      display: flex; align-items: center; gap: 26px;
      padding: 14px clamp(22px, 5vw, 48px); max-width: 1280px; margin: 0 auto;
      background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--sr-mist-2);
    }
    .sr-brand { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; color: var(--sr-ink); font-size: 21px; font-weight: 700; }
    .sr-brand strong { font-weight: 800; }
    .sr-brand-dot { width: 26px; height: 26px; border-radius: 50%; background: radial-gradient(circle at 32% 30%, #9DC3C3, var(--sr-teal)); box-shadow: 0 4px 12px rgba(94,139,139,0.4); }
    .sr-nav-note { margin: 0 0 0 auto; font-size: 13.5px; font-weight: 700; color: var(--sr-ink-soft); letter-spacing: 0.06em; }
    .sr-nav-book { background: var(--sr-teal); color: #fff; text-decoration: none; font-weight: 800; font-size: 15.5px; padding: 12px 24px; border-radius: 999px; box-shadow: 0 8px 20px rgba(94,139,139,0.35); transition: background 0.18s ease, transform 0.18s ease; }
    .sr-nav-book:hover { background: var(--sr-teal-deep); transform: translateY(-2px); }

    /* le cahier */
    .sr-book { padding: clamp(56px, 9vh, 110px) 0 clamp(60px, 9vh, 100px); background: radial-gradient(1100px 520px at 12% 8%, var(--sr-mist) 0%, transparent 60%); }
    .sr-daytabs { display: flex; gap: 10px; margin-bottom: 22px; flex-wrap: wrap; }
    .sr-daytab {
      font-family: var(--sr-sans); font-weight: 800; font-size: 16px; cursor: pointer;
      border: 2px solid var(--sr-mist-2); background: #fff; color: var(--sr-ink-soft);
      border-radius: 16px; padding: 14px 22px; transition: all 0.16s ease;
    }
    .sr-daytab:hover { border-color: var(--sr-teal); color: var(--sr-teal-deep); }
    .sr-daytab.is-active { background: var(--sr-teal); border-color: var(--sr-teal); color: #fff; box-shadow: 0 10px 24px rgba(94,139,139,0.35); }
    .sr-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(108px, 1fr)); gap: 12px; margin-bottom: 30px; min-height: 64px; }
    .sr-slot {
      font-family: var(--sr-sans); font-weight: 800; font-size: 17px; cursor: pointer;
      border: 2px solid var(--sr-mist-2); background: #fff; color: var(--sr-ink);
      border-radius: 16px; padding: 16px 8px; transition: all 0.14s ease;
    }
    .sr-slot:hover:not(:disabled) { border-color: var(--sr-teal); transform: translateY(-2px); }
    .sr-slot.is-picked { background: var(--sr-teal-deep); border-color: var(--sr-teal-deep); color: #fff; }
    .sr-slot.is-taken { opacity: 0.38; text-decoration: line-through; cursor: not-allowed; }
    .sr-picked { font-weight: 700; font-size: 16px; color: var(--sr-teal-deep); margin: 0 0 20px; }
    .sr-bookform { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; background: #fff; border: 1px solid var(--sr-mist-2); border-radius: 24px; padding: clamp(24px, 4vw, 40px); box-shadow: 0 24px 60px rgba(62,98,98,0.12); }
    .sr-bookform label { display: grid; gap: 8px; font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sr-teal-deep); }
    .sr-bookform input, .sr-bookform select {
      font-family: var(--sr-sans); font-size: 16px; font-weight: 600; color: var(--sr-ink);
      background: var(--sr-mist); border: 2px solid transparent; border-radius: 16px; padding: 14px 16px; width: 100%;
    }
    .sr-bookform input:focus, .sr-bookform select:focus { outline: none; border-color: var(--sr-teal); background: #fff; }
    .sr-bookform button {
      font-family: var(--sr-sans); font-size: 17px; font-weight: 800;
      background: var(--sr-teal); color: #fff; border: 0; border-radius: 16px; padding: 16px; cursor: pointer;
      transition: background 0.18s ease, transform 0.18s ease; box-shadow: 0 12px 26px rgba(94,139,139,0.35);
    }
    .sr-bookform button:hover { background: var(--sr-teal-deep); transform: translateY(-2px); }
    .sr-book-note { grid-column: 1 / -1; margin: 0; text-align: center; font-weight: 700; font-size: 15px; color: var(--sr-teal-deep); }
    .sr-book-note:empty { display: none; }

    /* l'équipe */
    .sr-roster { padding: clamp(60px, 9vh, 100px) 0; background: var(--sr-mist); }
    .sr-roster-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--sr-mist-2); }
    .sr-roster-list li { display: grid; grid-template-columns: 84px 1fr auto; gap: 22px; align-items: center; padding: 22px 4px; border-bottom: 1px solid var(--sr-mist-2); }
    .sr-roster-list img { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; filter: saturate(0.94); }
    .sr-roster-list h3 { font-size: 19px; font-weight: 800; margin: 0 0 6px; }
    .sr-roster-list p { margin: 0; font-size: 15px; color: var(--sr-ink-soft); font-weight: 600; max-width: 52ch; }
    .sr-next { font-size: 13.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sr-teal-deep); background: #fff; border-radius: 999px; padding: 10px 18px; white-space: nowrap; }

    /* menu des soins */
    .sr-menu { padding: clamp(60px, 9vh, 100px) 0; }
    .sr-menu-list { list-style: none; margin: 0 0 44px; padding: 0; border-top: 1px solid var(--sr-mist-2); }
    .sr-menu-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 26px; padding: 24px 4px; border-bottom: 1px solid var(--sr-mist-2); }
    .sr-menu-list h3 { font-size: 18.5px; font-weight: 800; margin: 0 0 8px; }
    .sr-menu-list p { margin: 0; font-size: 15px; color: var(--sr-ink-soft); font-weight: 600; max-width: 54ch; line-height: 1.6; }
    .sr-menu-list span { font-weight: 800; font-size: 15.5px; color: var(--sr-teal-deep); white-space: nowrap; }
    .sr-menu-media { margin: 0; }
    .sr-menu-media img { width: 100%; height: min(420px, 60vw); object-fit: cover; border-radius: 28px; filter: saturate(0.94) brightness(1.02); }

    /* comment ça se passe */
    .sr-how { padding: clamp(60px, 9vh, 100px) 0; background: var(--sr-mist); }
    .sr-how p { font-size: 17px; line-height: 1.7; font-weight: 600; color: var(--sr-ink-soft); max-width: 60ch; margin: 0 0 18px; }
    .sr-how p strong { color: var(--sr-ink); font-weight: 800; }
    .sr-how-media { margin: 36px 0 0; }
    .sr-how-media img { width: 100%; height: min(380px, 56vw); object-fit: cover; border-radius: 28px; filter: saturate(0.94) brightness(1.02); }

    /* faq */
    .sr-faqwrap { padding: clamp(60px, 9vh, 100px) 0; }
    .sr-faq { display: grid; gap: 14px; }
    .sr-faq details { background: #fff; border: 1px solid var(--sr-mist-2); border-radius: 20px; padding: 6px 26px; }
    .sr-faq summary { cursor: pointer; font-weight: 800; font-size: 17px; padding: 20px 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    .sr-faq summary::-webkit-details-marker { display: none; }
    .sr-faq summary::after { content: "+"; flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--sr-mist); color: var(--sr-teal-deep); display: grid; place-items: center; font-size: 20px; font-weight: 800; transition: transform 0.2s ease, background 0.2s ease; }
    .sr-faq details[open] summary::after { transform: rotate(45deg); background: var(--sr-teal); color: #fff; }
    .sr-faq details p { margin: 0 0 22px; font-size: 16px; line-height: 1.65; color: var(--sr-ink-soft); font-weight: 600; }

    .sr-footer { background: var(--sr-teal-deep); color: #fff; padding: clamp(52px, 8vh, 88px) 0 30px; }
    .sr-footer-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 34px; margin-bottom: 44px; }
    .sr-footer-brand { font-size: 27px; font-weight: 700; margin: 0 0 14px; }
    .sr-footer-brand strong { font-weight: 800; }
    .sr-footer p { font-size: 15.5px; line-height: 1.7; font-weight: 600; opacity: 0.88; margin: 0 0 10px; }
    .sr-footer a { color: #fff; }
    .sr-footer-h { font-size: 12.5px !important; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.7 !important; }
