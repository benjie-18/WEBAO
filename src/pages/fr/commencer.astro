---
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = "fr" as const;
const title = "Démarrer mon site · WEBAO";
const description = "Démarrez votre site WEBAO : dites-nous qui vous êtes, puis finalisez votre abonnement de 149 $/mois.";

// Clé publique Stripe; sûre à intégrer dans le code frontend.
const STRIPE_PUBLISHABLE_KEY = "pk_live_51UMzZYE57vVzxI418WAmnlUuIXMLMWtNxjYa6WeWauaSmAhF3xfwaFfdP4D4kJUG2k1nieWrIGSYVMDcy2WYIJ2T00TPmrTePT";
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="section">
    <div class="shell" style="max-width: 640px;">
      <div class="eyebrow">Démarrer mon site</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.2rem); line-height:.92; margin-top:12px;">Allons-y.</h1>
      <p class="prose" style="margin-top:12px; max-width: 52ch;">
        Dites-nous qui vous êtes, puis finalisez le paiement ci-dessous.
        Votre abonnement de 149 $/mois débute aujourd'hui; nous vous contactons dans un délai d'un jour ouvrable pour démarrer votre site.
      </p>

      <form id="start-form" class="start-form" novalidate style="margin-top: 28px;">
        <label>Votre nom
          <input name="name" placeholder="Votre nom" autocomplete="name" required />
          <span class="field-error mono" data-error="name" hidden></span>
        </label>
        <label>Courriel
          <input name="email" type="email" placeholder="vous@votreentreprise.ca" autocomplete="email" required />
          <span class="field-error mono" data-error="email" hidden></span>
        </label>
        <label>Nom de l'entreprise
          <input name="business" placeholder="Nom de votre entreprise" autocomplete="organization" required />
          <span class="field-error mono" data-error="business" hidden></span>
        </label>
        <p class="mono" style="font-size:11px; color: var(--muted); margin: 4px 0 0;">Le formulaire de paiement apparaît ci-dessous une fois vos infos valides.</p>
      </form>

      <div class="checkout-card checkout-card--pay" style="margin-top: 20px;">
        <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5; margin-bottom:12px;">PAIEMENT SÉCURISÉ · 149 $ CAD/MOIS</div>
        <div id="stripe-checkout">
          <div class="mono" style="padding:40px 20px; text-align:center; color: var(--muted); font-size:12.5px;" id="checkout-loading">
            Remplissez vos coordonnées ci-dessus pour charger le formulaire de paiement.
          </div>
        </div>
        <div class="mono" style="margin-top:12px; font-size:10.5px; text-align:center; color: var(--muted);">
          🔒 Chiffré et sécurisé · Propulsé par Stripe · <a href="/fr/refunds" style="color: var(--accent-text);">Politique de remboursement</a>
        </div>
      </div>

      <p class="mono" style="margin-top:24px; font-size:11px; color: var(--muted); text-align:center;">
        Une simple question? <a href="/fr/contact" style="color: var(--ink);">Contactez-nous</a> plutôt.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="https://js.stripe.com/v3/"></script>
<script define:vars={{ pk: STRIPE_PUBLISHABLE_KEY }}>
  (function() {
    if (window.__webaoStartMounted) return;
    const form = document.getElementById('start-form');
    if (!form) return;
    const loadingEl = document.getElementById('checkout-loading');
    let checkoutMounted = false;
    let mountInFlight = false;
    const touched = { name: false, email: false, business: false };

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function setFieldError(field, msg) {
      const el = form.querySelector('[data-error="' + field + '"]');
      const input = form.querySelector('[name="' + field + '"]');
      if (el) {
        if (msg) {
          el.textContent = msg;
          el.hidden = false;
        } else {
          el.hidden = true;
        }
      }
      if (input) input.classList.toggle('input-error', !!msg);
    }

    function getFormData() {
      const data = new FormData(form);
      return {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        business: String(data.get('business') || '').trim(),
      };
    }

    function validateField(field, value) {
      let msg = null;
      if (field === 'name' && !value) msg = 'Veuillez entrer votre nom.';
      else if (field === 'business' && !value) msg = "Veuillez entrer le nom de l'entreprise.";
      else if (field === 'email') {
        if (!value) msg = 'Veuillez entrer votre courriel.';
        else if (!EMAIL_RE.test(value)) msg = 'Entrez un courriel valide comme nom@domaine.com.';
      }
      if (touched[field]) setFieldError(field, msg);
      return !msg;
    }

    function allValid(d) {
      return d.name && d.business && EMAIL_RE.test(d.email);
    }

    async function mountCheckout() {
      if (checkoutMounted || mountInFlight) return;
      const d = getFormData();
      if (!allValid(d)) return;
      mountInFlight = true;

      if (!window.Stripe) {
        if (loadingEl) loadingEl.textContent = 'Stripe n\'a pas pu être chargé. Vérifiez votre connexion et actualisez.';
        mountInFlight = false;
        return;
      }

      if (loadingEl) loadingEl.textContent = 'Chargement du formulaire de paiement…';

      try {
        sessionStorage.setItem('webao-checkout', JSON.stringify(d));
        fetch('/api/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({ form: 'start', fields: { ...d, page: location.pathname, locale: 'fr' } }),
        }).catch(() => {});
      } catch (e) {}

      try {
        const stripe = window.Stripe(pk);
        const checkout = await stripe.initEmbeddedCheckout({
          fetchClientSecret: async () => {
            const res = await fetch('/api/checkout/session', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...d, locale: 'fr' }),
            });
            const data = await res.json();
            if (!data.ok || !data.clientSecret) {
              throw new Error(data.error || 'Paiement indisponible');
            }
            return data.clientSecret;
          },
        });
        checkout.mount('#stripe-checkout');
        checkoutMounted = true;
        window.__webaoStartMounted = true;
      } catch (e) {
        console.error('Stripe checkout error:', e);
        if (loadingEl) loadingEl.textContent = 'Paiement indisponible (' + (e.message || 'erreur inconnue') + '). Vérifiez votre connexion et vos infos.';
        mountInFlight = false;
      }
    }

    if (form) {
      form.addEventListener('input', (e) => {
        const input = e.target;
        if (!input || !input.name || !(input.name in touched)) return;
        touched[input.name] = true;
        const d = getFormData();
        validateField(input.name, d[input.name]);
        if (allValid(d)) mountCheckout();
      });
      form.addEventListener('focusout', (e) => {
        const input = e.target;
        if (!input || !input.name || !(input.name in touched)) return;
        touched[input.name] = true;
        const d = getFormData();
        validateField(input.name, d[input.name]);
      });
      form.addEventListener('submit', (e) => e.preventDefault());
    }
  })();
</script>

<style>
  .start-form {
    display: grid;
    gap: 14px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
  }
  .start-form label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .start-form input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--paper-3);
    font-size: 14px;
    color: var(--ink);
  }
  .start-form input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .start-form input.input-error {
    border-color: #c0392b;
  }
  .field-error {
    font-size: 11.5px;
    color: #c0392b;
    margin-top: 2px;
  }
  .checkout-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--card-bg);
  }
  .checkout-card--pay {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  #stripe-checkout {
    min-height: 320px;
    border-radius: 12px;
    overflow: hidden;
  }
</style>
