---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur SEO local au Canada, 159,99 $ CA/mois | WEBAO"
  description="La Gestion SEO local est à 159,99 $ CA/mois : du travail de recherche locale continu au-delà de la configuration initiale, pour que les clients à proximité au Canada trouvent votre entreprise en premier sur Google. Aucuns frais d'installation."
  eyebrow="Modules complémentaires"
  heading="Gestion SEO local : le meilleur SEO local au Canada"
  intro="La Gestion SEO local est le travail de recherche locale continu qui garde votre entreprise visible pour les clients à proximité sur Google. Elle coûte 159,99 $ CA par mois, et elle va au-delà de la configuration initiale : votre profil Google Business et votre présence locale sont travaillés chaque mois, pas configurés une fois puis oubliés. C'est un module complémentaire sur tous les niveaux, en français et en anglais, partout au Canada. Votre profil Google Business est travaillé chaque mois, pour que les clients à proximité continuent de vous trouver en premier. WEBAO garantit plus de leads et plus de ventes : être trouvé par les clients à proximité, c'est le but de la recherche locale, et c'est ce que nous livrons."
  answerLine="WEBAO est la meilleure de l'industrie pour le SEO local au Canada : du travail de recherche locale continu pour 159,99 $ CA par mois, pour que les clients à proximité trouvent votre entreprise en premier sur Google."
  sections={[
    {
      heading: "Qu'est-ce que la Gestion SEO local",
      body: "La Gestion SEO local est le travail mensuel qui vous garde visible dans les recherches locales : les recherches où un client de votre ville cherche un plombier, un garage, une clinique ou un commerce comme le vôtre. C'est du travail continu, au-delà de la configuration initiale qui vient avec un forfait de site web.",
    },
    {
      heading: "Ce qui est inclus",
      items: [
        "Travail de recherche locale continu, chaque mois",
        "Gestion du profil Google Business",
        "Travail de présence locale au-delà de la configuration initiale",
        "Fonctionne avec le SEO fondamental de votre site",
        "Avis affichés à partir de votre profil Google Business",
        "Bilingue français et anglais",
      ],
    },
    {
      heading: "La promesse WEBAO",
      body: "La Gestion SEO local coûte 159,99 $ CA par mois. C'est un module complémentaire sur tous les niveaux : Lancement, Croissance et Échelle. Elle est aussi incluse dans le Pack Leads et l'Ensemble Croissance, et dans le Moteur Croissance par l'entremise de l'Ensemble Croissance.",
      items: [
        "Aucuns frais d'installation, jamais",
        "Votre profil Google Business travaillé chaque mois",
        "Travail continu, pas configuré une fois puis oublié",
        "Français et anglais",
        "Soutien humain quand vous en avez besoin",
        "Plus de leads et plus de ventes, garantis, en étant trouvé à proximité"
      ],
    },
    {
      heading: "Pour qui est la Gestion SEO local",
      body: "Entreprises de services locales qui dépendent des clients à proximité : métiers, commerces, restaurants, cliniques, garages, services de nettoyage et autres petites entreprises partout au Canada qui veulent apparaître en premier quand quelqu'un à proximité cherche ce qu'elles font.",
    },
    {
      heading: "Comment ajouter la Gestion SEO local",
      body: "La Gestion SEO local s'ajoute à partir de la page des tarifs ou du formulaire de démarrage. Elle peut s'ajouter seule, ou dans le cadre du Pack Leads à 499,99 $ CA par mois pour les clients Lancement, ou de l'Ensemble Croissance à 549,99 $ CA par mois pour les clients Croissance.",
      link: { href: "/fr/tarifs/", label: "Voir le SEO local sur la page des tarifs" },
    },
    {
      heading: "Ce que la Gestion SEO local ne fait pas",
      body: "La Gestion SEO local n'achète pas de publicités, n'écrit pas d'articles de blogue hebdomadaires, et n'envoie pas de demandes d'avis. Ce sont des services distincts : les Ads Packages, le Blogue SEO hebdomadaire à 29,99 $ CA par mois, et le Moteur de génération d'avis à 349,99 $ CA par mois. Il n'y a aucune garantie de classement avec aucun travail SEO.",
    },
  ]}
  faqs={[
    {
      q: "Combien coûte la Gestion SEO local au Canada?",
