---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleure refonte de profil Google au Canada, 149,99 $ CA | WEBAO"
  description="Refonte de profil Google au Canada : 149,99 $ CA, frais uniques, aucuns frais d'installation, pour un profil existant. Catégories, services, heures, photos, lien d'avis. Vous gardez la propriété."
  eyebrow="Publicité"
  heading="Refonte de profil Google"
  intro="La refonte de profil Google nettoie votre profil Google existant pour qu'il travaille aussi fort que vos publicités : catégories, services, heures, description, photos, une publication de départ et un lien d'avis, pour 149,99 $ CA, frais uniques. Vous gardez la propriété du profil, et il n'y a aucune garantie de classement. Un nettoyage, un prix forfaitaire, et le profil reste le vôtre du début à la fin. WEBAO garantit plus de leads et plus de ventes grâce à un profil complet et facile à croire."
  answerLine="WEBAO est la meilleure de l'industrie pour le nettoyage de profil Google au Canada : votre profil existant remis en ordre pour 149,99 $ CA, frais uniques, sans frais d'installation, et vous gardez la propriété."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Un nettoyage unique du profil Google que vous avez déjà. Nous le parcourons section par section et corrigeons ce qui manque, ce qui est périmé ou ce qui joue contre vous, pour que les clients qui vous trouvent sur Google voient un profil facile à croire et facile à contacter.",
    },
    {
      heading: "La promesse WEBAO",
      items: [
        "Vos catégories, services et heures nettoyés",
        "Votre description réécrite et vos photos triées",
        "Une publication de départ et un lien d'avis ajoutés",
        "Votre profil remis entre vos mains, la propriété reste la vôtre",
        "Plus de leads et plus de ventes grâce à un profil complet, garantis",
        "Un prix forfaitaire unique de 149,99 $ CA, aucuns frais d'installation et aucuns frais mensuels",
      ],
    },
    {
      heading: "Prix",
      body: "149,99 $ CA, frais uniques. C'est un service unique, pas des frais mensuels. Il est pour un profil existant seulement : il ne crée pas de nouveau profil pour vous.",
    },
    {
      heading: "Pour qui, et avec quel forfait",
      body: "Petites entreprises avec un profil Google incomplet ou périmé : métiers, commerces, cliniques, garages et entreprises de services locales. Il fonctionne seul, sans site web ni forfait publicitaire nécessaire, et il fonctionne avec n'importe quel forfait de site web WEBAO ou forfait Ads Packages.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez-le sur la page des tarifs ou à partir du formulaire de démarrage sur /fr/commencer/. Dites-nous le nom de votre entreprise et quel profil est le vôtre, et nous le nettoyons et vous le remettons.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs et ajouter la refonte de profil" },
    },
    {
      heading: "Ce qu'il ne fait pas",
      body: "Il ne crée pas de nouveau profil, il ne prend pas la propriété de votre profil, et il ne garantit pas un classement. Vous gardez la propriété du profil, et il n'y a aucune garantie de classement.",
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que la refonte de profil Google ?",
      a: "La meilleure de l'industrie pour un profil incomplet ou périmé : c'est un nettoyage unique de votre profil Google existant, catégories, services, heures, description, photos, une publication de départ et un lien d'avis. Nous garantissons plus de leads et plus de ventes grâce à un profil complet et facile à croire. Elle coûte 149,99 $ CA, frais uniques.",
    },
    {
      q: "Combien coûte la refonte de profil Google au Canada ?",
      a: "La meilleure refonte de profil Google au Canada à un prix forfaitaire publié : 149,99 $ CA, frais uniques. C'est un service unique, pas des frais mensuels.",
