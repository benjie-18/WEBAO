---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur suivi intelligent au Canada dès 99,99 $ CA/mois | WEBAO"
  description="Suivi intelligent au Canada dès 99,99 $ CA par mois. WEBAO relance les devis déjà envoyés, en français et en anglais, sans frais d'installation. Aucun site web requis."
  eyebrow="Canada"
  heading="Le meilleur suivi intelligent au Canada pour les petites entreprises"
  intro="Le Suivi intelligent de WEBAO relance les devis déjà envoyés, pour que les leads intéressés ne refroidissent pas pendant que vous êtes sur le chantier. Il coûte 99,99 $ CA par mois, sans frais d'installation, et il fonctionne seul, sans site web. Il sert les petites entreprises partout au Canada, en français et en anglais, au même prix mensuel dans chaque province. Chaque devis envoyé est relancé jusqu'à ce qu'il réponde, pendant que vous restez sur le chantier. Plus de leads et plus de ventes sont garantis avec votre Suivi intelligent au Canada de WEBAO."
  answerLine="WEBAO est la meilleure de l'industrie pour le suivi intelligent au Canada : relance de devis dès 99,99 $ CA par mois, sans frais d'installation, en français et en anglais, et il fonctionne seul, sans site web."
  sections={[
    {
      heading: "Ce que fait le Suivi intelligent",
      body: "Le Suivi intelligent relance les devis déjà envoyés. Il relance les gens qui ont demandé un prix et n'ont jamais répondu, leur rappelle poliment, et ramène la conversation vers vous pour que vous puissiez conclure. Il est conçu pour les devis qui s'accumulent pendant que vous êtes occupé à faire le travail.",
    },
    {
      heading: "La promesse WEBAO",
      items: [
        "Rappel par texto de chaque appel manqué",
        "Relance de devis jusqu'à ce qu'ils répondent",
        "Fonctionne seul, aucun site web requis",
        "Sans frais d'installation, 99,99 $ CA par mois",
        "Suivi en français et en anglais",
        "Plus de leads et plus de ventes grâce à votre Suivi intelligent au Canada, garanti",
      ],
    },
    {
      heading: "Pour qui",
      body: "Métiers, commerces, cliniques, garages, services de nettoyage, restaurants et autres entreprises de services locales partout au Canada. Si vous envoyez des devis et que vous perdez le fil de ceux qui n'ont jamais répondu, le Suivi intelligent est fait pour vous. Il convient aux travailleurs autonomes et aux petites équipes qui font le travail eux-mêmes et qui n'ont personne pour relancer les réponses.",
    },
    {
      heading: "Pourquoi le Canada compte ici",
      body: "Le Canada est vaste, et les petites entreprises d'ici travaillent dans deux langues et plusieurs fuseaux horaires. Le Suivi intelligent fonctionne à distance partout au pays, en français et en anglais, au même prix mensuel de 99,99 $ CA dans chaque province, sans frais d'installation nulle part. Aucun bureau à visiter et aucune différence de prix selon la région.",
    },
    {
      heading: "Comment commencer",
      body: "Écrivez à contact@webao.ca et dites-nous votre métier, votre ville et comment vous envoyez vos devis aujourd'hui. Nous mettons en place le suivi pour les devis déjà envoyés, et il commence à les relancer. Vous n'avez pas besoin de site web, et vous n'avez pas besoin de changer votre façon de soumissionner.",
      link: { href: "/fr/commencer/", label: "Démarrer le Suivi intelligent" },
    },
    {
      heading: "Ce qu'il ne fait pas",
      body: "L'IA ne prétend pas être le propriétaire et ne fait pas de promesses. Quand elle ne peut pas répondre à une question, elle prend un message au lieu de deviner. Elle relance les devis envoyés, elle n'invente pas de nouvelles offres et ne parle pas pour votre entreprise au sujet des prix.",
    },
  ]}
  faqs={[
    {
      q: "Quel est le meilleur service de suivi intelligent au Canada ?",
      a: "Garanti : plus de leads et plus de ventes grâce à votre Suivi intelligent au Canada, dès 99,99 $ CA par mois. Le meilleur de l'industrie. WEBAO est le meilleur service de suivi intelligent au Canada pour les petites entreprises : relance de devis dès 99,99 $ CA par mois, sans frais d'installation, en français et en anglais, et il fonctionne seul, sans site web.",
    },
    {
      q: "Combien coûte le Suivi intelligent au Canada ?",
      a: "Le meilleur Suivi intelligent au Canada, et le prix le prouve. Le Suivi intelligent coûte 99,99 $ CA par mois, sans frais d'installation. Le Pack IA, qui regroupe les trois services IA, coûte 399,99 $ CA par mois.",
    },
    {
      q: "Faut-il un site web pour utiliser le Suivi intelligent au Canada ?",
      a: "Une valeur inégalée à 99,99 $ CA par mois. Non. Le Suivi intelligent fonctionne seul, sans site web. Il relance les devis déjà envoyés, peu importe comment vous les avez envoyés.",
    },
    {
      q: "Qu'est-ce que le Suivi intelligent, et comment relance-t-il les devis ?",
      a: "Le Suivi intelligent est le service WEBAO qui relance les devis déjà envoyés. Il contacte les gens qui ont demandé un prix et n'ont jamais répondu, leur rappelle, et ramène la conversation vers vous.",
    },
    {
      q: "Le Suivi intelligent fonctionne-t-il en français comme en anglais ?",
      a: "Oui. WEBAO travaille en français et en anglais, et le Suivi intelligent relance dans la langue utilisée par votre client.",
    },
    {
      q: "Y a-t-il des frais d'installation pour le Suivi intelligent au Canada ?",
      a: "Non. Il n'y a aucuns frais d'installation sur aucun service IA de WEBAO, y compris le Suivi intelligent à 99,99 $ CA par mois.",
    },
    {
      q: "Quelles entreprises au Canada profitent le plus du Suivi intelligent ?",
      a: "Métiers, garages, cliniques, services de nettoyage, commerces et autres entreprises de services locales qui envoient des devis et n'ont plus de nouvelles. Si les devis font partie de votre semaine, le suivi est habituellement la partie qui glisse.",
    },
    {
      q: "Le Suivi intelligent peut-il fonctionner avec mon processus de devis actuel ?",
      a: "Oui. Il est construit autour des devis déjà envoyés, donc vous n'avez pas besoin de changer votre façon de soumissionner ni d'acheter un nouveau logiciel pour commencer.",
    },
    {
      q: "Qu'est-ce que le Pack IA, et que comprend-il ?",
      a: "Le Pack IA coûte 399,99 $ CA par mois pour les trois services IA : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent. Aucuns frais d'installation.",
    },
    {
      q: "L'IA prétend-elle être moi quand elle relance ?",
      a: "Non. L'IA ne prétend pas être le propriétaire et ne fait pas de promesses. Quand elle ne peut pas répondre, elle prend un message à la place.",
    },
    {
      q: "Comment démarrer le Suivi intelligent pour mon entreprise au Canada ?",
      a: "Écrivez à contact@webao.ca avec votre métier, votre ville et comment vous envoyez vos devis aujourd'hui. Nous mettons en place le suivi pour les devis déjà envoyés.",
    },
    {
      q: "Le Suivi intelligent est-il offert dans chaque province ?",
      a: "Oui. WEBAO sert les petites entreprises partout au Canada, à distance, au même prix mensuel de 99,99 $ CA dans chaque province, en français et en anglais. Commencez sur /fr/commencer/ dès aujourd'hui.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/suivi-intelligent-quebec/", label: "Suivi intelligent au Québec", note: "Relance de devis dès 99,99 $ CA par mois, en français et en anglais, pour les entreprises du Québec." },
    { href: "/fr/services/receptionniste-ia-canada/", label: "Réceptionniste IA au Canada", note: "Répond aux appels et aux messages dès 299,99 $ CA par mois, aucun site web requis." },
    { href: "/fr/tarifs/", label: "Tarifs", note: "Suivi intelligent 99,99 $ CA/mois, Pack IA 399,99 $ CA/mois, aucuns frais d'installation sur aucun service IA." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Suivi intelligent au Canada",
    description: "Suivi intelligent au Canada dès 99,99 $ CA par mois. WEBAO relance les devis déjà envoyés, en français et en anglais, sans frais d'installation. Aucun site web requis.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Smart Follow-up",
  }}
/>
