  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Meilleure agence de sites web pour PME au Canada",
    description: "La meilleure agence de sites web pour PME au Canada : des sites sur mesure pour les métiers, les commerces, les cliniques et les garages dès 89,99 $ CA/mois. Aucuns frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Web design",
  }}
/>

