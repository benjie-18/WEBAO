---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleure agence de sites web pour PME au Canada | WEBAO"
  description="La meilleure agence de sites web pour PME au Canada : des sites sur mesure pour les métiers, les commerces, les cliniques et les garages dès 89,99 $ CA/mois. Aucuns frais d'installation."
  eyebrow="Canada"
  heading="La meilleure agence de sites web pour PME au Canada"
