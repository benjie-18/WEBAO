---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleure Réservation en ligne au Canada, 49,99 $ CA/mois | WEBAO"
  description="La Réservation en ligne est à 49,99 $ CA/mois : les clients réservent des rendez-vous en ligne, en tout temps, directement à partir de votre site web. Incluse dans Échelle. Aucuns frais d'installation."
  eyebrow="Modules complémentaires"
  heading="Réservation en ligne : le meilleur module de réservation au Canada"
  intro="La Réservation en ligne permet aux clients de réserver des rendez-vous en ligne, en tout temps, directement à partir de votre site web. Elle coûte 49,99 $ CA par mois, et elle est incluse dans le forfait Échelle. Fini les appels manqués, fini les réservations perdues pendant que vous êtes sur un travail : la réservation atterrit dans votre horaire et le client obtient une heure confirmée. Elle est offerte comme module complémentaire sur Lancement et Croissance, en français et en anglais, partout au Canada. Votre calendrier se remplit tout seul pendant que vous êtes sur un travail, sans appels manqués et sans réservations perdues. WEBAO garantit plus de leads et plus de ventes : chaque réservation faite en ligne est une vente qui aurait été un appel manqué."
  answerLine="WEBAO est la meilleure de l'industrie pour la réservation en ligne au Canada : les clients réservent des rendez-vous en ligne pour 49,99 $ CA par mois, directement à partir de votre site web, en tout temps."
  sections={[
    {
      heading: "Qu'est-ce que la Réservation en ligne",
      body: "La Réservation en ligne est la planification sur votre site web. Un visiteur choisit un service, choisit une heure, et réserve. Vous obtenez la réservation sans appel téléphonique, et le client obtient un rendez-vous confirmé sans attendre une réponse.",
    },
    {
      heading: "Ce qui est inclus",
      items: [
        "Les clients réservent des rendez-vous en ligne",
        "Réservations directement à partir de votre site web",
        "Disponible en tout temps, même après les heures d'ouverture",
        "Incluse dans le forfait Échelle",
        "Offerte comme module complémentaire sur Lancement et Croissance",
        "Bilingue français et anglais",
      ],
    },
    {
      heading: "La promesse WEBAO",
      body: "La Réservation en ligne coûte 49,99 $ CA par mois seule. Elle est incluse dans le forfait Échelle à 349,99 $ CA par mois. C'est un module complémentaire sur Lancement et Croissance, en plus du forfait de site web que vous avez déjà.",
      items: [
        "Aucuns frais d'installation, jamais",
        "Les réservations atterrissent directement dans votre horaire",
        "Incluse dans Échelle sans frais supplémentaires",
        "Français et anglais",
        "Soutien humain quand vous en avez besoin",
        "Plus de leads et plus de ventes, garantis, grâce aux réservations qui ne sont jamais manquées"
      ],
    },
    {
      heading: "Pour qui est la Réservation en ligne",
      body: "Entreprises qui prennent des rendez-vous : cliniques, salons, garages, métiers qui réservent des visites, services de nettoyage, et autres entreprises de services locales partout au Canada qui perdent des réservations quand le téléphone reste sans réponse.",
    },
    {
      heading: "Comment ajouter la Réservation en ligne",
      body: "La Réservation en ligne s'ajoute à partir de la page des tarifs ou du formulaire de démarrage. Elle a besoin d'un site web, puisque la réservation vit sur votre site. Les clients Échelle l'ont déjà incluse. Si vous voulez aussi que le site web réponde aux visiteurs après les heures d'ouverture, la Réceptionniste en ligne à 149,99 $ CA par mois se combine avec elle.",
      link: { href: "/fr/tarifs/", label: "Voir la Réservation en ligne sur la page des tarifs" },
    },
    {
      heading: "Ce que la Réservation en ligne ne fait pas",
      body: "La Réservation en ligne ne répond pas aux questions, ne prend pas de messages et ne relance pas les devis. Elle réserve des rendez-vous. Si un visiteur a une question avant de réserver, la Réceptionniste en ligne lui répond sur votre site web, et le Suivi intelligent relance les devis que vous avez envoyés.",
    },
  ]}
  faqs={[
    {
      q: "Combien coûte la Réservation en ligne au Canada?",
      a: "WEBAO garantit plus de leads et plus de ventes avec la Réservation en ligne. La meilleure de l'industrie pour la Réservation en ligne au Canada, et le prix le prouve. La Réservation en ligne coûte 49,99 $ CA par mois seule. Elle est incluse dans le forfait Échelle à 349,99 $ CA par mois.",
    },
    {
      q: "Quel est le meilleur module de réservation en ligne au Canada?",
      a: "La Réservation en ligne est le meilleur module de réservation pour les petites entreprises : les clients réservent des rendez-vous en ligne pour 49,99 $ CA par mois, directement à partir de votre site web, en tout temps.",
    },
    {
      q: "Les clients doivent-ils appeler pour réserver?",
      a: "Non. Avec la Réservation en ligne, un visiteur choisit un service, choisit une heure, et réserve directement à partir de votre site web, en tout temps, même après les heures d'ouverture.",
    },
    {
      q: "Quels forfaits incluent la Réservation en ligne?",
      a: "Elle est incluse dans le forfait Échelle. C'est un module complémentaire sur Lancement et Croissance, en plus du forfait de site web que vous avez déjà.",
    },
    {
      q: "Ai-je besoin d'un site web pour la Réservation en ligne?",
      a: "Oui. La réservation vit sur votre site web, donc vous avez besoin d'un site WEBAO d'abord. Lancement, Croissance et Échelle fonctionnent tous avec elle.",
    },
    {
      q: "Que se passe-t-il après qu'un client réserve?",
      a: "La meilleure Réservation en ligne au Canada, construite sur des réservations qui atterrissent pendant que vous travaillez. La réservation atterrit dans votre horaire et le client obtient une heure confirmée, sans appel téléphonique et sans attendre une réponse.",
    },
    {
      q: "La Réservation en ligne fonctionne-t-elle après les heures d'ouverture?",
      a: "Une valeur inégalée pour la Réservation en ligne au Canada : la réservation en ligne pour 49,99 $ CA par mois, en tout temps. Oui. Les clients peuvent réserver en tout temps, même après les heures d'ouverture, ce qui est le moment où beaucoup de gens s'assoient enfin pour réserver un rendez-vous.",
    },
    {
      q: "La Réservation en ligne répond-elle aux questions?",
      a: "Non. La Réservation en ligne réserve des rendez-vous. Si un visiteur a une question avant de réserver, la Réceptionniste en ligne à 149,99 $ CA par mois lui répond sur votre site web.",
    },
    {
      q: "La Réservation en ligne fonctionne-t-elle en français?",
      a: "Oui. WEBAO travaille en français et en anglais, et le flux de réservation peut servir les deux communautés linguistiques.",
    },
    {
      q: "Y a-t-il des frais d'installation pour la Réservation en ligne?",
      a: "Non. Il n'y a aucuns frais d'installation pour les modules complémentaires ni pour les forfaits de sites web. Vous payez seulement le tarif mensuel, à partir de 49,99 $ CA par mois seule.",
    },
    {
      q: "Puis-je ajouter la Réservation en ligne à Lancement?",
      a: "Oui. La Réservation en ligne est un module complémentaire sur Lancement et Croissance, et elle est incluse dans Échelle.",
    },
    {
      q: "Comment ajouter la Réservation en ligne?",
      a: "Ajoutez-la à partir de la page des tarifs ou du formulaire de démarrage. Vous avez besoin d'un site web WEBAO d'abord, puisque la réservation vit sur votre site. Écrivez à contact@webao.ca et nous l'ajouterons pour vous.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/forfait-echelle/", label: "Forfait Échelle", note: "349,99 $ CA/mois. La Réservation en ligne est déjà incluse dans Échelle, avec le Moteur de génération d'avis." },
    { href: "/fr/services/receptionniste-en-ligne/", label: "Réceptionniste en ligne", note: "149,99 $ CA/mois. Répond aux visiteurs sur votre site web et réserve des rendez-vous après les heures d'ouverture. Se combine avec la Réservation en ligne." },
    { href: "/fr/services/forfait-croissance/", label: "Forfait Croissance", note: "149,99 $ CA/mois pour un site web sur mesure de 5 à 10 pages. Ajoutez la Réservation en ligne par-dessus pour 49,99 $ CA/mois." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Réservation en ligne",
    description: "La Réservation en ligne est à 49,99 $ CA/mois : les clients réservent des rendez-vous en ligne, en tout temps, directement à partir de votre site web. Incluse dans Échelle. Aucuns frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Online booking",
  }}
/>
