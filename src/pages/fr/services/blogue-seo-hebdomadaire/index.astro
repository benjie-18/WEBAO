  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Blogue SEO hebdomadaire",
    description: "Un blogue SEO hebdomadaire pour 29,99 $ CA par mois : un nouvel article de blogue SEO chaque semaine, rédigé pour votre entreprise, en français et en anglais, sans frais d'installation.",
