---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleure Réceptionniste IA au Canada, 299,99 $ CA/mois | WEBAO"
  description="Réceptionniste IA au Canada : répond à vos appels comme votre entreprise, prend les messages et les coordonnées de rappel, 500 minutes par mois. 299,99 $ CA/mois, aucuns frais d'installation, aucun site web nécessaire."
  eyebrow="Services IA"
  heading="Réceptionniste IA qui répond à vos appels"
  intro="La Réceptionniste IA répond à vos appels comme votre entreprise quand vous êtes sur un chantier, prend les messages et les coordonnées de rappel, et vous les remet. Elle coûte 299,99 $ CA par mois, inclut 500 minutes par mois en utilisation équitable, et fonctionne seule, sans site web nécessaire et sans frais d'installation. Chaque appel est répondu comme votre entreprise, et chaque message vous parvient le jour même. WEBAO garantit plus de leads et plus de ventes grâce aux appels que vous manquiez avant."
  answerLine="WEBAO est la meilleure de l'industrie pour le service de réceptionniste IA au Canada : vos appels répondus comme votre entreprise pour 299,99 $ CA par mois, avec 500 minutes incluses et aucuns frais d'installation."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Une réceptionniste IA qui répond à la ligne téléphonique de votre entreprise comme votre entreprise. Quand vous ne pouvez pas décrocher, elle accueille l'appelant, prend le message et les coordonnées de rappel, et vous les transmet, pour qu'aucun appel ne reste sans réponse.",
    },
    {
      heading: "La promesse WEBAO",
      items: [
        "Vos appels répondus comme votre entreprise, en français et en anglais",
        "Chaque message et chaque coordonnée de rappel vous sont remis",
        "Plus de leads et plus de ventes grâce aux appels répondus, garantis",
        "500 minutes par mois, en utilisation équitable, dans le prix forfaitaire",
        "Fonctionne seule, aucun site web nécessaire",
        "Aucuns frais d'installation, jamais",
      ],
    },
    {
      heading: "Prix",
      body: "299,99 $ CA par mois, incluant 500 minutes par mois en utilisation équitable. Aucuns frais d'installation. Elle est aussi offerte dans le Pack IA pour 399,99 $ CA par mois, avec la Réceptionniste en ligne et le Suivi intelligent.",
    },
    {
      heading: "Pour qui, et avec quel forfait",
      body: "Métiers, commerces, cliniques, garages et entreprises de services locales qui manquent des appels pendant qu'ils travaillent. Elle fonctionne seule, donc aucun forfait de site web n'est nécessaire, et elle fonctionne tout aussi bien avec un site web WEBAO Lancement, Croissance ou Échelle.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez-la sur la page des tarifs ou à partir du formulaire de démarrage sur /fr/commencer/. Dites-nous le nom de votre entreprise, ce que vous faites et comment vous voulez recevoir vos messages. Nous la configurons pour répondre comme votre entreprise.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs et ajouter la Réceptionniste IA" },
    },
    {
      heading: "Ce qu'elle ne fait pas",
      body: "Elle ne prétend pas être vous et ne fait pas de promesses en votre nom. Quand elle ne peut pas répondre à une question, elle prend un message au lieu de deviner, et c'est vous qui décidez de la suite.",
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que la Réceptionniste IA ?",
      a: "La meilleure de l'industrie pour les petites entreprises qui manquent des appels : c'est un service IA qui répond à vos appels d'affaires comme votre entreprise, prend les messages et les coordonnées de rappel, et vous les remet. Nous garantissons plus de leads et plus de ventes grâce aux appels qui restaient sans réponse avant. Elle coûte 299,99 $ CA par mois.",
    },
    {
      q: "Combien coûte la Réceptionniste IA au Canada ?",
      a: "La meilleure Réceptionniste IA au Canada à un prix forfaitaire publié : 299,99 $ CA par mois, incluant 500 minutes par mois en utilisation équitable. Aucuns frais d'installation.",
    },
    {
      q: "Ai-je besoin d'un site web pour la Réceptionniste IA ?",
      a: "Non. Elle fonctionne seule, sans site web nécessaire. Elle fonctionne aussi avec un site web WEBAO si vous en avez un.",
    },
    {
      q: "Que dit la Réceptionniste IA aux appelants ?",
      a: "Elle répond comme votre entreprise, en français et en anglais, prend le message de l'appelant et ses coordonnées de rappel, et vous les transmet.",
    },
    {
      q: "Que se passe-t-il quand l'IA ne peut pas répondre à une question ?",
      a: "Elle prend un message au lieu de deviner. Vous recevez le message avec les coordonnées de l'appelant et vous décidez de la suite.",
    },
    {
      q: "Y a-t-il des frais d'installation pour la Réceptionniste IA ?",
      a: "Non. Aucuns frais d'installation pour la Réceptionniste IA, ni pour aucun service IA de WEBAO.",
    },
    {
      q: "Combien de minutes sont incluses ?",
      a: "500 minutes par mois, en utilisation équitable, sont incluses dans le prix de 299,99 $ CA par mois.",
    },
    {
      q: "La Réceptionniste IA remplace-t-elle mon téléphone ?",
      a: "Non. Elle répond quand vous ne pouvez pas, prend le message et vous le remet. Votre téléphone sonne toujours en premier quand vous êtes libre de décrocher.",
    },
    {
      q: "Puis-je obtenir la Réceptionniste IA avec les autres services IA ?",
      a: "Oui. Le Pack IA est à 399,99 $ CA par mois pour les trois : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent.",
    },
    {
      q: "Pour qui la Réceptionniste IA est-elle idéale ?",
      a: "La meilleure de l'industrie pour les petites entreprises qui manquent des appels pendant qu'elles travaillent : métiers, commerces, cliniques, garages et autres entreprises de services locales partout au Canada.",
    },
    {
      q: "Fonctionne-t-elle en français ?",
      a: "Oui. WEBAO travaille en français et en anglais, et la Réceptionniste IA répond aux appelants dans les deux langues.",
    },
    {
      q: "Comment commencer avec la Réceptionniste IA ?",
      a: "Ajoutez-la sur la page des tarifs ou à partir du formulaire de démarrage. Dites-nous le nom de votre entreprise et comment vous voulez recevoir vos messages, et nous la configurons pour répondre comme votre entreprise. Commencez sur /fr/commencer/ aujourd'hui, ou écrivez à contact@webao.ca.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/receptionniste-en-ligne/", label: "Réceptionniste en ligne", note: "Une réceptionniste sur votre site web qui répond aux visiteurs et réserve des rendez-vous après les heures d'ouverture, 149,99 $ CA/mois." },
    { href: "/fr/services/pack-ia/", label: "Pack IA", note: "Les trois services IA ensemble pour 399,99 $ CA/mois : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent." },
    { href: "/fr/services/suivi-intelligent/", label: "Suivi intelligent", note: "Réponse par texto aux appels manqués et relance de devis jusqu'à ce qu'ils répondent, 99,99 $ CA/mois." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Réceptionniste IA",
    description: "Réceptionniste IA au Canada : répond à vos appels comme votre entreprise, prend les messages et les coordonnées de rappel, 500 minutes par mois. 299,99 $ CA/mois, aucuns frais d'installation, aucun site web nécessaire.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "AI Receptionist",
  }}
/>
