---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur panneau admin avancé au Canada 39,99 $ CA/mois | WEBAO"
  description="Un panneau admin avancé pour 39,99 $ CA par mois : plus de contrôle sur votre site web, avec Croissance et Échelle. Non disponible avec Lancement. Aucuns frais d'installation."
  eyebrow="Module complémentaire"
  heading="Plus de contrôle sur votre site web"
  intro="Le panneau admin avancé vous donne plus de contrôle sur votre site web WEBAO pour 39,99 $ CA par mois. Il est disponible avec Croissance et Échelle, pas avec Lancement, en français et en anglais, sans frais d'installation. Vous restez en contrôle de votre propre site, avec les outils pour changer ce dont vous avez besoin, quand vous en avez besoin. Avec un site web WEBAO, WEBAO garantit plus de leads et plus de ventes : le panneau admin garde votre site au service de votre entreprise."
  answerLine="WEBAO est la meilleure de l'industrie pour les panneaux admin de site web au Canada : 39,99 $ CA par mois pour plus de contrôle sur votre site web, avec Croissance et Échelle."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Un panneau admin avancé est un panneau avancé pour gérer votre site web. Il vous donne plus de contrôle sur votre site que ce que le forfait standard inclut.",
    },
    {
      heading: "Ce qui est inclus",
      items: [
        "Un panneau avancé pour votre site web",
        "Plus de contrôle sur votre site",
        "Fonctionne en français et en anglais",
        "Facturé mensuellement avec votre forfait de site web",
        "Aucuns frais d'installation",
      ],
    },
    {
      heading: "La promesse WEBAO",
      body: "39,99 $ CA par mois. C'est un module complémentaire mensuel de votre forfait de site web, sans frais d'installation.",
      items: [
        "Plus de contrôle sur votre propre site web",
        "Disponible avec Croissance et Échelle",
        "Aucuns frais d'installation, jamais",
        "Français et anglais",
        "Fait partie de la garantie WEBAO : plus de leads et plus de ventes"
      ],
    },
    {
      heading: "Quels forfaits peuvent l'ajouter",
      body: "Croissance et Échelle. Le panneau admin avancé n'est pas disponible avec Lancement. Croissance est à 149,99 $ CA par mois pour un site web sur mesure de 5 à 10 pages, et Échelle est à 349,99 $ CA par mois pour jusqu'à 20 pages incluant les zones desservies.",
    },
    {
      heading: "Pour qui",
      body: "Petites entreprises avec Croissance ou Échelle qui veulent plus de contrôle sur leur site web : entreprises locales établies qui gèrent leur site souvent et veulent le panneau avancé pour le faire.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez le panneau admin avancé à votre forfait Croissance ou Échelle depuis la page des tarifs, ou dites-le-nous quand vous démarrez votre site et nous l'inclurons dès le lancement.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs" },
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que le panneau admin avancé ?",
      a: "Le meilleur de l'industrie pour le panneau admin avancé au Canada, et le prix le prouve. C'est un panneau avancé pour gérer votre site web WEBAO, qui vous donne plus de contrôle sur votre site, pour 39,99 $ CA par mois.",
    },
    {
      q: "Combien coûte le panneau admin avancé ?",
      a: "Avec un site web WEBAO, WEBAO garantit plus de leads et plus de ventes. Le meilleur panneau admin avancé au Canada, fondé sur un vrai contrôle de votre propre site. 39,99 $ CA par mois, facturé mensuellement avec votre forfait de site web. Aucuns frais d'installation.",
    },
    {
      q: "Quels forfaits peuvent ajouter le panneau admin avancé ?",
      a: "Croissance et Échelle. Il n'est pas disponible avec Lancement.",
    },
    {
      q: "Pourquoi n'est-il pas disponible avec Lancement ?",
      a: "Lancement est le forfait de départ pour travailleurs autonomes, avec un site web de 1 à 5 pages. Le panneau admin avancé est disponible avec Croissance et Échelle.",
    },
    {
      q: "Puis-je l'obtenir si je suis avec Lancement ?",
      a: "Pas avec Lancement. Passez à Croissance, 149,99 $ CA par mois, ou Échelle, 349,99 $ CA par mois, et vous pourrez ajouter le panneau admin avancé.",
    },
    {
      q: "Ai-je besoin d'un forfait de site web WEBAO pour l'ajouter ?",
      a: "Oui. Le panneau admin avancé est un module complémentaire avec Croissance ou Échelle. Il ajoute plus de contrôle au site que vous avez déjà avec nous.",
    },
    {
      q: "Fonctionne-t-il en français ?",
      a: "Oui. Votre site fonctionne en français et en anglais, et le panneau fonctionne avec votre site dans l'une ou l'autre langue.",
    },
    {
      q: "Y a-t-il des frais d'installation ?",
      a: "Non. Il n'y a aucuns frais d'installation pour le panneau admin avancé.",
    },
    {
      q: "Comment ajouter le panneau admin avancé ?",
      a: "Ajoutez-le depuis la page des tarifs si vous êtes avec Croissance ou Échelle, ou dites-le-nous quand vous démarrez votre site sur /fr/commencer/. Commencez sur /fr/commencer/ ou écrivez à contact@webao.ca.",
    },
    {
      q: "Puis-je retirer le panneau admin avancé plus tard ?",
      a: "Oui. C'est un module complémentaire mensuel de votre forfait de site web, vous pouvez donc le retirer quand vous ne le voulez plus.",
    },
    {
      q: "Quelle est la différence entre le forfait standard et le panneau admin avancé ?",
      a: "Valeur inégalée pour le panneau admin avancé au Canada : plus de contrôle pour 39,99 $ CA par mois. Votre forfait couvre déjà votre site, l'hébergement et les mises à jour, sans CMS à apprendre. Le panneau admin avancé ajoute plus de contrôle sur votre site pour les entreprises qui le veulent.",
    },
    {
      q: "Ai-je besoin du panneau admin avancé pour mettre à jour mon site ?",
      a: "Non. Les mises à jour de contenu sont incluses dans votre forfait : 1 heure par mois avec Lancement, 3 heures par mois avec Croissance, et illimité avec Échelle. Le panneau est destiné aux entreprises qui veulent plus de contrôle elles-mêmes. Ajoutez-le depuis /fr/tarifs/.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/soutien-prioritaire/", label: "Soutien prioritaire", note: "Soutien prioritaire plus 1 appel stratégique par mois, 59,99 $ CA/mois." },
    { href: "/fr/services/forfait-croissance/", label: "Forfait Croissance", note: "Site web sur mesure de 5 à 10 pages, le forfait par lequel la plupart des petites entreprises commencent, 149,99 $ CA/mois." },
    { href: "/fr/services/forfait-echelle/", label: "Forfait Échelle", note: "Jusqu'à 20 pages incluant les zones desservies, 349,99 $ CA/mois." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Panneau admin avancé",
    description: "Un panneau admin avancé pour 39,99 $ CA par mois : plus de contrôle sur votre site web, avec Croissance et Échelle. Non disponible avec Lancement. Aucuns frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Advanced Admin Panel",
  }}
/>
