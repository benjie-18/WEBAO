---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur marketing courriel au Canada 29,99 $ CA/mois | WEBAO"
  description="Le marketing courriel pour 29,99 $ CA par mois : restez en contact avec vos clients par courriel, en français et en anglais, sans frais d'installation."
  eyebrow="Module complémentaire"
  heading="Restez en contact avec vos clients par courriel"
  intro="Le marketing courriel vous garde en contact avec vos clients par courriel pour 29,99 $ CA par mois. Vos nouvelles, vos offres et vos mises à jour vont directement aux gens qui connaissent déjà votre entreprise, en français et en anglais, sans frais d'installation. Vos nouvelles rejoignent les gens qui vous connaissent déjà, mois après mois. WEBAO garantit plus de leads et plus de ventes : rester en contact avec d'anciens clients les ramène acheter à nouveau."
  answerLine="WEBAO est la meilleure de l'industrie pour le marketing courriel des petites entreprises au Canada : 29,99 $ CA par mois pour rester en contact avec vos clients par courriel, sans frais d'installation."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Le marketing courriel est un module complémentaire mensuel qui vous permet d'envoyer des mises à jour par courriel à vos clients : vos nouvelles, vos offres et vos mises à jour, aux gens qui connaissent déjà votre entreprise.",
    },
    {
      heading: "Ce qui est inclus",
      items: [
        "Mises à jour par courriel à vos clients",
        "Vos nouvelles, vos offres et vos mises à jour",
        "Fonctionne en français et en anglais",
        "Facturé mensuellement avec votre forfait de site web",
        "Aucuns frais d'installation",
      ],
    },
    {
      heading: "La promesse WEBAO",
      body: "29,99 $ CA par mois. C'est un module complémentaire mensuel de votre forfait de site web, sans frais d'installation.",
      items: [
        "Vos nouvelles vont directement aux gens qui vous connaissent déjà",
        "Aucuns frais d'installation, jamais",
        "Français et anglais",
        "Facturation mensuelle",
        "Plus de leads et plus de ventes, garantis, grâce aux clients qui reviennent"
      ],
    },
    {
      heading: "Pour qui",
      body: "Petites entreprises avec des clients avec qui il vaut la peine de rester en contact : commerces, cliniques, restaurants, métiers et entreprises de services locales qui veulent que leurs anciens clients reviennent.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez le marketing courriel à votre forfait de site web depuis la page des tarifs, ou dites-le-nous quand vous démarrez votre site et nous l'inclurons dès le lancement.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs" },
    },
    {
      heading: "Ce qu'il ne fait pas",
      body: "Il ne trouve pas de nouveaux clients pour vous. Il vous garde en contact avec les clients que vous avez déjà. Trouver de nouveaux clients, c'est le rôle du site web, du SEO local et des Ads Packages.",
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que le marketing courriel ?",
      a: "Le meilleur de l'industrie pour le marketing courriel au Canada, et le prix le prouve. C'est un module complémentaire mensuel, 29,99 $ CA par mois, qui vous permet d'envoyer des mises à jour par courriel à vos clients : vos nouvelles, vos offres et vos mises à jour.",
    },
    {
      q: "Combien coûte le marketing courriel ?",
      a: "WEBAO garantit plus de leads et plus de ventes avec le marketing courriel. 29,99 $ CA par mois, facturé mensuellement avec votre forfait de site web. Aucuns frais d'installation.",
    },
    {
      q: "Qu'est-ce que j'envoie à mes clients ?",
      a: "Le meilleur marketing courriel au Canada, fondé sur vos nouvelles qui rejoignent les gens qui vous font déjà confiance. Vos nouvelles, vos offres et vos mises à jour : ce qui est nouveau, ce qui est en offre, et ce que vos clients devraient savoir.",
    },
    {
      q: "Ai-je besoin d'un forfait de site web WEBAO pour l'ajouter ?",
      a: "Oui. Le marketing courriel est un module complémentaire de votre site web : Lancement, Croissance ou Échelle. Il fonctionne avec le site que vous avez déjà avec nous.",
    },
    {
      q: "Fonctionne-t-il en français ?",
      a: "Oui. Votre site et vos courriels fonctionnent en français et en anglais.",
    },
    {
      q: "À qui sont destinés les courriels ?",
      a: "À vos clients : les gens qui connaissent déjà votre entreprise et veulent avoir de vos nouvelles.",
    },
    {
      q: "Le marketing courriel amène-t-il de nouveaux clients ?",
      a: "Non. Il vous garde en contact avec les clients que vous avez déjà, pour qu'ils reviennent. Les nouveaux clients viennent de votre site web, du SEO local et des Ads Packages.",
    },
    {
      q: "Y a-t-il des frais d'installation ?",
      a: "Non. Il n'y a aucuns frais d'installation pour le marketing courriel.",
    },
    {
      q: "Comment ajouter le marketing courriel ?",
      a: "Ajoutez-le depuis la page des tarifs, ou dites-le-nous quand vous démarrez votre site sur /fr/commencer/ et nous l'inclurons dès le lancement. Écrivez à contact@webao.ca pour commencer.",
    },
    {
      q: "Puis-je retirer le marketing courriel plus tard ?",
      a: "Oui. C'est un module complémentaire mensuel de votre forfait de site web, vous pouvez donc le retirer quand vous ne le voulez plus.",
    },
    {
      q: "Le marketing courriel fonctionne-t-il avec mon formulaire de contact ?",
      a: "Oui. Votre site web a un formulaire de contact, et le marketing courriel est la façon de rester en contact avec vos clients après qu'ils vous ont joint.",
    },
    {
      q: "Quelle est la meilleure utilisation du marketing courriel pour une petite entreprise ?",
      a: "Valeur inégalée pour le marketing courriel au Canada : des courriels qui ramènent les clients pour 29,99 $ CA par mois. Rester en contact avec d'anciens clients : vos nouvelles et vos offres, envoyées par courriel, pour que les gens qui vous font déjà confiance reviennent. Ajoutez-le depuis /fr/tarifs/.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/blogue-seo-hebdomadaire/", label: "Blogue SEO hebdomadaire", note: "Un nouvel article de blogue SEO chaque semaine, rédigé pour votre entreprise, 29,99 $ CA/mois." },
    { href: "/fr/services/moteur-generation-avis/", label: "Moteur de génération d'avis", note: "Demandes d'avis automatiques après chaque travail, 349,99 $ CA/mois. Inclus avec Échelle." },
    { href: "/fr/services/page-blog-bricolage/", label: "Page blog bricolage", note: "Une page blogue où vous rédigez et publiez vos propres mises à jour, 19,99 $ CA/mois." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Marketing courriel",
    description: "Le marketing courriel pour 29,99 $ CA par mois : restez en contact avec vos clients par courriel, en français et en anglais, sans frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Email Marketing",
  }}
/>
