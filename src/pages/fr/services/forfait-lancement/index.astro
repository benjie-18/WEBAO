---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur forfait Lancement au Canada, 89,99 $ CA/mois | WEBAO"
  description="Lancement est le forfait de site web de départ au meilleur rapport qualité-prix au Canada : un site web sur mesure de 1 à 5 pages à partir de 89,99 $ CA par mois, avec domaine, hébergement, SSL, SEO fondamental et mises à jour. Aucuns frais d'installation."
