    name: "Meilleure agence de publicité au Québec",
    description: "La meilleure agence de publicité au Québec pour les petites entreprises : Ads Packages Meta et Google dès 399,99 $ CA/mois, dépenses sur votre propre carte. Aucuns frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "State", name: "Quebec" },
    serviceType: "Advertising",
  }}
/>

