  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/suivi-intelligent-montreal/", label: "Suivi intelligent à Montréal", note: "Relance de devis dès 99,99 $ CA par mois, en français et en anglais, à partir d'une base à Montréal." },
    { href: "/fr/services/suivi-intelligent-canada/", label: "Suivi intelligent au Canada", note: "Relance de devis dès 99,99 $ CA par mois, partout au Canada, aucun site web requis." },
    { href: "/fr/tarifs/", label: "Tarifs", note: "Suivi intelligent 99,99 $ CA/mois, Pack IA 399,99 $ CA/mois, aucuns frais d'installation sur aucun service IA." },
  ]}
