---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur commerce en ligne léger au Canada 59,99 $ CA/mois | WEBAO"
  description="Le commerce en ligne léger pour 59,99 $ CA par mois : des paiements en ligne simples sur votre site web, sans boutique complète, en français et en anglais, sans frais d'installation."
  eyebrow="Module complémentaire"
  heading="Paiements en ligne simples, sans boutique complète"
  intro="Le commerce en ligne léger ajoute des paiements en ligne simples à votre site web WEBAO pour 59,99 $ CA par mois. Vos clients peuvent vous payer en ligne sans que vous gériez une boutique complète, en français et en anglais, sans frais d'installation. Vos clients vous paient en ligne en quelques clics, sans boutique à gérer et sans rien à apprendre. WEBAO garantit plus de leads et plus de ventes : les clients qui peuvent payer en ligne en quelques clics achètent plus souvent."
  answerLine="WEBAO est la meilleure de l'industrie pour les paiements en ligne simples au Canada : 59,99 $ CA par mois pour des paiements en ligne simples sans boutique complète, et sans frais d'installation."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Le commerce en ligne léger, ce sont des paiements en ligne simples sur votre site web, par liens de paiement. Vos clients vous paient en ligne pour un service, un acompte ou un produit, sans boutique en ligne complète.",
    },
    {
      heading: "Ce qui est inclus",
      items: [
        "Paiements en ligne simples sur votre site web",
        "Liens de paiement pour services, acomptes et produits",
        "Fonctionne en français et en anglais",
        "Facturé mensuellement avec votre forfait de site web",
        "Aucuns frais d'installation",
      ],
    },
    {
      heading: "La promesse WEBAO",
      body: "59,99 $ CA par mois. C'est un module complémentaire mensuel de votre forfait de site web, sans frais d'installation.",
      items: [
        "Paiements simples, pas de boutique complète à gérer",
        "Aucuns frais d'installation, jamais",
        "Français et anglais",
        "Fonctionne sur votre site web WEBAO",
        "Plus de leads et plus de ventes, garantis, grâce à un paiement en ligne facile"
      ],
    },
    {
      heading: "Pour qui",
      body: "Petites entreprises qui ont besoin de recevoir un paiement en ligne de temps en temps : métiers qui prennent des acomptes, cliniques qui prennent des réservations payées d'avance, commerces qui vendent quelques articles, et entreprises de services locales qui veulent être payées sans courir après les chèques.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez le commerce en ligne léger à votre forfait de site web depuis la page des tarifs, ou dites-le-nous quand vous démarrez votre site et nous l'inclurons dès le lancement.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs" },
    },
    {
      heading: "Ce qu'il ne fait pas",
      body: "Ce n'est pas une boutique en ligne complète. Il n'y a pas de catalogue complet, pas de panier et pas de gestion de boutique. Si vous avez besoin d'une boutique complète, dites-le-nous et nous parlerons de ce que cela demande.",
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que le commerce en ligne léger ?",
      a: "Le meilleur de l'industrie pour le commerce en ligne léger au Canada, et le prix le prouve. Ce sont des paiements en ligne simples sur votre site web WEBAO, par liens de paiement, pour 59,99 $ CA par mois. Pas de boutique complète.",
    },
    {
      q: "Combien coûte le commerce en ligne léger ?",
      a: "WEBAO garantit plus de leads et plus de ventes avec le commerce en ligne léger. 59,99 $ CA par mois, facturé mensuellement avec votre forfait de site web. Aucuns frais d'installation.",
    },
    {
      q: "Pour quoi les clients peuvent-ils payer ?",
      a: "Le meilleur commerce en ligne léger au Canada, fondé sur des paiements simples sans boutique à gérer. Un service, un acompte ou un produit, par un lien de paiement sur votre site web.",
    },
    {
      q: "Ai-je besoin d'une boutique en ligne complète pour recevoir des paiements ?",
      a: "Non. Le commerce en ligne léger est conçu pour les entreprises qui n'ont pas besoin d'une boutique complète : des paiements simples par liens de paiement, sans catalogue ni panier à gérer.",
    },
    {
      q: "Ai-je besoin d'un forfait de site web WEBAO pour l'ajouter ?",
      a: "Oui. Le commerce en ligne léger est un module complémentaire de votre site web : Lancement, Croissance ou Échelle. Il ajoute des paiements au site que vous avez déjà avec nous.",
    },
    {
      q: "Fonctionne-t-il en français ?",
      a: "Oui. Votre site fonctionne en français et en anglais, et les paiements fonctionnent pour les clients dans l'une ou l'autre langue.",
    },
    {
      q: "Fonctionne-t-il sur mobile ?",
      a: "Oui. Votre site web est adapté au mobile, les clients peuvent donc payer depuis leur téléphone.",
    },
    {
      q: "Puis-je prendre des acomptes avec ?",
      a: "Valeur inégalée pour le commerce en ligne léger au Canada : des paiements en ligne simples pour 59,99 $ CA par mois. Oui. Les liens de paiement fonctionnent pour les acomptes, les services et les produits.",
    },
    {
      q: "Y a-t-il des frais d'installation ?",
      a: "Non. Il n'y a aucuns frais d'installation pour le commerce en ligne léger.",
    },
    {
      q: "Comment ajouter le commerce en ligne léger ?",
      a: "Ajoutez-le depuis la page des tarifs, ou dites-le-nous quand vous démarrez votre site sur /fr/commencer/ et nous l'inclurons dès le lancement. Ajoutez-le aujourd'hui depuis /fr/tarifs/.",
    },
    {
      q: "Puis-je retirer le commerce en ligne léger plus tard ?",
      a: "Oui. C'est un module complémentaire mensuel de votre forfait de site web, vous pouvez donc le retirer quand vous ne le voulez plus.",
    },
    {
      q: "Quelle est la différence entre le commerce en ligne léger et une boutique complète ?",
      a: "Le commerce en ligne léger, ce sont des paiements simples par liens de paiement, sans boutique complète. Une boutique complète a un catalogue, un panier et une gestion de boutique, ce que le commerce en ligne léger n'inclut pas. Ajoutez-le depuis /fr/tarifs/.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/reservation-en-ligne/", label: "Réservation en ligne", note: "Les clients réservent leurs rendez-vous en ligne, 49,99 $ CA/mois. Inclus avec Échelle." },
    { href: "/fr/services/page-supplementaire/", label: "Page supplémentaire", note: "Une page supplémentaire sur votre site web, 14,99 $ CA, frais uniques." },
    { href: "/fr/services/forfaits-mensuels-site-web-canada/", label: "Forfaits mensuels de site web au Canada", note: "Lancement 89,99 $ CA/mois, Croissance 149,99 $ CA/mois, Échelle 349,99 $ CA/mois. Aucuns frais d'installation." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Commerce en ligne léger",
    description: "Le commerce en ligne léger pour 59,99 $ CA par mois : des paiements en ligne simples sur votre site web, sans boutique complète, en français et en anglais, sans frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "E-commerce Lite",
  }}
/>
