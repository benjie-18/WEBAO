---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleure Réceptionniste en ligne au Canada, 149,99 $ CA/mois | WEBAO"
  description="Réceptionniste en ligne au Canada : une réceptionniste sur votre site web qui répond aux visiteurs et réserve des rendez-vous après les heures d'ouverture. 149,99 $ CA/mois, aucuns frais d'installation, site web nécessaire."
  eyebrow="Services IA"
  heading="Réceptionniste en ligne pour votre site web"
  intro="La Réceptionniste en ligne est une réceptionniste sur votre site web qui répond aux visiteurs pendant que vous travaillez et réserve des rendez-vous après les heures d'ouverture. Elle coûte 149,99 $ CA par mois, répond aux questions propres à votre entreprise, qualifie les leads et recueille leurs coordonnées. Elle a besoin d'un site web, et il n'y a aucuns frais d'installation. Votre site web ne dort jamais, et vos visiteurs obtiennent toujours une réponse. WEBAO garantit plus de leads et plus de ventes grâce aux visiteurs qui arrivent après les heures d'ouverture."
  answerLine="WEBAO est la meilleure de l'industrie pour le service de réceptionniste en ligne au Canada : vos visiteurs de site web répondus et réservés après les heures d'ouverture pour 149,99 $ CA par mois, sans frais d'installation."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Une réceptionniste qui vit sur votre site web. Elle répond aux visiteurs en français et en anglais, couvre vos services et les renseignements de base de votre entreprise, et réserve des rendez-vous après les heures d'ouverture, pour qu'un visiteur qui arrive pendant que vous travaillez obtienne quand même une réponse.",
    },
    {
      heading: "La promesse WEBAO",
      items: [
        "Vos visiteurs répondus en français et en anglais, jour et nuit",
        "Rendez-vous réservés après les heures d'ouverture, avec intégration de réservation lorsque c'est pris en charge",
        "Vos questions fréquentes propres à votre entreprise répondues, plus de 25 questions courantes couvertes",
        "Chaque lead qualifié et recueilli, coordonnées remises à vous",
        "Plus de leads et plus de ventes grâce aux visiteurs après les heures d'ouverture, garantis",
        "Aucuns frais d'installation, jamais",
      ],
    },
    {
      heading: "Prix",
      body: "149,99 $ CA par mois. Aucuns frais d'installation. Elle est aussi offerte dans le Pack IA pour 399,99 $ CA par mois, avec la Réceptionniste IA et le Suivi intelligent.",
    },
    {
      heading: "Pour qui, et avec quel forfait",
      body: "Petites entreprises avec un site web qui reçoivent des visiteurs après les heures d'ouverture : métiers, commerces, cliniques et entreprises de services locales. Elle a besoin d'un site web, donc elle fonctionne avec un site web WEBAO Lancement, Croissance ou Échelle, ou avec un site que vous avez déjà.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez-la sur la page des tarifs ou à partir du formulaire de démarrage sur /fr/commencer/. Dites-nous vos services, vos heures et vos questions les plus fréquentes, et nous la configurons avec les réponses propres à votre entreprise.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs et ajouter la Réceptionniste en ligne" },
    },
    {
      heading: "Ce qu'elle ne fait pas",
      body: "Elle ne prétend pas être vous et ne fait pas de promesses en votre nom. Quand elle ne peut pas répondre, elle prend les coordonnées du visiteur et vous les remet, et c'est vous qui décidez de la suite.",
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que la Réceptionniste en ligne ?",
      a: "La meilleure de l'industrie pour les sites web qui reçoivent des visiteurs après les heures d'ouverture : c'est une réceptionniste sur votre site web qui répond aux visiteurs, couvre vos questions propres à votre entreprise et réserve des rendez-vous après les heures d'ouverture. Nous garantissons plus de leads et plus de ventes grâce aux visiteurs qui arrivent pendant que vous travaillez. Elle coûte 149,99 $ CA par mois.",
    },
    {
      q: "Combien coûte la Réceptionniste en ligne au Canada ?",
      a: "La meilleure Réceptionniste en ligne au Canada à un prix forfaitaire publié : 149,99 $ CA par mois. Aucuns frais d'installation.",
    },
    {
      q: "Ai-je besoin d'un site web pour la Réceptionniste en ligne ?",
      a: "Oui. Elle vit sur votre site web, donc elle en a besoin. Elle fonctionne avec un site web WEBAO Lancement, Croissance ou Échelle, ou avec un site que vous avez déjà.",
    },
    {
      q: "À quelles questions la Réceptionniste en ligne répond-elle ?",
      a: "Vos questions fréquentes propres à votre entreprise, plus de 25 questions et réponses courantes, ainsi que vos services et les renseignements de base de votre entreprise, en français et en anglais.",
    },
    {
      q: "Réserve-t-elle des rendez-vous ?",
      a: "Oui. Elle réserve des rendez-vous après les heures d'ouverture, avec intégration de réservation lorsque c'est pris en charge, et recueille les coordonnées du visiteur pour vous.",
    },
    {
      q: "Qualifie-t-elle les leads ?",
      a: "Oui. Elle qualifie les leads et recueille leurs coordonnées, pour que vous obteniez les visiteurs prêts à réserver ou à demander un devis.",
    },
    {
      q: "Y a-t-il des frais d'installation pour la Réceptionniste en ligne ?",
      a: "Non. Aucuns frais d'installation pour la Réceptionniste en ligne, ni pour aucun service IA de WEBAO.",
    },
    {
      q: "Que se passe-t-il quand elle ne peut pas répondre à un visiteur ?",
      a: "Elle prend les coordonnées du visiteur au lieu de deviner, et vous les remet pour que vous puissiez faire le suivi vous-même.",
    },
    {
      q: "Puis-je obtenir la Réceptionniste en ligne avec les autres services IA ?",
      a: "Oui. Le Pack IA est à 399,99 $ CA par mois pour les trois : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent.",
    },
    {
      q: "Pour qui la Réceptionniste en ligne est-elle idéale ?",
      a: "La meilleure de l'industrie pour les petites entreprises avec un site web qui reçoivent des visiteurs après les heures d'ouverture : métiers, commerces, cliniques et entreprises de services locales partout au Canada.",
    },
    {
      q: "Fonctionne-t-elle en français ?",
      a: "Oui. WEBAO travaille en français et en anglais, et la Réceptionniste en ligne répond aux visiteurs dans les deux langues.",
    },
    {
      q: "Comment commencer avec la Réceptionniste en ligne ?",
      a: "Ajoutez-la sur la page des tarifs ou à partir du formulaire de démarrage. Dites-nous vos services, vos heures et vos questions les plus fréquentes, et nous la configurons avec les réponses propres à votre entreprise. Commencez sur /fr/commencer/ aujourd'hui, ou écrivez à contact@webao.ca.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/receptionniste-ia/", label: "Réceptionniste IA", note: "Répond à vos appels comme votre entreprise et prend les messages, 299,99 $ CA/mois, aucun site web nécessaire." },
    { href: "/fr/services/pack-ia/", label: "Pack IA", note: "Les trois services IA ensemble pour 399,99 $ CA/mois : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent." },
    { href: "/fr/services/suivi-intelligent/", label: "Suivi intelligent", note: "Réponse par texto aux appels manqués et relance de devis jusqu'à ce qu'ils répondent, 99,99 $ CA/mois." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Réceptionniste en ligne",
    description: "Réceptionniste en ligne au Canada : une réceptionniste sur votre site web qui répond aux visiteurs et réserve des rendez-vous après les heures d'ouverture. 149,99 $ CA/mois, aucuns frais d'installation, site web nécessaire.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "Online Receptionist",
  }}
/>
