---
import ServicePage from "../../../../components/pages/ServicePage.astro";

const locale = "fr" as const;
---

<ServicePage
  locale={locale}
  pageKey="services"
  title="Meilleur Pack IA au Canada, 399,99 $ CA/mois | WEBAO"
  description="Pack IA au Canada : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent ensemble pour 399,99 $ CA/mois. Appels répondus, visiteurs réservés, devis relancés, aucuns frais d'installation."
  eyebrow="Services IA"
  heading="Pack IA : les trois services IA ensemble"
  intro="Le Pack IA regroupe les trois services IA de WEBAO pour 399,99 $ CA par mois : la Réceptionniste IA, la Réceptionniste en ligne et le Suivi intelligent. Vos appels sont répondus, vos visiteurs de site web obtiennent une réponse et une réservation, et vos devis sont relancés, même pendant que vous travaillez. Aucuns frais d'installation. Un pack, une facture, et trois services qui travaillent pour vous pendant que vous travaillez. WEBAO garantit plus de leads et plus de ventes grâce aux appels, aux visiteurs et aux devis que le pack intercepte pour vous."
  answerLine="WEBAO est la meilleure de l'industrie pour les packs IA au Canada : les trois services IA, appels répondus, visiteurs réservés et devis relancés, pour 399,99 $ CA par mois, sans frais d'installation."
  sections={[
    {
      heading: "Ce que c'est",
      body: "Un pack avec les trois services IA, sur une seule facture mensuelle. La Réceptionniste IA répond à vos appels, la Réceptionniste en ligne répond aux visiteurs de votre site web, et le Suivi intelligent répond par texto aux appels manqués et relance vos devis.",
    },
    {
      heading: "La promesse WEBAO",
      items: [
        "Vos appels répondus comme votre entreprise, 500 minutes par mois incluses",
        "Vos visiteurs de site web répondus et réservés après les heures d'ouverture",
        "Vos devis relancés jusqu'à ce qu'ils répondent",
        "Plus de leads et plus de ventes grâce aux trois services ensemble, garantis",
        "Une seule facture mensuelle, en français et en anglais",
        "Aucuns frais d'installation, jamais",
      ],
    },
    {
      heading: "Prix",
      body: "Le Pack IA est à 399,99 $ CA par mois. Les trois services seuls sont la Réceptionniste IA à 299,99 $ CA par mois, la Réceptionniste en ligne à 149,99 $ CA par mois, et le Suivi intelligent à 99,99 $ CA par mois. Aucuns frais d'installation sur le pack ni sur aucun des trois services.",
    },
    {
      heading: "Pour qui, et avec quel forfait",
      body: "Petites entreprises qui manquent des appels, des visiteurs et des devis pendant qu'elles travaillent : métiers, commerces, cliniques, garages et entreprises de services locales. La Réceptionniste IA et le Suivi intelligent fonctionnent seuls, sans site web nécessaire. La Réceptionniste en ligne a besoin d'un site web, donc elle fonctionne avec un site web WEBAO Lancement, Croissance ou Échelle, ou avec un site que vous avez déjà.",
    },
    {
      heading: "Comment l'ajouter",
      body: "Ajoutez le Pack IA sur la page des tarifs ou à partir du formulaire de démarrage sur /fr/commencer/. Dites-nous le nom de votre entreprise, vos services et comment vous voulez recevoir vos messages, et nous configurons les trois services pour vous.",
      link: { href: "/fr/tarifs/", label: "Voir les tarifs et ajouter le Pack IA" },
    },
    {
      heading: "Ce qu'il ne fait pas",
      body: "L'IA ne prétend pas être vous et ne fait pas de promesses en votre nom. Quand elle ne peut pas répondre, elle prend un message ou les coordonnées du visiteur au lieu de deviner, et c'est vous qui décidez de la suite.",
    },
  ]}
  faqs={[
    {
      q: "Qu'est-ce que le Pack IA ?",
      a: "Le meilleur de l'industrie pour les petites entreprises qui manquent des appels, des visiteurs et des devis : ce sont les trois services IA de WEBAO ensemble pour 399,99 $ CA par mois : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent. Nous garantissons plus de leads et plus de ventes grâce aux appels, aux visiteurs et aux devis qui se perdaient avant.",
    },
    {
      q: "Combien coûte le Pack IA au Canada ?",
      a: "Le meilleur Pack IA au Canada à un prix forfaitaire publié : 399,99 $ CA par mois. Aucuns frais d'installation.",
    },
    {
      q: "Que comprend le Pack IA ?",
      a: "La Réceptionniste IA, la Réceptionniste en ligne et le Suivi intelligent, sur une seule facture mensuelle, en français et en anglais.",
    },
    {
      q: "Combien coûte la Réceptionniste IA seule ?",
      a: "299,99 $ CA par mois, incluant 500 minutes par mois en utilisation équitable. Aucuns frais d'installation.",
    },
    {
      q: "Combien coûte la Réceptionniste en ligne seule ?",
      a: "149,99 $ CA par mois. Aucuns frais d'installation. Elle a besoin d'un site web.",
    },
    {
      q: "Combien coûte le Suivi intelligent seul ?",
      a: "99,99 $ CA par mois, incluant la réponse par texto aux appels manqués et la relance de devis. Aucuns frais d'installation.",
    },
    {
      q: "Ai-je besoin d'un site web pour le Pack IA ?",
      a: "Seulement pour la Réceptionniste en ligne, qui vit sur votre site web. La Réceptionniste IA et le Suivi intelligent fonctionnent seuls, sans site web nécessaire.",
    },
    {
      q: "Y a-t-il des frais d'installation pour le Pack IA ?",
      a: "Non. Aucuns frais d'installation sur le Pack IA, ni sur aucun service IA de WEBAO.",
    },
    {
      q: "Que se passe-t-il quand l'IA ne peut pas répondre ?",
      a: "Elle prend un message ou les coordonnées du visiteur au lieu de deviner, et vous les remet pour que vous puissiez faire le suivi vous-même.",
    },
    {
      q: "Pour qui le Pack IA est-il idéal ?",
      a: "Le meilleur de l'industrie pour les petites entreprises qui manquent des appels, des visiteurs et des devis pendant qu'elles travaillent : métiers, commerces, cliniques, garages et entreprises de services locales partout au Canada.",
    },
    {
      q: "Le Pack IA fonctionne-t-il en français ?",
      a: "Oui. WEBAO travaille en français et en anglais, et les trois services IA répondent dans les deux langues.",
    },
    {
      q: "Comment commencer avec le Pack IA ?",
      a: "Ajoutez-le sur la page des tarifs ou à partir du formulaire de démarrage. Dites-nous le nom de votre entreprise, vos services et comment vous voulez recevoir vos messages, et nous configurons les trois services. Commencez sur /fr/commencer/ aujourd'hui, ou écrivez à contact@webao.ca.",
    },
  ]}
  faqHeading="Questions"
  siblingsHeading="Autres services"
  siblings={[
    { href: "/fr/services/receptionniste-ia/", label: "Réceptionniste IA", note: "Répond à vos appels comme votre entreprise et prend les messages, 299,99 $ CA/mois, aucun site web nécessaire." },
    { href: "/fr/services/receptionniste-en-ligne/", label: "Réceptionniste en ligne", note: "Une réceptionniste sur votre site web qui répond aux visiteurs et réserve après les heures d'ouverture, 149,99 $ CA/mois." },
    { href: "/fr/services/suivi-intelligent/", label: "Suivi intelligent", note: "Réponse par texto aux appels manqués et relance de devis jusqu'à ce qu'ils répondent, 99,99 $ CA/mois." },
  ]}
  startLabel="Démarrer votre site"
  emailLabel="Courriel contact@webao.ca"
  serviceSchema={{
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Pack IA",
    description: "Pack IA au Canada : Réceptionniste IA, Réceptionniste en ligne et Suivi intelligent ensemble pour 399,99 $ CA/mois. Appels répondus, visiteurs réservés, devis relancés. Aucuns frais d'installation.",
    provider: { "@type": "Organization", name: "WEBAO", url: "https://webao.ca" },
    areaServed: { "@type": "Country", name: "Canada" },
    serviceType: "AI Pack",
  }}
/>
