---
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = "fr" as const;
const title = "Paiement · WEBAO";
const description = "Finalisez votre abonnement WEBAO : 149 $ CAD/mois, sans frais d'installation, annulez en tout temps.";

// TODO: Remplacez par votre URL de lien de paiement Stripe (créez dans Tableau de bord Stripe > Liens de paiement)
// Pour l'abonnement récurrent de 149 $ CAD/mois
const STRIPE_PAYMENT_URL = "https://buy.stripe.com/YOUR_PAYMENT_LINK_HERE";
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="section">
    <div class="shell" style="max-width: 920px;">
      <div class="eyebrow">Paiement</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.2rem); line-height:.92; margin-top:12px;">Plus qu'une étape</h1>
      <p class="prose" style="margin-top:12px; max-width: 52ch;">
        Vérifiez vos informations ci-dessous, puis finalisez le paiement en
        toute sécurité avec Stripe. La création de votre site commence dès
        la confirmation du paiement.
      </p>

      <div class="checkout-grid" style="margin-top: 32px;">
        <!-- Résumé de commande -->
        <div class="checkout-card">
          <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5;">RÉSUMÉ</div>
          <div style="margin-top:16px; display:flex; align-items:baseline; gap:8px;">
            <span class="display" style="font-size: 2.6rem; line-height:.9;">149 $</span>
            <span class="mono" style="font-size:11px; opacity:.6;">CAD/mois</span>
          </div>
          <ul style="margin:18px 0 0; padding:0; list-style:none; display:grid; gap:10px; font-size:13.5px;">
            <li>✓ Site web sur mesure de 3–5 pages</li>
            <li>✓ Domaine, hébergement et SSL</li>
            <li>✓ Bases SEO et analytique</li>
            <li>✓ Mises à jour et soutien inclus</li>
          </ul>
          <div class="mono" style="margin-top:18px; padding-top:14px; border-top:1px solid var(--line); font-size:11px; color: var(--muted);">
            Sans frais d'installation · Annulez en tout temps<br/>
            <a href="/fr/refunds" style="color: var(--accent-text);">Politique de remboursement</a>
          </div>
        </div>

        <!-- Client + paiement -->
        <div class="checkout-card checkout-card--pay">
          <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5;">VOS INFORMATIONS</div>
          <div id="checkout-customer" class="mono" style="margin-top:12px; font-size:12.5px; line-height:1.7; color: var(--muted);">
            <!-- Rempli par JS depuis sessionStorage -->
          </div>

          <div style="margin-top:24px; padding-top:20px; border-top:1px solid var(--line);">
            <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5;">PAIEMENT</div>
            <p class="prose" style="font-size:13px; margin-top:10px; color: var(--muted);">
              Paiement sécurisé propulsé par Stripe. Vous serez redirigé pour
              finaliser votre abonnement de 149 $/mois.
            </p>
            <a
              href={STRIPE_PAYMENT_URL}
              class="btn btn--primary"
              style="width:100%; justify-content:center; margin-top:14px; font-size:15px; padding:14px 20px;"
              data-stripe-link
            >
              Payer 149 $/mois →
            </a>
            <div class="mono" style="margin-top:10px; font-size:10.5px; text-align:center; color: var(--muted);">
              🔒 Chiffré et sécurisé · Propulsé par Stripe
            </div>
          </div>
        </div>
      </div>

      <p class="mono" style="margin-top:24px; font-size:11px; color: var(--muted); text-align:center;">
        Des questions? <a href="/fr/contact" style="color: var(--ink);">Contactez-nous</a> avant de payer.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Remplit les infos client depuis le formulaire de contact (sessionStorage)
  try {
    const raw = sessionStorage.getItem('webao-checkout');
    const el = document.getElementById('checkout-customer');
    if (raw && el) {
      const d = JSON.parse(raw);
      const lines = [];
      if (d.business) lines.push(`<strong style="color:var(--ink)">${d.business}</strong>`);
      if (d.name) lines.push(d.name);
      if (d.email) lines.push(d.email);
      if (d.city || d.trade) lines.push([d.trade, d.city].filter(Boolean).join(' · '));
      el.innerHTML = lines.length ? lines.join('<br/>') : 'Informations non fournies.';
    } else if (el) {
      el.innerHTML = 'Aucune info — <a href="/fr/contact" style="color:var(--accent-text)">remplissez le formulaire</a> d\'abord.';
    }
  } catch (e) { /* noop */ }

  // Avertit si le lien Stripe est encore un placeholder
  document.querySelectorAll('[data-stripe-link]').forEach((a) => {
    const href = a.getAttribute('href') || '';
    if (href.includes('YOUR_PAYMENT_LINK_HERE')) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        alert('Lien de paiement Stripe non configuré. Contactez-nous à hello@webao.ca pour finaliser votre abonnement.');
      });
    }
  });
</script>

<style>
  .checkout-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .checkout-grid { grid-template-columns: 1fr 1.2fr; }
  }
  .checkout-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--card-bg);
  }
  .checkout-card--pay {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  .checkout-card ul li {
    color: var(--ink);
  }
</style>
