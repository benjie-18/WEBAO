---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { STRIPE_PUBLISHABLE_KEY } from "../../lib/config";
import { useTranslations } from "../../lib/i18n";

const locale = "fr" as const;
const t = useTranslations(locale);
const title = "Paiement · WEBAO";
const description = "Finalisez votre abonnement WEBAO : 149 $ CAD/mois, sans frais d'installation, annulez en tout temps.";

// Clé publique Stripe; sûre à intégrer dans le code frontend.
---

<BaseLayout title={title} description={description} locale={locale} noIndex={true}>
  <Fragment slot="head">
    <!-- Stripe.js + the embedded-checkout iframe: preconnect so the payment
         UI mounts sooner (the checkout page is the conversion step). -->
    <link rel="preconnect" href="https://js.stripe.com" />
    <link rel="preconnect" href="https://api.stripe.com" />
    <link rel="preconnect" href="https://checkout.stripe.com" />
  </Fragment>

  <section class="section">
    <div class="shell" style="max-width: 920px;">
      <div class="eyebrow">Paiement</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.2rem); line-height:.92; margin-top:12px;">Plus qu'une étape</h1>
      <p class="prose" style="margin-top:12px; max-width: 52ch;">
        Finalisez votre commande ci-dessous.
      </p>

      <div style="margin-top: 32px; max-width: 640px;">
        <div class="checkout-card checkout-card--pay">
          <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5; margin-bottom:12px;">PAIEMENT SÉCURISÉ</div>
          <div id="checkout-customer" class="mono" style="margin-bottom:16px; font-size:12px; line-height:1.7; color: var(--muted);"></div>
          <div id="checkout-items" style="margin-bottom:24px;">
            <!-- Cart items injected by JS -->
          </div>
          <div id="stripe-checkout">
            <div class="mono" style="padding:40px 20px; text-align:center; color: var(--muted); font-size:12.5px;" id="checkout-loading">
              Chargement du formulaire de paiement…
            </div>
          </div>
          <div class="mono" style="margin-top:12px; font-size:10.5px; text-align:center; color: var(--muted);">
            🔒 Chiffré et sécurisé · Propulsé par Stripe · <a href="/fr/remboursements" style="color: var(--accent-text);">Politique de remboursement</a>
          </div>
        </div>
      </div>

      <p class="mono" style="margin-top:24px; font-size:11px; color: var(--muted); text-align:center;">
        Des questions? <a href="/fr/contact" style="color: var(--ink);">Contactez-nous</a> avant de payer.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="https://js.stripe.com/v3/"></script>
<script define:vars={{ pk: STRIPE_PUBLISHABLE_KEY, labels: t.cart }}>
  (function() {
    const loadingEl = document.getElementById('checkout-loading');
    const itemsEl = document.getElementById('checkout-items');

    // ── Panier ─────────────────────────────────────────────────────────────
    // Le panier est écrit par src/lib/cart-ui.ts (clé « webao_cart_v1 »).
    let cartItems = [];
    try {
      const raw = localStorage.getItem('webao_cart_v1');
      const parsed = raw ? JSON.parse(raw) : [];
      cartItems = Array.isArray(parsed) ? parsed : [];
    } catch (e) { cartItems = []; }

    const money = (cents) => {
      const [whole, frac] = (cents / 100).toFixed(2).split('.');
      const grouped = whole.replace(/\B(?=(\d{3})+(?!\d))/g, labels.moneyDecimal === ',' ? '\u00a0' : ',');
      return labels.moneyPrefix + grouped + labels.moneyDecimal + frac + labels.moneySuffix;
    };
    const suffix = (interval) =>
      interval === 'year' ? labels.suffixYear
      : interval === 'month' ? labels.suffixMonth
      : labels.suffixOneTime;
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function renderItems(rows, note) {
      if (!itemsEl) return;
      if (!rows.length) {
        itemsEl.innerHTML =
          '<p class="mono" style="color:var(--muted); text-align:center; padding:20px;">' +
          esc(labels.checkoutEmpty) +
          ' <a href="/fr/tarifs" style="color:var(--accent-text);">' +
          esc(labels.checkoutEmptyCta) +
          '</a></p>';
        return;
      }
      const total = rows.reduce((sum, i) => sum + i.priceCents, 0);
      itemsEl.innerHTML =
        '<div style="border:1px solid var(--line); border-radius:12px; padding:16px; background:var(--card-bg);">' +
        '<p class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5; margin-bottom:12px;">' +
        esc(labels.checkoutTitle) +
        '</p>' +
        rows
          .map(
            (i) =>
              '<div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px; padding:8px 0; border-bottom:1px solid var(--line);">' +
              '<span style="font-weight:600;">' + esc(i.name) + '</span>' +
              '<span class="mono" style="white-space:nowrap;">' + esc(money(i.priceCents) + suffix(i.interval)) + '</span>' +
              '</div>',
          )
          .join('') +
        '<div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px; padding-top:12px; font-size:1.1rem;">' +
        '<strong>' + esc(labels.total) + '</strong>' +
        '<strong class="mono">' + esc(money(total)) + '</strong>' +
        '</div>' +
        (note
          ? '<p class="mono" style="margin:10px 0 0; font-size:11px; color:var(--muted);">' + esc(note) + '</p>'
          : '') +
        '</div>';
    }

    renderItems(cartItems);

    try {
      const raw = sessionStorage.getItem('webao-checkout');
      const custEl = document.getElementById('checkout-customer');
      if (raw && custEl) {
        const d = JSON.parse(raw);
        const lines = [];
        if (d.business) lines.push('<strong style="color:var(--ink)">' + esc(d.business) + '</strong>');
        if (d.name) lines.push(esc(d.name));
        if (d.email) lines.push(esc(d.email));
        if (custEl && lines.length) custEl.innerHTML = lines.join('<br/>');
      }
    } catch (e) {}

    function fail(msg) {
      if (loadingEl) loadingEl.textContent = msg || 'Paiement indisponible. Contactez-nous à contact@webao.ca.';
    }

    // Rien à payer : ne jamais ouvrir une session Stripe vide.
    if (cartItems.length === 0) {
      if (loadingEl) {
        loadingEl.innerHTML =
          esc(labels.checkoutEmpty) +
          ' <a href="/fr/tarifs" style="color:var(--accent-text);">' + esc(labels.checkoutEmptyCta) + '</a>';
      }
      return;
    }

    if (!window.Stripe) { fail('Stripe n\'a pas pu être chargé. Vérifiez votre connexion et actualisez.'); return; }
    if (!pk || pk.includes('YOUR_PUBLISHABLE_KEY_HERE')) {
      fail('Paiement non configuré. Contactez-nous à contact@webao.ca pour finaliser votre abonnement.');
      return;
    }

    let customer = {};
    try {
      const raw = sessionStorage.getItem('webao-checkout');
      if (raw) customer = JSON.parse(raw);
    } catch (e) {}

    fetch('/api/checkout/session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: customer.email || '',
        name: customer.name || '',
        business: customer.business || '',
        locale: 'fr',
        items: cartItems.map(i => ({ key: i.key }))
      }),
    })
      .then((r) => r.json())
      .then(async (data) => {
        if (!data.ok || !data.clientSecret) {
          fail(data.error || 'Paiement indisponible. Réessayez ou contactez-nous.');
          return;
        }
        // Stripe est la source de vérité des montants facturés.
        if (Array.isArray(data.lineItems) && data.lineItems.length > 0) {
          renderItems(
            data.lineItems.map((li) => ({
              name: li.description || li.key || '',
              priceCents: typeof li.amount === 'number' ? li.amount : 0,
              interval: li.interval || 'one-time',
            })),
          );
        }
        const stripe = window.Stripe(pk);
        const checkout = await stripe.initEmbeddedCheckout({ clientSecret: data.clientSecret });
        const el = document.getElementById('stripe-checkout');
        if (el) el.innerHTML = '';
        checkout.mount(el || '#stripe-checkout');
      })
      .catch(() => fail());

    const payCard = document.querySelector('.checkout-card--pay');
    if (payCard) {
      payCard.addEventListener('mouseenter', () => {
        document.documentElement.classList.add('cc-hidden-pay');
      });
      payCard.addEventListener('mouseleave', () => {
        document.documentElement.classList.remove('cc-hidden-pay');
      });
    }
  })();
</script>

<style>
  .checkout-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--card-bg);
  }
  .checkout-card--pay {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  #stripe-checkout {
    min-height: 320px;
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    min-width: 0;
  }
  #stripe-checkout iframe {
    width: 100% !important;
    min-width: 0 !important;
  }
  html.cc-hidden-pay .cc { display: none !important; }
  html.cc-hidden-pay .checkout-card--pay,
  html.cc-hidden-pay .checkout-card--pay * { cursor: auto !important; }
  @media (max-width: 560px) {
    .checkout-card { padding: 16px; }
    #stripe-checkout { border-radius: 8px; }
  }
</style>
