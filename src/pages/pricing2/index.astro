---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PricingPage from "../../components/pages/PricingPage.astro";

const locale = "en" as const;

// The previous /pricing page, now at /pricing2 after the swap.
// Temporary test page only. Not linked from navigation, not in the
// sitemap, and noindex so it cannot compete with /pricing in search.
// No Product schema here: that lives on /pricing now.
---

<BaseLayout
  title="Pricing (previous version) · WEBAO"
  description="Previous version of the WEBAO pricing page, kept as a test page."
  locale={locale}
  pageKey="pricing"
  noIndex={true}
>
  <PricingPage locale={locale} />
</BaseLayout>
