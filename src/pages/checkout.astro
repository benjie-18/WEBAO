---
import BaseLayout from "../layouts/BaseLayout.astro";
import CheckoutPage from "../components/pages/CheckoutPage.astro";
import { useTranslations } from "../lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);
---

<BaseLayout title={t.checkout.metaTitle} description={t.checkout.metaDescription} locale={locale} noIndex={true} stickyCta={false}>
  <Fragment slot="head">
    <!-- Stripe.js + the embedded-checkout iframe: preconnect so the payment
         UI mounts sooner (the checkout page is the conversion step). -->
    <link rel="preconnect" href="https://js.stripe.com" />
    <link rel="preconnect" href="https://api.stripe.com" />
    <link rel="preconnect" href="https://checkout.stripe.com" />
  </Fragment>
  <CheckoutPage locale={locale} />
</BaseLayout>
