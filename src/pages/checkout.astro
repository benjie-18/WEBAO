---
import BaseLayout from "../layouts/BaseLayout.astro";
import { STRIPE_PUBLISHABLE_KEY } from "../lib/config";

const locale = "en" as const;
const title = "Checkout · WEBAO";
const description = "Complete your WEBAO subscription: $149 CAD/month, no setup fee, cancel anytime.";

// Publishable key is public; safe to embed in frontend code.
---

<BaseLayout title={title} description={description} locale={locale} noIndex={true}>
  <section class="section">
    <div class="shell" style="max-width: 920px;">
      <div class="eyebrow">Checkout</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.2rem); line-height:.92; margin-top:12px;">Almost there</h1>
      <p class="prose" style="margin-top:12px; max-width: 52ch;">
        Complete your order below.
      </p>

      <div style="margin-top: 32px; max-width: 640px;">
        <div class="checkout-card checkout-card--pay">
          <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5; margin-bottom:12px;">SECURE PAYMENT · $149 CAD/MONTH</div>
          <div id="checkout-customer" class="mono" style="margin-bottom:16px; font-size:12px; line-height:1.7; color: var(--muted);"></div>
          <div id="stripe-checkout">
            <div class="mono" style="padding:40px 20px; text-align:center; color: var(--muted); font-size:12.5px;" id="checkout-loading">
              Loading secure payment form…
            </div>
          </div>
          <div class="mono" style="margin-top:12px; font-size:10.5px; text-align:center; color: var(--muted);">
            🔒 Encrypted & secure · Powered by Stripe · <a href="/refunds" style="color: var(--accent-text);">Refund policy</a>
          </div>
        </div>
      </div>

      <p class="mono" style="margin-top:24px; font-size:11px; color: var(--muted); text-align:center;">
        Questions? <a href="/contact" style="color: var(--ink);">Contact us</a> before paying.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="https://js.stripe.com/v3/"></script>
<script define:vars={{ pk: STRIPE_PUBLISHABLE_KEY }}>
  (function() {
    const mountEl = document.getElementById('stripe-checkout');
    const loadingEl = document.getElementById('checkout-loading');

    // Show customer details from the contact form
    try {
      const raw = sessionStorage.getItem('webao-checkout');
      const custEl = document.getElementById('checkout-customer');
      if (raw && custEl) {
        const d = JSON.parse(raw);
        const lines = [];
        if (d.business) lines.push('<strong style="color:var(--ink)">' + d.business + '</strong>');
        if (d.name) lines.push(d.name);
        if (d.email) lines.push(d.email);
        if (custEl && lines.length) custEl.innerHTML = lines.join('<br/>');
      }
    } catch (e) {}

    function fail(msg) {
      if (loadingEl) loadingEl.textContent = msg || 'Payment could not be loaded. Please contact us at contact@webao.ca.';
    }

    if (!window.Stripe) { fail('Stripe could not be loaded. Check your connection and refresh.'); return; }
    if (!pk || pk.includes('YOUR_PUBLISHABLE_KEY_HERE')) {
      fail('Payment is not configured yet. Please contact us at contact@webao.ca to complete your subscription.');
      return;
    }

    let customer = {};
    try {
      const raw = sessionStorage.getItem('webao-checkout');
      if (raw) customer = JSON.parse(raw);
    } catch (e) {}

    fetch('/api/checkout/session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: customer.email || '', name: customer.name || '', business: customer.business || '' }),
    })
      .then((r) => r.json())
      .then(async (data) => {
        if (!data.ok || !data.clientSecret) {
          fail(data.error || 'Could not start checkout. Please try again or contact us.');
          return;
        }
        const stripe = window.Stripe(pk);
        const checkout = await stripe.initEmbeddedCheckout({ clientSecret: data.clientSecret });
        const mountEl = document.getElementById('stripe-checkout');
        if (mountEl) mountEl.innerHTML = '';
        checkout.mount(mountEl || '#stripe-checkout');
      })
      .catch(() => fail());

    // Hide custom cursor over Stripe iframe
    const payCard = document.querySelector('.checkout-card--pay');
    if (payCard) {
      payCard.addEventListener('mouseenter', () => {
        document.documentElement.classList.add('cc-hidden-pay');
      });
      payCard.addEventListener('mouseleave', () => {
        document.documentElement.classList.remove('cc-hidden-pay');
      });
    }
  })();
</script>

<style>
  .checkout-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--card-bg);
  }
  .checkout-card--pay {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  /* Stripe's embedded iframe inherits page background; keep the card readable */
  #stripe-checkout {
    min-height: 320px;
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    min-width: 0;
  }
  #stripe-checkout iframe {
    width: 100% !important;
    min-width: 0 !important;
  }
  html.cc-hidden-pay .cc { display: none !important; }
  html.cc-hidden-pay .checkout-card--pay,
  html.cc-hidden-pay .checkout-card--pay * { cursor: auto !important; }
  @media (max-width: 560px) {
    .checkout-card { padding: 16px; }
    #stripe-checkout { border-radius: 8px; }
  }
</style>
