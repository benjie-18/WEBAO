---
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = "en" as const;
const title = "Checkout · WEBAO";
const description = "Complete your WEBAO subscription: $149 CAD/month, no setup fee, cancel anytime.";

// Publishable key is public; replace with your Stripe publishable key (pk_live_...).
// Get it from Stripe Dashboard > Developers > API keys.
const STRIPE_PUBLISHABLE_KEY = "pk_live_YOUR_PUBLISHABLE_KEY_HERE";
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="section">
    <div class="shell" style="max-width: 920px;">
      <div class="eyebrow">Checkout</div>
      <h1 class="display" style="font-size: clamp(2rem, 5vw, 3.2rem); line-height:.92; margin-top:12px;">Almost there</h1>
      <p class="prose" style="margin-top:12px; max-width: 52ch;">
        Complete payment below to start your $149/month subscription.
        Your site build starts as soon as payment confirms.
      </p>

      <div class="checkout-grid" style="margin-top: 32px;">
        <!-- Order summary -->
        <div class="checkout-card">
          <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5;">ORDER SUMMARY</div>
          <div style="margin-top:16px; display:flex; align-items:baseline; gap:8px;">
            <span class="display" style="font-size: 2.6rem; line-height:.9;">$149</span>
            <span class="mono" style="font-size:11px; opacity:.6;">CAD/month</span>
          </div>
          <ul style="margin:18px 0 0; padding:0; list-style:none; display:grid; gap:10px; font-size:13.5px;">
            <li>✓ Custom 3–5 page website</li>
            <li>✓ Domain, hosting & SSL</li>
            <li>✓ SEO basics & analytics</li>
            <li>✓ Updates & support included</li>
          </ul>
          <div class="mono" style="margin-top:18px; padding-top:14px; border-top:1px solid var(--line); font-size:11px; color: var(--muted);">
            No setup fee · Cancel anytime<br/>
            <a href="/refunds" style="color: var(--accent-text);">Refund policy</a>
          </div>
          <div id="checkout-customer" class="mono" style="margin-top:14px; font-size:12px; line-height:1.7; color: var(--muted);"></div>
        </div>

        <!-- Embedded Stripe checkout -->
        <div class="checkout-card checkout-card--pay">
          <div class="mono" style="font-size:10px; letter-spacing:.14em; opacity:.5; margin-bottom:12px;">SECURE PAYMENT</div>
          <div id="stripe-checkout">
            <div class="mono" style="padding:40px 20px; text-align:center; color: var(--muted); font-size:12.5px;" id="checkout-loading">
              Loading secure payment form…
            </div>
          </div>
          <div class="mono" style="margin-top:12px; font-size:10.5px; text-align:center; color: var(--muted);">
            🔒 Encrypted & secure · Powered by Stripe
          </div>
        </div>
      </div>

      <p class="mono" style="margin-top:24px; font-size:11px; color: var(--muted); text-align:center;">
        Questions? <a href="/contact" style="color: var(--ink);">Contact us</a> before paying.
      </p>
    </div>
  </section>
</BaseLayout>

<script src="https://js.stripe.com/v3/"></script>
<script define:vars={{ pk: STRIPE_PUBLISHABLE_KEY }}>
  (function() {
    const mountEl = document.getElementById('stripe-checkout');
    const loadingEl = document.getElementById('checkout-loading');

    // Show customer details from the contact form
    try {
      const raw = sessionStorage.getItem('webao-checkout');
      const custEl = document.getElementById('checkout-customer');
      if (raw && custEl) {
        const d = JSON.parse(raw);
        const lines = [];
        if (d.business) lines.push('<strong style="color:var(--ink)">' + d.business + '</strong>');
        if (d.name) lines.push(d.name);
        if (d.email) lines.push(d.email);
        if (custEl && lines.length) custEl.innerHTML = lines.join('<br/>');
      }
    } catch (e) {}

    function fail(msg) {
      if (loadingEl) loadingEl.textContent = msg || 'Payment could not be loaded. Please contact us at hello@webao.ca.';
    }

    if (!window.Stripe) { fail('Stripe could not be loaded. Check your connection and refresh.'); return; }
    if (!pk || pk.includes('YOUR_PUBLISHABLE_KEY_HERE')) {
      fail('Payment is not configured yet. Please contact us at hello@webao.ca to complete your subscription.');
      return;
    }

    let customer = {};
    try {
      const raw = sessionStorage.getItem('webao-checkout');
      if (raw) customer = JSON.parse(raw);
    } catch (e) {}

    fetch('/api/checkout/session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: customer.email || '', name: customer.name || '', business: customer.business || '' }),
    })
      .then((r) => r.json())
      .then(async (data) => {
        if (!data.ok || !data.clientSecret) {
          fail(data.error || 'Could not start checkout. Please try again or contact us.');
          return;
        }
        const stripe = window.Stripe(pk);
        const checkout = await stripe.initEmbeddedCheckout({ clientSecret: data.clientSecret });
        checkout.mount('#stripe-checkout');
      })
      .catch(() => fail());
  })();
</script>

<style>
  .checkout-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .checkout-grid { grid-template-columns: 1fr 1.4fr; }
  }
  .checkout-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--card-bg);
  }
  .checkout-card--pay {
    background: var(--paper-2);
    border-color: var(--line-strong);
  }
  .checkout-card ul li {
    color: var(--ink);
  }
  /* Stripe's embedded iframe inherits page background; keep the card readable */
  #stripe-checkout {
    min-height: 320px;
    border-radius: 12px;
    overflow: hidden;
  }
</style>
