---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotFoundPage from "../components/pages/NotFoundPage.astro";
import { useTranslations, getLocaleFromUrl } from "../lib/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={t.meta.notfound.title} description={t.meta.notfound.description} noIndex locale={locale} pageKey="notfound">
  <NotFoundPage locale={locale} />
</BaseLayout>
