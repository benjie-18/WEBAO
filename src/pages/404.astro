---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — WEBAO" description="The page you’re looking for doesn’t exist. Browse our demos or pricing." noIndex>
  <section class="section grain" style="min-height: 60vh; display:grid; place-items:center; text-align:center;">
    <div class="shell" style="max-width: 560px;">
      <div class="eyebrow">404 — Not found</div>
      <h1 class="display" style="font-size: clamp(2.4rem, 5vw, 3.6rem); margin-top:12px; line-height:.9;">That page<br /><span style="font-style: italic; font-weight:400;">isn’t here.</span></h1>
      <p class="prose" style="margin-top:16px; margin-inline:auto;">Maybe you followed an old link. Let’s get you somewhere useful — demos, pricing, or a conversation about your site.</p>
      <div class="cluster" style="justify-content:center; margin-top: 20px;">
        <a href="/" class="btn btn--primary">Go home →</a>
        <a href="/demos" class="btn btn--ghost">Browse demos</a>
        <a href="/contact" class="btn btn--ghost">Contact</a>
      </div>
      <div class="mono" style="margin-top:18px; font-size:11px; color: var(--muted);">If you think this is a mistake, email <a href="mailto:hello@webao.ca" style="color: var(--accent); font-weight:600; text-decoration: underline; text-underline-offset:3px;">hello@webao.ca</a></div>
    </div>
  </section>
</BaseLayout>
