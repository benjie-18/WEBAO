---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PricingPage from "../../components/pages/PricingPage.astro";
import { useTranslations } from "../../lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);

// Product + Offer structured data: lets Google show price/currency in results.
const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: "WEBAO Custom Website",
  description: t.meta.pricing.description,
  brand: { "@type": "Brand", name: "WEBAO" },
  offers: [
    {
      "@type": "Offer",
      name: "Launch",
      url: "https://webao.ca/pricing/",
      priceCurrency: "CAD",
      price: "89.99",
      availability: "https://schema.org/InStock",
    },
    {
      "@type": "Offer",
      name: "Grow",
      url: "https://webao.ca/pricing/",
      priceCurrency: "CAD",
      price: "149.99",
      availability: "https://schema.org/InStock",
    },
    {
      "@type": "Offer",
      name: "Scale",
      url: "https://webao.ca/pricing/",
      priceCurrency: "CAD",
      price: "349.99",
      availability: "https://schema.org/InStock",
    },
  ],
});
---

<BaseLayout title={t.meta.pricing.title} description={t.meta.pricing.description} locale={locale} pageKey="pricing">
  <script slot="head" type="application/ld+json" set:html={productSchema} />
  <PricingPage locale={locale} />
</BaseLayout>
