      }
      :global(.cart-item-remove) {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      :global(.cart-item-remove:hover) {
        color: #e00;
        border-color: #e00;
      }
      :global(.cart-item-remove svg) {
        width: 15px;
        height: 15px;
      }
      .cart-drawer-footer {
        padding: 20px 24px;
        border-top: 1px solid var(--line);
        background: var(--paper-2);
      }
      .cart-drawer-total {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 16px;
        font-size: 1.1rem;
      }
      .cart-drawer-total strong {
        font-size: 1.4rem;
      }
      .cart-drawer-checkout {
        width: 100%;
        justify-content: center;
      }
      /* Empty cart: the link stays visible but inert (cart-ui also cancels
         the click and sets aria-disabled). */
      .cart-drawer-checkout.is-disabled {
        opacity: 0.5;
        pointer-events: none;
      }
      .cart-drawer-note {
        text-align: center;
        font-size: 0.8rem;
        color: var(--muted);
        margin: 12px 0 0;
      }
      /* Bundle suggestion: a quiet card inside the drawer, not a popup. */
      .cart-pack-suggest {
        margin-top: 14px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--paper-3);
      }
      .cart-pack-suggest p {
        font-size: 13px;
        line-height: 1.55;
        color: var(--ink-3);
      }
      .cart-pack-suggest button {
        margin-top: 10px;
        border: 0;
        border-radius: 999px;
        padding: 9px 16px;
        background: var(--ink);
        color: var(--paper);
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }
      /* Add-to-cart toast: dark pill, bottom center, above the drawer. */
      .cart-toast {
        position: fixed;
        left: 50%;
        bottom: calc(24px + env(safe-area-inset-bottom, 0px));
        transform: translate(-50%, 16px);
        z-index: 120;
        display: flex;
        align-items: center;
        gap: 14px;
        max-width: calc(100vw - 32px);
        padding: 12px 12px 12px 18px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--paper);
        font-size: 13.5px;
        font-weight: 600;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
        opacity: 0;
        transition: opacity .25s ease, transform .25s cubic-bezier(.16, 1, .3, 1);
        pointer-events: none;
      }
      .cart-toast.is-visible {
        opacity: 1;
        transform: translate(-50%, 0);
        pointer-events: auto;
      }
      .cart-toast button {
        flex: none;
        border: 0;
        border-radius: 999px;
        padding: 8px 14px;
        background: var(--paper);
        color: var(--ink);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
      /* Empty cart: a quiet muted text link, never a solid red pill. The
         two-click confirm keeps its meaning through red text alone. */
      .cart-empty-all {
        display: block;
        flex-shrink: 0;
        margin: 14px auto 0;
        padding: 4px 2px;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--muted);
        background: transparent;
        border: none;
        border-radius: 0;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s ease;
      }
      .cart-empty-all:hover {
        color: var(--ink);
      }
      .cart-empty-all[hidden] {
        display: none;
      }
      .cart-empty-all.is-armed {
        color: var(--accent);
      }
      /* Cart conflict popup: centred dialog above everything else. The
         action buttons are injected by cart-ui.ts, so :global() required. */
      .cart-conflict-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 100;
      }
      .cart-conflict-overlay[hidden],
      .cart-conflict[hidden] {
        display: none;
      }
      .cart-conflict {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(440px, calc(100vw - 40px));
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 24px;
        z-index: 101;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
      }
      .cart-conflict-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 32px 8px 0;
      }
      .cart-conflict-message {
        margin: 0 0 20px;
        color: var(--muted);
        line-height: 1.5;
      }
      .cart-conflict-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      :global(.cart-conflict-actions .btn) {
        justify-content: center;
      }
      .cart-conflict-close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .cart-conflict-close svg {
        width: 14px;
        height: 14px;
      }
    </style>
    <script>
      // Cart: buttons, badge, billing toggle and drawer. One module for every
      // page — listeners are delegated from `document` and the UI re-renders
      // on astro:page-load, so the cart keeps working across ClientRouter
      // navigations (module scripts only run once per window).
      import { initCart } from "../lib/cart-ui";
      initCart();
    </script>
  </body>
</html>
