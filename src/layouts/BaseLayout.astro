---
import { ClientRouter } from "astro:transitions";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  headerVariant?: "light" | "dark";
}
const {
  title = "WEBAO · Websites that work for small business",
  description = "WEBAO designs, hosts, and maintains custom websites for small businesses. One simple monthly fee. Domain, hosting, SEO basics, analytics, and ongoing support included.",
  ogImage = "/favicon.svg",
  noIndex = false,
  headerVariant = "light",
} = Astro.props as Props;

const canonical = Astro.url ? new URL(Astro.url.pathname, Astro.site).toString() : "https://webao.ca/";
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0A0F1C" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="WEBAO" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts: Instrument Serif + Inter + IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Global styles -->
    <style is:global>
      @import "../styles/global.css";
    </style>

    <ClientRouter />

    <!-- JSON-LD: Organization -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "WEBAO",
      url: "https://webao.ca",
      logo: "https://webao.ca/favicon.svg",
      contactPoint: { "@type": "ContactPoint", email: "hello@webao.ca", contactType: "customer service", availableLanguage: ["en","fr"], areaServed: "CA" },
      description: description,
    })} />

    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress-bar" data-progress></div></div>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class:list={["site-header", headerVariant === "dark" && "site-header--dark"]} role="banner">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="WEBAO home">
          <span class="brand-mark" aria-hidden="true">W</span>
          <span>WEBAO</span>
          <span class="mono" style="font-size: 10px; letter-spacing: .16em; opacity:.55; margin-left:2px; font-weight:500;">WEBAO.CA</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a href="/demos">Demos</a>
          <a href="/pricing">Pricing</a>
          <a href="/contact">Contact</a>
          <a href="/contact" class="cta">Start your site →</a>
        </nav>

        <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-panel">
          <span></span>
        </button>
      </div>
    </header>

    <div id="mobile-panel" class="mobile-panel" hidden>
      <a href="/demos">Demos <span aria-hidden="true">→</span></a>
      <a href="/pricing">Pricing <span aria-hidden="true">→</span></a>
      <a href="/contact">Contact <span aria-hidden="true">→</span></a>
      <a href="/contact" style="background: var(--ink); color: var(--paper); border-radius: 12px; padding-inline: 16px; margin-top: 12px; border-bottom:0;">Start your site →</a>
    </div>

    <!-- Full-viewport overlays (kept outside <main> so they are never affected
         by the landing page's own transforms). Used by the landing page intro. -->
    <slot name="overlay" />

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand" style="color: var(--paper);">
              <span class="brand-mark" style="background: var(--paper); color: var(--ink);">W</span>
              <span>WEBAO</span>
            </a>
            <p>Custom websites for small businesses across Canada. One monthly fee. We handle the domain, hosting, maintenance, and support, so you can run your business.</p>
            <div class="cluster" style="margin-top: 20px;">
              <span class="mono" style="font-size:10px; color: rgba(248,245,239,.5); letter-spacing:.14em;">BASED IN MONTRÉAL · SERVING BUSINESSES ACROSS CANADA</span>
            </div>
          </div>
          <div class="footer-col">
            <h4>Studio</h4>
            <a href="/demos">Demo catalog</a>
            <a href="/pricing">Pricing</a>
            <a href="/contact">Contact</a>
            <a href="/#process">How it works</a>
          </div>
          <div class="footer-col">
            <h4>Services</h4>
            <a href="/pricing">Custom 3–5 page sites</a>
            <a href="/pricing">Hosting & SSL</a>
            <a href="/pricing">SEO basics & analytics</a>
            <a href="/pricing">Ongoing support</a>
          </div>
          <div class="footer-col">
            <h4>Contact</h4>
            <a href="mailto:hello@webao.ca">hello@webao.ca</a>
            <span style="display:block; margin-top:10px; color: rgba(248,245,239,.55); font-size:13px; line-height:1.5;">We usually reply within one business day.<br />Monday to Friday, 9am to 5pm Eastern.</span>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} WEBAO · Made in Montréal.</span>
          <span style="display:flex; gap:16px;">
            <span>All demo businesses shown on this site are fictional.</span>
          </span>
        </div>
      </div>
    </footer>

    <script>
      function initBaseLayout() {
        // Clean up intro classes if not on a page with IntroSequence
        const hasIntro = !!document.querySelector('[data-webao-intro]');
        if (!hasIntro) {
          document.documentElement.classList.remove('wi-run', 'wi-static', 'wi-released');
          const main = document.getElementById('main');
          const headerEl = document.querySelector('.site-header') as HTMLElement | null;
          const footerEl = document.querySelector('.site-footer') as HTMLElement | null;
          if (main) main.style.transform = '';
          if (headerEl) headerEl.style.transform = '';
          if (footerEl) footerEl.style.transform = '';
        }

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isCoarse = window.matchMedia('(pointer: coarse), (hover: none)').matches;

        // Mobile menu
        const toggle = document.querySelector('.menu-toggle');
        const panel = document.getElementById('mobile-panel');
        if (toggle && panel) {
          toggle.setAttribute('aria-expanded', 'false');
          panel.setAttribute('hidden', '');
          panel.classList.remove('open');

          const handleToggleClick = () => {
            const open = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!open));
            if (open) {
              panel.setAttribute('hidden', '');
              panel.classList.remove('open');
            } else {
              panel.removeAttribute('hidden');
              panel.classList.add('open');
            }
          };

          toggle.replaceWith(toggle.cloneNode(true));
          const newToggle = document.querySelector('.menu-toggle');
          if (newToggle) {
            newToggle.addEventListener('click', handleToggleClick);
          }

          // close on link click
          panel.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
            const t = document.querySelector('.menu-toggle');
            if (t) t.setAttribute('aria-expanded', 'false');
            panel.setAttribute('hidden', '');
            panel.classList.remove('open');
          }));
        }

        // Reveal on scroll
        const reveals = document.querySelectorAll('[data-reveal]');
        if (!prefersReduced && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
          reveals.forEach(el => io.observe(el));
        } else {
          reveals.forEach(el => el.classList.add('is-visible'));
        }

        // Header shadow + scroll progress
        const header = document.querySelector('.site-header') as HTMLElement | null;
        const progress = document.querySelector('[data-progress]') as HTMLElement | null;
        if (header || progress) {
          let ticking = false;
          const onScroll = () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                const y = window.scrollY;
                if (header) {
                  header.style.boxShadow = y > 8 ? '0 4px 24px rgba(10,15,28,.06), 0 1px 0 rgba(10,15,28,.04)' : 'none';
                  header.style.background = y > 8 ? 'color-mix(in srgb, var(--paper) 96%, transparent)' : 'color-mix(in srgb, var(--paper) 88%, transparent)';
                }
                if (progress) {
                  const h = document.documentElement.scrollHeight - window.innerHeight;
                  const p = h > 0 ? Math.min(y / h, 1) : 0;
                  progress.style.transform = `scaleX(${p})`;
                }
                ticking = false;
              });
              ticking = true;
            }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }

        // Magnetic buttons
        if (!prefersReduced && !isCoarse && 'ontouchstart' in window === false) {
          const magnetics = document.querySelectorAll('.btn--primary, .btn--dark, .cta .btn');
          magnetics.forEach(btn => {
            const el = btn as HTMLElement;
            el.classList.add('btn--magnetic');
            el.addEventListener('mousemove', (e: MouseEvent) => {
              const r = el.getBoundingClientRect();
              const x = (e.clientX - r.left - r.width / 2) * 0.18;
              const y = (e.clientY - r.top - r.height / 2) * 0.28;
              el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
            });
            el.addEventListener('mouseleave', () => {
              el.style.transform = '';
            });
          });
        }

        // Smooth anchor offset
        document.querySelectorAll('a[href^="#"]').forEach(a => {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href');
            if (!id || id === '#') return;
            const target = document.querySelector(id);
            if (target) {
              e.preventDefault();
              const top = target.getBoundingClientRect().top + window.scrollY - 72;
              window.scrollTo({ top, behavior: prefersReduced ? 'auto' : 'smooth' });
              history.pushState(null, '', id);
            }
          });
        });

        // Prefetch hover
        document.querySelectorAll('a[href^="/"]').forEach(a => {
          a.addEventListener('mouseenter', () => {
            const href = a.getAttribute('href');
            if (href && !document.querySelector(`link[rel="prefetch"][href="${href}"]`)) {
              const link = document.createElement('link');
              link.rel = 'prefetch';
              link.href = href;
              document.head.appendChild(link);
            }
          }, { once: true });
        });
      }

      document.addEventListener('astro:page-load', initBaseLayout);
    </script>

    <style>
      /* Inlined critical for header/mobile */
      @media (prefers-reduced-motion: reduce) {
        * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </body>
</html>
