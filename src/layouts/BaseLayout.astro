---
import { ClientRouter } from "astro:transitions";
import LanguageSwitcher from "../components/ui/LanguageSwitcher.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import CustomCursor from "../components/anim/CustomCursor.astro";
import {
  getLocaleFromUrl,
  getAlternateUrls,
  localizedPaths,
  type Locale,
  type PageKey,
  getPageKeyFromPath,
} from "../lib/i18n/config";
import { useTranslations } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  headerVariant?: "light" | "dark";
  locale?: Locale;
  pageKey?: PageKey;
  /** Mobile "Start →" bar. Off on the pages that are the funnel itself. */
  stickyCta?: boolean;
}

const {
  title: titleProp,
  description: descProp,
  ogImage = "/og-image.jpg",
  noIndex = false,
  headerVariant = "light",
  locale: localeProp,
  pageKey: pageKeyProp,
  stickyCta: stickyCtaProp = true,
} = Astro.props as Props;

const url = Astro.url;
const detected = getLocaleFromUrl(url);
const locale: Locale = localeProp ?? detected;
const t = useTranslations(locale);

const pageInfo = getPageKeyFromPath(url.pathname);
const pageKey: PageKey | null = pageKeyProp ?? pageInfo.pageKey;

const metaTitle =
  titleProp ??
  (pageKey ? (t.meta as any)[pageKey]?.title : undefined) ??
  t.meta.home.title;
const metaDesc =
  descProp ??
  (pageKey ? (t.meta as any)[pageKey]?.description : undefined) ??
  t.meta.home.description;

const canonical = Astro.url ? new URL(Astro.url.pathname, Astro.site).toString() : "https://webao.ca/";

const siteBase = (Astro.site?.toString() ?? "https://webao.ca").replace(/\/$/, "");
// og:image must be an absolute URL for social crawlers.
const ogImageAbs = ogImage.startsWith("http") ? ogImage : `${siteBase}${ogImage}`;
const alternates = getAlternateUrls(url.pathname, siteBase);

// For hreflang, ensure both locales exist
const enHref = alternates.en;
const frHref = alternates.fr;

const htmlLang = locale === "fr" ? "fr-CA" : "en-CA";

// Structured data: WebSite + BreadcrumbList (subpages) for rich SERP display.
const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "WEBAO",
  url: "https://webao.ca",
  inLanguage: ["en-CA", "fr-CA"],
});
const crumbLabels: Record<string, string> = {
  pricing: t.nav.pricing,
  demos: t.nav.demos,
  contact: t.nav.contact,
  start: locale === "fr" ? "Commencer" : "Start",
  terms: locale === "fr" ? "Conditions" : "Terms",
  privacy: locale === "fr" ? "Confidentialité" : "Privacy",
  portal: locale === "fr" ? "Portail client" : "Client portal",
  sources: "Sources",
  refunds: locale === "fr" ? "Remboursements" : "Refunds",
  guideIndex: "Guides",
};
const crumbName = pageKey ? crumbLabels[pageKey] : undefined;
const breadcrumbSchema = crumbName
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: locale === "fr" ? "Accueil" : "Home",
          item: `${siteBase}${localizedPaths[locale].home}`,
        },
        { "@type": "ListItem", position: 2, name: crumbName, item: canonical },
      ],
    })
  : null;

// Localized nav paths
const navLinks = {
  demos: localizedPaths[locale].demos,
  pricing: localizedPaths[locale].pricing,
  audit: localizedPaths[locale].audit,
  contact: localizedPaths[locale].contact,
  support: localizedPaths[locale].support,
  home: localizedPaths[locale].home,
  start: localizedPaths[locale].start,
  portal: localizedPaths[locale].portal,
  serviceDesign: localizedPaths[locale].serviceDesign,
  servicePlans: localizedPaths[locale].servicePlans,
  serviceHosting: localizedPaths[locale].serviceHosting,
  serviceMontreal: localizedPaths[locale].serviceMontreal,
  guideCost: localizedPaths[locale].guideCost,
  guideBill96: localizedPaths[locale].guideBill96,
  guideLaw25: localizedPaths[locale].guideLaw25,
  guideIndex: localizedPaths[locale].guideIndex,
  process: locale === "fr" ? "/fr#processus" : "/#process",
};

// Localized process anchor
const processAnchor = locale === "fr" ? "#processus" : "#process";
const homeProcessLink = `${localizedPaths[locale].home}${processAnchor}`;

// The sticky bar sells the funnel; never show it on the funnel's own pages
// (pricing, the start/details step, the payment step).
const showStickyCta = stickyCtaProp && pageKey !== "start" && pageKey !== "pricing";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#F8F5EF" />
    <meta name="color-scheme" content="light dark" />

    <!-- Theme init: runs before first paint to avoid a flash of the wrong
         theme. Stored choice wins; otherwise the OS preference is respected.
         Also marks the document as JS-run (html.js): entrance/reveal hidden
         states only apply with JS, so a no-JS load shows the content. -->
    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.add("js");
          var stored = null;
          try { stored = localStorage.getItem("webao.theme"); } catch (e) {}
          var theme = stored === "dark" || stored === "light"
            ? stored
            : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#070B14" : "#F8F5EF");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <!-- Analytics beacon: pageviews, clicks, time-on-page. Fail-silent and
         non-blocking; never breaks the page if the API is unreachable.
         Skipped entirely when Do Not Track is on. The session id persists in
         localStorage (per the /api/track contract) so a returning visitor in
         another tab still counts as one session. -->
    <script is:inline>
      (function () {
        try {
          if (navigator.doNotTrack === "1") return;

          var SID_KEY = "webao.sid";
          var sid = null;
          try { sid = localStorage.getItem(SID_KEY); } catch (e) { sid = null; }
          if (!sid) {
            if (window.crypto && typeof window.crypto.randomUUID === "function") {
              sid = window.crypto.randomUUID();
            } else {
              sid = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
                var r = (Math.random() * 16) | 0;
                return (c === "x" ? r : (r & 0x3) | 0x8).toString(16);
              });
            }
            try { localStorage.setItem(SID_KEY, sid); } catch (e) {}
          }

          var startTs = 0;
          var curPath = "";
          var lastPv = "";
          var finalSent = false;
          var clickBuffer = [];
          var pendingPrev = null;
          // A final heartbeat was already sent for the current view:
          // hide + pagehide both fire when a tab closes, and each would
          // cost a KV write for the same visit. Reset when the tab is
          // shown again or a new page is viewed.
          // Clicks are buffered and flushed with the next pageview or
          // final heartbeat instead of one POST per click (one KV write
          // per click). pendingPrev carries the page being left when the
          // client router navigates, so its time-on-page rides along
          // with the next pageview instead of a separate heartbeat.

          function post(url, body, useBeacon) {
            try {
              var payload = JSON.stringify(body);
              if (useBeacon && navigator.sendBeacon) {
                navigator.sendBeacon(url, payload);
                return;
              }
              fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: payload,
                keepalive: true,
              }).catch(function () {});
            } catch (e) {}
          }

          function pageview() {
            var key = location.pathname + location.search;
            if (key === lastPv) return;
            lastPv = key;
            startTs = Date.now();
            finalSent = false;
            curPath = location.pathname;
            var body = { sid: sid, path: curPath };
            if (document.referrer) body.referrer = document.referrer;
            try { body.screen = window.screen.width + "x" + window.screen.height; } catch (e) {}
            var lang = document.documentElement.getAttribute("lang");
            if (lang) body.locale = lang;
            var theme = document.documentElement.getAttribute("data-theme");
            if (theme) body.theme = theme;
            // Piggyback: the page just left (client-router nav) and any
            // clicks buffered since the last flush ride along, so this
            // one request carries what used to cost extra writes.
            if (pendingPrev) {
              body.prevPath = pendingPrev.path;
              body.prevDurationMs = pendingPrev.durationMs;
              pendingPrev = null;
            }
            if (clickBuffer.length) {
              body.clicks = clickBuffer;
              clickBuffer = [];
            }
            post("/api/track/pageview", body, false);
          }

          function heartbeat(useBeacon, isFinal) {
            if (!startTs) return;
            // One final beat per view: hide + pagehide both fire on close.
            if (isFinal) {
              if (finalSent) return;
              finalSent = true;
            }
            var body = { sid: sid, path: curPath, durationMs: Date.now() - startTs, final: !!isFinal };
            // Flush any clicks buffered since the last pageview: they
            // ride along with this beat instead of costing a write each.
            if (clickBuffer.length) {
              body.clicks = clickBuffer;
              clickBuffer = [];
            }
            post("/api/track/heartbeat", body, useBeacon);
          }

          // Click tracking: kind comes from the closest [data-track], otherwise
          // from the tag and its context (nav vs plain link, cta vs button).
          document.addEventListener("click", function (e) {
            try {
              var t = e.target;
              if (!t || !t.closest) return;
              var el = t.closest("a, button, [data-track]");
              if (!el) return;
              var kind = null;
              var label = "";
              var tracked = el.closest("[data-track]");
              if (tracked) {
                kind = tracked.getAttribute("data-track") || "click";
                label = tracked.getAttribute("data-track-label") || tracked.textContent || "";
              } else if (el.tagName === "A") {
                kind = el.closest("nav, header, footer") ? "nav" : "link";
                label = el.textContent || "";
              } else if (el.tagName === "BUTTON") {
                var cls = typeof el.className === "string" ? el.className : "";
                kind = /\b(cta|btn--primary)\b/.test(cls) ? "cta" : "button";
                label = el.textContent || el.getAttribute("aria-label") || "";
              }
              label = String(label).replace(/\s+/g, " ").trim().slice(0, 120);
              // Buffer the click: it is flushed with the next pageview
              // or final heartbeat instead of costing a KV write each.
              clickBuffer.push({
                path: curPath || location.pathname,
                kind: kind || "click",
                label: label,
                at: Date.now(),
              });
              if (clickBuffer.length > 200) clickBuffer = clickBuffer.slice(-200);
            } catch (err) {}
          }, { passive: true, capture: true });

          document.addEventListener("astro:page-load", pageview);
          // Client-router navigation away: stash time-on-page for the
          // next pageview instead of sending a heartbeat. The next
          // pageview carries the previous page's duration (and any
          // buffered clicks) in the same request, so navigating costs
          // no extra KV write. A real close still sends a final beat.
          document.addEventListener("astro:before-preparation", function () {
            if (!startTs || !curPath) return;
            pendingPrev = { path: curPath, durationMs: Date.now() - startTs };
          });
          document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "hidden") heartbeat(true, true);
            else finalSent = false;
          });
          window.addEventListener("pagehide", function () { heartbeat(true, true); });
          // No periodic heartbeat: the final beats above already send the
          // total time on the page (durationMs is measured from the
          // pageview, and the server keeps the largest value), so a beat
          // every few minutes would only re-send intermediate totals
          // nobody reads, at one KV write per open tab per beat. The
          // final beat on hide / close is the only one kept; client-
          // router navigations piggyback on the next pageview instead.

          if (document.readyState !== "loading") pageview();
          else document.addEventListener("DOMContentLoaded", pageview, { once: true });
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:site_name" content="WEBAO" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="701" />
    <meta property="og:image:height" content="292" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:locale" content={locale === "fr" ? "fr_CA" : "en_CA"} />
    <meta property="og:locale:alternate" content={locale === "fr" ? "en_CA" : "fr_CA"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={metaTitle} />

    <!-- Fonts: Instrument Serif + Inter + IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon: theme-aware icons (new logo) -->
    <link rel="icon" href="/light-icon.svg" media="(prefers-color-scheme: light)" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/dark-icon.svg" media="(prefers-color-scheme: dark)" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" type="image/png" sizes="180x180" />

    <!-- Global styles -->
    <style is:global>
      @import "../styles/global.css";
    </style>

    <ClientRouter />

    <!-- JSON-LD: Organization -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "WEBAO",
        url: "https://webao.ca",
        logo: "https://webao.ca/light-logo.jpg",
        contactPoint: {
          "@type": "ContactPoint",
          email: "contact@webao.ca",
          contactType: "customer service",
          availableLanguage: ["en", "fr"],
          areaServed: "CA",
        },
        description: metaDesc,
      })}
    />

    <script is:inline type="application/ld+json" set:html={websiteSchema} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={breadcrumbSchema} />}

    <slot name="head" />
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important;}</style></noscript>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress-bar" data-progress></div></div>
    <a href="#main" class="skip-link">{t.nav.skip}</a>

    <header class:list={["site-header", headerVariant === "dark" && "site-header--dark"]} role="banner">
      <div class="header-inner">
        <a href={navLinks.home} class="brand" aria-label={t.nav.homeAria}>
          <img src="/light-logo.jpg" alt="WEBAO" class="brand-logo brand-logo--light" width="120" height="40" />
          <img src="/dark-logo.jpg" alt="WEBAO" class="brand-logo brand-logo--dark" width="120" height="40" />
        </a>

        <div class="header-right">
          <nav class="nav" aria-label={locale==="fr" ? "Principal" : "Primary"}>
            <a href={navLinks.demos}>{t.nav.demos}</a>
            <a href={navLinks.pricing}>{t.nav.pricing}</a>
            <a href={navLinks.audit}>{t.nav.audit}</a>
            <div class="nav-item--mega" data-mega>
              <button type="button" class="nav-mega-trigger" aria-expanded="false" aria-haspopup="true" data-mega-trigger>
                {t.nav.services} <span class="nav-mega-caret" aria-hidden="true">▾</span>
              </button>
              <div class="nav-mega" data-mega-panel hidden>
                <div class="nav-mega-col">
                  <p class="nav-mega-heading">{t.nav.services}</p>
                  <a href={navLinks.serviceDesign}>{t.nav.megaDesign}</a>
                  <a href={navLinks.servicePlans}>{t.nav.megaPlans}</a>
                  <a href={navLinks.serviceHosting}>{t.nav.megaHosting}</a>
                  <a href={navLinks.serviceMontreal}>{t.nav.megaMontreal}</a>
                </div>
                <div class="nav-mega-col">
                  <p class="nav-mega-heading">{t.nav.megaResources}</p>
                  <a href={navLinks.guideIndex}>{t.nav.guides}</a>
                  <a href={navLinks.guideBill96}>{t.nav.megaBill96}</a>
                  <a href={navLinks.guideLaw25}>{t.nav.megaLaw25}</a>
                  <a href={navLinks.portal}>{t.nav.portal}</a>
                  <a href={navLinks.support}>{t.nav.support}</a>
                </div>
              </div>
            </div>
            <a href={navLinks.contact} class="nav-contact">{t.nav.contact}</a>
            <a href={navLinks.start} class="cta" data-track="cta" data-track-label={t.nav.startSite} data-start-cta>{t.nav.startSite}</a>
          </nav>

          <LanguageSwitcher locale={locale} currentPath={url.pathname} />

          <LanguageSwitcher locale={locale} currentPath={url.pathname} variant="toggle" />

          <ThemeToggle locale={locale} />

          <button type="button" class="header-cart-btn" data-cart-open aria-label={t.cart.open}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="header-cart-icon">
              <g clip-path="url(#header-cart-clip)">
                <path d="M5.33331 6H19.8672C20.4687 6 20.9341 6.52718 20.8595 7.12403L20.1095 13.124C20.0469 13.6245 19.6215 14 19.1172 14H16.5555H9.44442H7.99998" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
                <path d="M2 4H4.23362C4.68578 4 5.08169 4.30341 5.19924 4.74003L8.30076 16.26C8.41831 16.6966 8.81422 17 9.26638 17H19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                <circle cx="10" cy="20" r="1.2" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
                <circle cx="17.5" cy="20" r="1.2" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
              </g>
              <defs>
                <clipPath id="header-cart-clip">
                  <rect width="24" height="24" fill="white"/>
                </clipPath>
              </defs>
            </svg>
            <span class="header-cart-count" data-cart-count hidden>0</span>
          </button>

          <button class="menu-toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="mobile-panel">
            <span></span>
          </button>
        </div>
      </div>
    </header>

    <div class="nav-scrim" data-mega-scrim hidden></div>

    <div id="mobile-panel" class="mobile-panel" hidden>
      <a href={navLinks.demos} style="--i:0">{t.nav.demos} <span aria-hidden="true">→</span></a>
      <a href={navLinks.pricing} style="--i:1">{t.nav.pricing} <span aria-hidden="true">→</span></a>
      <a href={navLinks.audit} style="--i:2">{t.nav.audit} <span aria-hidden="true">→</span></a>
      <a href={navLinks.contact} style="--i:3">{t.nav.contact} <span aria-hidden="true">→</span></a>
      <a href={localizedPaths[locale].serviceDesign} style="--i:4">{t.nav.services} <span aria-hidden="true">→</span></a>
      <a href={localizedPaths[locale].guideIndex} style="--i:5">{t.nav.guides} <span aria-hidden="true">→</span></a>
      <a href={navLinks.portal} style="--i:6">{t.nav.portal} <span aria-hidden="true">→</span></a>
      <a href={navLinks.support} style="--i:7">{t.nav.support} <span aria-hidden="true">→</span></a>
      <a
        href={navLinks.start}
        data-track="cta"
        data-track-label={t.nav.startSite}
        data-start-cta
        style="--i:8; background: var(--ink); color: var(--paper); border-radius: 12px; padding-inline: 16px; margin-top: 12px; border-bottom:0;"
        >{t.nav.startSite}</a
      >
      <div class="drawer-utils">
        <ThemeToggle locale={locale} />
        <LanguageSwitcher locale={locale} currentPath={url.pathname} variant="toggle" />
      </div>
    </div>

    <!-- Full-viewport overlays (kept outside <main> so they are never affected
         by the landing page's own transforms). -->
    <slot name="overlay" />

    <main id="main">
      <slot />
    </main>

    <CustomCursor />

    <button
      type="button"
      class="to-top"
      data-to-top
      aria-label={t.nav.backToTop}
      title={t.nav.backToTop}
      hidden
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <footer class="site-footer" role="contentinfo">
      <div class="shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={navLinks.home} class="brand" style="color: var(--section-dark-text);" aria-label={t.nav.homeAria}>
              <img src="/dark-logo.jpg" alt="WEBAO" class="brand-logo" width="120" height="40" />
            </a>
            <p>{t.footer.tagline}</p>
            <div class="cluster" style="margin-top: 20px;">
              <span class="mono" style="font-size:10px; color: rgba(248,245,239,.5); letter-spacing:.14em;">{t.footer.location}</span>
            </div>
          </div>
          <div class="footer-col">
            <h4>{t.footer.studio}</h4>
            <a href={navLinks.demos}>{t.footer.demoCatalog}</a>
            <a href={navLinks.pricing}>{t.footer.pricing}</a>
            <a href={navLinks.audit}>{t.nav.audit}</a>
            <a href={navLinks.contact}>{t.footer.contact}</a>
            <a href={navLinks.support}>{t.footer.support}</a>
            <a href={navLinks.portal}>{t.footer.portal}</a>
            <a href={homeProcessLink}>{t.footer.howItWorks}</a>
          </div>
          <div class="footer-col">
            <h4>{t.footer.services}</h4>
            <a href={navLinks.serviceDesign}>{t.footer.customSites}</a>
            <a href={navLinks.servicePlans}>{t.footer.monthlyPlans}</a>
            <a href={navLinks.pricing}>{t.footer.adsPackages}</a>
            <a href={navLinks.pricing}>{t.footer.aiServices}</a>
          </div>
          <div class="footer-col">
            <h4>{t.footer.guides}</h4>
            <a href={navLinks.guideIndex}>{t.footer.guidesIndex}</a>
            <a href={navLinks.guideCost}>{t.footer.guideCost}</a>
            <a href={navLinks.guideBill96}>{t.footer.guideBill96}</a>
            <a href={navLinks.guideLaw25}>{t.footer.guideLaw25}</a>
          </div>
          <div class="footer-col">
            <h4>{t.footer.contactTitle}</h4>
            <a href="mailto:contact@webao.ca">contact@webao.ca</a>
            <span style="display:block; margin-top:10px; color: rgba(248,245,239,.55); font-size:13px; line-height:1.5;" set:html={t.footer.replyTime}></span>
          </div>
        </div>
        <div class="footer-bottom">
          <span set:html={t.footer.copyright.replace("{year}", String(new Date().getFullYear()))}></span>
          <span style="display:flex; gap:16px; align-items:center;">
            <span>{t.footer.fictionalNote}</span>
          </span>
        </div>
      </div>
    </footer>

    {showStickyCta && (
      <div class="sticky-cta" data-sticky-cta role="region" aria-label={t.nav.stickyCta}>
        <span class="sticky-cta-text">
          <strong>{t.nav.stickyCtaPrice}</strong>
        </span>
        <a
          href={navLinks.start}
          class="sticky-cta-btn"
          data-track="cta"
          data-track-label={t.nav.stickyCta}
        >{t.nav.stickyCta}</a>
      </div>
    )}

    <script>
      let scrollCleanup: (() => void) | null = null;
      let pauseCleanup: (() => void) | null = null;

      function initLayout() {
        // Mobile menu setup & reset
        const toggle = document.querySelector('.menu-toggle');
        const panel = document.getElementById('mobile-panel');
        if (toggle && panel) {
          toggle.setAttribute('aria-expanded', 'false');
          panel.setAttribute('hidden', '');
          panel.classList.remove('open');

          const onToggle = () => {
            const open = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!open));
            if (open) {
              panel.setAttribute('hidden', '');
              panel.classList.remove('open');
            } else {
              panel.removeAttribute('hidden');
              panel.classList.add('open');
            }
          };

          toggle.addEventListener('click', onToggle);

          panel.querySelectorAll('a').forEach(a => {
            a.addEventListener('click', () => {
              toggle.setAttribute('aria-expanded', 'false');
              panel.setAttribute('hidden', '');
              panel.classList.remove('open');
            });
          });

          const onKeyDown = (e: KeyboardEvent) => {
            if (e.key === 'Escape' && panel.classList.contains('open')) {
              toggle.setAttribute('aria-expanded', 'false');
              panel.setAttribute('hidden', '');
              panel.classList.remove('open');
              (toggle as HTMLElement).focus();
            }
          };
          document.addEventListener('keydown', onKeyDown);
        }

        // Desktop mega-menu (#31): frosted Services/Resources dropdown.
        // Hover and focus open it; click toggles (touch); Esc or a scrim
        // click closes it. Guarded so a ClientRouter re-init never
        // double-binds the same trigger.
        const mega = document.querySelector('[data-mega]') as HTMLElement | null;
        const megaTrigger = document.querySelector('[data-mega-trigger]') as HTMLButtonElement | null;
        const megaPanel = document.querySelector('[data-mega-panel]') as HTMLElement | null;
        const megaScrim = document.querySelector('[data-mega-scrim]') as HTMLElement | null;
        if (mega && megaTrigger && megaPanel && megaScrim && !megaTrigger.dataset.webaoBound) {
          megaTrigger.dataset.webaoBound = '1';
          let megaHoverTimer = 0;
          const setMega = (open: boolean) => {
            mega.classList.toggle('is-open', open);
            megaTrigger.setAttribute('aria-expanded', String(open));
            if (open) {
              megaPanel.removeAttribute('hidden');
              megaScrim.removeAttribute('hidden');
            } else {
              megaPanel.setAttribute('hidden', '');
              megaScrim.setAttribute('hidden', '');
            }
          };
          const openSoon = () => {
            window.clearTimeout(megaHoverTimer);
            megaHoverTimer = window.setTimeout(() => setMega(true), 120);
          };
          const closeSoon = () => {
            window.clearTimeout(megaHoverTimer);
            megaHoverTimer = window.setTimeout(() => setMega(false), 180);
          };
          mega.addEventListener('mouseenter', openSoon);
          mega.addEventListener('mouseleave', closeSoon);
          megaTrigger.addEventListener('focus', openSoon);
          mega.addEventListener('focusout', (e: FocusEvent) => {
            if (!mega.contains(e.relatedTarget as Node | null)) closeSoon();
          });
          megaTrigger.addEventListener('click', () => {
            window.clearTimeout(megaHoverTimer);
            setMega(!mega.classList.contains('is-open'));
          });
          megaScrim.addEventListener('click', () => setMega(false));
          megaPanel.querySelectorAll('a').forEach((a) => {
            a.addEventListener('click', () => setMega(false));
          });
          document.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Escape' && mega.classList.contains('is-open')) {
              setMega(false);
              megaTrigger.focus();
            }
          });
        }

        // Reveal on scroll, respects prefers-reduced-motion.
        // Gated on fonts.ready: revealing text before webfonts load causes
        // layout shifts mid-animation (stutter), especially on slower connections.
        // Anything already in the viewport is revealed immediately, so a
        // hash jump or slow font load never leaves a visible void.
        const revealInViewport = () => {
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            const r = (el as HTMLElement).getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('is-visible');
          });
        };
        revealInViewport();
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isCoarse = window.matchMedia('(pointer: coarse), (hover: none)').matches;
        const initReveals = () => {
          if (!prefersReduced && 'IntersectionObserver' in window) {
            const io = new IntersectionObserver((entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  io.unobserve(e.target);
                }
              }
            }, { threshold: 0.05, rootMargin: '0px 0px 12% 0px' });
            document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
          } else {
            document.querySelectorAll('[data-reveal]').forEach(el => el.classList.add('is-visible'));
          }
        };
        if ('fonts' in document && (document as any).fonts.ready) {
          let revealed = false;
          const doReveal = () => { if (!revealed) { revealed = true; initReveals(); } };
          (document as any).fonts.ready.then(doReveal);
          window.setTimeout(doReveal, 1500);
        } else {
          initReveals();
        }

        // Subtle header shadow + scroll progress + header bg opacity
        if (scrollCleanup) {
          scrollCleanup();
          scrollCleanup = null;
        }

        const header = document.querySelector('.site-header') as HTMLElement | null;
        const progress = document.querySelector('[data-progress]') as HTMLElement | null;
        const toTop = document.querySelector('[data-to-top]') as HTMLButtonElement | null;
        if (toTop && !toTop.dataset.webaoBound) {
          toTop.dataset.webaoBound = '1';
          toTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
          });
        }
        if (header || progress || toTop) {
          let ticking = false;
          // The header and back-to-top styles only ever flip between two
          // states (scrolled / not). Writing them on every scroll frame
          // forces a style recalc + repaint of the blurred header each
          // frame for no visual difference, so writes happen only when
          // the state actually changes. Same values, same look.
          let headerState: string | null = null;
          let toTopShown: boolean | null = null;
          const onScroll = () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                const y = window.scrollY;
                // Read geometry before any style writes in this frame, so
                // the read never forces a synchronous layout flush.
                const docH = document.documentElement.scrollHeight - window.innerHeight;
                if (header) {
                  const dark = document.documentElement.getAttribute('data-theme') === 'dark';
                  const state = (y > 24 ? 'scrolled' : 'top') + (dark ? '-dark' : '-light');
                  if (state !== headerState) {
                    headerState = state;
                    header.style.boxShadow = y > 24
                      ? (dark
                          ? '0 8px 32px rgba(0,0,0,.5), 0 1px 0 rgba(248,245,239,.09)'
                          : '0 8px 32px rgba(10,15,28,.10), 0 1px 0 rgba(10,15,28,.06)')
                      : 'none';
                    header.style.background = y > 24 ? 'color-mix(in srgb, var(--paper) 96%, transparent)' : 'color-mix(in srgb, var(--paper) 88%, transparent)';
                  }
                }
                if (progress) {
                  const p = docH > 0 ? Math.min(y / docH, 1) : 0;
                  progress.style.transform = `scaleX(${p})`;
                }
                if (toTop) {
                  const show = y > window.innerHeight * 0.9;
                  if (show !== toTopShown) {
                    toTopShown = show;
                    toTop.hidden = !show;
                    toTop.classList.toggle('is-visible', show);
                  }
                }
                ticking = false;
              });
              ticking = true;
            }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
          scrollCleanup = () => window.removeEventListener('scroll', onScroll);
        }

        // Sticky mobile CTA bar: slides up after scrolling past the hero.
        // Mobile only (CSS media query); not rendered on the start page.
        const stickyCta = document.querySelector('[data-sticky-cta]') as HTMLElement | null;
        if (stickyCta) {
          const coarse = window.matchMedia('(max-width: 768px)');
          let ctaTicking = false;
          let ctaShown: boolean | null = null;
          const prevCleanup = scrollCleanup;
          const updateCta = () => {
            const show = coarse.matches && window.scrollY > 480;
            if (show !== ctaShown) {
              ctaShown = show;
              stickyCta.classList.toggle('is-visible', show);
              document.body.classList.toggle('has-sticky-cta', show);
            }
            ctaTicking = false;
          };
          const onScrollCta = () => {
            if (!ctaTicking) {
              ctaTicking = true;
              requestAnimationFrame(updateCta);
            }
          };
          window.addEventListener('scroll', onScrollCta, { passive: true });
          if (typeof coarse.addEventListener === 'function') {
            coarse.addEventListener('change', updateCta);
          }
          updateCta();
          scrollCleanup = () => {
            window.removeEventListener('scroll', onScrollCta);
            if (prevCleanup) prevCleanup();
          };
        }

        // Pause looping CSS animations while their section is off-screen.
        // Pausing preserves each animation's phase, so nothing on screen
        // changes; the grain shift, the marquee and the pricing bundle's
        // drifting blobs/cards just stop consuming paint time while the
        // visitor is looking elsewhere. Rules live in global.css (grain,
        // marquee) and in BundleCarousel's own styles (blobs, card drift).
        if (pauseCleanup) { pauseCleanup(); pauseCleanup = null; }
        if ('IntersectionObserver' in window) {
          const pausables = document.querySelectorAll('.grain, .marquee, [data-bundle-section]');
          if (pausables.length) {
            const pio = new IntersectionObserver((entries) => {
              for (const e of entries) {
                if (e.isIntersecting) e.target.removeAttribute('data-anim-paused');
                else e.target.setAttribute('data-anim-paused', '');
              }
            });
            pausables.forEach(el => pio.observe(el));
            pauseCleanup = () => pio.disconnect();
          }
        }

        // Magnetic buttons: desktop only, respects reduced motion
        if (!prefersReduced && !isCoarse && 'ontouchstart' in window === false) {
          const magnetics = document.querySelectorAll('.btn--primary, .btn--dark, .cta .btn');
          magnetics.forEach(btn => {
            const el = btn as HTMLElement;
            el.classList.add('btn--magnetic');
            // Coalesce through rAF: high-polling mice can fire mousemove
            // many times per frame, and each event used to do its own
            // rect read + transform write. One write per frame with the
            // latest position is visually identical (the button already
            // smooths via its .15s linear transform transition).
            let magRaf = 0;
            let magX = 0;
            let magY = 0;
            el.addEventListener('mousemove', (e: MouseEvent) => {
              magX = e.clientX;
              magY = e.clientY;
              if (!magRaf) {
                magRaf = requestAnimationFrame(() => {
                  magRaf = 0;
                  const r = el.getBoundingClientRect();
                  const x = (magX - r.left - r.width/2) * 0.18;
                  const y = (magY - r.top - r.height/2) * 0.28;
                  el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
                });
              }
            });
            el.addEventListener('mouseleave', () => {
              if (magRaf) { cancelAnimationFrame(magRaf); magRaf = 0; }
              el.style.transform = '';
            });
          });
        }

        // Smooth anchor offset for sticky header
        document.querySelectorAll('a[href^="#"]').forEach(a => {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href');
            if (!id || id === '#') return;
            const target = document.querySelector(id);
            if (target) {
              e.preventDefault();
              const top = target.getBoundingClientRect().top + window.scrollY - 72;
              window.scrollTo({ top, behavior: prefersReduced ? 'auto' : 'smooth' });
              history.pushState(null, '', id);
            }
          });
        });

        // Prefetch hover for internal links (boost View Transitions)
        document.querySelectorAll('a[href^="/"]').forEach(a => {
          a.addEventListener('mouseenter', () => {
            const href = a.getAttribute('href');
            if (href && !document.querySelector(`link[rel="prefetch"][href="${href}"]`)) {
              const link = document.createElement('link');
              link.rel = 'prefetch';
              link.href = href;
              document.head.appendChild(link);
            }
          }, { once: true });
        });
      }

      document.addEventListener('astro:page-load', initLayout);

      // Reset layout transforms / mobile menu when preparing navigation
      document.addEventListener('astro:before-preparation', () => {
        const main = document.getElementById('main');
        const header = document.querySelector('.site-header') as HTMLElement | null;
        const footer = document.querySelector('.site-footer') as HTMLElement | null;
        [main, header, footer].forEach(el => {
          if (el) {
            el.style.transform = '';
            el.style.willChange = '';
            if ('inert' in el) (el as any).inert = false;
          }
        });

        const toggle = document.querySelector('.menu-toggle');
        const panel = document.getElementById('mobile-panel');
        if (toggle && panel) {
          toggle.setAttribute('aria-expanded', 'false');
          panel.setAttribute('hidden', '');
          panel.classList.remove('open');
        }
      });
    </script>


    <!-- Cart drawer. Rendered empty here; src/lib/cart-ui.ts owns the
