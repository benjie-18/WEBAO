      data-cart-drawer
      aria-label={t.cart.title}
      hidden
      data-label-open={t.cart.open}
      data-label-add={t.cart.add}
      data-label-remove={t.cart.remove}
      data-label-empty-all={t.cart.emptyAll}
      data-label-empty-confirm={t.cart.emptyConfirm}
      data-empty-title={t.cart.emptyTitle}
      data-empty-hint={t.cart.emptyHint}
      data-suffix-month={t.cart.suffixMonth}
      data-suffix-year={t.cart.suffixYear}
      data-suffix-one-time={t.cart.suffixOneTime}
      data-money-prefix={t.cart.moneyPrefix}
      data-money-suffix={t.cart.moneySuffix}
      data-money-decimal={t.cart.moneyDecimal}
    >
      <div class="cart-drawer-header">
        <h2 class="cart-drawer-title">{t.cart.title}</h2>
        <button type="button" class="cart-drawer-close" data-cart-close aria-label={t.cart.close}>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="cart-drawer-items" data-cart-items>
        <div class="cart-drawer-empty">{t.cart.emptyTitle}<br/>{t.cart.emptyHint}</div>
      </div>
      <div class="cart-drawer-footer">
        <div class="cart-drawer-total">
          <span>{t.cart.total}</span>
          <strong data-cart-total>{t.cart.moneyPrefix}0{t.cart.moneyDecimal}00{t.cart.moneySuffix}</strong>
        </div>
        <a
          href={navLinks.start}
          class="btn btn--primary cart-drawer-checkout is-disabled"
          data-cart-checkout
          aria-disabled="true"
          tabindex="-1"
          data-track="cta"
          data-track-label={t.cart.checkout}
        >
          {t.cart.checkout}
        </a>
        <p class="cart-drawer-note">{t.cart.note}</p>
        <button type="button" class="cart-empty-all" data-cart-empty-all hidden>{t.cart.emptyAll}</button>
      </div>
    </aside>

